{
  "permissions": {
    "allow": ["mcp__Neon", "mcp__claude_ai_Neon", "Bash(pnpm gates:*)", "Bash(pnpm test:*)", "Bash(node --test:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-protected-files.mjs"
          }
        ]
      }
    ]
  }
}
