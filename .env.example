# Copy to .env.local and fill in. Never commit a filled-in copy.

# --- Map tiles -------------------------------------------------------------
# MapTiler vector tiles. Free key at https://cloud.maptiler.com/account/keys/
# Optional in development: with no key the map falls back to OpenFreeMap,
# which needs no account. Set this before deploying — the fallback is
# community-run and carries no SLA.
NEXT_PUBLIC_MAPTILER_KEY=

# MapTiler style id used when the key above is set.
# Defaults to "dataviz-dark" if unset.
NEXT_PUBLIC_MAPTILER_STYLE=

# --- Database --------------------------------------------------------------
# Neon Postgres connection string, from the Neon console.
# postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Unset in development: nothing on the map entry screen reads the database yet.
DATABASE_URL=
