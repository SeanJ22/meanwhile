# Copy to .env.local and fill in. Never commit a filled-in copy.

# --- Map tiles -------------------------------------------------------------
# ONE KEY, ONE QUESTION (MAPQ-3, 2026-09-07). The first billing period closed at
# 101,863 requests against a 100,000 allowance and nobody could say which were
# readers, because one key served production, staging, previews, local dev and
# every Playwright run. docs/maptiler-keys.md carries the full matrix and the
# owner actions; lib/map/key-matrix.ts is the machine-readable copy.
#
# LEAVE THIS EMPTY LOCALLY. Local, CI and preview deploys are expected to carry
# no browser key at all: the map draws a plain ground colour and says "Basemap
# unavailable", and nobody's allowance is spent. There is deliberately no
# substitute provider — a silent swap makes a total rendering failure look like
# a dark style choice.
#
# Production carries meanwhile-prod-browser; the staging branch deploy carries
# meanwhile-staging-browser. Both are set on the Netlify side, scoped to their
# deploy context, and each is restricted in the MapTiler account to its own
# exact origins.
NEXT_PUBLIC_MAPTILER_KEY=

# The key issued to the ONE bounded provider smoke (pnpm provider:smoke), and to
# nothing else. Never shipped to a browser bundle, never the production or
# staging key — the smoke refuses to run if this value equals
# NEXT_PUBLIC_MAPTILER_KEY. Restricted in the MapTiler account to
# http://maptiler-smoke.localhost.
WTP_MAPTILER_SMOKE_KEY=

# MapTiler SERVICE credential (the Credentials page, not the Keys page), used
# server-side by `pnpm maptiler:usage` to read the account's own usage
# analytics. Runner only. Never NEXT_PUBLIC_, never a log line, never a
# committed file. Unset means the admin console says NOT CONNECTED — which is
# not the same as, and must never be read as, zero usage.
MAPTILER_SERVICE_TOKEN=

# The request allowance the plan actually carries. MapTiler's analytics API does
# not return it, so the console shows 100,000 marked "assumed" until this is set.
MAPTILER_MONTHLY_ALLOWANCE=

# MapTiler style id used for the dark theme, when the key above is set.
# Defaults to "basic-v2-dark" if unset.
NEXT_PUBLIC_MAPTILER_STYLE=

# MapTiler style id used for the light theme. Defaults to "basic-v2".
# The basemap follows the UI theme, so both need to be set together.
NEXT_PUBLIC_MAPTILER_STYLE_LIGHT=

# --- Meeting source --------------------------------------------------------
# Which adapter serves the map. Unset (the default) reads the committed
# snapshot at data/meetings-snapshot.json — the production path, refreshed by
# `pnpm ingest composite` on a schedule. Set to `composite` for local
# development against the live vendor portals (never in production: a fetch
# per visitor against a public body's portal is the service degradation
# CLAUDE.md forbids, and five portals in sequence outlive a serverless
# timeout). Tests pin `mock` themselves.
WTP_MEETING_SOURCE=

# --- Ingestion -------------------------------------------------------------
# Contact address sent in the User-Agent by every source adapter that touches
# the network, so an administrator who sees our traffic in a log has somewhere
# to write. Identified traffic gets a conversation; anonymous traffic gets
# blocked.
#
# Optional. Unset, the User-Agent still names the project and links the repo —
# it just gives whoever wants to complain a slower route. Not committed with a
# value, because a personal address in a public repo is a separate decision.
INGEST_CONTACT_EMAIL=

# --- Officeholder and funding sources --------------------------------------
# NONE of these take a NEXT_PUBLIC_ prefix. That prefix inlines the value into
# the client bundle and publishes it. All three are read server-side, inside an
# adapter, at build time.

# Congress.gov. Free key at https://api.congress.gov/sign-up/
# NOT needed for the officeholder roster — that is built from the public-domain
# unitedstates/congress-legislators bulk file, which needs no key at all. This
# is for the member `depiction` endpoint that supplies portraits and their
# attribution (tracker D20), and later for roll calls.
CONGRESS_API_KEY=

# Plural Open (ex-Open States), for state legislators.
# Free key at https://open.pluralpolicy.com — note that account is SEPARATE
# from a pluralpolicy.com account. Build against v3; the v2 GraphQL API is
# sunset. The key is passed as an `apikey` query parameter. Data is CC-0.
#
# NOT needed for the officeholder roster, which is built from the nightly CC-0
# bulk CSVs at data.openstates.org — no key, no login, three requests for three
# states. This key is for the GraphQL API, which nothing currently uses.
#
# The default tier is 500 GraphQL requests/day at 1 request/second. That is the
# reason for the bulk route rather than a preference: AZ, NJ and NH are ~620
# legislators, and a per-district fetch pattern would spend most of a day's
# quota in a single build. If GraphQL is ever used, serialize at 1 req/sec,
# cache hard, and print the request count so the ceiling is visible rather than
# discovered by hitting it.
PLURAL_API_KEY=

# OpenFEC. Free key at https://api.open.fec.gov/developers/
# DO NOT WIRE THIS YET. It belongs to the FUNDING evidence tier, and federal law
# restricts commercial use of contributor information (52 U.S.C. 30111(a)(4)) —
# tracker D14 has to record that finding before an adapter ships. Holding the
# key is not clearance to use it.
FEC_API_KEY=

# --- Database --------------------------------------------------------------
# Neon Postgres connection string, from the Neon console.
# postgresql://user:password@host.neon.tech/dbname?sslmode=require
#
# LEAVE THIS UNSET FOR LOCAL DEVELOPMENT, and the reason is a defect that
# already happened (2026-08-17). This file's local copy used to carry the
# PRODUCTION connection string, which quietly made `pnpm dev` a production
# client: opening a browser at localhost:3000 wrote an unmarked ORGANIC row
# into the search log — the table the business sells from.
#
# Unsetting it costs nothing. NOTHING IN THE APP READS THE DATABASE: all four
# getDb() call sites are writes, and every write path treats an absent
# DATABASE_URL as an ordinary state (returns false / null / 0) rather than an
# error. So a local checkout with no DATABASE_URL runs every surface.
#
# Set it only to point at a database that is genuinely yours to write to, and
# set WTP_DB_ROLE=local in the same edit.
DATABASE_URL=

# What DATABASE_URL points at: `local` or `production`.
#
# UNSET MEANS PRODUCTION. That default is deliberate — lib/db/write-guard.ts
# refuses every write from a non-production runtime to a database it believes
# is production, so a new checkout, a forgotten variable or a script nobody
# thought about is refused rather than trusted. Failing closed is the whole
# point; a guard whose default is "probably fine" guards nothing.
#
# Declare `local` ONLY at the same moment DATABASE_URL is pointed at a real
# local database. `local` declared over a production URL opens the gate this
# closes, which is the one way to get the original defect back.
#
# The recommended local database is a NEON BRANCH of production rather than a
# local Postgres install, because the app talks to Neon over its HTTP driver
# (@neondatabase/serverless + drizzle-orm/neon-http) rather than the Postgres
# wire protocol. A branch keeps the driver, the protocol, the TLS and the
# connection-string shape identical, so local exercises the same code path
# production does; a local Postgres would need either a proxy or a second
# driver, and a second driver means local stops testing what ships.
WTP_DB_ROLE=

# Direct Scout and Detective tools (server-side only).
CENSUS_API_KEY=
LEGISCAN_API_KEY=
LDA_API_KEY=
DATA_GOV_API_KEY=
SOCRATA_APP_TOKEN=
SOCRATA_SECRET_TOKEN=
GOOGLE_CIVIC_API_KEY=
SAM_GOV_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
