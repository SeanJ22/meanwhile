# Copy to .env.local and fill in. Never commit a filled-in copy.

# --- Map tiles -------------------------------------------------------------
# MapTiler vector tiles. Free key at https://cloud.maptiler.com/account/keys/
# Required. With no key the map draws a plain ground colour and says "Basemap
# unavailable". There is deliberately no substitute provider: a silent swap
# makes a total rendering failure look like a dark style choice.
NEXT_PUBLIC_MAPTILER_KEY=

# MapTiler style id used for the dark theme, when the key above is set.
# Defaults to "basic-v2-dark" if unset.
NEXT_PUBLIC_MAPTILER_STYLE=

# MapTiler style id used for the light theme. Defaults to "basic-v2".
# The basemap follows the UI theme, so both need to be set together.
NEXT_PUBLIC_MAPTILER_STYLE_LIGHT=

# --- Ingestion -------------------------------------------------------------
# Contact address sent in the User-Agent by every source adapter that touches
# the network, so an administrator who sees our traffic in a log has somewhere
# to write. Identified traffic gets a conversation; anonymous traffic gets
# blocked.
#
# Optional. Unset, the User-Agent still names the project and links the repo —
# it just gives whoever wants to complain a slower route. Not committed with a
# value, because a personal address in a public repo is a separate decision.
INGEST_CONTACT_EMAIL=

# --- Database --------------------------------------------------------------
# Neon Postgres connection string, from the Neon console.
# postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Unset in development: nothing on the map entry screen reads the database yet.
DATABASE_URL=
