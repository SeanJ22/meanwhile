# Copy to .env.local and fill in. Never commit a filled-in copy.
# No key here takes a NEXT_PUBLIC_ prefix unless it is meant for the browser bundle.

# --- Map tiles -------------------------------------------------------------
# Leave empty locally, in CI and on previews: the map draws a plain ground and says "Basemap unavailable".
NEXT_PUBLIC_MAPTILER_KEY=
# Key for the provider smoke test only (pnpm provider:smoke); must differ from the browser key.
WTP_MAPTILER_SMOKE_KEY=
# MapTiler service credential, server-side only, for reading account usage.
MAPTILER_SERVICE_TOKEN=
# The plan's monthly request allowance (the usage API does not return it).
MAPTILER_MONTHLY_ALLOWANCE=
# Style ids for the dark and light themes; set both together.
NEXT_PUBLIC_MAPTILER_STYLE=
NEXT_PUBLIC_MAPTILER_STYLE_LIGHT=

# --- Meetings --------------------------------------------------------------
# Which adapter serves meetings. Unset in production; tests set it themselves.
WTP_MEETING_SOURCE=

# --- Acquisition -----------------------------------------------------------
# Contact address added to the User-Agent of every request we send to a source.
INGEST_CONTACT_EMAIL=

# Plain-code sources, read on a schedule for every place and callable as tools by every acquiring role.
CONGRESS_API_KEY=
PLURAL_API_KEY=
FEC_API_KEY=
CENSUS_API_KEY=
LEGISCAN_API_KEY=
LDA_API_KEY=
DATA_GOV_API_KEY=
SOCRATA_APP_TOKEN=
SOCRATA_SECRET_TOKEN=
GOOGLE_CIVIC_API_KEY=
SAM_GOV_API_KEY=
# Search providers, callable as tools by every acquiring role.
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# --- Database --------------------------------------------------------------
# Neon Postgres connection string. Leave unset locally unless it points at a database that is yours to write to.
DATABASE_URL=
# What DATABASE_URL points at: `local` or `production`. Unset means production, so writes from a
# non-production runtime are refused. Set `local` only together with a local DATABASE_URL.
WTP_DB_ROLE=

# --- Admin -----------------------------------------------------------------
# Read-only GitHub token for this repository, used by Admin's Changes view. GH_TOKEN is read too.
WTP_GITHUB_READ_TOKEN=
