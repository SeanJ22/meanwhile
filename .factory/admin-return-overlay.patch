+import { lookupAction } from "../lib/control-plane/gateway/registry.ts";
+import { SECTION_IDS } from "../app/(admin)/_mw/admin-v6/contract.ts";
+test("retired actions, sections and routes offer no empty controls or endpoints", () => {
