 const read=await bank.readEntries(q as any); const projection=projectFieldManual(read.store,q as any);
 assert.deepEqual(projection.entryIds,projectFieldManual(expected,q as any).entryIds); assert.equal(read.total,entries.length);
}
calls.length=0;
await bank.mergeEntries([make('az',{states:['ut'],outcome:'FAILED',observedAt:'2026-10-06T06:00:00Z'})],stamp);
assert(!calls.some(c=>c.text.includes('cp_field_manual WHERE')));
assert(calls.filter(c=>c.text.startsWith('SELECT value')).every(c=>c.bytes<10000));
const merged=(await db.query('SELECT value FROM cp_field_manual_entries WHERE id=$1',[entries[1].id])).rows[0].value as any;
assert.deepEqual(merged.states,['az','ut']); assert.equal(merged.placeResults.length,2);
const cost=(attempt:string,success:boolean)=>make(attempt,{kind:'JOB_COST',payload:{platform:'legistar',recordClass:'meetings',attemptId:attempt,durationMs:1000,usd:0.1,requestCount:1,success}});
await bank.mergeEntries([cost('a',true)],stamp);await bank.mergeEntries([cost('b',false)],stamp);await bank.mergeEntries([cost('b',false)],stamp);
const profiles=(await db.query("SELECT value FROM cp_field_manual_entries WHERE kind='COST_PROFILE'")).rows as any[];
assert.equal(profiles.length,1);assert.equal(profiles[0].value.payload.attempts,2);assert.equal(profiles[0].value.payload.usdPerSuccess,0.2);
await bank.importEntries([make('large-cost-history',{kind:'JOB_COST',payload:{platform:'legistar',recordClass:'meetings',attemptId:'large-cost-history',durationMs:1000,usd:0.1,requestCount:1,success:true,originalEvidence:'x'.repeat(6600000)}})],stamp);
calls.length=0;await bank.mergeEntries([cost('c',true)],stamp);
assert(calls.filter(c=>c.text.startsWith('SELECT')).every(c=>c.bytes<1000));
assert(calls.some(c=>c.text.includes('AS attempts')));
const costReadBytes=calls.reduce((sum,c)=>sum+c.bytes,0);
await db.exec('TRUNCATE cp_field_manual_entries');
const repos=createMemoryRepositories();
await repos.fieldManual.put('live',expected,stamp);
await moveBankToEntryRows({repos,entries:bank,checkpointId:'db39-checkpoint-forward',now:stamp});
assert.equal((await bank.scanEntries(undefined,100)).length,entries.length);
const originalIds=new Set(expected.entries.map(e=>e.id));
for(const row of await bank.scanEntries(undefined,100)) { assert(originalIds.has(row.id)); assert.deepEqual(row.payload,expected.entries.find(e=>e.id===row.id)!.payload); }
const scopedRepos={...repos,bankEntries:bank};
const originalBook=await readRolePlaybook(scopedRepos,'SCOUT');
const edit={role:'SCOUT' as const,text:'Use saved official evidence first',expectedVersion:originalBook.version,id:'sql-edit',at:stamp,why:'SQL test'};
await updateRolePlaybook(scopedRepos,edit);
const edited=await readRolePlaybook(scopedRepos,'SCOUT');assert.equal(edited.text,edit.text);
assert.equal((await updateRolePlaybook(scopedRepos,edit)).changed,false);
await assert.rejects(updateRolePlaybook(scopedRepos,{...edit,id:'stale',text:'stale'}),/refresh/);
await updateRolePlaybook(scopedRepos,{...edit,id:'undo',text:originalBook.text,expectedVersion:edited.version,undoOf:'sql-edit'});
assert.equal((await readRolePlaybook(scopedRepos,'SCOUT')).text,originalBook.text);
await bank.mergeEntries([make('after-cutover')],stamp);
await moveBankBackToAggregate({repos,entries:bank,checkpointId:'db39-checkpoint-rollback',now:stamp});
assert((await repos.fieldManual.read('live'))!.value.entries.some(e=>e.title==='after-cutover'));
assert((await repos.fieldManual.read('db39-checkpoint-forward'))!.value.entries.every(e=>e.title!=='after-cutover'));
console.log(JSON.stringify({ok:true,costReadBytes,realPostgresEngine:'PGlite',assertions:'scoped SQL equals existing projection; unrelated 6.6MB row not read on write; grow-only place merge; cost replay idempotent; forward checkpoint; role edit and stale edit refusal; Undo; rollback preserves post-cutover learning',queries:calls.map(c=>({bytes:c.bytes,text:c.text.slice(0,100)}))}));await db.close();
