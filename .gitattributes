# Git hooks run under sh; CRLF would break the shebang.
.githooks/* text eol=lf

* text=auto eol=lf

*.jpg  binary
*.png  binary
*.ico  binary
*.xlsx binary
*.woff binary
*.woff2 binary

# Recorded server responses and published reference files keep their exact bytes.
tests/fixtures/**  -text
data/reference/**  -text
