#!/bin/sh
#
# Refuse a commit whose staged documents carry a date later than today.
#
# The check itself is scripts/check-staged-dates.mjs; this file only finds
# node and gets out of the way. Installed by pointing git at this directory:
#
#     git config core.hooksPath .githooks
#
# which `pnpm session:start` reports on, so a fresh clone is told rather than
# left silently unprotected. Bypass with git's own `--no-verify`.
#
# `hooks/` at the repo root is React hooks — this is `.githooks/` on purpose.

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not on PATH — the staged-document checks did not run." >&2
  echo "pre-commit: refusing rather than passing a check that never ran." >&2
  exit 1
fi

# Both checks run, and `set -e` means the first failure stops the commit.
# CLAUDE.md's size is checked FIRST and deliberately: a clobbered constraints
# file is the one failure that makes every later check meaningless, because
# the rules those checks enforce are the thing that just went missing (R01).
node scripts/check-claude-size.mjs
# AGENTS.md must be the byte-exact generated mirror of CLAUDE.md (provider
# transition, 2026-09-02): a constitution change committed without
# `pnpm agents:sync` would hand a non-Claude agent stale law.
node scripts/agents-sync.mjs --check
exec node scripts/check-staged-dates.mjs
