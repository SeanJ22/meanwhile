# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — never commit real keys. .env.example is the checked-in contract.
.env
.env.*
!.env.example

# local database files
*.db
*.db-journal
*.sqlite
*.sqlite3
/pgdata/

# vercel
.vercel

# scripts/shoot.ts output — regenerate with `pnpm shoot`, never review a PNG
/screenshots/

# generated by scripts/build-map-worker.mjs on predev/prebuild. Not vendored:
# a committed copy goes stale the moment maplibre-gl is upgraded.
/public/maplibre-gl-worker.mjs

# pid of the running dev server, written by scripts/dev.mjs, removed on exit.
# Machine-local by definition; a committed one would name someone else's process.
/.dev-server.pid

# session scratch — one-off probes and measurements that must resolve the
# repo's own dependencies (a file outside the tree cannot), and must never be
# type-checked by the deploy or reviewed as work. Regenerate, never commit.
/.scratch/

# the code mirror (R16). `docs/code-manifest.md` is GENERATED by every
# `pnpm handoff` and records the commit SHA it mirrored at — a SHA that cannot
# exist inside the commit which would contain it, so the file is always one behind
# whenever it is committed, and it would dirty the tree on every run and refuse
# the next ship. It lives in Drive beside the code it describes, where the
# reviewer reads it. `docs/mirror-code.json` and `docs/mirror-code-ids.json`
# ARE committed: one is the author's allowlist, the other is a record.
/docs/code-manifest.md
# staging directory, only written when the mirror drive is unreachable
/.mirror/
# THE NIGHTLY WINDOW'S ISOLATED CHECKOUT (RULING 242). `pnpm window:run` runs
# the legacy refresh in a git worktree at .window/checkout so the main
# checkout is never dirtied and nothing is committed; the worktree is reset to
# origin/main after every window. The window's RUN RECORDS under
# data/health/nightly-window-runs/ are committed, as freshness-shadow-runs are.
/.window/

# typescript
*.tsbuildinfo
next-env.d.ts
*.log
.cache
.promptb

# Session capture directories. Screenshots are EVIDENCE A HUMAN READS, not
# artifacts — RULING 2 requires them opened and read as images, and the reading
# is what the report carries. Committing them would also trip the asset-store
# guard (RULING 20), which is the guard working: a PNG is a binary and binaries
# do not go in git.
/.promptc/
/.promptd/
# Prompt E capture directory (item 3.6). Same reason as the three above: the
# captures are evidence a session READ, and the reading is what the report
# carries — the pixels are not the repo's to keep.
/.prompte/
/* ASK04 (2026-08-27): the ballot Ask reader-output captures. Same reason as
   the directories above — the reading is what the report carries. */
/.askshots/
/.f22tmp/
/.nh3tmp/
/.nh5tmp/
/.njhunt2/
/.njhunt3/

# Excel owner-lock files. Sean edits docs/tracker.xlsx by hand, and Excel
# writes a ~$tracker.xlsx beside it while the workbook is open. NH Hunt 5
# committed one with git add -A: it then blocked every branch switch, because
# Excel holds the file open and git cannot unlink it to check the branch out.
~$*
/.nh6tmp/
.hunt-tmp/

# Fetched document and page corpora. RULING 20: portraits and document corpora
# do not go in git, because git keeps every version of every one of them
# forever. These are reproducible: docs/evidence/az-85641-rosters.jsonl carries
# the URL and the resolved final URL of every document read, which is the part
# worth keeping.
/data/hunt/85641-pdfs/
/data/hunt/*.html
/data/hunt/*.xml
/data/hunt/vail-nuxt-payload.txt
# RULING 20: screenshots are EVIDENCE and are not repository content. git keeps
# every version of every binary forever, so a walk that captures the reader's
# own screen writes its images here and commits only the text beside them.
/data/hunt/**/*.png

# The same rule, for the visual acceptance suite's captures (Part C,
# 2026-08-31). `pnpm visual:suite` writes one PNG per check on every run, and
# it runs on every session — committing them would put a fresh set of binaries
# in history each time. The RUN RECORD beside them is committed and is the
# durable evidence: for a DOM-certified check it carries the whole observation
# the verdict was read from, which is the part a later session can argue with.
/data/health/visual-suite-runs/*.png

# THE SHADOW RUN'S WORKING STATE, but NOT its record.
#
# RULING 20's reasoning, applied to the control plane: git keeps every version
# of every file forever, and a shadow run's durable state and evidence bodies
# are ~1.8 MB of bytes ALREADY committed under tests/fixtures/. Storing them a
# second time — and again on every re-run — buys nothing, because they are
# reproducible in one command:
#
#     pnpm shadow:run --write
#
# What IS committed is the part worth keeping: `run.json`, the replayable
# machine-readable record naming every route, disposition, attempt, artifact
# hash and refusal, and `run.txt` beside it for a person. Those are the
# deliverable; the state directory is the scratch space that produced them.
/data/control-plane/shadow-runs/*/state/
/data/control-plane/shadow-runs/*/evidence/

# The owner's raw defect screenshots, dropped straight into the repo.
#
# RULING 20: portraits and document corpora do not go in git — git keeps every
# version of every one of them forever. These are owner INTAKE, read by
# `pnpm owner:intake` and converted into permanent VisualAcceptanceChecks; the
# image itself belongs in the content-addressed store, never in a commit.
#
# Ignored rather than merely unstaged because a blanket `git add -A` in any
# session would otherwise commit them, which is how 21 PNGs reached the index
# on 2026-08-30 before RULING 20's sweep caught them.
/feedback/

# RULING 20: staged portraits are regenerated by `pnpm own03:stage`, never committed.
# git keeps every version of every binary forever; the nine are one command away.
data/photos/staged/

# The freshness EVIDENCE VAULT — retrieved third-party bytes, content-addressed,
# rewritten by every unattended cycle. It is a STORE, not repository content:
# one cycle over the registered route portfolios wrote 13 MB, and it grows with
# every cycle forever. Same reason `/data/control-plane/shadow-runs/*/evidence/`
# above is ignored, applied to the vault the scheduler actually writes through.
#
# WHAT THIS COSTS, said rather than hidden: the vault is durable against a
# PROCESS and not against a fresh clone, so a citation to a vault key is
# resolvable on the machine that acquired it and nowhere else. The STAGED
# snapshots under `data/control-plane/staging/` ARE committed, and they are what
# a later session reads.
/data/control-plane/vault/

# ITEM J (2026-09-01) — the brand identity's capture set.
#
# The PIXELS are ignored; the MEASUREMENTS are not. `probe.json` and
# `assets.txt` beside them are text and stay in git, because they carry the
# computed border colours, the resolved tokens and the list of hosts a real
# page load contacted — the facts the report rests on.
#
# The captures themselves follow the convention every session capture directory
# above already follows: a PNG is a binary, binaries do not go in git (RULING
# 20), and the READING is what the report carries. They live in the worktree at
# a stable path so the integration owner and the author can open them.
/docs/evidence/brand-2026-09-01/*.png
/docs/evidence/brand-2026-09-01/**/*.png
