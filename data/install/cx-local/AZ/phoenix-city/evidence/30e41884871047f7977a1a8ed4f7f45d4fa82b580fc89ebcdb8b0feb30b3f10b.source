                role="tablist"
        >
                    <li class="nav-item" role="presentation">
                        <a
                                id="tab-panel-e0048ed8-de92-49ae-94eb-6bcadbbce1d8"
                                href="#tab-e0048ed8-de92-49ae-94eb-6bcadbbce1d8"
                                class="nav-link active"
                                data-toggle="pill"
                                role="tab"
                                aria-controls="#tab-e0048ed8-de92-49ae-94eb-6bcadbbce1d8"
                                aria-selected="true"
                        >Voting Precincts</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a
                                id="tab-panel-f5eb440a-b03b-459b-bf0b-4bbcadf15648"
                                href="#tab-f5eb440a-b03b-459b-bf0b-4bbcadf15648"
