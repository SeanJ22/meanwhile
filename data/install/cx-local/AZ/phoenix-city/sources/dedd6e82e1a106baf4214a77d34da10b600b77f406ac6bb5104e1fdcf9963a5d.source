<script>
	  document.addEventListener('DOMContentLoaded', function() {
    var currentUrl = window.location.href;
    var menuItems = document.querySelectorAll('.elementor-nav-menu a');
    menuItems.forEach(function(item) {
        if (item.href === currentUrl) {
            item.parentElement.classList.add('current-menu-item');
        }
    });
});
</script>
<script>
	(function($) { 
		$(document).ready(function () {

  // Evento al hacer clic en el botón Load More
  $('#view-more-btn').click(function () {		
		 $('html, body').animate({
         scrollTop: $('#first-elemento-load-more').offset().top - 180
    	}, 500);
  });

  // Evento al hacer clic en el botón Show Less
  $('#show-less-btn').click(function () {
		// Desplazar suavemente la pantalla al elemento con el ID #wpb-locations-detail
   	$('html, body').animate({
         scrollTop: $('#wpb-locations-detail').offset().top - 180
    	}, 500);
  });

});
})(jQuery);</script>
<script>
	(function($) { 
		$(document).ready(function () {

  $('.hidden-physician').hide();

  // Ocultar el botón Show Less al cargar la página
  $('#show-less-btn').hide();

  // Evento al hacer clic en el botón Load More
  $('#view-more-btn').click(function () {
    // Mostrar los cuadros ocultos
    $('.hidden-physician').fadeIn(500);

    // Ocultar el botón Load More y mostrar el botón Show Less
    $(this).hide();
    $('#show-less-btn').show();
		
		 $('html, body').animate({
         scrollTop: $('#first-elemento-load-more').offset().top - 200
    	}, 500);
  });

  // Evento al hacer clic en el botón Show Less
  $('#show-less-btn').click(function () {
    // Ocultar los cuadros
    $('.hidden-physician').fadeOut(500);

    // Ocultar el botón Show Less y mostrar el botón Load More
    $(this).hide();
    $('#view-more-btn').show();
		
		// Desplazar suavemente la pantalla al elemento con el ID #wpb-locations-detail
   	$('html, body').animate({
         scrollTop: $('#wpb-locations-detail').offset().top - 200
    	}, 500);
  });
			
				/*-------------------- PHYSICIANS----------------*/

	$('.hidden-location').hide();

	$('#show-less-btn-ph').hide();

	$('#view-more-btn-ph').click(function() {
		
		$('.hidden-location').fadeIn(500);
		
		$(this).hide();
		$('#show-less-btn-ph').show();
	});

	$('#show-less-btn-ph').click(function() {
	
		$('.hidden-location').fadeOut(500);
		
		$(this).hide();
		$('#view-more-btn-ph').show();
	});

});
})(jQuery);</script>
<script>
	(function ($) {
	
		
		const observer = new MutationObserver(() => {
    const wrapper = document.querySelector('.physicians-loop-grid .e-loop__load-more, .physicians-loop-two-col .e-loop__load-more');
    const button = document.querySelector('.vwh_find_doctors');
			if (wrapper && button) {
					wrapper.appendChild(button.cloneNode(true));
					observer.disconnect();
			}
		});

		observer.observe(document.body, { childList: true, subtree: true });
		
		
  function adjustScrollPosition() {
        var hash = window.location.hash; // Get the hash from the URL
        if (hash) {
            var adminbarHeight = $('#wpadminbar').outerHeight() || 0;
            var headerHeight = $('.elementor-location-header').outerHeight() || 0;

            var $target = $(hash);
            if ($target.length) {
                // Adjust position after default scroll
                var targetPosition = $target.offset().top - adminbarHeight - headerHeight;
                setTimeout(function () {
                    $(window).scrollTop(targetPosition); // Adjust scroll position
                }, 500); // Delay to allow default scroll to complete
            }
        }
    }

    // Call adjustScrollPosition on page load
    adjustScrollPosition();
		
		
		
	}(jQuery));
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    function setPostsPerPageCookie() {
        var postsPerPage = 30; // desktop
        if (window.innerWidth < 600) {
            postsPerPage = 5; // mobile
        } else if (window.innerWidth < 1024) {
            postsPerPage = 10; // tablet
        }
        document.cookie = "posts_per_page=" + postsPerPage + "; path=/";
    }

    setPostsPerPageCookie();
    window.addEventListener('resize', setPostsPerPageCookie);
});
</script>

