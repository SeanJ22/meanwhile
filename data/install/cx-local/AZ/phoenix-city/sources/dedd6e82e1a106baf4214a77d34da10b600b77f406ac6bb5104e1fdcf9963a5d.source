  <script>
    document.querySelector(".facetwp-type-search").addEventListener("keyup", function(e) {
      if ('object' !== typeof FWP || FWP.is_refresh) {
        return;
      }
      var trigger = 3; // Start auto-refreshing at this number of characters
      e.stopPropagation();
      var $facet = fUtil(this).closest('.facetwp-facet');
      var facet_name = $facet.attr('data-name');
      var sel = this.querySelector('input').value;
 
      if ('undefined' !== typeof FWP.settings[facet_name]) {
        if ('yes' === FWP.settings[facet_name]['auto_refresh'] && !( trigger > sel.length && 0 < sel.length ) ) {
          FWP.logic.search['delay_refresh'](facet_name);
        }
        else if (13 === e.keyCode) {
          FWP.autoload();
        }
      }
    });
  </script>
        <script>
            document.addEventListener('facetwp-loaded', function() {
                // detect language
                var lang = document.documentElement.getAttribute('lang');

                // Change checkbox label "Speak spanish"
                if (lang === 'es-MX') {
                    jQuery(".facetwp-facet-speaks_spanish .facetwp-display-value").html("Habla español");
                    jQuery(".facetwp-facet-search_blog input.facetwp-search").prop("placeholder", "Buscar blog");
                    jQuery(".facetwp-facet-search_blog .facetwp-icon").html('<p class="btn-search-blog"> Buscar</p>');
                } else {
                    jQuery(".facetwp-facet-speaks_spanish .facetwp-display-value").html("Speaks Spanish");
                    jQuery(".facetwp-facet-search_blog input.facetwp-search").prop("placeholder", "Enter a keyword");
                    jQuery(".facetwp-facet-search_blog .facetwp-icon").html('<p class="btn-search-blog"> Search</p>');
                }
            });
        </script>
