.mobile_lang_drop .cpel-switcher__list {
	box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    box-sizing: border-box;
    background-color: #fff;
    top: calc(100% + 10px);
	left: 50%;
	transform: translatex(-50%);
}

.mobile_lang_drop .cpel-switcher__list .cpel-switcher__lang:first-child {
    margin-top: 10px;
}

.mobile_lang_drop .cpel-switcher__list .cpel-switcher__lang:last-child {
    margin-bottom: 10px;
}

.mobile_lang_drop .cpel-switcher__list .cpel-switcher__lang a {
    font-family: "Noto Sans", Sans-serif;
    font-size: 14px;
    font-weight: 400;
    font-style: normal;
    line-height: 1;
    padding: 6px 12px;
}

.mobile_lang_drop .cpel-switcher__list .cpel-switcher__lang .cpel-switcher__name,
.mobile_lang_drop .cpel-switcher__list .cpel-switcher__lang a .cpel-switcher__code {
	padding: 0;
}

.cpel-switcher__nav:not(.cpel-ready) {
  opacity: 0;
}
.cpel-switcher__nav.cpel-ready {
  opacity: 1;
}

body .content-languaje.elementor-element .cpel-switcher--layout-dropdown .cpel-switcher__nav .cpel-switcher__toggle + .cpel-switcher__list:has(a:focus),
body .content-languaje.elementor-element .cpel-switcher--layout-dropdown .cpel-switcher__nav .cpel-switcher__toggle:has(a:focus) + .cpel-switcher__list {
	display: block;
	max-height: unset !important;
}

body .content-languaje.elementor-element .cpel-switcher--layout-dropdown .cpel-switcher__nav .cpel-switcher__toggle a {
	background-color: transparent !important;
	font-family: "Noto Sans", Sans-serif;
    font-size: 14px;
    font-weight: 400;
