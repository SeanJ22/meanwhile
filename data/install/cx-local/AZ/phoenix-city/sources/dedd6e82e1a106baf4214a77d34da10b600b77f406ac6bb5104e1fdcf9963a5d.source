.vwh-video-card .vwh-video-wrapper .vwh-video-overlay::before{
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	width: 50px;
	height: 50px;
	border-radius: 50%;
	z-index: 1;
	background: rgba(255, 255, 255, 0.5);
	opacity: 0
}
