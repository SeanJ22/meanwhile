			<style id="wp-custom-css">
html[dir="rtl"][lang="fa-IR"] header,
html[dir="rtl"][lang="fa-IR"] footer,
html[dir="rtl"][lang="ar"] header,
html[dir="rtl"][lang="ar"] footer{
