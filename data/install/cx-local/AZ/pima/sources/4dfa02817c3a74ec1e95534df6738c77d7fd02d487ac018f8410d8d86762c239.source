  tableRow = dojo.byId("PCC");
	dojo.style(tableRow, {display: "table-row"});
   dojo.byId("pccdist").innerHTML = dataOutputTC;     
                                 }				
	
function makePointPol(PLAddrX, PLAddrY, pollLocOutput) {    
  //if the X and Y points have "0" zero as their value then that record(location)is in a precinct currently marked as mail in only so do not display a map link
  //if  (PLAddrX != "0") {
  // in 2020 we switched to using the criteria below for filtering map based on mail in status	  
	if  (pollLocOutput != "All Mail Precinct") {  
    //alert ("test");		      		
    //create an address point using the x, y which is in our spatial reference - 2868
    PolLocAddrPoint = new esri.geometry.Point(PLAddrX, PLAddrY, new esri.SpatialReference({ wkid : 2868 }));
    //console.log(addressPoint);	
    //use our geometry service to reproject the point into lat-lon for use with Google Maps - wkid 4326
    var outSR = new esri.SpatialReference({wkid: 4326}); 
    var gs = new esri.tasks.GeometryService("https://pimamaps.pima.gov/pmgp/rest/services/Utilities/Geometry/GeometryServer?token=" +tkn2);
    //gs.project completes the projection and uses callback to send the reprojected point object to the 
    gs.project([PolLocAddrPoint], outSR, mapPoint);
						}							
                                        }		
								 
function mapPoint(DestAddrPoint) {
  //display the breaker line just above the map and driving directions area
  //alert ("making visible");
  tableRow = dojo.byId("dataMapLine");
    dojo.style(tableRow, {display: "table-row"});
  //The object created from the projection method from the geometry service is always an array even if only one point.
  //http://help.arcgis.com/en/webapi/javascript/arcgis/help/jsapi_start.htm
  var XDestAddrPoint = DestAddrPoint[0].x;
  var YDestAddrPoint = DestAddrPoint[0].y;
  //define end portion of url to generate/ hold Google Map - cannot use quoted, complete url in variable for window.open or getElement.hfref
  mapUrl = YstartAddrPoint + ',' + XstartAddrPoint + '&daddr=' + YDestAddrPoint + ',' + XDestAddrPoint;
  //Display a link to the map  
  document.getElementById("maplink").href="http://maps.google.com/maps?saddr=" + mapUrl;
  tableRow = dojo.byId("maplinkDiv");
    dojo.style(tableRow, {display: "table-row"});
  //window.open("http://maps.google.com/maps?saddr=" + mapUrl + "" );
                                  }	
			 
function clearData() {
  //clear the address candidate radio button options
  dojo.style("CANDINSTRUCT", {display: "none"});
  dojo.style("CAND0", {display: "none"});
  dojo.style("CAND1", {display: "none"});
  dojo.style("CAND2", {display: "none"});
  //hide the datatable which because even when the table is empty the table border creates a dot on the screen
  dojo.style("DataTable", {display: "none"});	
  //clear the data output - even though these are hidden when the data table above is hidden
  //we hide each one individually because display isn't always in sync with table visibility
  dojo.style("MADDR", {display: "none"});
  dojo.style("PREC", {display: "none"});
  dojo.style("SCH", {display: "none"});
  dojo.style("FIRE", {display: "none"});
  dojo.style("BOS", {display: "none"});
  dojo.style("LEG", {display: "none"});
  dojo.style("JUR", {display: "none"});
  dojo.style("CON", {display: "none"});
  dojo.style("JP", {display: "none"});
  dojo.style("PCC", {display: "none"});  

  //clear the polling location data
  dojo.style("POL", {display: "none"});
  //dojo.style("PLA", {display: "none"});
  //dojo.style("RML", {display: "none"});

  //clear the driving directions and map
  //dojo.style("right", {display: "none"});
  //dojo.style("left", {display: "none"});

  //clear the No Matching address found message
  dojo.style("NM", {display: "none"});

  //clear the "Processing Query" indicator
  dojo.style("Processing", {display: "none"});

  //hide the line between the data and map areas
  dojo.style("dataMapLine", {display: "none"}); 

  //hide maplink
  dojo.style("maplinkDiv", {display: "none"}); 
				     }
//the name of the parent function has to be declared as a variable to this nested function name for successfull use in the specific call in the earlier dynamic radio buttons.
initLocate.clearData = clearData;

function toTitleCase(str) 
{ 
    return str.replace(/\w\S*/g, function(txt){return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase();}); 
} 

}); // end of require function statement
}  // end of initLocate function
					 
					 
					 
					 
	
	
	
	