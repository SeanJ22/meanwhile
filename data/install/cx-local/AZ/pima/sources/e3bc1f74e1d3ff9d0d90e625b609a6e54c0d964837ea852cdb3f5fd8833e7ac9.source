<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function () {
    const currentUrl = window.location.href;

    const currentPath = window.location.pathname;

    if (currentPath.includes('%20')) {
        // Create the corrected path by removing %20
        const correctedPath = currentPath.replace(/%20/g, '');

        // Reconstruct the corrected URL
        const correctedUrl = window.location.origin + correctedPath + window.location.search + window.location.hash;

        // Redirect to the corrected URL (without adding to history)
        window.location.replace(correctedUrl);
    }
});

