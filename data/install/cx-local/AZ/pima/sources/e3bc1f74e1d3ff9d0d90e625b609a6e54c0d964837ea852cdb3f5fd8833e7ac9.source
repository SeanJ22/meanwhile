f-9cb341a59f3c","lastModified":"","meta":{"d3ec4fa8-70c5-4850-bc9f-9cb341a59f3c":{"contentType":"agendasandminutes","isAsset":false,"isImage":false,"options":{}}},"newStatus":"","newStatusColor":"","scheduledJob":{},"status":"","statusColor":"","scheduleJob":{},"titleText":"Election Integrity Commission","bodyText":"1 Asset(s) 1 Asset(s)"}}}},"options":{"autoPopulate":false,"optionSetId":1,"autoAdjust":true,"removePastDates":true,"hidePlaceholders":false,"skinId":43,"widgetFormat":"EVENT","presetId":"EVENT_PRESET","viewAllRadioOption":"default","selectedSortDisplayName":"Newest First","categories":["ea233dff-a4bf-4071-ab68-20fdf6e902ea","53dd6594-9765-4c20-a5b0-498ee56618d0"],"contentTypeNames":["agendasandminutes","event"],"tags":[],"header":"Upcoming Events","assetTypes":[],"seeMoreLabelsLocation":"left","seeMoreOpenIn":"dialog","sortBy":"BY_LAST_MODIFIED","sortDirection":"DESCENDING","showCalendar":true,"calendarPosition":"right","numItems":4,"includedAssetTypes":{"images":false,"pdfs":true,"otherFiles":false}},"itemsUnableToRender":[],"formatConfigurations":{"CALENDAR":{"event":{"title":"{{title}}","itemDetails":"","sectionOptions":{"secondary":{},"body":{},"thumbnail":{},"title":{},"seeMore":{},"itemDetails":{"formatAsStackedIfLabelsAreNotOn":true}},"fieldRenderOptions":{}}},"EVENT":{"event":{"title":"{{title}}","body":"","sectionOptions":{"secondary":{"showLabel":true},"body":{"formatAsStackedIfLabelsAreNotOn":true,"showLabel":false},"thumbnail":{},"title":{},"seeMore":{},"itemDetails":{}},"fieldRenderOptions":{"title":{},"eventdate":{"showLabel":true},"description":{"showLabel":true}},"secondary":"{{eventdate}} {{description}}"},"agendasandminutes":{"title":"{{commissionboard-name}}","sectionOptions":{"title":{},"secondary":{},"body":{"formatAsStackedIfLabelsAreNotOn":true,"showLabel":true}},"fieldRenderOptions":{"commissionboard-name":{},"meeting-date":{},"agenda":{"showLabel":true},"minutes":{"showLabel":true},"meeting-type":{},"additionallink":{},"media-link":{}},"secondary":"{{meeting-date}}","body":"{{agenda}} {{minutes}}"}}},"status":"UNIVERSAL > LOADING","columns":[["278faa5f-617a-4724-a2fe-22c45c452cd2","254cf2ed-9c54-45f0-9592-e7c8da231e72","d3ec4fa8-70c5-4850-bc9f-9cb341a59f3c"]],"autoPopulatedContentItems":[],"manualContentItemIds":["278faa5f-617a-4724-a2fe-22c45c452cd2","254cf2ed-9c54-45f0-9592-e7c8da231e72","d3ec4fa8-70c5-4850-bc9f-9cb341a59f3c"],"manualContentItemsOptions":{"278faa5f-617a-4724-a2fe-22c45c452cd2":{"contentType":"event","isAsset":false,"isImage":false,"options":{},"id":"278faa5f-617a-4724-a2fe-22c45c452cd2"},"254cf2ed-9c54-45f0-9592-e7c8da231e72":{"contentType":"agendasandminutes","isAsset":false,"isImage":false,"options":{},"id":"254cf2ed-9c54-45f0-9592-e7c8da231e72"},"d3ec4fa8-70c5-4850-bc9f-9cb341a59f3c":{"contentType":"agendasandminutes","isAsset":false,"isImage":false,"options":{},"id":"d3ec4fa8-70c5-4850-bc9f-9cb341a59f3c"}},"filterOptions":{"contentTypes":[]}},"2b468b43-68ab-41b2-bf22-95b4cfe8aeac":{"isInitialized":true,"widgetId":"2b468b43-68ab-41b2-bf22-95b4cfe8aeac","contentItems":{"ea0debae-26d6-42e8-a06f-03f31662303e":{"contentItemId":"ea0debae-26d6-42e8-a06f-03f31662303e","isLoading":false,"isPlaceholderItem":false,"id":"ea0debae-26d6-42e8-a06f-03f31662303e","slug":"your-guide-to-election-day-in-pima-county-voting-ballot-drop-off-and-results","createdBy":"subject:e03b7a17-09af-4173-b298-4f3a441ab169","lastModifiedBy":"subject:e03b7a17-09af-4173-b298-4f3a441ab169","data":{"title":{"en":"Your guide to Election Day in Pima County: Voting, ballot drop-off and results"},"Date":{"iv":"2026-10-30T07:00:00Z"},"description":{"en":"<p data-pasted=\\"true\\">The 2026 General Election is Tuesday, Nov. 3, and Pima County has resources to help voters find a Vote Center, return an early ballot and follow election results.<\/p><p>Visit <a href=\\"https://www.pima.vote/\\">pima.vote<\/a> for voting information from the Pima County Recorder&#39;s Office and Elections Department.<\/p><h2><strong><img class=\\"fr-dii fr-fir\\" src=\\"https://content.civicplus.com/api/assets/az-pimacounty/2171cb80-8ff5-4b97-a7f8-6eb2dee2788d\\" style=\\"width: 347px;\\">Where to vote on Election Day<\/strong><\/h2><p>All 126 Pima County Vote Centers will be open from 6 a.m. to 7 p.m. on Nov. 3. Voters can cast their ballots at any Vote Center in the county, regardless of where they live. Anyone in line by 7 p.m. will be allowed to vote.<\/p><ul><li>Find a Vote Center: <a href=\\"https://experience.arcgis.com/experience/21445fb10f884caea0aac1ecba764599/page/English?views=Election-Day-Vote-Centers\\">Map of Vote Centers<\/a> | <a href=\\"https://docaccess.com/docviewer.html?url=https%3A%2F%2Fcontent.civicplus.com%2Fapi%2Fassets%2Faz-pimacounty%2Ff9990a8f-8ccc-45cf-9893-90bb2dd56e96&url_hash=b046040f4b576c690fbe543a605c0156&domain=pima.gov&site=a445fc5e-cbf4-4e87-afba-9c1902cbd811&found_on=https%3A%2F%2Fwww.pima.gov%2Fpima-votes%3Fpreview%3Dtrue\\">List of Vote Centers by region (PDF)<\/a><\/li><li>Look before you go: <a href=\\"https://updates.electionlink.net/widgets/pimaaz/2026-11-03/Vote%20Center%20Wait%20Times.html\\">Check Vote Center wait times on Election Day<\/a><\/li><\/ul><p><strong><em>Note:<\/em><\/strong><em>&nbsp;16 locations will offer emergency voting Oct. 31 and Nov. 2. <a href=\\"https://www.recorder.pima.gov/EarlyVotingSites\\">Check locations and hours<\/a>.<\/em><\/p><h2><strong>How to return an early ballot<\/strong><\/h2><p>Voters should no longer mail their early ballots. All early ballots must be received by 7 p.m. on Election Day to be counted.<\/p><p>Ballots can still be returned at designated early ballot drop-off locations, including 24/7 drop boxes, or at any Vote Center on Election Day.<\/p><p>Voters returning their own early ballots at a Vote Center also have the option of showing approved identification at an ID-Verified check-in table. This allows the ballot to bypass the signature verification process.<\/p><ul><li><a href=\\"https://www.pima.gov/how-to-return-your-early-ballot-in-pima-county\\">Find ballot drop-off locations and learn more about the options<\/a><\/li><\/ul><h2><strong>Follow Election Day turnout<\/strong><\/h2><p>Pima County provides an online dashboard showing voter turnout at Vote Centers throughout Election Day.<\/p><ul><li><a href=\\"https://updates.electionlink.net/widgets/pimaaz/2026-11-03/index.html\\">Follow Election Day turnout<\/a><\/li><\/ul><h2><strong>When will election results be available?<\/strong><\/h2><p>The first batch of unofficial election results is expected shortly after 8 p.m. on Nov. 3.<\/p><p>These results will consist of early ballots turned over from the Recorder&rsquo;s Office to the Elections Department through approximately midday Nov. 3. Additional results released throughout the night will include ballots cast in person at Vote Centers on Election Day or dropped off using the ID-verified process. Counting of those ballots is expected to continue into the early morning hours of Nov. 4.&nbsp;<\/p><p>Results will be available at:<\/p><ul><li><a href=\\"https://gcc02.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.livevoterturnout.com%2FENR%2Fpimaazenr%2F7%2Fen%2FIndex_7.html&data=05%7C02%7CAnthony.Gimino%40pima.gov%7C5f91503db8ce4a2c33c008df33c13b9c%7C33b6e2c30b1a4879b74147461a6c1a89%7C0%7C0%7C639286577329204170%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=5qTZWT9BE4h9Y%2F3jJ4uCmqLGS8%2BJPcY2GpuiR6zI5j4%3D&reserved=0\\">Pima County results<\/a><\/li><li><a href=\\"https://app.enhancedvoting.com/results/public/Arizona/elections/110326GeneralElection\\">Secretary of State&rsquo;s Arizona Election Results page<\/a><\/li><\/ul><h2><strong>Why will counting continue after Election Day?<\/strong><\/h2><p>Some early ballots returned close to the deadline must still undergo signature verification and processing before they can be counted. These include ballots received by mail, returned to drop boxes or dropped off at Vote Centers without ID verification.<\/p><p>Provisional ballots also must be reviewed to determine whether they can be counted.<\/p><p>Additional ballot counting is expected to resume Wednesday afternoon, Nov. 4, and continue in the days following the election.<\/p><p>The Recorder&rsquo;s Office has five days after Election Day to verify or resolve any issues with signatures.<\/p><h2><strong>When will results become official?<\/strong><\/h2><p>Election results remain unofficial until the Pima County Board of Supervisors approves the canvass of votes at a special meeting scheduled for Nov. 19.<\/p><h2><strong>Follow election updates<\/strong><\/h2><p>Pima County will post Election Day updates, alerts, responses and results on <a href=\\"https://www.threads.com/@pima_county\\">Threads<\/a>, <a href=\\"https://bsky.app/profile/pimacounty.bsky.social\\">Bluesky<\/a>, and <a href=\\"https://x.com/pimavote\\">X<\/a>.<\/p><p>For additional election information, visit <a href=\\"http://www.pima.vote/\\">pima.vote<\/a>.<\/p>"},"image":{"iv":["effa36b9-d171-40f0-830b-f5fb7fc7f2e6"]}},"titles":{"title":{"en":"Your guide to Election Day in Pima County: Voting, ballot drop-off and results"}},"searchFields":{"Date":{"iv":"2026-10-30T07:00:00Z"},"description":{"en":"<p data-pasted=\\"true\\">The 2026 General Election is Tuesday, Nov. 3, and Pima County has resources to help voters find a Vote Center, return an early ballot and follow election results.<\/p><p>Visit <a href=\\"https://www.pima.vote/\\">pima.vote<\/a> for voting information from the Pima County Recorder&#39;s Office and Elections Department.<\/p><h2><strong><img class=\\"fr-dii fr-fir\\" src=\\"https://content.civicplus.com/api/assets/az-pimacounty/2171cb80-8ff5-4b97-a7f8-6eb2dee2788d\\" style=\\"width: 347px;\\">Where to vote on Election Day<\/strong><\/h2><p>All 126 Pima County Vote Centers will be open from 6 a.m. to 7 p.m. on Nov. 3. Voters can cast their ballots at any Vote Center in the county, regardless of where they live. Anyone in line by 7 p.m. will be allowed to vote.<\/p><ul><li>Find a Vote Center: <a href=\\"https://experience.arcgis.com/experience/21445fb10f884caea0aac1ecba764599/page/English?views=Election-Day-Vote-Centers\\">Map of Vote Centers<\/a> | <a href=\\"https://docaccess.com/docviewer.html?url=https%3A%2F%2Fcontent.civicplus.com%2Fapi%2Fassets%2Faz-pimacounty%2Ff9990a8f-8ccc-45cf-9893-90bb2dd56e96&url_hash=b046040f4b576c690fbe543a605c0156&domain=pima.gov&site=a445fc5e-cbf4-4e87-afba-9c1902cbd811&found_on=https%3A%2F%2Fwww.pima.gov%2Fpima-votes%3Fpreview%3Dtrue\\">List of Vote Centers by region (PDF)<\/a><\/li><li>Look before you go: <a href=\\"https://updates.electionlink.net/widgets/pimaaz/2026-11-03/Vote%20Center%20Wait%20Times.html\\">Check Vote Center wait times on Election Day<\/a><\/li><\/ul><p><strong><em>Note:<\/em><\/strong><em>&nbsp;16 locations will offer emergency voting Oct. 31 and Nov. 2. <a href=\\"https://www.recorder.pima.gov/EarlyVotingSites\\">Check locations and hours<\/a>.<\/em><\/p><h2><strong>How to return an early ballot<\/strong><\/h2><p>Voters should no longer mail their early ballots. All early ballots must be received by 7 p.m. on Election Day to be counted.<\/p><p>Ballots can still be returned at designated early ballot drop-off locations, including 24/7 drop boxes, or at any Vote Center on Election Day.<\/p><p>Voters returning their own early ballots at a Vote Center also have the option of showing approved identification at an ID-Verified check-in table. This allows the ballot to bypass the signature verification process.<\/p><ul><li><a href=\\"https://www.pima.gov/how-to-return-your-early-ballot-in-pima-county\\">Find ballot drop-off locations and learn more about the options<\/a><\/li><\/ul><h2><strong>Follow Election Day turnout<\/strong><\/h2><p>Pima County provides an online dashboard showing voter turnout at Vote Centers throughout Election Day.<\/p><ul><li><a href=\\"https://updates.electionlink.net/widgets/pimaaz/2026-11-03/index.html\\">Follow Election Day turnout<\/a><\/li><\/ul><h2><strong>When will election results be available?<\/strong><\/h2><p>The first batch of unofficial election results is expected shortly after 8 p.m. on Nov. 3.<\/p><p>These results will consist of early ballots turned over from the Recorder&rsquo;s Office to the Elections Department through approximately midday Nov. 3. Additional results released throughout the night will include ballots cast in person at Vote Centers on Election Day or dropped off using the ID-verified process. Counting of those ballots is expected to continue into the early morning hours of Nov. 4.&nbsp;<\/p><p>Results will be available at:<\/p><ul><li><a href=\\"https://gcc02.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.livevoterturnout.com%2FENR%2Fpimaazenr%2F7%2Fen%2FIndex_7.html&data=05%7C02%7CAnthony.Gimino%40pima.gov%7C5f91503db8ce4a2c33c008df33c13b9c%7C33b6e2c30b1a4879b74147461a6c1a89%7C0%7C0%7C639286577329204170%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=5qTZWT9BE4h9Y%2F3jJ4uCmqLGS8%2BJPcY2GpuiR6zI5j4%3D&reserved=0\\">Pima County results<\/a><\/li><li><a href=\\"https://app.enhancedvoting.com/results/public/Arizona/elections/110326GeneralElection\\">Secretary of State&rsquo;s Arizona Election Results page<\/a><\/li><\/ul><h2><strong>Why will counting continue after Election Day?<\/strong><\/h2><p>Some early ballots returned close to the deadline must still undergo signature verification and processing before they can be counted. These include ballots received by mail, returned to drop boxes or dropped off at Vote Centers without ID verification.<\/p><p>Provisional ballots also must be reviewed to determine whether they can be counted.<\/p><p>Additional ballot counting is expected to resume Wednesday afternoon, Nov. 4, and continue in the days following the election.<\/p><p>The Recorder&rsquo;s Office has five days after Election Day to verify or resolve any issues with signatures.<\/p><h2><strong>When will results become official?<\/strong><\/h2><p>Election results remain unofficial until the Pima County Board of Supervisors approves the canvass of votes at a special meeting scheduled for Nov. 19.<\/p><h2><strong>Follow election updates<\/strong><\/h2><p>Pima County will post Election Day updates, alerts, responses and results on <a href=\\"https://www.threads.com/@pima_county\\">Threads<\/a>, <a href=\\"https://bsky.app/profile/pimacounty.bsky.social\\">Bluesky<\/a>, and <a href=\\"https://x.com/pimavote\\">X<\/a>.<\/p><p>For additional election information, visit <a href=\\"http://www.pima.vote/\\">pima.vote<\/a>.<\/p>"},"image":{"iv":["effa36b9-d171-40f0-830b-f5fb7fc7f2e6"]}},"created":"2026-10-30T21:37:17Z","lastModified":"2026-10-30T21:37:17Z","status":"UNIVERSAL > LOADING_COMPLETE","statusColor":"#4caf50","contentTypeName":"news","contentTypeDisplayName":"News","version":1,"contentTypeId":"49b6850a-b530-4e7e-a607-fbad45cdacae,news","tagsDeleted":[],"tags":["FeatureNews","Elections"],"categories":[{"id":"ea233dff-a4bf-4071-ab68-20fdf6e902ea","name":"Elections"}],"permissionSet":{"id":"cdad6e7f-0cef-4493-9fd2-f65211a002fe","name":"News","version":0,"lastModified":"1970-01-01T00:00:00Z","_links":{}},"isEncrypted":false,"_links":{"self":{"href":"/api/content/az-pimacounty/news/ea0debae-26d6-42e8-a06f-03f31662303e","method":"GET"},"previous":{"href":"/api/content/az-pimacounty/news/ea0debae-26d6-42e8-a06f-03f31662303e/0","method":"GET"}},"contentType":"news","templatedData":{"STACKED":{"seeMore":"","contentType":"News","id":"ea0debae-26d6-42e8-a06f-03f31662303e","lastModified":"","meta":{"ea0debae-26d6-42e8-a06f-03f31662303e":{"contentType":"news","isAsset":false,"isImage":false,"options":{}}},"newStatus":"","newStatusColor":"","scheduledJob":{},"status":"","statusColor":"","scheduleJob":{},"titleText":"Your guide to Election Day in Pima County: Voting, ballot drop-off and results","bodyText":"The 2026 General Election is Tuesday, Nov. 3, and Pima County has resources to help voters find a Vote Center, return an early ballot and follow election results.\\n\\nVisit pima.vote for voting information from the Pima County Recorder&#39;s Office and Elections Department.\\n\\nWHERE TO VOTE ON ELECTION DAY\\n\\nAll 126 Pima County Vote Centers will be open from 6 a.m. to 7 p.m. on Nov. 3. Voters can cast their ballots at any Vote Center in the county, regardless of where they live. Anyone in line by 7 p.m. will be allowed to vote.\\n\\n* Find a Vote Center: Map of Vote Centers | List of Vote Centers by region (PDF)\\n* Look before you go: Check Vote Center wait times on Election Day\\n\\nNote: 16 locations will offer emergency voting Oct. 31 and Nov. 2. Check locations and hours.\\n\\nHOW TO RETURN AN EARLY BALLOT\\n\\nVoters should no longer mail their early ballots. All early ballots must be received by 7 p.m. on Election Day to be counted.\\n\\nBallots can still be returned at designated early ballot drop-off locations, including 24/7 drop boxes, or at any Vote Center on Election Day.\\n\\nVoters returning their own early ballots at a Vote Center also have the option of showing approved identification at an ID-Verified check-in table. This allows the ballot to bypass the signature verification process.\\n\\n* Find ballot drop-off locations and learn more about the options\\n\\nFOLLOW ELECTION DAY TURNOUT\\n\\nPima County provides an online dashboard showing voter turnout at Vote Centers throughout Election Day.\\n\\n* Follow Election Day turnout\\n\\nWHEN WILL ELECTION RESULTS BE AVAILABLE?\\n\\nThe first batch of unofficial election results is expected shortly after 8 p.m. on Nov. 3.\\n\\nThese results will consist of early ballots turned over from the Recorder&rsquo;s Office to the Elections Department through approximately midday Nov. 3. Additional results released throughout the night will include ballots cast in person at Vote Centers on Election Day or dropped off using the ID-verified process. Counting of those ballots is expected to continue into the early morning hours of Nov. 4. \\n\\nResults will be available at:\\n\\n* Pima County results\\n* Secretary of State&rsquo;s Arizona Election Results page\\n\\nWHY WILL COUNTING CONTINUE AFTER ELECTION DAY?\\n\\nSome early ballots returned close to the deadline must still undergo signature verification and processing before they can be counted. These include ballots received by mail, returned to drop boxes or dropped off at Vote Centers without ID verification.\\n\\nProvisional ballots also must be reviewed to determine whether they can be counted.\\n\\nAdditional ballot counting is expected to resume Wednesday afternoon, Nov. 4, and continue in the days following the election.\\n\\nThe Recorder&rsquo;s Office has five days after Election Day to verify or resolve any issues with signatures.\\n\\nWHEN WILL RESULTS BECOME OFFICIAL?\\n\\nElection results remain unofficial until the Pima County Board of Supervisors approves the canvass of votes at a special meeting scheduled for Nov. 19.\\n\\nFOLLOW ELECTION UPDATES\\n\\nPima County will post Election Day updates, alerts, responses and results on Threads, Bluesky, and X.\\n\\nFor additional election information, visit pima.vote."}}},"b34a4273-40c7-4b1f-9969-018fb5e7bdc9":{"contentItemId":"b34a4273-40c7-4b1f-9969-018fb5e7bdc9","isLoading":false,"isPlaceholderItem":false,"id":"b34a4273-40c7-4b1f-9969-018fb5e7bdc9","slug":"federal-observers-to-monitor-pima-county-general-election","createdBy":"subject:e03b7a17-09af-4173-b298-4f3a441ab169","lastModifiedBy":"subject:e03b7a17-09af-4173-b298-4f3a441ab169","data":{"title":{"en":"Federal observers to monitor Pima County General Election"},"Date":{"iv":"2026-10-29T07:00:00Z"},"description":{"en":"<p data-pasted=\\"true\\">Pima County will have Department of Justice observers &ndash; typically referred to as monitors &ndash; during the Nov. 3 General Election, continuing a practice common in federal elections. Pima County elections has had federal monitoring of one type or another since the 1970s.<\/p><p>DOJ monitors have the authority to observe the voting process and are looking for compliance with the Voting Rights Act (VRA). &nbsp;<\/p><p>Under Section 203 of the VRA, Pima County is required to provide voting materials in both English and Spanish. Monitors check compliance with these language requirements, as well as accessibility requirements under the Americans with Disabilities Act.<\/p><p>Congressional observers have a different focus, concentrating more on the election process. Congressional observers in 2022 and 2024 arrived in Pima County after the election to observe ballot processing and tabulation.<\/p><p>Text from the State of Arizona <a href=\\"https://apps.azsos.gov/election/files/epm/2025/Election-Procedures-Manual-2025--FINAL-12-22-25.pdf\\" aria-describedby=\\"audioeye_pdf_message\\">Elections Procedures Manual<\/a> is below:<\/p><p><strong>F. Federal Observers<\/strong><\/p><p><strong>Congressional Observers:<\/strong><\/p><p>The U.S. House Committee administers an <a href=\\"https://cha.house.gov/election-observer-program\\">Election Observer Program<\/a> pursuant to the Elections Clause of Article I, &sect; 4 and the Judging Clause of Article I, &sect; 5. In 2024, the program was put into law as the Confirmation of Congressional Observer Access Act of 2024 (&ldquo;COCOA Act&rdquo;).&nbsp;<\/p><p>Under the Act, a designated Congressional observer is an individual who is designated in writing by the chair or ranking minority member of the Committee on House Administration of the House of Representatives or the Committee on Rules and Administration of the Senate.<\/p><p>Congressional observers are meant to gather information with respect to Congressional elections.&nbsp;<\/p><p>The COCOA Act requires the election facility to provide Congressional observers with full access to clearly observe the election administration process including at 1) polling places; 2) locations where ballots are processed, tabulated, cast, and canvassed; and, 3) areas where voter registration activities occur before the election. No Congressional observer may handle or touch ballots or election equipment (voting or non-voting). They may not advocate for a position or candidate, take any action to reduce ballot secrecy, or otherwise interfere with the elections administration process. Congressional observers must provide written credentials prior to the election.<\/p><p><strong>Department of Justice (DOJ) Observers:<\/strong><\/p><p>The Voting Rights Act under Section 3(a), permits federal observers to monitor procedures in polling places and at sites where ballots are counted in eligible political subdivisions. The DOJ Civil Rights Division determines whether federal observers are needed in an eligible jurisdiction. These observers must provide written credentials prior to the election and be allowed the same access as political party observers.<\/p>"},"image":{"iv":[]}},"titles":{"title":{"en":"Federal observers to monitor Pima County General Election"}},"searchFields":{"Date":{"iv":"2026-10-29T07:00:00Z"},"description":{"en":"<p data-pasted=\\"true\\">Pima County will have Department of Justice observers &ndash; typically referred to as monitors &ndash; during the Nov. 3 General Election, continuing a practice common in federal elections. Pima County elections has had federal monitoring of one type or another since the 1970s.<\/p><p>DOJ monitors have the authority to observe the voting process and are looking for compliance with the Voting Rights Act (VRA). &nbsp;<\/p><p>Under Section 203 of the VRA, Pima County is required to provide voting materials in both English and Spanish. Monitors check compliance with these language requirements, as well as accessibility requirements under the Americans with Disabilities Act.<\/p><p>Congressional observers have a different focus, concentrating more on the election process. Congressional observers in 2022 and 2024 arrived in Pima County after the election to observe ballot processing and tabulation.<\/p><p>Text from the State of Arizona <a href=\\"https://apps.azsos.gov/election/files/epm/2025/Election-Procedures-Manual-2025--FINAL-12-22-25.pdf\\" aria-describedby=\\"audioeye_pdf_message\\">Elections Procedures Manual<\/a> is below:<\/p><p><strong>F. Federal Observers<\/strong><\/p><p><strong>Congressional Observers:<\/strong><\/p><p>The U.S. House Committee administers an <a href=\\"https://cha.house.gov/election-observer-program\\">Election Observer Program<\/a> pursuant to the Elections Clause of Article I, &sect; 4 and the Judging Clause of Article I, &sect; 5. In 2024, the program was put into law as the Confirmation of Congressional Observer Access Act of 2024 (&ldquo;COCOA Act&rdquo;).&nbsp;<\/p><p>Under the Act, a designated Congressional observer is an individual who is designated in writing by the chair or ranking minority member of the Committee on House Administration of the House of Representatives or the Committee on Rules and Administration of the Senate.<\/p><p>Congressional observers are meant to gather information with respect to Congressional elections.&nbsp;<\/p><p>The COCOA Act requires the election facility to provide Congressional observers with full access to clearly observe the election administration process including at 1) polling places; 2) locations where ballots are processed, tabulated, cast, and canvassed; and, 3) areas where voter registration activities occur before the election. No Congressional observer may handle or touch ballots or election equipment (voting or non-voting). They may not advocate for a position or candidate, take any action to reduce ballot secrecy, or otherwise interfere with the elections administration process. Congressional observers must provide written credentials prior to the election.<\/p><p><strong>Department of Justice (DOJ) Observers:<\/strong><\/p><p>The Voting Rights Act under Section 3(a), permits federal observers to monitor procedures in polling places and at sites where ballots are counted in eligible political subdivisions. The DOJ Civil Rights Division determines whether federal observers are needed in an eligible jurisdiction. These observers must provide written credentials prior to the election and be allowed the same access as political party observers.<\/p>"},"image":{"iv":[]}},"created":"2026-10-29T23:08:01Z","lastModified":"2026-10-29T23:08:01Z","status":"UNIVERSAL > LOADING_COMPLETE","statusColor":"#4caf50","contentTypeName":"news","contentTypeDisplayName":"News","version":1,"contentTypeId":"49b6850a-b530-4e7e-a607-fbad45cdacae,news","tagsDeleted":[],"tags":["Elections"],"categories":[{"id":"ea233dff-a4bf-4071-ab68-20fdf6e902ea","name":"Elections"}],"permissionSet":{"id":"cdad6e7f-0cef-4493-9fd2-f65211a002fe","name":"News","version":0,"lastModified":"1970-01-01T00:00:00Z","_links":{}},"isEncrypted":false,"_links":{"self":{"href":"/api/content/az-pimacounty/news/b34a4273-40c7-4b1f-9969-018fb5e7bdc9","method":"GET"},"previous":{"href":"/api/content/az-pimacounty/news/b34a4273-40c7-4b1f-9969-018fb5e7bdc9/0","method":"GET"}},"contentType":"news","templatedData":{"STACKED":{"thumbnail":null,"seeMore":"","contentType":"News","id":"b34a4273-40c7-4b1f-9969-018fb5e7bdc9","lastModified":"","meta":{"b34a4273-40c7-4b1f-9969-018fb5e7bdc9":{"contentType":"news","isAsset":false,"isImage":false,"options":{}}},"newStatus":"","newStatusColor":"","scheduledJob":{},"status":"","statusColor":"","scheduleJob":{},"titleText":"Federal observers to monitor Pima County General Election","bodyText":"Pima County will have Department of Justice observers &ndash; typically referred to as monitors &ndash; during the Nov. 3 General Election, continuing a practice common in federal elections. Pima County elections has had federal monitoring of one type or another since the 1970s.\\n\\nDOJ monitors have the authority to observe the voting process and are looking for compliance with the Voting Rights Act (VRA).  \\n\\nUnder Section 203 of the VRA, Pima County is required to provide voting materials in both English and Spanish. Monitors check compliance with these language requirements, as well as accessibility requirements under the Americans with Disabilities Act.\\n\\nCongressional observers have a different focus, concentrating more on the election process. Congressional observers in 2022 and 2024 arrived in Pima County after the election to observe ballot processing and tabulation.\\n\\nText from the State of Arizona Elections Procedures Manual is below:\\n\\nF. Federal Observers\\n\\nCongressional Observers:\\n\\nThe U.S. House Committee administers an Election Observer Program pursuant to the Elections Clause of Article I, &sect; 4 and the Judging Clause of Article I, &sect; 5. In 2024, the program was put into law as the Confirmation of Congressional Observer Access Act of 2024 (&ldquo;COCOA Act&rdquo;). \\n\\nUnder the Act, a designated Congressional observer is an individual who is designated in writing by the chair or ranking minority member of the Committee on House Administration of the House of Representatives or the Committee on Rules and Administration of the Senate.\\n\\nCongressional observers are meant to gather information with respect to Congressional elections. \\n\\nThe COCOA Act requires the election facility to provide Congressional observers with full access to clearly observe the election administration process including at 1) polling places; 2) locations where ballots are processed, tabulated, cast, and canvassed; and, 3) areas where voter registration activities occur before the election. No Congressional observer may handle or touch ballots or election equipment (voting or non-voting). They may not advocate for a position or candidate, take any action to reduce ballot secrecy, or otherwise interfere with the elections administration process. Congressional observers must provide written credentials prior to the election.\\n\\nDepartment of Justice (DOJ) Observers:\\n\\nThe Voting Rights Act under Section 3(a), permits federal observers to monitor procedures in polling places and at sites where ballots are counted in eligible political subdivisions. The DOJ Civil Rights Division determines whether federal observers are needed in an eligible jurisdiction. These observers must provide written credentials prior to the election and be allowed the same access as political party observers."}}}},"options":{"autoPopulate":true,"optionSetId":1,"autoAdjust":true,"removePastDates":true,"hidePlaceholders":false,"skinId":64,"widgetFormat":"STACKED","presetId":"STACKED_PRESET","viewAllRadioOption":"default","selectedSortDisplayName":"Newest First","categories":["ea233dff-a4bf-4071-ab68-20fdf6e902ea"],"contentTypeNames":["news"],"tags":[],"numItems":2,"sortBy":"BY_LAST_MODIFIED","sortDirection":"DESCENDING","numberOfColumns":2,"truncateDescription":true,"header":"Election News","includedAssetTypes":{"images":false,"pdfs":true,"otherFiles":false}},"itemsUnableToRender":[],"formatConfigurations":{"STACKED":{"news":{"title":"{{title}}","body":"{{description}}","sectionOptions":{"secondary":{"showLabel":false},"body":{"showLabel":false},"thumbnail":{"scale":400},"title":{},"seeMore":{},"itemDetails":{}},"thumbnail":"{{image}}","fieldRenderOptions":{"image":{},"Date":{"showLabel":false},"description":{"showLabel":false}},"secondary":"{{Date}}"}}},"status":"UNIVERSAL > LOADING","columns":[["e735c6d0-802a-4e09-9299-9fbac59e5faa"]],"autoPopulatedContentItems":["ea0debae-26d6-42e8-a06f-03f31662303e","b34a4273-40c7-4b1f-9969-018fb5e7bdc9"],"manualContentItemIds":["e735c6d0-802a-4e09-9299-9fbac59e5faa"],"manualContentItemsOptions":{"e735c6d0-802a-4e09-9299-9fbac59e5faa":{"contentType":"news","isAsset":false,"isImage":false,"options":{}}},"filterOptions":{},"autoPopulatedTotalResults":45},"b74d1