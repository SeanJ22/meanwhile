.widget.skin43 a:link { color: #0077c8; text-decoration: underline; }.widget.skin43 .widgetItem--image a[href].widgetImage--link img.widgetImage--image {
    border-radius: 10px;
    border: 2px solid #dddddd;
    box-shadow: .3px .5px .7px rgba(10, 52, 62, .06), .4px .8px 1px -1.2px rgba(10, 52, 62, .16), 1px 2px 2.5px -2.5px rgba(10, 52, 62, .26); }
.widget.skin43 a:visited { color: #0077c8;  }
.widget.skin43 a:hover, .widget.skin43 a:focus, .widget.skin43 a:active { color: #005786; text-decoration: underline; }.widget.skin43 .widgetItem--image a[href].widgetImage--link img.widgetImage--image:hover, .widget.skin43 .widgetItem--image a[href].widgetImage--link img.widgetImage--image:active, .widget.skin43 .widgetItem--image a[href].widgetImage--link img.widgetImage--image:focus   {
    border: 2px solid #0077c8;
    box-shadow: 2px 2px 4px cornflowerblue; }
.widget.skin43 .readOn:link { text-decoration: underline; display: inline;  }
.widget.skin43 .readOn:visited {  }
.widget.skin43 .readOn:hover, .widget.skin43 .readOn:focus, .widget.skin43 .readOn:active { text-decoration: underline;  }
.widget.skin43 .widgetViewAll:link { color: #005786;  margin-top: 1em; font-family: 'Open Sans'; font-style:normal; font-weight:400; text-decoration: none; background-color: #fff; 
transition: 0.6s cubic-bezier(0.68, -0.6, 0.32, 1.6);
display: table;
margin: 1.25em auto;
padding-top:1em;
padding-bottom:1em;
margin-top:.5em;
text-align:center;
width: 200px;
border-radius: 5px;
border: 1px solid #f2f2f2;
box-shadow: 0.3px 0.5px 0.7px rgba(10, 52, 62,0.06), 
0.4px 0.8px 1px -1.2px rgba(10, 52, 62,0.16),
1px 2px 2.5px -2.5px rgba(10, 52, 62,0.26); }
.widget.skin43 .widgetViewAll:visited { color: #005786; background-color: #fff; 
margin: 1.25em auto;
border: 1px solid #f2f2f2; }
.widget.skin43 .widgetViewAll:hover, .widget.skin43 .widgetViewAll:focus, .widget.skin43 .widgetViewAll:active { color: #fffffe; text-decoration: underline; width: 250px;
border: 1px solid #0077C8;
background:#004F84;
transition: 0.6s cubic-bezier(0.68, -0.6, 0.32, 1.6);
box-shadow: 0.3px 0.5px 0.7px rgba(10, 52, 62,0.06),
0.9px 1.8px 2.3px -0.3px rgba(10, 52, 62,0.06),
1.6px 3.1px 3.9px -0.6px rgba(10, 52, 62,0.06),
2.3px 4.7px 5.9px -0.8px rgba(10, 52, 62,0.06),
3.4px 6.7px 8.5px -1.1px rgba(10, 52, 62,0.06),
4.8px 9.6px 12.1px -1.4px rgba(10, 52, 62,0.06),
6.8px 13.6px 17.1px -1.7px rgba(10, 52, 62,0.06),
9.5px 19px 23.9px -1.9px rgba(10, 52, 62,0.06),
13px 26px 32.7px -2.2px rgba(10, 52, 62,0.06),
17.5px 35px 44px -2.5px rgba(10, 52, 62,0.06);  }
.widget.skin43 .widgetRSS:link { text-decoration: none;  }
.widget.skin43 .widgetRSS:visited {  }
.widget.skin43 .widgetRSS:hover, .widget.skin43 .widgetRSS:focus, .widget.skin43 .widgetRSS:active { text-decoration: none;  }
.widget.skin43 .widgetFooter {  border: 0 none ; font-style:normal; font-weight:400;  }
.widget.skin43 .cpTabs {  border-bottom: 0 solid ;  }
.widget.skin43 .cpTabs > li > a:link, .widget.skin43 .cpTabs > li > a:visited {  background-color: #ffffff;  border: 0 none ;  padding-top: 0.75em;  padding-right: 0.5em;  padding-bottom: 0.75em;  padding-left: 2.5em; font-family: 'Roboto Slab'; font-style:normal; font-weight:400; color: #383838; font-size: 1.2em; box-shadow: 3px 3px 13px 0px rgba(60, 25, 60, 0.11);
transition:.5s ease-in-out;
box-shadow:inset 0px 2px 6px 0px rgba(0,0,0,0.1);
position:relative;
text-align: left;
border-radius: 5px;
margin: 0 .5em;
}
.widget.skin43 .cpTabs > li > a:link:after, .widget.skin43 .cpTabs > li > a:visited:after{
background-image:url(https://content.civicplus.com/api/assets/d028fea2-36f4-47e5-a3c5-2f11385544cc);
background-repeat:no-repeat;
background-position:center center;
    -webkit-transform:rotate(180deg);
    -moz-transform:rotate(180deg);
background-size:8px;
position:absolute;
height:40px;
width:40px;
content:'';
left:.35em;
top:0;
bottom:0;
margin:auto 0;
z-index:1!important;
transition:.5s ease-in-out;
}
@media(max-width:35em){
.widget.skin43 .cpTabs > li > a:link, .widget.skin80 .cpTabs > li > a:visited{
margin-top:.5em;
margin-bottom:.5em;
} }
.widget.skin43 .cpTabs > li > a:hover, .widget.skin43 .cpTabs > li > a:focus, .widget.skin43 .cpTabs > li > a:active {  background-color: #005786;  border: 0 none ; color: #ffffff; text-decoration: underline !important;box-shadow:0px 2px 10px 0px rgba(0,0,0,0.4);
}
.widget.skin43 .cpTabs > li > a:hover:after, .widget.skin43 .cpTabs > li > a:active:after{
background-image:url(https://content.civicplus.com/api/assets/6e64e89d-863b-48d4-9ab9-b022ce38fc97);
transition:.2s ease-in-out;
background-repeat:no-repeat;
background-position:center center;
-webkit-transform:rotate(-90deg);
-moz-transform:rotate(-90deg);
background-size:10px;
position:absolute;
height:40px;
width:40px;
content:'';
left:.35em;
top:0;
bottom:0;
margin:auto 0;
z-index:1!important;
transition:.3s ease-in-out; }
.widget.skin43 .cpTabs > li > a{margin-left: 0;;margin-right: 0; }
.widget.skin43 .cpTabs.alignRight > li > a{margin-left: 0;margin-right: 0;; }
.widget.skin43 .cpTabs > li.active > a {  background-color: #0077c8;  border: 0 none ; color: #fffffe; box-shadow:0px 2px 10px 0px rgba(0,0,0,0.3);
}
.widget.skin43 .cpTabs > li.active > a:after{
position:absolute;
height:40px;
width:40px;
content:'';
left:.35em;
top:0;
bottom:0;
margin:auto 0;
background-image:url(https://content.civicplus.com/api/assets/8b3cec67-82cf-4bd0-a28c-d1035504a9eb);
background-repeat:no-repeat;
background-position:center center;
background-size:13px;
z-index:1!important;
transition:0s ease-in-out;
    -webkit-transform:rotate(0deg);
    -moz-transform:rotate(0deg);
}
.widget.skin43 .cpTabs > li.active > a:hover:after{
    -webkit-transform:rotate(0deg);
    -moz-transform:rotate(0deg);
}
.widget.skin43 .cpTabs > li.active > a:focus:after{
    -webkit-transform:none;
    -moz-transform:none; }
.widget.skin43 .cpTabPanel {  border: 0 none ;  padding-top: 0.75em;  padding-right: 0.75em;  padding-left: 0.75em; /* Container query to remove padding for tabs panel on mobile */
.widget.skin43 .widgetTabbed .cpTabPanels {
  container: tabPanel / inline-size;
  @container (max-width: 425px) {
    div.cpTabPanel {
      padding: 0;
    }
  }
} }
.widget.skin43 .separated .half:after,.widget.skin43 .separated .third:after,.widget.skin43 .separated .fourth:after,.widget.skin43 .separated .fifth:after,.widget.skin43 .separated.cpGrid .col:after  {  background-color: #ccc; width: 1px; }
