/* subscription box tab order fix - start */
!function () {
  "use strict";
    function resetTabOrder() { document.body.tabIndex = -1; document.body.focus({preventScroll: true}); }
    function modifyCloseButtons() {
        const closeClasses = ["prefix-overlay-action-later", "prefix-overlay-action-dismiss", "prefix-big"]; 
        const btnList = document.getElementsByTagName('button'); 
        for (var currBtn of btnList) {
            var currBtnClassList = currBtn.classList; 
            for (var closeClass of closeClasses) {
                if (currBtnClassList.contains(closeClass)) {
                    currBtn.addEventListener('click', resetTabOrder); } } } }
    var observer = null;
    function stopObserving() { if (observer) { observer.disconnect(); observer = null; } }
    function startObserving() {
        observer = new MutationObserver(
              function (mutations) {
                    var checker = document.getElementsByClassName("prefix-overlay-action-later");
                    if (checker.length > 0) { modifyCloseButtons(); stopObserving(); } } );
        const config = { childList: true, subtree: true };
        observer.observe(document.body, config);
        setTimeout(stopObserving, 5000);  }
    if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", startObserving); }
    else { startObserving(); }
}();
/* subscription box tab order fix - end*/

/* removing hidden google translate form - start */
!function() {
    "use strict";
    var observer = null;
    function stopObserving() { if (observer) { observer.disconnect; observer = null; } }
    function startObserving() {
        observer = new MutationObserver(
        function() {
            var form = document.getElementById("goog-gt-votingHiddenPane");
            if (form) { form.remove(); stopObserving(); } });
        var config = { childList: true, subtree: true }
        observer.observe(document.body, config);
        setTimeout(stopObserving, 5000);}
    if (document.readState == "loading") {
        window.addEventListener("DOMContentLoaded", startObserving)
    } else { startObserving(); }
}();
/* removing hidden google translate form - end */



