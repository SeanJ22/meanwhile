Color":"#4caf50","contentTypeName":"agendasandminutes","contentTypeDisplayName":"Agendas & Minutes","version":2,"contentTypeId":"cefd9397-5bc0-4ee2-8eb2-d7924714e1d1,agendasandminutes","tagsDeleted":[],"tags":["2026"],"categories":[{"id":"53dd6594-9765-4c20-a5b0-498ee56618d0","name":"Election Integrity Commission"}],"permissionSet":{"id":"f7b0a10d-814d-42f5-8014-fd1b6e633627","name":"Agendas and Minutes","version":0,"lastModified":"1970-01-01T00:00:00Z","_links":{}},"notificationDetails":{"subject":"A modification to a Agendas & Minutes has been made!","smsMessage":"A modification to a Agendas & Minutes has been made!"},"isEncrypted":false,"emailAddresses":[],"_links":{"self":{"href":"/api/content/az-pimacounty/agendasandminutes/d3ec4fa8-70c5-4850-bc9f-9cb341a59f3c","method":"GET"},"previous":{"href":"/api/content/az-pimacounty/agendasandminutes/d3ec4fa8-70c5-4850-bc9f-9cb341a59f3c/1","method":"GET"}},"contentType":"agendasandminutes","contentItemId":"d3ec4fa8-70c5-4850-bc9f-9cb341a59f3c"},"e40717d0-1fef-42e9-83e1-87ad22f14a05":{"id":"e40717d0-1fef-42e9-83e1-87ad22f14a05","slug":"url-2060-running-a-business-displayname-business-openinnewwindow-false","createdBy":"subject:e584c05f-c96e-42f9-b110-00f241f2734f","lastModifiedBy":"subject:0af359d4-1a43-4686-9ce7-ca4bf83118c8","data":{"link":{"en":{"url":"/2060/Running-a-Business","displayName":"Business","openInNewWindow":false}},"Image":{"iv":[]}},"titles":{"link":{"en":{"url":"/2060/Running-a-Business","displayName":"Business","openInNewWindow":false}}},"searchFields":{"Image":{"iv":[]}},"created":"2023-01-05T15:09:28Z","lastModified":"2023-02-08T15:39:58Z","status":"Published","statusColor":"#4caf50","contentTypeName":"link","contentTypeDisplayName":"Link","version":4,"contentTypeId":"4fa38a05-cef4-4abb-8e1a-69cc7588e399,link","tagsDeleted":[],"tags":["TopLinks","Search","Business"],"categories":[],"permissionSet":{"id":"3f4e5862-747a-4b93-97f0-a7c11fac832e","name":"Link","version":0,"lastModified":"1970-01-01T00:00:00Z","_links":{}},"notificationDetails":{"subject":"A modification to a Link has been made!","smsMessage":"A modification to a Link has been made!"},"isEncrypted":false,"emailAddresses":[],"_links":{"self":{"href":"/api/content/az-pimacounty/link/e40717d0-1fef-42e9-83e1-87ad22f14a05","method":"GET"},"previous":{"href":"/api/content/az-pimacounty/link/e40717d0-1fef-42e9-83e1-87ad22f14a05/3","method":"GET"}},"contentType":"link","contentItemId":"e40717d0-1fef-42e9-83e1-87ad22f14a05"},"ea7dabbc-c3b6-44f9-ad88-56434492bdc7":{"id":"ea7dabbc-c3b6-44f9-ad88-56434492bdc7","slug":"elections-mockup","createdBy":"subject:af31c080-e877-4679-a806-b9ec4e1e03bd","lastModifiedBy":"subject:4cd862b5-5582-48be-a5bb-5fd99fb6400f","data":{"name":{"en":"Elections (mockup)"},"article":{"en":"<h2>Pima County Elections Department<\/h2><p>Welcome to the Pima County Elections Department. Our mission is to ensure the accessibility, accuracy, and integrity of the electoral process by providing greater transparency to our constituents, candidates, and stakeholders while maintaining the safety and security of the election and our staff. Under the direction of the Board of Supervisors and County Administration, the Elections Department works closely with the Recorder&#39;s Office to administer and coordinate all elections in accordance with Arizona Revised Statutes.<\/p><p>Your go-to resource for all things related to upcoming elections. Here, you&rsquo;ll find essential information about candidates, key issues, and voting procedures to help you make informed decisions.<\/p><p>Join us in empowering your community through knowledge and participation. Together, let&rsquo;s make every vote count!<\/p><h2 data-pasted=\\"true\\">Public Records Requests&nbsp;<\/h2><p>The public may submit public records requests for Elections Department records by submitting a request through the Pima County Clerk of the Board&#39;s <a href=\\"https://pimacountyaz.mycusthelp.com/WEBAPP/_rs/(S(0v5fzykjy3ffmk0ae2max4fq))/supporthome.aspx\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\" aria-describedby=\\"audioeye_new_window_message\\">online request portal.<\/a>&nbsp;<\/p><p><br><\/p><h2>2026 Election and Voter Information<\/h2>"}},"titles":{"name":{"en":"Elections (mockup)"}},"searchFields":{"article":{"en":"<h2>Pima County Elections Department<\/h2><p>Welcome to the Pima County Elections Department. Our mission is to ensure the accessibility, accuracy, and integrity of the electoral process by providing greater transparency to our constituents, candidates, and stakeholders while maintaining the safety and security of the election and our staff. Under the direction of the Board of Supervisors and County Administration, the Elections Department works closely with the Recorder&#39;s Office to administer and coordinate all elections in accordance with Arizona Revised Statutes.<\/p><p>Your go-to resource for all things related to upcoming elections. Here, you&rsquo;ll find essential information about candidates, key issues, and voting procedures to help you make informed decisions.<\/p><p>Join us in empowering your community through knowledge and participation. Together, let&rsquo;s make every vote count!<\/p><h2 data-pasted=\\"true\\">Public Records Requests&nbsp;<\/h2><p>The public may submit public records requests for Elections Department records by submitting a request through the Pima County Clerk of the Board&#39;s <a href=\\"https://pimacountyaz.mycusthelp.com/WEBAPP/_rs/(S(0v5fzykjy3ffmk0ae2max4fq))/supporthome.aspx\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\" aria-describedby=\\"audioeye_new_window_message\\">online request portal.<\/a>&nbsp;<\/p><p><br><\/p><h2>2026 Election and Voter Information<\/h2>"}},"created":"2024-10-15T18:01:57Z","lastModified":"2026-10-26T16:36:09Z","status":"Published","statusColor":"#4caf50","contentTypeName":"article","contentTypeDisplayName":"Article","version":9,"contentTypeId":"b3d073e4-61c9-4ef8-bd47-543a8c94e32f,article","tagsDel