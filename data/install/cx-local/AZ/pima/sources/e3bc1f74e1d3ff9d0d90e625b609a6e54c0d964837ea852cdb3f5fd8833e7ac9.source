assets/az-pimacounty/{{id}}"},"userToken":null},"contentCollectionId":"e61ca429-c5b8-4616-a310-48f7a97885bc","liveEditContentTab":{"renderKey":"LIVE_EDIT > CONTENT_TAB > ADD_CONTENT","content":{"cardList":{"items":[],"templatedItems":[],"searchTerm":"","filterOptionsOpen":false,"pageSize":10,"loadMargin":5,"endOfList":false,"status":"IDLE","statusError":null,"predefinedItems":[],"designWidgetItems":[],"designWidgetTemplatedItems":[],"selectedItems":[],"pageNumber":0,"fetchedPages":[]}},"contentOptions":{"tab":"TAB_CONTENT","widgetId":null,"currentWidgetFormat":"STACKED","onLoad":null,"savingOptionsLocked":false,"configuration":{},"sortOptions":[],"designTab":{"button":{"selectedStyleSection":"OuterBackground"},"dirtySkins":[]},"optionsTab":{"optionSetId":1}},"contentPanelHcms":{"data":{}}},"contentTemplateBuilder":{"isActive":false,"contentTypeId":null,"drawerMode":"tools","wrappers":[],"initialWrappers":[],"editingTarget":null,"hoveredLayerId":null},"widgets":{"universal":{"2902f718-2234-42c5-945f-8a034b79d7a2":{"isInitialized":true,"widgetId":"2902f718-2234-42c5-945f-8a034b79d7a2","contentItems":{"33bf660c-46ef-47d2-9cc2-aa2a7d07aff4":{"contentItemId":"33bf660c-46ef-47d2-9cc2-aa2a7d07aff4","isLoading":false,"isPlaceholderItem":false,"contentType":"article","id":"33bf660c-46ef-47d2-9cc2-aa2a7d07aff4","slug":"make-a-plan-to-vote-at-pima-vote","createdBy":"subject:e03b7a17-09af-4173-b298-4f3a441ab169","lastModifiedBy":"subject:e03b7a17-09af-4173-b298-4f3a441ab169","data":{"name":{"en":"Make a plan to vote at pima.vote"},"article":{"en":"<h2 data-pasted=\\"true\\">Make a plan to vote at pima.vote<\/h2><p>Visit <a href=\\"http://www.pima.vote\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\" aria-describedby=\\"audioeye_new_window_message\\">pima.vote<\/a>, Pima County&rsquo;s hub for election and voting information, combining resources from the Elections Department and the Recorder&rsquo;s Office. Find important dates and deadlines, registration information, voting options and more. Explore the <a href=\\"https://experience.arcgis.com/experience/21445fb10f884caea0aac1ecba764599/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\" aria-describedby=\\"audioeye_new_window_message\\">interactive map<\/a> to find the most convenient Vote Centers, early voting sites and ballot drop-off locations.<\/p><p>Voters who are unable to leave their vehicles can vote curbside at <a href=\\"https://content.civicplus.com/api/assets/az-pimacounty/b18fecdf-2291-407f-9fbc-9551c7e06719\\" target=\\"_blank\\" aria-describedby=\\"audioeye_new_window_message\\" rel=\\"noopener noreferrer\\">21 Pima County Vote Centers (PDF)<\/a> on Election Day, Nov. 3.<\/p>"}},"titles":{"name":{"en":"Make a plan to vote at pima.vote"}},"searchFields":{"article":{"en":"<h2 data-pasted=\\"true\\">Make a plan to vote at pima.vote<\/h2><p>Visit <a href=\\"http://www.pima.vote\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\" aria-describedby=\\"audioeye_new_window_message\\">pima.vote<\/a>, Pima County&rsquo;s hub for election and voting information, combining resources from the Elections Department and the Recorder&rsquo;s Office. Find important dates and deadlines, registration information, voting options and more. Explore the <a href=\\"https://experience.arcgis.com/experience/21445fb10f884caea0aac1ecba764599/\\" target=\\"_blank\\" rel=\\"noopener noreferrer\\" aria-describedby=\\"audioeye_new_window_message\\">interactive map<\/a> to find the most convenient Vote Centers, early voting sites and ballot drop-off locations.<\/p><p>Voters who are unable to leave their vehicles can vote curbside at <a href=\\"https://content.civicplus.com/api/assets/az-pimacounty/b18fecdf-2291-407f-9fbc-9551c7e06719\\" target=\\"_blank\\" aria-describedby=\\"audioeye_new_window_message\\" rel=\\"noopener noreferrer\\">21 Pima County Vote Centers (PDF)<\/a> on Election Day, Nov. 3.<\/p>"}},"created":"2026-09-18T18:48:05Z","lastModified":"2026-10-15T22:02:43Z","status":"UNIVERSAL > LOADING_COMPLETE","statusColor":"#4caf50","contentTypeName":"article","contentTypeDisplayName":"Article","version":4,"contentTypeId":"b3d073e4-61c9-4ef8-bd47-543a8c94e32f,article","tagsDeleted":[],"tags":["Elections"],"categories":[{"id":"ea233dff-a4bf-4071-ab68-20fdf6e902ea","name":"Elections"}],"permissionSet":{"id":"06f7b6d6-092b-4bee-8b9a-c3e45a10aeda","name":"Article","version":0,"lastModified":"1970-01-01T00:00:00Z","_links":{}},"notificationDetails":{"subject":"A modification to a Article has been made!","smsMessage":"A modification to a Article has been made!"},"isEncrypted":false,"emailAddresses":[],"_links":{"self":{"href":"/api/content/az-pimacounty/article/33bf660c-46ef-47d2-9cc2-aa2a7d07aff4","method":"GET"},"previous":{"href":"/api/content/az-pimacounty/article/33bf660c-46ef-47d2-9cc2-aa2a7d07aff4/3","method":"GET"}},"templatedData":{"STACKED":{"title":null,"secondary":null,"thumbnail":null,"seeMore":"","contentType":"Article","id":"33bf660c-46ef-47d2-9cc2-aa2a7d07aff4","lastModified":"","meta":{"33bf660c-46ef-47d2-9cc2-aa2a7d07aff4":{"contentType":"article","isAsset":false,"isImage":false,"options":{}}},"newStatus":"","newStatusColor":"","scheduledJob":{},"status":"","statusColor":"","scheduleJob":{},"titleText":"","bodyText":"MAKE A PLAN TO VOTE AT PIMA.VOTE\\n\\nVisit pima.vote, Pima County&rsquo;s hub for election and voting information, combining resources from the Elections Department and the Recorder&rsquo;s Office. Find important dates and deadlines, registration information, voting options and more. Explore the interactive map to find the most convenient Vote Centers, early voting sites and ballot drop-off locations.\\n\\nVoters who are unable to leave their vehicles can vote curbside at 21 Pima County Vote Centers (PDF) on Election Day, Nov. 3."}}}},"options":{"autoPopulate":false,"optionSetId":1,"autoAdjust":true,"removePastDates":true,"hidePlaceholders":false,"skinId":125,"widgetFormat":"STACKED","presetId":"STACKED_PRESET","viewAllRadioOptio