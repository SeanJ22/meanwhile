	<li class="topMenuItem sideNavLi hasAccordionChildren" role="menuitem" tabindex="-1" id="SideItem202" data-pageid="202">
		<div class="accordionNavItem">
			<a href="/202/Candidate-Information" target="_self" class="navMainItem secondaryNavItem cpComponent" data-type="SecondaryMainItem">Candidate Information</a>
