					--><li class="" role="presentation">	<a href="#tab161b9142-f5cd-4bf9-af49-d789cbe256bd_2" class="tabButton" id="tabBtn161b9142-f5cd-4bf9-af49-d789cbe256bd_2" role="tab" aria-controls="tab161b9142-f5cd-4bf9-af49-d789cbe256bd_2" aria-selected="false" tabindex="-1"><span class="tabName editable" data-sequence="2" data-tabname="简体中文" contenteditable="false">简体中文</span></a>
</li><!--
					--><li class="" role="presentation">	<a href="#tab161b9142-f5cd-4bf9-af49-d789cbe256bd_3" class="tabButton" id="tabBtn161b9142-f5cd-4bf9-af49-d789cbe256bd_3" role="tab" aria-controls="tab161b9142-f5cd-4bf9-af49-d789cbe256bd_3" aria-selected="false" tabindex="-1"><span class="tabName editable" data-sequence="3" data-tabname="Tagalog" contenteditable="false">Tagalog</span></a>
</li><!--
