window.onload = function() {
    var socialShareButton = document.querySelector('.social_share__desktop_button');
    socialShareButton.addEventListener('click', function() {        
        
            var socialBtnClasses =  socialShareButton.classList
            var isExpanded = socialShareButton.getAttribute('aria-expanded')

            if (socialBtnClasses.contains('active')) {
                return socialShareButton.setAttribute('aria-expanded', true)
            } 
            return socialShareButton.setAttribute('aria-expanded', false) 
    })
}


