                    <td>Start of Nomination Period for the November 3, 2026 General Election</td> 
                    <td>July 13, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Regional Transit Measure Direct Argument Deadline for the November 3, 2026 General Election</td> 
                    <td>August 04, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>End of Nomination Period for the November 3, 2026 General Election</td> 
                    <td>August 07, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Lettering of Measures for the November 3, 2026 General Election</td> 
                    <td>August 10, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Regional Transit Measure Rebuttal Argument Deadline for the November 3, 2026 General Election</td> 
                    <td>August 11, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Ballot Measure Direct Argument Deadline for the November 3, 2026 General Election</td> 
                    <td>August 12, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Ballot Measure Rebuttal Argument Deadline for the November 3, 2026 General Election</td> 
                    <td>August 17, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Start of Voter Information Guide Mailing for the November 3, 2026 General Election</td> 
                    <td>September 24, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Start of Voting Equipment Testing - November 3, 2026 General Election</td> 
                    <td>September 28, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>First Day of Mailing Vote by Mail Ballots for the November 3, 2026 General Election</td> 
                    <td>October 05, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>First Day of early voting for the November 3, 2026 General Election</td> 
                    <td>October 05, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>24-hour Ballot Drop Boxes open for the November 3, 2026 General Election</td> 
                    <td>October 05, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Start of Vote by Mail Processing for the November 3, 2026 General Election</td> 
                    <td>October 08, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Close of Registration Period for the November 3, 2026 General Election</td> 
                    <td>October 19, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Public Logic and Accuracy Testing - November 3, 2026 General Election</td> 
                    <td>October 22, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>10-Day Vote Centers Open for the November 3, 2026 General Election</td> 
                    <td>October 24, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Last Day to Request a Replacement Vote by Mail Ballot for the November 3, 2026 General Election</td> 
                    <td>October 27, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>4-Day Vote Centers Open for the November 3, 2026 General Election</td> 
                    <td>October 31, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Election Day for the November 3, 2026 General Election</td> 
                    <td>November 03, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>Random Selection of Batches for the 1% Manual Tally</td> 
                    <td>November 16, 2026</td> 
                   </tr> 
                   <tr> 
                    <td>1% Manual Tally</td> 
                    <td>November 18, 2026</td> 
                   </tr> 
                  </tbody> 
                 </table> 
