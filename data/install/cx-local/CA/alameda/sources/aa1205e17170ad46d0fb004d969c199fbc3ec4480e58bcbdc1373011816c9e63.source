					<ol class="tabbedWidgetNarrow cpTabs " role="tablist" aria-hidden="True.ToString().ToLowerInvariant()" style='display: none;'>
						<li class="" role="presentation">	<a href="#tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_1" class="tabButton" id="tabBtnNarrow6a1fe495-05a8-495d-ba49-f5f991aa9f99_1" role="tab" aria-controls="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_1" aria-selected="false" tabindex="-1"><span class="tabName editable" data-sequence="1" data-tabname="Ward 1" contenteditable="false">Ward 1</span></a>
</li>
					</ol>
				<div class="tabbedWidget cpTabPanel " style="display: none;" id="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_1" role="tabpanel" aria-labelledby="tabBtn6a1fe495-05a8-495d-ba49-f5f991aa9f99_1" tabindex="-1">

<div class="widget editor pageStyles narrow" id="divEditordb7a1121-971e-4e2d-ab96-6f53f517d3da" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <h3 class="subhead2"><img src="/ImageRepository/Document?documentId=7909" class="fr-fil fr-dii fr-rounded" style="border-radius: 20px; width: 200px; padding: 10px;" alt="Photo of James G. Gunther"><p><br></p>James G. Gunther</h3><p>Member, Board of Directors&nbsp;<br>Term 2024 - 2028<br>Committees: Engineering &amp; Information Technology (Chair); Operations &amp; Water Quality<br><strong>Contact:&nbsp;</strong><a href="https://acwd.org/formcenter/Email-13/Email-James-Gunther-147" target="_blank" aria-label="Email James Gunther Opens in new window" rel="noopener" data-pasted="true">Email James Gunther</a></p><p>James G. Gunther is a professional engineer and currently serves as a supervisor for Transit America Services, Inc. He holds a Hazardous Materials Management Certificate and was formerly both a registered environmental assessor and a facility supervisor with an environmental cleanup and emergency response firm. He has 12 year of experience as a U.S. Coast Guard officer/engineer. Mr. Gunther has served as an active member of the Association of California Water Agencies since 1995 and has volunteered with the Fremont Fire Department, the Golden Gate National Recreation Area, and the Niles Canyon Railroad. Mr. Gunther has served as a Director of the Alameda County Water District since 1995.</p><p>Mr. Gunther holds a Bachelor of Science in Ocean Engineering, U.S. Coast Guard Academy.</p><p><br></p>
    </div>

<script type="text/javascript">
	$(document).ready(function (e) {		
	    renderSlideshowIfApplicable($('#divEditor' + 'db7a1121-971e-4e2d-ab96-6f53f517d3da'));
	});
</script>
</div>

				</div>
					<ol class="tabbedWidgetNarrow cpTabs " role="tablist" aria-hidden="True.ToString().ToLowerInvariant()" style='display: none;'>
						<li class="" role="presentation">	<a href="#tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_2" class="tabButton" id="tabBtnNarrow6a1fe495-05a8-495d-ba49-f5f991aa9f99_2" role="tab" aria-controls="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_2" aria-selected="false" tabindex="-1"><span class="tabName editable" data-sequence="2" data-tabname="Ward 2" contenteditable="false">Ward 2</span></a>
</li>
					</ol>
				<div class="tabbedWidget cpTabPanel " style="display: none;" id="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_2" role="tabpanel" aria-labelledby="tabBtn6a1fe495-05a8-495d-ba49-f5f991aa9f99_2" tabindex="-1">

<div class="widget editor pageStyles narrow" id="divEditor5fd2d679-a8d2-47bc-a87b-a7158cefdf91" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <p><img src="/ImageRepository/Document?documentId=7910" class="fr-fil fr-dii fr-rounded" style="border-radius: 20px; width: 200px; padding: 10px;" alt="Photo of Judy C. Huang"></p><h3 class="subhead2"><br></h3><h3 class="subhead2">Judy C. Huang</h3><p>Member, Board of Directors&nbsp;<br>Term 2022 - 2026<br>Committees: Engineering &amp; Information Technology; Legal, Intergovernmental &amp; Community Affairs (Chair), Intergovernmental &amp; Community Affairs<br><strong>Contact:</strong> <a href="https://acwd.org/formcenter/Email-13/Email-Judy-Huang-151" target="_blank" rel="noopener" data-pasted="true">Email Judy Huang</a></p><p>Judy C. Huang is a Registered Professional Engineer in California. She worked for the San Francisco Bay Regional Water Quality Control Board as a Water Resource Control Engineer from 1993 to 2006. From 2006 through 2025, she was an environmental engineer/project manager for the U.S. Environmental Protection Agency. Ms. Huang returned to her prior position as a Water Resource Control Engineer for the San Francisco Bay &nbsp;Regional Water Quality Control Board starting May 2025. Ms. Huang has served as a Director of the Alameda County Water District since 2002.</p><p>Ms. Huang holds a Bachelor of Science in Chemical Engineering, University of California, Berkeley.</p><p><br></p>
    </div>

<script type="text/javascript">
	$(document).ready(function (e) {		
	    renderSlideshowIfApplicable($('#divEditor' + '5fd2d679-a8d2-47bc-a87b-a7158cefdf91'));
	});
</script>
</div>

				</div>
					<ol class="tabbedWidgetNarrow cpTabs " role="tablist" aria-hidden="True.ToString().ToLowerInvariant()" style='display: none;'>
						<li class="" role="presentation">	<a href="#tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_3" class="tabButton" id="tabBtnNarrow6a1fe495-05a8-495d-ba49-f5f991aa9f99_3" role="tab" aria-controls="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_3" aria-selected="false" tabindex="-1"><span class="tabName editable" data-sequence="3" data-tabname="Ward 3" contenteditable="false">Ward 3</span></a>
</li>
					</ol>
				<div class="tabbedWidget cpTabPanel " style="display: none;" id="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_3" role="tabpanel" aria-labelledby="tabBtn6a1fe495-05a8-495d-ba49-f5f991aa9f99_3" tabindex="-1">

<div class="widget editor pageStyles narrow" id="divEditord6762446-335c-4792-86a7-fe3d7ff8f896" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <h3 class="subhead2"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 13.3333px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;" data-pasted="true"><img src="/ImageRepository/Document?documentId=7911" class="fr-fil fr-dii fr-rounded" style="border-radius: 20px; width: 200px; padding: 10px;" alt="Photo of Paul Sethy"></span></h3><h3 class="subhead2"><br>Paul Sethy</h3><p>Member, Board of Directors<br>Tern 2022-2026<br>Committees: Finance &amp; Administration; Operations &amp; Water Quality (Chair)<br><strong>Contact:</strong> <span style="font-size: 14.4px;" data-pasted="true"><a href="https://acwd.org/formcenter/Email-13/Email-Paul-Sethy-163" target="_blank" rel="noopener">Email Paul Sethy</a></span></p><p>Paul Sethy is a career veteran of Silicon Valley&apos;s high technology industry and has worked in various management positions for corporate leaders such as Verbatim, Xerox, 3Com, VeriFone, and Hewlett-Packard. &nbsp;He held full profit and loss responsibilities in more senior roles.</p><p>In 1999, Mr. Sethy became the Founder, Chairman, and CEO of AirPrime, Inc., for which he raised $82 million in venture capital financing from 2000-2001. &nbsp;The company eventually became a leading manufacturer of cellular modems for personal computers, smartphones, and industrial applications. &nbsp;AirPrime also introduced the world&apos;s first internet-capable smartphone in 2001, which both Sprint and Verizon retailed. &nbsp;AirPrime was later acquired by Sierra Wireless, a NASDAQ listed corporation (Stock Symbol: SWIR).</p><p>Mr. Sethy is also a co-author of the book &quot;The Wireless Industry&quot; (2001, Aspatore Books), now considered a multinational technology classic for his essay on how the Internet was established on the cellular system.</p><p>Mr. Sethy was elected to the Alameda County Water District&rsquo;s Board of Directors in 2010, and re-elected in 2014, 2018, and 2022. &nbsp;He served as Board President in 2014, 2018, and 2023.</p><p>Beyond his role with the ACWD Board, he has served as the Board President of the Delta Conveyance Finance Authority, 2023-2024, and Director since its 2018 inception. &nbsp;Board Director and Treasurer, Los Vaqueros Reservoir Joint Power Authority, 2022 &ndash; 2024.</p><p>Additionally, Mr. Sethy&rsquo;s involvement extends to serving on various committees, including the Water Management, Local Government, and Business Development Committees of the Association of California Water Agencies (ACWA). &nbsp;He is an active member of the Alameda County Special Districts Association (ACSDA) and the California Special Districts Association (CSDA). &nbsp;In 2018, he was elected by ACSDA membership to represent their interests on the County of Alameda Countywide Oversight Board (2018-2024). Mr. Sethy has also served as a director on the board of the Southern Alameda County Geographical Information System Authority from 2011 to the present.</p><p>In other civic engagements, and for many years, Mr. Sethy has been an active member of the Fremont Cultural Arts Council, Mission Peak Heritage Foundation, and the Washington Township Historical Society. &nbsp;He is also a long-time Fremont Chamber of Commerce member and has served on the Government Affairs Committee since 2011.&nbsp;</p><p>Mr. Sethy grew up in Fremont, California, and graduated from Mission San Jose High School. &nbsp;He then attended the University of California at Berkeley, School of Letters and Science, majoring in Economics and Business Administration.</p>
    </div>

<script type="text/javascript">
	$(document).ready(function (e) {		
	    renderSlideshowIfApplicable($('#divEditor' + 'd6762446-335c-4792-86a7-fe3d7ff8f896'));
	});
</script>
</div>

				</div>
					<ol class="tabbedWidgetNarrow cpTabs " role="tablist" aria-hidden="True.ToString().ToLowerInvariant()" style='display: none;'>
						<li class="" role="presentation">	<a href="#tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_4" class="tabButton" id="tabBtnNarrow6a1fe495-05a8-495d-ba49-f5f991aa9f99_4" role="tab" aria-controls="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_4" aria-selected="false" tabindex="-1"><span class="tabName editable" data-sequence="4" data-tabname="Ward 4" contenteditable="false">Ward 4</span></a>
</li>
					</ol>
				<div class="tabbedWidget cpTabPanel " style="display: none;" id="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_4" role="tabpanel" aria-labelledby="tabBtn6a1fe495-05a8-495d-ba49-f5f991aa9f99_4" tabindex="-1">

<div class="widget editor pageStyles narrow" id="divEditor44a1e5b8-f349-4ae0-ba91-7293aedb708c" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <p><img src="/ImageRepository/Document?documentId=7912" class="fr-fil fr-rounded fr-dii" style="border-radius: 20px; width: 200px; padding: 10px;" alt="Photo of John H. Weed"></p><h3 class="subhead2"><br>John H. Weed</h3><p>Vice President, Board of Directors&nbsp;<br>Term 2024 - 2028<br>Committees: Finance &amp; Administration (Chair); Water Resources &amp; Conservation<br><strong>Contact:</strong> <a href="https://acwd.org/formcenter/Email-13/Email-John-Weed-150" target="_blank" rel="noopener" data-pasted="true">Email John Weed</a></p><p>John H. Weed is an attorney and also works in property development. He has military experience as a civil engineer and water utility consultant with the United States Air Force on installations worldwide. He retired as a Colonel with the U.S. Air Force Reserves in 2000. He was previously employed as an engineer technician with the Santa Clara Valley Water District and was the Special Assistant to the Division Manager of Ordinance Engineering at FMC Corporation. He currently serves on the Board of Directors of the Bay Area Water Supply and Conservation Agency and is an appointed member of the Alameda County Assessment Appeals Board. He is an active member of the California State Bar (88299). He was a member of the Board of Directors of the Association of California Water Agencies (ACWA) from 2005-2009, and is currently a Member of the ACWA Region 5 Council. Mr. Weed served as an elected Trustee of the Ohlone Community College District from 1977 to 2010 and has served as a Director of the Alameda County Water District since 1995.</p><p>Mr. Weed has a bachelor&rsquo;s degree in civil engineering from the University of Santa Clara, a master&rsquo;s degree of business administration in finance from Eastern New Mexico University and doctoral level graduate studies at Water Resource Administration in University of Arizona. He obtained his Juris Doctor degree from the University of Santa Clara.</p>
    </div>

<script type="text/javascript">
	$(document).ready(function (e) {		
	    renderSlideshowIfApplicable($('#divEditor' + '44a1e5b8-f349-4ae0-ba91-7293aedb708c'));
	});
</script>
</div>

				</div>
					<ol class="tabbedWidgetNarrow cpTabs " role="tablist" aria-hidden="True.ToString().ToLowerInvariant()" style='display: none;'>
						<li class="" role="presentation">	<a href="#tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_5" class="tabButton" id="tabBtnNarrow6a1fe495-05a8-495d-ba49-f5f991aa9f99_5" role="tab" aria-controls="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_5" aria-selected="false" tabindex="-1"><span class="tabName editable" data-sequence="5" data-tabname="Ward 5" contenteditable="false">Ward 5</span></a>
</li>
					</ol>
				<div class="tabbedWidget cpTabPanel " style="display: none;" id="tab6a1fe495-05a8-495d-ba49-f5f991aa9f99_5" role="tabpanel" aria-labelledby="tabBtn6a1fe495-05a8-495d-ba49-f5f991aa9f99_5" tabindex="-1">

<div class="widget editor pageStyles narrow" id="divEditor36191e9d-a314-4b80-ac03-e7de6e3ae138" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <h3 class="subhead2"><img src="/ImageRepository/Document?documentId=7913" class="fr-fil fr-rounded fr-dii" style="border-radius: 20px; width: 200px; padding: 10px;" alt="Photo of Aziz Akbari"><p><br></p>Aziz Akbari</h3><p>President, Board of Directors&nbsp;<br>Term 2024 - 2028<br>Committees: Legal, Intergovernmental &amp; Community Affairs; Water Resources &amp; Conservation (Chair)<br><strong>Contact:</strong> <a href="https://acwd.org/formcenter/Email-13/Email-Aziz-Akbari-134" target="_blank" rel="noopener" data-pasted="true">Email Aziz Akbari</a></p><p>Aziz Akbari is an experienced public servant and engineer who was elected to the ACWD Board in 2016. He is a product of our local public schools, having attended Parkmont Elementary School, Centerville Junior High School, and Washington High School. His educational background is in Industrial and Systems Engineering with concentrations in Resource Planning and Data Sciences from the University of Southern California. Previously, Mr. Akbari served as a Consumer Affairs Commissioner in Alameda County &ndash; the youngest to ever serve in this capacity. Outside of his duties on the Board, Mr. Akbari volunteers with several local organizations and is an active member in the Niles Rotary Club.&nbsp;</p><p>Mr. Akbari holds a Bachelor of Science in Industrial and Systems Engineering from the University of Southern California.</p>
    </div>

<script type="text/javascript">
	$(document).ready(function (e) {		
	    renderSlideshowIfApplicable($('#divEditor' + '36191e9d-a314-4b80-ac03-e7de6e3ae138'));
	});
</script>
</div>

				</div>
					</div>
	</div>
	<script type="text/javascript">
		
		$.when(window.Pages.rwdReady).done(function () {
			var tabbedWidgetID = 'divTabbed6a1fe495-05a8-495d-ba49-f5f991aa9f99';
			var mediaQuerySize = 25;
			if (mediaQuerySize > 0) {
				var mediaElementQuery = '#' + tabbedWidgetID + ':media(this-min-width:' + mediaQuerySize + 'em)';
				var $tabbedWidget = $('#' + tabbedWidgetID);
				
                // Update child widget classes based on parent state
                var updateChildWidgetClasses = function (isParentWide) {
                    var liveEditEnabled = getCookieValue("enableLiveEdit") === "true";
                    if (liveEditEnabled)
                        return;

                    var $childWidgets = $tabbedWidget.find('.widget').not('[data-elementqueryclasses]');

                    if (isParentWide) {
                        $childWidgets.addClass('wide').removeClass('narrow');
                        $tabbedWidget.find('[data-event-list-row="true"]').addClass('wide').removeClass('narrow');
                    } else {
                        $childWidgets.addClass('narrow').removeClass('wide');
                        $tabbedWidget.find('[data-event-list-row="true"]').addClass('narrow').removeClass('wide');
                    }
                };
				
				window.cpMedia.unregister(mediaElementQuery).register(mediaElementQuery, {
					deferSetup: false,
					setup: function () {
						var liveEditEnabled = $.cookie("enableLiveEdit") === "true";
						if (!liveEditEnabled) {
							$tabbedWidget.addClass('narrow').removeClass('wide');
							cpMedia.diag('$(element).addClass("narrow"), mediaQuery: ' + mediaElementQuery);
							$tabbedWidget.find('.tabbedWidget.cpTabs').hide().attr('aria-hidden', 'true');
							$tabbedWidget.find('.tabbedWidgetNarrow.cpTabs').show().attr('aria-hidden', 'false');
							$tabbedWidget.data("tabHeightSet", false);
							
							// Update child widget classes - parent is narrow
							updateChildWidgetClasses(false);
						}
					},
					match: function () {
						$tabbedWidget.addClass('wide').removeClass('narrow');
						cpMedia.diag('$(element).removeClass("narrow"), mediaQuery: ' + mediaElementQuery);
						$tabbedWidget.find('.tabbedWidget.cpTabs').show().attr('aria-hidden', 'false');
						$tabbedWidget.find('.tabbedWidgetNarrow.cpTabs').hide().attr('aria-hidden', 'true');

						if($tabbedWidget.data("tabHeightSet") == false)
						{
							$tabbedWidget.data("tabHeightSet", true);

							var tabbedWidgetID = 'divTabbed6a1fe495-05a8-495d-ba49-f5f991aa9f99';
							setTabbedWidgetsTabHeight(tabbedWidgetID);
						}
						$('.cpTabPanels').unbind('click');
						
						// Update child widget classes - parent is wide
						updateChildWidgetClasses(true);
					},
					unmatch: function () {
						var liveEditEnabled = $.cookie("enableLiveEdit") === "true";
						if (!liveEditEnabled) {
							$tabbedWidget.addClass('narrow').removeClass('wide');
							cpMedia.diag('$(element).addClass("narrow"), mediaQuery: ' + mediaElementQuery);
							$tabbedWidget.find('.tabbedWidget.cpTabs').hide().attr('aria-hidden', 'true');
							$tabbedWidget.find('.tabbedWidgetNarrow.cpTabs').show().attr('aria-hidden', 'false');
							
							// Update child widget classes - parent is narrow
							updateChildWidgetClasses(false);
						}
						$('.cpTabPanels').click(function() {
							this.scrollIntoView();
						});
					}
				});                
            }
        });
		
		//Used for when page is initially loaded
		if($('#divTabbed6a1fe495-05a8-495d-ba49-f5f991aa9f99').hasClass('narrow'))
		{
			$('.cpTabPanels').click(function() {
				this.scrollIntoView();
			});
		}
		

		//If responsive not enabled, execute this after a timeout
		if(!isResponsiveEnabled)
		{
			window.setTimeout(function(){
				var tabbedWidgetID = 'divTabbed6a1fe495-05a8-495d-ba49-f5f991aa9f99';
				typeof setTabbedWidgetsTabHeight === "function" && setTabbedWidgetsTabHeight(tabbedWidgetID);
			}, 1500);
