		reg_lang.push( [ 'Chinese', 21938 ] ); reg_lang.push( [ 'English', 937939 ] );
		reg_lang.push( [ 'Spanish', 17408 ] ); reg_lang.push( [ 'Tagalog', 1109 ] );
		reg_lang.push( [ 'Vietnamese', 4821 ] );
		
		reg_party.sort( sortArray );
		reg_lang.sort( sortArray );
		
