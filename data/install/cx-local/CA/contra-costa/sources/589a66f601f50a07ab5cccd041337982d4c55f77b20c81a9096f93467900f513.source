<script>

// Updated - 03/30/2026
jQuery(document).on('click', 'a.lang_link', function (e) {

  e.preventDefault();

  const $link = $(this);

  const mvpDtlpageElem = document.getElementById('dtlpage');
  const mvpDtlpage = mvpDtlpageElem ? mvpDtlpageElem.value : 'N';

  const lang = $link.attr('lang') || 'en';
  const currentUrl = new URL(window.location.href);


  // Set language-preference cookie for 7 days
  const oneWeek = 60 * 60 * 24 * 7;
  const secure = location.protocol === 'https:' ? '; Secure' : '';
  document.cookie = `language-preference=${lang}; path=/; max-age=${oneWeek}; domain=.alamedacountyca.gov; SameSite=Lax${secure}`;

  if (mvpDtlpage === 'Y') {
    window.location.reload();
  } else {
    window.location.href = currentUrl.toString();
  }

});

</script>


	
