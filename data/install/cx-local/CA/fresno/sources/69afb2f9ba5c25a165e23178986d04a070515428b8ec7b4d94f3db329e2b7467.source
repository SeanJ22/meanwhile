u0947 \u0905\u092a\u0928\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\u0964</p>","ja":"<p>\u4ee5\u4e0b\u306e\u30ea\u30b9\u30c8\u304b\u3089\u81ea\u5206\u306e\u60c5\u5831\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>","ko":"<p>\uc544\ub798 \ubaa9\ub85d\uc5d0\uc11c \uadc0\ud558\uc758 \uc815\ubcf4\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624.</p>","ur":"<p>\u0628\u0631\u0627\u06c1\u0650 \u06a9\u0631\u0645 \u0645\u0646\u062f\u0631\u062c\u06c1 \u0630\u06cc\u0644 \u0641\u06c1\u0631\u0633\u062a \u0645\u06cc\u06ba \u0633\u06d2 \u0627\u067e\u0646\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4</p>","vi":"<p>Vui l\xf2ng ch\u1ecdn th\xf4ng tin c\u1ee7a qu\xfd v\u1ecb t\u1eeb danh s\xe1ch b\xean d\u01b0\u1edbi.</p>","km":"<p>\u179f\u17bc\u1798\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u1796\u17d0\u178f\u17cc\u200b\u200b\u1798\u17b6\u1793\u200b\u179a\u1794\u179f\u17cb\u17a2\u17d2\u1793\u1780\u200b\u200b\u1796\u17b8\u200b\u1794\u1789\u17d2\u1787\u17b8\u200b\u1781\u17b6\u1784\u200b\u1780\u17d2\u179a\u17c4\u1798\u200b\u200b \u17d4\u200b</p>"}},"confirmVoter":{"value":"<strong>[fname] [lname]</strong> \u2013 [raddress], [rcity] [rstate], [rzip]","tokens":{"voter.*":"Any voter property","raddress":"All voter raddress# fields concatenated."}},"confirmNotFound":{"value":"I don\'t see my information above.","translations":{"es":"No veo mi informaci\xf3n en la lista anterior.","zh-hant":"\u6211\u5728\u4e0a\u9762\u6c92\u6709\u770b\u5230\u6211\u7684\u8cc7\u8a0a\u3002","tl":"Hindi ko nakita ang aking impormasyon sa itaas.","hi":"\u092e\u0941\u091d\u0947 \u090a\u092a\u0930 \u0905\u092a\u0928\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947 \u0930\u0939\u0940 \u0939\u0948\u0964","ja":"\u4e0a\u8a18\u306b\u306f\u81ea\u5206\u306e\u60c5\u5831\u306f\u3042\u308a\u307e\u305b\u3093\u3002","ko":"\uc0c1\uae30\uc758 \ub0b4 \uc815\ubcf4\ub97c \ubcfc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.","ur":"\u0645\u062c\u06be\u06d2 \u0627\u0648\u067e\u0631 \u0627\u067e\u0646\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0646\u0638\u0631 \u0646\u06c1\u06cc\u06ba \u0622\u0626\u06cc\u06ba\u06d4","vi":"T\xf4i kh\xf4ng t\xecm th\u1ea5y th\xf4ng tin c\u1ee7a t\xf4i \u1edf tr\xean.","km":"\u1781\u17d2\u1789\u17bb\u17c6\u200b\u1798\u17b7\u1793\u200b\u1783\u17be\u1789\u200b\u1796\u17d0\u178f\u17cc\u200b\u1798\u17b6\u1793\u200b\u1781\u17d2\u1789\u17bb\u17c6\u200b\u1793\u17c5\u200b\u1781\u17b6\u1784\u200b\u179b\u17be\u200b\u1791\u17c1\u200b \u17d4"}},"contentRight":{"fieldType":"TranslatableText","includeByDefault":false,"defaultValue":{"value":"","format":"html","translations":{}}}},"cta":{"requiredFields":["title","actions"],"actions":null,"table":null,"autoRedirect":true},"online-ballot-mark":{"requiredFields":["aid","eid","styleId","precinctId","title"],"aid":"","eid":0,"styleId":0,"precinctId":0,"canSkip":true,"title":{"value":"Ballot Marking","translations":{"es":"Marca de Boleta","zh-hant":"","tl":"","vi":"","ja":"\u6295\u7968\u7528\u7d19\u306e\u8a18\u5165","ko":"\ud22c\ud45c\uc9c0 \ub9c8\ud0b9","hi":"\u092e\u0924\u092a\u0924\u094d\u0930 \u092a\u0930 \u0928\u093f\u0936\u093e\u0928 \u0932\u0917\u093e\u0928\u093e","ur":"","km":"\u1780\u17b6\u179a\u200b\u1782\u17bc\u179f\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b","needed":"noi18n"}},"instructions":{"value":"<p>Your ballot is presented below. To mark your selection, click on a checkbox. To remove a selection, click on the checked box again.</p>","format":"html","style":null,"translations":{"zh-hant":"<p>\u60a8\u7684\u9078\u7968\u5982\u4e0b\u6240\u793a\u3002\u9ede\u64ca\u52fe\u9078\u6846\uff0c\u6a19\u8a18\u60a8\u7684\u9078\u64c7\u3002\u5982\u8981\u6e05\u9664\u8a72\u9805\u9078\u64c7\uff0c\u8acb\u518d\u6b21\u9ede\u64ca\u60a8\u6240\u52fe\u9078\u7684\u52fe\u9078\u6846\u3002</p>","hi":"<p>\u0906\u092a\u0915\u093e \u092e\u0924\u092a\u0924\u094d\u0930 \u0928\u0940\u091a\u0947 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0905\u092a\u0928\u0947 \u091a\u092f\u0928 \u092a\u0930 \u0928\u093f\u0936\u093e\u0928 \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0915\u093f\u0938\u0940 \u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u091a\u092f\u0928 \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u091a\u0947\u0915 \u0915\u093f\u090f \u0917\u090f \u092c\u0949\u0915\u094d\u0938 \u092a\u0930 \u0926\u094b\u092c\u093e\u0930\u093e \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964</p>","ja":"<p>\u4ee5\u4e0b\u306b\u3042\u306a\u305f\u306e\u6295\u7968\u7528\u7d19\u304c\u8868\u793a\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u9078\u629e\u306b\u5370\u3092\u3064\u3051\u308b\u306b\u306f\u3001\u56db\u89d2\u306e\u30de\u30b9\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002\u9078\u629e\u3092\u53d6\u308a\u6d88\u3059\u306b\u306f\u3001\u540c\u3058\u30de\u30b9\u3092\u518d\u5ea6\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>","ko":"<p>\uadc0\ud558\uc758 \ud22c\ud45c\uc9c0\ub294 \uc544\ub798\uc5d0\uc11c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc120\ud0dd\ud558\ub824\uba74, \ud655\uc778\ub780\uc744 \ud074\ub9ad\ud558\uc2ed\uc2dc\uc624. \uc120\ud0dd \ud56d\ubaa9\uc744 \uc81c\uac70\ud558\ub824\uba74, \ud655\uc778\ub780\uc744 \ub2e4\uc2dc \ud074\ub9ad\ud558\uc2ed\uc2dc\uc624.</p>","es":"<p>Su boleta se presenta abajo. Haga clic en una casilla para marcar su selecci&oacute;n. Si quisiera eliminar una selecci&oacute;n, haga clic en la casilla otra vez.</p>","tl":"<p>Ipinapakita sa ibaba ang inyong balota. Para markahan ang inyong pinili, i-click ang checkbox. Upang tanggalin ang pinili, i-click muli ang unang napili na checkbox.</p>","ur":"<p>\u0622\u067e \u06a9\u0627 \u0628\u06cc\u0644\u0679 \u0646\u06cc\u0686\u06d2 \u0645\u06c1\u06cc\u0627 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4 \u0627\u067e\u0646\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0634\u0627\u0646 \u0632\u062f \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0686\u06cc\u06a9 \u0628\u0627\u06a9\u0633 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4 \u06a9\u0648\u0626\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u06c1\u0679\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633 \u0686\u06cc\u06a9 \u06a9\u0631\u062f\u06c1 \u0628\u0627\u06a9\u0633 \u067e\u0631 \u0627\u06cc\u06a9 \u0645\u0631\u062a\u0628\u06c1 \u067e\u06be\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u06d4</p>","vi":"<p>L\xe1 phi\u1ebfu c\u1ee7a qu\xfd v\u1ecb \u0111\u01b0\u1ee3c tr\xecnh b\xe0y d\u01b0\u1edbi \u0111\xe2y. \u0110\xe1nh d\u1ea5u ch\u1ecdn v\xe0o \xf4 cho s\u1ef1 l\u1ef1a ch\u1ecdn c\u1ee7a qu\xfd v\u1ecb, \u0111\xe1nh d\u1ea5u ch\u1ecdn v\xe0o \xf4 l\u1ea1i m\u1ed9t l\u1ea7n n\u1eefa \u0111\u1ec3 b\u1ecf ch\u1ecdn l\u1ef1a \u0111\xf3.</p>","km":"<p>\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u200b\u200b\u1786\u17d2\u1793\u17c4\u178f\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b\u200b\u178f\u17d2\u179a\u17bc\u179c\u200b\u1794\u17b6\u1793\u200b\u1794\u1784\u17d2\u17a0\u17b6\u1789\u200b\u178a\u17bc\u1785\u200b\u1781\u17b6\u1784\u200b\u1780\u17d2\u179a\u17c4\u1798 \u17d4\u200b \u178a\u17be\u1798\u17d2\u1794\u17b8\u200b\u1782\u17bc\u179f\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780 \u179f\u17bc\u1798\u200b\u1785\u17bb\u1785\u200b\u179b\u17be\u200b\u1794\u17d2\u179a\u200b\u17a2\u1794\u17cb\u200b\u1792\u17b8\u1780\u200b \u17d4\u200b \u178a\u17be\u1798\u17d2\u1794\u17b8\u200b\u178a\u17c4\u17c7\u200b\u1780\u17b6\u179a\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u1785\u17c1\u1789 \u179f\u17bc\u1798\u200b\u1785\u17bb\u1785\u200b\u1793\u17c5\u200b\u179b\u17be\u200b\u200b\u1794\u17d2\u179a\u200b\u17a2\u1794\u17cb\u178a\u17c2\u179b\u200b\u1794\u17b6\u1793\u200b\u200b\u200b\u1792\u17b8\u1780\u200b\u179a\u17bd\u1785\u200b\u1798\u17d2\u178f\u1784\u200b\u1791\u17c0\u178f \u17d4\u200b</p>"}},"writeInInstructions":{"value":"<p>To vote for a qualified write-in candidate who is not listed on the ballot, click the checkbox beside the WRITE-IN space at the end of the candidate list, then type the candidate&#39;s name in the space.</p>","format":"html","style":null,"translations":{"zh-hant":"<p>\u82e5\u8981\u6295\u9078\u4e00\u4f4d\u672a\u5217\u65bc\u9078\u7968\u4e0a\u7684\u5408\u8cc7\u683c\u88dc\u5beb\u5019\u9078\u4eba\uff0c\u8acb\u5148\u884c\u52fe\u9078\u5019\u9078\u4eba\u540d\u55ae\u672b\u7aef\uff0c\u5408\u8cc7\u683c\u88dc\u5beb\u5019\u9078\u4eba\u4f4d\u7f6e\u65c1\u908a\u7684\u52fe\u9078\u6846\uff0c\u7136\u5f8c\u8f38\u5165\u5019\u9078\u4eba\u59d3\u540d\u3002</p>","hi":"<p>\u0915\u093f\u0938\u0940 \u0910\u0938\u0947 \u092f\u094b\u0917\u094d\u092f \u0930\u093e\u0907\u091f-\u0907\u0928 \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u092e\u0924\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u094b \u092e\u0924\u092a\u0924\u094d\u0930 \u092a\u0930 \u0938\u0942\u091a\u0940\u092c\u0926\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0938\u0942\u091a\u0940 \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902 \u0930\u093e\u0907\u091f-\u0907\u0928 \u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u092c\u0917\u0932 \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0924 \u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902, \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0909\u0938 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0915\u093e \u0928\u093e\u092e \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902\u0964</p>","ja":"<p>\u6295\u7968\u7528\u7d19\u306b\u540d\u524d\u304c\u8a18\u8f09\u3055\u308c\u3066\u3044\u306a\u3044\u6709\u8cc7\u683c\u8a18\u540d\u5019\u88dc\u8005\u306b\u6295\u7968\u3059\u308b\u306b\u306f\u3001\u5019\u88dc\u8005\u30ea\u30b9\u30c8\u306e\u4e00\u756a\u4e0b\u306e\u8a18\u5165\u6b04\u306e\u6a2a\u306b\u3042\u308b\u56db\u89d2\u306e\u30de\u30b9\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u3001\u30b9\u30da\u30fc\u30b9\u306b\u5019\u88dc\u8005\u306e\u540d\u524d\u3092\u5165\u529b\u3057\u307e\u3059\u3002</p>","ko":"<p>\ud22c\ud45c\uc9c0\uc5d0 \uae30\uc7ac\ub418\uc9c0 \uc54a\uc740 \uc720\uc790\uaca9 \uae30\uba85 \ud6c4\ubcf4\uc790\uc5d0 \uac8c \ud22c\ud45c\ud558\ub824\uba74, \ud6c4\ubcf4\uc790 \uba85\ubd80 \ub05d\uc758 \uc4f0\uae30 \uacf5\uac04 \uc606\uc5d0 \uc788\ub294 \ud655\uc778\ub780\uc744 \ud074\ub9ad\ud55c \ub2e4\uc74c, \ud574\ub2f9 \uacf5\uac04\uc5d0 \ud6c4\ubcf4\uc790\uc758 \uc774\ub984\uc744 \uc785\ub825\ud569\ub2c8\ub2e4.</p>","es":"<p>Para votar por un candidato calificado cuyo nombre no aparece en la boleta, primero haga clic para marcar la casilla junto al espacio NO LISTADO al final de la lista de candidatos. Haga clic en el espacio a la derecha de la casilla e introduzca el nombre de su candidato.</p>","tl":"<p>Upang iboto ang isang kuwalipikadong isinusulat-lamang na kandidato na hindi nakalista sa balota, i-click ang checkbox na katabi ng Isinusulat-Lamang na linya sa dulo ng listahan ng mga kandidato, at i-type ang pangalan ng kandidato sa blangkong linya na iyon.</p>","ur":"<p> \u0641\u06c1\u0631\u0633\u062a \u0645\u06cc\u06ba \u063a\u06cc\u0631 \u0645\u0648\u062c\u0648\u062f (\u0631\u0627\u0626\u0679 \u0627\u0650\u0646) \u0627\u0645\u06cc\u062f\u0648\u0627\u0631 \u062f\u0627\u062e\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u067e\u06c1\u0644\u06d2 \u063a\u06cc\u0631 \u0645\u0648\u062c\u0648\u062f (\u0631\u0627\u0626\u0679 \u0627\u0650\u0646) \u06a9\u0627 \u0686\u06cc\u06a9 \u0628\u0627\u06a9\u0633 \u0646\u0634\u0627\u0646 \u0632\u062f \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u067e\u06be\u0631 \u0686\u06cc\u06a9 \u0628\u0627\u06a9\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u06c1\u06cc\u0627 \u06a9\u06cc \u06af\u0626\u06cc \u062c\u06af\u06c1 \u0645\u06cc\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u0645\u062a\u0639\u0644\u0642\u06c1 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631 \u06a9\u0627 \u0646\u0627\u0645 \u062f\u0627\u062e\u0644 \u06a9\u0631\u06cc\u06ba\u06d4</p>","vi":"<p>\u0110\u1ec3 b\u1ea7u cho \u1ee9ng c\u1eed vi\xean h\u1ed9i \u0111\u1ee7 \u0111i\u1ec1u ki\u1ec7n theo c\xe1ch vi\u1ebft t\xean v\xe0o m\xe0 kh\xf4ng c\xf3 t\xean tr\xean l\xe1 phi\u1ebfu, \u0111\xe1nh d\u1ea5u v\xe0o \xf4 b\xean c\u1ea1nh ch\u1ed7 tr\u1ed1ng VI\u1ebeT T\xcaN V\xc0O \u1edf ph\u1ea7n cu\u1ed1i c\u1ee7a danh s\xe1ch \u1ee9ng c\u1eed vi\xean, v\xe0 \u0111\xe1nh m\xe1y t\xean \u1ee9ng c\u1eed vi\xean v\xe0o ph\u1ea7n tr\u1ed1ng \u0111\xf3.</p>","km":"<p>\u178a\u17be\u1798\u17d2\u1794\u17b8\u200b\u1794\u17c4\u17c7\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u17b2\u17d2\u1799\u200b\u1794\u17c1\u1780\u17d2\u1781\u1787\u1793\u200b\u200b\u179f\u179a\u179f\u17c1\u179a\u200b\u200b\u1794\u1789\u17d2\u1785\u17bc\u179b\u200b\u1788\u17d2\u1798\u17c4\u17c7\u178a\u17c2\u179b\u200b\u1798\u17b6\u1793\u200b\u1782\u17bb\u178e\u200b\u179c\u178c\u17d2\u178d\u17b7\u200b\u1782\u17d2\u179a\u1794\u17cb\u200b\u1782\u17d2\u179a\u17b6\u1793\u200b \u178a\u17c2\u179b\u200b\u1798\u17b7\u1793\u200b\u1798\u17b6\u1793\u200b\u1788\u17d2\u1798\u17c4\u17c7\u200b\u1793\u17c5\u200b\u179b\u17be\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b \u179f\u17bc\u1798\u200b\u1785\u17bb\u1785\u200b\u1793\u17c5\u200b\u179b\u17be\u200b\u1794\u17d2\u179a\u200b\u17a2\u1794\u17cb\u200b\u1792\u17b8\u1780\u200b\u1793\u17c5\u200b\u1780\u17d2\u1794\u17c2\u179a\u200b\u1796\u17b6\u1780\u17d2\u1799\u200b\u1790\u17b6 \u179f\u179a\u179f\u17c1\u179a\u200b\u200b\u1794\u1789\u17d2\u1785\u17bc\u179b\u200b\u200b\u1788\u17d2\u1798\u17c4\u17c7\u200b\u200b\u1794\u17c1\u1780\u17d2\u1781\u1787\u1793 \u1793\u17c5\u200b\u1795\u17d2\u1793\u17c2\u1780\u200b\u1781\u17b6\u1784\u200b\u1785\u17bb\u1784\u200b\u178f\u17b6\u179a\u17b6\u1784\u200b\u1794\u17c1\u1780\u17d2\u1781\u200b\u1787\u1793 \u1794\u1793\u17d2\u1791\u17b6\u1794\u17cb\u200b\u1798\u1780\u200b\u179f\u17bc\u1798\u200b\u179c\u17b6\u1799\u200b\u200b\u1788\u17d2\u1798\u17c4\u17c7\u200b\u179a\u1794\u179f\u17cb\u200b\u1794\u17c1\u1780\u17d2\u1781\u200b\u1787\u1793\u200b\u1785\u17bc\u179b\u200b\u1791\u17c5\u200b\u1780\u17d2\u1793\u17bb\u1784\u200b\u1780\u1793\u17d2\u179b\u17c2\u200b\u1791\u17c6\u200b\u1793\u17c1\u179a\u200b\u1793\u17c4\u17c7 \u17d4\u200b</p>"}},"intro":{"value":"","format":"html","style":null,"translations":{}},"header":[{"value":"Official Ballot","translations":{"es":"Votacion Oficial","needed":"noi18n"},"tokens":{"election":"Election Title","precinct":"Precinct Name","style":"Style Name"}},{"value":"Election: [election]","format":"text","style":"default","translations":{"zh-hant":"\u9078\u8209\uff1a[election]","hi":"\u091a\u0941\u0928\u093e\u0935: [election]","ja":"\u9078\u6319\uff1a[election]","ko":"\uc120\uac70: [election]","es":"Elecciones: [election]","tl":"Eleksyon: [election]","ur":"\u0627\u0644\u06cc\u06a9\u0634\u0646: [election]","vi":"B\u1ea7u C\u1eed: [election]","km":"\u1780\u17b6\u179a\u200b\u1794\u17c4\u17c7\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b: [election]"},"tokens":{"election":"Election Title","precinct":"Precinct Name","style":"Style Name"}},{"value":"Precinct: [precinct]","format":"text","style":"subtitle","translations":{"zh-hant":"\u9078\u5340: [precinct]","hi":"\u0938\u0940\u092e\u093e: [precinct]","ja":"\u9078\u6319\u533a\uff1a[precinct]","ko":"\uc120\uac70\uad6c: [precinct]","es":"Recinto electoral: [precinct]","tl":"Presinto: [precinct]","ur":"\u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u062d\u0644\u0642\u06c1: [precinct]","vi":"Khu v\u1ef1c: [precinct]","zh-hans":"\u533a\u57df: [precinct]","km":"\u1798\u178e\u17d2\u178c\u179b: [precinct]"},"tokens":{"election":"Election Title","precinct":"Precinct Name","style":"Style Name"}},{"value":"Ballot Style: [style]","format":"text","style":"subtitle","translations":{"es":"Tipo de boleta: [style]","zh-hant":"\u9078\u7968\u6a23\u5f0f: [style]","hi":"\u092e\u0924\u092a\u0924\u094d\u0930 \u0915\u0940 \u0936\u0948\u0932\u0940: [style]","ja":"\u6295\u7968\u7528\u7d19\u306e\u5f62\u5f0f: [style]","ko":"\ud22c\ud45c \uc6a9\uc9c0 \ud615\uc2dd: [style]","tl":"Uri ng Balota: [style]","ur":"\u0628\u06cc\u0644\u0679 \u0633\u0679\u0627\u0626\u0644: [style]","vi":"Ki\u1ec3u L\xe1 Phi\u1ebfu: [style]","km":"\u1791\u1798\u17d2\u179a\u1784\u17cb\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f: [style]\u200b"},"tokens":{"election":"Election Title","precinct":"Precinct Name","style":"Style Name"}}]},"online-ballot-print":{"requiredFields":["aid","eid","styleId","title","printButton"],"aid":"","eid":0,"styleId":0,"precinctId":0,"showBarcode":true,"fullBallot":false,"fullOptions":false,"allOptions":false,"showSessionWarning":true,"title":{"value":"Print Your Selections","format":null,"style":null,"translations":{"zh-hant":"\u5217\u5370\u60a8\u7684\u9078\u64c7","hi":"\u0905\u092a\u0928\u0947 \u091a\u092f\u0928\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u093f\u0902\u091f \u0915\u0930\u0947\u0902","ja":"\u9078\u629e\u5185\u5bb9\u3092\u5370\u5237\u3059\u308b","ko":"\uc120\ud0dd \ud56d\ubaa9 \uc778\uc1c4","es":"Imprimir sus votos","tl":"I-print ang mga Pinili","ur":"\u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u067e\u0631\u0646\u0679 \u06a9\u0631\u06cc\u06ba","vi":"In c\xe1c L\u1ef1a Ch\u1ecdn","km":"\u179f\u17bc\u1798\u1796\u17d2\u179a\u17b8\u1793\u200b\u1780\u17b6\u179a\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b\u200b"}},"intro":{"value":"<p>Click on the Print Selections button below to print your ballot selections. After your selections finish printing, click the End Session button.</p>","format":"html","style":null,"translations":{"es":"<p>Haga clic en el bot\xf3n Imprimir sus votos de abajo para imprimir sus selecciones de la boleta. Despu\xe9s de que se acaben de imprimir sus selecciones, haga clic en el bot\xf3n Finalizar sesi\xf3n.</p>","zh-hant":"<p>\u9ede\u64ca\u4ee5\u4e0b\u7684\u300c\u5217\u5370\u9078\u64c7\u300d\u6309\u9375\uff0c\u5217\u5370\u60a8\u7684\u9078\u7968\u9078\u64c7\u3002\u7576\u60a8\u5b8c\u6210\u5217\u5370\u5f8c\uff0c\u8acb\u9ede\u64ca\u300c\u7d50\u675f\u6295\u7968\u671f\u300d\u7684\u6309\u9375\u3002</p>","tl":"<p>I-click ang I-print ang mga Pinili na button sa ibaba para i-print ang inyong mga pinili sa balota. Pagkatapos na mag-print ng inyong mga pinili, i-click ang Katapusan ng Sesyon na button upang isara ang inyong sesyon.</p>","vi":"<p>Nh\u1ea5p v\xe0o n\xfat In c\xe1c L\u1ef1a Ch\u1ecdn (Print Selections) b\xean d\u01b0\u1edbi \u0111\u1ec3 in c\xe1c l\u1ef1a ch\u1ecdn phi\u1ebfu b\u1ea7u c\u1ee7a qu\xfd v\u1ecb. Sau khi ph\u1ea7n b\u1ea7u ch\u1ecdn c\u1ee7a qu\xfd v\u1ecb \u0111\xe3 in xong, h\xe3y nh\u1ea5p v\xe0o n\xfat K\u1ebft th\xfac phi\xean b\u1ea7u ch\u1ecdn (hay End Session hay Ph\u1ea7n - K\u1ebft Th\xfac).</p>","ja":"<p>\u4e0b\u306e\u3001\u9078\u629e\u5185\u5bb9\u3092\u5370\u5237\u3059\u308b\u306e\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u3001\u6295\u7968\u7528\u7d19\u306e\u9078\u629e\u5185\u5bb9\u3092\u5370\u5237\u3057\u307e\u3059\u3002\u9078\u629e\u5185\u5bb9\u3092\u5370\u5237\u3057\u305f\u3089\u3001\u30bb\u30c3\u30b7\u30e7\u30f3\u3092\u7d42\u4e86\u3059\u308b\u306e\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002</p>","ko":"<p>\ud22c\ud45c\uc9c0 \uc120\ud0dd \ud56d\ubaa9\uc744 \uc778\uc1c4\ud558\ub824\uba74 \uc544\ub798\uc758 \uc120\ud0dd \ud56d\ubaa9 \uc778\uc1c4(Print Selections) \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc2ed\uc2dc\uc624. \uc120\ud0dd\ud55c \ud6c4 \uc778\uc1c4\uac00 \uc644\ub8cc\ub418\uba74 \uc138\uc158 \uc885\ub8cc(End Session) \ubc84\ud2bc\uc744 \ud074\ub9ad\ud569\ub2c8\ub2e4.</p>","hi":"<p>\u0905\u092a\u0928\u0947 \u092e\u0924\u092a\u0924\u094d\u0930 \u091a\u092f\u0928\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u093f\u0902\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u092a\u094d\u0930\u093f\u0902\u091f \u091a\u092f\u0928 \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a\u0915\u0947 \u091a\u092f\u0928\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u093f\u0902\u091f \u0939\u094b\u0928\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0938\u0924\u094d\u0930 \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902 \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964</p>","ur":"","km":"<p>\u179f\u17bc\u1798\u200b\u1785\u17bb\u1785\u200b\u179b\u17be\u200b\u1794\u17ca\u17bc\u178f\u17bb\u1784\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u1796\u17d2\u179a\u17b8\u1793 \u178a\u17c2\u179b\u200b\u179f\u17d2\u1790\u17b7\u178f\u200b\u1793\u17c5\u200b\u1781\u17b6\u1784\u200b\u1780\u17d2\u179a\u17c4\u1798\u200b\u1780\u17b6\u179a\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b \u17d4\u200b \u1780\u17d2\u179a\u17c4\u1799\u1796\u17b8\u200b\u200b\u1796\u17d2\u179a\u17b8\u1793\u200b\u200b\u1780\u17b6\u179a\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u179a\u17bd\u1785 \u179f\u17bc\u1798\u200b\u1785\u17bb\u1785\u200b\u1794\u17ca\u17bc\u178f\u17bb\u1784\u200b\u1794\u1789\u17d2\u1785\u1794\u17cb\u200b\u1796\u17c1\u179b\u200b\u179c\u17c1\u179b\u17b6\u200b\u1780\u17c6\u200b\u178e\u178f\u17cb\u200b\u1780\u17b6\u179a\u200b\u1794\u17d2\u179a\u17be\u200b\u1794\u17d2\u179a\u17b6\u179f\u17cb\u200b\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b \u17d4\u200b</p>"}},"printButton":{"value":"Print Selections","format":null,"style":null,"translations":{"es":"Imprimir sus votos","zh-hant":"\u5217\u5370\u9078\u64c7","tl":"I-print ang mga Pinili","hi":"\u091a\u092f\u0928\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u093f\u0902\u091f \u0915\u0930\u0947\u0902","ja":"Secure Select\u3092\u3054\u5229\u7528\u3044\u305f\u3060\u304d\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059","ko":"\uc120\ud0dd \ud56d\ubaa9 \uc778\uc1c4","ur":"\u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u067e\u0631\u0646\u0679 \u06a9\u0631\u06cc\u06ba","vi":"In c\xe1c L\u1ef1a Ch\u1ecdn","km":"\u1796\u17d2\u179a\u17b8\u1793\u200b\u1780\u17b6\u179a\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u200b\u200b"}},"header":[{"value":"Official Ballot","translations":{"es":"Votacion Oficial","needed":"noi18n"},"tokens":{"election":"Election Title","precinct":"Precinct Name","style":"Style Name"}},{"value":"Election: [election]","format":"text","style":"default","translations":{"zh-hant":"\u9078\u8209\uff1a[election]","hi":"\u091a\u0941\u0928\u093e\u0935: [election]","ja":"\u9078\u6319\uff1a[election]","ko":"\uc120\uac70: [election]","es":"Elecciones: [election]","tl":"Eleksyon: [election]","ur":"\u0627\u0644\u06cc\u06a9\u0634\u0646: [election]","vi":"B\u1ea7u C\u1eed: [election]","km":"\u1780\u17b6\u179a\u200b\u1794\u17c4\u17c7\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b: [election]"},"tokens":{"election":"Election Title","precinct":"Precinct Name","style":"Style Name"}},{"value":"Precinct: [precinct]","format":"text","style":"subtitle","translations":{"zh-hant":"\u9078\u5340: [precinct]","hi":"\u0938\u0940\u092e\u093e: [precinct]","ja":"\u9078\u6319\u533a\uff1a[precinc