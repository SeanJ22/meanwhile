"","ja":"","ko":"\ub3c4\uc2dc","ur":"","vi":"Th\xe0nh ph\u1ed1"}},"UI_ZIP_CODE":{"value":"Zip","translations":{"es":"C\xf3digo postal","zh-hant":"\u90f5\u5340","tl":"Zip","hi":"\u091c\u093c\u093f\u092a","ja":"\u90f5\u4fbf\u756a\u53f7","ko":"\uc6b0\ud3b8\ubc88\ud638","ur":"\u0632\u0650\u067e","vi":"M\xe3 b\u01b0u \u0111i\u1ec7n"}},"UI_MAIL_ADDRESS":{"value":"Mailing Address","translations":{"es":"Domicilio","zh-hant":"\u90f5\u5bc4\u5730\u5740","tl":"","hi":"\u0921\u093e\u0915 \u092a\u0924\u093e","ja":"\u90f5\u4fbf\u5b9b\u5148","ko":"\uc6b0\ud3b8 \uc8fc\uc18c","ur":"","vi":"\xd0\u1ecba ch\u1ec9","km":"\u17a2\u17b6\u179f\u1799\u178a\u17d2\u178b\u17b6\u1793\u1795\u17d2\u1789\u17be\u179f\u17c6\u1794\u17bb\u178f\u17d2\u179a"}},"UI_MAIL_CITY":{"value":"Mailing City","translations":{"es":"Ciudad","zh-hant":"\u90f5\u5bc4\u57ce\u5e02","tl":"","hi":"","ja":"","ko":"\ub3c4\uc2dc","ur":"","vi":"Th\xe0nh ph\u1ed1"}},"UI_MAIL_ZIP_CODE":{"value":"Mailing Zip","translations":{"es":"C\xf3digo postal","zh-hant":"\u90f5\u5bc4\u90f5\u5340","tl":"Zip","hi":"\u091c\u093c\u093f\u092a","ja":"\u90f5\u4fbf\u756a\u53f7","ko":"\uc6b0\ud3b8\ubc88\ud638","ur":"\u0632\u0650\u067e","vi":"M\xe3 b\u01b0u \u0111i\u1ec7n"}},"UI_MONTH":{"value":"Month","translations":{"es":"Mes","zh-hant":"\u6708","tl":"Buwan","hi":"\u092e\u093e\u0939","ja":"\u6708","ko":"\uc6d4","ur":"\u0645\u06c1\u06cc\u0646\u06c1","vi":"Th\xe1ng"}},"UI_DAY":{"value":"Day","translations":{"es":"D\xeda","zh-hant":"\u65e5","tl":"Araw","hi":"\u0926\u093f\u0928","ja":"\u65e5","ko":"\uc77c","ur":"\u062f\u0646","vi":"Ng\xe0y"}},"UI_YEAR":{"value":"Year","translations":{"es":"A\xf1o","zh-hant":"\u5e74","tl":"Taon","hi":"\u0935\u0930\u094d\u0937","ja":"\u5e74","ko":"\ub144","ur":"\u0633\u0627\u0644","vi":"N\u0103m"}},"UI_COUNTY":{"value":"County","translations":{}},"END_SESSION_PAGE_TITLE":{"value":"Thank you","translations":{"es":"Gracias","zh-hant":"\u8b1d\u8b1d","needed":"noi18n"}},"END_SESSION_PAGE_INTRO":{"value":"<p>Your session has been closed and your ballot selections have been cleared. Please follow the instructions provided in your return packet to send your selections to your local elections office.</p>","format":null,"style":null,"translations":{"es":"<p>Se ha cerrado su sesi\xf3n y sus selecciones de la boleta se han borrado. Por favor, siga las instrucciones proporcionadas en su paquete de devoluci\xf3n para enviar sus selecciones a su oficina local de elecciones.</p>","zh-hant":"<p>\u60a8\u7684\u6295\u7968\u671f\u5df2\u7d93\u7d50\u675f\uff0c\u9078\u7968\u7684\u9078\u64c7\u4ea6\u5df2\u6e05\u9664\u3002\u8acb\u4f9d\u7167\u5728\u60a8\u56de\u90f5\u90f5\u4ef6\u5305\u5167\u63d0\u4f9b\u7684\u6307\u793a\uff0c\u628a\u60a8\u7684\u6295\u7968\u9078\u64c7\u4ea4\u56de\u60a8\u672c\u5730\u7684\u9078\u8209\u8fa6\u516c\u5ba4\u3002</p>","tl":"<p>Ang inyong sesyon ay sarado na at ang inyong mga pinili sa balota ay nabura na. Mangyaring sundin ang mga instruksiyon na nasa inyong pambalik na pakete upang maipadala ang inyong mga pinili sa inyong lokal na opisinang pang-eleksyon.</p>","vi":"<p>Phi\xean b\u1ea7u ch\u1ecdn c\u1ee7a qu\xfd v\u1ecb \u0111\xe3 \u0111\xf3ng l\u1ea1i v\xe0 c\xe1c l\u1ef1a ch\u1ecdn phi\u1ebfu b\u1ea7u c\u1ee7a qu\xfd v\u1ecb \u0111\xe3 \u0111\u01b0\u1ee3c x\xf3a. Vui l\xf2ng l\xe0m theo c\xe1c h\u01b0\u1edbng d\u1eabn c\xf3 trong phong b\xec h\u1ed3 s\u01a1 n\u1ed9p l\u1ea1i c\u1ee7a qu\xfd v\u1ecb \u0111\u1ec3 g\u1eedi c\xe1c b\u1ea7u ch\u1ecdn c\u1ee7a m\xecnh \u0111\u1ebfn v\u0103n ph\xf2ng b\u1ea7u c\u1eed \u0111\u1ecba ph\u01b0\u01a1ng.</p>","km":"<p>\u1796\u17c1\u179b\u200b\u179c\u17c1\u179b\u17b6\u200b\u1780\u17c6\u200b\u178e\u178f\u17cb\u200b\u1780\u17b6\u179a\u200b\u1794\u17d2\u179a\u17be\u200b\u1794\u17d2\u179a\u17b6\u179f\u17cb\u200b\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b\u178f\u17d2\u179a\u17bc\u179c\u200b\u1794\u17b6\u1793\u200b\u1794\u17b7\u1791 \u17a0\u17be\u1799\u200b\u1780\u17b6\u179a\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b\u200b\u178f\u17d2\u179a\u17bc\u179c\u200b\u1794\u17b6\u1793\u200b\u1787\u1798\u17d2\u179a\u17c7 \u17d4\u200b \u179f\u17bc\u1798\u200b\u17a2\u1793\u17bb\u179c\u178f\u17d2\u178f\u200b\u1791\u17c5\u178f\u17b6\u1798\u200b\u1780\u17b6\u179a\u200b\u178e\u17c2\u200b\u1793\u17b6\u17c6\u200b\u178a\u17c2\u179b\u200b\u1794\u17b6\u1793\u200b\u1795\u17d2\u178f\u179b\u17cb\u200b\u1787\u17bc\u1793\u200b\u1793\u17c5\u200b\u1780\u17d2\u1793\u17bb\u1784\u200b\u1780\u1789\u17d2\u1785\u1794\u17cb\u200b\u1795\u17d2\u1789\u17be\u200b\u178f\u17d2\u179a\u200b\u17a1\u1794\u17cb\u200b \u178a\u17be\u1798\u17d2\u1794\u17b8\u1795\u17d2\u1789\u17be\u200b\u1780\u17b6\u179a\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b\u1791\u17c5\u200b\u1780\u17b6\u179a\u17b7\u1799\u17b6\u179b\u17d0\u1799\u200b\u1794\u17c4\u17c7\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u1780\u17d2\u1793\u17bb\u1784\u200b\u1798\u17bc\u179b\u200b\u178a\u17d2\u178b\u17b6\u1793\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780 \u17d4\u200b</p>","hi":"<p>\u0906\u092a\u0915\u093e \u0938\u0924\u094d\u0930 \u092c\u0902\u0926 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u0947 \u092e\u0924\u092a\u0924\u094d\u0930 \u091a\u092f\u0928 \u092e\u093f\u091f\u093e \u0926\u093f\u090f \u0917\u090f \u0939\u0948\u0902\u0964 \u0905\u092a\u0928\u0947 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u091a\u0941\u0928\u093e\u0935 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0915\u094b \u0905\u092a\u0928\u0947 \u091a\u092f\u0928 \u092d\u0947\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u0935\u093e\u092a\u0938\u0940 \u092a\u0948\u0915\u0947\u091f \u092e\u0947\u0902 \u0926\u093f\u092f\u0947 \u0917\u092f\u0947 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0964</p>","ja":"<p>\u3042\u306a\u305f\u306e\u30bb\u30c3\u30b7\u30e7\u30f3\u306f\u7d42\u4e86\u3057\u3001\u6295\u7968\u9078\u629e\u5185\u5bb9\u306f\u6d88\u53bb\u3055\u308c\u307e\u3057\u305f\u3002\u63d0\u51fa\u7528\u30d1\u30b1\u30c3\u30c8\u306b\u8a18\u8f09\u3055\u308c\u3066\u3044\u308b\u6307\u793a\u306b\u5f93\u3063\u3066\u3001\u9078\u629e\u5185\u5bb9\u3092\u5730\u65b9\u9078\u6319\u4e8b\u52d9\u6240\u306b\u63d0\u51fa\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>","ko":"<p>\uadc0\ud558\uc758 \uc138\uc158\uc774 \uc885\ub8cc\ub418\uc5c8\uc73c\uba70 \ud22c\ud45c\uc9c0 \uc120\ud0dd \ud56d\ubaa9\uc774 \ucde8\uc18c\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uadc0\ud558\uc758 \uc120\ud0dd \ud56d\ubaa9\uc744 \uc9c0\uc5ed \uc120\uac70 \uc0ac\ubb34\uc18c\ub85c \ubcf4\ub0b4\ub824\uba74 \ubc18\uc1a1 \ud328\ud0a4\uc9c0\uc758 \uc9c0\uce68\uc744 \ub530\ub974\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.</p>"}},"END_SESSION_WARNING":{"value":"Warning! Ending your session will clear all your ballot selections. This cannot be undone.","translations":{"es":"\xa1Advertencia! Si cierra su sesi\xf3n, se borrar\xe1n todas sus selecciones de la boleta. Esta acci\xf3n no puede deshacerse.","zh-hant":"\u8b66\u544a\uff01 \u95dc\u9589\u6295\u7968\u671f\u5c07\u6e05\u9664\u6240\u6709\u9078\u7968\u9078\u64c7\u3002 \u9019\u7121\u6cd5\u64a4\u6d88\u3002","zh-hans":"\u8b66\u544a\uff01\u5173\u95ed\u60a8\u7684\u4f1a\u8bdd\u4f1a\u6e05\u9664\u60a8\u7684\u6240\u6709\u6295\u7968\u9009\u62e9\u3002\u8fd9\u4e2a\u52a8\u4f5c\u65e0\u6cd5\u64a4\u6d88\u3002","tl":"Babala! Ang pagsasara ng iyong sesyon ay magbubura sa lahat ng iyong mga pinili sa balota. Hindi ito maaaring bawiin.","hi":"\u091a\u0947\u0924\u093e\u0935\u0928\u0940! \u0905\u0917\u0930 \u0906\u092a \u0905\u092a\u0928\u093e \u0938\u0924\u094d\u0930 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902\u0917\u0947, \u0924\u094b \u0906\u092a\u0915\u0947 \u0938\u092d\u0940 \u092e\u0924\u092a\u0924\u094d\u0930 \u091a\u092f\u0928 \u0938\u093e\u092b \u0939\u094b \u091c\u093e\u090f\u0902\u0917\u0947\u0964 \u0907\u0938\u0947 \u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0947\u0917\u093e\u0964","ja":"\u8b66\u544a\uff01\u3000\u3053\u306e\u30bb\u30c3\u30b7\u30e7\u30f3\u3092\u9589\u3058\u308b\u3068\u3001\u6295\u7968\u7528\u7d19\u306e\u9078\u629e\u304c\u5931\u308f\u308c\u307e\u3059\u3002\u3053\u308c\u306f\u5143\u306b\u623b\u3059\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002","ko":"\uacbd\uace0! \uc138\uc158\uc744 \uc885\ub8cc\ud558\uc2dc\uba74, \uadc0\ud558\uc758 \ud22c\ud45c \uc120\ud0dd \ub0b4\uc5ed\uc774 \ubaa8\ub450 \uc0ad\uc81c\ub429\ub2c8\ub2e4. \uc2e4\ud589 \ud6c4\uc5d0\ub294 \ubcf5\uad6c\uac00 \ubd88\uac00\ub2a5\ud569\ub2c8\ub2e4.","ur":"\u0627\u0646\u062a\u0628\u0627\u06c1! \u0633\u06cc\u0634\u0646 \u0628\u0646\u062f \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0622\u067e \u06a9\u06d2 \u062a\u0645\u0627\u0645 \u0628\u06cc\u0644\u0679 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0635\u0627\u0641 \u06c1\u0648 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4 \u0627\u0633\u06d2 \u0644\u0648\u0679\u0627\u06cc\u0627 \u0646\u06c1\u06cc\u06ba \u062c\u0627\u0633\u06a9\u062a\u0627\u06d4","vi":"C\u1ea3nh B\xe1o! \u0110\xf3ng phi\xean ch\u1ecdn n\xe0y s\u1ebd x\xf3a t\u1ea5t c\u1ea3 c\xe1c l\u1ef1a ch\u1ecdn l\xe1 phi\u1ebfu c\u1ee7a qu\xfd v\u1ecb. S\u1ebd kh\xf4ng th\u1ec3 kh\xf4i ph\u1ee5c l\u1ea1i."}},"ACCESS_DENIED_PAGE_TITLE":{"value":"Access Denied","translations":{"es":"Acceso denegado","zh-hant":"\u62d2\u7d55\u8a2a\u554f","tl":"Walang pahintulot","ko":"\uc811\uadfc \ubd88\uac00","ja":"\u30a2\u30af\u30bb\u30b9\u304c\u62d2\u5426\u3055\u308c\u307e\u3057\u305f","vi":"Truy c\u1eadp b\u1ecb t\u1eeb ch\u1ed1i","needed":"noi18n"}},"ACCESS_DENIED_PAGE_INTRO":{"value":"<p>You are not allowed to access this page.</p>","format":null,"style":null,"translations":{"es":"<p> No tiene permiso para acceder a esta p\xe1gina. </p>","zh-hant":"<p>\u60a8\u7121\u6b0a\u8a2a\u554f\u6b64\u9801\u9762\u3002</ p>","tl":"<p> Hindi ka pinapayagang mag-access sa pahinang ito. </p>","ko":"<p>\uc774 \ud398\uc774\uc9c0\uc5d0 \uc561\uc138\uc2a4 \ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. </ p>","ja":"<p>\u3053\u306e\u30da\u30fc\u30b8\u3078\u306e\u30a2\u30af\u30bb\u30b9\u306f\u8a31\u53ef\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002</ p>","vi":"<p> B\u1ea1n kh\xf4ng \u0111\u01b0\u1ee3c ph\xe9p truy c\u1eadp trang n\xe0y. </ p>","needed":"noi18n"}},"NOT_USED_WRITE_IN_LABEL":{"value":"Write in [x] of [y]","translations":{"es":"Escriba en [x] de [y]","zh-hant":"\u5beb\u5165 [y] \u7684 [x]","zh-hans":"\u5019\u9009 [x] / [y]","tl":"Sumulat sa [x] ng [y]","hi":"[y] \u0915\u0947 [x] \u092e\u0947\u0902 \u0932\u093f\u0916\u0947\u0902","ja":"[y]\u306e[x]\u306b\u5165\u529b\u3059\u308b","ko":"[y] \uc758 [x] \ub77c\uace0 \uae30\uc7ac\ud558\uc2ed\uc2dc\uc624","ur":"[x] \u0627\u0632 [y] \u0645\u06cc\u06ba \u0644\u06a9\u06be\u06cc\u06ba","vi":"B\u1ea7u \u1ee9ng vi\xean b\u1ed5 sung [x] c\u1ee7a [y]"}},"NOT_USED_WRITE_IN_LABEL_ENTER_TEXT":{"value":"Please enter a name in the following field","translations":{"es":"Ingrese un nombre en el siguiente campo","zh-hant":"\u8acb\u5728\u4e0b\u5217\u6b04\u4f4d\u4e2d\u8f38\u5165\u540d\u7a31","zh-hans":"\u8bf7\u5728\u4ee5\u4e0b\u680f\u4f4d\u8f93\u5165\u540d\u79f0","tl":"Mangyaring ilagay ang pangalan sa sumusunod na patlang","hi":"\u0915\u0943\u092a\u092f\u093e \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u092b\u0940\u0932\u094d\u0921 \u092e\u0947\u0902 \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","ja":"\u4ee5\u4e0b\u306e\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u540d\u524d\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044","ko":"\ub2e4\uc74c\uc758 \uc601\uc5ed\ubc15\uc2a4\uc5d0 \uc774\ub984\uc744 \uae30\uc7ac\ud558\uc2ed\uc2dc\uc624","ur":"\u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0645\u0646\u062f\u0631\u062c\u06c1 \u0630\u06cc\u0644 \u062c\u06af\u06c1 \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0646\u0627\u0645 \u062f\u0627\u062e\u0644 \u06a9\u0631\u06cc\u06ba","vi":"Vui l\xf2ng nh\u1eadp t\xean v\xe0o \xf4 sau"}},"NOT_USED_YET_PASSTHROUGH_TITLE":{"value":"Access Denied","translations":{"es":"Acceso denegado","zh-hant":"\u62d2\u7d55\u4f7f\u7528","tl":"Walang Pahintulot","hi":"\u092a\u0939\u0941\u0901\u091a \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u093f\u092f\u093e \u0917\u092f\u093e","ja":"\u30a2\u30af\u30bb\u30b9\u304c\u62d2\u5426\u3055\u308c\u307e\u3057\u305f","ko":"\uc811\uadfc \uac70\ubd80","ur":"\u0631\u0633\u0627\u0626\u06cc \u0645\u0646\u0639 \u06c1\u06d2","vi":"Truy c\u1eadp B\u1ecb ch\u1eb7n"}},"NOT_USED_YET_PASSTHROUGH_WARNING":{"value":"You must access this website by following a link provided by your local elections official.","translations":{"es":"Debe acceder a este sitio web al seguir un enlace que le proporcione su funcionario electoral local.","zh-hant":"\u60a8\u5fc5\u9808\u6309\u7167\u7576\u5730\u9078\u8209\u5b98\u54e1\u63d0\u4f9b\u7684\u9023\u7d50\u4f7f\u7528\u8a72\u7db2\u7ad9\u3002","tl":"Dapat mong i-access ang website na ito sa pamamagitan ng pagsunod sa isang link na ibinigay ng iyong lokal na opisyal ng halalan.","hi":"\u0906\u092a\u0915\u094b \u0907\u0938 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0906\u092a\u0915\u0947 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u091a\u0941\u0928\u093e\u0935 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u090f \u0917\u090f \u0932\u093f\u0902\u0915 \u0915\u093e \u0905\u0928\u0941\u0938\u0930\u0923 \u0915\u0930\u0915\u0947 \u092a\u0939\u0941\u0901\u091a \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0940 \u0939\u094b\u0917\u0940\u0964","ja":"\u73fe\u5730\u306e\u9078\u6319\u4e8b\u52d9\u6240\u304b\u3089\u63d0\u4f9b\u3055\u308c\u305f\u30ea\u30f3\u30af\u306b\u5f93\u3063\u3066\u3001\u3053\u306e\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002","ko":"\ubcf8 \uc6f9\uc0ac\uc774\ud2b8\ub294 \uc9c0\uc5ed \uc120\uac70 \uc0ac\ubb34\uc18c\uac00 \uc81c\uacf5\ud55c \ub9c1\ud06c\ub97c \ud1b5\ud574\uc11c\ub9cc \uc811\uadfc\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.","ur":"\u0622\u067e \u06a9\u0648 \u0627\u06cc\u06a9 \u0644\u0646\u06a9 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2 \u0627\u0633 \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u062a\u06a9  \u0631\u0633\u0627\u0626\u06cc \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u0627 \u06c1\u0648\u06af\u06cc \u062c\u0648 \u0622\u067e \u06a9\u06d2 \u0645\u0642\u0627\u0645\u06cc \u0627\u0644\u06cc\u06a9\u0634\u0646 \u0627\u06c1\u0644\u06a9\u0627\u0631 \u0646\u06d2 \u0645\u06c1\u06cc\u0627 \u06a9\u06cc\u0627 \u06c1\u0648\u06d4","vi":"Qu\xfd v\u1ecb ph\u1ea3i truy c\u1eadp trang m\u1ea1ng n\xe0y b\u1eb1ng c\xe1ch s\u1eed d\u1ee5ng \u0111\u01b0\u1eddng link \u0111\u01b0\u1ee3c vi\xean ch\u1ee9c b\u1ea7u c\u1eed t\u1ea1i \u0111\u1ecba ph\u01b0\u01a1ng qu\xfd v\u1ecb cung c\u1ea5p."}},"NOT_USED_YET_PASSTHROUGH_BUTTON":{"value":"Go to my county website","translations":{"es":"Ir al sitio web de mi condado","zh-hant":"\u524d\u5f80\u6211\u6240\u5728\u7e23\u7684\u7db2\u7ad9","tl":"Pumunta sa aking county website","hi":"\u092e\u0947\u0930\u0947 \u0926\u0947\u0936 \u0915\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u091c\u093e\u090f\u0901","ja":"\u5c45\u4f4f\u5730\u306e\u90e1\u306e\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u306b\u79fb\u52d5\u3059\u308b","ko":"\uac70\uc8fc \uce74\uc6b4\ud2f0 \uc6f9\uc0ac\uc774\ud2b8 \ubc14\ub85c \uac00\uae30","ur":"\u0645\u06cc\u0631\u06cc \u06a9\u0627\u0624\u0646\u0679\u06cc \u06a9\u06cc \u0648\u06cc\u0628 \u0633\u0627\u0626\u0679 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba","vi":"D\u1eabn t\u1edbi trang m\u1ea1ng qu\u1eadn h\u1ea1t c\u1ee7a t\xf4i"}},"NOT_USED_YET_SAMPLE_BALLOT_INTRO":{"notes":"This text has the bit about clicking additional information","value":"<p>The following information is a list of contests just as they will appear on your ballot. You may click on a candidate name or measure response to mark it for future reference. You may also click on the more information links to view additional information.</p>","format":"html","translations":{"es":"<p>La siguiente informaci\xf3n es una lista de las contiendas electorales tal como aparecer\xe1n en su boleta. Puede hacer clic en el nombre de un candidato o en la respuesta de la medida para marcarla para futura referencia. Tambi\xe9n puede hacer clic en los enlaces para acceder a m\xe1s informaci\xf3n para ver dicha informaci\xf3n adicional.</p>","zh-hant":"<p>\u4ee5\u4e0b\u8cc7\u8a0a\u662f\u9078\u7968\u4e0a\u5c07\u51fa\u73fe\u7684\u7af6\u9078\u5217\u8868\u3002 \u53ef\u4ee5\u6309\u4e00\u4e0b\u5019\u9078\u4eba\u59d3\u540d\u6216\u8b70\u6848\u7b54\u5fa9\uff0c\u6ce8\u660e\u4f9b\u5c07\u4f86\u53c3\u8003\u3002 \u4e5f\u53ef\u4ee5\u6309\u4e00\u4e0b\u66f4\u591a\u8cc7\u8a0a\u9023\u7d50\u67e5\u770b\u5176\u4ed6\u8cc7\u8a0a\u3002</p>","tl":"<p>Ang sumusunod na impormasyon ay isang listahan ng mga paligsahan tulad ng makikita mo sa iyong balota. Maaari mong i-click ang pangalan ng isang kandidato o takalin ang tugon upang markahan ito para sa pagtukoy sa panghinaharap. Maaari mo ring i-click ang karagdagang impormasyon na mga link upang makita ang karagdagang impormasyon.</p>","hi":"<p>\u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u092a\u0930\u094d\u0927\u093f\u092f\u094b\u0902 \u0915\u0940 \u0920\u0940\u0915 \u0935\u0948\u0938\u0940 \u0939\u0940 \u0938\u0942\u091a\u0940 \u0939\u0948, \u091c\u0948\u0938\u0947 \u0935\u0947 \u0906\u092a\u0915\u0947 \u092e\u0924\u092a\u0924\u094d\u0930 \u092a\u0930 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0902\u0917\u0947\u0964 \u0906\u092a \u092d\u0935\u093f\u0937\u094d\u092f \u092e\u0947\u0902 \u0938\u0902\u0926\u0930\u094d\u092d \u0915\u0947 \u0932\u093f\u090f \u091a\u093f\u0939\u094d\u0928\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0915\u0947 \u0928\u093e\u092e \u092f\u093e \u0935\u093f\u0927\u0947\u092f\u0915 \u0909\u0924\u094d\u0924\u0930 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u0905\u0927\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0905\u0927\u093f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0932\u093f\u0902\u0915 \u092a\u0930 \u092d\u0940 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964</p>","ja":"<p>\u4ee5\u4e0b\u306e\u60c5\u5831\u306f\u3001\u6295\u7968\u7528\u7d19\u306b\u8a18\u8f09\u3055\u308c\u308b\u9078\u6319\u6226\u306e\u4e00\u89a7\u3067\u3059\u3002\u5f8c\u65e5\u306e\u53c2\u8003\u306e\u305f\u3081\u306b\u3001\u5019\u88dc\u8005\u306e\u540d\u524d\u307e\u305f\u306f\u6cd5\u6848\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u4ed6\u306e\u60c5\u5831\u30ea\u30f3\u30af\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u3001\u8ffd\u52a0\u60c5\u5831\u3092\u3054\u89a7\u3044\u305f\u3060\u3051\u307e\u3059\u3002</p>","ko":"<p>\ub2e4\uc74c\uc758 \uc815\ubcf4\ub294 \uacbd\ud569 \ubaa9\ub85d\uc73c\ub85c, \uadc0\ud558\uc758 \ud22c\ud45c \uc6a9\uc9c0\uc640 \ub3d9\uc77c\ud55c \ud654\uba74\uc785\ub2c8\ub2e4.  \ud6c4\ubcf4 \uc131\uba85\uc774\ub098 \uc815\ucc45\uc5d0 \ub300\ud55c \ub2f5\ubcc0\uc744 \ud074\ub9ad\ud558\uc2dc\uba74 \ucc38\uc870 \ud45c\uc2dc\uac00 \ub418\uc5b4 \ud3b8\ub9ac\ud558\uac8c \ub2e4\uc2dc \ucc3e\uc544 \ubcf4\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc815\ubcf4 \uad00\ub828 \ub9c1\ud06c\ub97c \ud074\ub9ad\ud558\uc2dc\uba74, \ucd94\uac00 \uc815\ubcf4\ub97c \ubcf4\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>","ur":"<p>\u0630\u06cc\u0644 \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0642\u0627\u0628\u0644\u0648\u06ba \u06a9\u06cc \u0627\u06cc\u06a9 \u0641\u06c1\u0631\u0633\u062a \u06c1\u06d2 \u062c\u06cc\u0633\u0627 \u06a9\u06c1 \u0648\u06c1 \u0622\u067e \u06a9\u06d2 \u0628\u06cc\u0644\u0679 \u067e\u0631 \u0638\u0627\u06c1\u0631 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0622\u067e \u0645\u0633\u062a\u0642\u0628\u0644 \u0645\u06cc\u06ba \u062d\u0648\u0627\u0644\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631 \u06a9\u06d2 \u0646\u0627\u0645 \u06cc\u0627 \u0627\u0642\u062f\u0627\u0645 \u06a9\u06d2 \u062c\u0648\u0627\u0628 \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0622\u067e \u0645\u0632\u06cc\u062f \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06d2 \u0644\u0646\u06a9\u0648\u06ba \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631 \u06a9\u06d2\u0627\u0636\u0627\u0641\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0628\u06be\u06cc \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4</p>","vi":"<p>Th\xf4ng tin sau \u0111\xe2y l\xe0 danh s\xe1ch c\xe1c tranh c\u1eed, th\xf4ng tin n\xe0y c\u0169ng s\u1ebd \u0111\u01b0\u1ee3c ghi tr\xean l\xe1 phi\u1ebfu c\u1ee7a qu\xfd v\u1ecb. Qu\xfd v\u1ecb c\xf3 th\u1ec3 ch\u1ecdn v\xe0o t\xean \u1ee9ng c\u1eed vi\xean ho\u1eb7c \u0111i\u1ec1u lu\u1eadt c\u1ea7n b\u1ecf phi\u1ebfu \u0111\u1ec3 \u0111\xe1nh d\u1ea5u n\xf3, d\xf9ng \u0111\u1ec3 tham kh\u1ea3o trong t\u01b0\u01a1ng lai. Qu\xfd v\u1ecb c\u0169ng c\xf3 th\u1ec3 nh\u1ea5p v\xe0o \u0111\u01b0\u1eddng link th\xeam th\xf4ng tin \u0111\u1ec3 xem th\xf4ng tin b\u1ed5 sung.</p>"}},"UI_VIEW_PDF":{"value":"View PDF","translations":{}},"UI_DOWNLOAD":{"value":"Download","translations":{}},"UI_ZOOM_IN":{"value":"Zoom In","translations":{}},"UI_ZOOM_OUT":{"value":"Zoom Out","translations":{}},"UI_CLOSE_PREVIEW":{"value":"Close Preview","translations":{}},"PRIVACY_POLICY_LINK":{"value":"Privacy Policy","translations":{"es":"Pol\xedtica de privacidad"}},"POWERED_BY_DEMOCRACY_LIVE":{"value":"Powered by Democracy Live","translations":{"es":"Desarrollado por Democracy Live"}},"PRIVACY_POLICY_TITLE":{"value":"Privacy Policy","translations":{"es":"Pol\xedtica de privacidad"}},"PRIVACY_POLICY_CONTENT":{"value":"<h2>Democracy Live Privacy Policy</h2>\\n<p>\\n  This website is a hosted application provided by Democracy Live. Democracy Live does not\\n  access, collect, sell, or distribute any information entered in this website. If technical support\\n  is required by a Democracy Live support specialist, they may temporarily access voter information\\n  to provide support to the customer or voter.\\n  <a href=\\"https://democracylive.com/privacy-policy/\\">Click here</a> to view Democracy Live\'s full Privacy Policy.\\n</p>\\n\\n<h2>reCaptcha</h2>\\n<p>\\n  This site is protected by reCAPTCHA and the Google\\n  <a href=\\"https://policies.google.com/privacy\\">Privacy Policy</a> and\\n  <a href=\\"https://policies.google.com/terms\\">Terms of Service</a> apply.\\n</p>\\n","translations":{"es":"<h2>Pol\xedtica de privacidad de Democracy Live</h2>\\n<p>\\n  Este sitio web es una aplicaci\xf3n alojada proporcionada por Democracy Live. Democracy Live no\\n accede, recopila, vende ni distribuye ninguna informaci\xf3n ingresada en este sitio web. Si un especialista en soporte\\n de Democracy Live requiere asistencia t\xe9cnica, pueden acceder temporalmente a la informaci\xf3n\\n del votante para brindar asistencia al cliente o votante.\\n <a href=\\"https://democracylive.com/privacy-policy/\\">Haga clic aqu\xed</a> para ver la Pol\xedtica de privacidad completa de Democracy Live.\\n</p>\\n </p>\\n\\n<h2>reCaptcha</h2>\\n<p>\\n  Este sitio est\xe1 protegido por reCAPTCHA y se aplican la <a href=\\"https://policies.google.com/privacy\\">Pol\xedtica de privacidad</a>\\n y los \\n  <a href=\\"https://policies.google.com/terms\\">T\xe9rminos de servicio</a> de Google.\\n</p>\\n"}},"TECHNICAL_SUPPORT_LINK":{"value":"Technical Support","translations":{"es":"Soporte t\xe9cnico"}},"TECHNICAL_SUPPORT_TITLE":{"value":"Technical Support","translations":{"es":"Soporte t\xe9cnico"}},"TECHNICAL_SUPPORT_CONTENT":{"value":"<h2>Email Support</h2>\\n<p>\\n If you run into any issues using OmniBallot, please send an email to <a href=\\"mailto:support@democracylive.com\\">support@democracylive.com</a> including any information about your web browser, operating system, and any steps to reproduce the issue. A technical support representative will respond to you promptly.\\n</p>\\n\\n<h2>Reporting Bugs</h2>\\n<p>\\n  Democracy Live considers keeping the voting process secure and confidential as our highest priority. We work with industry leading experts in information security in both public and private sector to maintain the privacy and integrity of our customers data as well as that of their voters.\\n</p>\\n<p>\\nWe encourage security professionals and developers of all skill levels to help us in keeping our OmniBallot platform secure for all voters. If you believe you\u2019ve discovered a bug or vulnerability while receiving your ballot through OmniBallot, we ask you contact us immediately.\\n</p>\\n\\n<h2>Submitting Bug or Vulnerability Reports</h2>\\n<p>\\n  Bug reports can be sent to <a href=\\"mailto:security@democracylive.com\\">security@democracylive.com</a>. Please see our <a href=\\"https://democracylive.com/disclosure-policy/\\" target=\\"_blank\\">Disclosure Policy</a> for additional information.\\n</p>\\n","translations":{"es":"<h2>Soporte de correo electr\xf3nico</h2>\\n<p>\\n  Si tiene alg\xfan problema al utilizar OmniBallot, env\xede un correo electr\xf3nico a <a href=\\"mailto:support@democracylive.com\\">support@democracylive.com</a> incluida cualquier informaci\xf3n sobre su navegador web, sistema operativo y cualquier paso para reproducir el problema. Un representante de soporte t\xe9cnico le responder\xe1 a la brevedad.\\n</p>\\n\\n<h2>Informar errores</h2>\\n<p>\\n  Democracy Live considera que mantener el proceso de votaci\xf3n seguro y confidencial es nuestra m\xe1xima prioridad. Trabajamos con expertos l\xedderes en la industria en seguridad de la informaci\xf3n tanto en el sector p\xfablico como en el privado para mantener la privacidad e integridad de los datos de nuestros clientes, as\xed como de sus votantes.\\n</p>\\n<p>\\n Alentamos a los profesionales y desarrolladores de seguridad de todos los niveles a que nos ayuden a mantener segura nuestra plataforma OmniBallot para todos los votantes. Si cree que ha descubierto un error o una vulnerabilidad al recibir su boleta a trav\xe9s de OmniBallot, le pedimos que se comunique con nosotros de inmediato.\\n</p>\\n\\n<h2>Env\xedo de informes de errores o vulnerabilidades</h2>\\n<p>\\n  Los informes de errores se pueden enviar a <a href=\\"mailto:security@democracylive.com\\">security@democracylive.com</a>. Consulte nuestra  <a href=\\"https://democracylive.com/disclosure-policy/\\" target=\\"_blank\\">Pol\xedtica de divulgaci\xf3n</a> para obtener informaci\xf3n adicional.\\n</p>\\n"}},"UI_IOS_BROWSER_WARNING":{"value":"<strong>Warning!</strong> \u2013 This application is not compatible with your browser on iOS. Please use\\n  Safari to continue.","translations":{}},"UI_ANDROID_FIREFOX_WARNING":{"value":"<strong>Warning!</strong> \u2013 This application is not compatible with Firefox on Android. Please use\\n Chrome to continue.","translations":{}},"UI_OUTDATED_BROWSER_WARNING":{"value":"<strong>Warning!</strong> \u2013 This application is not compatible with your current browser version. Please \\n upgrade your browser version or use another browser to continue.","translations":{}},"UI_ERROR_TITLE":{"value":"Error","translations":{}},"UI_ERROR_INTRO":{"value":"<p>\\nThe following error has occured. Please go back and try again or contact\\n  <a href=\\"[supportLink]\\" target=\\"blank\\">support@democracylive.com</a> with the following information for further assistance.</p>","format":"html","translations":{}}}')},TB59:function(e,t,n){!function(e){"use strict";e.defineLocale("en-il",{months:"January_February_March_April_May_June_July_August_September_October_November_December".split("_"),monthsShort:"Jan_Feb_Mar_Apr_May_Jun_Jul_Aug_Sep_Oct_Nov_Dec".split("_"),weekdays:"Sunday_Monday_Tuesday_Wednesday_Thursday_Friday_Saturday".split("_"),weekdaysShort:"Sun_Mon_Tue_Wed_Thu_Fri_Sat".split("_"),weekdaysMin:"Su_Mo_Tu_We_Th_Fr_Sa".split("_"),longDateFormat:{LT:"HH:mm",LTS:"HH:mm:ss",L:"DD/MM/YYYY",LL:"D MMMM YYYY",LLL:"D MMMM YYYY HH:mm",LLLL:"dddd, D MMMM YYYY HH:mm"},calendar:{sameDay:"[Today at] LT",nextDay:"[Tomorrow at] LT",nextWeek:"dddd [at] LT",lastDay:"[Yesterday at] LT",lastWeek:"[Last] dddd [at] LT",sameElse:"L"},relativeTime:{future:"in %s",past:"%s ago",s:"a few seconds",m:"a minute",mm:"%d minutes",h:"an hour",hh:"%d hours",d:"a day",dd:"%d days",M:"a month",MM:"%d months",y:"a year",yy:"%d years"},dayOfMonthOrdinalParse:/\d{1,2}(st|nd|rd|th)/,ordinal:function(e){var t=e%10;return e+(1==~~(e%100/10)?"th":1===t?"st":2===t?"nd":3===t?"rd":"th")}})}(n("wgY5"))},TLy2:function(e,t,n){"use strict";n.d(t,"a",(function(){return u}));var r=n("pBDD"),i=n("r9RI"),a=n("mW0F"),o=n("YtkY"),s=n("GoAz");function u(e,t){return"function"==typeof t?function(n){return n.pipe(u((function(n,r){return Object(s.a)(e(n,r)).pipe(Object(o.a)((function(e,i){return t(n,e,r,i)})))})))}:function(t){return t.lift(new l(e))}}var l=function(){function e(t){_classCallCheck2(this,e),this.project=t}return _createClass2(e,[{key:"call",value:function(e,t){return t.subscribe(new c(e,this.project))}}]),e}(),c=function(e){function t(e,n){var r;return _classCallCheck2(this,t),(r=_possibleConstructorReturn2(this,_getPrototypeOf2(t).call(this,e))).project=n,r.index=0,r}return _inherits2(t,e),_createClass2(t,[{key:"_next",value:function(e