u5f0f [code]","tl":"Uri ng Balota [code]","hi":"\u092e\u0924\u092a\u0924\u094d\u0930 \u0936\u0948\u0932\u0940 [code]","ja":"\u6295\u7968\u7528\u7d19\u306e\u5f62\u5f0f [code]","ko":"\ud22c\ud45c\uc9c0 \uc2a4\ud0c0\uc77c [code]","ur":"\u0628\u06cc\u0644\u0679 \u0633\u0679\u0627\u0626\u0644 [code]","vi":"Ki\u1ec3u L\xe1 Phi\u1ebfu [code]","km":"\u1791\u1798\u17d2\u179a\u1784\u17cb\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b [code]"},"tokens":{"code":"Style Code","name":"Style Name","partyName":"Party Name","partyCode":"party Code"}},"notFoundTitle":{"value":"No ballot found","translations":{"es":"No se encontr\xf3 la boleta","zh-hant":"\u6c92\u6709\u767c\u73fe\u6295\u7968","tl":"Walang nahanap na balota","hi":"\u0915\u094b\u0908 \u092e\u0924\u092a\u0924\u094d\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e","ja":"\u6295\u7968\u7528\u7d19\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f","ko":"\ud22c\ud45c\uc9c0\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.","ur":"\u06a9\u0648\u0626\u06cc \u0628\u06cc\u0644\u0679 \u0646\u06c1\u06cc\u06ba \u0645\u0644\u0627","vi":"Kh\xf4ng c\xf3 l\xe1 phi\u1ebfu n\xe0o \u0111\u01b0\u1ee3c t\xecm th\u1ea5y","km":"\u1782\u17d2\u1798\u17b6\u1793\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b"}},"notFoundMessage":{"value":"<p>We were unable to locate a ballot for you this election. If you feel this is an error, please contact your local elections office.</p>","format":"html","translations":{"es":"<p>No podemos encontrar una boleta para usted en esta elecci\xf3n. Si cree que esto es un error, comun\xedquese con su funcionario electoral local.</p>","zh-hant":"<p>\u6211\u5011\u7121\u6cd5\u627e\u5230\u60a8\u9019\u6b21\u9078\u8209\u7684\u6295\u7968\u3002 \u5982\u679c\u60a8\u89ba\u5f97\u9019\u662f\u4e00\u500b\u932f\u8aa4\uff0c\u8acb\u806f\u7d61\u60a8\u7576\u5730\u7684\u9078\u8209\u8fa6\u516c\u5ba4\u3002</p>","tl":"<p>Hindi namin mahanap ang balota para sa iyo sa halalan na ito. Kung sa tingin mo ito ay isang pagkakamali, mangyaring makipag-ugnay sa iyong lokal na opisina ng halalan.</p>","hi":"<p>\u0939\u092e \u0907\u0938 \u091a\u0941\u0928\u093e\u0935 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092e\u0924\u092a\u0924\u094d\u0930 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925 \u0930\u0939\u0947\u0964 \u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0915\u094b\u0908 \u095a\u0932\u0924\u0940 \u0939\u0948, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u091a\u0941\u0928\u093e\u0935 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964</p>","ja":"<p>\u3053\u306e\u9078\u6319\u306e\u3042\u306a\u305f\u306e\u6295\u7968\u7528\u7d19\u306f\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u3053\u308c\u304c\u8aa4\u308a\u3067\u3042\u308b\u3068\u601d\u308f\u308c\u308b\u5834\u5408\u306f\u3001\u5730\u65b9\u9078\u6319\u4e8b\u52d9\u6240\u306b\u3054\u9023\u7d61\u304f\u3060\u3055\u3044\u3002</p>","ko":"<p>\uc774\ubc88 \uc120\uac70\uc5d0\uc11c \uadc0\ud558\uac00 \uc0ac\uc6a9\ud558\uc2e4 \ud22c\ud45c\uc9c0\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc624\ub958\ub77c\uace0 \uc0dd\uac01\ub418\uba74 \uc9c0\uc5ed \uc120\uac70 \uc0ac\ubb34\uc18c\uc5d0 \ubb38\uc758\ud558\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.</p>","ur":"<p>\u06c1\u0645 \u0627\u0633 \u0627\u0644\u06cc\u06a9\u0634\u0646 \u0645\u06cc\u06ba \u0622\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0648\u0626\u06cc \u0628\u06cc\u0644\u0679 \u0688\u06be\u0648\u0646\u0688\u0646\u06d2 \u0633\u06d2 \u0642\u0627\u0635\u0631 \u06c1\u06cc\u06ba\u06d4 \u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u0644\u06af\u06d2 \u06a9\u06c1 \u0627\u06cc\u0633\u0627 \u063a\u0644\u0637\u06cc \u0633\u06d2 \u06c1\u0648\u0627 \u06c1\u06d2 \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u067e\u0646\u06d2 \u0645\u0642\u0627\u0645\u06cc \u0627\u0644\u06cc\u06a9\u0634\u0646 \u062f\u0641\u062a\u0631 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4</p>","vi":"<p>Ch\xfang t\xf4i kh\xf4ng t\xecm \u0111\u01b0\u1ee3c l\xe1 phi\u1ebfu cho qu\xfd v\u1ecb trong cu\u1ed9c b\u1ea7u c\u1eed n\xe0y. N\u1ebfu qu\xfd v\u1ecb c\u1ea3m th\u1ea5y \u0111\xe2y l\xe0 l\u1ed7i sai, h\xe3y li\xean h\u1ec7 v\u1edbi v\u0103n ph\xf2ng b\u1ea7u c\u1eed \u0111\u1ecba ph\u01b0\u01a1ng c\u1ee7a qu\xfd v\u1ecb.</p>","km":"<p>\u1799\u17be\u1784\u200b\u1798\u17b7\u1793\u200b\u17a2\u17b6\u1785\u200b\u179a\u1780\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb\u200b\u1780\u17b6\u179a\u200b\u1787\u17d2\u179a\u17be\u179f\u200b\u179a\u17be\u179f\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b\u1783\u17be\u1789\u200b\u1791\u17c1\u200b \u17d4\u200b \u1794\u17d2\u179a\u200b\u179f\u17b7\u1793\u200b\u1794\u17be\u200b\u17a2\u17d2\u1793\u1780\u200b\u200b\u1799\u179b\u17cb\u200b\u1790\u17b6\u200b\u1793\u17c1\u17c7\u200b\u1787\u17b6\u200b\u1780\u17c6\u200b\u17a0\u17bb\u179f\u1793\u17c4\u17c7 \u179f\u17bc\u1798\u200b\u1791\u17b6\u1780\u17cb\u200b\u1791\u1784\u200b\u1780\u17b6\u179a\u17b7\u1799\u17b6\u179b\u17d0\u1799\u200b\u1794\u17c4\u17c7\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u1780\u17d2\u1793\u17bb\u1784\u200b\u1798\u17bc\u179b\u200b\u178a\u17d2\u178b\u17b6\u1793\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780 \u17d4\u200b</p>"}},"errorTitle":{"value":"Error","translations":{"es":"Error","zh-hant":"\u932f\u8aa4","tl":"Mali","hi":"\u0917\u095c\u092c\u095c\u0940","ja":"\u30a8\u30e9\u30fc","ko":"\uc624\ub958","ur":"\u0646\u0642\u0635","vi":"L\u1ed7i sai","km":"\u1780\u17c6\u200b\u17a0\u17bb\u179f\u200b"}},"errorMessage":{"value":"<p>Uh oh. Something is not quite right. [error]</p>","format":"html","translations":{"es":"<p>\xa1Oh, no! Algo est\xe1 mal. [error]</p>","zh-hant":"<p>\u554a\u3002 \u51fa\u932f\u4e86\u3002 [error]</p>","tl":"<p>Uh oh. May isang bagay na hindi tama. [error]</p>","hi":"<p>\u0909\u0939 \u0913\u0939\u0964 \u0915\u0941\u091b \u092c\u093f\u0932\u0915\u0941\u0932 \u0938\u0939\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 [\u0917\u095c\u092c\u095c\u0940]</p>","ja":"<p>\u3042\u308c\u3063\u3002\u4f55\u304b\u304c\u9593\u9055\u3063\u3066\u3044\u308b\u3088\u3046\u3067\u3059\u3002[\u30a8\u30e9\u30fc]</p>","ko":"<p>\uc8c4\uc1a1\ud569\ub2c8\ub2e4. \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. [error]</p>","ur":"<p>\u0627\u0648\u06c1 \u06c1\u0648\u06d4 \u06a9\u0686\u06be \u0679\u06be\u06cc\u06a9 \u0646\u06c1\u06cc\u06ba \u0644\u06af\u062a\u0627\u06d4 [error]</p>","vi":"<p>\u1ed2. C\xf3 sai s\xf3t g\xec \u0111\xf3. [error]</p>","km":"<p>\u17a2\u17ca\u17bb \u17a2\u17ca\u17bc \u17d4 \u1798\u17b6\u1793\u200b\u17a2\u17d2\u179c\u17b8\u200b\u1798\u17bd\u1799\u200b\u1798\u17b7\u1793\u200b\u178f\u17d2\u179a\u17b9\u1798\u200b\u178f\u17d2\u179a\u17bc\u179c\u17a0\u17be\u1799\u200b \u17d4\u200b [error]</p>"},"tokens":{"error":"Error Message"}}},"radios":{"requiredFields":["title","options"],"required":false,"options":null,"contentRight":{"fieldType":"TranslatableText","includeByDefault":false,"defaultValue":{"value":"","format":"html","translations":{}}}},"voter-guide":{"requiredFields":["aid","eid","styleId","precinctId"],"aid":"","eid":0,"styleId":0,"precinctId":0,"fullBallot":false,"showBarcode":false,"canSkip":true,"title":{"value":"County Voter Information Guide","format":null,"style":null,"translations":{"zh-hant":"\u7e23\u9078\u6c11\u8cc7\u8a0a\u6307\u5357","hi":"\u0915\u093e\u0909\u0902\u091f\u0940 \u092e\u0924\u0926\u093e\u0924\u093e \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0917\u093e\u0907\u0921","ja":"\u90e1\u306e\u6709\u6a29\u8005\u60c5\u5831\u30ac\u30a4\u30c9","ko":"