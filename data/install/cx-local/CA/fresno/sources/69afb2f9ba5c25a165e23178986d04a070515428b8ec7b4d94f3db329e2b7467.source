:"Mga Panukala","hi":"\u0935\u093f\u0927\u0947\u092f\u0915","ja":"\u6cd5\u6848","ko":"\ubc95\uc548","ur":"\u0627\u0642\u062f\u0627\u0645\u0627\u062a","vi":"C\xe1c \u0110i\u1ec1u Lu\u1eadt c\u1ea7n B\u1ecf Phi\u1ebfu","km":"\u179c\u17b7\u1792\u17b6\u1793\u1780\u17b6\u179a"}},"tabAdditionalInfo":{"value":"Additional Info","translations":{"es":"Informaci\xf3n adicional","zh-hant":"\u9644\u52a0\u8cc7\u8a0a","tl":"Karagdagang Impormasyon","hi":"\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940","ja":"\u8ffd\u52a0\u60c5\u5831","ko":"\ucd94\uac00 \uc815\ubcf4","ur":"\u0627\u0636\u0627\u0641\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a","vi":"Th\xf4ng Tin B\u1ed5 Sung"}},"tabReferenceBallot":{"value":"Reference Ballot","translations":{"es":"Boleta de referencia","zh-hant":"\u53c3\u8003\u9078\u7968","tl":"Reference na Balota","hi":"\u0938\u0902\u0926\u0930\u094d\u092d \u092e\u0924\u092a\u0924\u094d\u0930","ja":"\u53c2\u7167\u7528\u6295\u7968\u7528\u7d19","ko":"\ucc38\uc870 \ud22c\ud45c\uc9c0","ur":"\u062d\u0648\u0627\u0644\u06d2 \u06a9\u0627 \u0628\u06cc\u0644\u0679","vi":"Phi\u1ebfu B\u1ea7u Tham Kh\u1ea3o","km":"\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u200b\u200b\u1786\u17d2\u1793\u17c4\u178f\u1787\u17b6\u200b\u17af\u1780\u179f\u17b6\u179a\u200b\u1799\u17c4\u1784"}},"instructionsIntro":{"value":"<p>This is your Accessible Voter Information Guide and Sample Ballot. You will find a list of available information pertaining to this election by clicking on the links provided.</p>","format":"html","translations":{"es":"<p>Esta es su Gu\xeda accesible de informaci\xf3n para los votantes y su Boleta de muestra. Encontrar\xe1 una lista de la informaci\xf3n disponible perteneciente a esta elecci\xf3n al hacer clic en los enlaces proporcionados.</p>","zh-hant":"<p>\u9019\u662f\u60a8\u7684\u7121\u969c\u7919\u9078\u6c11\u8cc7\u8a0a\u6307\u5357\u548c\u6a23\u672c\u9078\u7968\u3002 \u6309\u4e00\u4e0b\u63d0\u4f9b\u7684\u9023\u7d50\uff0c\u5373\u53ef\u627e\u5230\u8207\u672c\u6b21\u9078\u8209\u6709\u95dc\u7684\u53ef\u7528\u8cc7\u8a0a\u6e05\u55ae\u3002</p>","tl":"<p>Ito ang iyong Magagamit na Gabay sa Impormasyon ng Botante at Halimbawa na Balota. Makikita mo ang isang listahan ng mga impormasyong maaaring gamitin na nauukol sa halalang ito sa pamamagitan ng pag-click sa mga link na ibinigay.</p>","hi":"<p>\u092f\u0939 \u0906\u092a\u0915\u0940 \u0938\u0941\u0932\u092d \u092e\u0924\u0926\u093e\u0924\u093e \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0917\u093e\u0907\u0921 \u0914\u0930 \u0928\u092e\u0942\u0928\u093e \u092e\u0924\u092a\u0924\u094d\u0930 \u0939\u0948\u0964 \u0906\u092a\u0915\u094b \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u0947 \u0917\u092f\u0947 \u0932\u093f\u0902\u0915\u094b\u0902 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0915\u0947 \u0907\u0938 \u091a\u0941\u0928\u093e\u0935 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0909\u092a\u0932\u092c\u094d\u0927 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0940 \u090f\u0915 \u0938\u0942\u091a\u0940 \u092e\u093f\u0932\u0947\u0917\u0940\u0964</p>","ja":"<p>\u3053\u308c\u306f\u3001\u30d0\u30ea\u30a2\u30d5\u30ea\u30fc\u306e\u6709\u6a29\u8005\u60c5\u5831\u30ac\u30a4\u30c9\u304a\u3088\u3073\u6295\u7968\u7528\u7d19\u898b\u672c\u3067\u3059\u3002\u30ea\u30f3\u30af\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u3001\u4eca\u56de\u306e\u6295\u7968\u306b\u95a2\u9023\u3057\u3066\u5165\u624b\u3067\u304d\u308b\u60c5\u5831\u306e\u4e00\u89a7\u8868\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002</p>","ko":"<p>\ubcf8 \ud22c\ud45c\uc9c0\ub294 \uadc0\ud558\uc758 \uc811\uadfc \uac00\ub2a5\ud55c \uc720\uad8c\uc790 \uc815\ubcf4 \uac00\uc774\ub4dc \ubc0f \uacac\ubcf8 \ud22c\ud45c\uc9c0\uc785\ub2c8\ub2e4. \uc81c\uacf5\ub41c \ub9c1\ud06c\ub97c \ud074\ub9ad\ud558\uc5ec \uc774 \uc120\uac70\uc640 \uad00\ub828\ud574 \uc774\uc6a9 \uac00\ub2a5\ud55c \uc815\ubcf4 \ubaa9\ub85d\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>","ur":"<p>\u06cc\u06c1 \u0622\u067e \u06a9\u06cc \u0642\u0627\u0628\u0644 \u0631\u0633\u0627\u0626\u06cc \u0648\u0648\u0679\u0631 \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc \u06af\u0627\u0626\u06cc\u0688 \u0627\u0648\u0631 \u0628\u06cc\u0644\u0679 \u06a9\u0627 \u0646\u0645\u0648\u0646\u06c1 \u06c1\u06d2\u06d4 \u0622\u067e \u0645\u06c1\u06cc\u0627 \u06a9\u0631\u062f\u06c1 \u0644\u0646\u06a9\u0648\u06ba \u067e\u0631 \u06a9\u0644\u06a9 \u06a9\u0631\u06a9\u06d2 \u0627\u0633 \u0627\u0644\u06cc\u06a9\u0634\u0646 \u06a9\u06cc \u0628\u0627\u0628\u062a \u062f\u0633\u062a\u06cc\u0627\u0628 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc \u0627\u06cc\u06a9 \u0641\u06c1\u0631\u0633\u062a \u062d\u0627\u0635\u0644 \u06a9\u0631\u06cc\u06ba \u06af\u06d2\u06d4</p>","vi":"<p>\u0110\xe2y l\xe0 H\u01b0\u1edbng d\u1eabn cho Th\xf4ng Tin C\u1eed tri Khuy\u1ebft t\u1eadt v\xe0 L\xe1 Phi\u1ebfu M\u1eabu. Qu\xfd v\u1ecb s\u1ebd t\xecm th\u1ea5y danh s\xe1ch c\xe1c th\xf4ng tin c\xf3 s\u1eb5n li\xean quan \u0111\u1ebfn cu\u1ed9c b\u1ea7u c\u1eed n\xe0y b\u1eb1ng c\xe1ch nh\u1ea5p v\xe0o c\xe1c \u0111\u01b0\u1eddng link \u0111\u01b0\u1ee3c cung c\u1ea5p.</p>","km":"<p>\u1793\u17c1\u17c7\u200b\u1787\u17b6\u200b\u1796\u17d0\u178f\u17cc\u1798\u17b6\u1793\u178e\u17c2\u1793\u17b6\u17c6\u200b\u178a\u179b\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b\u1794\u17c4\u17c7\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u200b \u1793\u17b7\u1784\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u200b\u1782\u17c6\u179a\u17bc\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b\u178a\u17c2\u179b\u200b\u17a2\u17b6\u1785\u200b\u1791\u1791\u17bd\u179b\u200b\u1794\u17b6\u1793\u200b \u17d4\u200b \u17a2\u17d2\u1793\u1780\u200b\u1793\u17b9\u1784\u200b\u1791\u1791\u17bd\u179b\u200b\u1794\u17b6\u1793\u200b\u1794\u1789\u17d2\u1787\u17b8\u200b\u1796\u17d0\u178f\u17cc\u200b\u1798\u17b6\u1793\u200b\u178a\u17c2\u179b\u200b\u1798\u17b6\u1793\u200b\u200b\u17a2\u17c6\u200b\u1796\u17b8\u200b\u1780\u17b6\u179a\u200b\u1794\u17c4\u17c7\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u1793\u17c1\u17c7\u200b \u178a\u17c4\u1799\u200b\u1785\u17bb\u1785\u200b\u179b\u17be\u200b\u178f\u17c6\u200b\u178e\u200b\u1797\u17d2\u1787\u17b6\u1794\u17cb\u200b\u178a\u17c2\u179b\u1794\u17b6\u1793\u200b\u200b\u1795\u17d2\u178f\u179b\u17cb\u200b\u17b2\u17d2\u1799\u200b \u17d4\u200b</p>"}},"candidatesIntro":{"value":"<p>The Candidate Statements that appear in this guide provide each candidate an opportunity to speak to voters regarding his or her background, education, qualifications, and platform.</p><p>Including a statement in this guide is at the option of the candidates and those that choose to do so are required to purchase the space. Some candidates choose not to purchase space for a statement; therefore, this guide may not contain a statement for every candidate on your ballot.</p><p>If nothing is present, there are no candidates on the ballot in your jurisdiction.</p>","format":"html","style":null,"translations":{"zh-hant":"<p>\u672c\u6307\u5357\u4e2d\u7684\u5019\u9078\u4eba\u9673\u8ff0\u70ba\u6bcf\u4f4d\u5019\u9078\u4eba\u63d0\u4f9b\u4e86\u4e00\u500b\u8207\u9078\u6c11\u9032\u884c\u4ea4\u6d41\u7684\u6a5f\u6703\uff0c\u53ef\u4ee5\u4ecb\u7d39\u81ea\u5df1\u7684\u80cc\u666f\u3001\u6559\u80b2\u7a0b\u5ea6\u3001\u8cc7\u6b77\u548c\u7af6\u9078\u7db1\u9818\u3002</p><p>\u5019\u9078\u4eba\u53ef\u81ea\u884c\u9078\u64c7\u5728\u672c\u6307\u5357\u4e2d\u5305\u542b\u4e00\u4efd\u9673\u8a34\uff0c\u800c\u90a3\u4e9b\u9078\u64c7\u9019\u6a23\u505a\u7684\u5019\u9078\u4eba\u9700\u8981\u8cfc\u8cb7\u8a72\u7a7a\u9593\u3002 \u6709\u4e9b\u5019\u9078\u4eba\u9078\u64c7\u4e0d\u8cfc\u8cb7\u9673\u8ff0\u7a7a\u9593\uff0c\u56e0\u6b64\uff0c\u672c\u6307\u5357\u53ef\u80fd\u4e0d\u5305\u542b\u9078\u7968\u4e0a\u6bcf\u4f4d\u5019\u9078\u4eba\u7684\u9673\u8a34\u3002</p><p>\u5982\u679c\u9078\u7968\u4e0a\u6c92\u6709\u5019\u9078\u4eba\uff0c\u5373\u8868\u660e\u60a8\u7684\u9078\u5340\u6c92\u6709\u5019\u9078\u4eba\u5728\u9078\u7968\u4e0a\u3002</p>","hi":"<p>\u0907\u0938 \u0917\u093e\u0907\u0921 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930\u094b\u0902 \u0915\u0947 \u0935\u0915\u094d\u0924\u0935\u094d\u092f \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0943\u0937\u094d\u0920\u092d\u0942\u092e\u093f, \u0936\u093f\u0915\u094d\u0937\u093e, \u092f\u094b\u0917\u094d\u092f\u0924\u093e\u0913\u0902, \u0914\u0930 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u092e\u0924\u0926\u093e\u0924\u093e\u0913\u0902 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964</p><p>\u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930\u094b\u0902 \u0915\u0947 \u092a\u093e\u0938 \u0935\u093f\u0915\u0932\u094d\u092a \u0939\u094b\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u0947 \u0907\u0938 \u0917\u093e\u0907\u0921 \u092e\u0947\u0902 \u0935\u0915\u094d\u0924\u0935\u094d\u092f \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902 \u092f\u093e \u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u091c\u094b \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0935\u0915\u094d\u0924\u0935\u094d\u092f \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0928\u093e \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u094d\u0925\u093e\u0928 \u0916\u0930\u0940\u0926\u0928\u0947 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0915\u0941\u091b \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0935\u0915\u094d\u0924\u0935\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u0928 \u0928 \u0916\u0930\u0940\u0926\u0928\u093e \u091a\u0941\u0928\u0924\u0947 \u0939\u0948\u0902; \u0907\u0938\u0940\u0932\u093f\u090f, \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0907\u0938 \u0917\u093e\u0907\u0921 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u092e\u0924\u092a\u0924\u094d\u0930 \u092a\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0915\u093e \u0935\u0915\u094d\u0924\u0935\u094d\u092f \u0936\u093e\u092e\u093f\u0932 \u0928 \u0939\u094b\u0964</p><p>\u0905\u0917\u0930 \u0915\u0941\u091b \u092d\u0940 \u092e\u094c\u091c\u0942\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0924\u094b \u092e\u0924\u092a\u0924\u094d\u0930 \u092a\u0930 \u0906\u092a\u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u093e \u0915\u094b\u0908 \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964</p>","ja":"<p>\u672c\u30ac\u30a4\u30c9\u3067\u306f\u3001\u5019\u88dc\u8005\u306e\u58f0\u660e\u3068\u3057\u3066\u3001\u5019\u88dc\u8005\u306b\u81ea\u8eab\u306e\u7d4c\u6b74\u3001\u5b66\u6b74\u3001\u8cc7\u683c\u3001\u304a\u3088\u3073\u653f\u7db1\u3092\u9078\u6319\u6c11\u306b\u4f1d\u9054\u3059\u308b\u6a5f\u4f1a\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002</p><p>\u672c\u30ac\u30a4\u30c9\u3078\u306e\u58f0\u660e\u63b2\u8f09\u306e\u6709\u7121\u306f\u500b\u3005\u306e\u5019\u88dc\u8005\u306e\u9078\u629e\u306b\u3088\u308b\u3082\u306e\u3067\u3042\u308a\u3001\u58f0\u660e\u3092\u63b2\u8f09\u3059\u308b\u3053\u3068\u3092\u9078\u629e\u3057\u305f\u5019\u88dc\u8005\u306f\u63b2\u8f09\u67a0\u3092\u8cfc\u5165\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4e2d\u306b\u306f\u58f0\u660e\u306e\u63b2\u8f09\u67a0\u3092\u8cfc\u5165\u3057\u306a\u3044\u3053\u3068\u3092\u9078\u629e\u3057\u305f\u5019\u88dc\u8005\u3082\u3044\u308b\u305f\u3081\u3001\u6295\u7968\u7528\u7d19\u306b\u8a18\u8f09\u3055\u308c\u3066\u3044\u308b\u5019\u88dc\u8005\u5168\u54e1\u306e\u58f0\u660e\u304c\u672c\u30ac\u30a4\u30c9\u306b\u542b\u307e\u308c\u3066\u3044\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p><p>\u4f55\u3082\u793a\u3055\u308c\u3066\u3044\u306a\u3044\u5834\u5408\u306f\u3001\u305d\u306e\u533a\u57df\u306e\u9078\u6319\u306b\u306f\u5019\u88dc\u8005\u304c\u3044\u306a\u3044\u3068\u3044\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002</p>","ko":"<p>\ubcf8 \uc548\ub0b4\uc11c\uc5d0\uc11c \ubcf4\uc2dc\ub294 \ud6c4\ubcf4 \uc131\uba85\uc11c\ub294 \uac01 \ud6c4\ubcf4\uac00 \uc720\uad8c\uc790\uc5d0\uac8c \uac01\uc790\uc758 \ubc30\uacbd, \uad50\uc721, \uc790\uaca9 \ubc0f \uacbd\ub825\uc5d0 \ub300\ud558\uc5ec \ud53c\ub825\ud560 \uc218 \uc788\ub294 \uc5f0\ub2e8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.</p><p>\ubcf8 \uc548\ub0b4\uc11c\uc5d0 \uc131\uba85\uc11c\ub97c \ud3ec\ud568\ud558\ub294 \uac83\uc740 \ud6c4\ubcf4\uc758 \uc120\ud0dd\uc774\uba70, \uc774 \uae30\ud68c\ub97c \ud65c\uc6a9\ud558\uace0\uc790 \ud558\ub294 \ud6c4\ubcf4\ub294 \ud64d\ubcf4 \uacf5\uac04\uc744 \uad6c\ub9e4\ud558\uc600\uc2b5\ub2c8\ub2e4. \uc77c\ubd80 \ud6c4\ubcf4\ub294 \uc131\uba85\uc11c\ub97c \uac8c\uc7ac\ud560 \uacf5\uac04\uc744 \uad6c\ub9e4\ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ub530\ub77c\uc11c, \ubcf8 \uc548\ub0b4\uc11c\ub294 \uadc0\ud558\uac00 \ud22c\ud45c\ud560 \uc218 \uc788\ub294 \ud6c4\ubcf4\uc790 \ubaa8\ub450\uc758 \uc131\uba85\uc11c\ub97c \ud3ec\ud568\ud558\uace0 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.</p><p>\ud654\uba74\uc5d0 \ub0b4\uc6a9\uc774 \ubcf4\uc774\uc9c0 \uc54a\ub294 \uacbd\uc6b0\ub294, \uadc0\ud558\uc758 \uc120\uac70\uad6c\uc5d0 \ud6c4\ubcf4\uac00 \uc5c6\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.</p>","es":"<p>Las declaraciones de candidatos que aparecen en esta gu\xeda le brindan a cada candidato la oportunidad de dirigirse a los votantes con respecto a sus antecedentes, educaci\xf3n, calificaciones y plataforma.</p><p> La inclusi\xf3n de una declaraci\xf3n en esta gu\xeda queda al exclusivo criterio de los candidatos, pero aquellos que decidan hacerlo deben adquirir el espacio. Algunos candidatos deciden no adquirir el espacio para incluir una declaraci\xf3n; por lo tanto, es posible que esta gu\xeda no incluya un declaraci\xf3n de cada candidato en su boleta.</p><p>Si no hay ninguna declaraci\xf3n, no hay candidatos en la boleta en su jurisdicci\xf3n.</p>","tl":"<p>Ang mga Pahayag ng Kandidato na inilathala sa gabay na ito ay nagbibigay sa bawat kandidato ng pagkakataon upang makipag-usap sa mga botante tungkol sa kanilang karanasan, edukasyon, mga kwalipikasyon, at plataporma.</p><p>Kabilang ang isang pahayag sa gabay na ito ay nasa opsyon ng mga kandidato at ang piniling gawin ito ay kinakailangang magbayad para sa ispasiyo. Ang ilang mga kandidato ay pinili na huwag bumili ng ispasiyo para sa isang pahayag; samakatwid, ang gabay na ito ay maaaring hindi naglalaman ng pahayag ng bawat kandidato sa iyong balota.</p><p>Kung walang makikita, walang mga kandidato sa iyong balota sa iyong nasasakupan.</p>","ur":"<p>\u0627\u0633 \u0641\u06c1\u0631\u0633\u062a \u0645\u06cc\u06ba \u0638\u0627\u06c1\u0631 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631\u0648\u06ba \u06a9\u06d2 \u0628\u06cc\u0627\u0646\u0627\u062a \u06c1\u0631 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631 \u06a9\u0648 \u0645\u0648\u0642\u0639 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0648\u06c1 \u0627\u067e\u0646\u06d2 \u067e\u0633 \u0645\u0646\u0638\u0631\u060c \u062a\u0639\u0644\u06cc\u0645\u060c \u0627\u06c1\u0644\u06cc\u062a\u0648\u06ba \u0627\u0648\u0631 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06a9\u06d2 \u062d\u0648\u0627\u0644\u06d2 \u0633\u06d2 \u0648\u0648\u0679\u0631\u0648\u06ba \u0633\u06d2 \u0645\u062e\u0627\u0637\u0628 \u06c1\u0648 \u0633\u06a9\u06d2\u06d4</p><p>\u0627\u0633 \u06af\u0627\u0626\u06cc\u0688 \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \u0628\u06cc\u0627\u0646 \u0634\u0627\u0645\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0627\u0646\u062d\u0635\u0627\u0631 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631\u0648\u06ba \u067e\u0631 \u06c1\u06d2 \u0627\u0648\u0631 \u062c\u0648 \u0627\u06cc\u0633\u0627 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u06cc\u06ba \u0627\u0646\u06c1\u06cc\u06ba \u062c\u06af\u06c1 \u062e\u0631\u06cc\u062f\u0646\u0627 \u06c1\u0648\u062a\u06cc \u06c1\u06d2\u06d4 \u06a9\u0686\u06be \u0627\u0645\u06cc\u062f\u0648\u0627\u0631 \u0628\u06cc\u0627\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062c\u06af\u06c1 \u0646\u06c1 \u062e\u0631\u06cc\u062f\u0646\u06d2 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u061b \u0686\u0646\u0627\u06ba \u0686\u06c1 \u06c1\u0648\u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u06a9\u06d2 \u0628\u06cc\u0644\u0679 \u067e\u0631 \u0645\u0648\u062c\u0648\u062f \u06c1\u0631 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631 \u06a9\u0627 \u0628\u06cc\u0627\u0646 \u0627\u0633 \u06af\u0627\u0626\u06cc\u0688 \u0645\u06cc\u06ba \u0645\u0648\u062c\u0648\u062f \u0646\u06c1 \u06c1\u0648\u06d4</p><p>\u0627\u06af\u0631 \u06a9\u0686\u06be \u0628\u06be\u06cc \u0645\u0648\u062c\u0648\u062f \u0646\u06c1\u06cc\u06ba \u062a\u0648 \u0622\u067e \u06a9\u06d2 \u062d\u0644\u0642\u06d2 \u0645\u06cc\u06ba \u0628\u06cc\u0644\u0679 \u067e\u0631 \u06a9\u0648\u0626\u06cc \u0627\u0645\u06cc\u062f\u0648\u0627\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4</p>","vi":"<p>C\xe1c Tuy\xean B\u1ed1 c\u1ee7a \u1ee8ng C\u1eed Vi\xean \u1edf trong h\u01b0\u1edbng d\u1eabn n\xe0y cung c\u1ea5p cho m\u1ed7i \u1ee9ng c\u1eed vi\xean m\u1ed9t c\u01a1 h\u1ed9i \u0111\u1ec3 tr\xecnh b\xe0y v\u1edbi c\u1eed tri v\u1ec1 l\xfd l\u1ecbch, tr\xecnh \u0111\u1ed9 h\u1ecdc v\u1ea5n, ti\xeau chu\u1ea9n \u0111i\u1ec1u ki\u1ec7n v\xe0 di\u1ec5n \u0111\xe0n ch\xednh tr\u1ecb c\u1ee7a h\u1ecd.</p><p>C\xe1c \u1ee9ng c\u1eed vi\xean \u0111\u01b0\u1ee3c t\xf9y ch\u1ecdn c\xf3 k\xe8m b\u1ea3n tuy\xean b\u1ed1 v\xe0o b\u1ea3n h\u01b0\u1edbng d\u1eabn n\xe0y hay kh\xf4ng v\xe0 nh\u1eefng ng\u01b0\u1eddi ch\u1ecdn l\xe0m nh\u01b0 v\u1eady ph\u1ea3i mua \xf4 th\xf4ng tin n\xe0y. M\u1ed9t s\u1ed1 \u1ee9ng c\u1eed vi\xean quy\u1ebft \u0111\u1ecbnh kh\xf4ng mua \xf4 th\xf4ng tin \u0111\u1ec3 vi\u1ebft tuy\xean b\u1ed1; do \u0111\xf3, h\u01b0\u1edbng d\u1eabn n\xe0y c\xf3 th\u1ec3 kh\xf4ng c\xf3 tuy\xean b\u1ed1 cho m\u1ed7i \u1ee9ng c\u1eed vi\xean tr\xean l\xe1 phi\u1ebfu c\u1ee7a qu\xfd v\u1ecb</p><p>N\u1ebfu kh\xf4ng c\xf3 th\xf4ng tin n\xe0o hi\u1ec7n ra, kh\xf4ng c\xf3 \u1ee9ng c\u1eed vi\xean n\xe0o trong cu\u1ed9c b\u1ecf phi\u1ebfu trong th\u1ea9m quy\u1ec1n c\u1ee7a qu\xfd v\u1ecb.</p>"}},"measuresIntro":{"value":"<p>Below is information about the measures that will appear on your ballot. If nothing is present, there are no measures on the ballot in your jurisdiction.</p>","format":"html","translations":{"es":"<p>A continuaci\xf3n, encontrar\xe1 informaci\xf3n sobre las medidas que aparecer\xe1n en su boleta. Si no hay ninguna, no hay medidas en la boleta en su jurisdicci\xf3n.</p>","zh-hant":"<p>\u4ee5\u4e0b\u662f\u95dc\u65bc\u60a8\u9078\u7968\u4e0a\u5c07\u51fa\u73fe\u7684\u8b70\u6848\u7684\u8cc7\u8a0a\u3002 \u5982\u679c\u9078\u7968\u4e0a\u6c92\u6709\u8b70\u6848\uff0c\u5373\u8868\u660e\u60a8\u7684\u9078\u5340\u6c92\u6709\u8b70\u6848\u5728\u9078\u7968\u4e0a\u3002</p>","tl":"<p>Sa ibaba ay ang impormasyon tungkol sa mga panukala na makikita sa iyong balota. Kung walang makikita, walang mga panukala sa balota sa iyong nasasakupan.</p>","hi":"<p>\u0928\u0940\u091a\u0947 \u0909\u0928 \u0935\u093f\u0927\u0947\u092f\u0915\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0940 \u0917\u0908 \u0939\u0948, \u091c\u094b \u0906\u092a\u0915\u0947 \u092e\u0924\u092a\u0924\u094d\u0930 \u092a\u0930 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0902\u0917\u0947\u0964 \u0905\u0917\u0930 \u0915\u0941\u091b \u092d\u0940 \u092e\u094c\u091c\u0942\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0924\u094b \u092e\u0924\u092a\u0924\u094d\u0930 \u092a\u0930 \u0906\u092a\u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u093e \u0915\u094b\u0908 \u0935\u093f\u0927\u0947\u092f\u0915 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964</p>","ja":"<p>\u4ee5\u4e0b\u306f\u3001\u6295\u7968\u7528\u7d19\u306b\u8a18\u8f09\u3055\u308c\u308b\u6cd5\u6848\u306b\u95a2\u3059\u308b\u60c5\u5831\u3067\u3059\u3002\u4f55\u3082\u793a\u3055\u308c\u3066\u3044\u306a\u3044\u5834\u5408\u306f\u3001\u305d\u306e\u533a\u57df\u306e\u9078\u6319\u306b\u306f\u6cd5\u6848\u304c\u306a\u3044\u3068\u3044\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002</p>","ko":"<p>\ub2e4\uc74c\uc740 \uadc0\ud558\uc758 \ud22c\ud45c \uc6a9\uc9c0\uc5d0 \uc18c\uac1c\ub41c \uc815\ucc45\uad00\ub828 \uc815\ubcf4\uc785\ub2c8\ub2e4. \ud654\uba74\uc5d0 \ub0b4\uc6a9\uc774 \ubcf4\uc774\uc9c0 \uc54a\ub294 \uacbd\uc6b0\ub294, \uadc0\ud558\uc758 \uc120\uac70\uad6c\uc640 \uad00\ub828\ub41c \uc815\ucc45\uc774 \uc5c6\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.</p>","ur":"<p> \u0630\u06cc\u0644 \u0645\u06cc\u06ba \u0627\u0646 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06c1\u06cc\u06ba \u062c\u0648 \u0622\u067e \u06a9\u06d2 \u0628\u06cc\u0644\u0679 \u067e\u0631 \u0638\u0627\u06c1\u0631 \u06c1\u0648\u06ba \u06af\u06d2\u06d4 \u0627\u06af\u0631 \u06a9\u0686\u06be \u0628\u06be\u06cc \u0645\u0648\u062c\u0648\u062f \u0646\u06c1\u06cc\u06ba \u062a\u0648 \u0622\u067e \u06a9\u06d2 \u062d\u0644\u0642\u06c1 \u0645\u06cc\u06ba \u0628\u06cc\u0644\u0679 \u067e\u0631 \u06a9\u0648\u0626\u06cc \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u0646\u06c1\u06cc\u06ba \u06c1\u06cc\u06ba\u06d4</p>","vi":"<p>D\u01b0\u1edbi \u0111\xe2y l\xe0 th\xf4ng tin v\u1ec1 c\xe1c \u0111i\u1ec1u lu\u1eadt c\u1ea7n b\u1ecf phi\u1ebfu s\u1ebd xu\u1ea5t hi\u1ec7n tr\xean l\xe1 phi\u1ebfu c\u1ee7a qu\xfd v\u1ecb. N\u1ebfu kh\xf4ng c\xf3 th\xf4ng tin n\xe0o hi\u1ec7n ra, kh\xf4ng c\xf3 \u0111i\u1ec1u lu\u1eadt c\u1ea7n b\u1ecf phi\u1ebfu n\xe0o trong cu\u1ed9c b\u1ecf phi\u1ebfu trong th\u1ea9m quy\u1ec1n c\u1ee7a qu\xfd v\u1ecb.</p>"}},"fullMeasureText":{"value":"Full Text","format":null,"style":null,"translations":{"zh-hant":"","hi":"\u092a\u0942\u0930\u093e \u092a\u093e\u0920","ja":"\u5168\u6587","ko":"\uc804\ubb38","es":"","tl":"","ur":"","vi":"To\xe0n V\u0103n B\u1ea3n","km":"\u17a2\u178f\u17d2\u1790\u1794\u1791\u1796\u17c1\u1789"}},"argumentsFor":{"value":"Arguments For","format":null,"style":null,"translations":{"zh-hant":"","hi":"\u092a\u0915\u094d\u0937 \u092e\u0947\u0902 \u0924\u0930\u094d\u0915","ja":"\u3078\u306e\u8cdb\u6210\u610f\u898b","ko":"\ub2e4\uc74c\uc5d0 \ub300\ud55c \ucc2c\uc131\ub860","es":"","tl":"","ur":"","vi":"L\u1eadp Lu\u1eadn \u1ee6ng H\u1ed9","km":"\u179f\u17c1\u1785\u1780\u17d2\u178a\u17b8\u200b\u17a2\u17c7\u17a2\u17b6\u1784"}},"argumentsAgainst":{"value":"Arguments Against","format":null,"style":null,"translations":{"zh-hant":"","hi":"\u0935\u093f\u0930\u0941\u0926\u094d\u0927 \u0924\u0930\u094d\u0915","ja":"\u3078\u306e\u53cd\u5bfe\u610f\u898b","ko":"\ub2e4\uc74c\uc5d0 \ub300\ud55c \ubc18\ub300\ub860","es":"","tl":"","ur":"","vi":"L\u1eadp Lu\u1eadn Ch\u1ed1ng ","km":"\u179f\u17c1\u1785\u1780\u17d2\u178a\u17b8\u200b\u17a2\u17c7\u17a2\u17b6\u1784\u1787\u17c6\u200b\u1791\u17b6\u179f\u17cb\u200b"}},"additionalInformationIntro":{"value":"<p>Below is a list of links to additional information about this election.</p>","format":"html","translations":{"es":"<p>A continuaci\xf3n, encontrar\xe1 una lista de los enlaces para acceder a informaci\xf3n adicional sobre esta elecci\xf3n.</p>","zh-hant":"<p>\u4ee5\u4e0b\u662f\u6709\u95dc\u9019\u6b21\u9078\u8209\u5176\u4ed6\u8cc7\u8a0a\u7684\u9023\u7d50\u5217\u8868\u3002</p>","tl":"<p>Sa ibaba ay isang listahan ng mga link sa karagdagang impormasyon tungkol sa halalang ito.</p>","hi":"<p>\u0928\u0940\u091a\u0947 \u0907\u0938 \u091a\u0941\u0928\u093e\u0935 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0932\u093f\u0902\u0915 \u0915\u0940 \u0938\u0942\u091a\u0940 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964</p>","ja":"<p>\u4ee5\u4e0b\u306f\u3053\u306e\u9078\u6319\u306b\u95a2\u3059\u308b\u8ffd\u52a0\u60c5\u5831\u3078\u306e\u30ea\u30f3\u30af\u4e00\u89a7\u3067\u3059\u3002</p>","ko":"<p>\ub2e4\uc74c\uc740 \ubcf8 \uc120\uac70 \uad00\ub828 \ucd94\uac00 \uc815\ubcf4\ub97c \ubcf4\uc2e4 \uc218 \uc788\ub294 \uc0ac\uc774\ud2b8 \ubaa9\ub85d\uc785\ub2c8\ub2e4.</p>","ur":"<p>\u0630\u06cc\u0644 \u0645\u06cc\u06ba \u0627\u0633 \u0627\u0644\u06cc\u06a9\u0634\u0646 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0627\u0636\u0627\u0641\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0644\u0646\u06a9\u0648\u06ba \u06a9\u06cc \u0627\u06cc\u06a9 \u0641\u06c1\u0631\u0633\u062a \u06c1\u06d2\u06d4</p>","vi":"<p>D\u01b0\u1edbi \u0111\xe2y l\xe0 danh s\xe1ch \u0111\u01b0\u1eddng link li\xean k\u1ebft t\u1edbi th\xf4ng tin b\u1ed5 sung v\u1ec1 cu\u1ed9c b\u1ea7u c\u1eed n\xe0y.</p>"}},"notFound":{"value":"This content has been disabled or no longer exists.","format":null,"style":null,"translations":{"zh-hant":"","hi":"\u092f\u0939 \u0915\u0949\u0928\u094d\u091f\u0947\u0902\u091f \u0921\u093f\u0938\u0947\u092c\u0932 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u092f\u093e \u0905\u092c \u092e\u094c\u091c\u0942\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0964","ja":"\u3053\u306e\u5185\u5bb9\u306f\u7121\u52b9\u306b\u306a\u3063\u3066\u3044\u308b\u304b\u3001\u307e\u305f\u306f\u5b58\u5728\u3057\u3066\u3044\u307e\u305b\u3093\u3002","ko":"\uc774 \ucf58\ud150\uce20\ub294 \ube44\ud65c\uc131\ud654\ub418\uc5c8\uac70\ub098 \ub354 \uc774\uc0c1 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","es":"","tl":"","ur":"","vi":"N\u1ed9i dung n\xe0y \u0111\xe3 b\u1ecb v\xf4 hi\u1ec7u h\xf3a ho\u1eb7c kh\xf4ng c\xf2n t\u1ed3n t\u1ea1i.","km":"\u1781\u17d2\u179b\u17b9\u1798\u179f\u17b6\u179a\u200b\u1793\u17c1\u17c7\u200b\u178f\u17d2\u179a\u17bc\u179c\u200b\u1794\u17b6\u1793\u200b\u200b\u1794\u17b7\u1791\u200b\u1798\u17b7\u1793\u200b\u17b2\u17d2\u1799\u200b\u178a\u17c6\u200b\u178e\u17be\u179a\u1780\u17b6\u179a\u200b\u1794\u17b6\u1793 \u17ac\u200b\u179b\u17c2\u1784\u200b\u1798\u17b6\u1793\u200b\u1791\u17c0\u178f\u200b\u17a0\u17be\u1799\u200b \u17d4"}},"sampleBallotTitle":{"value":"Reference Ballot","translations":{"es":"Boleta de referencia","zh-hant":"\u53c3\u8003\u9078\u7968","tl":"Reference na Balota","hi":"\u0938\u0902\u0926\u0930\u094d\u092d \u092e\u0924\u092a\u0924\u094d\u0930","ja":"\u53c2\u7167\u7528\u6295\u7968\u7528\u7d19","ko":"\ucc38\uc870 \ud22c\ud45c\uc9c0","ur":"\u062d\u0648\u0627\u0644\u06d2 \u06a9\u0627 \u0628\u06cc\u0644\u0679","vi":"Phi\u1ebfu B\u1ea7u Tham Kh\u1ea3o","km":"\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u200b\u200b\u1786\u17d2\u1793\u17c4\u178f\u1787\u17b6\u200b\u17af\u1780\u179f\u17b6\u179a\u200b\u1799\u17c4\u1784"}},"sampleBallotIntro":{"value":"<p>The following information is a list of contests just as they will appear on your ballot. You may click on a candidate name or measure response to mark it for future reference.</p>","format":"html","translations":{"es":"<p>La siguiente informaci\xf3n es una lista de las contiendas electorales tal como aparecer\xe1n en su boleta. Puede hacer clic en el nombre de un candidato o en la respuesta de la medida para marcarla para futura referencia.</p>","zh-hant":"<p>\u60a8\u7684\u9078\u7968\u5c07\u6709\u4ee5\u4e0b\u7684\u9078\u8209\u9805\u76ee\u3002\u60a8\u53ef\u4ee5\u9ede\u6483\u5019\u9078\u4eba\u7684\u59d3\u540d\u6216\u63d0\u6848\uff0c\u6a19\u8a18\u60a8\u7684\u9078\u64c7\uff0c\u4f5c\u70ba\u65e5\u5f8c\u53c3\u8003\u4e4b\u7528\u3002</p>","tl":"<p>Ang sumusunod na impormasyon ay isang listahan ng mga paligsahan tulad ng makikita mo sa iyong balota. Maaari mong i-click ang pangalan ng isang kandidato o tugon sa panukalang-batas upang markahan ito para maging reperensiya sa hinaharap.</p>","vi":"<p>Th\xf4ng tin sau \u0111\xe2y l\xe0 danh s\xe1ch c\xe1c tranh c\u1eed, th\xf4ng tin n\xe0y c\u0169ng s\u1ebd \u0111\u01b0\u1ee3c ghi tr\xean l\xe1 phi\u1ebfu c\u1ee7a qu\xfd v\u1ecb. Qu\xfd v\u1ecb c\xf3 th\u1ec3 ch\u1ecdn v\xe0o t\xean \u1ee9ng c\u1eed vi\xean ho\u1eb7c d\u1ef1 lu\u1eadt c\u1ea7n b\u1ecf phi\u1ebfu \u0111\u1ec3 \u0111\xe1nh d\u1ea5u n\xf3, d\xf9ng \u0111\u1ec3 tham kh\u1ea3o trong t\u01b0\u01a1ng lai.</p>","ja":"<p>\u4ee5\u4e0b\u306e\u60c5\u5831\u306f\u3001\u6295\u7968\u7528\u7d19\u306b\u63b2\u8f09\u3055\u308c\u308b\u306e\u3068\u540c\u3058\u9078\u6319\u9805\u76ee\u306e\u30ea\u30b9\u30c8\u3067\u3059\u3002\u5019\u88dc\u8005\u306e\u6c0f\u540d\u307e\u305f\u306f\u6cd5\u6848\u3078\u306e\u56de\u7b54\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u3001\u5c06\u6765\u306e\u53c2\u7167\u306e\u305f\u3081\u306b\u5370\u3092\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002</p>","ko":"<p>\ub2e4\uc74c \uc815\ubcf4\ub294 \uadc0\ud558\uc758 \ud22c\ud45c\uc9c0\uc5d0 \ud45c\uc2dc\ub420 \ucf58\ud150\uce20\uc758 \ubaa9\ub85d\uc785\ub2c8\ub2e4. \ud6c4\ubcf4\uc790 \uc774\ub984\uc774\ub098 \ubc95\uc548\uc5d0 \ub300\ud55c \ub2f5\ubcc0\uc744 \ud074\ub9ad\ud558\uc5ec \ub098\uc911\uc5d0 \ucc38\uace0\ud560 \uc218 \uc788\ub3c4\ub85d \ud45c\uc2dc\ud558\uc2dc\uba74 \ub429\ub2c8\ub2e4.</p>","hi":"<p>\u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0909\u0928 \u092e\u0941\u0915\u093e\u092c\u0932\u094b\u0902 \u0915\u0940 \u090f\u0915 \u0938\u0942\u091a\u0940 \u0939\u0948 \u091c\u0948\u0938\u0947 \u0915\u093f \u0935\u0947 \u0906\u092a\u0915\u0947 \u092e\u0924\u092a\u0924\u094d\u0930 \u092a\u0930 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0902\u0917\u0947\u0964 \u0906\u092a \u0915\u093f\u0938\u0940 \u0909\u092e\u094d\u092e\u0940\u0926\u0935\u093e\u0930 \u0915\u0947 \u0928\u093e\u092e \u092f\u093e \u0935\u093f\u0927\u0947\u092f\u0915 \u0909\u0924\u094d\u0924\u0930 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u091c\u093f\u0938\u0938\u0947 \u092d\u0935\u093f\u0937\u094d\u092f \u092e\u0947\u0902 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u092a\u0930 \u0928\u093f\u0936\u093e\u0928 \u0932\u0917\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0947\u0964</p>","ur":"","km":"<p>\u1796\u17d0\u178f\u17cc\u1798\u17b6\u1793\u1781\u17b6\u1784\u200b\u1780\u17d2\u179a\u17c4\u1798\u200b\u1787\u17b6\u200b\u1794\u1789\u17d2\u1787\u17b8\u200b\u1788\u17d2\u1798\u17c4\u17c7\u200b\u1794\u17c1\u1780\u17d2\u1781\u1787\u1793\u1785\u17bc\u179b\u179a\u17bd\u1798\u200b\u200b\u1794\u17d2\u179a\u200b\u1780\u17bd\u178f\u200b\u200b\u178a\u17c2\u179b\u200b\u178a\u17bc\u1785\u200b\u1782\u17d2\u1793\u17b6\u200b\u1791\u17c5\u200b\u1793\u17b9\u1784\u200b\u17a2\u17d2\u179c\u17b8\u200b\u178a\u17c2\u179b\u1798\u17b6\u1793\u200b\u200b\u179b\u17be\u200b\u179f\u1793\u17d2\u179b\u17b9\u1780\u200b\u1786\u17d2\u1793\u17c4\u178f\u200b\u179a\u1794\u179f\u17cb\u200b\u17a2\u17d2\u1793\u1780\u200b \u17d4 \u17a2\u17d2\u1793\u1780\u200b\u17a2\u17b6\u1785\u200b\u1785\u17bb\u1785\u200b\u179b\u17be\u200b\u1788\u17d2\u1798\u17c4\u17c7\u200b\u1794\u17c1\u1780\u17d2\u1781\u1787\u1793 \u17ac\u200b\u179c\u17b7\u1792\u17b6\u1793\u1780\u17b6\u179a\u200b\u1786\u17d2\u179b\u17be\u1799\u200b\u178f\u1794\u200b\u178e\u17b6\u1798\u17bd\u1799\u200b\u178a\u17be\u1798\u17d2\u1794\u17b8\u200b\u1782\u17bc\u179f\u200b\u179c\u17b6\u200b\u179f\u1798\u17d2\u179a\u17b6\u1794\u17cb\u200b\u1787\u17b6\u200b\u17af\u1780\u179f\u17b6\u179a\u200b\u1799\u17c4\u1784\u200b\u1793\u17b6\u200b\u1796\u17c1\u179b\u200b\u17a2\u1793\u17b6\u1782\u178f\u200b \u17d4\u200b</p>"}},"printSampleBallot":{"value":"Print Reference Ballot","translations":{"es":"Imprimir Boleta de Referencia","zh-h