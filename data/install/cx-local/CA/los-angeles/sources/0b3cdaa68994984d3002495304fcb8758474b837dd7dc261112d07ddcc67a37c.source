{"id":"cc10565","long_description":{},"name":{"BN":"SANTA CLARITA VALLEY ওয়াটার এজেন্সির সদস্য, পরিচালক পরিষদ, ডিভিসন 1-এর জন্য","CC":"SANTA CLARITA VALLEY 供水局 董事會董事，第 1 分區","EN":"SANTA CLARITA VALLEY WATER AGENCY Member, Board of Directors, Division 1","ES":"AGENCIA DE SUMINISTRO DE AGUA DE SANTA CLARITA VALLEY Miembro, Junta de Directores, División 1","FA":"سازمان آب SANTA CLARITA VALLEY عضو، هیئت مدیره، بخش 1","GU":"SANTA CLARITA VALLEY જળ સંસ્થાના સભ્ય, નિયામક મંડળ, વિભાગ 1","HI":"SANTA CLARITA VALLEY जल एजेंसी सदस्य, बोर्ड ऑफ डायरेक्टर्स, प्रभाग 1","HY":"SANTA CLARITA VALLEY ՋՐԻ ԳՈՐԾԱԿԱԼՈՒԹՅՈՒՆ Տնօրենների խորհրդի անդամ, Բաժին 1","ID":"BADAN PENGAIRAN SANTA CLARITA VALLEY Anggota, Dewan Direksi, Divisi 1","JA":"SANTA CLARITA VALLEY 水道機関 役員、役員会、第1部門","KM":"ទីភ្នាក់ងារកែច្នៃទឹក SANTA CLARITA VALLEY សមាជិក, គណៈកម្មការនាយក, តំបន់ 1","KO":"SANTA CLARITA VALLEY 수도국 이사회 이사, 제 1 부","MN":"SANTA CLARITA VALLEY УС ХАНГАМЖИЙН ГАЗАР Гишүүн, Захирлуудын зөвлөл, Хэсэг 1","MY":"SANTA CLARITA VALLEY ရေအေဂျင်စီအဖွဲ့ဝင်၊ ဒါရိုက်တာများဘုတ်အဖွဲ့၊ ဌာနခွဲ 1","RU":"УПРАВЛЕНИЕ ВОДОСНАБЖЕНИЯ SANTA CLARITA VALLEY Член Совета директоров, Подразделение 1","TE":"SANTA CLARITA VALLEY వాటర్ ఏజెన్సీ సభ్యులు, డైరెక్టర్ల బోర్డు, విభాగం 1","TH":"หน่วยการประปา SANTA CLARITA VALLEY สมาชิกคณะกรรมการอำนวยการ แผนก 1","TL":"AHENSYA NG TUBIG NG SANTA CLARITA VALLEY Miyembro, Lupon ng mga Direktor, Dibisyon 1","VI":"CƠ QUAN THỦY CỤC SANTA CLARITA VALLEY Thành Viên, Hội Đồng Giám Đốc, Phân Khu 1","ZH":"SANTA CLARITA VALLEY 供水局 董事會董事，第 1 分區"},"short_name":{"BN":"SANTA CLARITA VALLEY-ডি 1","CC":"SANTA CLARITA VALLEY 供水局 - 第 1 分區","EN":"SANTA CLARITA VALLEY-D1","ES":"SANTA CLARITA VALLEY-D1","FA":"SANTA CLARITA VALLEY - بخش 1","GU":"SANTA CLARITA VALLEY-ડી1","HI":"SANTA CLARITA VALLEY-D1","HY":"SANTA CLARITA VALLEY-Բ1","ID":"SANTA CLARITA VALLEY-D1","JA":"SANTA CLARITA VALLEY　1区","KM":"SANTA CLARITA VALLEY-មណ្ឌល 1","KO":"SANTA CLARITA VALLEY-제 1부","MN":"SANTA CLARITA VALLEY-Х1","MY":"SANTA CLARITA VALLEY-ခွဲ 1","RU":"SANTA CLARITA VALLEY - ПОДР1","TE":"SANTA CLARITA VALLEY-వి1","TH":"นปป. SANTA CLARITA VALLEY แผนก 1","TL":"SANTA CLARITA VALLEY-D1","VI":"CQTC SANTA CLARITA VALLEY-PK 1","ZH":"SANTA CLARITA VALLEY 供水局 - 第 1 分區"},"short_description":{},"contest_class":"candidate_class","number_of_writeins":1,"vote_for_max":1,"vote_for_text":{"BN":"<b>এক</b>জনের পক্ষে ভোট দিন","CC":"請選 <b>一人</b>","EN":"Vote For <b>ONE</b>","ES":"Vote Por <b>UNO</b>","FA":"رای به <b>یک نفر</b>  ","GU":"<b>એક</b> માટે મત આપો","HI":"<b>एक</b> के लिए मतदान करें","HY":"Քվեարկեք <b>ՄԵԿԻ </b>Համար","ID":"PILIH <b>SATU</b>","JA":" <b>一人</b>に投票","KM":"បោះឆ្នោតអោយ <b>មួយ</b>","KO":"<b>한</b> 명까지만 투표하십시오","MN":"<b>НЭГ</b> санал өгнө үү","MY":"<b>တစ်ဦး</b>သာ မဲပေးပါ","RU":"Голосовать за <b>ОДНОГО</b> кандидата","TE":"<b>ఒకరికి</b> ఓటువేయండి","TH":"ออกเสียงลงคะแนนเลือกเพียง <b>หนึ่ง</b>  ชื่อ ","TL":"Bumoto Ng <b>ISA</b>","VI":"Bầu <b>MỘT</b> Người","ZH":"請選 <b>一人</b>"},"division":"D62","candidates":[{"id":"3D9","name":[{"BN":"বিল কুপার","CC":"比爾·庫珀","EN":"BILL COOPER","FA":"بیل کوپر","GU":"બિલ કૂપર","HI":"बिल कूपर","HY":"ԲԻԼ ՔՈՒՓԵՐ","JA":"ビル・クーパー","KM":"ប៊ីល ឃូពើរ","KO":"빌 쿠퍼","MN":"БИЛЛ КҮҮПЕР","MY":"ဘီလ် ကူးပါး","RU":"БИЛЛ КУПЕР","TE":"బిల్ కూపర్","TH":"บิล คูเปอร์","ZH":"比爾·庫珀"}],"short_name":[{"EN":"BILL COOPER"}],"occupation":[{"BN":"সদস্য, পরিচালক পরিষদ, Santa Clarita Valley ওয়াটার এজেন্সি","CC":"Santa Clarita Valley 供水局董事會董事","EN":"Member, Board of Directors, Santa Clarita Valley Water Agency","ES":"Miembro, Junta de Directores, Agencia de Suministro de Agua de Santa Clarita Valley","FA":"عضو، هیئت مدیره، سازمان آب Santa Clarita Valley","GU":"સભ્ય, નિર્દેશક મંડળ, Santa Clarita Valley જ​ળ સંસ્થા","HI":"सदस्य, बोर्ड ऑफ डायरेक्टर्स, Santa Clarita Valley जल एजेंसी","HY":"Santa Clarita Valley Ջրամատակարարման գործակալություն, Տնօրենների խորհրդի անդամ","ID":"Anggota, Dewan Direksi, Badan Pengairan Santa Clarita Valley","JA":"Santa Clarita Valley水道機関、役員会、役員","KM":"សមាជិក, នៃក្រុមប្រឹក្សាភិបាល, ទីភ្នាក់ងារកែច្នៃទឹក Santa Clarita Valley","KO":"Santa Clarita Valley 수도국 이사회 이사","MN":"Гишүүн, Захирлуудын зөвлөл, Santa Clarita Valley Ус Хангамжийн Газар","MY":"အဖွဲ့ဝင်၊ ဒါရိုက်တာများဘုတ်အဖွဲ့၊ Santa Clarita Valley ရေအေဂျင်စီ","RU":"Член совета директоров, Управление водоснабжения Santa Clarita Valley","TE":"సభ్యులు, డైరెక్టర్ల బోర్డు, Santa Clarita Valley వాటర్ ఏజెన్సీ","TH":"สมาชิกคณะกรรมการอำนวยการ หน่วยงานประปา Santa Clarita Valley","TL":"Miyembro, Lupon ng mga Direktor, Ahensya ng Tubig ng Santa Clarita Valley","VI":"Thành Viên, Hội Đồng Giám Đốc, Cơ Quan Thủy Cục Santa Clarita Valley","ZH":"Santa Clarita Valley 供水局董事會董事"}],"statements":[{"ID":"C0002587505E","FullHTML":{"BN":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER (বিল কুপার)-এর বিবৃতি</h1><h2 dir=\"auto\" style=\"text-align: center\">প্রার্থী সদস্য, পরিচালক পরিষদ,<br dir=\"auto\">ডিভিসন 1-এর জন্য</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY ওয়াটার এজেন্সি</h3><p dir=\"auto\">পেশা: Santa Clarita Valley ওয়াটার এজেন্সি বোর্ডের সহ সভাপতি</p><p dir=\"auto\"><strong>BILL COOPER</strong> তার পুরো পেশাগত জীবন জল সম্পদ খাতে কাজ করেছেন এবং Southern California-র <strong>19 মিলিয়ন </strong>মানুষের কাছে জল সরবরাহকারী মেট্রোপলিটন ওয়াটারের পাঁচটি জল শোধনাগারের পরিচালনা ব্যবস্থা দেখাশোনা করেছেন। বৃহৎ জল শোধন ও সরবরাহ ব্যবস্থাপনা পরিচালনার অভিজ্ঞতা তাঁকে আমাদের স্থানীয় জলের সরবরাহের মান ও প্রাপ্যতা রক্ষার জন্য প্রয়োজনীয় অভিজ্ঞতা দিয়েছে।</p><p dir=\"auto\">Santa Clarita Valley-তে নির্ভরযোগ্য, নিরাপদ এবং সাশ্রয়ী মূল্যে জল সরবরাহ আমাদের কমিউনিটির জন্য এবং আমরা যে জীবনযাত্রার মান উপভোগ করি তার জন্য অত্যন্ত জরুরি।</p><p dir=\"auto\"><strong>BILL COOPER </strong>নিম্নলিখিত উপায়ে দায়িত্বশীল জল ব্যবস্থাপনার জন্য কাজ করে যাবেন:</p><p dir=\"auto\">পুনর্ব্যবহার ও সংরক্ষণের মাধ্যমে <strong>বিদ্যমান সরবরাহকে সর্বাধিক করে</strong>;</p><p dir=\"auto\"><strong>নতুন নির্মাণের ক্ষেত্রে </strong>ভবন নির্মাণের আগে জলের নিশ্চিত ও নির্দিষ্ট সরবরাহ থাকতে হবে তা নিশ্চিত করে;</p><p dir=\"auto\"><strong>ভূগর্ভস্থ ব্যাংকিং স্টোরেজ প্রোগ্রাম প্রচার করে </strong>যাতে খরার বছরগুলোতে জল সরবরাহ করা যায়;</p><p dir=\"auto\"><strong>দূষক পদার্থ অপসারণ করে </strong>যা আমাদের ভূগর্ভস্থ জলকে হুমকির মুখে ফেলছে এবং দূষণকারীদের পরিষ্কার করার খরচ বহন করতে বাধ্য করে;</p><p dir=\"auto\"><strong>ফেডারেল ও স্টেট সরকারের অর্থায়ন পাওয়ার চেষ্টা করে </strong>যাতে স্থানীয় প্রকল্পের খরচ কমানো যায়;</p><p dir=\"auto\">কঠোর বাজেট তত্ত্বাবধানের মাধ্যমে <strong>জলের দাম কম রেখে</strong>।</p><p dir=\"auto\"><strong>BILL COOPER </strong>সবসময় <strong>উচ্চমানের </strong>জল নির্ভরযোগ্যভাবে ও <strong>যুক্তিসঙ্গত খরচে </strong>পাওয়া যায় তা নিশ্চিত করতে কঠোর পরিশ্রম করে যাবেন এবং দায়িত্বশীল পরিকল্পনা ও ব্যবস্থাপনার মাধ্যমে ভবিষ্যতের খরা থেকে আমাদের ভ্যালিকে রক্ষা করতে কাজ করবেন।</p><p dir=\"auto\">অভিজ্ঞ প্রার্থী <strong>BILL COOPER </strong>-কে পুনর্নির্বাচিত করুন।</p><p dir=\"auto\">5 বছর <strong>মার্কিন নৌবাহিনীর প্রাক্তন সৈনিক </strong>হিসেবে একটি বিমানবাহী রণতরীতে দায়িত্ব পালন করেছেন।</p>","CC":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER（比爾·庫珀）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">董事會委員候選人，<br dir=\"auto\">第1分區</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY 供水局</h3><p dir=\"auto\">職業：Santa Clarita Valley供水局委員會副主席</p><p dir=\"auto\"><strong>BILL COOPER</strong>職業生涯一直在處理管理全五座Metropolitan Water（大都會水質）處理廠的水資源，這些廠區為Southern California的<strong>1,900萬</strong>居民供水。管理大型水處理和輸水設施使他累積保護當地供水品質和供應能力所需的經驗。</p><p dir=\"auto\">可靠、安全且平價的供水對於Santa Clarita Valley社區和生活品質來說十分重要。</p><p dir=\"auto\"><strong>BILL COOPER </strong>將繼續努力實現負責任的水資源管理，方法如下：</p><p dir=\"auto\">透過回收和保護水資源確保<strong>最大限度地利用現有供水 </strong>；</p><p dir=\"auto\"><strong>要求新建案 </strong>開始施工前必須有可識別的水源；</p><p dir=\"auto\"><strong>推廣地下儲水計畫 </strong>以在乾旱年份供水；</p><p dir=\"auto\"><strong>去除威脅地下水的污染物</strong>，並要求污染者支付清理費用；</p><p dir=\"auto\"><strong>尋求聯邦和州政府</strong>補助金，降低當地計畫成本；</p><p dir=\"auto\">透過嚴格監督預算<strong>維持低廉水費</strong>。</p><p dir=\"auto\"><strong>BILL COOPER</strong>透過負責任規劃和管理確保我們的山谷始終擁有可靠的<strong>高品質</strong>、<strong>成本合理</strong>供水，免受未來乾旱影響。</p><p dir=\"auto\">懇請各位支持經驗豐富的候選人<strong>BILL COOPER</strong>連任</p><p dir=\"auto\">曾在航空母艦上服役5年的<strong>US海軍退伍軍人</strong>。</p>","EN":"<h1 dir=\"auto\" style=\"text-align: center\">STATEMENT OF BILL COOPER</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATE FOR MEMBER, BOARD OF DIRECTORS,<br dir=\"auto\">Division 1</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY WATER AGENCY</h3><p dir=\"auto\">Occupation: Santa Clarita Valley Water Agency Board Vice President</p><p dir=\"auto\"><strong>BILL COOPER </strong>has worked his entire professional career in water resources managing the operations of all five Metropolitan Water treatment plants serving water to <strong>19 million </strong>people in Southern California. Managing large water treatment and distribution facilities gives him the experience needed to protect the quality and availability of our local water supplies.</p><p dir=\"auto\">The reliable, safe and affordable supply of water to the Santa Clarita Valley is essential for our community and the quality of life we enjoy.</p><p dir=\"auto\"><strong>BILL COOPER </strong>will continue to strive for responsible water management by:</p><p dir=\"auto\"><strong>Maximizing Existing Supplies </strong>through recycling and conservation;</p><p dir=\"auto\"><strong>Requiring New Development </strong>to have an identifiable supply of water before building;</p><p dir=\"auto\"><strong>Promoting Underground Banking Storage Programs </strong>to provide water during drought years;</p><p dir=\"auto\"><strong>Removing Contaminants </strong>threatening our groundwater and requiring polluters to pay for cleanup;</p><p dir=\"auto\"><strong>Seeking Federal and State </strong>funding to reduce local project costs;</p><p dir=\"auto\"><strong>Maintaining Low Water Rates </strong>through strict budget oversight.</p><p dir=\"auto\"><strong>BILL COOPER </strong>will continue to work hard to ensure that we always have a reliable supply of <strong>high quality </strong>water at a <strong>reasonable cost </strong>and to protect our valley from future drought through responsible planning and management.</p><p dir=\"auto\">Re-Elect <strong>BILL COOPER </strong>the Candidate with Experience</p><p dir=\"auto\">5 Year <strong>US Navy Veteran </strong>serving onboard an aircraft carrier.</p>","ES":"<h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE BILL COOPER</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATO PARA MIEMBRO, JUNTA DE DIRECTORES,<br dir=\"auto\"/>División 1</h2><h3 dir=\"auto\" style=\"text-align: center\">AGENCIA DE SUMINISTRO DE AGUA DE SANTA CLARITA VALLEY</h3><p dir=\"auto\">Ocupación: Vicepresidente de la Junta de la Agencia de Suministro de Agua de Santa Clarita Valley</p><p dir=\"auto\"><strong>BILL COOPER </strong>ha trabajado toda su carrera profesional en recursos hídricos gestionando las operaciones de las cinco plantas de tratamiento del distrito Metropolitano de Agua que suministran agua a <strong>19 millones </strong>de personas en el Sur de California. Su experiencia gestionando grandes plantas de tratamiento y distribución de agua le proporciona los conocimientos necesarios para proteger la calidad y la disponibilidad de nuestro suministro local de agua.</p><p dir=\"auto\">El suministro de agua fiable, seguro y asequible a Santa Clarita Valley es esencial para nuestra comunidad y para la calidad de vida de la que disfrutamos.</p><p dir=\"auto\"><strong>BILL COOPER </strong>continuará esforzándose por lograr una gestión responsable del agua mediante:</p><p dir=\"auto\"><strong>La Maximización de los Suministros Existentes </strong>a través del reciclaje y la conservación;</p><p dir=\"auto\"><strong>El Requerimiento a la Nueva Urbanización </strong>de contar con un suministro de agua identificable antes de la construcción;</p><p dir=\"auto\"><strong>La Promoción de Programas de Almacenamiento Subterráneo de Agua </strong>para suministrar agua durante los años de sequía;</p><p dir=\"auto\"><strong>La Eliminación de Contaminantes </strong>que amenazan nuestras aguas subterráneas y obligar a los contaminadores a pagar por la limpieza;</p><p dir=\"auto\"><strong>La Búsqueda de financiamiento Federal y Estatal </strong>para reducir los costos de los proyectos locales;</p><p dir=\"auto\"><strong>El Mantenimiento de Tarifas de Agua Bajas </strong>mediante una estricta supervisión presupuestaria.</p><p dir=\"auto\"><strong>BILL COOPER </strong>continuará trabajando arduamente para asegurarnos de que siempre tengamos un suministro confiable de agua de <strong>alta calidad </strong>a un <strong>costo razonable </strong>y para proteger nuestro valle de futuras sequías mediante una planificación y gestión responsables.</p><p dir=\"auto\">Reelija a <strong>BILL COOPER </strong>el Candidato con Experiencia</p><p dir=\"auto\"><strong>Veterano de la Marina de los EE. UU. </strong> durante 5 Años prestando servicio a bordo de un portaaviones.</p>\r\n","FA":"<h1 dir=\"rtl\" style=\"text-align: center\">بیانیه BILL COOPER (بیل کوپر)</h1><h2 dir=\"rtl\" style=\"text-align: center\">کاندیدا برای عضو، هیئت مدیره،<br dir=\"auto\">بخش 1</h2><h3 dir=\"rtl\" style=\"text-align: center\">سازمان آب SANTA CLARITA VALLEY</h3><p dir=\"rtl\">شغل: معاون هیئت مدیره سازمان آب Santa Clarita Valley</p><p dir=\"rtl\"><strong>BILL COOPER </strong>تمام دوران حرفه‌ای خود را در زمینه منابع آب کار کرده است و عملیات‌ هرپنج تصفیه‌خانه آب Metropolitan را مدیریت کرده است که به <strong>19 میلیون </strong>نفر ساکنان Southern California خدمات آب‌ رسانی ارائه می‌کنند. مدیریت تأسیسات بزرگ تصفیه و توزیع آب، تجربه لازم برای محافظت از کیفیت و دسترسی به منابع آب محلی ما را به او می‌دهد.</p><p dir=\"rtl\">تأمین قابل اطمینان، ایمن و مقرون‌به‌صرفه آب در Santa Clarita Valley برای جامعه ما و کیفیت زندگی که از آن لذت می‌بریم ضروری است.</p><p dir=\"rtl\"><strong>BILL COOPER </strong>تلاش‌های خود برای مدیریت مسئولانه آب را از طرق زیر ادامه خواهد داد:</p><p dir=\"rtl\"><strong>به حداکثر رساندن ذخایر موجود </strong>از طریق بازیافت و حفاظت؛</p><p dir=\"rtl\"><strong>ملزم کردن پروژه‌های توسعه جدید </strong>به داشتن منبع آب قابل شناسایی قبل از ساخت؛</p><p dir=\"rtl\"><strong>ترویج برنامه‌های ذخیره‌ سازی بسترهای زیرزمینی </strong>برای تأمین آب در سال‌های خشکسالی؛</p><p dir=\"rtl\"><strong>حذف آلاینده‌هایی </strong>که آب‌های زیرزمینی ما را تهدید می‌کنند و ملزم کردن آلوده‌ کنندگان به پرداخت هزینه پاکسازی؛</p><p dir=\"rtl\"><strong>درخواست بودجه فدرال و ایالتی </strong>برای کاهش هزینه‌های پروژه‌های محلی؛</p><p dir=\"rtl\"><strong>پایین نگه داشتن نرخ آب </strong>از طریق نظارت شدید بر بودجه.</p><p dir=\"rtl\"><strong>BILL COOPER </strong>به تلاش‌های پیگرانه خود ادامه خواهد داد تا اطمینان حاصل شود که همیشه منبع آب <strong>باکیفیت </strong>با <strong>قیمت معقول </strong>داشته باشیم و با برنامه‌ریزی و مدیریت مسئولانه، از دره ما در برابر خشکسالی‌های آینده محافظت کند.</p><p dir=\"rtl\">مجدداً <strong>BILL COOPER </strong>کاندیدای باتجربه<strong> </strong>را انتخاب کنید، </p><p dir=\"rtl\">5 سال <strong>کهنه‌سرباز نیروی دریایی ایالات متحده </strong>که در ناو هواپیما بر خدمت کرده است.</p>","GU":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER (બિલ કૂપર)નું નિવેદન</h1><h2 dir=\"auto\" style=\"text-align: center\">નિયામક મંડળના સભ્ય, માટેના ઉમેદવાર,<br dir=\"auto\">વિભાગ 1</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY જળ સંસ્થા</h3><p dir=\"auto\">વ્યવસાય: Santa Clarita Valley જળ સંસ્થા મંડળ ઉપ પ્રમુખ</p><p dir=\"auto\"><strong>BILL COOPER </strong>એ Southern California માં <strong>19 મિલીયન </strong>લોકોને પાણીની સેવા આપતા પાંચેય મેટ્રોપોલિટન જળ સારવાર પ્લાન્ટના સંચાલનમાં જળ સંસાધનોમાં પોતાની સંપૂર્ણ વ્યાવસાયિક કારકિર્દી બનાવી છે. વિશાળ પાણીની શુદ્ધિકરણ અને વિતરણ સુવિધાઓનું સંચાલન કરવાથી તે આપણા સ્થાનિક પાણી પુરવઠાની ગુણવત્તા અને ઉપલબ્ધતાને સુરક્ષિત રાખવા માટે જરૂરી અનુભવ લાવે છે.</p><p dir=\"auto\">Santa Clarita Valley માં પાણીનો વિશ્વસનીય, સુરક્ષિત અને સસ્તો પુરવઠો આપણા સમુદાય અને આપણે માણીએ છીએ તે જીવનની ગુણવત્તા માટે જરૂરી છે.</p><p dir=\"auto\"><strong>BILL COOPER </strong>નિમ્નલિખિત દ્વારાજવાબદાર પાણી વ્યવસ્થાપન માટે પ્રયત્નશીલ રહેશે:</p><p dir=\"auto\">પુનઃચક્રણ અને સંરક્ષણ દ્વારા <strong>હાલના પુરવઠાને મહત્તમ બનાવવો</strong>;</p><p dir=\"auto\">નિર્માણ પહેલાં પાણીનો ઓળખી શકાય તેવા પુરવઠા માટે <strong>નવા વિકાસની આવશ્યકતા બનાવવી</strong>;</p><p dir=\"auto\"><strong>ભૂગર્ભ બેંકિંગ સંગ્રહ કાર્યક્રમોને પ્રોત્સાહન આપવું </strong>જેથી દુષ્કાળના વર્ષોમાં પાણી મળી રહે;</p><p dir=\"auto\">આપણા ભૂગર્ભજળને જોખમમાં મૂકતા અને પ્રદૂષકોને સફાઈ માટે ચૂકવણી કરવાની ફરજ પાડતા <strong>દૂષકોને દૂર કરવા</strong>;</p><p dir=\"auto\">સ્થાનિક યોજના ખર્ચ ઘટાડવા માટે <strong>સંઘીય અને રાજ્ય ભંડોળ </strong>મેળવવાની માંગ કરવી;</p><p dir=\"auto\">ચુસ્ત અંદાજપત્ર દેખરેખ દ્વારા <strong>પાણીના નીચા દરો જાળવી રાખવા</strong>.</p><p dir=\"auto\"><strong>BILL COOPER</strong> <strong>વાજબી કિંમતે</strong> <strong>ઉચ્ચ ગુણવત્તાયુક્ત</strong> પાણીનો વિશ્વસનીય પુરવઠો હંમેશા મળે તે સુનિશ્ચિત કરવા અને જવાબદાર આયોજન અને વ્યવસ્થાપન દ્વારા ભવિષ્યના દુષ્કાળથી આપણી ખીણને સુરક્ષિત રાખવા માટે સખત મહેનત કરવાનું ચાલુ રાખશે.</p><p dir=\"auto\"><strong>BILL COOPER </strong>ને ફરીથી ચૂંટો, જે અનુભવ ધરાવતા ઉમેદવાર છે</p><p dir=\"auto\">5 વર્ષ <strong>US જળસેના નિવૃત્ત સૈનિક </strong>જેમણે વિમાનવાહક જહાજ પર સેવા આપી છે.</p>","HI":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER (बिल कूपर) का वक्तव्य</h1><h2 dir=\"auto\" style=\"text-align: center\">बोर्ड ऑफ डायरेक्टर्स सदस्य के लिए उम्मीदवार,<br dir=\"auto\">प्रभाग 1</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY जल एजेंसी</h3><p dir=\"auto\">व्यवसाय: Santa Clarita Valley जल एजेंसी बोर्ड उपाध्यक्ष</p><p dir=\"auto\"><strong>BILL COOPER </strong>ने अपने पूरे पेशेवर कैरियर में जल संसाधनों के क्षेत्र में काम किया है, जिसमें Southern California में <strong>19 मिलियन </strong>लोगों को जल प्रदान करने वाले महानगर के सभी पाँच जल शोधन संयंत्रों के प्रचालन का प्रबंधन करना शामिल है। बड़े जल शोधन और वितरण सुविधा केंद्रों का प्रबंधन करने से उन्हें हमारी स्थानीय जल आपूर्ति की गुणवत्ता और उपलब्धता की रक्षा करने के लिए आवश्यक अनुभव प्राप्त होता है।</p><p dir=\"auto\">Santa Clarita Valley में पानी की विश्वसनीय, सुरक्षित और किफायती आपूर्ति हमारे समुदाय और हमारे जीवन की गुणवत्ता के लिए अत्यंत आवश्यक है।</p><p dir=\"auto\"><strong>BILL COOPER </strong>निम्नलिखित उपायों द्वारा जिम्मेदार जल प्रबंधन के लिए निरंतर प्रयास करते रहेंगे:</p><p dir=\"auto\"><strong>मौजूदा जल आपूर्ति का अधिकतम उपयोग करना</strong> — पुनर्चक्रण और जल संरक्षण के माध्यम से;</p><p dir=\"auto\"><strong>नए विकास कार्यों के लिए यह आवश्यक बनाना</strong> कि निर्माण शुरू होने से पहले पानी की उपलब्धता का स्पष्ट और सुनिश्चित स्रोत हो;</p><p dir=\"auto\"><strong>भूमिगत जल भंडारण कार्यक्रमों को बढ़ावा देना</strong>, ताकि सूखे के वर्षों में पानी उपलब्ध कराया जा सके;</p><p dir=\"auto\"><strong>प्रदूषकों को हटाना</strong> जो हमारे भूजल के लिए खतरा पैदा कर रहे हैं, और प्रदूषण फैलाने वालों से सफाई की लागत वसूलना;</p><p dir=\"auto\"><strong>संघीय और राज्य सरकार से वित्त पोषण प्राप्त करना</strong>, ताकि स्थानीय परियोजनाओं की लागत कम की जा सके;</p><p dir=\"auto\">सख्त बजट निगरानी के माध्यम से <strong>पानी की कम दरों को बनाए रखना</strong>।</p><p dir=\"auto\"><strong>BILL COOPER </strong>यह सुनिश्चित करने के लिए कड़ी मेहनत करना जारी रखेंगे कि हमारे पास <strong>उचित लागत </strong>पर <strong>उच्च गुणवत्ता </strong>वाले पानी की हमेशा विश्वसनीय आपूर्ति बनी रहे और जिम्मेदार नियोजन और प्रबंधन के माध्यम से भविष्य में सूखे से हमारी घाटी की रक्षा की जा सके।</p><p dir=\"auto\"><strong>BILL COOPER</strong>, अनुभवी उम्मीदवार को दोबारा चुनें</p><p dir=\"auto\">वे 5 वर्ष तक <strong>US नौसेना कर्मी </strong>रहे हैं और उन्होंने विमानवाहक पोत पर सेवा प्रदान की है।</p>","HY":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER-Ի (ԲԻԼ ՔՈՒՓԵՐ) ՀԱՅՏԱՐԱՐՈՒԹՅՈՒՆԸ</h1><h2 dir=\"auto\" style=\"text-align: center\">ՏՆՕՐԵՆՆԵՐԻ ԽՈՐՀՐԴԻ ԱՆԴԱՄԻ ԹԵԿՆԱԾՈՒ,<br dir=\"auto\">Բաժին 1</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY ՋՐԱՄԱՏԱԿԱՐԱՐՄԱՆ ԳՈՐԾԱԿԱԼՈՒԹՅՈՒՆ</h3><p dir=\"auto\">Պաշտոնը՝ Santa Clarita Valley Ջրամատակարարման գործակալության խորհրդի փոխնախագահ</p><p dir=\"auto\"><strong>BILL COOPER-ը </strong>իր ողջ մասնագիտական կարիերան աշխատել է ջրային ռեսուրսների ոլորտում՝ կառավարելով  Metropolitan Water ջրամաքրման բոլոր հինգ կայանների գործունեությունը, որոնք սպասարկում են ջուրը <strong>19 միլիոն </strong>մարդու համար Southern California-ում։ Ջրի մաքրման և բաշխման խոշոր կայանների կառավարումը նրան տալիս է մեր տեղական ջրամատակարարման որակը և հասանելիությունը պաշտպանելու համար անհրաժեշտ փորձը։</p><p dir=\"auto\">Santa Clarita Valley-ի ջրամատակարարման հուսալի, անվտանգ և մատչելի լինելը կարևոր է մեր համայնքի և մեր կյանքի որակի համար։</p><p dir=\"auto\"><strong>BILL COOPER-ը </strong>կշարունակի ձգտել պատասխանատու ջրային կառավարմանը՝ հետևյալ կերպ.</p><p dir=\"auto\"><strong>Առկա պաշարների մաքսիմալացում՝ </strong>վերամշակման և պահպանման միջոցով,</p><p dir=\"auto\"><strong>Նոր զարգացման կարիք </strong>շինարարությունից առաջ ջրի որոշակի պաշար ունենալու համար,</p><p dir=\"auto\"><strong>Ստորգետնյա բանկային պահեստավորման ծրագրերի խթանում՝ </strong>երաշտի տարիներին ջուր ապահովելու նպատակով,</p><p dir=\"auto\"><strong>Աղտոտիչների հեռացում, </strong>որոնք սպառնում են մեր ստորգետնյա ջրերին և պահանջում են, որ աղտոտողները վճարեն մաքրման համար,</p><p dir=\"auto\"><strong>Փնտրել</strong> <strong>Դաշնային և Նահանգային </strong>ֆինանսավորում՝ տեղական նախագծերի ծախսերը կրճատելու համար,</p><p dir=\"auto\"><strong>Ջրի ցածր սակագների պահպանում՝ </strong>խիստ բյուջետային վերահսկողության միջոցով։</p><p dir=\"auto\"><strong>BILL COOPER-ը </strong>կշարունակի աշխատել՝ ապահովելու, որ մենք միշտ ունենանք հուսալի և <strong>բարձրորակ </strong>մատակարարում՝ <strong>ողջամիտ գնով </strong>և պաշտպանելու մեր հովիտը ապագա երաշտից՝ պատասխանատու պլանավորման և կառավարման միջոցով։</p><p dir=\"auto\">Վերընտրեք փորձառու <strong>BILL COOPER</strong> թեկնածուին</p><p dir=\"auto\">5 տարի <strong>ԱՄՆ ռազմածովային ուժերի վետերան՝ </strong>ծառայելով ավիակրի վրա։</p>","ID":"<h1 dir=\"auto\" style=\"text-align: center\">PERNYATAAN BILL COOPER</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDAT UNTUK ANGGOTA, DEWAN DIREKSI,<br dir=\"auto\">Divisi 1</h2><h3 dir=\"auto\" style=\"text-align: center\">BADAN PENGAIRAN SANTA CLARITA VALLEY</h3><p dir=\"auto\">Pekerjaan: Wakil Presiden Dewan Badan Pengairan Santa Clarita Valley</p><p dir=\"auto\"><strong>BILL COOPER </strong>telah mengabdikan seluruh karier profesionalnya di bidang sumber daya air mengelola operasional kelima instalasi pengolahan air Metropolitan Water yang memasok air ke <strong>19 juta </strong>penduduk di Southern California (California Selatan). Mengelola fasilitas pengolahan dan distribusi air berskala besar memberinya pengalaman yang dibutuhkan untuk melindungi kualitas dan ketersediaan pasokan air lokal kita.</p><p dir=\"auto\">Pasokan air yang andal, aman dan terjangkau ke Santa Clarita Valley sangat penting bagi komunitas kita dan kualitas hidup yang kita nikmati.</p><p dir=\"auto\"><strong>BILL COOPER </strong>akan terus mengupayakan pengelolaan air yang bertanggung jawab dengan cara:</p><p dir=\"auto\"><strong>Memaksimalkan Pasokan yang Ada </strong>melalui daur ulang dan konservasi;</p><p dir=\"auto\"><strong>Mewajibkan Pengembangan Baru </strong>untuk memiliki pasokan air yang dapat diidentifikasi sebelum pembangunan;</p><p dir=\"auto\"><strong>Mempromosikan Program Penyimpanan Cadangan Air Bawah Tanah </strong>untuk menyediakan air selama tahun-tahun kekeringan;</p><p dir=\"auto\"><strong>Menghilangkan Kontaminan </strong>yang mengancam air tanah kita dan mewajibkan para pencemar untuk membayar biaya pembersihan;</p><p dir=\"auto\"><strong>Mencari pendanaan dari Pemerintah Federal dan Negara Bagian </strong>untuk mengurangi biaya-biaya proyek lokal;</p><p dir=\"auto\"><strong>Mempertahankan Tarif Air yang Rendah </strong>melalui pengawasan anggaran yang ketat.</p><p dir=\"auto\"><strong>BILL COOPER </strong>akan terus bekerja keras untuk memastikan bahwa kita selalu memiliki pasokan air <strong>berkualitas tinggi </strong>yang andal dengan <strong>biaya yang wajar </strong>dan untuk melindungi lembah kita dari kekeringan pada masa depan melalui perencanaan dan pengelolaan yang bertanggung jawab.</p><p dir=\"auto\">Pilih kembali <strong>BILL COOPER </strong>Kandidat yang Berpengalaman</p><p dir=\"auto\"><strong>Veteran Angkatan Laut AS </strong>yang bertugas 5 Tahun di atas kapal induk.</p>","JA":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER（ビル・クーパー）の声明</h1><h2 dir=\"auto\" style=\"text-align: center\">役員会、役員の候補者、<br dir=\"auto\">第１部門</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY 水道機関</h3><p dir=\"auto\">職業：Santa Clarita Valley水道機関役員会副会長</p><p dir=\"auto\"><strong>BILL COOPER</strong>は、水資源分野での職業人生を通じて、Southern Californiaの<strong>1,900万人</strong>に水を供給するMetropolitan Water（メトロポリタンウォーター）の五つの浄水場すべての運営管理に携わってきました。大規模な浄水・配水施設を管理してきた経験は、地域の水供給の質と安定供給を守るために必要です。</p><p dir=\"auto\">Santa Clarita Valleyへの信頼性が高く、安全で手頃な水の供給は、地域社会と私たちの生活の質に不可欠です。</p><p dir=\"auto\"><strong>BILL　COOPER</strong>は、責任ある水管理を目指し、以下の取り組みを継続します：</p><p dir=\"auto\"><strong>既存水源の最大活用</strong>：再利用と節水を推進します；</p><p dir=\"auto\"><strong>新規開発への要件</strong>：建設前に明確な水源を確保することを求めます；</p><p dir=\"auto\"><strong>地下水貯留事業の推進：</strong>干ばつ時に利用できる水を確保します；</p><p dir=\"auto\"><strong>汚染物質の除去：</strong>地下水を脅かす汚染物質を除去し、汚染者に浄化費用を負担させます；</p><p dir=\"auto\"><strong>連邦・州政府の資金確保：</strong>地域計画の費用を削減します；</p><p dir=\"auto\"><strong>低い水道料金の維持：</strong>厳格な予算監督を行います。</p><p dir=\"auto\"><strong>BILL COOPER</strong>は、<strong>高品質</strong>な水を<strong>適正な費用</strong>で安定して供給し、責任ある計画と管理によって将来の干ばつから地域を守るため、引き続き尽力します。</p><p dir=\"auto\">経験豊富な候補者<strong>BILL COOPER</strong>を再選へ</p><p dir=\"auto\">5年間、<strong>US海軍の退役軍人</strong>であり、現役時代は航空母艦に乗務していました。</p>","KM":"<h1 dir=\"auto\" style=\"text-align: center\">សេចក្តីថ្លែងការណ៍របស់ BILL COOPER (ប៊ីល ឃូភើរ)</h1><h2 dir=\"auto\" style=\"text-align: center\">បេក្ខជនសំរាប់សមាជិក, គណៈកម្មការនាយក,<br dir=\"auto\">តំបន់ 1</h2><h3 dir=\"auto\" style=\"text-align: center\">ទីភ្នាក់ងារកែច្នៃទឹក SANTA CLARITA VALLEY</h3><p dir=\"auto\">មុខរបរ ៖ អនុប្រធានគណៈ​កម្មការ​​ទីភ្នាក់ងារកែច្នៃទឹក Santa Clarita Valley</p><p dir=\"auto\"><strong>លោក BILL COOPER</strong> បានចំណាយពេលពេញមួយជីវិតការងារ​អា​ជីពរបស់លោកក្នុងវិស័យធនធានទឹកដោយគ្រប់គ្រងប្រតិបត្តិការនៃ​រោងចក្រ​ប្រព្រឹត្តិកម្មទឹកទីក្រុងទាំងប្រាំកន្លែងដែលផ្គត់ផ្គង់ទឹកជូនប្រជាពលរដ្ឋចំនួន <strong>19 លាន</strong>នាក់ នៅរដ្ឋ Southern California ។ ការគ្រប់គ្រងរោងចក្រប្រព្រឹត្តិកម្ម និងអគារចែកចាយទឹកទំហំធំបានផ្តល់ជូន លោកនូវបទពិសោធចាំបាច់ ដើម្បីការពារគុណភាព និងការផ្គត់ផ្គង់ប្រភព​ទឹក​នៅក្នុងមូលដ្ឋានរបស់យើង ។</p><p dir=\"auto\">ការផ្គត់ផ្គង់ទឹកប្រកបដោយភាពទុកចិត្ត សុវត្ថិភាព និងតម្លៃសមរម្យជូន​ដល់​តំបន់ Santa Clarita Valley គឺជារឿងសំខាន់បំផុតសម្រាប់​សហគមន៍​របស់​យើង និងគុណភាពជីវិតដែលយើងកំពុងរីករាយ ។</p><p dir=\"auto\"><strong>លោក BILL COOPER </strong>នឹងបន្តខិតខំប្រឹងប្រែងដើម្បីការគ្រប់គ្រងទឹក​ប្រកបដោយការទទួលខុសត្រូវតាមរយៈ ៖</p><p dir=\"auto\"><strong>ការប្រើប្រាស់ប្រភពទឹកដែលមានស្រាប់ឱ្យអស់លទ្ធភាព</strong> តាមរយៈ​ការ​កែច្នៃប្រើប្រាស់ឡើងវិញ និងការសំចៃទឹក</p><p dir=\"auto\"><strong>តម្រូវឱ្យមានគម្រោងអភិវឌ្ឍន៍ថ្មីៗ</strong>ដើម្បីមានប្រភពទឹកច្បាស់លាស់ដែលអាចកំណត់បាន មុនពេលចាប់ផ្តើមការសាងសង់</p><p dir=\"auto\"><strong>លើកកម្ពស់កម្មវិធីស្តុកទឹកក្រោមដី</strong> ដើម្បីផ្គត់ផ្គង់ទឹក​ក្នុងអំឡុង​ឆ្នាំគ្រោះ​រាំង​ស្ងួត</p><p dir=\"auto\"><strong>លុបបំបាត់សារធាតុពុល</strong>ដែលគំរាមកំហែងដល់ប្រភពទឹកក្រោមដីរបស់យើង និងតម្រូវឱ្យជនបង្កការបំពុលចេញថ្លៃសម្អាត</p><p dir=\"auto\"><strong>ស្វែងរកថវិកាឧបត្ថម្ភពីសហព័ន្ធ និងរដ្ឋ</strong> ដើម្បីកាត់​បន្ថយថ្លៃ​ចំណាយ​លើ​គម្រោង​ក្នុងមូលដ្ឋាន</p><p dir=\"auto\"><strong>រក្សាអត្រាថ្លៃទឹកឱ្យនៅទាប</strong>តាមរយៈការត្រួតពិនិត្យថវិកាយ៉ាងម៉ឺងម៉ាត់ ។</p><p dir=\"auto\"><strong>លោក BILL COOPER </strong>នឹងបន្តខិតខំបំពេញការងារ ដើម្បីធានាថា​យើ​ង​មានការផ្គត់ផ្គង់ទឹក<strong>ប្រកបដោយគុណភាពខ្ពស់</strong> និងទុកចិត្តក្នុង​<strong>តម្លៃសមរម្យ</strong>ជានិច្ច ព្រមទាំងការពារជ្រលងភ្នំរបស់យើង​ពីគ្រោះរាំង​ស្ងួតនាពេលអនាគតតាមរយៈការរៀបចំផែនការ និងការគ្រប់គ្រង​ប្រកប​ដោយការទទួលខុសត្រូវ ។</p><p dir=\"auto\">សូមបោះឆ្នោតជ្រើសរើសលោក <strong>BILL COOPER </strong>ឡើងវិញ ដែល​ជាបេក្ខជន​មានបទពិសោធ</p><p dir=\"auto\">5 ឆ្នាំ<strong>ជាអតីតយុទ្ធជនជើងទឹកអាមេរិក</strong>ដែលបានបម្រើការនៅលើនាវា​ដឹកយន្តហោះចម្បាំង ។</p>","KO":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER (빌 쿠퍼) 의 성명서</h1><h2 dir=\"auto\" style=\"text-align: center\">이사회 이사 후보,<br dir=\"auto\">제 1 부</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY 수도국</h3><p dir=\"auto\">직업: Santa Clarita Valley 수도국 이사회 부회장</p><p dir=\"auto\"><strong>BILL COOPER</strong>는 Southern California 주민 <strong>1,900만 명</strong>에게 물을 공급하는 Metropolitan Water의 다섯 곳 정수장 전체 운영을 관리하는 등 평생의 직업 경력을 수자원 분야에서 쌓아 왔습니다. 대규모 정수 및 급수 시설을 관리한 경험을 바탕으로, 그는 우리 지역 수자원의 수질과 공급 가능성을 보호하는 데 필요한 전문성을 갖추고 있습니다.</p><p dir=\"auto\">Santa Clarita Valley에 신뢰할 수 있고 안전하며 합리적인 비용의 물을 공급하는 것은 우리 커뮤니티와 우리가 누리는 삶의 질에 필수적입니다.</p><p dir=\"auto\"><strong>BILL COOPER</strong>는 다음과 같은 방법으로 책임 있는 수자원 관리를 위해 계속 노력하겠습니다:</p><p dir=\"auto\">재활용과 절수를 통해 <strong>기존 수자원의 최대한 활용</strong>;</p><p dir=\"auto\">착공 전에 확인 가능한 수자원을 확보하도록 <strong>신규 개발 사업에 요구</strong>;</p><p dir=\"auto\">가뭄 시 물을 공급할 수 있도록 <strong>지하수 저장 프로그램 추진</strong>;</p><p dir=\"auto\">지하수를 위협하는 <strong>오염물질을 제거</strong>하고 오염 유발자가 정화 비용을 부담하도록 요구;</p><p dir=\"auto\">지역 사업 비용을 절감하기 위해 <strong>연방 및 주 정부 재원을 확보</strong>;</p><p dir=\"auto\">엄격한 예산 감독을 통해 <strong>낮은 수도 요금 유지</strong>.</p><p dir=\"auto\"><strong>BILL COOPER</strong>는 책임감 있는 계획과 관리를 통해 미래의 가뭄으로부터 우리 밸리를 보호하고, <strong>합리적인 비용</strong>으로 <strong>양질</strong>의 물을 항상 안정적으로 공급할 수 있도록 계속해서 최선을 다하겠습니다.</p><p dir=\"auto\">경험을 갖춘 후보 <strong>BILL COOPER</strong>를 재선시켜 주십시오</p><p dir=\"auto\"><strong>US 해군 </strong>항공모함에서 5년간<strong> </strong>복무한<strong> 재향군인</strong>입니다.</p>","MN":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER (БИЛЛ КҮҮПЕР)-ИЙН МЭДЭГДЭЛ</h1><h2 dir=\"auto\" style=\"text-align: center\">ГИШҮҮНД НЭР ДЭВШИГЧ, ЗАХИРЛУУДЫН ЗӨВЛӨЛ,<br dir=\"auto\">Хэсэг 1</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY УС ХАНГАМЖИЙН ГАЗАР</h3><p dir=\"auto\">Ажил мэргэжил: Santa Clarita Valley Ус Хангамжийн Газрын Зөвлөлийн дэд ерөнхийлөгч</p><p dir=\"auto\"><strong>BILL COOPER </strong>нь Southern California дахь <strong>19 сая </strong>хүнд ус түгээдэг Metropolitan Water-ийн ус цэвэршүүлэх таван байгууламжийн үйл ажиллагааг зохицуулах усны нөөцийн чиглэлээр ажил мэргэжлийнхээ бүхий л хугацаанд ажиллаж ирсэн. Томоохон ус цэвэрлэх болон ус түгээх байгууламжуудыг зохицуулан ажилласан туршлага нь манай орон нутгийн усан хангамжийн чанар, хүртээмжийг хамгаалахад шаардлагатай туршлагыг түүнд өгсөн.</p><p dir=\"auto\">Santa Clarita Valley-г найдвартай, аюулгүй, боломжийн үнэтэй усаар хангах нь манай олон нийтэд болон бидний хүсдэг амьдралын чанарыг бий болгоход нэн чухал.</p><p dir=\"auto\"><strong>BILL COOPER </strong>нь хариуцлагатай усны удирдлагыг хэрэгжүүлэхийн төлөө хичээн ажилласаар байх болно:</p><p dir=\"auto\">дахин боловсруулах болон ус хэмнэх замаар одоо байгаа усны нөөцийг нэмэгдүүлэх;</p><p dir=\"auto\"><strong>Шинээр барилга барихын өмнө </strong>шинээр хөгжүүлж буй төслүүдэд тодорхой усан хангамжийн эх үүсвэртэй байх шаардлага тавих;</p><p dir=\"auto\"><strong>Гантай жилүүдэд усаар хангах зорилгоор газар доорх байгууламжид </strong>хуримтлуулах хөтөлбөрүүдийг дэмжих;</p><p dir=\"auto\"><strong>Манай газрын доорх усанд аюул учруулж буй бохирдуулагч бодисыг зайлуулж, </strong>бохирдол үүсгэгчдээр цэвэрлэгээний зардлыг төлүүлэх;</p><p dir=\"auto\"><strong>Орон нутгийн төслийн зардлыг бууруулахын тулд </strong>холбооны болон мужийн санхүүжилтийг эрэлхийлэх;</p><p dir=\"auto\"><strong>Төсвийн хатуу хяналтаар дамжуулан </strong>усны үнийг бага дээр барих.</p><p dir=\"auto\">BILL COOPER нь биднийг боломжийн үнээр өндөр чанартай, найдвартай усаар тогтмол хангах, мөн хариуцлагатай төлөвлөлт, удирдлагаар дамжуулан манай хөндийг ирээдүйн ган гачгаас хамгаалахын төлөө үргэлжлүүлэн шаргуу ажиллах болно.</p><p dir=\"auto\">Туршлагатай нэр дэвшигч <strong>BILL COOPER</strong>-ийг дахин сонгоорой</p><p dir=\"auto\">5 Жил <strong>US Тэнгисийн цэргийн хүчинд </strong>алба хаасан ахмад дайчин, нисэх онгоц тээгч хөлгөн дээр үүрэг гүйцэтгэж байсан.</p>","MY":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER (ဘီလ် ကူးပါး) ၏ ထုတ်ပြန်ချက်</h1><h2 dir=\"auto\" style=\"text-align: center\">အဖွဲ့ဝင်အတွက် ကိုယ်စားလှယ်လောင်း၊ ဒါရိုက်တာများဘုတ်အဖွဲ့၊<br dir=\"auto\">ဌာနခွဲ 1</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY ရေအေဂျင်စီ</h3><p dir=\"auto\">အလုပ်အကိုင်- Santa Clarita Valley ရေအေဂျင်စီ ဘုတ်အဖွဲ့ ဒုတိယဥက္ကဋ္ဌ</p><p dir=\"auto\"><strong>BILL COOPER </strong>သည် Southern California တွင် လူပေါင်း <strong>19 သန်း</strong>ထံ ရေဖြန့်ဝေပေးလျက်ရှိသော Metropolitan Water ရေသန့်စင်စက်ရုံ ငါးရုံစလုံး၏ လုပ်ငန်းဆောင်ရွက်မှုများကို စီမံခန့်ခွဲရင်း သူ၏ အတတ်ပညာရှင်သက်တမ်းတစ်ခုလုံးကို ရေအရင်းအမြစ်ဆိုင်ရာ ကဏ္ဍတွင် လုပ်ကိုင်ခဲ့ပါသည်။ ကြီးမားသော ရေသန့်စင်ရေးနှင့် ဖြန့်ဝေရေး အဆောက်အအုံများကို စီမံခန့်ခွဲခြင်းသည် သူ့အား ကျွန်ုပ်တို့၏ ဒေသတွင်း ရေပေးဝေမှု၏ အရည်အသွေးနှင့် ရရှိနိုင်မှုကို ကာကွယ်ရန် လိုအပ်သည့် အတွေ့အကြုံများကို ရရှိစေပါသည်။</p><p dir=\"auto\">Santa Clarita Valley ထံ စိတ်ချရသော၊ ဘေးကင်းသော၊ ကုန်ကျစရိတ်သက်သာသော ရေပေးဝေမှုသည် ကျွန်ုပ်တို့၏ အသိုက်အဝန်းနှင့် ကျွန်ုပ်တို့ ခံစားစံစားနေရသော လူနေမှုဘဝ အရည်အသွေးအတွက် မရှိမဖြစ် လိုအပ်ပါသည်။</p><p dir=\"auto\"><strong>BILL COOPER </strong>သည် အောက်ပါတို့မှတစ်ဆင့် တာဝန်ယူမှုရှိသော ရေစီမံခန့်ခွဲမှုအတွက် ဆက်လက် ကြိုးပမ်းသွားပါမည်-</p><p dir=\"auto\">ပြန်လည်အသုံးပြုခြင်းနှင့် ထိန်းသိမ်းစောင့်ရှောက်ခြင်းတို့မှတစ်ဆင့် <strong>လက်ရှိ ရေပေးဝေမှုများကို အပြည့်အဝ အကျိုးရှိရှိ အသုံးပြုခြင်း</strong>၊</p><p dir=\"auto\">မဆောက်လုပ်မီ <strong>အကောင်အထည်ဖော်ဆောင်ရွက်မှုအသစ်များ</strong>တွင် ရေပေးဝေမှု အခိုင်အမာ ရှိစေရန် <strong>တောင်းဆိုခြင်း</strong>၊</p><p dir=\"auto\">မိုးခေါင်ရေရှားသည့် နှစ်များတွင် ရေပေးဝေနိုင်ရန် <strong>မြေအောက် ရေလှောင်ကန် ပရိုဂရမ်များကို မြှင့်တင်ခြင်း</strong>၊</p><p dir=\"auto\">ကျွန်ုပ်တို့၏ မြေအောက်ရေကို ခြိမ်းခြောက်နေသည့် <strong>ညစ်ညမ်းပစ္စည်းများကို ဖယ်ရှားခြင်း</strong>နှင့် ညစ်ညမ်းစေသူများအား သန့်ရှင်းရေးအတွက် ကျသင့်ငွေ ပေးဆောင်စေခြင်း၊</p><p dir=\"auto\">ဒေသတွင်း စီမံကိန်း ကုန်ကျစရိတ်များကို လျှော့ချရန် <strong>ဖက်ဒရယ်နှင့် ပြည်နယ်</strong> ရန်ပုံငွေများကို ရှာဖွေခြင်း၊</p><p dir=\"auto\">တင်းကျပ်သော သတ်မှတ်အသုံးစရိတ် ကြီးကြပ်ကွပ်ကဲမှုမှတစ်ဆင့် <strong>ရေဖိုး ရေခများကို သက်သာစွာ ထိန်းသိမ်းထားခြင်း</strong>။</p><p dir=\"auto\"><strong>BILL COOPER </strong>သည် ကျွန်ုပ်တို့ထံတွင် <strong>သင့်တော်သော ကုန်ကျစရိတ်</strong>ဖြင့် <strong>အရည်အသွေးမြင့်မားသော </strong>ရေကို စိတ်ချစွာ အမြဲမပြတ် ရရှိစေရေး သေချာစေရန်နှင့် တာဝန်ယူမှုရှိသော စီမံကိန်းရေးဆွဲမှုနှင့် စီမံခန့်ခွဲမှုတို့မှတစ်ဆင့် ကျွန်ုပ်တို့၏ ချိုင့်ဝှမ်းဒေသကို အနာဂတ် မိုးခေါင်ရေရှားမှုမှ ကာကွယ်ရန် ဆက်လက် ကြိုးပမ်းဆောင်ရွက်သွားပါမည်။</p><p dir=\"auto\">အတွေ့အကြုံရှိသော ကိုယ်စားလှယ်လောင်း <strong>BILL COOPER </strong>ကို ပြန်လည်ရွေးကောက်တင်မြှောက်ပါ</p><p dir=\"auto\">လေယာဉ်တင်သင်္ဘောပေါ်တွင် တာဝန်ထမ်းဆောင်ခဲ့သည့် 5 နှစ်တာ <strong>အမေရိကန်ပြည်ထောင်စု ရေတပ် စစ်မှုထမ်းဟောင်း</strong>။</p>","RU":"<h1 dir=\"auto\" style=\"text-align: center\">ЗАЯВЛЕНИЕ BILL COOPER (БИЛЛ КУПЕР)</h1><h2 dir=\"auto\" style=\"text-align: center\">КАНДИДАТ В ЧЛЕНЫ СОВЕТА ДИРЕКТОРОВ,<br dir=\"auto\">Подразделение 1</h2><h3 dir=\"auto\" style=\"text-align: center\">УПРАВЛЕНИЕ ВОДОСНАБЖЕНИЯ SANTA CLARITA VALLEY</h3><p dir=\"auto\">Род занятий: Вице-президент совета Управления водоснабжения Santa Clarita Valley</p><p dir=\"auto\"><strong>BILL COOPER</strong> всю свою профессиональную карьеру проработал в сфере водных ресурсов, управляя работой всех пяти водоочистных сооружений Metropolitan Water, обеспечивающих водой <strong>19 миллионов</strong> жителей Southern California. Опыт управления крупными водоочистными и водораспределительными объектами дает ему необходимые знания для защиты качества и доступности наших местных запасов воды.</p><p dir=\"auto\">Надежное, безопасное и доступное водоснабжение Santa Clarita Valley имеет важнейшее значение для нашего сообщества и качества нашей жизни.</p><p dir=\"auto\"><strong>BILL COOPER</strong> продолжит добиваться ответственного управления водными ресурсами посредством:</p><p dir=\"auto\"><strong>Максимально эффективного использования существующих запасов</strong> путем переработки и экономии воды;</p><p dir=\"auto\"><strong>Требования к новым объектам застройки</strong> иметь подтвержденный источник водоснабжения до начала строительства;</p><p dir=\"auto\"><strong>Содействия программам подземного накопления воды</strong> для обеспечения водой в засушливые годы;</p><p dir=\"auto\"><strong>Удаления загрязняющих веществ,</strong> угрожающих нашим подземным водам, и требования к загрязнителям оплачивать очистку;</p><p dir=\"auto\"><strong>Привлечения федерального финансирования и финансирования штата</strong> для снижения стоимости местных проектов;</p><p dir=\"auto\"><strong>Сохранения низких тарифов на воду</strong> посредством строгого контроля бюджета.</p><p dir=\"auto\"><strong>BILL COOPER</strong> продолжит упорно работать, чтобы у нас всегда был надежный запас воды <strong>высокого качества</strong> по <strong>разумной цене</strong>, а также чтобы защитить нашу долину от будущих засух посредством ответственного планирования и управления.</p><p dir=\"auto\">Переизберите <strong>BILL COOPER</strong> — опытного кандидата</p><p dir=\"auto\"><strong>Ветеран Военно-морских сил США</strong> с 5-летним стажем, проходивший службу на борту авианосца.</p>","TE":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER (బిల్ కూపర్) స్టేట్​మెంట్</h1><h2 dir=\"auto\" style=\"text-align: center\">సభ్యుని కొరకు అభ్యర్థి, డైరెక్టర్ల బోర్డు,<br dir=\"auto\">విభాగం 1</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY వాటర్ ఏజెన్సీ</h3><p dir=\"auto\">వృత్తి: Santa Clarita Valley వాటర్ ఏజెన్సీ బోర్డు వైస్ ప్రెసిడెంట్</p><p dir=\"auto\"><strong>BILL COOPER </strong>తన వృత్తి జీవితమంతా జలవనరుల రంగంలోనే పనిచేశారు. Southern Californiaలోని <strong>19 మిలియన్ల </strong>ప్రజలకు నీటిని అందిస్తున్న ఐదు మెట్రోపాలిటన్ నీటి శుద్ధి కర్మాగారాల కార్యకలాపాలను ఆయన నిర్వహించారు. పెద్ద నీటి శుద్ధి మరియు పంపిణీ సౌకర్యాలను నిర్వహించడం వల్ల, మన స్థానిక నీటి సరఫరాల నాణ్యతను మరియు లభ్యతను కాపాడటానికి అవసరమైన అనుభవం ఆయనకు లభించింది.</p><p dir=\"auto\">Santa Clarita Valleyకు నమ్మకమైన, సురక్షితమైన మరియు సరసమైన నీటి సరఫరా మన కమ్యూనిటీకి మరియు మనం అనుభవిస్తున్న జీవన నాణ్యతకు అత్యవసరం.</p><p dir=\"auto\"><strong>BILL COOPER </strong>ఈ క్రింది చర్యల ద్వారా బాధ్యతాయుతమైన నీటి నిర్వహణ కోసం కృషి చేస్తూనే ఉంటారు:</p><p dir=\"auto\">పునరుపయోగం మరియు పరిరక్షణ ద్వారా <strong>ప్రస్తుత సరఫరాలను గరిష్ఠంగా వినియోగించుకోవడం</strong>;</p><p dir=\"auto\"><strong>కొత్త నిర్మాణాలు</strong> చేపట్టే ముందు, గుర్తించదగిన నీటి సరఫరా ఉండేలా చూడటం;</p><p dir=\"auto\">కరువు సంవత్సరాలలో నీటిని అందించడానికి <strong>భూగర్భ బ్యాంకింగ్ నిల్వ కార్యక్రమాలను ప్రోత్సహించడం</strong>;</p><p dir=\"auto\">మన భూగర్భ జలాలకు ముప్పుగా ఉన్న <strong>కలుషితాలను తొలగించడం</strong> మరియు శుభ్రపరిచే ఖర్చులను కాలుష్య కారకులే చెల్లించేలా చేయడం.</p><p dir=\"auto\">స్థానిక ప్రాజెక్టుల ఖర్చులను తగ్గించడానికి <strong>కేంద్ర మరియు రాష్ట్ర నిధులను కోరడం</strong>;</p><p dir=\"auto\">కఠినమైన బడ్జెట్ పర్యవేక్షణ ద్వారా <strong>తక్కువ నీటి ధరలను కొనసాగించడం</strong>.</p><p dir=\"auto\"><strong>BILL COOPER</strong>, బాధ్యతాయుతమైన ప్రణాళిక మరియు నిర్వహణ ద్వారా, మనకు ఎల్లప్పుడూ <strong>సరసమైన ధరలో</strong> <strong>నాణ్యమైన</strong> నీటి సరఫరా విశ్వసనీయంగా ఉండేలా చూడటానికి మరియు భవిష్యత్తులో కరువు నుండి మన వ్యాలీను రక్షించడానికి కష్టపడి పనిచేయడం కొనసాగిస్తారు.</p><p dir=\"auto\">అనుభవజ్ఞుడైన అభ్యర్థి <strong>BILL COOPER </strong>ను తిరిగి ఎన్నుకోండి</p><p dir=\"auto\">విమాన వాహక నౌకలో పనిచేసిన 5 సంవత్సరాల <strong>US నేవీ వెటరన్</strong>.</p>","TH":"<h1 dir=\"auto\" style=\"text-align: center\">แถลงการณ์ของ BILL COOPER (บิล คูเปอร์)</h1><h2 dir=\"auto\" style=\"text-align: center\">ผู้สมัครรับเลือกตั้งสำหรับตำแหน่งสมาชิกคณะกรรมการอำนวยการ<br dir=\"auto\">แผนก 1</h2><h3 dir=\"auto\" style=\"text-align: center\">หน่วยการประปา SANTA CLARITA VALLEY</h3><p dir=\"auto\">อาชีพ: รองประธานคณะกรรมการหน่วยการประปา Santa Clarita Valley</p><p dir=\"auto\"><strong>BILL COOPER </strong>ทำงานด้านทรัพยากรน้ำมาตลอดชีวิตการทำงาน โดยบริหารจัดการการดำเนินงานของโรงบำบัดน้ำทั้งห้าแห่งซึ่งให้บริการน้ำแก่ประชาชน <strong>19 ล้าน </strong>คนใน Southern California การบริหารจัดการโรงบำบัดน้ำและจ่ายน้ำขนาดใหญ่ทำให้เขามีประสบการณ์ที่จำเป็นในการปกป้องคุณภาพและความพร้อมของแหล่งน้ำในท้องถิ่นของเรา</p><p dir=\"auto\">การจัดหาน้ำที่เชื่อถือได้ ปลอดภัย และราคาไม่แพงให้กับ Santa Clarita Valley เป็นสิ่งจำเป็นอย่างยิ่งสำหรับชุมชนของเราและคุณภาพชีวิตที่เราได้รับ</p><p dir=\"auto\"><strong>BILL COOPER </strong>จะยังคงมุ่งมั่นในการบริหารจัดการน้ำอย่างมีความรับผิดชอบต่อไป โดย:</p><p dir=\"auto\"><strong>ใช้ประโยชน์จากทรัพยากรที่มีอยู่ให้เกิดประโยชน์สูงสุด </strong>โดยการรีไซเคิลและการอนุรักษ์;</p><p dir=\"auto\"><strong>กำหนดให้ต้องมีการพัฒนาใหม่ </strong>ต้องมีแหล่งน้ำที่ระบุได้ชัดเจนก่อนเริ่มก่อสร้าง;</p><p dir=\"auto\"><strong>ส่งเสริมโครงการกักเก็บน้ำใต้ดิน </strong>เพื่อจัดหาน้ำในช่วงปีที่เกิดภัยแล้ง;</p><p dir=\"auto\"><strong>กำจัดสารปนเปื้อน </strong>ที่คุกคามแหล่งน้ำใต้ดินของเรา และบังคับให้ผู้ก่อมลพิษต้องรับผิดชอบค่าใช้จ่ายในการทำความสะอาด</p><p dir=\"auto\"><strong>แสวงหาเงินทุนจากรัฐบาลกลางและรัฐบาลท้องถิ่น </strong>เพื่อลดต้นทุนโครงการในท้องถิ่น</p><p dir=\"auto\"><strong>รักษาระดับอัตราค่าน้ำให้ต่ำ </strong>ผ่านการกำกับดูแลงบประมาณอย่างเข้มงวด</p><p dir=\"auto\"><strong>BILL COOPER </strong>จะยังคงทำงานอย่างหนักต่อไปเพื่อให้มั่นใจว่าเรามีแหล่งน้ำ<strong>ที่มีคุณภาพสูง</strong> และมี<strong>ต้นทุนที่สมเหตุสมผล</strong>ใช้อย่างมั่นคงตลอดเวลา รวมทั้งปกป้องพื้นที่หุบเขาของเราจากภัยแล้งในอนาคตผ่านการวางแผนและการจัดการอย่างมีความรับผิดชอบ</p><p dir=\"auto\">เลือก <strong>BILL COOPER </strong>ผู้สมัครที่มีประสบการณ์</p><p dir=\"auto\">ซึ่งเป็น<strong>ทหารผ่านศึกกองทัพเรือสหรัฐฯ </strong>ปฏิบัติหน้าที่บนเรือบรรทุกเครื่องบินเป็นเวลา 5 ปี กลับเข้าดำรงตำแหน่งอีกครั้ง</p>","TL":"<h1 dir=\"auto\" style=\"text-align: center\">PAHAYAG NI BILL COOPER</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDATO PARA MIYEMBRO, LUPON NG MGA DIREKTOR,<br dir=\"auto\">Dibisyon 1</h2><h3 dir=\"auto\" style=\"text-align: center\">AHENSIYA NG TUBIG NG SANTA CLARITA VALLEY</h3><p dir=\"auto\">Trabaho: Bise Presidente ng Ahensiya ng Tubig ng Santa Clarita Valley</p><p dir=\"auto\"><strong>Si BILL COOPER </strong>ay nagtrabaho sa buong propesyonal niyang karera sa yamang-tubig, na namamahala sa mga operasyon ng lahat ng limang planta ng Metropolitan Water na naghahatid ng tubig sa <strong>19 milyon </strong>mga tao sa Southern California. Ang pamamahala ng malalaking pasilidad sa paggamot at pamamahagi ng tubig ay nagbibigay sa kanya ng karanasang kailangan upang protektahan ang kalidad at pagkakaroon ng ating mga lokal na suplay ng tubig.</p><p dir=\"auto\">Ang maaasahan, ligtas at abot-kayang suplay ng tubig sa Santa Clarita Valley ay mahalaga para sa ating komunidad at sa kalidad ng buhay na ating tinatamasa.</p><p dir=\"auto\"><strong>Si BILL COOPER </strong>ay patuloy na magsisikap para sa responsableng pamamahala ng tubig sa pamamagitan ng:</p><p dir=\"auto\"><strong>Sulitin ang kasalukuyang suplay </strong>sa pamamagitan ng pag-recycle at konserbasyon;</p><p dir=\"auto\"><strong>Pag-aatas na ang mga bagong pagpapaunlad</strong> ay magkaroon muna ng tiyak na mapagkukunan ng tubig bago magsimula ang pagtatayo;</p><p dir=\"auto\"><strong>Pagtataguyod ng mga Programa sa Pagiimbak ng tubig sa Ilalim ng Lupa </strong>upang magbigay ng tubig sa mga taon ng tagtuyot;</p><p dir=\"auto\"><strong>Pag-aalis ng mga Kontaminante </strong>nagbabanta sa ating tubig sa lupa at hinihiling sa mga nagpaparumi na magbayad para sa paglilinis;</p><p dir=\"auto\"><strong>Naghahanap sa Pederal at Estado</strong> ng<strong> </strong>pagpopondo upang mabawasan ang mga gastos sa lokal na proyekto;</p><p dir=\"auto\"><strong>Pagpapanatili ng Mababang Singil sa Tubig </strong>sa pamamagitan ng mahigpit na pangangasiwa sa badyet.</p><p dir=\"auto\"><strong>Si BILL COOPER </strong>patuloy na magsusumikap upang matiyak na palagi tayong mayroong maaasahang suplay ng <strong>mataas na kalidad </strong>na tubig sa isang <strong>makatwirang gastos </strong>at upang protektahan ang ating lambak mula sa tagtuyot sa hinaharap sa pamamagitan ng responsableng pagpaplano at pamamahala.</p><p dir=\"auto\">Muling Ihalal Si <strong>BILL COOPER </strong>ang Kandidato na may Karanasan</p><p dir=\"auto\">5 Taon <strong>Beterano ng Hukbong Dagat ng Estados Unidos </strong>naglilingkod sakay ng isang tagadala ng sasakyang panghimpapawid.</p>","VI":"<h1 dir=\"auto\" style=\"text-align: center\">BÀI PHÁT BIỂU CỦA BILL COOPER</h1><h2 dir=\"auto\" style=\"text-align: center\">ỨNG CỬ VIÊN CHO CHỨC VỤ THÀNH VIÊN, HỘI ĐỒNG GIÁM ĐỐC,<br dir=\"auto\">Phân Khu 1</h2><h3 dir=\"auto\" style=\"text-align: center\">CƠ QUAN THỦY CỤC SANTA CLARITA VALLEY</h3><p dir=\"auto\">Nghề Nghiệp: Phó Chủ Tịch Hội Đồng Cơ Quan Thủy Cục Santa Clarita Valley</p><p dir=\"auto\"><strong>BILL COOPER </strong>đã cống hiến toàn bộ sự nghiệp chuyên môn của mình cho lĩnh vực tài nguyên nước, quản lý hoạt động của cả năm nhà máy xử lý nước thuộc Metropolitan Water, cung cấp nước cho <strong>19 triệu </strong>người dân ở Nam California. Việc quản lý các cơ sở xử lý và phân phối nước quy mô lớn đã mang lại cho ông kinh nghiệm cần thiết để bảo vệ chất lượng và nguồn cung cấp nước tại địa phương chúng ta.</p><p dir=\"auto\">Việc cung cấp nước sạch, an toàn và giá cả phải chăng cho Santa Clarita Valley là điều thiết yếu đối với cộng đồng chúng ta và chất lượng cuộc sống mà chúng ta đang hưởng thụ.</p><p dir=\"auto\"><strong>BILL COOPER </strong>sẽ tiếp tục nỗ lực hướng tới quản lý nguồn nước có trách nhiệm bằng cách:</p><p dir=\"auto\"><strong>Tối Đa Hóa Nguồn Cung Hiện Có </strong>thông qua việc tái chế và bảo tồn;</p><p dir=\"auto\"><strong>Yêu Cầu Các Dự Án Phát Triển Mới </strong>phải có nguồn cung cấp nước rõ ràng trước khi xây dựng;</p><p dir=\"auto\"><strong>Thúc Đẩy Các Chương Trình Dự Trữ Nước Ngầm </strong>nhằm bảo đảm nguồn nước trong những năm hạn hán;</p><p dir=\"auto\"><strong>Loại Bỏ Chất Gây Ô Nhiễm </strong>đe dọa nguồn nước ngầm của chúng ta và buộc những người gây ô nhiễm phải trả tiền cho việc dọn dẹp;</p><p dir=\"auto\"><strong>Tìm Kiếm nguồn tài trợ Liên Bang và Tiểu Bang </strong>nhằm giảm chi phí cho các dự án tại địa phương;</p><p dir=\"auto\"><strong>Duy Trì Mức Giá Nước Thấp </strong>thông qua việc giám sát ngân sách chặt chẽ.</p><p dir=\"auto\"><strong>BILL COOPER </strong>sẽ tiếp tục nỗ lực để đảm bảo chúng ta luôn có nguồn cung cấp nước <strong>chất lượng cao </strong>, đáng tin cậy với <strong>chi phí hợp lý </strong>và bảo vệ thung lũng của chúng ta khỏi hạn hán trong tương lai thông qua quy hoạch và quản lý có trách nhiệm.</p><p dir=\"auto\">Hãy Bầu Cho <strong>BILL COOPER </strong>Ứng Cử Viên Giàu Kinh Nghiệm</p><p dir=\"auto\">Cựu Quân Nhân <strong>Hải Quân Hoa Kỳ</strong> với 5 năm phục vụ trên tàu sân bay.</p>","ZH":"<h1 dir=\"auto\" style=\"text-align: center\">BILL COOPER（比爾·庫珀）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">董事會委員候選人，<br dir=\"auto\">第1分區</h2><h3 dir=\"auto\" style=\"text-align: center\">SANTA CLARITA VALLEY 供水局</h3><p dir=\"auto\">職業：Santa Clarita Valley供水局委員會副主席</p><p dir=\"auto\"><strong>BILL COOPER</strong>職業生涯一直在處理管理全五座Metropolitan Water（大都會水質）處理廠的水資源，這些廠區為Southern California的<strong>1,900萬</strong>居民供水。管理大型水處理和輸水設施使他累積保護當地供水品質和供應能力所需的經驗。</p><p dir=\"auto\">可靠、安全且平價的供水對於Santa Clarita Valley社區和生活品質來說十分重要。</p><p dir=\"auto\"><strong>BILL COOPER </strong>將繼續努力實現負責任的水資源管理，方法如下：</p><p dir=\"auto\">透過回收和保護水資源確保<strong>最大限度地利用現有供水 </strong>；</p><p dir=\"auto\"><strong>要求新建案 </strong>開始施工前必須有可識別的水源；</p><p dir=\"auto\"><strong>推廣地下儲水計畫 </strong>以在乾旱年份供水；</p><p dir=\"auto\"><strong>去除威脅地下水的污染物</strong>，並要求污染者支付清理費用；</p><p dir=\"auto\"><strong>尋求聯邦和州政府</strong>補助金，降低當地計畫成本；</p><p dir=\"auto\">透過嚴格監督預算<strong>維持低廉水費</strong>。</p><p dir=\"auto\"><strong>BILL COOPER</strong>透過負責任規劃和管理確保我們的山谷始終擁有可靠的<strong>高品質</strong>、<strong>成本合理</strong>供水，免受未來乾旱影響。</p><p dir=\"auto\">懇請各位支持經驗豐富的候選人<strong>BILL COOPER</strong>連任</p><p dir=\"auto\">曾在航空母艦上服役5年的<strong>US海軍退伍軍人</strong>。</p>"},"CandidateID":"3D9","SequenceOrder":641}],"order":0,"isWriteIn":false,"isPresidential":false},{"id":"3DA","name":[{"BN":"নোয়া এম. রপ","CC":"諾亞·M.·羅普","EN":"NOAH M. ROPP","FA":"نوآ ام. راپ","GU":"નોહ એમ. રોપ","HI":"नोआ एम. रॉप","HY":"ՆՈԱ Մ․ ՌՈՓ","JA":"ノア・M.・ロップ","KM":"ណូអា អឹម. រ៉ប់","KO":"노아 M. 로프","MN":"НОА М. РОПП","MY":"နိုအာ အမ် ရော့ပ်","RU":"НОА М. РОПП","TE":"నోవా ఎమ్. రాప్","TH":"โนอาห์ เอ็ม. รอปป์","ZH":"諾亞·M.·羅普"}],"short_name":[{"EN":"NOAH M ROPP"}],"occupation":[{"BN":"কমিউনিটি পরিবেশ সংগঠক","CC":"社區環境組織者","EN":"Community Environmental Organizer","ES":"Organizador Ambiental Comunitario","FA":"سازمان‌دهنده اجتماع در امور زیست ‌محیطی","GU":"સમુદાય પર્યાવરણિય આયોજક","HI":"सामुदायिक पर्यावरणीय आयोजक","HY":"Բնապահպանական հարցերով համայնքային կազմակերպիչ","ID":"Organisator Lingkungan Komunitas","JA":"地域環境オーガナイザー","KM":"អ្នករៀបចំបរិស្ថានសហគមន៍","KO":"커뮤니티 환경 조직자","MN":"Олон нийтийн орчны зохион байгуулагч","MY":"ရပ်ရွာ သဘာဝပတ်ဝန်းကျင်ဆိုင်ရာ စည်းရုံးရေးမှူး","RU":"Общественный организатор экологических мероприятий","TE":"కమ్యూనిటీ పర్యావరణ ఆర్గనైజర్","TH":"นักจัดกิจกรรมสิ่งแวดล้อมชุมชน","TL":"Tagapagtatag ng Kapaligiran ng Komunidad","VI":"Người Tổ Chức Môi Trường Cộng Đồng","ZH":"社區環境組織者"}],"statements":[],"order":1,"isWriteIn":false,"isPresidential":false},{"id":"3TB","name":[{"BN":"রাইট-ইন(তালিকা বহির্ভূত)প্রার্থী","CC":"自填候選人","EN":"Write-In Candidate","ES":"Candidato por Escrito","FA":"کاندیدا خارج از لیست","GU":"અંદર લખવાના ઉમેદવાર","HI":"राइट–इन उम्मीदवार","HY":"Գրավոր առաջադրված թեկնածու","ID":"Calon Tidak Terdaftar dalam Surat Suara","JA":"記入候補者","KM":"បេក្ខជនសរសេរបញ្ចូលឈ្មោះ","KO":"기명 후보자","MN":"Бичигдэх нэр дэвшигч","MY":"ထပ်ဖြည့်သော ကိုယ်စားလှယ်လောင်း","RU":"Вписанный кандидат","TE":"రైట్-ఇన్ అభ్యర్ధి","TH":"ผู้สมัครรับเลือกตั้งแบบเขียนชื่อ","TL":"Isinusulat-lamang na Kandidato","VI":"Ứng Cử Viên Viết Tên Vào","ZH":"自填候選人"}],"short_name":[{"EN":"Write-In Candidate"}],"occupation":[null],"statements":[],"order":3,"isWriteIn":true,"isPresidential":false}],"statements":[]}