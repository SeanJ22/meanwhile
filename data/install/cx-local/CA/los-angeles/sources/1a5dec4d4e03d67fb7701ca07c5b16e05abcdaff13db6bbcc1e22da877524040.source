AS 5","JA":"DUARTE　統一学区-管役 管財5","KM":"មណ្ឌលសិក្សាធិការរួបរួម DUARTE - សមាជិកគណៈកម្មការគ្រប់គ្រង ប្រឹក្សាភិបាលតំបន់លេខ 5","KO":"DUARTE 통합교육구-이사회 이사 구역 번호5","MN":"DUARTE НЭГДСЭН СУР-УЗГ ИХ5","MY":"DUARTE စုကျောင်း-ချုပ်ဘုတ်ထိန်း 5","RU":"ОБЪЕД ШК DUARTE - ЧЛ УПР СОВ ПУ5","TE":"DUARTE ఏకీకృత స్కూలు గ బో స-ధ ప్రాం 5","TH":"ขรร. ร่วม DUARTE สคก. ทม. 5","TL":"PINAG-ISANG DIST PAARALAN DUARTE-MNL,Lugar ng Katiwala Blg 5","VI":"KHC THỐNG NHẤT DUARTE-UVHĐQT CQK5","ZH":"DUARTE聯合學區 - 管理委員會委員，第5託管區"},"short_description":{},"contest_class":"candidate_class","number_of_writeins":1,"vote_for_max":1,"vote_for_text":{"BN":"<b>এক</b>জনের পক্ষে ভোট দিন","CC":"請選 <b>一人</b>","EN":"Vote For <b>ONE</b>","ES":"Vote Por <b>UNO</b>","FA":"رای به <b>یک نفر</b>  ","GU":"<b>એક</b> માટે મત આપો","HI":"<b>एक</b> के लिए मतदान करें","HY":"Քվեարկեք <b>ՄԵԿԻ </b>Համար","ID":"PILIH <b>SATU</b>","JA":" <b>一人</b>に投票","KM":"បោះឆ្នោតអោយ <b>មួយ</b>","KO":"<b>한</b> 명까지만 투표하십시오","MN":"<b>НЭГ</b> санал өгнө үү","MY":"<b>တစ်ဦး</b>သာ မဲပေးပါ","RU":"Голосовать за <b>ОДНОГО</b> кандидата","TE":"<b>ఒకరికి</b> ఓటువేయండి","TH":"ออกเสียงลงคะแนนเลือกเพียง <b>หนึ่ง</b>  ชื่อ ","TL":"Bumoto Ng <b>ISA</b>","VI":"Bầu <b>MỘT</b> Người","ZH":"請選 <b>一人</b>"},"division":"D61","candidates":[{"id":"U5","name":[{"BN":"লিজবেথ অ্যাকুইনো","CC":"莉茲貝絲·阿奎諾","EN":"LIZBETH AQUINO","FA":"لیزبت آکینو","GU":"લિઝબેથ એક્વિનો","HI":"लिज़बेथ एक्विनो","HY":"ԼԻԶԲԵԹ ԱԿԻՆՈ","JA":"リズベス・アキノ","KM":"លីសបេត អាគីណូ","KO":"리즈베스 아퀴노","MN":"ЛИЗБЕТ АКУЙНО","MY":"လစ်ဇ်ဘသ် အကွီနို","RU":"ЛИЗБЕТ АКИНО","TE":"లిజ్‌బెత్ ఆక్వినో","TH":"ลิซเบธ อากีโน","ZH":"莉茲貝絲·阿奎諾"}],"short_name":[{"EN":"LIZBETH AQUINO"}],"occupation":[{"BN":"কমিউনিটি প্রোগ্রাম লিডার","CC":"社區計畫主管","EN":"Community Program Leader","ES":"Líder del Programa Comunitario","FA":"رهبر برنامه اجتماعی","GU":"સમુદાય કાર્યક્રમ​ આગેવાન","HI":"सामुदायिक कार्यक्रम नेत्री","HY":"Համայնքային ծրագրի ղեկավար","ID":"Pemimpin Program Komunitas","JA":"地域プログラムリーダー","KM":"អ្នកដឹកនាំកម្មវិធីសហគមន៍","KO":"커뮤니티 프로그램 지도자","MN":"Олон нийтийн хөтөлбөрийн удирдагч","MY":"ရပ်ရွာဆိုင်ရာ ပရိုဂရမ် ခေါင်းဆောင်","RU":"Руководитель общественных программ","TE":"కమ్యూనిటీ ప్రోగ్రామ్ లీడర్","TH":"ผู้นำโครงการชุมชน","TL":"Pinuno ng Programa ng Komunidad","VI":"Trưởng Nhóm Chương Trình Cộng Đồng","ZH":"社區計畫主管"}],"statements":[{"ID":"C0002614705E","FullHTML":{"BN":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO (লিজবেথ অ্যাকুইনো)-এর বিবৃতি</h1><h2 dir=\"auto\" style=\"text-align: center\">পরিচালনা পর্ষদের সদস্য প্রার্থী,<br dir=\"auto\">ট্রাস্টি এলাকা নং 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE ইউনিফায়েড স্কুল ডিস্ট্রিক্ট</h3><p dir=\"auto\">Duarte ইউনিফায়েড স্কুল ডিস্ট্রিক্টের একজন গর্বিত প্রাক্তন শিক্ষার্থী হিসেবে, আমি নিজ অভিজ্ঞতা থেকে জানি যে একটি শক্তিশালী সরকারি শিক্ষা ব্যবস্থা কীভাবে একজন শিক্ষার্থীর ভবিষ্যৎ গড়ে তুলতে পারে। Duarte-এর শ্রেণিকক্ষে অর্জিত শিক্ষা আমাকে আমার পরিবারের প্রথম কলেজ শিক্ষার্থী হিসেবে পড়াশোনা চালিয়ে যেতে এবং যে সমাজ আমাকে বড় হতে সাহায্য করেছে, তার সেবায় নিজের কর্মজীবন উৎসর্গ করতে অনুপ্রাণিত করেছে।</p><p dir=\"auto\">বহু বছর ধরে আমার কর্মজীবন জনসেবা এবং<strong> </strong>যুবক-যুবতী ও পরিবারবর্গের সঙ্গে সরাসরি কাজ করাকে কেন্দ্র করে গড়ে উঠেছে। আমি শিক্ষামূলক ও বিনোদনমূলক কর্মসূচির পরিকল্পনা ও ব্যবস্থাপনা করেছি, সামাজিক অংশীদারিত্ব গড়ে তুলেছি, সরকারি ফান্ড পরিচালনা করেছি, বৃহৎ পরিসরের সামাজিক অনুষ্ঠানের সমন্বয় করেছি এবং শিক্ষাবিদ, অভিভাবক, অলাভজনক সংস্থা, মানসিক স্বাস্থ্য পেশাজীবী, গ্রন্থাগার, স্থানীয় ব্যবসা প্রতিষ্ঠানসহ জননিরাপত্তা সংস্থাগুলোর পরিবারগুলোকে অর্থপূর্ণ সম্পদ ও সুযোগের সাথে সংযুক্ত করে বিভিন্ন ক্ষেত্রের মানুষের সাথে কাজ করেছি।</p><p dir=\"auto\">আমার অভিজ্ঞতা থেকে আমি শিখেছি যে, একটি শিক্ষা কর্তৃপক্ষের প্রতিটি সিদ্ধান্ত শ্রেণিকক্ষের গণ্ডি ছাড়িয়ে অনেক দূর পর্যন্ত বিস্তৃত। এটি পরিবার, শিক্ষক, কর্মচারী, এবং আমাদের কমিউনিটির ভবিষ্যৎকে প্রভাবিত করে। এটি আমাকে আরও দেখিয়েছে যে, সহযোগিতা, জবাবদিহিতা, স্বচ্ছতা, এবং দায়িত্বশীল নেতৃত্বের মাধ্যমেই শক্তিশালী স্কুল গড়ে ওঠে।</p><p dir=\"auto\">শিক্ষার্থীদের সাথে সরাসরি<strong> </strong>কাজ করার সুবাদে আমি তাদের অসাধারণ সম্ভাবনা এবং অনেক পরিবারের মুখোমুখি হওয়া প্রতিবন্ধকতা উভয়ই দেখতে পেয়েছি। আমি সব ধরনের সক্ষমতা সম্পন্ন শিশুদের সাথে কাজ করেছি, স্কুল-পরবর্তী ও নেতৃত্বদান কর্মসূচির মাধ্যমে কিশোর-কিশোরীদের সহায়তা করেছি, কঠিন পরিস্থিতিতে পরিবারগুলোর পাশে থেকেছি এবং এমন পরিবেশ তৈরিতে সাহায্য করেছি যেখানে তরুণ-তরুণীরা নিরাপদ, সমর্থিত এবং সফল হওয়ার জন্য ক্ষমতায়িত বোধ করে। পরিবারের প্রথম শিক্ষার্থী হিসেবে আমি বুঝি যে প্রত্যেক শিক্ষার্থীর পথচলা ভিন্ন হয়। পরিবারের আয়, পটভূমি বা পরিস্থিতি দিয়ে সাফল্য নির্ধারণ করা উচিত নয়। প্রতিটি শিশুরই উৎকৃষ্ট শিক্ষক, নিরাপদ স্কুল, আধুনিক শিক্ষার সুযোগ, সহশিক্ষা কার্যক্রম, এবং বিকাশের জন্য প্রয়োজনীয় প্রাতিষ্ঠানিক ও মানসিক সহায়তা পাওয়ার অধিকার রয়েছে। নির্বাচিত হলে, আমি অভিভাবকদের পক্ষে একজন বলিষ্ঠ কণ্ঠস্বর হিসেবে কাজ করব এবং তাদের সন্তানদের শিক্ষায় অর্থপূর্ণ অংশগ্রহণের সুযোগ নিশ্চিত করব। শিক্ষার্থীদের সফল হতে সাহায্য করার জন্য আমাদের শিক্ষক ও শ্রেণিবদ্ধ কর্মচারীদের প্রয়োজনীয় সরঞ্জাম, জনবল, এবং সম্পদ প্রদানে আমি সমর্থন জানাব। আমি আমাদের স্কুলগুলো এবং Duarte পরিবারগুলোকে ইতোমধ্যে সেবা প্রদানকারী সংস্থাগুলোর মধ্যে অংশীদারিত্ব জোরদার করার জন্যও কাজ করব, কারণ শিক্ষা শুধু শ্রেণীকক্ষের মধ্যেই সীমাবদ্ধ নয়।</p><p dir=\"auto\">নেতৃত্ব দেওয়ার আগে শোনাটাই হলো নেতৃত্ব।</p><p dir=\"auto\">Duarte ইউনিফায়েড-এর অসাধারণ সম্ভাবনা রয়েছে। আমি বিশ্বাস করি, যখন আমরা সততা ও শিক্ষার্থীদের সাফল্যের প্রতি অভিন্ন অঙ্গীকার নিয়ে একসঙ্গে কাজ করব, তখন আমাদের সেরা দিনগুলো সামনে আসবে।</p><p dir=\"auto\">আমি কোনও কিছু উপেক্ষা করছি না কারণ আমার কাছে সব উত্তর আছে। আমি নির্বাচনে প্রতিদ্বন্দ্বিতা করছি, কারণ আমি আমার কর্মজীবন অন্যের সেবায় উৎসর্গ করেছি। Duarte ইউনিফায়েড স্কুল ডিস্ট্রিক্ট বোর্ড অফ এডুকেশনে সেই একই দায়বদ্ধতা, অভিজ্ঞতা, এবং নেতৃত্ব নিয়ে আসতে পারলে আমি সম্মানিত বোধ করব।</p>","CC":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO（莉茲貝絲 · 阿奎諾）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理委員會委員候選人，<br dir=\"auto\">第5託管區</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE 聯合學區</h3><p dir=\"auto\">身為杜 Duarte 聯合學區的優秀畢業生，我親身見證完善的公立教育如何形塑學生的未來。我在 Duarte 校園習得的種種，促使身為第一代大學生的我繼續深造，並投身職涯服務培育我的這片社區。</p><p dir=\"auto\">多年以來，我的職涯始終圍繞公共服務，並直接與青年及家庭合作。我曾規劃、管理教育與休閒計畫，建立社區合作關係，管理公共經費，籌辦大型社區活動，並與教育工作者、家長、非營利組織、心理健康專業人員、圖書館、在地企業及公共安全單位協力，為家庭媒合實質可用的資源與發展機會。</p><p dir=\"auto\">自身經歷讓我體悟到，學區做出的每一項決策，影響層面遠不止於課堂之內。這會影響家長、教師、職員，以及我們社區的未來。這也讓我看見，優質學校是透過合作、問責、透明化治理與負責任的領導所建立。</p><p dir=\"auto\">親自與學生共事，讓我同時看見他們無限的潛能，以及許多家庭所面臨的難題。我曾服務各種學習能力的孩童，透過課後課程與領袖培育計畫陪伴青少年，在困境中與家庭攜手合作，並協助打造讓青少年感到安心、備受支持，且有能力邁向成功的成長環境。身為第一代大學生，我明白每位學生的求學之路都各不相同。成功與否，絕不該取決於家庭收入、背景或所處環境。每個孩子都應能接觸優秀師資、安全的校園、現代化學習資源、課外活動，以及茁壯成長所需的學業與情緒支援。如果當選，我將成為家長堅實的發聲後盾，確保家長擁有實質管道參與孩子的教育。我將為我們的教師和行政人員爭取權益，支援他們所需的工具、人員配備和資源，以幫助學生成功。我也會致力於強化學校與現有服務 Duarte 家庭之機構的合作關係，因為教育的範疇不僅限於課堂之內。</p><p dir=\"auto\">領導力在於先傾聽後領導。</p><p dir=\"auto\">Duarte 聯合學區擁有巨大的潛力。我相信，只要我們秉持誠信，齊心協力，共同致力於學生的成功，我們最美好的未來就在前方。</p><p dir=\"auto\">我參選，並非因為我握有所有答案。我參選，是因為我的職涯始終奉獻於服務他人。若能將這份相同的使命感、經歷與領導能力貢獻給 Duarte 聯合學區教育委員會，我將深感榮幸。</p>","EN":"<h1 dir=\"auto\" style=\"text-align: center\">STATEMENT OF LIZBETH AQUINO</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATE FOR GOVERNING BOARD MEMBER,<br dir=\"auto\">Trustee Area No. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE UNIFIED SCHOOL DISTRICT</h3><p dir=\"auto\">As a proud graduate of Duarte Unified School District, I know firsthand how a strong public education can shape a student's future. The lessons I learned in Duarte's classrooms inspired me to continue my education as a first-generation college student and dedicate my career to serving the community that helped raise me.</p><p dir=\"auto\">For years, my career has centered on public service and working directly with<strong> </strong>youth, and families. I have planned, managed educational and recreational programs, developed community partnerships, managed public funds, coordinated large-scale community events, and worked alongside educators, parents, nonprofit organizations, mental health professionals, libraries, local businesses, along<strong> </strong>public safety agencies to connect families with meaningful resources and opportunities.</p><p dir=\"auto\">My experience has taught me that every decision made by a school district is far beyond the classroom. It affects families, teachers, employees, and the future of our community. It has also shown me that strong schools are built through collaboration, accountability, transparency, and responsible leadership.</p><p dir=\"auto\">Working directly with students has<strong> </strong>allowed me to see both their incredible potential and the challenges many families face. I have worked with children of all abilities, supported teens through after-school and leadership programs, partnered with families during difficult situations, and helped create environments where youth feel safe, supported, and empowered to succeed. As a first-generation college student, I understand that every student's path looks different. Success should never be determined by a family's income, background, or circumstances. Every child deserves access to excellent teachers, safe schools, modern learning opportunities, extracurricular activities, the academic and emotional support needed to thrive. If elected, I will be a strong voice for parents by ensuring they have meaningful opportunities to participate in their children's education. I will advocate for our teachers and classified employees by supporting the tools, staffing, and resources they need to help students succeed. I will also work to strengthen partnerships between our schools and the organizations that already serve Duarte families because education extends beyond the classroom.</p><p dir=\"auto\">Leadership is about listening before leading.</p><p dir=\"auto\"> Duarte Unified has incredible potential. I believe our best days are ahead of us when we work together with integrity, and a shared commitment to student success.</p><p dir=\"auto\">I am not running because I have all the answers. I am running because I have dedicated my career to serving others. I would be honored to bring that same commitment, experience, and leadership to the Duarte Unified School District Board of Education.</p><p><br /></p><h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE LIZBETH AQUINO</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATA PARA MIEMBRO DE LA JUNTA GUBERNATIVA,<br dir=\"auto\">Área Sindical N.° 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DISTRITO ESCOLAR UNIFICADO DE DUARTE</h3><p dir=\"auto\">Como orgullosa egresada del Distrito Escolar Unificado de Duarte, sé de primera mano cómo una sólida educación pública puede moldear el futuro de un estudiante. Las lecciones que aprendí en las clases de Duarte me inspiraron a continuar mi educación como estudiante del colegio de primera generación y a dedicar mi carrera a servir a la comunidad que me ayudó a crecer.</p><p dir=\"auto\">Durante años, mi carrera se ha centrado en el servicio público y en trabajar directamente con<strong> </strong>los jóvenes y las familias. He planificado y gestionado programas educativos y recreativos, desarrollado asociaciones comunitarias, gestionado fondos públicos, coordinado eventos comunitarios a gran escala y trabajado junto a educadores, padres, organizaciones sin fines de lucro, profesionales de la salud mental, bibliotecas, empresas locales, junto con<strong> </strong>agencias de seguridad pública para conectar a las familias con recursos y oportunidades valiosos.</p><p dir=\"auto\">Mi experiencia me ha enseñado que cada decisión que toma un distrito escolar va mucho más allá del aula. Afecta a las familias, a los maestros, a los empleados y al futuro de nuestra comunidad. También me ha demostrado que las escuelas sólidas se construyen mediante la colaboración, la rendición de cuentas, la transparencia y un liderazgo responsable.</p><p dir=\"auto\">Trabajar directamente con los estudiantes me ha<strong> </strong>permitido apreciar tanto su increíble potencial como los desafíos a los que se enfrentan muchas familias. He trabajado con niños de todas las capacidades, he apoyado a adolescentes a través de programas extraescolares y de liderazgo, he colaborado con familias en situaciones difíciles y he ayudado a crear entornos donde los jóvenes se sientan seguros, apoyados y capacitados para tener éxito. Como estudiante del colegio de primera generación, entiendo que el camino de cada estudiante es diferente. El éxito nunca debería estar determinado por los ingresos, los antecedentes o las circunstancias de una familia. Todos los niños merecen tener acceso a excelentes maestros, escuelas seguras, oportunidades de aprendizaje modernas, actividades extracurriculares y el apoyo académico y emocional necesario para prosperar. Si resulto elegida, seré una firme defensora de los padres, garantizando que tengan oportunidades significativas para participar en la educación de sus hijos. Defenderé a nuestros maestros y empleados administrativos apoyando las herramientas, el personal y los recursos que necesitan para ayudar a los estudiantes a tener éxito. También trabajaré para fortalecer las alianzas entre nuestras escuelas y las organizaciones que ya prestan servicios a las familias de Duarte, porque la educación va más allá del aula.</p><p dir=\"auto\">El liderazgo consiste en escuchar antes de liderar.</p><p dir=\"auto\"> El Unificado de Duarte tiene un potencial increíble. Creo que nuestros mejores días están por venir cuando trabajamos juntos con integridad y un compromiso compartido con el éxito de los estudiantes.</p><p dir=\"auto\">No me postulo porque tenga todas las respuestas. Me postulo porque he dedicado mi carrera a servir a los demás. Sería un honor para mí aportar ese mismo compromiso, experiencia y liderazgo a la Junta de Educación del Distrito Escolar Unificado de Duarte.</p>\n","ES":"<h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE LIZBETH AQUINO</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATA PARA MIEMBRO DE LA JUNTA GUBERNATIVA,<br dir=\"auto\">Área Sindical N.° 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DISTRITO ESCOLAR UNIFICADO DE DUARTE</h3><p dir=\"auto\">Como orgullosa egresada del Distrito Escolar Unificado de Duarte, sé de primera mano cómo una sólida educación pública puede moldear el futuro de un estudiante. Las lecciones que aprendí en las clases de Duarte me inspiraron a continuar mi educación como estudiante del colegio de primera generación y a dedicar mi carrera a servir a la comunidad que me ayudó a crecer.</p><p dir=\"auto\">Durante años, mi carrera se ha centrado en el servicio público y en trabajar directamente con<strong> </strong>los jóvenes y las familias. He planificado y gestionado programas educativos y recreativos, desarrollado asociaciones comunitarias, gestionado fondos públicos, coordinado eventos comunitarios a gran escala y trabajado junto a educadores, padres, organizaciones sin fines de lucro, profesionales de la salud mental, bibliotecas, empresas locales, junto con<strong> </strong>agencias de seguridad pública para conectar a las familias con recursos y oportunidades valiosos.</p><p dir=\"auto\">Mi experiencia me ha enseñado que cada decisión que toma un distrito escolar va mucho más allá del aula. Afecta a las familias, a los maestros, a los empleados y al futuro de nuestra comunidad. También me ha demostrado que las escuelas sólidas se construyen mediante la colaboración, la rendición de cuentas, la transparencia y un liderazgo responsable.</p><p dir=\"auto\">Trabajar directamente con los estudiantes me ha<strong> </strong>permitido apreciar tanto su increíble potencial como los desafíos a los que se enfrentan muchas familias. He trabajado con niños de todas las capacidades, he apoyado a adolescentes a través de programas extraescolares y de liderazgo, he colaborado con familias en situaciones difíciles y he ayudado a crear entornos donde los jóvenes se sientan seguros, apoyados y capacitados para tener éxito. Como estudiante del colegio de primera generación, entiendo que el camino de cada estudiante es diferente. El éxito nunca debería estar determinado por los ingresos, los antecedentes o las circunstancias de una familia. Todos los niños merecen tener acceso a excelentes maestros, escuelas seguras, oportunidades de aprendizaje modernas, actividades extracurriculares y el apoyo académico y emocional necesario para prosperar. Si resulto elegida, seré una firme defensora de los padres, garantizando que tengan oportunidades significativas para participar en la educación de sus hijos. Defenderé a nuestros maestros y empleados administrativos apoyando las herramientas, el personal y los recursos que necesitan para ayudar a los estudiantes a tener éxito. También trabajaré para fortalecer las alianzas entre nuestras escuelas y las organizaciones que ya prestan servicios a las familias de Duarte, porque la educación va más allá del aula.</p><p dir=\"auto\">El liderazgo consiste en escuchar antes de liderar.</p><p dir=\"auto\"> El Unificado de Duarte tiene un potencial increíble. Creo que nuestros mejores días están por venir cuando trabajamos juntos con integridad y un compromiso compartido con el éxito de los estudiantes.</p><p dir=\"auto\">No me postulo porque tenga todas las respuestas. Me postulo porque he dedicado mi carrera a servir a los demás. Sería un honor para mí aportar ese mismo compromiso, experiencia y liderazgo a la Junta de Educación del Distrito Escolar Unificado de Duarte.</p>\n","FA":"<h1 dir=\"rtl\" style=\"text-align: center\">بیانیه LIZBETH AQUINO (لیزبت آکینو)</h1><h2 dir=\"rtl\" style=\"text-align: center\">کاندیدا برای عضو هیئت حاکمه،<br dir=\"auto\">امین منطقه شماره 5</h2><h3 dir=\"rtl\" style=\"text-align: center\">اتحاد ناحیه مدارس DUARTE</h3><p dir=\"rtl\">من به عنوان یک فارغ‌ التحصیل مفتخر اتحاد ناحیه مدارس Duarte، به خوبی می‌دانم که یک آموزش عمومی قوی چگونه می‌تواند آینده یک دانش‌آموز را شکل دهد. درس‌هایی که در کلاس‌های درس Duarte آموختم، الهام‌بخش من شد تا به‌عنوان نخستین فرد در خانواده‌ام که وارد دانشگاه می‌شود، تحصیلاتم را ادامه دهم و حرفه‌ام را وقف خدمت به جامعه‌ای کنم که در پرورش من نقش داشته است.</p><p dir=\"rtl\">سال‌هاست که حرفه من بر خدمات عمومی و همکاری مستقیم با جوانان، و خانواده‌ها متمرکز بوده است. من برنامه‌های آموزشی و تفریحی را برنامه‌ ریزی و مدیریت کرده‌ام، مشارکت‌های اجتماعی ایجاد کرده‌ام، بودجه‌های عمومی را مدیریت کرده‌ام، رویدادهای اجتماعی در مقیاس بزرگ را هماهنگ کرده‌ام و در کنار مربیان، والدین، سازمان‌های غیرانتفاعی، متخصصان سلامت روان، کتابخانه‌ها، کسب‌وکارهای محلی،<strong> </strong>سازمان‌های امنیت عمومی کار کرده‌ام تا خانواده‌ها را به منابع و فرصت‌های مفید معرفی کنم.</p><p dir=\"rtl\">تجربه به من آموخته است که هر تصمیمی که توسط یک ناحیه مدارس شهر گرفته می‌شود، بسیار فراتر از کلاس درس است. این تصمیمات بر خانواده‌ها، معلمان، کارمندان و آینده جامعه ما تأثیر می‌گذارد. همچنین به من نشان داده است که مدارس قوی از طریق همکاری، پاسخگویی، شفافیت و رهبری مسئولانه شکل می‌گیرند.</p><p dir=\"rtl\">کار مستقیم با دانشجویان<strong> </strong>به من اجازه داد تا هم پتانسیل باورنکردنی آنها و هم چالش‌هایی را که بسیاری از خانواده‌ها با آن مواجه هستند را بفهمم. من با کودکانی در هر سطح توانایی کار کرده‌ام، از نوجوانان در برنامه‌های فوق برنامه و مدیریتی حمایت کرده‌ام، در شرایط دشوار با خانواده‌ها همکاری داشته‌ام و به ایجاد محیط‌هایی کمک کرده‌ام که در آنها جوانان احساس امنیت، حمایت و توانمندی برای کسب موفقیت داشته باشند. به‌عنوان نخستین فرد در خانواده‌ام که به دانشگاه راه یافته‌ام، درک می‌کنم که مسیر تحصیلی هر دانش‌آموز متفاوت است. درآمد، پیشینه یا شرایط خانواده هرگز نباید تعیین کننده موفقیت باشد. هر کودکی سزاوار دسترسی به معلمان عالی، مدارس امن، فرصت‌های یادگیری مدرن، فعالیت‌های فوق برنامه و حمایت تحصیلی و عاطفی مورد نیاز برای رشد و شکوفایی است. اگر انتخاب شوم، با ایجاد فرصت‌های مفید برای مشارکت والدین در آموزش فرزندانشان، صدای رسای آنها خواهم بود. من از معلمان و پرسنل غیرآموزشی ناحیه حمایت خواهم کرد و از تأمین ابزارها، نیروی انسانی و منابع موردنیاز آنان برای کمک به موفقیت دانش‌آموزان پشتیبانی خواهم کرد. من همچنین در جهت تقویت همکاری بین مدارس و سازمان‌هایی که در حال حاضر به خانواده‌های Duarte خدمت‌ رسانی می‌کنند تلاش خواهم کرد، زیرا آموزش فراتر از کلاس درس است.</p><p dir=\"rtl\">رهبری یعنی گوش دادن قبل از رهبری کردن.</p><p dir=\"rtl\">Duarte Unified یک پتانسیل فوق‌العاده دارد. من معتقدم زمانی که با صداقت و تعهد مشترک به موفقیت دانش‌آموزان با هم همکاری کنیم، بهترین روزها در انتظارمان خواهد بود.</p><p dir=\"rtl\">من برای این کاندید نشده‌ام که فکر می‌کنم پاسخ همه سؤالات را می‌دانم. من به این علت کاندید شده‌ام که تمام مسیر حرفه‌ای خود را وقف خدمت به دیگران کرده‌ام. باعث افتخار من خواهد بود که همین تعهد، تجربه و رهبری را به هیئت آموزش و پرورش اتحاد ناحیه مدارس Duarte منتقل کنم.</p>","GU":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO (લિઝબેથ એક્વિનો) નું નિવેદન</h1><h2 dir=\"auto\" style=\"text-align: center\">સંચાલક મંડળ સભ્ય માટેના ઉમેદવાર,<br dir=\"auto\">ટ્રસ્ટી એરિયા નં. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE એકીકૃત શાળા જિલ્લો</h3><p dir=\"auto\">Duarte એકીકૃત શાળા જિલ્લાની ગૌરવશાળી ભૂતપૂર્વ સ્નાતકની તરીકે, હું પોતે જાણું છું કે મજબૂત સરકારી શિક્ષણ વિદ્યાર્થીના ભવિષ્યને કેવી રીતે સારું બનાવી શકે છે. Duarteના વગૅખંડઓમાં મને મળેલા શિક્ષણએ મને આગળ અભ્યાસ કરવા માટે પ્રેરણા આપી. હું મહાવિદ્યાલયમાં ભણનારી પ્રથમ વ્યક્તિ બની અને જે સમુદાયે મને ઉછેરવામાં મદદ કરી, તેની સેવા કરવા માટે મેં મારી કારકિર્દી સમર્પિત કરી.</p><p dir=\"auto\">વર્ષોથી મારી કારકિર્દીનો મુખ્ય હેતુ લોકોની સેવા કરવાનો અને<strong> </strong>યુવાનો, તથા પરિવારો સાથે સીધું કામ કરવું રહ્યો છે. મેં, શૈક્ષણિક અને મનોરંજનના કાર્યક્રમોનું આયોજન અને સંચાલન કર્યું છ. મેં સમુદાય સાથે ભાગીદારી વિકસાવી છે, સરકારી નાણાંનું યોગ્ય સંચાલન કર્યું છે, મોટા પાયે યોજાતા સામુદાયિક કાર્યક્રમોનું આયોજન કર્યું છે, અને મેં શિક્ષકો, માતા-પિતાઓ, સામાજિક સંસ્થાઓ, માનસિક આરોગ્યના નિષ્ણાતો, પુસ્તકાલયો, સ્થાનિક વ્યવસાયો,<strong> </strong>જાહેર સુરક્ષા વિભાગો સાથે મળીને કામ કર્યું છે, જેથી પરિવારોને જરૂરી સંસાધનો અને સારી તકો મળી શકે.</p><p dir=\"auto\">મારા અનુભવથી મને શીખવા મળ્યું છે કે શાળા જિલ્લો દ્વારા લેવામાં આવતો દરેક નિર્ણય માત્ર વર્ગખંડ પૂરતો મર્યાદિત નથી. તેની અસર પરિવારો, શિક્ષકો, શાળાના કર્મચારીઓ, અને આપણા સમગ્ર સમુદાયના ભવિષ્ય પર પડે છે. મારા અનુભવથી મને એ પણ સમજાયું છે કે મજબૂત શાળાઓ સહકાર, જવાબદારી, પારદર્શિતા અને જવાબદાર નેતૃત્વથી બને છે.</p><p dir=\"auto\">વિદ્યાર્થીઓ સાથે સીધું કામ કરવાથી<strong> </strong>મને તેમની અદ્ભુત ક્ષમતાઓ તેમજ ઘણા પરિવારો જે મુશ્કેલીઓનો સામનો કરે છે, તે બંનેને નજીકથી સમજવાની તક મળી છે. મેં વિવિધ ક્ષમતાઓ ધરાવતા બાળકો સાથે કામ કર્યું છે, શાળા પછીના કાર્યક્રમો અને નેતૃત્વના કાર્યક્રમોમાં કિશોરોને મદદ કરી છે, મુશ્કેલ પરિસ્થિતિમાં પરિવારો સાથે મળીને કામ કર્યું છે, અને એવું વાતાવરણ બનાવવામાં મદદ કરી છે જ્યાં યુવાનો સુરક્ષિત, સહાયક, અને આત્મવિશ્વાસથી આગળ વધીને સફળ થઈ શકે. હું મારા પરિવારમાંથી મહાવિદ્યાલયમાં ભણનારી પ્રથમ વ્યક્તિ હોવાથી, હું સમજું છું કે દરેક વિદ્યાર્થીની આગળ વધવાની સફર અલગ હોય છે. વિદ્યાર્થીની સફળતા તેના પરિવારની આવક, પૃષ્ઠભૂમિ, કે પરિસ્થિતિના આધારે નક્કી થવી જોઈએ નહીં. દરેક બાળકને સારા શિક્ષકો, સુરક્ષિત શાળાઓ, આધુનિક શિક્ષણની તકો, અભ્યાસેતર પ્રવૃત્તિઓ, અને આગળ વધવા માટે જરૂરી શૈક્ષણિક તથા ભાવનાત્મક સહાય મળવી જોઈએ. જો હું ચૂંટાઈશ, તો હું વાલીઓ માટે મજબૂત અવાજ બનીશ અને એ સુનિશ્ચિત કરીશ કે તેમને તેમના બાળકોના શિક્ષણમાં સક્રિય રીતે ભાગ લેવાની સારી અને યોગ્ય તકો મળે. હું આપણા શિક્ષકો અને અન્ય શાળાના કર્મચારીઓ માટે મજબૂત રીતે અવાજ ઉઠાવીશ અને વિદ્યાર્થીઓને સફળ બનાવવામાં મદદરૂપ થાય તે માટે તેમને જરૂરી સાધનો, પૂરતો કર્મચારી, અને જરૂરી સંસાધનો મળી રહે તે માટે પ્રયત્ન કરીશ. હું આપણી શાળાઓ અને Duarte ના પરિવારો માટે પહેલેથી જ કામ કરતી સંસ્થાઓ વચ્ચેના સંબંધોને વધુ મજબૂત બનાવવાનો પ્રયત્ન કરીશ, કારણ કે શિક્ષણ માત્ર વર્ગખંડ પૂરતું મર્યાદિત નથી.</p><p dir=\"auto\">નેતૃત્વ એટલે આગળ વધીને નેતૃત્વ કરતા પહેલાં લોકોની વાત ધ્યાનથી સાંભળવી.</p><p dir=\"auto\">Duarte એકીકૃત શાળામાં ઘણી મોટી ક્ષમતા છે. મને વિશ્વાસ છે કે જ્યારે આપણે ઈમાનદારીથી, અને વિદ્યાર્થીઓની સફળતા માટે એકસાથે મળીને કામ કરીશું, ત્યારે આપણા આવનારા દિવસો વધુ સારા રહેશે.</p><p dir=\"auto\">હું ચૂંટણી લડું છું કારણ કે મારી પાસે દરેક પ્રશ્નનો જવાબ છે એવું નથી. હું ચૂંટણી લડું છું કારણ કે મેં મારી આખી કારકિર્દી લોકોની સેવા કરવા માટે સમર્પિત કરી છે. મને ગૌરવ થશે કે એ જ સમર્પણ, અનુભવ, અને નેતૃત્વ સાથે Duarte એકીકૃત શાળા જિલ્લા શિક્ષણ  મંડળમાં સેવા આપવાની તક મળે.</p><p dir=\"auto\"></p><p dir=\"auto\"></p><p dir=\"auto\"></p><p dir=\"auto\"></p>","HI":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO (लिज़बेथ एक्विनो) का वक्तव्य</h1><h2 dir=\"auto\" style=\"text-align: center\">गवर्निंग बोर्ड सदस्या के लिए उम्मीदवार,<br dir=\"auto\">ट्रस्टी क्षेत्र सं. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE एकीकृत स्कूल जिला</h3><p dir=\"auto\">Duarte एकीकृत स्कूल जिला के एक गौरवान्वित स्नातक के रूप में, मैं प्रत्यक्ष रूप से जानता हूँ कि एक मजबूत सार्वजनिक शिक्षा एक छात्र के भविष्य को कैसे आकार दे सकती है। Duarte की कक्षाओं में मैंने जो सीख हासिल की, उसने मुझे पहली पीढ़ी के कॉलेज विद्यार्थी के रूप में अपनी शिक्षा जारी रखने और अपने करियर को उस समुदाय की सेवा के लिए समर्पित करने की प्रेरणा दी, जो समुदाय ने मुझे बड़ा होने में सहयोग दिया।”</p><p dir=\"auto\">वर्षों से, मेरा करियर सार्वजनिक सेवा और सीधे तौर पर<strong> </strong>युवाओं और परिवारों के साथ काम करने पर केंद्रित रहा है। मैंने शैक्षणिक और मनोरंजक कार्यक्रमों की योजना बनाई और उनका प्रबंधन किया है, सामुदायिक साझेदारियां विकसित की हैं, सार्वजनिक फंडों का प्रबंधन किया है, बड़े पैमाने पर सामुदायिक कार्यक्रमों का समन्वय किया है, और परिवारों को सार्थक संसाधनों तथा अवसरों से जोड़ने के लिए अध्यापकों, अभिभावकों, गैर-लाभकारी संगठनों, मानसिक स्वास्थ्य पेशेवरों, पुस्तकालयों, स्थानीय व्यवसायों और<strong> </strong>सार्वजनिक सुरक्षा एजेंसियों के साथ मिलकर काम किया है।</p><p dir=\"auto\">मेरे अनुभव ने मुझे सिखाया है कि स्कूल जिला द्वारा लिया गया हर निर्णय कक्षा तक ही सीमित नहीं होता। इसका असर परिवारों, अध्यापकों, कर्मचारियों और हमारे समुदाय के भविष्य पर पड़ता है। इससे मुझे यह भी पता चला है कि मजबूत स्कूल सहयोग, जवाबदेही, पारदर्शिता और जिम्मेदार नेतृत्व के माध्यम से बनते हैं।</p><p dir=\"auto\">छात्रों के साथ सीधे काम करने से<strong> </strong>मुझे उनकी असाधारण क्षमता और कई परिवारों के सामने आने वाली चुनौतियों दोनों को देखने का मौका मिला। मैंने हर तरह की क्षमताओं वाले बच्चों के साथ काम किया है, स्कूल के बाद के कार्यक्रमों और नेतृत्व कार्यक्रमों के माध्यम से किशोरों का समर्थन किया है, कठिन परिस्थितियों के दौरान परिवारों के साथ साझेदारी की है, और ऐसे वातावरण बनाने में मदद की है जहां युवा सुरक्षित, समर्थित और सफल होने के लिए सशक्त महसूस करते हैं। अपने परिवार में कॉलेज जाने वाली पहली छात्रा होने के नाते, मैं समझती हूँ कि हर छात्र का रास्ता अलग होता है। किसी परिवार की आय, पृष्ठभूमि या परिस्थितियों के आधार पर सफलता का निर्धारण कभी नहीं किया जाना चाहिए। हर बच्चे को बेहतरीन अध्यापकों सुरक्षित स्कूलों, आधुनिक शिक्षण अवसरों, पाठ्येतर गतिविधियों और आगे बढ़ने के लिए आवश्यक शैक्षणिक और भावनात्मक समर्थन तक पहुँच का अधिकार है। यदि मैं निर्वाचित होती हूँ, तो मैं यह सुनिश्चित करके अभिभावकों के लिए एक सशक्त आवाज बनूँगी कि उन्हें अपने बच्चों की शिक्षा में सार्थक रूप से भाग लेने के अवसर मिलें। मैं छात्रों की सफलता में सहायता करने के लिए आवश्यक उपकरणों, कर्मचारियों और संसाधनों का समर्थन करके हमारे शिक्षकों और वर्गीकृत कर्मचारियों की वकालत करूँगी। मैं हमारे स्कूलों और उन संगठनों के बीच साझेदारी को मजबूत करने के लिए भी काम करूँगी जो पहले से ही Duarte परिवारों की सेवा कर रहे हैं क्योंकि शिक्षा कक्षा तक ही सीमित नहीं है।</p><p dir=\"auto\">नेतृत्व का मतलब नेतृत्व करने से पहले सुनना है।</p><p dir=\"auto\">Duarte एकीकृत में अपार संभावनाएं हैं। मुझे विश्वास है कि जब हम ईमानदारी और छात्रों की सफलता के प्रति साझा प्रतिबद्धता के साथ मिलकर काम करेंगे, तो हमारे सबसे अच्छे दिन हमारे सामने होंगे।</p><p dir=\"auto\">मैं इसलिए चुनाव नहीं लड़ रही हूँ क्योंकि मेरे पास सभी सवालों के जवाब हैं। मैं चुनाव लड़ रही हूँ क्योंकि मैंने अपना पूरा करियर दूसरों की सेवा के लिए समर्पित किया है। मुझे Duarte एकीकृत स्कूल जिला शिक्षा बोर्ड में वही प्रतिबद्धता, अनुभव और नेतृत्व लाने का सम्मान प्राप्त होगा।</p>","HY":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO-Ի (ԼԻԶԲԵԹ ԱԿԻՆՈ) ՀԱՅՏԱՐԱՐՈՒԹՅՈՒՆԸ</h1><h2 dir=\"auto\" style=\"text-align: center\">ԿԱՌԱՎԱՐՄԱՆ ԽՈՐՀՐԴԻ ԱՆԴԱՄԻ ԹԵԿՆԱԾՈՒ,<br dir=\"auto\">Հոգաբարձու գոտի համար 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE ՄԻԱՑՅԱԼ ԴՊՐՈՑԱԿԱՆ ՇՐՋԱՆ</h3><p dir=\"auto\">Որպես Duarte-ի միացյալ դպրոցական շրջանի հպարտ շրջանավարտ, ես անձամբ գիտեմ, թե ինչպես կարող է ուժեղ հանրային կրթությունը ձևավորել աշակերտի ապագան։ Duarte-ի դասարաններում սովորած դասերը ոգեշնչեցին ինձ շարունակել կրթությունս որպես առաջին սերնդի քոլեջի ուսանող և նվիրել իմ կարիերան այն համայնքին ծառայելուն, որն օգնել է ինձ մեծանալ։</p><p dir=\"auto\">Տարիներ շարունակ իմ կարիերան կենտրոնացած է եղել հանրային ծառայության և անմիջականորեն<strong> </strong>երիտասարդության և ընտանիքների հետ աշխատելու վրա։ Ես պլանավորել և կառավարել եմ կրթական և ժամանցային ծրագրեր, մշակել եմ համայնքային գործընկերություններ, կառավարել եմ հանրային միջոցներ, համակարգել եմ լայնածավալ համայնքային միջոցառումներ և աշխատել եմ մանկավարժների, ծնողների, հասարակական կազմակերպությունների, հոգեկան առողջության մասնագետների, գրադարանների, տեղական բիզնեսների,<strong> </strong>հանրային անվտանգության գործակալությունների հետ համագործակցությամբ՝ ընտանիքներին տրամադրելու իմաստալից ռեսուրսներ և հնարավորություններ:</p><p dir=\"auto\">Իմ փորձը ինձ սովորեցրել է, որ դպրոցական շրջանի կողմից կայացված յուրաքանչյուր որոշում դուրս է գալիս դասարանի սահմաններից։ Այն ազդում է ընտանիքների, ուսուցիչների, աշխատակիցների և մեր համայնքի ապագայի վրա։ Այն նաև ցույց տվեց ինձ, որ ուժեղ դպրոցները կառուցվում են համագործակցության, հաշվետվողականության, թափանցիկության և պատասխանատու ղեկավարության հիման վրա։</p><p dir=\"auto\">Աշակերտների հետ անմիջականորեն աշխատելը թույլ<strong> </strong>տվեց ինձ տեսնել թե՛ նրանց անհավանական ներուժը, թե՛ այն մարտահրավերները, որոնց բախվում են շատ ընտանիքներ։ Ես աշխատել եմ տարբեր կարողությունների տեր երեխաների հետ, աջակցել եմ դեռահասներին հետդպրոցական և առաջնորդության ծրագրերի միջոցով, համագործակցել եմ ընտանիքների հետ դժվարին իրավիճակներում և օգնել եմ ստեղծել այնպիսի միջավայր, որտեղ երիտասարդներն իրենց ապահով կզգան, աջակցություն կստանան և հաջողության հասնելու հնարավորություն կունենան: Որպես առաջին սերնդի քոլեջի ուսանող, ես հասկանում եմ, որ յուրաքանչյուր ուսանողի ուղին տարբեր է։ Հաջողությունը երբեք չպետք է որոշվի ընտանիքի եկամտով, ծագմամբ կամ հանգամանքներով։ Յուրաքանչյուր երեխա արժանի է գերազանց ուսուցիչների, անվտանգ դպրոցների, ժամանակակից ուսումնական հնարավորությունների, արտադասարանական գործունեության, զարգանալու համար անհրաժեշտ ակադեմիական և հուզական աջակցության հասանելիության։ Եթե ընտրվեմ, ես կլինեմ ծնողների հզոր ձայնը՝ ապահովելով, որ նրանք ունենան իրենց երեխաների կրթությանը մասնակցելու իրական հնարավորություններ։ Ես կպաշտպանեմ մեր ուսուցիչներին և ոչ ուսուցչական անձնակազմի աշխատակիցներին՝ աջակցելով գործիքներին, կադրային ապահովմանը և ռեսուրսներին, որոնք նրանց անհրաժեշտ են աշակերտներին հաջողության հասցնելու համար։ Ես նաև կաշխատեմ ամրապնդել մեր դպրոցների և Duarte-ի ընտանիքներին արդեն իսկ սպասարկող կազմակերպությունների միջև գործընկերությունը, քանի որ կրթությունը դուրս է գալիս դասարանի սահմաններից:</p><p dir=\"auto\">Առաջնորդությունը նշանակում է լսել նախքան առաջնորդելը։</p><p dir=\"auto\">Duarte-ի միացյալ դպրոցական շրջանն անհավանական ներուժ ունի։ Ես հավատում եմ, որ մեր լավագույն օրերը դեռ առջևում են, երբ մենք միասին աշխատում ենք ազնվությամբ և աշակերտների հաջողության համար միասնական նվիրվածությամբ։</p><p dir=\"auto\">Ես չեմ առաջադրվում, որովհետև ունեմ բոլոր պատասխանները։ Ես առաջադրվում եմ, քանի որ իմ կարիերան նվիրել եմ ուրիշներին ծառայելուն։ Ինձ համար պատիվ կլինի նույն նվիրվածությունը, փորձը և առաջնորդությունը բերել Duarte-ի միացյալ դպրոցական շրջանի կրթության խորհրդ։</p>","ID":"<h1 dir=\"auto\" style=\"text-align: center\">PERNYATAAN LIZBETH AQUINO</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDAT UNTUK ANGGOTA DEWAN PENGURUS,<br dir=\"auto\">Daerah Pengawas No. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DISTRIK SEKOLAH TERPADU DUARTE</h3><p dir=\"auto\">Sebagai lulusan yang bangga dari Distrik Sekolah Terpadu Duarte, saya paham betul bagaimana pendidikan publik yang kuat dapat membentuk masa depan seorang siswa. Pelajaran yang saya dapatkan selama bersekolah di Duarte menginspirasi saya untuk melanjutkan pendidikan sebagai mahasiswa generasi pertama di keluarga saya dan mengabdikan karier saya untuk melayani masyarakat yang telah membesarkan saya.</p><p dir=\"auto\">Selama bertahun-tahun, karier saya berfokus pada pelayanan publik dan bekerja secara langsung dengan<strong> </strong>anak muda, dan keluarga. Saya telah merencanakan, mengelola program pendidikan dan rekreasi, mengembangkan kemitraan masyarakat, mengelola dana publik, mengoordinasikan kegiatan masyarakat berskala besar, dan bekerja sama dengan para pendidik, orang tua, organisasi-organisai nirlaba, tenaga kerja kesehatan mental, perpustakaan, pelaku usaha lokal, dan<strong> </strong>lembaga keamanan publik untuk menghubungkan keluarga dengan sumber daya dan peluang yang bermakna.</p><p dir=\"auto\">Pengalaman saya mengajarkan bahwa setiap keputusan yang diambil oleh distrik sekolah berdampak jauh melampaui ruang kelas. Keputusan tersebut berdampak pada para keluarga, guru, karyawan, dan masa depan masyarakat kita. Pengalaman ini juga menunjukkan kepada saya bahwa sekolah yang kuat dibangun melalui kerja sama, pertanggungjawaban, transparansi, dan kepemimpinan yang bertanggung jawab.</p><p dir=\"auto\">Dengan bekerja langsung dengan siswa<strong> </strong>saya dapat melihat potensi mereka yang luar biasa sekaligus tantangan yang dihadapi banyak keluarga. Saya telah bekerja sama dengan anak-anak dari berbagai kemampuan, mendampingi remaja melalui program setelah sekolah dan program kepemimpinan, bekerja sama dengan keluarga dalam situasi yang sulit, dan membantu menciptakan lingkungan di mana anak muda merasa aman, didukung, dan diberdayakan untuk meraih kesuksesan. Sebagai mahasiswa generasi pertama di keluarga saya, saya paham bahwa setiap mahasiswa memiliki jalan yang berbeda. Kesuksesan seharusnya tidak pernah ditentukan oleh pendapatan, latar belakang, atau keadaan keluarga. Setiap anak berhak mendapatkan akses ke guru yang berkualitas, sekolah yang aman, kesempatan belajar modern, kegiatan ekstrakurikuler, serta dukungan akademis dan emosional yang dibutuhkan untuk berkembang. Jika terpilih, saya akan menjadi penyalur aspirasi yang kuat bagi para orang tua dengan memastikan mereka mendapatkan kesempatan bermakna untuk ikut andil dalam pendidikan anak-anak mereka. Saya akan memperjuangkan guru-guru dan karyawan nonguru dengan mendukung tersedianya alat-alat, staf, dan sumber daya yang mereka butuhkan untuk membantu siswa meraih kesuksesan. Saya juga akan berupaya memperkuat kemitraan antara sekolah-sekolah kita dan berbagai organisasi yang telah melayani banyak keluarga di Duarte karena pendidikan tidak berhenti di ruang kelas.</p><p dir=\"auto\">Kepemimpinan itu tentang mendengarkan sebelum memimpin.</p><p dir=\"auto\">Distrik Sekolah Terpadu Duarte memiliki potensi luar biasa. Saya percaya kita bisa menyongsong masa depan yang cerah jika kita bekerja sama dengan integritas dan komitmen yang sama demi kesuksesan siswa.</p><p dir=\"auto\">Saya tidak mencalonkan diri karena saya memiliki semua jawabannya. Saya mencalonkan diri karena saya telah mengabdikan karier saya untuk melayani orang lain. Saya akan merasa terhormat jika dapat membawa komitmen, pengalaman, dan kepemimpinan yang sama ke Dewan Pendidikan Distrik Sekolah Terpadu Duarte.</p>","JA":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO（リズベス・アキノ）の声明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理役員会役員の候補者、<br dir=\"auto\">管財区番号５</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE統一学区</h3><p dir=\"auto\">Duarte Unified統一学区の卒業生であることを誇りに思っています。質の高い公教育が生徒の将来を形づくる力を持つことを、私は身をもって知っています。Duarteの教室で学んだことが、第一世代大学生としてさらに学びを続けるきっかけとなり、また、私を育ててくれた地域社会に貢献する仕事に生涯を捧げる原動力となりました。</p><p dir=\"auto\">長年にわたり、私は公務と、青少年や家庭と直接関わる仕事に携わってきました。教育および余暇活動の計画と運営、地域社会との連携体制の構築、公的資金の管理、大規模な地域行事の運営、そして教育関係者、保護者、非営利団体、精神保健の専門家、図書館、地域の事業者、公共安全機関と協力し、家庭を有意義な支援や機会につなげる取り組みを行ってきました。</p><p dir=\"auto\">これまでの経験を通じて、学区が行う一つひとつの決定は、教室内にとどまるものではないことを学びました。それは家庭、教員、職員、そして地域社会の将来に影響を及ぼします。また、強い学校は、協力、説明責任、透明性、そして責任ある指導によって築かれることも学びました。</p><p dir=\"auto\">生徒たちと直接関わってきたことで、私は、生徒たちが持つ素晴らしい可能性だけでなく、多くの家庭が直面している課題も目の当たりにしてきました。私は、さまざまな能力を持つ子どもたちと関わり、放課後活動や指導者育成の取り組みを通じて青少年を支援し、困難な状況にある家庭と協力し、青少年が安心して支援を受けながら、自らの力を発揮して成功できる環境づくりに取り組んできました。第一世代大学生として、私は、一人ひとりの生徒の歩む道は異なることを理解しています。成功が、家庭の収入、背景、置かれた状況によって決められてはなりません。すべての子どもには、優れた教員、安全な学校、現代的な学習機会、課外活動、そして健やかに成長し能力を発揮するために必要な学業面および心の支援を受ける権利があります。当選した際には、保護者が子どもの教育に実質的に参加できる機会を確保し、保護者の声を代弁してまいります。また、生徒の成功を支えるために必要な教材や設備、人員配置、資源が教員および職員に提供されるよう取り組み、教員と職員を支援してまいります。さらに、すでにDuarteの家庭を支えている団体との連携を学校が一層強化できるよう取り組みます。教育は教室の中だけで完結するものではないからです。</p><p dir=\"auto\">指導する前に、まず耳を傾ける。それが指導者としての務めです。</p><p dir=\"auto\">Duarte 統一学区には素晴らしい可能性があります。私たちが誠実さをもって力を合わせ、生徒の成功に向けて共通の決意を持って取り組むならば、私たちの最も素晴らしい日々はこれから訪れると信じています。</p><p dir=\"auto\">私が立候補するのは、すべての答えを持っているからではありません。人々に奉仕することに、これまでの職業人生を捧げてきたからこそ、立候補しています。これまで培ってきた同じ責任感、経験、そして指導力をDuarte統一学区教育委員会にもたらす機会をいただけましたら、光栄に存じます。</p>","KM":"<h1 dir=\"auto\" style=\"text-align: center\">សេចក្តីថ្លែងការណ៍របស់ LIZBETH AQUINO (លីសបេត អាគីណូ)</h1><h2 dir=\"auto\" style=\"text-align: center\">បេក្ខជនសំរាប់ សមាជិកគណៈកម្មការគ្រប់គ្រង,<br dir=\"auto\">ប្រឹក្សា​ភិបាល​តំបន់​លេខ 5</h2><h3 dir=\"auto\" style=\"text-align: center\">មណ្ឌលសិក្សា​ធិការ​រួបរួម DUARTE</h3><p dir=\"auto\">ក្នុងនាមជាអតីតសិស្សដែលមានមោទនភាពរបស់មណ្ឌលសិក្សាធិការរួបរួម Durate ខ្ញុំដឹងដោយផ្ទាល់ថា ការអប់រំសាធារណៈដ៏រឹងមាំអាចជួយកំណត់អនាគតរបស់សិស្សម្នាក់បានកម្រិតណា ។ មេរៀនដែលខ្ញុំបានរៀននៅក្នុងថ្នាក់រៀនរបស់ Duarte បានជំរុញទឹកចិត្តខ្ញុំឱ្យបន្តការសិក្សាក្នុងនាមជានិស្សិតមហាវិទ្យាល័យជំនាន់ទីមួយក្នុងគ្រួសារ និងមានភាពលះបង់ក្នុងអាជីពរបស់ខ្ញុំដើម្បីបម្រើសហគមន៍ដែលបានជួយចិញ្ចឹមបីបាច់ខ្ញុំ ។</p><p dir=\"auto\">អស់រយៈពេលជាច្រើនឆ្នាំ អាជីពរបស់ខ្ញុំបានផ្តោតលើការបម្រើសាធារណៈ និងការធ្វើការដោយផ្ទាល់ជាមួយយុវជន<strong> </strong>និងគ្រួសារ ។ ខ្ញុំបានរៀបចំផែនការ និងគ្រប់គ្រងកម្មវិធីអប់រំ និងកម្សាន្ត បង្កើតភាពជាដៃគូជាមួយសហគមន៍ គ្រប់គ្រងមូលនិធិសាធារណៈ សម្របសម្រួលព្រឹត្តិការណ៍សហគមន៍ទ្រង់ទ្រាយធំ និងធ្វើការរួមគ្នាជាមួយអ្នកអប់រំ មាតាបិតា អង្គការមិនរកប្រាក់ចំណេញ អ្នកជំនាញផ្នែកសុខភាពផ្លូវចិត្ត បណ្ណាល័យ អាជីវកម្មក្នុងមូលដ្ឋាន ព្រមទាំងភ្នាក់ងារសុវត្ថិភាពសាធារណៈ<strong> </strong>ដើម្បីភ្ជាប់គ្រួសារទៅកាន់ធនធាន និងឱកាសដែលមានប្រយោជន៍ ។</p><p dir=\"auto\">បទពិសោធន៍របស់ខ្ញុំបានបង្រៀនខ្ញុំថា រាល់ការសម្រេចចិត្តរបស់មណ្ឌលសិក្សាធិការ មានផលប៉ះពាល់យ៉ាងទូលំទូលាយ លើសពីអ្វីដែលកើតមាននៅក្នុងថ្នាក់រៀន ។ វាប៉ះពាល់ដល់គ្រួសារ គ្រូបង្រៀន បុគ្គលិក និងអនាគតសហគមន៍របស់យើង ។ វាក៏បានបង្ហាញឱ្យខ្ញុំឃើញថា សាលារៀនដែលរឹងមាំត្រូវបានកសាងឡើងតាមរយៈកិច្ចសហការ គណនេយ្យភាព តម្លាភាព និងភាពជាអ្នកដឹកនាំប្រកបដោយការទទួលខុសត្រូវ ។</p><p dir=\"auto\">ការធ្វើការដោយផ្ទាល់ជាមួយសិស្សបាន<strong> </strong>អនុញ្ញាតឱ្យខ្ញុំមើលឃើញទាំងសក្តានុពលដ៏អស្ចារ្យរបស់ពួកគេ និងបញ្ហាប្រឈមដែលគ្រួសារជាច្រើនកំពុងប្រឈមមុខ ។ ខ្ញុំបានធ្វើការជាមួយកុមារដែលមានសមត្ថភាពផ្សេងៗគ្នា គាំទ្រយុវវ័យតាមរយៈកម្មវិធីក្រោយម៉ោងសិក្សា និងកម្មវិធីភាពជាអ្នកដឹកនាំ សហការជាមួយគ្រួសារក្នុងស្ថានភាពលំបាក និងជួយបង្កើតបរិយាកាសដែលយុវជនមានអារម្មណ៍ថាមានសុវត្ថិភាព ទទួលបានការគាំទ្រ និងមានសមត្ថភាពសម្រេចបានជោគជ័យ ។ ក្នុងនាមជាមនុស្សដំបូងក្នុងគ្រួសារដែលបានចូលរៀននៅមហាវិទ្យាល័យ ខ្ញុំយល់ថា ផ្លូវទៅកាន់ភាពជោគជ័យរបស់សិស្សម្នាក់ៗមានលក្ខណៈខុសៗគ្នា ។ ភាពជោគជ័យមិនគួរត្រូវបានកំណត់ដោយប្រាក់ចំណូល ប្រវត្តិគ្រួសារ ឬស្ថានភាពរបស់គ្រួសារឡើយ ។ កុមារគ្រប់រូបសមនឹងទទួលបានឱកាសសិក្សាជាមួយគ្រូបង្រៀនដ៏ល្អ សាលារៀនដែលមានសុវត្ថិភាព ឱកាសសិក្សាទំនើប សកម្មភាពក្រៅកម្មវិធីសិក្សា និងការគាំទ្រផ្នែកការសិក្សា និងអារម្មណ៍ដែលពួកគេត្រូវការដើម្បីរីកចម្រើន ។ ប្រសិនបើជាប់ឆ្នោត ខ្ញុំនឹងធ្វើជាសំឡេងដ៏រឹងមាំសម្រាប់មាតាបិតា ដោយធានាថាពួកគេមានឱកាសដ៏មានប្រយោជន៍ក្នុងការចូលរួមក្នុងការអប់រំរបស់កូនៗពួកគេ ។ ខ្ញុំនឹងតស៊ូមតិសម្រាប់គ្រូបង្រៀន និងបុគ្គលិកដែលមិនមែនជាគ្រូបង្រៀន ដោយគាំទ្រឧបករណ៍ បុគ្គលិក និងធនធានដែលពួកគេត្រូវការដើម្បីជួយសិស្សឱ្យទទួលបានជោគជ័យ ។ ខ្ញុំក៏នឹងធ្វើការដើម្បីពង្រឹងភាពជាដៃគូរវាងសាលារៀនរបស់យើង និងអង្គការនានាដែលកំពុងបម្រើគ្រួសាររបស់ Duarte រួចហើយ ពីព្រោះការអប់រំមានវិសាលភាពលើសពីថ្នាក់រៀន ។</p><p dir=\"auto\">ភាពជាអ្នកដឹកនាំ គឺជាការស្តាប់មុនពេលដឹកនាំ ។</p><p dir=\"auto\">មណ្ឌលសិក្សាធិការរួបរួម Duarte មានសក្តានុពលដ៏អស្ចារ្យ ។ ខ្ញុំជឿថា ថ្ងៃដ៏ល្អបំផុតរបស់យើងនៅខាងមុខ ប្រសិនបើយើងធ្វើការរួមគ្នាដោយសុចរិតភាព និងមានការប្តេជ្ញាចិត្តរួមគ្នាចំពោះភាពជោគជ័យរបស់សិស្ស ។</p><p dir=\"auto\">ខ្ញុំមិនឈរឈ្មោះបោះឆ្នោតនោះទេ ពីព្រោះខ្ញុំមានចម្លើយគ្រប់យ៉ាង។ ខ្ញុំឈរឈ្មោះបោះឆ្នោត ពីព្រោះខ្ញុំបានលះបង់អាជីពរបស់ខ្ញុំដើម្បីបម្រើអ្នកដទៃ ។ ខ្ញុំនឹងមានកិត្តិយស ប្រសិនបើបាននាំយកការប្តេជ្ញាចិត្ត បទពិសោធន៍ និងភាពជាអ្នកដឹកនាំដូចគ្នានោះ មកកាន់គណៈកម្មការអប់រំនៃមណ្ឌលសិក្សាធិការរួបរួម Duarte ។</p>","KO":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO (리즈베스 아퀴노) 의 성명서</h1><h2 dir=\"auto\" style=\"text-align: center\">이사회 이사 후보,<br dir=\"auto\">이사 구역 번호 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE 통합교육구</h3><p dir=\"auto\">Duarte 통합교육구를 자랑스럽게 졸업한 사람으로서, 저는 훌륭한 공교육이 학생의 미래를 어떻게 형성할 수 있는지 직접 경험했습니다. Duarte의 교실에서 배운 교훈은 제가 가족 중 처음으로 칼리지에 진학해 학업을 계속하고, 저를 키워 준 지역사회를 위해 봉사하는 데 제 경력을 바치도록 영감을 주었습니다.</p><p dir=\"auto\">수년간 제 경력은 공공서비스와<strong> </strong>청소년 및 가족들과 직접 일하는 데 중점을 두어 왔습니다. 저는 교육 및 여가 프로그램을 기획·관리하고, 지역사회 협력관계를 구축하고,<strong> </strong>공공자금을 관리하며, 대규모 지역사회 행사를 조정해 왔습니다. 또한 교육자, 학부모, 비영리단체, 정신 건강 전문가, 도서관, 지역 사업체 및 공공안전기관과 협력하여 가족들이 의미 있는 자원과 기회를 이용할 수 있도록 지원해 왔습니다.</p><p dir=\"auto\">이러한 경험을 통해 저는 교육구에서 내리는 모든 결정이 교실을 훨씬 넘어서는 영향을 미친다는 것을 배웠습니다. 그러한 결정은 가족, 교사, 직원, 그리고 우리 지역사회의 미래에 영향을 미칩니다. 또한 훌륭한 학교는 협력, 책무성, 투명성 및 책임 있는 지도력을 통해 만들어진다는 것을 깨달았습니다.</p><p dir=\"auto\">학생들과 직접 일하면서<strong> </strong>저는 학생들의 놀라운 잠재력과 많은 가족들이 직면하는 어려움을 모두 직접 볼 수 있었습니다. 저는 다양한 능력을 가진 어린이들과 함께 일하고, 방과 후 프로그램과 리더십 프로그램을 통해 청소년들을 지원했으며, 어려운 상황에 처한 가족들과 협력하고, 청소년들이 안전하고 지지받으며 성공할 수 있다는 자신감을 가질 수 있는 환경을 조성하는 데 도움을 주었습니다. 가족 중 처음으로 칼리지에 진학한 학생으로서, 저는 모든 학생의 진로가 서로 다르다는 것을 잘 알고 있습니다. 성공은 가족의 소득, 배경 또는 상황에 따라 결정되어서는 안 됩니다. 모든 어린이는 훌륭한 교사, 안전한 학교, 현대적인 학습 기회, 방과 후 활동, 그리고 성장하고 성공하는 데 필요한 학업 및 정서적 지원을 받을 자격이 있습니다. 당선된다면 저는 학부모들이 자녀의 교육에 의미 있게 참여할 수 있는 기회를 갖도록 보장함으로써 학부모들을 강력하게 대변하겠습니다. 저는 교사와 사무직 직원들이 학생들의 성공을 돕는 데 필요한 도구, 인력 및 자원을 지원함으로써 이들을 옹호하겠습니다. 또한 교육은 교실을 넘어 이루어지는 것이므로, 우리 학교와 이미 Duarte 가족들을 지원하고 있는 단체들 간의 협력관계를 강화하기 위해 노력하겠습니다.</p><p dir=\"auto\">리더십이란 이끌기 전에 먼저 경청하는 것입니다.</p><p dir=\"auto\">Duarte 통합교육구는 엄청난 잠재력을 가지고 있습니다. 저는 우리가 청렴성을 바탕으로 협력하고 학생의 성공이라는 공동의 목표에 헌신한다면, 우리에게 가장 좋은 날들은 앞으로 펼쳐질 것이라고 믿습니다.</p><p dir=\"auto\">제가 모든 해답을 가지고 있기 때문에 출마하는 것은 아닙니다. 저는 다른 사람들을 위해 봉사하는 데 제 경력을 바쳐왔기 때문에 출마합니다. 그와 같은 헌신, 경험 및 리더십을 Duarte 통합교육구 교육위원회에 기여할 수 있다면 큰 영광이겠습니다.</p>","MN":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO (ЛИЗБЕТ АКУЙНО)-ИЙН МЭДЭГДЭЛ</h1><h2 dir=\"auto\" style=\"text-align: center\">УДИРДАХ ЗӨВЛӨЛИЙН ГИШҮҮНД НЭР ДЭВШИГЧ,<br dir=\"auto\">Итгэмжлэгдсэн хэсэг No. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE НЭГДСЭН СУРГУУЛИЙН ДҮҮРЭГ</h3><p dir=\"auto\">Duarte Нэгдсэн Сургуулийн Дүүргийн төгсөгчийн хувьд би чанартай төрийн боловсрол сурагчийн ирээдүйг хэрхэн өөрчилж, тодорхойлж чаддагийг өөрийн биеэр мэднэ. Duarte-ийн сургуулийн анги танхимд олж авсан мэдлэг, сургамж маань гэр бүлээсээ анхлан коллежид элсэн суралцсан оюутан болж, цаашид боловсрол эзэмшихэд урам зориг өгсөн, мөн төлөвшихөд минь дэмжсэн хамтын нийгэмлэгтээ үйлчлэхэд ажлын замналаа зориулахад нөлөөлсөн.</p><p dir=\"auto\">Олон жилийн турш миний ажил мэргэжлийн гол чиглэл төрийн үйлчилгээ болон хүүхэд, залуучууд, гэр бүлүүдтэй шууд ажиллах<strong> </strong>явдал байсаар ирсэн. Боловсролын болон чөлөөт цагийн хөтөлбөрүүдийг төлөвлөж, удирдан хэрэгжүүлж, хамтын нийгэмлэгийн түншлэлийг хөгжүүлж, төрийн хөрөнгийг удирдан зарцуулж, олон нийтийг хамарсан томоохон арга хэмжээнүүдийг зохион байгуулж ирсэн, мөн багш, эцэг эх, ашгийн бус байгууллагууд, сэтгэцийн эрүүл мэндийн мэргэжилтнүүд, номын сан,<strong> </strong>орон нутгийн бизнесүүд болон олон нийтийн аюулгүй байдлыг хангах байгууллагуудтай хамтран ажиллаж, гэр бүлүүдийг үнэ цэнтэй нөөц, боломжуудтай холбон ажилласан.</p><p dir=\"auto\">Миний туршлагаас харахад сургуулийн дүүргийн гаргасан шийдвэр бүр зөвхөн анги танхимд хамаарахгүй. Эдгээр шийдвэр нь гэр бүл, багш, ажилтнууд болон манай хамтын нийгэмлэгийн ирээдүйд нөлөөлдөг. Мөн хүчирхэг сургуулийг хамтын ажиллагаа, хариуцлага, ил тод байдал, хариуцлагатай манлайллаар бий болгодгийг би ойлгосон.</p><p dir=\"auto\">Сурагчидтай шууд ажилласнаар<strong> </strong>тэдний гайхалтай боломж чадамжийг төдийгүй олон гэр бүлд тулгардаг бэрхшээлүүдийг өөрийн нүдээр харах боломж надад олдсон. Би төрөл бүрийн чадвар, хэрэгцээтэй хүүхдүүдтэй ажиллаж, хичээлийн дараах болон манлайллын хөтөлбөрөөр дамжуулан өсвөр үеийнхнийг дэмжиж, хүнд нөхцөлд байгаа гэр бүлүүдтэй хамтран ажиллаж, залуучууд өөрсдийгөө аюулгүй, дэмжлэгтэй, амжилтад хүрэх бүрэн боломжтой гэж мэдрэх орчныг бүрдүүлэхэд хувь нэмрээ оруулсан. Гэр бүлээсээ анхлан коллежид суралцсан оюутны хувьд сурагч бүрийн замнал өөр өөр байдгийг би ойлгодог. Амжилтыг хэзээ ч гэр бүлийн орлого, гарал үүсэл, нөхцөл байдлаар тодорхойлж болохгүй. Хүүхэд бүр чадварлаг багш, аюулгүй сургууль, орчин үеийн сургалтын боломж, хичээлээс гадуурх үйл ажиллагаа, амжилттай хөгжихөд шаардлагатай академик болон сэтгэл санааны дэмжлэгийг авах эрхтэй. Сонгогдвол би эцэг эхчүүдэд хүүхдийнхээ боловсролд утга учиртайгаар оролцох боломжийг бүрдүүлэх замаар тэдний эрх ашгийг тууштай хамгаалан ажиллана. Мөн багш нар болон сургуулийн бусад ажилтнуудыг сурагчдыг амжилтад хүргэхэд нь шаардлагатай хэрэгсэл, хүний нөөц, бусад нөөц бололцоогоор хангахыг дэмжиж, тэдний эрх ашгийг хамгаалан ажиллана. Түүнчлэн боловсрол зөвхөн анги танхимаар хязгаарлагдахгүй учраас Duarte-ийн гэр бүлүүдэд аль хэдийн үйлчилгээ үзүүлж буй байгууллагууд болон сургуулиудын хоорондын түншлэлийг бэхжүүлэхийн төлөө ажиллана.</p><p dir=\"auto\">Манлайлал гэдэг нь удирдахаасаа өмнө сонсох явдал юм.</p><p dir=\"auto\">Duarte Нэгдсэн Сургуулийн Дүүрэг асар их боломжтой. Бид шударга зарчим, сурагчдын амжилтын төлөөх нэгдсэн зорилгын хүрээнд хамтран ажиллаж чадвал бидний хамгийн сайхан өдрүүд бидний өмнө байна гэдэгт би итгэдэг.</p><p dir=\"auto\">Би бүх хариултыг мэддэг учраас нэр дэвшиж байгаа юм биш. Би бүхий л ажил мэргэжлийнхээ замналыг бусдад үйлчлэхэд зориулж ирсэн учраас нэр дэвшиж байна. Энэхүү тууштай байдал, туршлага, манлайллаа Duarte Нэгдсэн Сургуулийн Дүүргийн Боловсролын Зөвлөлд авчран ажиллах нь миний хувьд нэр төрийн хэрэг байх болно.</p>","MY":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO (လစ်ဇ်ဘသ် အကွီနို) ၏ ထုတ်ပြန်ချက်</h1><h2 dir=\"auto\" style=\"text-align: center\">အုပ်ချုပ်ရေးဘုတ်အဖွဲ့ဝင်အတွက် ကိုယ်စားလှယ်လောင်း၊<br dir=\"auto\">အုပ်ထိန်းရေး ဧရိယာ အမှတ် 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE စုပေါင်းကျောင်းခရိုင်</h3><p dir=\"auto\">Duarte စုပေါင်းကျောင်းခရိုင်ရဲ့ ဂုဏ်ယူရတဲ့ ကျောင်းဆင်းတစ်ယောက်အနေနဲ့ ကျွန်မဟာ ခိုင်မာတဲ့အစိုးရပညာရေးက ကျောင်းသားတစ်ယောက်ရဲ့ အနာဂတ်ကို ဘယ်လိုမျိုး ပုံဖော်ပေးနိုင်သည်ကိုကိုယ်တွေ့သိရှိပါတယ်။ Duarte ရဲ့ စာသင်ခန်းတွေမှာ ကျွန်မ သင်ယူခဲ့တဲ့ သင်ခန်းစာတွေက မိသားစုထဲမှာ ပထမဆုံး ကောလိပ်တက်ရောက်ခဲ့သူတစ်ယောက်အနေနဲ့ ကျွန်မရဲ့ပညာရေးကို ဆက်လက်သင်ယူရန်နှင့် ကျွန်မကို ပြုစုပျိုးထောင်ပေးခဲ့တဲ့ အသိုင်းအဝိုင်းအတွက် တာဝန်ထမ်းဆောင်ရာမှာ အသက်မွေးဝမ်းကျောင်းဘဝကို နှစ်မြှုပ်လုပ်ကိုင်ဖို့ စိတ်ဓာတ်လှုံ့ဆော်ပေးခဲ့ပါတယ်။</p><p dir=\"auto\">ကျွန်မရဲ့လုပ်သက်နှစ်ပေါင်းများစွာတစ်လျှောက်မှာ အများပြည်သူဝန်ဆောင်မှုနဲ့<strong> </strong>လူငယ်နဲ့ မိသားစုတွေနဲ့ တိုက်ရိုက်လက်တွဲလုပ်ကိုင်ဖို့ အဓိကထားခဲ့ပါတယ်။ ကျွန်မက ပညာရေးနဲ့ အပန်းဖြေ အစီအစဉ်တွေကို ရေးဆွဲပြီး စနစ်တကျ စီမံခဲ့တယ်၊ အသိုင်းအဝိုင်းနဲ့ မိတ်ဖက်‌ဆက်ဆံရေးတွေ တည်ဆောက်ခဲ့တယ်၊ ပြည်သူ့ဘဏ္ဍာငွေတွေကို စီမံခန့်ခွဲခဲ့တယ်၊ ကြီးမားတဲ့ လူထုပွဲတွေကို ပေါင်းစပ်ညှိနှိုင်း ဆောင်ရွက်ခဲ့ဖူးပါတယ်။ ဒါ့အပြင် မိသားစုတွေကို အသုံးဝင်ပြီး အဓိပ္ပာယ်ရှိတဲ့ အရင်းအမြစ်တွေ၊ အခွင့်အလမ်းတွေနဲ့ ချိတ်ဆက်ပေးနိုင်ဖို့အတွက် ဆရာတွေ၊ မိဘတွေ၊ အကျိုးအမြတ်မယူတဲ့ အဖွဲ့အစည်းတွေ၊ စိတ်ကျန်းမာရေး ပညာရှင်တွေ၊ စာကြည့်တိုက်တွေ၊ ဒေသတွင်း စီးပွားရေးလုပ်ငန်းတွေနဲ့<strong> </strong>ပြည်သူ့လုံခြုံရေး အဖွဲ့အစည်းတွေနဲ့အတူ လက်တွဲလုပ်ကိုင်ခဲ့ပါတယ်။</p><p dir=\"auto\">ကျောင်း ခရိုင်တစ်ခုက ချမှတ်လိုက်တဲ့ ဆုံးဖြတ်ချက်တိုင်းဟာ စာသင်ခန်းထက်မက အများကြီး ပိုမိုကျယ်ပြန့်တယ်ဆိုတာကို ကျွန်မရဲ့ အတွေ့အကြုံတွေကနေ သင်ယူခဲ့ရပါတယ်။ အဲဒါက မိသားစုတွေ၊ ဆရာတွေ၊ ဝန်ထမ်းတွေနဲ့ ကျွန်မတို့ အသိုင်းအဝိုင်းရဲ့ အနာဂတ်အပေါ်မှာ သက်ရောက်မှု ရှိပါတယ်။ ဒါ့အပြင် ခိုင်မာအားကောင်းတဲ့ ကျောင်းတွေကို ပူးပေါင်းဆောင်ရွက်မှု၊ တာဝန်ခံမှု၊ ပွင့်လင်းမြင်သာမှုနဲ့ တာဝန်သိတဲ့ ခေါင်းဆောင်မှုတို့နဲ့ တည်ဆောက်ရတယ်ဆိုတာကိုလည်း သဘောပေါက်ခဲ့ရပါတယ်။</p><p dir=\"auto\">ကျောင်းသားတွေနဲ့ တိုက်ရိုက်ထိတွေ့ လုပ်ကိုင်ခဲ့ရတာကြောင့်<strong> </strong>သူတို့ရဲ့ မယုံနိုင်စရာ အလားအလာတွေကိုရော မိသားစုအများစု ရင်ဆိုင်နေရတဲ့ စိန်ခေါ်မှုတွေကိုပါ မြင်တွေ့ခွင့်ရခဲ့ပါတယ်။ ကျွန်မက စွမ်းဆောင်ရည်အမျိုးမျိုးရှိတဲ့ ကလေးတွေနဲ့အတူ လုပ်ကိုင်ခဲ့ဖူးတယ်၊ ကျောင်းပြင်ပနဲ့ ခေါင်းဆောင်မှု အစီအစဉ်တွေကနေတစ်ဆင့် လူငယ်တွေကို ပံ့ပိုးပေးခဲ့တယ်၊ ခက်ခဲတဲ့ အခြေအနေတွေမှာ မိသားစုတွေနဲ့ ပူးပေါင်းဆောင်ရွက်ခဲ့တယ်၊ လူငယ်တွေ ဘေးကင်းလုံခြုံမှုရှိပြီး အားပေးကူညီမှုရရှိကာ အောင်မြင်ဖို့အတွက် ခွန်အားဖြစ်စေမယ့် ပတ်ဝန်းကျင်ကောင်းတွေကို ဖန်တီးပေးဖို့ ကူညီခဲ့ပါတယ်။ မိသားစုထဲမှာ ပထမဆုံး ကောလိပ်တက်ရောက်ခဲ့သူ တစ်ယောက်အနေနဲ့ ကျောင်းသားတိုင်းရဲ့ လျှောက်လှမ်းရမည့် လမ်းကြောင်းဟာ မတူညီကြဘူးဆိုတာကို ကျွန်မ နားလည်ပါတယ်။ အောင်မြင်မှုဆိုတာ မိသားစုရဲ့ ဝင်ငွေ၊ နောက်ခံ ဒါမှမဟုတ် အခြေအနေတွေပေါ် မူတည်ပြီး ဘယ်တော့မှ အဆုံးအဖြတ် မပေးသင့်ပါဘူး။ ကလေးတိုင်းဟာ ထူးချွန်တဲ့ ဆရာတွေ၊ ဘေးကင်းတဲ့ ကျောင်းတွေ၊ ခေတ်မီသင်ယူမှု အခွင့်အလမ်းတွေ၊ ကျောင်းပြင်ပ လှုပ်ရှားမှုတွေနဲ့အတူ တိုးတက်အောင်မြင်ဖို့ လိုအပ်တဲ့ ပညာရေးဆိုင်ရာရော စိတ်ဓာတ်ရေးရာပါ ပံ့ပိုးမှုတွေကို ရရှိပိုင်ခွင့်ရှိပါတယ်။ ကျွန်မ ရွေးချယ်ခံရပါက မိဘတွေအနေနဲ့ သူတို့ကလေးတွေရဲ့ ပညာရေးမှာ အဓိပ္ပာယ်ရှိသော ပါဝင်ခွင့်ရရှိစေရေးအတွက် မိဘတွေအတွက် ခိုင်မာတဲ့ အသံတစ်သံ ဖြစ်လာစေရပါမယ်။ ကျောင်းသားတွေ အောင်မြင်ဖို့အတွက် လိုအပ်တဲ့ အထောက်အကူပြု ကိရိယာတွေ၊ ဝန်ထမ်းအင်အားနဲ့ အရင်းအမြစ်တွေကို ပံ့ပိုးပေးခြင်းအားဖြင့် ကျွန်မတို့ရဲ့ ဆရာတွေနဲ့ ဝန်ထမ်းအဖွဲ့အစည်းတွေကို ကူညီထောက်ပံ့ပေးသွားမှာ ဖြစ်ပါတယ်။ ဒါ့အပြင် ပညာရေးဆိုတာ စာသင်ခန်းတွင်းထက်မက ပိုမိုကျယ်ပြန့်တာကြောင့် Duarte မိသားစုတွေကို ဝန်ဆောင်မှုပေးနေပြီးသား အဖွဲ့အစည်းတွေနဲ့ ကျွန်မတို့ ကျောင်းတွေကြား ပူးပေါင်းဆောင်ရွက်မှုတွေကို ပိုမိုခိုင်မာအောင် လုပ်ဆောင်သွားပါမယ်။</p><p dir=\"auto\">ခေါင်းဆောင်မှုဆိုတာ မဦးဆောင်ခင် အရင်ဆုံး နားထောင်ပေးခြင်း ဖြစ်ပါတယ်။</p><p dir=\"auto\">Duarte စုပေါင်းကျောင်းခရိုင်မှာ မယုံနိုင်လောက်အောင် ကောင်းမွန်သော အလားအလာရှိပါတယ်။ ကျွန်မတို့ သမာသမတ်ရှိရှိနဲ့ အတူတကွ လက်တွဲလုပ်ကိုင်ပြီး ကျောင်းသားတွေရဲ့ အောင်မြင်မှုကို အတူတူ အဓိကထား ဆောင်ရွက်သွားမယ်ဆိုရင် ကျွန်မတို့ရဲ့ အကောင်းဆုံး နေ့ရက်တွေဟာ ရှေ့မှောက်မှာ ရောက်ရှိလာတော့မယ်လို့ ယုံကြည်ပါတယ်။</p><p dir=\"auto\">ကျွန်မ အဖြေအားလုံးကို သိရှိထားလို့ ဒီရွေးကောက်ပွဲမှာ ဝင်ရောက်ယှဉ်ပြိုင်တာ မဟုတ်ပါဘူး။ ကျွန်မရဲ့ အသက်မွေးဝမ်းကျောင်း ဘဝတစ်ခုလုံးကို အခြားသူတွေအတွက် တာဝန်ထမ်းဆောင်ဖို့ မြှုပ်နှံထားခဲ့တာကြောင့် ဝင်ရောက်ယှဉ်ပြိုင်ရခြင်း ဖြစ်ပါတယ်။ အလားတူ ကတိကဝတ်၊ အတွေ့အကြုံနဲ့ ခေါင်းဆောင်မှုကို Duarte စုပေါင်းကျောင်းခရိုင် ပညာရေးဘုတ်အဖွဲ့ဆီ ယူဆောင်လာပေးရတဲ့အတွက် ဂုဏ်ယူဝမ်းမြောက်မိမှာပါ။</p>","RU":"<h1 dir=\"auto\" style=\"text-align: center\">ЗАЯВЛЕНИЕ LIZBETH AQUINO (ЛИЗБЕТ АКИНО)</h1><h2 dir=\"auto\" style=\"text-align: center\">КАНДИДАТ В ЧЛЕНЫ УПРАВЛЯЮЩЕГО СОВЕТА,<br dir=\"auto\">Попечительский участок № 5</h2><h3 dir=\"auto\" style=\"text-align: center\">ОБЪЕДИНЕННЫЙ ШКОЛЬНЫЙ РАЙОН DUARTE</h3><p dir=\"auto\">Я — гордая выпускница Объединенного школьного района Duarte — знаю на собственном опыте, как сильное государственное образование может повлиять на будущее учащегося. Уроки, усвоенные в классах Duarte, вдохновили меня продолжить образование в качестве первой студентки колледжа в своей семье и посвятить свою карьеру служению сообществу, которое помогло меня вырастить.</p><p dir=\"auto\">На протяжении многих лет моя карьера была сосредоточена на государственной службе и непосредственной работе с<strong> </strong>молодежью и семьями. Я занималась планированием и управлением образовательными и развлекательными программами, развитием партнерских отношений с сообществом, управлением государственными средствами и координацией масштабных общественных мероприятий. Я работала совместно с педагогами, родителями, некоммерческими организациями, специалистами в области ментального здоровья, библиотеками, местным бизнесом и органами<strong> </strong>общественной безопасности, чтобы обеспечивать семьям доступ к полезным ресурсам и возможностям.</p><p dir=\"auto\">Мой опыт научил меня, что любое решение, принимаемое школьным районом, выходит далеко за рамки классной комнаты. Оно оказывает влияние на семьи, учителей, сотрудников и будущее нашего сообщества. Я также пришла к пониманию того, что сильные школы строятся на основе сотрудничества, подотчетности, прозрачности и ответственного руководства.</p><p dir=\"auto\">Непосредственная работа с учащимися<strong> </strong>позволила мне увидеть как их невероятный потенциал, так и трудности, с которыми сталкиваются многие семьи. Я работала с детьми с самыми разными возможностями, поддерживала подростков через программы продленного дня и программы лидерства, сотрудничала с семьями в сложных жизненных ситуациях, а также помогала создавать условия, в которых молодежь чувствует себя в безопасности, ощущает поддержку и получает мотивацию к достижению успеха. Как первая студентка колледжа в своей семье, я понимаю, что у каждого учащегося свой путь. Успех никогда не должен определяться доходом семьи, ее прошлым или обстоятельствами. Каждый ребенок заслуживает доступа к превосходным учителям, безопасным школам, современным возможностям обучения, внеклассным мероприятиям, а также к академической и эмоциональной поддержке, необходимой для успешного развития. В случае избрания я стану решительным защитником интересов родителей, обеспечив им существенные возможности для участия в образовании своих детей. Я буду отстаивать интересы наших учителей и вспомогательного персонала, поддерживая предоставление им необходимых инструментов, кадров и ресурсов для обеспечения успеха учащихся. Я также буду работать над укреплением партнерских отношений между нашими школами и организациями, которые уже обслуживают семьи Duarte, потому что образование выходит за рамки классной комнаты.</p><p dir=\"auto\">Лидерство — это умение слушать, прежде чем вести за собой.</p><p dir=\"auto\">Объединенный школьный район Duarte обладает невероятным потенциалом. Я верю, что наши лучшие дни впереди, когда мы работаем вместе честно и с общим стремлением к успеху учащихся.</p><p dir=\"auto\">Я иду на выборы не потому, что знаю все ответы. Я иду на выборы, потому что посвятила свою карьеру служению обществу. Для меня было бы большой честью привнести свое стремление, опыт и навыки руководства в работу Совета по вопросам образования Объединенного школьного района Duarte.</p>","TE":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO (లిజ్‌బెత్ ఆక్వినో) స్టేట్‌మెంట్</h1><h2 dir=\"auto\" style=\"text-align: center\">గవర్నింగ్ బోర్డు సభ్యుని కొరకు అభ్యర్థి,<br dir=\"auto\">ధర్మకర్త ప్రాంతం నెంబరు 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE ఏకీకృత స్కూలు డిస్ట్రిక్ట్</h3><p dir=\"auto\">Duarte ఏకీకృత స్కూలు డిస్ట్రిక్ట్ యొక్క గర్వించదగిన గ్రాడ్యుయేట్‌గా, ఒక విద్యార్థి భవిష్యత్తును ఒక బలమైన ప్రభుత్వ విద్య ఎలా తీర్చిదిద్దగలదనేది నేను ప్రత్యక్షంగా తెలుసుకున్నాను. నేను Duarte క్లాస్‌రూమ్‌ల్లో నేర్చుకున్న పాఠాలు, మొదటి తరానికి చెందిన కాలేజీ విద్యార్థిగా నా విద్యను కొనసాగించడానికి మరియు నన్ను పెంచి పెద్ద చేసిన కమ్యూనిటీకి సేవ చేసేందుకు నా వృత్తిజీవితాన్ని అంకితం చేయడానికి నన్ను ప్రేరేపించాయి.</p><p dir=\"auto\">అనేక సంవత్సరాలుగా, నా వృత్తి జీవితం ప్రజాసేవ మరియు<strong> </strong>యువత, మరియు కుటుంబాలతో నేరుగా పనిచేయడంపైనే కేంద్రీకృతమైంది. నేను విద్యా మరియు రిక్రియేషన్ కార్యక్రమాలను ప్లాన్ చేశాను, నిర్వహించాను, కమ్యూనిటీ భాగస్వామ్యాలను అభివృద్ధి చేశాను, ప్రభుత్వ నిధులను నిర్వహించాను, పెద్ద ఎత్తున కమ్యూనిటీ ఈవెంట్‌లకు సమన్వయాన్ని నెరిపాను మరియు టీచర్‌లు, తల్లిదండ్రులు, లాభాపేక్షలేని సంస్థలు, మానసిక ఆరోగ్య నిపుణులు, లైబ్రరీలు, స్థానిక వ్యాపారాలు,<strong> </strong>ప్రజా భద్రతా సంస్థలతో పాటు కుటుంబాలను అర్థవంతమైన వనరులు మరియు అవకాశాలతో అనుసంధానించడానికి పనిచేశాను.</p><p dir=\"auto\">ఒక స్కూలు డిస్ట్రిక్ట్ తీసుకునే ప్రతి నిర్ణయం కూడా కేవలం తరగతి గదికి మాత్రమే పరిమితం కాదని నా అనుభవం నాకు బోధించింది. ఇది కుటుంబాలు, టీచర్‌లు, ఉద్యోగులు, మరియు మన కమ్యూనిటీ భవిష్యత్తును ప్రభావితం చేస్తుంది. బలమైన పాఠశాలలు సహకారం, జవాబుదారీతనం, పారదర్శకత మరియు బాధ్యతాయుతమైన నాయకత్వం ద్వారా మాత్రమే రూపుదిద్దుకుంటాయని కూడా నాకు అర్థమైంది.</p><p dir=\"auto\">విద్యార్థులతో నేరుగా పనిచేయడం వారి<strong> </strong>అద్భుత సామర్థ్యాన్ని మరియు అనేక కుటుంబాలు ఎదుర్కొంటున్న సవాళ్లను చూడటానికి నన్ను అనుమతించింది. నేను అన్ని రకాలైన సామర్థ్యాలున్న పిల్లలతో కలిసి పనిచేశాను, పాఠశాల అనంతర మరియు నాయకత్వ కార్యక్రమాల ద్వారా టీనేజర్‌లకు మద్దతు ఇచ్చాను, కష్ట సమయాల్లో కుటుంబాలకు తోడుగా నిలిచాను, మరియు యువత సురక్షితంగా, మద్దతుగా మరియు విజయం సాధించడానికి సాధికారత కలిగిన వాతావరణాన్ని సృష్టించడంలో సాయపడ్డాను. మొదటి తరం కాలేజీ విద్యార్థిగా, నేను ప్రతి విద్యార్థి పథం భిన్నంగా కనిపిస్తుందని నేను అర్థం చేసుకున్నాను. విజయాన్ని కుటుంబ ఆదాయం, నేపథ్యం, లేదా పరిస్థితుల ద్వారా ఎన్నడూ నిర్ధారించకూడదు. ప్రతి విద్యార్థి కూడా అద్భుతమైన టీచర్‌లు, సురక్షితమైన పాఠశాలు, ఆధునిక అభ్యసన అవకాశాలు, ఎక్స్‌ట్రాకరిక్యులర్ యాక్టివిటీస్, రాణించడానికి అవసరమైన విద్య మరియు మానసిక మద్దతుకు అర్హులు. నేను ఎన్నికైతే, పిల్లల చదువులో వారి తల్లిదండ్రుల పాల్గొనే అర్థవంతమైన అవకాశాలను అందించడం ద్వారా వారి తరఫున బలమైన గొంతుకగా ఉంటాను. విద్యార్థులు విజయం సాధించడానికి సాయపడటానికి అవసరమైన ఉపకరణాలు, సిబ్బంది మరియు వనరుల మద్దతు అందించడం ద్వారా నేను మా టీచర్‌లు మరియు క్లాసిఫైడ్ ఉద్యోగుల తరఫున పోరాడతాను. అలాగే విద్య అనేది కేవలం తరగతి గదికే పరిమితం కాదు కాబట్టి, మన పాఠశాలలు మరియు ఇప్పటికే Duarte కుటుంబాలకు సేవలందిస్తున్న సంస్థల మధ్య భాగస్వామ్యాన్ని బలోపేతం చేయడానికి కూడా నేను కృషి చేస్తాను.</p><p dir=\"auto\">నాయకత్వం అనేది నడిపించడానికి ముందు వినడం.</p><p dir=\"auto\">Duarte ఏకీకృత స్కూలు డిస్ట్రిక్ట్‌కు అద్భుతమైన సామర్థ్యం ఉంది. మనందరం కూడా సమగ్రతతో, మరియు విద్యార్థుల విజయం సాధించేలా ఉన్న ఉమ్మడి నిబద్ధతతో కలిసి పనిచేసేప్పుడు, మన మంచి రోజులు రాబోతున్నాయని నేను విశ్వసిస్తున్నాను.</p><p dir=\"auto\">నా వద్ద అన్ని సమాధానాలు ఉన్నాయని నేను పోటీ చేయడం లేదు. నా వృత్తి జీవితాన్ని ఇతరులకు సేవ చేయడానికి అంకితం చేశాను కాబట్టి నేను పోటీ చేస్తున్నాను. Duarte ఏకీకృత స్కూలు డిస్ట్రిక్ట్ విద్యా బోర్డుకు అదే నిబద్ధత, అనుభవం మరియు నాయకత్వాన్ని తీసుకురావడాన్ని నేను గౌరవంగా భావిస్తున్నాను.</p>","TH":"<h1 dir=\"auto\" style=\"text-align: center\">แถลงการณ์ของ LIZBETH AQUINO <br dir=\"auto\">(ลิซเบธ อากีโน)</h1><h2 dir=\"auto\" style=\"text-align: center\">ผู้สมัครรับเลือกตั้งสำหรับตำแหน่งสมาชิกของคณะกรรมการกำกับดูแล<br dir=\"auto\">ทรัสตีพื้นที่หมายเลข 5</h2><h3 dir=\"auto\" style=\"text-align: center\">เขตโรงเรียนร่วม DUARTE</h3><p dir=\"auto\">ในฐานะศิษย์เก่าที่ภาคภูมิใจของเขตโรงเรียนร่วม Duarte ดิฉันรู้ด้วยตนเองว่าการศึกษาของรัฐที่ดีสามารถหล่อหลอมอนาคตของนักเรียนได้อย่างไร บทเรียนที่ดิฉันได้รับในห้องเรียนของ Duarte เป็นแรงบันดาลใจให้ดิฉันศึกษาต่อในระดับมหาวิทยาลัยในฐานะนักศึกษาคนแรกของครอบครัว และอุทิศอาชีพการงานเพื่อรับใช้ชุมชนที่หล่อหลอมดิฉันมา</p><p dir=\"auto\">ตลอดหลายปีที่ผ่านมา อาชีพของดิฉันมุ่งเน้นไปที่การบริการสาธารณะและการทำงานโดยตรงกับเยาวชนและครอบครัว ดิฉันมีประสบการณ์ในการวางแผนและบริหารจัดการโครงการด้านการศึกษาและนันทนาการ พัฒนาความร่วมมือกับชุมชน บริหารจัดการงบประมาณสาธารณะ ประสานงานกิจกรรมชุมชนขนาดใหญ่ และทำงานร่วมกับนักการศึกษา ผู้ปกครอง องค์กรไม่แสวงผลกำไร ผู้เชี่ยวชาญด้านสุขภาพจิต ห้องสมุด ธุรกิจในท้องถิ่น หน่วยงานด้านความปลอดภัยสาธารณะเพื่อเชื่อมโยงครอบครัวเข้ากับแหล่งข้อมูลและโอกาสที่มีคุณค่า</p><p dir=\"auto\">จากประสบการณ์ของดิฉัน ดิฉันได้เรียนรู้ว่าทุกการตัดสินใจของเขตโรงเรียนส่งผลกระทบไปไกลกว่าแค่ในห้องเรียน เรื่องนี้ส่งผลกระทบต่อครอบครัว ครู พนักงาน และอนาคตของชุมชนของเรา นอกจากนี้ยังทำให้ดิฉันเห็นว่าโรงเรียนที่มีคุณภาพสร้างขึ้นได้จากการทำงานร่วมกัน ความรับผิดชอบ ความโปร่งใส และความเป็นผู้นำที่มีความรับผิดชอบ</p><p dir=\"auto\">การทำงานโดยตรงกับนักเรียนนั้น<strong> </strong>ทำให้ดิฉันได้เห็นทั้งศักยภาพอันน่าทึ่งของพวกเขาและความท้าทายที่หลายครอบครัวต้องเผชิญ ดิฉันเคยทำงานกับเด็กที่มีความสามารถทุกระดับ สนับสนุนวัยรุ่นผ่านโครงการหลังเลิกเรียนและโครงการพัฒนาภาวะผู้นำ ร่วมมือกับครอบครัวในช่วงเวลาที่ยากลำบาก และช่วยสร้างสภาพแวดล้อมที่เยาวชนรู้สึกปลอดภัย ได้รับการสนับสนุน และมีศักยภาพที่จะประสบความสำเร็จ ในฐานะนักศึกษาที่เรียนมหาวิทยาลัยเป็นรุ่นแรกของครอบครัว ดิฉันเข้าใจดีว่าเส้นทางของนักศึกษาแต่ละคนนั้นแตกต่างกัน ความสำเร็จไม่ควรถูกตัดสินจากรายได้ ภูมิหลัง หรือสถานการณ์ของครอบครัว เด็กทุกคนสมควรได้รับโอกาสในการเข้าถึงครูผู้สอนที่ยอดเยี่ยม โรงเรียนที่ปลอดภัย โอกาสในการเรียนรู้ที่ทันสมัย กิจกรรมนอกหลักสูตร และการสนับสนุนด้านวิชาการและอารมณ์ที่จำเป็นต่อการเติบโตและประสบความสำเร็จ หากได้รับเลือกตั้ง ดิฉันจะเป็นกระบอกเสียงที่แข็งแกร่งให้กับผู้ปกครอง โดยจะทำให้แน่ใจว่าพวกเขามีโอกาสที่สำคัญในการมีส่วนร่วมในการศึกษาของบุตรหลาน ดิฉันจะสนับสนุนครูและบุคลากรของเราโดยการจัดหาเครื่องมือ บุคลากร และทรัพยากรที่จำเป็นเพื่อช่วยให้นักเรียนประสบความสำเร็จ นอกจากนี้ ดิฉันจะทำงานเพื่อเสริมสร้างความร่วมมือระหว่างโรงเรียนของเรากับองค์กรต่างๆ ที่ให้บริการแก่ครอบครัวในเมือง Duarte อยู่แล้ว เพราะการศึกษาไม่ได้จำกัดอยู่แค่ในห้องเรียน</p><p dir=\"auto\">การเป็นผู้นำคือการฟังก่อนที่จะนำผู้อื่น</p><p dir=\"auto\">เขตการศึกษาร่วม Duarte มีศักยภาพที่น่าทึ่ง ดิฉันเชื่อว่าอนาคตที่ดีที่สุดของเราอยู่ข้างหน้า เมื่อเราร่วมมือกันด้วยความซื่อสัตย์สุจริต และความมุ่งมั่นร่วมกันเพื่อความสำเร็จของนักเรียน</p><p dir=\"auto\">ดิฉันไม่ได้ลงสมัครรับเลือกตั้งเพราะดิฉันรู้คำตอบทุกอย่างแล้ว ดิฉันลงสมัครรับเลือกตั้งเพราะดิฉันได้อุทิศอาชีพของดิฉันเพื่อรับใช้ผู้อื่น ดิฉันรู้สึกเป็นเกียรติอย่างยิ่งที่จะนำความมุ่งมั่น ประสบการณ์ และภาวะผู้นำเหล่านั้นมาสู่คณะกรรมการการศึกษาของเขตการศึกษาร่วม Duarte</p>","TL":"<h1 dir=\"auto\" style=\"text-align: center\">PAHAYAG NI LIZBETH AQUINO</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDATO PARA MIYEMBRO NG NAMAMAHALANG LUPON,<br dir=\"auto\">Lugar ng Katiwala Blg. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">PINAG-ISANG DISTRITO NG PAARALAN NG DUARTE</h3><p dir=\"auto\">Bilang isang maipagmamalaking nagtapos ng Pinag-isang Distrito ng Paaralan ng Duarte, alam ko mismo kung paano mahuhubog ng isang matibay na pampublikong edukasyon ang kinabukasan ng isang mag-aaral. Ang mga aral na natutunan ko sa mga silid-aralan ng Duarte ang nagbigay ng inspirasyon sa akin na ipagpatuloy ang aking edukasyon bilang isang unang henerasyon ng estudyante sa kolehiyo at ialay ang aking karera sa paglilingkod sa komunidad na tumulong sa pagpapalaki sa akin.</p><p dir=\"auto\">Sa loob ng maraming taon, nakasentro ang aking karera sa serbisyo publiko at direktang pakikipagtulungan sa<strong> </strong>kabataan at mga pamilya. Ako ay nagplano, namahala ng mga programang pang-edukasyon at panlibangan, bumuo ng mga pakikipagtulungan sa komunidad, namahala ng mga pampublikong pondo, nagsaayos ng mga malaking kaganapan sa komunidad, at nakipagtulungan sa mga tagapagturo, magulang, organisasyong di-nagtutubo, propesyonal sa kalusugan ng isip, aklatan, lokal na negosyo, kasama ang<strong> </strong>mga ahensya ng kaligtasan ng publiko upang ikonekta ang mga pamilya sa mga makabuluhang mapagkukunan at oportunidad.</p><p dir=\"auto\">Itinuro sa akin ng aking karanasan na ang bawat desisyong ginagawa ng isang distrito ng paaralan ay higit pa sa nasa loob ng silid-aralan. Nakakaapekto ito sa mga pamilya, guro, empleyado, at sa kinabukasan ng ating komunidad. Ipinakita rin nito sa akin na nabubuo ang matibay na paaralan sa pamamagitan ng kolaborasyon, pananagutan, kalinawan, at responsableng pamumuno.</p><p dir=\"auto\">Ang direktang pakikipagtulungan sa mga mag-aaral ay<strong> </strong>nagbigay-daan sa akin na makita ang kanilang kahanga-hangang potensyal at ang mga hamong kinakaharap ng maraming pamilya. Nakatrabaho ko na ang mga batang may iba't ibang kakayahan, sinuportahan ko ang mga tinedyer sa mga programa pagkatapos ng eskwela at programa sa pamumuno, nakipagtulungan ako sa mga pamilya sa panahon ng mahihirap na sitwasyon, at tumulong akong lumikha ng mga kapaligiran kung saan nakakaramdam ang kabataan ng ligtas, suportado, at may kapangyarihang magtagumpay. Bilang isang unang henerasyon ng estudyante sa kolehiyo, naiintindihan ko na iba-iba ang landas na tinatahak ng bawat estudyante. Ang tagumpay ay hindi dapat kailanman ibase sa kita, pinagmulan, o kalagayan ng isang pamilya. Ang bawat bata ay nararapat na makatanggap ng mahuhusay na guro, mga ligtas na paaralan, mga modernong pagkakataon sa pag-aaral, mga aktibidad sa labas ng klase, at akademiko at emosyonal na suporta na kailangan upang umunlad. Kung mahahalal, ako ay magiging isang malakas na boses para sa mga magulang sa pamamagitan ng pagtiyak na magkakaroon sila ng mga makabuluhang pagkakataon na makilahok sa edukasyon ng kanilang mga anak. Ipagtatanggol ko ang ating mga guro at klasipikadong empleyado sa pamamagitan ng pagsuporta sa mga kagamitan, tauhan, at mapagkukunang kailangan nila upang matulungan ang mga mag-aaral na magtagumpay. Magsisikap din ako na palakasin ang pakikipagtulungan sa pagitan ng ating mga paaralan at ng mga organisasyong naglilingkod na sa mga pamilya sa Duarte dahil higit pa sa silid-aralan ang edukasyon.</p><p dir=\"auto\">Ang pamumuno ay tungkol sa pakikinig bago mamuno.</p><p dir=\"auto\">Malaki ang potensyal ng Pinag-isang Distrito ng Paaralan ng Duarte. Naniniwala akong darating ang pinakamagagandang araw natin kapag nagtutulungan tayo nang may integridad, at may nakabahaging dedikasyon tayo sa tagumpay ng mga estudyante.</p><p dir=\"auto\">Hindi ako tatakbo dahil alam ko na ang lahat ng sagot. Tumatakbo ako dahil inialay ko ang aking karera sa paglilingkod sa iba. Isang karangalan para sa akin na dalhin ang parehong pangako, karanasan, at pamumuno sa Lupon ng Edukasyon ng Pinag-isang Distrito ng Paaralan ng Duarte.</p>","VI":"<h1 dir=\"auto\" style=\"text-align: center\">BÀI PHÁT BIỂU CỦA LIZBETH AQUINO</h1><h2 dir=\"auto\" style=\"text-align: center\">ỨNG CỬ VIÊN CHO CHỨC VỤ ỦY VIÊN HỘI ĐỒNG QUẢN TRỊ,<br dir=\"auto\">Chưởng Quản Khu Số 5</h2><h3 dir=\"auto\" style=\"text-align: center\">KHU HỌC CHÁNH THỐNG NHẤT DUARTE</h3><p dir=\"auto\">Là một cựu học sinh tự hào của Khu Học Chánh Thống Nhất Duarte, tôi hiểu rõ từ chính trải nghiệm của mình rằng một nền giáo dục công vững mạnh có thể định hình tương lai của một học sinh như thế nào. Những bài học tôi được học trong các lớp học tại Duarte đã truyền cảm hứng để tôi tiếp tục con đường học vấn với tư cách là thế hệ đầu tiên trong gia đình theo học đại học, đồng thời cống hiến sự nghiệp để phục vụ cộng đồng đã nuôi dưỡng và giúp tôi trưởng thành.</p><p dir=\"auto\">Trong nhiều năm, sự nghiệp của tôi tập trung vào hoạt động phục vụ cộng đồng và làm việc trực tiếp với<strong> </strong>thanh thiếu niên và các gia đình. Tôi đã lập kế hoạch và quản lý các chương trình giáo dục, giải trí; xây dựng quan hệ đối tác với cộng đồng; quản lý ngân sách công; phối trí các sự kiện cộng đồng quy mô lớn; đồng thời phối hợp với các nhà giáo dục, phụ huynh, tổ chức bất vụ lợi, chuyên gia sức khỏe tâm thần, thư viện, thương nghiệp địa phương và<strong> </strong>các cơ quan an toàn công cộng để kết nối các gia đình với những nguồn lực và cơ hội thiết thực, có ý nghĩa.</p><p dir=\"auto\">Kinh nghiệm của tôi cho thấy mọi quyết định được một khu học chánh đưa ra đều có tác động vượt xa phạm vi lớp học. Những quyết định đó ảnh hưởng đến các gia đình, giáo viên, nhân viên và tương lai của cộng đồng chúng ta. Kinh nghiệm ấy cũng cho tôi thấy rằng những trường học vững mạnh được xây dựng dựa trên sự hợp tác, trách nhiệm, tính minh bạch và sự lãnh đạo có trách nhiệm.</p><p dir=\"auto\">Làm việc trực tiếp với học sinh đã<strong> </strong>cho tôi cơ hội chứng kiến cả tiềm năng đáng kinh ngạc của các em lẫn những khó khăn mà nhiều gia đình đang phải đối mặt. Tôi đã làm việc với trẻ em với mọi khả năng khác nhau, hỗ trợ thanh thiếu niên thông qua các chương trình sau giờ học và chương trình phát triển năng lực lãnh đạo, đồng hành cùng các gia đình trong những hoàn cảnh khó khăn, đồng thời góp phần xây dựng môi trường khiến thanh thiếu niên cảm thấy an toàn, được hỗ trợ và có đủ điều kiện để vươn lên đạt được thành công. Là người đầu tiên trong gia đình theo học đại học, tôi hiểu rằng con đường của mỗi học sinh là khác nhau. Thành công không bao giờ nên được quyết định bởi thu nhập, xuất thân hay điều kiện gia đình của một em học sinh. Mỗi đứa trẻ đều xứng đáng được theo học giáo viên xuất sắc, trường học an toàn, cơ hội học tập hiện đại, các hoạt động ngoại khóa, cũng như sự hỗ trợ về học tập và cảm xúc cần thiết để phát triển toàn diện. Nếu đắc cử, tôi sẽ là tiếng nói mạnh mẽ đại diện cho phụ huynh, bảo đảm rằng quý vị có những cơ hội thực chất để tham gia vào quá trình giáo dục con em mình. Tôi sẽ bảo vệ quyền lợi của giáo viên và nhân viên hành chính, hỗ trợ các công cụ, nhân sự và nguồn lực mà họ cần để giúp học sinh đạt được thành tựu. Tôi cũng sẽ nỗ lực củng cố quan hệ hợp tác giữa các trường học của chúng ta và những tổ chức vốn đang phục vụ các gia đình Duarte, bởi giáo dục không chỉ giới hạn trong lớp học.</p><p dir=\"auto\">Lãnh đạo là biết lắng nghe trước khi dẫn dắt.</p><p dir=\"auto\">Khu Học Chánh Thống Nhất Duarte có tiềm năng to lớn. Tôi tin rằng những ngày tốt đẹp nhất của chúng ta vẫn còn ở phía trước nếu ta cùng nhau hành động bằng sự chính trực và cam kết chung đối với thành công của học sinh.</p><p dir=\"auto\">Tôi ra tranh cử không phải vì tôi biết mọi câu trả lời. Tôi ra tranh cử vì tôi đã dành cả sự nghiệp để phục vụ cộng đồng. Tôi sẽ rất vinh dự nếu có cơ hội mang tinh thần tận tâm, kinh nghiệm và năng lực lãnh đạo đó đến với Hội Đồng Giáo Dục Khu Học Chánh Thống Nhất Duarte.</p>","ZH":"<h1 dir=\"auto\" style=\"text-align: center\">LIZBETH AQUINO（莉茲貝絲 · 阿奎諾）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理委員會委員候選人，<br dir=\"auto\">第5託管區</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE 聯合學區</h3><p dir=\"auto\">身為杜 Duarte 聯合學區的優秀畢業生，我親身見證完善的公立教育如何形塑學生的未來。我在 Duarte 校園習得的種種，促使身為第一代大學生的我繼續深造，並投身職涯服務培育我的這片社區。</p><p dir=\"auto\">多年以來，我的職涯始終圍繞公共服務，並直接與青年及家庭合作。我曾規劃、管理教育與休閒計畫，建立社區合作關係，管理公共經費，籌辦大型社區活動，並與教育工作者、家長、非營利組織、心理健康專業人員、圖書館、在地企業及公共安全單位協力，為家庭媒合實質可用的資源與發展機會。</p><p dir=\"auto\">自身經歷讓我體悟到，學區做出的每一項決策，影響層面遠不止於課堂之內。這會影響家長、教師、職員，以及我們社區的未來。這也讓我看見，優質學校是透過合作、問責、透明化治理與負責任的領導所建立。</p><p dir=\"auto\">親自與學生共事，讓我同時看見他們無限的潛能，以及許多家庭所面臨的難題。我曾服務各種學習能力的孩童，透過課後課程與領袖培育計畫陪伴青少年，在困境中與家庭攜手合作，並協助打造讓青少年感到安心、備受支持，且有能力邁向成功的成長環境。身為第一代大學生，我明白每位學生的求學之路都各不相同。成功與否，絕不該取決於家庭收入、背景或所處環境。每個孩子都應能接觸優秀師資、安全的校園、現代化學習資源、課外活動，以及茁壯成長所需的學業與情緒支援。如果當選，我將成為家長堅實的發聲後盾，確保家長擁有實質管道參與孩子的教育。我將為我們的教師和行政人員爭取權益，支援他們所需的工具、人員配備和資源，以幫助學生成功。我也會致力於強化學校與現有服務 Duarte 家庭之機構的合作關係，因為教育的範疇不僅限於課堂之內。</p><p dir=\"auto\">領導力在於先傾聽後領導。</p><p dir=\"auto\">Duarte 聯合學區擁有巨大的潛力。我相信，只要我們秉持誠信，齊心協力，共同致力於學生的成功，我們最美好的未來就在前方。</p><p dir=\"auto\">我參選，並非因為我握有所有答案。我參選，是因為我的職涯始終奉獻於服務他人。若能將這份相同的使命感、經歷與領導能力貢獻給 Duarte 聯合學區教育委員會，我將深感榮幸。</p>"},"CandidateID":"U5","SequenceOrder":289}],"order":0,"isWriteIn":false,"isPresidential":false},{"id":"U6","name":[{"BN":"রেইনা ই. ডিয়াজ","CC":"蕾娜·E.·迪亞茲","EN":"REYNA E. DIAZ","FA":"ری نا ای. دیاز","GU":"રેયના ઇ. ડિઆઝ","HI":"रेना ई. डियाज़","HY":"ՌԵՅՆԱ Է. ԴԻԱՍ","JA":"レイナ・E.・ディアス","KM":"រ៉េណា អ៊ី. ឌីអាស់","KO":"레이나 E. 디아즈","MN":"РЕЙНА Э. ДИАЗ","MY":"ရေးနာ အီး ဒီယက်ဇ်","RU":"РЕЙНА Э. ДИАС","TE":"రేనా ఈ. డియాజ్","TH":"เรย์นา อี. ดิแอซ","ZH":"蕾娜·E.·迪亞茲"}],"short_name":[{"EN":"REYNA E DIAZ"}],"occupation":[{"BN":"দায়িত্বপ্রাপ্ত","CC":"在職者","EN":"Incumbent","ES":"Titular","FA":"متصدی","GU":"પદાધિકારી","HI":"पदधारी","HY":"Գործող պաշտոնյա","ID":"Petahana","JA":"現職者","KM":"អ្នកកំពុងកាន់តំណែង","KO":"현직자","MN":"Одоогийн албан тушаалтан","MY":"တာဝန်ထမ်းဆောင်ဆဲပုဂ္ဂိုလ်","RU":"Должностное лицо","TE":"ప్రస్తుతం అధికారంలో ఉన్న వ్యక్తి","TH":"ผู้ดำรงตำแหน่ง","TL":"Nanunungkulan","VI":"Đương Nhiệm","ZH":"在職者"}],"statements":[{"ID":"C0002591605E","FullHTML":{"BN":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ (রেইনা ই. ডিয়াজ)-এর বিবৃতি</h1><h2 dir=\"auto\" style=\"text-align: center\">পরিচালনা পর্ষদের সদস্য প্রার্থী,<br dir=\"auto\">ট্রাস্টি এলাকা নং 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE ইউনিফায়েড স্কুল ডিস্ট্রিক্ট</h3><p dir=\"auto\">বয়স: 69</p><p dir=\"auto\">পেশা: পরিচালনা পর্ষদের সদস্য, DUSD ট্রাস্টি 5</p><p dir=\"auto\">প্রায় তিন দশক ধরে, Duarte ইউনিফায়েড স্কুল ডিস্ট্রিক্ট-এর শিক্ষার্থী, পরিবার, ও কমিউনিটির সেবা করতে পারা আমার জন্য অত্যন্ত সম্মানের। শিক্ষা পরিষদে আমার কার্যকাল জুড়ে, আমি শিক্ষার্থীদের সবার আগে রাখার এবং প্রতিটি শিশুর সফল হওয়ার সুযোগ নিশ্চিত করার ব্যাপারে প্রতিশ্রুতিবদ্ধ থেকেছি।</p><p dir=\"auto\" style=\"text-align: justify\">পরিবারগুলোর আস্থা অর্জন করতে পারা আমার সবচেয়ে বড় সম্মানগুলোর একটি। বিগত বছরগুলোতে, আমি অভিভাবকদের প্রশ্ন, উদ্বেগ, এবং সমস্যাগুলো শোনার সুযোগ পেয়েছি এবং পরিবারগুলোকে শিক্ষা ব্যবস্থা বুঝতে ও তাদের সন্তানদের সফলতার জন্য প্রয়োজনীয় সহায়তার ব্যবস্থা করতে সাহায্য করেছি। আমাদের কমিউনিটির মানুষের কথা শোনা, তাদের কাছে সহজে পৌঁছানো, তাদের প্রয়োজন অনুযায়ী সাড়া দেওয়া, এবং নিজের কাজের জন্য জবাবদিহি করা সবসময়ই আমার কাছে খুব গুরুত্বপূর্ণ।</p><p dir=\"auto\" style=\"text-align: justify\">প্রতি বছর আমার সবচেয়ে আনন্দের মুহূর্তগুলোর একটি হলো গ্র্যাজুয়েশন বা সমাবর্তন মঞ্চে দাঁড়িয়ে আমাদের শিক্ষার্থীদের হাতে ডিপ্লোমা তুলে দেওয়া। এই মুহূর্তটি বহু বছরের কঠোর পরিশ্রম, অধ্যবসায়, এবং পরিবার, শিক্ষাবিদ ও আমাদের কমিউনিটির সম্মিলিত অঙ্গীকারের প্রতিফলন। এটি আমাকে মনে করিয়ে দেয়, কেন আমি মানুষের সেবা করার পথ বেছে নিয়েছিলাম এবং কেন প্রতিটি Duarte শিক্ষার্থীকে নিজের স্বপ্ন পূরণে সাহায্য করার জন্য আমি এখনও নিবেদিত।</p><p dir=\"auto\" style=\"text-align: justify\">আমাদের স্কুলগুলোকে আরও শক্তিশালী করার ক্ষেত্রে যে অগ্রগতি হয়েছে, তা নিয়েও আমি গর্বিত। কমিউনিটির সহায়তায় আমাদের বন্ডের মাধ্যমে আমরা স্কুল ক্যাম্পাসগুলো আধুনিক করেছি এবং 21<sup>র্স্ট</sup> শতাব্দীর উপযোগী শিক্ষার পরিবেশ তৈরি করেছি, যা আগামী প্রজন্মের শিক্ষার্থীদেরও উপকার করবে। এই উন্নতিগুলো, সেইসাথে আমাদের এলিমেন্টারি স্কুলগুলোকে K–8 (আট) গ্রেডে রূপান্তর করার বোর্ডের দূরদর্শী সিদ্ধান্ত।</p><p dir=\"auto\"></p>","CC":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ（蕾娜·E.·迪亞茲）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理委員會委員候選人，<br dir=\"auto\">第5託管區</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE 聯合學區</h3><p dir=\"auto\">年齡：69</p><p dir=\"auto\">職業：管理委員會委員，DUSD（Duarte聯合學區）第5託管區</p><p dir=\"auto\">近三十年來，能夠為Duarte聯合學區的學生、家庭和社區服務，一直是我的榮幸。在教育委員會任職的這些年裡，我始終致力於將學生放在首位，並確保每位孩子都有成功的機會。</p><p dir=\"auto\" style=\"text-align: justify\">贏得家庭的信任，一直是我最大的榮幸之一。這些年來，我有機會傾聽家長的問題、憂慮和挑戰，協助家庭了解學校系統的運作，並連結孩子所需要的資源。傾聽並對我們的社區保持親和、積極回應和負責，對我來說一直非常重要。</p><p dir=\"auto\" style=\"text-align: justify\">每年，我最大的喜悅之一，就是站在畢業典禮舞台上，為我們的學生頒發畢業證書。那一刻代表著多年的努力、堅持，以及家庭、教育工作者和社區的共同承諾。這提醒著我，為什麼我選擇服務，也提醒著我，為什麼我始終致力於幫助每一位Duarte學生實現他們的夢想。</p><p dir=\"auto\" style=\"text-align: justify\">我也為我們在強化學校方面所取得的進展感到自豪。感謝社區對我們公債的支持，我們已經現代化了校園，並打造了21世紀的學習環境，讓我們的學生受益數個世代。這些改善，加上委員會審慎決定將我們的小學轉型為K-8學制</p><p dir=\"auto\"></p>\n","EN":"<h1 dir=\"auto\" style=\"text-align: center\">STATEMENT OF REYNA E. DIAZ</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATE FOR GOVERNING BOARD MEMBER,<br dir=\"auto\">Trustee Area No. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE UNIFIED SCHOOL DISTRICT</h3><p dir=\"auto\">Age: 69</p><p dir=\"auto\">Occupation: Governing Board Member, DUSD Trustee 5</p><p dir=\"auto\">For almost three decades, it has been my privilege to serve the students, families, and community of Duarte Unified School District. Throughout my years on the Board of Education, I have remained committed to putting students first and ensuring every child has the opportunity to succeed.</p><p dir=\"auto\">One of the greatest honors has been earning the trust of families. Over the years, I have had the opportunity to listen to parents' questions, concerns, and challenges, helping families navigate the school system and connect with the resources their children need to succeed. Listening and being accessible, responsive, and accountable to our community has always been very important to me.</p><p dir=\"auto\">One of my greatest joys each year is standing on the graduation stage and presenting diplomas to our students. That moment represents years of hard work, perseverance, and the shared commitment of families, our educators, and our community. It reminds me why I chose to serve and why I remain dedicated to helping every Duarte student achieve their dreams.</p><p dir=\"auto\">I am also proud of the progress we have made in strengthening our schools. Thanks to the community's support of our bond, we have modernized campuses and created 21st-century learning environments that will benefit our students for generations to come. These improvements, along with the Board's thoughtful decision to transition our elementary schools to K–8</p><p dir=\"auto\"></p><p><br /></p><h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE REYNA E. DIAZ</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATA PARA MIEMBRO DE LA JUNTA GUBERNATIVA,<br dir=\"auto\">Área Sindical N.° 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DISTRITO ESCOLAR UNIFICADO DE DUARTE</h3><p dir=\"auto\">Edad: 69</p><p dir=\"auto\">Ocupación: Miembro de la Junta Gubernativa, Síndica 5 del DUSD (Distrito Escolar Unificado de Duarte)</p><p dir=\"auto\">Durante casi tres décadas, ha sido un privilegio para mí servir a los estudiantes, las familias y la comunidad del Distrito Escolar Unificado de Duarte. A lo largo de mis años en la Junta de Educación, me he mantenido comprometida con dar prioridad a los estudiantes y garantizar que cada niño tenga la oportunidad de triunfar.</p><p dir=\"auto\">Uno de los mayores honores ha sido ganarme la confianza de las familias. A lo largo de los años, he tenido la oportunidad de escuchar las preguntas, inquietudes y desafíos de los padres, ayudando a las familias a desenvolverse en el sistema escolar y a conectarse con los recursos que sus hijos necesitan para tener éxito. Para mí, escuchar a nuestra comunidad, ser accesible, receptiva y responsable ante ella siempre ha sido muy importante.</p><p dir=\"auto\">Una de mis mayores alegrías cada año es estar en el escenario de la graduación y entregar los diplomas a nuestros estudiantes. Ese momento representa años de arduo trabajo, perseverancia y el compromiso compartido de las familias, nuestros educadores y nuestra comunidad. Me recuerda por qué elegí servir y por qué sigo comprometida a ayudar a cada estudiante de Duarte a alcanzar sus sueños.</p><p dir=\"auto\">También me enorgullece el progreso que hemos logrado en el fortalecimiento de nuestras escuelas. Gracias al apoyo de la comunidad a nuestro programa de bonos, hemos modernizado los campus y creado entornos de aprendizaje del siglo&nbsp;21 que beneficiarán a nuestros estudiantes durante generaciones. Estas mejoras, además de la decisión acertada de la Junta de hacer la transición de nuestras escuelas primarias a K-8</p><p dir=\"auto\"></p>","ES":"<h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE REYNA E. DIAZ</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATA PARA MIEMBRO DE LA JUNTA GUBERNATIVA,<br dir=\"auto\">Área Sindical N.° 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DISTRITO ESCOLAR UNIFICADO DE DUARTE</h3><p dir=\"auto\">Edad: 69</p><p dir=\"auto\">Ocupación: Miembro de la Junta Gubernativa, Síndica 5 del DUSD (Distrito Escolar Unificado de Duarte)</p><p dir=\"auto\">Durante casi tres décadas, ha sido un privilegio para mí servir a los estudiantes, las familias y la comunidad del Distrito Escolar Unificado de Duarte. A lo largo de mis años en la Junta de Educación, me he mantenido comprometida con dar prioridad a los estudiantes y garantizar que cada niño tenga la oportunidad de triunfar.</p><p dir=\"auto\">Uno de los mayores honores ha sido ganarme la confianza de las familias. A lo largo de los años, he tenido la oportunidad de escuchar las preguntas, inquietudes y desafíos de los padres, ayudando a las familias a desenvolverse en el sistema escolar y a conectarse con los recursos que sus hijos necesitan para tener éxito. Para mí, escuchar a nuestra comunidad, ser accesible, receptiva y responsable ante ella siempre ha sido muy importante.</p><p dir=\"auto\">Una de mis mayores alegrías cada año es estar en el escenario de la graduación y entregar los diplomas a nuestros estudiantes. Ese momento representa años de arduo trabajo, perseverancia y el compromiso compartido de las familias, nuestros educadores y nuestra comunidad. Me recuerda por qué elegí servir y por qué sigo comprometida a ayudar a cada estudiante de Duarte a alcanzar sus sueños.</p><p dir=\"auto\">También me enorgullece el progreso que hemos logrado en el fortalecimiento de nuestras escuelas. Gracias al apoyo de la comunidad a nuestro programa de bonos, hemos modernizado los campus y creado entornos de aprendizaje del siglo&nbsp;21 que beneficiarán a nuestros estudiantes durante generaciones. Estas mejoras, además de la decisión acertada de la Junta de hacer la transición de nuestras escuelas primarias a K-8</p><p dir=\"auto\"></p>","FA":"<h1 dir=\"rtl\" style=\"text-align: center\">بیانیه REYNA E. DIAZ (ری‌نا اي. دیاز)</h1><h2 dir=\"rtl\" style=\"text-align: center\">کاندیدا برای عضو هیئت حاکمه،<br dir=\"auto\">امین منطقه شماره 5</h2><h3 dir=\"rtl\" style=\"text-align: center\">اتحاد ناحیه مدارس DUARTE</h3><p dir=\"rtl\">سن: 69</p><p dir=\"rtl\">شغل: عضو هیئت حاکمه، امین 5 DUSD (اتحاد ناحیه مدارس Duarte)</p><p dir=\"rtl\">تقریباً سه دهه، افتخار خدمت به دانش‌ آموزان، خانواده‌ها و جامعه‌ اتحاد ناحیه مدارس Duarte را داشته‌ام. در طول سال‌های حضورم در هیئت‌ مدیره آموزش و پرورش، متعهد بوده‌ام که دانش‌آموزان را در اولویت قرار دهم و اطمینان حاصل کنم که هر کودکی فرصت موفقیت دارد.</p><p dir=\"rtl\">یکی از بزرگ‌ترین افتخاراتم جلب اعتماد خانواده‌ها بوده است. در طول این سال‌ها، فرصت داشته‌ام که به سؤالات، دغدغه‌ها و چالش‌های والدین گوش دهم، به خانواده‌ها کمک کنم تا با سیستم مدرسه آشنا شوند و با منابع لازم برای موفقیت فرزندانشان ارتباط برقرار کنند. گوش دادن و در دسترس بودن، پاسخ‌گو و مسئولیت‌ پذیر بودن در قبال جامعه‌مان همیشه برای من بسیار مهم بوده است.</p><p dir=\"rtl\">یکی از بزرگ‌ترین لذت‌های من هر سال ایستادن روی صحنه مراسم فارغ‌ التحصیلی و اهدای دیپلم به دانش‌ آموزانمان است. آن لحظه، نشان‌ دهنده سال‌ها سخت‌ کوشی، پشتکار و تعهد مشترک خانواده‌ها، مدرسان ما و جامعه ماست. این به من یادآوری می‌کند که چرا خدمت کردن را انتخاب کردم و چرا همچنان متعهد به کمک به هر دانش‌آموز Duarte برای تحقق رؤیاهایش هستم.</p><p dir=\"rtl\">همچنین به پیشرفتی که در تقویت مدارسمان داشته‌ایم افتخار می‌کنم. به لطف حمایت جامعه از پیوند ما، دانشگاه‌ها را مدرن کرده‌ایم و محیط‌های یادگیری مناسب قرن بیست‌و‌یکم ساخته‌ایم که برای چند نسل آینده از دانش‌آموزانمان مفید خواهد بود. این پیشرفت‌ها، همراه با تصمیم مدبرانه هیئت‌مدیره برای انتقال مدارس ابتدایی ما به مهدکودک تا کلاس هشتم</p><p dir=\"rtl\"></p>","GU":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ (રેયના ઈ. ડિઆઝ) નું નિવેદન</h1><h2 dir=\"auto\" style=\"text-align: center\">સંચાલક મંડળ સભ્ય માટેના ઉમેદવાર,<br dir=\"auto\">ટ્રસ્ટી એરિયા નં. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE એકીકૃત શાળા જિલ્લો</h3><p dir=\"auto\">ઉંમર: 69</p><p dir=\"auto\">વ્યવસાય: સંચાલક મંડળ સભ્ય, DUSD (Duarte એકીકૃત શાળા જિલ્લો) ટ્રસ્ટી 5</p><p dir=\"auto\">લગભગ ત્રણ દાયકાથી, Duarte એકીકૃત શાળા જિલ્લાના વિદ્યાર્થીઓ, પરિવારો, અને સમુદાયની સેવા કરવાનો મને લહાવો મળ્યો છે. શિક્ષણ મંડળમાં મારા વર્ષો દરમિયાન, હું વિદ્યાર્થીઓને પ્રથમ રાખવા અને દરેક બાળકને સફળ થવાની તક મળે તે સુનિશ્ચિત કરવા માટે પ્રતિબદ્ધ રહી છું.</p><p dir=\"auto\">પરિવારોનો વિશ્વાસ જીતવો એ સૌથી મોટા સન્માનોમાંનો એક રહ્યું છે. વર્ષોથી,મને માતાપિતાના પ્રશ્નો, ચિંતાઓ, અને પડકારો સાંભળવાની તક મળી છે, જેનાથી પરિવારોને શાળા પ્રણાલીને સમજવામાં અને તેમના બાળકોને સફળ થવા માટે જરૂરી સંસાધનો સાથે જોડાવામાં મદદ મળી છે. આપણા સમુદાયને સાંભળવું અને સુલભ, પ્રતિભાવશીલ, અને જવાબદાર બનવું મારા માટે હંમેશા ખૂબ જ મહત્વપૂર્ણ રહ્યું છે.</p><p dir=\"auto\">દર વર્ષે મારા સૌથી મોટા આનંદમાંથી એક એ છે કે હું સ્નાતકતાના મંચ પર ઊભી રહીને આપણાં વિદ્યાર્થીઓને ડિપ્લોમા આપીશ. તે ક્ષણ વર્ષોની સખત મહેનત, ખંત, અને પરિવારો, આપણા કેળવણીકાર અને આપણા સમુદાયની સહિયારી પ્રતિબદ્ધતાને દર્શાવે છે. તે મને યાદ અપાવે છે કે મેં શા માટે સેવા કરવાનું પસંદ કર્યું અને શા માટે હું દરેક Duarte વિદ્યાર્થીને તેમના સપનાઓ પ્રાપ્ત કરવામાં મદદ કરવા માટે સમર્પિત છું.</p><p dir=\"auto\">આપણી શાળાઓને મજબૂત બનાવવામાં આપણે જે પ્રગતિ કરી છે તેનો મને ગર્વ છે. સમુદાય દ્વારા આપણાં બંધનના સમર્થનને આભારી, અમે કેમ્પસીસનું આધુનિકીકરણ કર્યું છે અને 21મી- સદીના શિક્ષણ વાતાવરણનું નિર્માણ કર્યું છે જે આવનારી પેઢીઓ માટે આપણાં વિદ્યાર્થીઓને લાભદાયી રહેશે. આ સુધારાઓ, આપણી પ્રાથમિક શાળાઓને K–8 માં સ્થાનાંતરિત કરવાના મંડળના વિચારશીલ નિર્ણય સાથે સંરેખિત છે</p><p dir=\"auto\"></p>","HI":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ (रेना ई. डियाज़) का वक्तव्य</h1><h2 dir=\"auto\" style=\"text-align: center\">गवर्निंग बोर्ड सदस्या के लिए उम्मीदवार,<br dir=\"auto\">ट्रस्टी क्षेत्र सं. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE एकीकृत स्कूल जिला</h3><p dir=\"auto\">उम्र: 69</p><p dir=\"auto\">व्यवसाय: गवर्निंग बोर्ड सदस्या, DUSD (Duarte एकीकृत स्कूल जिला) ट्रस्टी 5</p><p dir=\"auto\">लगभग तीन दशकों से, Duarte एकीकृत स्कूल जिले के छात्रों, परिवारों और समुदाय की सेवा करना मेरे लिए सौभाग्य की बात रही है। शिक्षा बोर्ड में अपने कार्यकाल के दौरान, मैं हमेशा छात्रों को सर्वोपरि रखने और यह सुनिश्चित करने के लिए प्रतिबद्ध रही हूँ कि प्रत्येक बच्चे को सफल होने का अवसर मिले।</p><p dir=\"auto\">परिवारों का भरोसा हासिल करना सबसे बड़े सम्मानों में से एक रहा है। पिछले कुछ वर्षों में, मुझे अभिभावकों के प्रश्नों, चिंताओं और चुनौतियों को सुनने का अवसर मिला है, जिससे परिवारों को स्कूल प्रणाली को समझने और अपने बच्चों की सफलता के लिए आवश्यक संसाधनों से जुड़ने में मदद मिली है। अपने समुदाय की बात सुनना और उनके लिए सुलभ, उत्तरदायी और जवाबदेह होना मेरे लिए हमेशा से बहुत महत्वपूर्ण रहा है।</p><p dir=\"auto\">हर साल दीक्षांत समारोह के मंच पर खड़े होकर अपने छात्रों को डिप्लोमा प्रदान करना मेरी सबसे बड़ी खुशियों में से एक है। वह क्षण वर्षों की कड़ी मेहनत, दृढ़ता और परिवारों, हमारे अध्यापकों और हमारे समुदाय की साझा प्रतिबद्धता का प्रतीक है। यह मुझे याद दिलाता है कि मैंने सेवा करने का विकल्प क्यों चुना और मैं Duarte के प्रत्येक छात्र को उनके सपनों को साकार करने में मदद करने के लिए क्यों समर्पित हूँ।</p><p dir=\"auto\">अपने स्कूलों को मजबूत बनाने में हमने जो प्रगति की है, उस पर भी मुझे गर्व है। हमारे संगठन को समुदाय से मिले समर्थन के बदौलत, हमने परिसरों का आधुनिकीकरण किया है और 21वीं सदी के शिक्षण के ऐसे माहौल बनाए हैं जिनसे आने वाली पीढ़ियों के हमारे छात्रों को लाभ मिलेगा। इन सुधारों के साथ-साथ बोर्ड द्वारा हमारे प्राथमिक विद्यालयों को K–8 में परिवर्तित करने का दूरदर्शी निर्णय भी सहायक सिद्ध हुआ है।</p><p dir=\"auto\"></p>","HY":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ-Ի (ՌԵՅՆԱ Է. ԴԻԱՍ) ՀԱՅՏԱՐԱՐՈՒԹՅՈՒՆԸ</h1><h2 dir=\"auto\" style=\"text-align: center\">ԿԱՌԱՎԱՐՄԱՆ ԽՈՐՀՐԴԻ ԱՆԴԱՄԻ ԹԵԿՆԱԾՈՒ,<br dir=\"auto\">Հոգաբարձու գոտի համար 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE ՄԻԱՑՅԱԼ ԴՊՐՈՑԱԿԱՆ ՇՐՋԱՆ</h3><p dir=\"auto\">Տարիքը՝ 69</p><p dir=\"auto\">Պաշտոնը՝ Կառավարման խորհրդի անդամ, DUSD-ի (Duarte Միացյալ դպրոցական շրջան) հոգաբարձու գոտի համար 5</p><p dir=\"auto\">Գրեթե երեք տասնամյակ շարունակ ինձ համար պատիվ է եղել ծառայել Duarte-ի միացյալ դպրոցական շրջանի աշակերտներին, ընտանիքներին և համայնքին։ Կրթության խորհրդում աշխատելու ողջ ընթացքում հավատարիմ եմ մնացել աշակերտներին առաջնահերթություն տալու և յուրաքանչյուր երեխայի հաջողության հասնելու հնարավորություն ապահովելու սկզբունքին։</p><p dir=\"auto\" style=\"text-align: justify\">Ամենամեծ պատիվներից մեկը ընտանիքների վստահությունը վաստակելն է եղել։ Տարիների ընթացքում հնարավորություն եմ ունեցել լսելու ծնողների հարցերը, մտահոգությունները և մարտահրավերները՝ օգնելով ընտանիքներին կողմնորոշվել դպրոցական համակարգում և կապ հաստատել այն ռեսուրսների հետ, որոնք իրենց երեխաներին անհրաժեշտ են հաջողության հասնելու համար։ Մեր համայնքին լսելը, նրան հասանելի, արձագանքող և հաշվետու լինելը միշտ շատ կարևոր է եղել ինձ համար։</p><p dir=\"auto\" style=\"text-align: justify\">Ամեն տարի իմ ամենամեծ ուրախություններից մեկը ավարտական միջոցառման բեմի վրա կանգնելն ու մեր աշակերտներին դիպլոմներ հանձնելն է։ Այդ պահը խորհրդանշում է տարիների քրտնաջան աշխատանքը, համառությունը և ընտանիքների, մեր մանկավարժների և մեր համայնքի համատեղ նվիրվածությունը։ Սա ինձ հիշեցնում է, թե ինչու որոշեցի ծառայել համայնքին և ինչու եմ շարունակում նվիրված մնալ Duarte-ի յուրաքանչյուր աշակերտի՝ օգնելով նրանց իրականացնել իրենց երազանքները։</p><p dir=\"auto\" style=\"text-align: justify\">Նաև հպարտ եմ մեր դպրոցների ամրապնդման գործում մեր արձանագրած առաջընթացով։ Համայնքի կողմից մեր պարտատոմսերի ծրագրին ցուցաբերած աջակցության շնորհիվ մենք արդիականացրել ենք ուսումնական տարածքները և ստեղծել 21-րդ դարի կրթական միջավայրեր, որոնք գալիք սերունդների ընթացքում կշարունակեն ծառայել մեր սովորողների բարօրությանը։ Այս բարելավումները, ինչպես նաև խորհրդի ողջամիտ որոշումը՝ մեր տարրական դպրոցները K-8-ի (մանկապարտեզից մինչև 8-րդ դասարան) անցնելու վերաբերյալ </p><p dir=\"auto\"></p>","ID":"<h1 dir=\"auto\" style=\"text-align: center\">PERNYATAAN REYNA E. DIAZ</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDAT UNTUK ANGGOTA DEWAN PENGURUS,<br dir=\"auto\">Daerah Pengawas No. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DISTRIK SEKOLAH TERPADU DUARTE</h3><p dir=\"auto\">Usia: 69</p><p dir=\"auto\">Pekerjaan: Anggota Dewan Pengurus, Pengawas DUSD (Distrik Sekolah Terpadu Duarte) 5</p><p dir=\"auto\">Selama hampir tiga dekade, merupakan suatu kehormatan bagi saya untuk melayani para siswa, keluarga, dan komunitas Distrik Sekolah Terpadu Duarte. Sepanjang tahun-tahun saya di Dewan Pendidikan, saya tetap berkomitmen untuk mengutamakan para siswa dan memastikan setiap anak memiliki kesempatan untuk sukses.</p><p dir=\"auto\">Salah satu kehormatan terbesar adalah mendapatkan kepercayaan dari keluarga. Selama bertahun-tahun, saya berkesempatan mendengarkan pertanyaan-pertanyaan, kekhawatiran, dan tantangan para orang tua, membantu keluarga menavigasi sistem sekolah dan terhubung dengan sumber daya yang dibutuhkan anak-anak mereka untuk berhasil. Mendengarkan dan bersikap mudah diakses, responsif, serta bertanggung jawab kepada komunitas kita selalu menjadi hal yang sangat penting bagi saya.</p><p dir=\"auto\">Salah satu kebahagiaan terbesar saya setiap tahun adalah berdiri di panggung wisuda dan menyerahkan ijazah kepada para siswa kami. Momen itu mewakili kerja keras selama bertahun-tahun, ketekunan, dan komitmen bersama dari para keluarga, pendidik, dan komunitas kita. Hal ini mengingatkan saya mengapa saya memilih untuk mengabdi dan mengapa saya tetap berdedikasi untuk membantu setiap siswa Duarte meraih impian mereka.</p><p dir=\"auto\">Saya juga bangga dengan kemajuan yang telah kita capai dalam memperkuat sekolah-sekolah kita. Berkat dukungan komunitas terhadap komitmen kami, kami telah memodernisasi kampus dan menciptakan lingkungan pembelajaran abad ke-21 yang akan bermanfaat bagi para siswa kita untuk generasi mendatang. Perbaikan-perbaikan ini, bersama dengan keputusan bijaksana Dewan untuk mentransisikan sekolah dasar kita ke sistem K–8</p><p dir=\"auto\"></p>","JA":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ（レイナ・E.・ディアス）の声明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理役員会役員の候補者、<br dir=\"auto\">管財区番号５</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE統一学区</h3><p dir=\"auto\">年齢：69歳</p><p dir=\"auto\">職業：管理役員会役員、DUSD（Duarte統一学区）管財委員 5</p><p dir=\"auto\">約三十年間にわたり、Duarte統一学区の生徒、家族、地域社会に奉仕できたことを光栄に思います。教育委員会での在任期間を通じて、私は学生を第一に考え、すべての子どもが成功する機会を確実に得られるよう尽力してきました。</p><p dir=\"auto\">最も大きな栄誉の一つは、家族からの信頼を得られたことです。これまで、保護者の質問、懸念、課題に耳を傾け、家族が学校制度を利用し、子どもたちの成功に必要な支援につながれるよう取り組む機会を得てきました。地域社会の声に耳を傾け、いつでも相談でき、迅速に対応し、説明責任を果たすことは、私にとって常に非常に重要なことでした。</p><p dir=\"auto\">毎年、卒業式の壇上に立ち、生徒たちに卒業証書を授与することは、私にとって最大の喜びの一つです。その瞬間には、何年にもわたる努力と忍耐、そして家族、教育関係者、地域社会が共に尽くしてきた思いが表れています。その瞬間は、なぜ私が奉仕することを選んだのか、そしてなぜすべてのDuarteの生徒が夢を実現できるよう支援することに今も尽力しているのかを思い起こさせてくれます。</p><p dir=\"auto\">また、私たちが学校の強化において成し遂げてきた進展を誇りに思います。地域社会が私たちの公債を支持してくださったおかげで、私たちは学校施設を近代化し、これから何世代にもわたって学生たちのためになる21世紀型の学習環境を整備してきました。これらの改善に加え、教育委員会は慎重に検討したうえで、私たちの小学校を幼稚園から８年生までの学校へ移行することを決定しました。</p>","KM":"<h1 dir=\"auto\" style=\"text-align: center\">សេចក្តីថ្លែងការណ៍របស់ REYNA E. DIAZ (រ៉េណា អ៊ី. ឌីអាស់)</h1><h2 dir=\"auto\" style=\"text-align: center\">បេក្ខជនសំរាប់ សមាជិកគណៈកម្មការគ្រប់គ្រង,<br dir=\"auto\">ប្រឹក្សា​ភិបាល​តំបន់​លេខ 5</h2><h3 dir=\"auto\" style=\"text-align: center\">មណ្ឌលសិក្សា​ធិការ​រួបរួម DUARTE</h3><p dir=\"auto\">អាយុ ៖ 69 ឆ្នាំ</p><p dir=\"auto\">មុខរបរ ៖ សមាជិកគណៈកម្មការគ្រប់គ្រង, ប្រឹក្សា​ភិបាល​ DUSD (មណ្ឌលសិក្សាធិការរួបរួម Duarte​) 5</p><p dir=\"auto\">អស់រយៈពេលជិតបីទសវត្សរ៍ វាជាឯកសិទ្ធិរបស់ខ្ញុំក្នុងការបម្រើសិស្សានុសិស្ស គ្រួសារ និងសហគមន៍នៃមណ្ឌលសិក្សាធិការរួបរួម Duarte ។ ពេញមួយឆ្នាំនៃការបម្រើការងាររបស់ខ្ញុំនៅក្នុងគណៈកម្មការអប់រំ ខ្ញុំនៅតែបន្តប្តេជ្ញាចិត្តក្នុងការដាក់សិស្សានុសិស្សជាអាទិភាព និងធានាថាកុមារគ្រប់រូបមានឱកាសដើម្បីទទួលបានជោគជ័យ ។</p><p dir=\"auto\" style=\"text-align: justify\">កិត្តិយសដ៏ធំបំផុតមួយគឺការទទួលបានការទុកចិត្តពីគ្រួសារនានា ។ ក្នុងរយៈពេលប៉ុន្មានឆ្នាំកន្លងមកនេះ ខ្ញុំមានឱកាសស្តាប់សំណួរ ក្តីព្រួយបារម្ភ និងបញ្ហាប្រឈមរបស់មាតាបិតា ដោយជួយគ្រួសារនានាក្នុងការស្វែងយល់ពីប្រព័ន្ធសាលារៀន និងភ្ជាប់ទំនាក់ទំនងជាមួយនឹងធនធានដែលកូនៗរបស់ពួកគេត្រូវការដើម្បីទទួលបានជោគជ័យ ។ ការស្តាប់ និងការងាយស្រួលក្នុងការទាក់ទង ការឆ្លើយតប និងមានគណនេយ្យភាពចំពោះសហគមន៍របស់យើង គឺតែងតែមានសារៈសំខាន់ខ្លាំងណាស់សម្រាប់ខ្ញុំ ។</p><p dir=\"auto\" style=\"text-align: justify\">សេចក្តីអំណរដ៏អស្ចារ្យបំផុតមួយរបស់ខ្ញុំជារៀងរាល់ឆ្នាំ គឺការឈរនៅលើឆាកប្រគល់សញ្ញាបត្រ និងការផ្តល់សញ្ញាបត្រដល់សិស្សានុសិស្សរបស់យើង ។ ពេលវេលានោះតំណាងឱ្យការខិតខំប្រឹងប្រែង ការតស៊ូព្យាយាមជាច្រើនឆ្នាំ និងការប្តេជ្ញាចិត្តរួមគ្នារបស់គ្រួសារ អ្នកអប់រំរបស់យើង និងសហគមន៍របស់យើង ។ វារំលឹកខ្ញុំពីមូលហេតុដែលខ្ញុំបានជ្រើសរើសបម្រើការ និងមូលហេតុដែលខ្ញុំនៅតែលះបង់ដើម្បីជួយសិស្សានុសិស្សនៅ Duarte គ្រប់រូបឱ្យសម្រេចបាននូវក្តីសុបិនរបស់ពួកគេ ។</p><p dir=\"auto\" style=\"text-align: justify\">ខ្ញុំក៏មានមោទនភាពចំពោះវឌ្ឍនភាពដែលយើងបានធ្វើឡើងក្នុងការពង្រឹងសាលារៀនរបស់យើង ។ ដោយសារតែការគាំទ្ររបស់សហគមន៍លើមូលបត្រប្រាក់កម្ចីរបស់យើង យើងបានធ្វើទំនើបកម្មបរិវេណសាលា និងបានបង្កើតបរិយាកាសសិក្សានៅសតវត្សទី 21 ដែលនឹងផ្តល់អត្ថប្រយោជន៍ដល់សិស្សានុសិស្សរបស់យើងសម្រាប់មនុស្សជំនាន់ក្រោយៗទៀត ។ ការកែលម្អទាំងនេះ រួមជាមួយនឹងការសម្រេចចិត្តដ៏ម៉ត់ចត់របស់គណៈកម្មការក្នុងការផ្លាស់ប្តូរសាលាបឋមសិក្សារបស់យើងទៅជាថ្នាក់ K–8</p><p dir=\"auto\"></p>","KO":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ (레이나 E. 디아즈) 의 성명서</h1><h2 dir=\"auto\" style=\"text-align: center\">이사회 이사 후보,<br dir=\"auto\">이사 구역 번호 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE 통합교육구</h3><p dir=\"auto\">연령: 69</p><p dir=\"auto\">직업: 이사회 이사, DUSD (Duarte 통합교육구) 이사 구역 5</p><p dir=\"auto\">거의 삼십 년 동안, 저는 Duarte 통합교육구의 학생, 가족, 커뮤니티를 위해 봉사할 수 있는 특권을 누렸습니다. 교육위원회에서 재직하는 동안 학생들을 최우선으로 생각하고 모든 아이들이 성공할 기회를 가질 수 있도록 최선을 다했습니다.</p><p dir=\"auto\">가장 큰 영광 중 하나는 가족들의 신뢰를 얻는 것이었습니다. 지난 몇 년간 저는 학부모님들의 질문, 걱정, 고충을 경청하며, 가족들이 학교 체계를 잘 이해하고 자녀의 성공에 필요한 자원을 얻도록 도울 수 있었습니다. 저는 항상 우리 커뮤니티의 목소리에 귀 기울이고, 소통할 수 있도록 열려 있으며, 신속하게 대응하고 책임을 다하는 것을 매우 중요하게 생각했습니다.</p><p dir=\"auto\">매년 제가 가장 큰 기쁨을 느끼는 순간 중 하나는 졸업식 무대에 서서 학생들에게 졸업장을 수여하는 순간입니다. 그 순간은 수년간의 노고와 인내, 그리고 가족, 교육자, 우리 커뮤니티의 공동의 헌신을 상징합니다. 이는 제가 봉사를 선택한 이유와 모든 Duarte 학생들이 꿈을 이루도록 돕는 데 헌신하는 이유를 다시금 일깨워줍니다.</p><p dir=\"auto\">저는 또한 우리 학교들이 더욱 발전할 수 있도록 노력해 온 것을 자랑스럽게 생각합니다. 발행한 채권에 대한 커뮤니티의 지지 덕분에 우리는 캠퍼스를 현대화하고 21세기형 학습 환경을 조성했으며, 이는 앞으로 여러 세대에 걸쳐 학생들에게 큰 도움이 될 것입니다. 초등학교를 K-8(유치원부터 8학년까지) 과정으로 전환하기로 한 이사회의 신중한 결정과 더불어 이러한 개선 사항들은</p><p dir=\"auto\"></p>","MN":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ (РЕЙНА Э. ДИАЗ)-ИЙН МЭДЭГДЭЛ</h1><h2 dir=\"auto\" style=\"text-align: center\">УДИРДАХ ЗӨВЛӨЛИЙН ГИШҮҮНД НЭР ДЭВШИГЧ,<br dir=\"auto\">Итгэмжлэгдсэн хэсэг No. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE НЭГДСЭН СУРГУУЛИЙН ДҮҮРЭГ</h3><p dir=\"auto\">Нас: 69</p><p dir=\"auto\">Ажил мэргэжил: Удирдах зөвлөлийн гишүүн, DUSD-ийн (Duarte Нэгдсэн Сургуулийн Дүүрэг) Итгэмжлэгдсэн төлөөлөгч 5</p><p dir=\"auto\">Бараг гучин жилийн турш Duarte Нэгдсэн Сургуулийн Дүүргийн сурагчид, гэр бүлүүд, нийгэмд үйлчлэх нь миний хувьд нэр төрийн хэрэг байлаа. Боловсролын зөвлөлийн гишүүнээр ажилласан он жилүүдийнхээ турш би сурагчдыг нэн тэргүүнд тавьж, хүүхэд бүрд амжилтад хүрэх боломж олгоход анхаарч ирсэн.</p><p dir=\"auto\" style=\"text-align: justify\">Гэр бүлүүдийн итгэлийг хүлээсэн нь миний хувьд хамгийн эрхэм нэр төрийн нэг байсан. Олон жилийн турш би эцэг эхчүүдийн асуулт, санаа зовнил, тулгарч буй бэрхшээлийг сонсож, гэр бүлүүдэд сургуулийн тогтолцоог ойлгоход туслахын зэрэгцээ хүүхдүүдийнх нь амжилтад шаардлагатай нөөц дэмжлэгтэй холбогдоход нь тусалж ирсэн. Олон нийтийнхээ үгийг сонсож, хүртээмжтэй байж, хэрэгцээнд нь шуурхай хариу өгч, олон нийтийн өмнө хариуцлагатай байх нь миний хувьд үргэлж чухал байсаар ирсэн.</p><p dir=\"auto\" style=\"text-align: justify\">Жил бүрийн хамгийн их баяр баясгалантай мөчүүдийн нэг бол төгсөлтийн тайзан дээр гарч, сурагчдадаа диплом гардуулах байдаг. Тэр мөч олон жилийн хичээл зүтгэл, тууштай байдал, гэр бүл, сурган хүмүүжүүлэгчид, манай олон нийтийн хамтын зүтгэлийн үр дүнг илэрхийлдэг. Энэ нь би яагаад бусдад үйлчлэхээр сонгосон, мөн Duarte хотын сурагч бүр мөрөөдөлдөө хүрэхэд нь туслахын төлөө яагаад тууштай ажиллаж байгааг минь сануулдаг.</p><p dir=\"auto\" style=\"text-align: justify\">Би мөн сургуулиудаа бэхжүүлэх чиглэлээр гаргасан ахиц дэвшлээрээ бахархдаг. Олон нийт манай бондыг дэмжсэнээр сургуулийн орчныг шинэчилж, сурагчдад хойч үеийн турш үр өгөөжөө өгөх 21-р зууны сургалтын орчин бүрдүүлж чадсан. Эдгээр сайжруулалтаас гадна Зөвлөл бага сургуулиудыг K–8 (цэцэрлэгээс 8-р анги хүртэл) анги бүхий сургууль болгох талаар нухацтай шийдвэр гаргасан</p><p dir=\"auto\"></p>","MY":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ (ရေးနာ အီး ဒီယက်ဇ်) ၏ ထုတ်ပြန်ချက်</h1><h2 dir=\"auto\" style=\"text-align: center\">အုပ်ချုပ်ရေးဘုတ်အဖွဲ့ဝင်အတွက် ကိုယ်စားလှယ်လောင်း၊<br dir=\"auto\">အုပ်ထိန်းရေး ဧရိယာ အမှတ် 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE စုပေါင်းကျောင်းခရိုင်</h3><p dir=\"auto\">အသက်- 69 နှစ်</p><p dir=\"auto\">အလုပ်အကိုင်- အုပ်ချုပ်ရေးဘုတ်အဖွဲ့ဝင်၊ DUSD (Duarte စုပေါင်းကျောင်းခရိုင်) အုပ်ထိန်းရေး 5</p><p dir=\"auto\">ဆယ်စုနှစ်သုံးခုနီးပါး၊ Duarte စုပေါင်းကျောင်းခရိုင်ရဲ့ ကျောင်းသားတွေ၊ မိသားစုတွေနဲ့ အသိုင်းအဝိုင်းကို ဝန်ဆောင်မှုပေးရတာဟာ ကျွန်ုပ်အတွက် အခွင့်ထူးတစ်ရပ်ဖြစ်ပါတယ်။ ပညာရေးဘုတ်အဖွဲ့တွင် ကျွန်ုပ်၏ သက်တမ်းတစ်လျှောက်တွင် ကျောင်းသားများကို ဦးစားပေးရန်နှင့် ကလေးတိုင်း အောင်မြင်ရန် အခွင့်အရေးရရှိစေရန် ကျွန်ုပ် ကတိပြုထားခဲ့ပါတယ်။</p><p dir=\"auto\">အကြီးမားဆုံးသော ဂုဏ်ယူစရာတစ်ခုမှာ မိသားစုများ၏ ယုံကြည်မှုကို ရရှိခြင်းဖြစ်ပါတယ်။ နှစ်များတစ်လျှောက်တွင်၊ ကျွန်ုပ်အနေဖြင့် မိဘများ၏ မေးခွန်းများ၊ စိုးရိမ်ပူပန်မှုများနှင့် စိန်ခေါ်မှုများကို နားထောင်ရန်၊ မိသားစုများအား ကျောင်းစနစ်ကို လမ်းညွှန်ရန်နှင့် ၎င်းတို့၏ကလေးများ အောင်မြင်ရန် လိုအပ်သော အရင်းအမြစ်များနှင့် ချိတ်ဆက်ရန် ကူညီပေးသည့် အခွင့်အရေးရရှိခဲ့ပါတယ်။ ကျွန်ုပ်တို့၏ အသိုင်းအဝိုင်းအပေါ် နားထောင်ပေးခြင်း၊ အမြဲဆက်သွယ်နိုင်အောင် ပြုလုပ်ခြင်း၊ တုံ့ပြန်မှုကောင်းမွန်ခြင်းနှင့် တာဝန်ခံမှုရှိခြင်းသည် ကျွန်ုပ်အတွက် အမြဲတမ်း အလွန်အရေးကြီးပါတယ်။</p><p dir=\"auto\">နှစ်စဉ် ကျွန်ုပ်၏ အကြီးမားဆုံးသော ပျော်ရွှင်မှုတစ်ခုမှာ ဘွဲ့နှင်းသဘင်စင်မြင့်ပေါ်တွင် ရပ်ပြီး ကျွန်ုပ်တို့၏ ကျောင်းသားများအား ဒီပလိုမာများ ပေးအပ်ခြင်းပင်ဖြစ်ပါတယ်။ အဲဒီအချိန်ဟာ မိသားစုတွေ၊ ကျွန်ုပ်တို့ရဲ့ ပညာရေးသမားတွေနဲ့ ကျွန်ုပ်တို့ရဲ့ အသိုင်းအဝိုင်းရဲ့ နှစ်ပေါင်းများစွာ ကြိုးစားအားထုတ်မှု၊ ဇွဲလုံ့လနဲ့ မျှဝေထားတဲ့ ကတိကဝတ်တွေကို ကိုယ်စားပြုပါတယ်။ ထိုအရာက ကျွန်ုပ်ဘာကြောင့် တာဝန်ထမ်းဆောင်ဖို့ ရွေးချယ်ရတယ်ဆိုတာနဲ့ Duarte ကျောင်းသားတိုင်း သူတို့ရဲ့ အိပ်မက်တွေကို အောင်မြင်အောင် ကူညီပေးဖို့ ဘာကြောင့် ကြိုးစားအားထုတ်နေရတယ်ဆိုတာကို ကျွန်ုပ်ကို သတိပေးနေပါတယ်။</p><p dir=\"auto\">ကျွန်ုပ်တို့ရဲ့ ကျောင်းတွေကို အားကောင်းအောင် လုပ်ဆောင်ရာမှာ ကျွန်ုပ်တို့ ရရှိခဲ့တဲ့ တိုးတက်မှုအတွက်လည်း ဂုဏ်ယူမိပါတယ်။ ကျွန်ုပ်တို့ရဲ့ အသိုင်းအဝိုင်းအပေါ် ငွေချေးစာချုပ်ရဲ့ ပံ့ပိုးမှုကြောင့် ကျွန်ုပ်တို့ဟာ ကျောင်းဝင်းတွေကို ခေတ်မီအောင် ပြုလုပ်ခဲ့ပြီး နောင်လာမယ့် မျိုးဆက်တွေနဲ့ ကျွန်ုပ်တို့ရဲ့ ကျောင်းသားတွေအတွက် အကျိုးရှိစေမယ့် 21 ရာစု သင်ယူမှုပတ်ဝန်းကျင်တွေကို ဖန်တီးနိုင်ခဲ့ပါတယ်။ ဒီတိုးတက်မှုတွေနဲ့အတူ ကျွန်ုပ်တို့ရဲ့ မူလတန်းကျောင်းတွေကို K-8 ကို ကူးပြောင်းဖို့ ဘုတ်အဖွဲ့ရဲ့ ဂရုတစိုက် ဆုံးဖြတ်ချက်ချခဲ့ပါတယ်</p><p dir=\"auto\"></p>","RU":"<h1 dir=\"auto\" style=\"text-align: center\">ЗАЯВЛЕНИЕ REYNA E. DIAZ (РЕЙНА Э. ДИАС)</h1><h2 dir=\"auto\" style=\"text-align: center\">КАНДИДАТ В ЧЛЕНЫ УПРАВЛЯЮЩЕГО СОВЕТА,<br dir=\"auto\">Попечительский участок № 5</h2><h3 dir=\"auto\" style=\"text-align: center\">ОБЪЕДИНЕННЫЙ ШКОЛЬНЫЙ РАЙОН DUARTE</h3><p dir=\"auto\">Возраст: 69</p><p dir=\"auto\">Род занятий: Член управляющего совета, Попечительский участок 5 DUSD (Объединенный школьный район Duarte)</p><p dir=\"auto\">На протяжении почти трех десятилетий я имела честь служить учащимся, их семьям и сообществу Объединенного школьного района Duarte. За годы работы в Совете по вопросам образования я неизменно ставила интересы учеников на первое место и делала все, чтобы у каждого ребенка была возможность добиться успеха.</p><p dir=\"auto\" style=\"text-align: justify\">Для меня было величайшей честью заслужить доверие семей. Все это время я имела возможность выслушивать родителей, их вопросы, тревоги и трудности, помогать семьям разбираться в школьной системе, а детям — получать доступ к нужным ресурсам. Умение слушать, быть доступной, оперативно реагировать и отчитываться перед нашим сообществом всегда было для меня одним из главных приоритетов.</p><p dir=\"auto\" style=\"text-align: justify\">Каждый год для меня одна из величайших радостей — стоять на сцене на выпускном и вручать дипломы нашим ученикам. Этот момент олицетворяет многолетний труд, целеустремленность и единство усилий родителей, педагогов и всех жителей нашего района. Это служит для меня напоминанием о том, почему я избрала путь служения и почему остаюсь верна цели — помочь каждому ученику Duarte воплощать мечты в реальность.</p><p dir=\"auto\" style=\"text-align: justify\">Я также горжусь теми успехами, которых мы добились в укреплении наших школ. Благодаря тому, что сообщество поддержало наш облигационный заем, мы модернизировали кампусы и создали условия для обучения, соответствующие 21-му веку, — и это пойдет на пользу нашим ученикам еще долгие годы. Эти преобразования, а также взвешенное решение Совета о переводе начальных школ на систему K–8 (с детского сада по 8-й класс)</p><p dir=\"auto\"></p>","TE":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ (రేనా ఈ. డియాజ్) స్టేట్‌మెంట్</h1><h2 dir=\"auto\" style=\"text-align: center\">గవర్నింగ్ బోర్డు సభ్యుని కొరకు అభ్యర్థి,<br dir=\"auto\">ధర్మకర్త ప్రాంతం నెంబరు 5</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE ఏకీకృత స్కూలు డిస్ట్రిక్ట్</h3><p dir=\"auto\">వయస్సు: 69</p><p dir=\"auto\">వృత్తి: గవర్నింగ్ బోర్డు సభ్యులు, DUSD (Duarte ఏకీకృత స్కూలు డిస్ట్రిక్ట్) ధర్మకర్త 5</p><p dir=\"auto\">దాదాపు మూడు దశాబ్దాలుగా, Duarte ఏకీకృత స్కూలు డిస్ట్రిక్ట్ విద్యార్థులు, కుటుంబాలు మరియు కమ్యూనిటీకి సేవ చేయడాన్ని నేను సగర్వంగా భావిస్తున్నాను. విద్యా బోర్డులో నా పదవీకాలం వ్యాప్తంగా, విద్యార్థులకే అత్యంత ప్రాధాన్యతనివ్వడానికి మరియు ప్రతి చిన్నారికి విజయం సాధించే అవకాశం లభించేలా చూసేందుకు నేను కట్టుబడి పనిచేశాను.</p><p dir=\"auto\">కుటుంబాల నమ్మకం పొందడం అత్యంత గొప్ప గౌరవాల్లో ఒకటి. గత కొన్నేళ్లుగా, తల్లిదండ్రుల ప్రశ్నలు, ఆందోళనలు మరియు సవాళ్లను వినే అవకాశం నాకు లభించింది. తద్వారా, స్కూలు వ్యవస్థను అర్థం చేసుకోవడంలో, తమ పిల్లల విజయానికి అవసరమైన వనరులు పొందడంలో కుటుంబాలకు నేను సహాయపడగలిగాను. మన కమ్యూనిటీ స్వరం వినడం, వారికి అందుబాటులో ఉండడం, స్పందించడం మరియు జవాబుదారీగా ఉండడం నాకు ఎల్లప్పుడూ చాలా ముఖ్యం.</p><p dir=\"auto\">ప్రతి ఏటా గ్రాడ్యుయేషన్ వేదిక మీద నిలబడి మన విద్యార్థులకు పట్టాలు అందజేయడం నాకు అత్యంత ఆనందాన్నిచ్చే విషయాలలో ఒకటి. ఎన్నో ఏళ్ల కఠోర శ్రమ, పట్టుదల మరియు కుటుంబాలు, విద్యావేత్తలు మరియు మన కమ్యూనిటీ ఉమ్మడి నిబద్ధతకు ఆ క్షణం ప్రతీకగా నిలుస్తుంది. సేవ చేయడానికి నేను ఎందుకు ఎంచుకున్నానో మరియు Duarteలోని ప్రతి విద్యార్థి వారి కలలు సాకారం చేసుకోవడంలో సహాయపడడానికి నేను ఎందుకు అంకితభావంతో ఉన్నానో అది నాకు గుర్తు చేస్తుంది.</p><p dir=\"auto\">మన స్కూళ్లను బలోపేతం చేయడంలో మనం సాధించిన పురోగతి పట్ల కూడా నేను గర్వపడుతున్నాను. మన బంధానికి కమ్యూనిటీ అందించిన మద్దతుతో, ఆధునిక క్యాంపస్‌లు నిర్మించి, రాబోయే తరాల విద్యార్థులకు ప్రయోజనం చేకూర్చే 21వ శతాబ్దపు అభ్యాస వాతావరణాలను మేము సృష్టించాము. ఈ మెరుగుదలలు మరియు మన ప్రాథమిక స్కూళ్ళను K–8 విధానానికి మార్చాలన్నది బోర్డు వారి ఆలోచనాత్మక నిర్ణయం</p><p dir=\"auto\"></p>","TH":"<h1 dir=\"auto\" style=\"text-align: center\">แถลงการณ์ของ REYNA E. DIAZ <br dir=\"auto\">(เรย์นา อี. ดิแอซ)</h1><h2 dir=\"auto\" style=\"text-align: center\">ผู้สมัครรับเลือกตั้งสำหรับตำแหน่งสมาชิกของคณะกรรมการกำกับดูแล<br dir=\"auto\">ทรัสตีพื้นที่หมายเลข 5</h2><h3 dir=\"auto\" style=\"text-align: center\">เขตโรงเรียนร่วม DUARTE</h3><p dir=\"auto\">อายุ: 69</p><p dir=\"auto\">อาชีพ: สมาชิกคณะกรรมการกำกับดูแล ทรัสตีพื้นที่ 5 ของ DUSD (เขตโรงเรียนร่วม Duarte)</p><p dir=\"auto\">ตลอดเกือบสามทศวรรษที่ผ่านมา ถือเป็นเกียรติอย่างยิ่งที่ได้อุทิศตนรับใช้นักเรียน ครอบครัว และชุมชนของเขตโรงเรียนร่วม Duarte ตลอดหลายปีที่ดิฉันดำรงตำแหน่งในคณะกรรมการกำกับดูแลการศึกษา ดิฉันยังคงมุ่งมั่นที่จะให้ความสำคัญกับนักเรียนเป็นอันดับแรก และทำให้มั่นใจว่าเด็กทุกคนมีโอกาสประสบความสำเร็จ</p><p dir=\"auto\">หนึ่งในสิ่งที่เป็นเกียรติที่สุดสำหรับดิฉันคือการได้รับความไว้วางใจจากครอบครัวต่างๆ ตลอดหลายปีที่ผ่านมา ดิฉันมีโอกาสรับฟังคำถามจากผู้ปกครอง ข้อกังวลใจ และความท้าทายที่พวกเขาต้องเผชิญ พร้อมทั้งช่วยให้หลายครอบครัวมีความรู้จักและคุ้นเคยกับระบบต่างๆในโรงเรียน และแนะนำเชื่อมโยงการเข้าถึงทรัพยากรต่างๆ ที่โรงเรียนจัดให้มีเพื่อช่วยเหลือบุตรหลานของพวกเขาให้ประสบความสำเร็จ ดิฉันให้ความสำคัญกับการรับฟัง การพร้อมที่จะพบปะพูดคุย การพร้อมที่จะตอบสนอง และมีรับผิดชอบต่อชุมชนของเรา</p><p dir=\"auto\">หนึ่งในความสุขที่ยิ่งใหญ่ที่สุดของดิฉันในแต่ละปีคือการได้ยืนอยู่บนเวทีในพิธีสำเร็จการศึกษาและมอบประกาศนียบัตรให้แก่นักเรียนของเรา ช่วงเวลานั้นสะท้อนถึงหลายปีแห่งความทุ่มเท ความพากเพียร และความมุ่งมั่นร่วมกันของครอบครัว นักการศึกษา และชุมชนของเรา ช่วงเวลานั้นเตือนให้ดิฉันนึกถึงเหตุผลที่เลือกอุทิศตนรับใช้ชุมชน และเหตุผลที่ดิฉันยังคงมุ่งมั่นที่จะช่วยให้นักเรียนทุกคนใน Duarte บรรลุความฝันของตนเอง</p><p dir=\"auto\">ดิฉันยังภูมิใจกับความก้าวหน้าที่เราได้สร้างขึ้นเพื่อเสริมสร้างโรงเรียนของเราให้แข็งแกร่งยิ่งขึ้น ขอขอบคุณชุมชนที่ได้ช่วยกันสนับสนุนมาตรการออกพันธบัตรเพื่อเขตโรงเรียนของเรา เราได้ปรับปรุงสถานศึกษาให้ทันสมัย และสร้างสภาพแวดล้อมการเรียนรู้แห่งศตวรรษที่ 21 ซึ่งจะเป็นประโยชน์ต่อนักเรียนของเราไปอีกหลายรุ่น การปรับปรุงเหล่านี้ รวมถึงการตัดสินใจอย่างรอบคอบของคณะกรรมการกำกับดูแลในการขยายเขตโรงเรียนของเราให้ครอบคลุมจากระดับประถมเป็นโรงเรียนระดับ K–8</p><p dir=\"auto\"></p>","TL":"<h1 dir=\"auto\" style=\"text-align: center\">PAHAYAG NI REYNA E. DIAZ</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDATO PARA MIYEMBRO NG NAMAMAHALANG LUPON,<br dir=\"auto\">Lugar ng Katiwala Blg. 5</h2><h3 dir=\"auto\" style=\"text-align: center\">PINAG-ISANG DISTRITO NG PAARALAN NG DUARTE</h3><p dir=\"auto\">Edad: 69</p><p dir=\"auto\">Trabaho: Miyembro ng Namamahalang Lupon, Katiwala ng DUSD (Pinag-isang Distrito ng Paaralan ng Duarte) 5</p><p dir=\"auto\">Sa loob ng halos tatlong dekada, naging pribilehiyo ko ang maglingkod sa mga mag-aaral, pamilya, at komunidad ng Pinag-isang Distrito ng Paaralan ng Duarte. Sa buong taon ng aking panunungkulan sa Lupon ng Edukasyon, nanatili akong nakatuon sa pag-una sa mga mag-aaral at pagtiyak na ang bawat bata ay may pagkakataong magtagumpay.</p><p dir=\"auto\">Isa sa mga pinakadakilang karangalan ay ang pagkamit ng tiwala ng mga pamilya. Sa paglipas ng mga taon, nagkaroon ako ng pagkakataong makinig sa mga tanong, alalahanin, at hamon ng mga magulang, na tumutulong sa mga pamilya na maunawaan ang sistema ng paaralan at kumonekta sa mga mapagkukunang kailangan ng kanilang mga anak upang magtagumpay. Ang pakikinig at pagiging madaling maintindihan, madaling tumugon, at may pananagutan sa ating komunidad ay palaging napakahalaga para sa akin.</p><p dir=\"auto\">Isa sa mga pinakamalaking kagalakan ko bawat taon ay ang pagtayo sa entablado ng pagtatapos at pagbibigay ng mga diploma sa ating mga mag-aaral. Ang sandaling iyon ay kumakatawan sa mga taon ng pagsusumikap, pagtitiyaga, at sa ibinahaging dedikasyon ng mga pamilya, ng ating mga edukador, at ng ating komunidad. Ipinapaalala nito sa akin kung bakit ko piniling maglingkod at kung bakit nananatiling dedikado ako sa pagtulong sa bawat mag-aaral ng Duarte na makamit ang kanilang mga pangarap.</p><p dir=\"auto\">Ipinagmamalaki ko rin ang mga pag-unlad na nagawa natin sa pagpapalakas ng ating mga paaralan. Dahil sa suporta ng komunidad sa ating ugnayan, nagawa nating moderno ang mga kampus at nakalikha ng mga kapaligirang pang-edukasyon para sa ika-21 na siglo na makikinabang sa ating mga mag-aaral sa mga susunod na henerasyon. Ang mga pagpapabuting ito, kasama ang maingat na desisyon ng Lupon na ilipat ang ating mga paaralang elementarya patungong K–8 (Kindergarten hanggang ikawalong baitang)</p><p dir=\"auto\"></p>","VI":"<h1 dir=\"auto\" style=\"text-align: center\">BÀI PHÁT BIỂU CỦA REYNA E. DIAZ</h1><h2 dir=\"auto\" style=\"text-align: center\">ỨNG CỬ VIÊN CHO CHỨC VỤ ỦY VIÊN HỘI ĐỒNG QUẢN TRỊ,<br dir=\"auto\">Chưởng Quản Khu Số 5</h2><h3 dir=\"auto\" style=\"text-align: center\">KHU HỌC CHÁNH THỐNG NHẤT DUARTE</h3><p dir=\"auto\">Tuổi: 69</p><p dir=\"auto\">Nghề Nghiệp: Ủy Viên Hội Đồng Quản Trị, Chưởng Quản Khu  5 của DUSD (Khu Học Chánh Thống Nhất Duarte)</p><p dir=\"auto\">Trong gần ba thập kỷ qua, tôi rất vinh dự được phục vụ học sinh, gia đình, và cộng đồng của Khu Học Chánh Thống Nhất Duarte. Trong suốt những năm tháng làm việc tại Hội Đồng Giáo Dục, tôi luôn cam kết đặt lợi ích của học sinh lên hàng đầu và đảm bảo mọi đứa trẻ đều có cơ hội thành công.</p><p dir=\"auto\">Một trong những vinh dự lớn nhất của tôi là giành được sự tin tưởng của các gia đình. Trong những năm qua, tôi đã có cơ hội lắng nghe những câu hỏi, mối lo ngại, và khó khăn của phụ huynh, giúp các gia đình định hướng trong hệ thống trường học và kết nối với các nguồn lực mà con cái họ cần để thành công. Việc lắng nghe và sẵn sàng tiếp nhận, phản hồi, và có trách nhiệm với cộng đồng luôn là điều rất quan trọng đối với tôi.</p><p dir=\"auto\">Một trong những niềm vui lớn nhất của tôi mỗi năm là được đứng trên bục lễ tốt nghiệp và trao bằng cho các học sinh. Khoảnh khắc đó ghi dấu những năm tháng làm việc chăm chỉ, kiên trì, và tinh thần cam kết đồng lòng của các gia đình, nhà giáo dục, và cộng đồng chúng ta. Điều đó nhắc nhở tôi lý do tại sao tôi chọn phục vụ và tại sao tôi vẫn luôn tận tâm giúp đỡ từng học sinh của Duarte đạt được ước mơ của mình.</p><p dir=\"auto\">Tôi cũng tự hào về những tiến bộ mà chúng ta đã đạt được trong công tác củng cố hệ thống trường học. Nhờ sự ủng hộ của cộng đồng đối với công khố phiếu của chúng ta, chúng ta đã hiện đại hóa được các khuôn viên trường học và tạo ra môi trường học tập thế kỷ 21, mang lại lợi ích cho học sinh trong nhiều thế hệ tiếp theo. Những cải tiến này, cùng với quyết định sáng suốt của Hội Đồng về chuyển đổi các trường tiểu học thành hệ thống trường từ mẫu giáo đến lớp 8.</p><p dir=\"auto\"></p>","ZH":"<h1 dir=\"auto\" style=\"text-align: center\">REYNA E. DIAZ（蕾娜·E.·迪亞茲）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理委員會委員候選人，<br dir=\"auto\">第5託管區</h2><h3 dir=\"auto\" style=\"text-align: center\">DUARTE 聯合學區</h3><p dir=\"auto\">年齡：69</p><p dir=\"auto\">職業：管理委員會委員，DUSD（Duarte聯合學區）第5託管區</p><p dir=\"auto\">近三十年來，能夠為Duarte聯合學區的學生、家庭和社區服務，一直是我的榮幸。在教育委員會任職的這些年裡，我始終致力於將學生放在首位，並確保每位孩子都有成功的機會。</p><p dir=\"auto\" style=\"text-align: justify\">贏得家庭的信任，一直是我最大的榮幸之一。這些年來，我有機會傾聽家長的問題、憂慮和挑戰，協助家庭了解學校系統的運作，並連結孩子所需要的資源。傾聽並對我們的社區保持親和、積極回應和負責，對我來說一直非常重要。</p><p dir=\"auto\" style=\"text-align: justify\">每年，我最大的喜悅之一，就是站在畢業典禮舞台上，為我們的學生頒發畢業證書。那一刻代表著多年的努力、堅持，以及家庭、教育工作者和社區的共同承諾。這提醒著我，為什麼我選擇服務，也提醒著我，為什麼我始終致力於幫助每一位Duarte學生實現他們的夢想。</p><p dir=\"auto\" style=\"text-align: justify\">我也為我們在強化學校方面所取得的進展感到自豪。感謝社區對我們公債的支持，我們已經現代化了校園，並打造了21世紀的學習環境，讓我們的學生受益數個世代。這些改善，加上委員會審慎決定將我們的小學轉型為K-8學制</p><p dir=\"auto\"></p>\n"},"CandidateID":"U6","SequenceOrder":290}],"order":1,"isWriteIn":false,"isPresidential":false},{"id":"3NA","name":[{"BN":"রাইট-ইন(তালিকা বহির্ভূত)প্রার্থী","CC":"自填候選人","EN":"Write-In Candidate","ES":"Candidato por Escrito","FA":"کاندیدا خارج از لیست","GU":"અંદર લખવાના ઉમેદવાર","HI":"राइट–इन उम्मीदवार","HY":"Գրավոր առաջադրված թեկնածու","ID":"Calon Tidak Terdaftar dalam Surat Suara","JA":"記入候補者","KM":"បេក្ខជនសរសេរបញ្ចូលឈ្មោះ","KO":"기명 후보자","MN":"Бичигдэх нэр дэвшигч","MY":"ထပ်ဖြည့်သော ကိုယ်စားလှယ်လောင်း","RU":"Вписанный кандидат","TE":"రైట్-ఇన్ అభ్యర్ధి","TH":"ผู้สมัครรับเลือกตั้งแบบเขียนชื่อ","TL":"Isinusulat-lamang na Kandidato","VI":"Ứng Cử Viên Viết Tên Vào","ZH":"自填候選人"}],"short_name":[{"EN":"Write-In Candidate"}],"occupation":[null],"statements":[],"order":3,"isWriteIn":true,"isPresidential":false}],"statements":[]}