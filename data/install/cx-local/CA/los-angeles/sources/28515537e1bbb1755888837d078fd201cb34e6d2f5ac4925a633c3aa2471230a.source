{"id":"cc10512","long_description":{},"name":{"BN":"SAN MARINO সিটি সাধারণ পৌরসভা নির্বাচন, সিটি কাউন্সিলের সদস্য","CC":"SAN MARINO 市市政大選 市議會議員","EN":"CITY OF SAN MARINO GENERAL MUNICIPAL ELECTION Member of the City Council","ES":"ELECCIÓN MUNICIPAL GENERAL DE LA CIUDAD DE SAN MARINO Miembro del Concejo de la Ciudad","FA":"انتخابات عمومی شهرداری شهر SAN MARINO، عضو شورای شهر","GU":"SAN MARINO શહેર સામાન્ય નગરપાલિકા ચૂંટણી શહેર પરિષદના સભ્ય","HI":"SAN MARINO शहर आम नगरपालिका चुनाव नगर परिषद सदस्य","HY":"SAN MARINO ՔԱՂԱՔԻ ԸՆԴՀԱՆՈՒՐ ՔԱՂԱՔԱՅԻՆ ԸՆՏՐՈՒԹՅՈՒՆՆԵՐ Քաղաքային խորհրդի անդամ","ID":"PEMILIHAN UMUM TINGKAT KOTAMADYA KOTA SAN MARINO Anggota Dewan Kota","JA":"SAN MARINO 市会総選挙 市議会議員","KM":"ការបោះឆ្នោតឃុំ សង្កាត់ ទូទៅរបស់ក្រុង ទីក្រុង SAN MARINO សមាជិកក្រុមប្រឹក្សាក្រុង","KO":"SAN MARINO 시 총지방선거 시의회 의원","MN":"SAN MARINO ХОТЫН ЗАСАГ ЗАХИРГААНЫ ЕРӨНХИЙ СОНГУУЛЬ Хотын зөвлөлийн гишүүн","MY":"SAN MARINO မြို့တော် အထွေထွေ မြူနီစီပယ် ရွေးကောက်ပွဲ မြို့တော်ကောင်စီ၏ အဖွဲ့ဝင်","RU":"ОБЩИЕ МУНИЦИПАЛЬНЫЕ ВЫБОРЫ ГОРОДА SAN MARINO Член городского совета","TE":"SAN MARINO నగర సాధారణ మునిసిపల్ ఎలక్షన్ నగర పాలక మండలి సభ్యులు","TH":"การเลือกตั้งทั่วไปเทศบาลเมือง SAN MARINO สมาชิกสภาเทศบาลเมือง","TL":"PANGKALAHATANG HALALANG MUNISIPAL NG LUNGSOD NG SAN MARINO Miyembro ng Konseho ng Lungsod","VI":"TỔNG TUYỂN CỬ ĐỊA PHƯƠNG CỦA THÀNH PHỐ SAN MARINO Ủy Viên Hội Đồng Thành Phố","ZH":"SAN MARINO 市市政大選 市議會議員"},"short_name":{"BN":"SAN MARINO সি সা কা","CC":"SAN MARINO 市市政大選 - 市議會議員","EN":"SAN MARINO CITY GEN-CNC","ES":"CDAD SAN MARINO GEN-MCM","FA":"انتخابات عمومی شهرداری شهر SAN MARINO - عضو شورای شهر","GU":"SAN MARINO શહેર જન.-સીએનસી","HI":"SAN MARINO शहर आम-नगर परिषद","HY":"SAN MARINO ՔԱՂԱՔԻ ԸՆԴ-ԽՈՐՀ","ID":"KOTA SAN MARINO-ADK","JA":"SAN MARINO　市総-市議","KM":"ទីក្រុង SAN MARINO-ក្រុមប្រឹក្សាក្រុង","KO":"SAN MARINO 시 총-의회","MN":"SAN MARINO ХОТ ЕР-ХЗГ","MY":"SAN MARINO မြို့ထွေ-စီ","RU":"ОБЩ ГОР SAN MARINO - ЧЛ ГОР СОВ","TE":"SAN MARINO నగర సాధా-నపామం","TH":"กลต. ทั่วไปของ ทม. SAN MARINO สภม.","TL":"PANG HAL MUN LUNGSOD SAN MARINO-MKL","VI":"TTC THÀNH PHỐ SAN MARINO-HĐTP","ZH":"SAN MARINO 市市政大選 - 市議會議員"},"short_description":{},"contest_class":"candidate_class","number_of_writeins":3,"vote_for_max":3,"vote_for_text":{"BN":"<b>তিন</b>জনের চেয়ে বেশি প্রার্থীতে ভোট দেবেন না","CC":"請選不超過 <b>三人</b>","EN":"Vote For No More Than <b>THREE</b>","ES":"Vote Por No Más De <b>TRES</b>","FA":"رای حداکثر به <b>سه نفر</b>","GU":"<b>ત્રણ</b>થી વધુ માટે મત ન આપો","HI":"<b>तीन</b> से अधिक के लिए मतदान न करें","HY":"Քվեարկեք Ոչ Ավելի Քան  <b>ԵՐԵՔԻ </b>Համար","ID":"PILIH MAKSIMAL <b>TIGA</b>","JA":" <b>三人</b>まで投票","KM":"បោះឆ្នោតអោយមិនលើសពី <b>បី</b>","KO":"<b>세</b> 명까지만 투표하십시오","MN":"<b>ГУРАВ-аас</b> дээш санал өгөхгүй","MY":"အများဆုံး <b>သုံးဦး</b>သာ မဲပေးပါ","RU":"Голосовать за не более <b>ТРЕХ</b> кандидатов","TE":"<b>మూడు</b> మించకుండా ఓటు వేయండి","TH":"ออกเสียงลงคะแนนเลือกไม่เกิน <b>สาม</b> ชื่อ","TL":"Bumoto Ng Hindi Hihigit Sa <b>TATLO</b>","VI":"Bầu Không Quá <b>BA</b> Người","ZH":"請選不超過 <b>三人</b>"},"division":"D61","candidates":[{"id":"RC","name":[{"BN":"টনি চৌ","CC":"托尼·周","EN":"TONY CHOU","FA":"تونی چو","GU":"ટોની ચાઉ","HI":"टोनी चोउ","HY":"ԹՈՆԻ ՉՈՈԻ","JA":"トニー・チョウ","KM":"ថូនី ជូ","KO":"토니 초우","MN":"ТОНИ ЧОУ","MY":"တိုနီ ချောင်","RU":"ТОНИ ЧОУ","TE":"టోనీ చౌ","TH":"โทนี่ โชว","ZH":"托尼·周"}],"short_name":[{"EN":"TONY CHOU"}],"occupation":[{"BN":"দায়িত্বপ্রাপ্ত","CC":"在職者","EN":"Incumbent","ES":"Titular","FA":"متصدی","GU":"પદાધિકારી","HI":"पदधारी","HY":"Գործող պաշտոնյա","ID":"Petahana","JA":"現職者","KM":"អ្នកកំពុងកាន់តំណែង","KO":"현직자","MN":"Одоогийн албан тушаалтан","MY":"တာဝန်ထမ်းဆောင်ဆဲပုဂ္ဂိုလ်","RU":"Должностное лицо","TE":"ప్రస్తుతం అధికారంలో ఉన్న వ్యక్తి","TH":"ผู้ดำรงตำแหน่ง","TL":"Nanunungkulan","VI":"Đương Nhiệm","ZH":"在職者"}],"statements":[{"ID":"C0002675805E","FullHTML":{"BN":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU (টনি চৌ)-এর বিবৃতি</h1><h2 dir=\"auto\" style=\"text-align: center\">সিটি কাউন্সিলের সদস্য প্রার্থী</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO সিটি সাধারণ পৌরসভা নির্বাচন</h3><p dir=\"auto\">বয়স: 38</p><p dir=\"auto\">পেশা: সম্পদ বিষয়ক উপদেষ্টা</p><p dir=\"auto\">San Marino-এর বাসিন্দা এবং San Marino হাই স্কুলের প্রাক্তন শিক্ষার্থী <br dir=\"auto\">পূর্ববর্তী মেয়র এবং কাউন্সিল সদস্য<br dir=\"auto\">San Marino-র চাইনিজ ক্লাব-এর প্রাক্তন সভাপতি <br dir=\"auto\">প্রাক্তন চাইনিজ স্কুল চেয়ার<br dir=\"auto\">San Marino হাই স্কুলের ভলিবল কোচ <br dir=\"auto\">San Marino রোটারিয়ান</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","CC":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU（托尼·周）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議會議員候選人</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市市政大選</h3><p dir=\"auto\">年齡：38</p><p dir=\"auto\">職業：財富顧問</p><p dir=\"auto\">San Marino本地人，San Marino高中校友 <br dir=\"auto\">前市長暨市議會議員<br dir=\"auto\">San Marino華人俱樂部前任會長 <br dir=\"auto\">中文學校前任校委員會主席<br dir=\"auto\">San Marino高中排球教練 <br dir=\"auto\">San Marino扶輪社社員</p><p dir=\"auto\"></p><p dir=\"auto\"></p>\n","EN":"<h1 dir=\"auto\" style=\"text-align: center\">STATEMENT OF TONY CHOU</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATE FOR MEMBER OF THE CITY COUNCIL</h2><h3 dir=\"auto\" style=\"text-align: center\">CITY OF SAN MARINO GENERAL MUNICIPAL ELECTION</h3><p dir=\"auto\">Age: 38</p><p dir=\"auto\">Occupation: Wealth Advisor</p><p dir=\"auto\">San Marino Native and Alumni of San Marino High School <br dir=\"auto\">Previous Mayor and Councilmember<br dir=\"auto\">Past President Chinese Club of San Marino <br dir=\"auto\">Past Chinese School Chair<br dir=\"auto\">Volleyball Coach at San Marino High <br dir=\"auto\">San Marino Rotarian</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","ES":"<h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE TONY CHOU</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATO PARA MIEMBRO DEL CONCEJO DE LA CIUDAD</h2><h3 dir=\"auto\" style=\"text-align: center\">ELECCIÓN MUNICIPAL GENERAL DE LA CIUDAD DE SAN MARINO</h3><p dir=\"auto\">Edad: 38</p><p dir=\"auto\">Ocupación: Asesor Patrimonial</p><p dir=\"auto\">Nacido en San Marino y Exalumno de la Preparatoria San Marino (San Marino High School)<br dir=\"auto\">Exalcalde y Exmiembro del Concejo<br dir=\"auto\">Expresidente del Club Chino de San Marino (Chinese Club of San Marino) <br dir=\"auto\">Expresidente de la Escuela China<br dir=\"auto\">Entrenador de Voleibol en la Preparatoria San Marino (San Marino High)<br dir=\"auto\">Rotario de San Marino</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","FA":"<h1 dir=\"rtl\" style=\"text-align: center\">بیانیه TONY CHOU (تونی چو)</h1><h2 dir=\"rtl\" style=\"text-align: center\">کاندیدا برای عضو شورای شهر</h2><h3 dir=\"rtl\" style=\"text-align: center\">انتخابات عمومی شهرداری شهر SAN MARINO</h3><p dir=\"rtl\">سن: 38</p><p dir=\"rtl\">شغل: مشاور امور مالی</p><p dir=\"rtl\">بزرگ شده San Marino و فارغ‌التحصیل دبیرستان San Marino <br dir=\"auto\">شهردار و عضو سابق شورای شهر<br dir=\"auto\">رئیس سابق باشگاه چینی‌های San Marino <br dir=\"auto\">رئیس سابق مدرسه چینی<br dir=\"auto\">مربی والیبال در دبیرستان San Marino <br dir=\"auto\">عضو باشگاه Rotary شهرSan Marino</p><p dir=\"rtl\"></p><p dir=\"rtl\"></p>","GU":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU (ટોની ચાઉ)નું નિવેદન</h1><h2 dir=\"auto\" style=\"text-align: center\">શહેર પરિષદના સભ્ય માટેના ઉમેદવાર</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO શહેરની સામાન્ય નગરપાલિકા ચૂંટણી</h3><p dir=\"auto\">ઉંમર: 38</p><p dir=\"auto\">વ્યવસાય: સંપત્તિ સલાહકાર</p><p dir=\"auto\">San Marino વતની અને San Marino ઉચ્ચ શાળાના ભૂતપૂર્વ વિદ્યાર્થી <br dir=\"auto\">ભૂતપૂર્વ મેયર અને પરિષદસભ્ય<br dir=\"auto\">ચાઇનીઝ ક્લબ ઓફ San Marinoના ભૂતપૂર્વ પ્રમુખ <br dir=\"auto\">ભૂતપૂર્વ ચાઇનીઝ શાળા અધ્યક્ષ<br dir=\"auto\">San Marino હાઇમાં વોલીબોલ કોચ <br dir=\"auto\">San Marino રોટેરિયન</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","HI":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU (टोनी चोउ) का वक्तव्य</h1><h2 dir=\"auto\" style=\"text-align: center\">नगर परिषद सदस्य के लिए उम्मीदवार</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO शहर आम नगरपालिका चुनाव</h3><p dir=\"auto\">उम्र: 38 </p><p dir=\"auto\">व्यवसायः धन-संपत्ति सलाहकार</p><p dir=\"auto\">San Marino के मूल निवासी और San Marino हाई स्कूल के पूर्व छात्र <br dir=\"auto\">पूर्व मेयर और परिषद सदस्य<br dir=\"auto\">San Marino चीनी क्लब के पूर्व अध्यक्ष <br dir=\"auto\">चीनी स्कूल के पूर्व अध्यक्ष<br dir=\"auto\">San Marino हाई स्कूल में वॉलीबॉल कोच <br dir=\"auto\">San Marino रोटेरियन</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","HY":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU-Ի (ԹՈՆԻ ՉՈՈԻ) ՀԱՅՏԱՐԱՐՈՒԹՅՈՒՆԸ</h1><h2 dir=\"auto\" style=\"text-align: center\">ՔԱՂԱՔԱՅԻՆ ԽՈՐՀՐԴԻ ԱՆԴԱՄԻ ԹԵԿՆԱԾՈՒ</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO ՔԱՂԱՔԻ ԸՆԴՀԱՆՈՒՐ ՔԱՂԱՔԱՅԻՆ ԸՆՏՐՈՒԹՅՈՒՆՆԵՐ</h3><p dir=\"auto\">Տարիքը՝ 38</p><p dir=\"auto\">Գործունեությունը՝ Ֆինանսական խորհրդատու</p><p dir=\"auto\">San Marino-ի բնիկ և San Marino-ի ավագ դպրոցի շրջանավարտ <br dir=\"auto\">Նախկին քաղաքապետ և խորհրդի անդամ<br dir=\"auto\">San Marino-ի չինական ակումբի նախկին նախագահ <br dir=\"auto\">Չինական դպրոցի նախկին ղեկավար<br dir=\"auto\">Վոլեյբոլի մարզիչ San Marino-ի ավագ դպրոցում <br dir=\"auto\">San Marino-ի Rotary ակումբի անդամ</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","ID":"<h1 dir=\"auto\" style=\"text-align: center\">PERNYATAAN TONY CHOU</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDAT UNTUK ANGGOTA DEWAN KOTA</h2><h3 dir=\"auto\" style=\"text-align: center\">PEMILIHAN UMUM TINGKAT KOTAMADYA KOTA SAN MARINO</h3><p dir=\"auto\">Usia: 38</p><p dir=\"auto\">Pekerjaan: Penasihat Kekayaan</p><p dir=\"auto\">Putra asli San Marino dan Alumni Sekolah Menengah Atas San Marino <br dir=\"auto\">Mantan Walikota dan Anggota Dewan Kota<br dir=\"auto\">Mantan Presiden Klub Tionghoa San Marino <br dir=\"auto\">Mantan Ketua Sekolah Tionghoa<br dir=\"auto\">Pelatih Bola Voli di Sekolah Menengah Atas San Marino <br dir=\"auto\">Anggota Rotari San Marino</p><p dir=\"auto\"></p><p dir=\"auto\"></p>\n","JA":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU（トニー・チョウ）の声明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議会議員の候補者</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市会総選挙</h3><p dir=\"auto\">年齢：38歳</p><p dir=\"auto\">職業：資産アドバイザー</p><p dir=\"auto\">San Marino出身で、San Marino高等学校の卒業生<br dir=\"auto\">前市長および議会議員<br dir=\"auto\">San Marino 中国人クラブの元会長<br dir=\"auto\">中国人学校の元委員長<br dir=\"auto\">San Marino Highのバレーボールコーチ<br dir=\"auto\">San Marinoロータリアン（San Marino Rotarian）</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","KM":"<h1 dir=\"auto\" style=\"text-align: center\">សេចក្ដីថ្លែងការណ៍របស់ TONY CHOU (ថូនី ជូ)</h1><h2 dir=\"auto\" style=\"text-align: center\">បេក្ខជន​សំរាប់ សមាជិកក្រុមប្រឹក្សាក្រុង</h2><h3 dir=\"auto\" style=\"text-align: center\">ការ​បោះឆ្នោត​ឃុំ សង្កាត់ ទូទៅរបស់ក្រុង ទីក្រុង SAN MARINO</h3><p dir=\"auto\">អាយុ ៖ 38 ឆ្នាំ</p><p dir=\"auto\">មុខរបរ ៖ អ្នកប្រឹក្សាទ្រព្យសម្បត្តិ</p><p dir=\"auto\">មានដើមកំណើតនៅទីក្រុង San Marino និងជាអតីតសិស្សវិទ្យាល័យ San Marino <br dir=\"auto\">អតីតចៅហ្វាយក្រុង និងជាសមាជិកក្រុមប្រឹក្សា<br dir=\"auto\">អតីតប្រធានក្លឹបភាសាចិននៃទីក្រុង San Marino <br dir=\"auto\">អតីតប្រធានសាលាភាសាចិន<br dir=\"auto\">គ្រូបង្វឹកកីឡាបាល់ទះនៅវិទ្យាល័យ San Marino <br dir=\"auto\">សមាជិក Rotary នៃទីក្រុង San Marino</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","KO":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU (토니 초우) 의 성명서</h1><h2 dir=\"auto\" style=\"text-align: center\">시의회 의원 후보</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 시 총지방선거</h3><p dir=\"auto\">연령: 38</p><p dir=\"auto\">직업: 자산관리사</p><p dir=\"auto\">San Marino 출신이자 San Marino 고등학교 졸업생 <br dir=\"auto\">전 시장 및 시 의회 의원<br dir=\"auto\">San Marino 중국인 클럽 전 회장 <br dir=\"auto\">전 중국인 학교 의장<br dir=\"auto\">San Marino 고등학교 배구 코치 <br dir=\"auto\">San Marino 로타리 클럽</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","MN":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU (ТОНИ ЧОУ)-ИЙН МЭДЭГДЭЛ</h1><h2 dir=\"auto\" style=\"text-align: center\">ХОТЫН ЗӨВЛӨЛИЙН ГИШҮҮНД НЭР ДЭВШИГЧ</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO ХОТЫН ЗАСАГ ЗАХИРГААНЫ ЕРӨНХИЙ СОНГУУЛЬ</h3><p dir=\"auto\">Нас: ‎38</p><p dir=\"auto\">Ажил мэргэжил: Хөрөнгийн зөвлөх</p><p dir=\"auto\">San Marino-ийн уугуул иргэн, San Marino ахлах сургуулийн төгсөгч <br dir=\"auto\">Өмнөх хотын дарга болон хотын зөвлөлийн гишүүн<br dir=\"auto\">Chinese Club of San Marino-ийн ерөнхийлөгчөөр ажиллаж байсан<br dir=\"auto\">Хятад хэлний сургуулийн даргаар ажиллаж байсан<br dir=\"auto\">San Marino ахлах сургуулийн волейболын дасгалжуулагч <br dir=\"auto\">San Marino ротари клубийн гишүүн</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","MY":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU (တိုနီ ချောင်) ၏ ထုတ်ပြန်ချက်</h1><h2 dir=\"auto\" style=\"text-align: center\">မြို့တော်ကောင်စီ၏ အဖွဲ့ဝင်အတွက် ကိုယ်စားလှယ်လောင်း</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO မြို့တော် အထွေထွေ မြူနီစီပယ် ရွေးကောက်ပွဲ</h3><p dir=\"auto\">အသက်- 38 နှစ်</p><p dir=\"auto\">အလုပ်အကိုင်- ဓနဥစ္စာဆိုင်ရာ အကြံပေးသူ</p><p dir=\"auto\">San Marino ဒေသခံနှင့် San Marino အထက်တန်းကျောင်းသားဟောင်း <br dir=\"auto\">ယခင် မြို့တော်ဝန် နှင့် ကောင်စီဝင်<br dir=\"auto\">San Marino ၏ တရုတ်လူမျိုး ကလပ် ဥက္ကဋ္ဌဟောင်း <br dir=\"auto\">တရုတ်ကျောင်း နာယကဟောင်း<br dir=\"auto\">San Marino အထက်တန်းကျောင်း ဘော်လီဘောနည်းပြ <br dir=\"auto\">San Marino ရိုထရီအဖွဲ့ဝင်</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","RU":"<h1 dir=\"auto\" style=\"text-align: center\">ЗАЯВЛЕНИЕ TONY CHOU (ТОНИ ЧОУ)</h1><h2 dir=\"auto\" style=\"text-align: center\">КАНДИДАТ В ЧЛЕНЫ ГОРОДСКОГО СОВЕТА</h2><h3 dir=\"auto\" style=\"text-align: center\">ОБЩИЕ МУНИЦИПАЛЬНЫЕ ВЫБОРЫ ГОРОДА SAN MARINO</h3><p dir=\"auto\">Возраст: 38</p><p dir=\"auto\">Род занятий: Советник по управлению капиталом</p><p dir=\"auto\">Коренной житель San Marino и выпускник средней школы San Marino <br dir=\"auto\">Бывший мэр и член совета<br dir=\"auto\">Бывший президент китайского клуба San Marino <br dir=\"auto\">Бывший председатель китайской школы<br dir=\"auto\">Тренер по волейболу средней школы San Marino <br dir=\"auto\">Член клуба Rotary San Marino</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","TE":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU (టోనీ  చౌ) స్టేట్‌మెంట్</h1><h2 dir=\"auto\" style=\"text-align: center\">నగర పాలక మండలి సభ్యుని కొరకు అభ్యర్థి</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO నగర సాధారణ మునిసిపల్ ఎలక్షన్</h3><p dir=\"auto\">వయస్సు: 38</p><p dir=\"auto\">వృత్తి: సంపద సలహాదారు</p><p dir=\"auto\">San Marino స్థానికుడిని మరియు San Marino హై స్కూలు పూర్వ విద్యార్థిని <br dir=\"auto\">మాజీ మేయర్ మరియు పాలక మండలి సభ్యుడిని<br dir=\"auto\">San Marino యొక్క Chinese Club కు మాజీ ప్రెసిడెంటుని <br dir=\"auto\">Chinese School మాజీ ప్రెసిడెంటుని<br dir=\"auto\">San Marino హై యందు వాలీబాల్ కోచ్ <br dir=\"auto\">San Marino రొటేరియన్</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","TH":"<h1 dir=\"auto\" style=\"text-align: center\">แถลงการณ์ของ TONY CHOU (โทนี่ โชว)</h1><h2 dir=\"auto\" style=\"text-align: center\">ผู้สมัครรับเลือกตั้งสำหรับตำแหน่งสมาชิกสภาเทศบาลเมือง</h2><h3 dir=\"auto\" style=\"text-align: center\">การเลือกตั้งทั่วไปเทศบาลเมือง SAN MARINO</h3><p dir=\"auto\">อายุ: 38</p><p dir=\"auto\">อาชีพ: ที่ปรึกษาทางการเงินและการลงทุน</p><p dir=\"auto\">ชาวเมือง San Marino โดยกำเนิด และศิษย์เก่าโรงเรียนมัธยมปลาย San Marino <br dir=\"auto\">อดีตนายกเทศมนตรีและสมาชิกสภาเทศบาล<br dir=\"auto\">อดีตประธาน Chinese Club แห่ง San Marino <br dir=\"auto\">อดีตประธาน Chinese School<br dir=\"auto\">โค้ชผู้ฝึกสอนกีฬาวอลเลย์บอล โรงเรียนมัธยมปลาย San Marino <br dir=\"auto\">สมาชิกสโมสรโรตารี San Marino</p><p dir=\"auto\"></p><p dir=\"auto\"></p>\n","TL":"<h1 dir=\"auto\" style=\"text-align: center\">PAHAYAG NI TONY CHOU</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDATO PARA MIYEMBRO NG KONSEHO NG LUNGSOD</h2><h3 dir=\"auto\" style=\"text-align: center\">PANGKALAHATANG HALALANG MUNISIPAL NG LUNGSOD NG SAN MARINO</h3><p dir=\"auto\">Edad: 38</p><p dir=\"auto\">Trabaho: Tagapayo sa Kayamanan</p><p dir=\"auto\">Katutubo ng San Marino at Nagtapos sa Mataas na Paaralan ng San Marino <br dir=\"auto\">Dating Alkalde at Miyembro ng Konseho<br dir=\"auto\">Dating Pangulo ng Klab ng Tsino ng San Marino <br dir=\"auto\">Dating Tagapangulo ng Paaralan<br dir=\"auto\">Tagapagsanay ng Balibol sa Mataas na Paaralan ng San Marino <br dir=\"auto\">Miyembro ng Rotary ng San Marino</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","VI":"<h1 dir=\"auto\" style=\"text-align: center\">BÀI PHÁT BIỂU CỦA TONY CHOU</h1><h2 dir=\"auto\" style=\"text-align: center\">ỨNG CỬ VIÊN CHO CHỨC VỤ ỦY VIÊN HỘI ĐỒNG THÀNH PHỐ</h2><h3 dir=\"auto\" style=\"text-align: center\">TỔNG TUYỂN CỬ ĐỊA PHƯƠNG CỦA THÀNH PHỐ SAN MARINO</h3><p dir=\"auto\">Tuổi: ‎38</p><p dir=\"auto\">Nghề Nghiệp: Cố Vấn Quản Lý Tài Sản</p><p dir=\"auto\">Sinh ra Tại San Marino và là Cựu Học Sinh Trường Trung Học San Marino <br dir=\"auto\">Cựu Thị Trưởng và Ủy Viên Hội Đồng<br dir=\"auto\">Cựu Chủ Tịch Câu Lạc Bộ Người Hoa Tại San Marino <br dir=\"auto\">Cựu Chủ Tịch Trường Tiếng Trung (Hoa Ngữ)<br dir=\"auto\">Huấn Luyện Viên Bóng Chuyền tại Trường Trung Học San Marino <br dir=\"auto\">Thành viên Câu Lạc Bộ Rotary San Marino</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","ZH":"<h1 dir=\"auto\" style=\"text-align: center\">TONY CHOU（托尼·周）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議會議員候選人</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市市政大選</h3><p dir=\"auto\">年齡：38</p><p dir=\"auto\">職業：財富顧問</p><p dir=\"auto\">San Marino本地人，San Marino高中校友 <br dir=\"auto\">前市長暨市議會議員<br dir=\"auto\">San Marino華人俱樂部前任會長 <br dir=\"auto\">中文學校前任校委員會主席<br dir=\"auto\">San Marino高中排球教練 <br dir=\"auto\">San Marino扶輪社社員</p><p dir=\"auto\"></p><p dir=\"auto\"></p>\n"},"CandidateID":"RC","SequenceOrder":208}],"order":0,"isWriteIn":false,"isPresidential":false},{"id":"RD","name":[{"BN":"ক্যালভিন লু","CC":"卡爾文·勞","EN":"CALVIN LO","FA":"کالوین لو","GU":"કેલ્વિન લો","HI":"कैल्विन लो","HY":"ՔԵԼՎԻՆ ԼՈ","JA":"カルビン・ロー","KM":"កាល់វីន ឡូ","KO":"캘빈 로","MN":"КАЛВИН ЛO","MY":"ကယ်လ်ဗင် လို","RU":"КАЛВИН ЛО","TE":"కాల్విన్ లో","TH":"คาลวิน โล","ZH":"卡爾文·勞"}],"short_name":[{"EN":"CALVIN LO"}],"occupation":[{"BN":"দায়িত্বপ্রাপ্ত","CC":"在職者","EN":"Incumbent","ES":"Titular","FA":"متصدی","GU":"પદાધિકારી","HI":"पदधारी","HY":"Գործող պաշտոնյա","ID":"Petahana","JA":"現職者","KM":"អ្នកកំពុងកាន់តំណែង","KO":"현직자","MN":"Одоогийн албан тушаалтан","MY":"တာဝန်ထမ်းဆောင်ဆဲပုဂ္ဂိုလ်","RU":"Должностное лицо","TE":"ప్రస్తుతం అధికారంలో ఉన్న వ్యక్తి","TH":"ผู้ดำรงตำแหน่ง","TL":"Nanunungkulan","VI":"Đương Nhiệm","ZH":"在職者"}],"statements":[{"ID":"C0002675905E","FullHTML":{"BN":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO (ক্যালভিন লু)-এর বিবৃতি</h1><h2 dir=\"auto\" style=\"text-align: center\">সিটি কাউন্সিলের সদস্য প্রার্থী</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO সিটি সাধারণ পৌরসভা নির্বাচন</h3><p dir=\"auto\">বয়স: 56</p><p dir=\"auto\">পেশা: স্ব-নিযুক্ত</p><p dir=\"auto\">বর্তমান প্রতিনিধি হিসেবে San Marino-র বাসিন্দাদের সেবা করা আমার জন্য একটি বিশেষ সৌভাগ্যের বিষয়। 2007 সালে San Marino-কে নিজের বাড়ি করার পর থেকে আমি নিজে<strong> </strong>দেখেছি, কী কী কারণে আমাদের কমিউনিটি এত অসাধারণ: চমৎকার স্কুল, নিরাপদ এলাকা, সুন্দর পার্ক এবং এমন সক্রিয় বাসিন্দা যারা আমাদের সিটির ভবিষ্যৎ নিয়ে গভীরভাবে ভাবেন।</p><p dir=\"auto\">সিটি কাউন্সিলে আমার দায়িত্ব পালনকালে আমি আর্থিক স্বচ্ছতা ও দায়িত্বশীলতা বজায় রাখা, আমাদের এলাকার নিজস্ব বৈশিষ্ট্য রক্ষা, জননিরাপত্তা জোরদার এবং উন্নতমানের নাগরিক সেবা নিশ্চিত করার লক্ষ্যে কাজ করেছি। আমি বিশ্বাস করি, স্থানীয় সরকার তখনই সবচেয়ে ভালোভাবে কাজ করে, যখন তা স্বচ্ছ, সম্মানজনক এবং বাস্তবসম্মত সমাধানের ওপর মনোযোগ থাকে।</p><p dir=\"auto\">San Marino-র সাফল্য গড়ে উঠেছে সুচিন্তিত পরিকল্পনা ও দায়িত্বশীল নেতৃত্বের ওপর। আমাদের জীবনযাত্রার মান রক্ষা, শহরের দীর্ঘমেয়াদী আর্থিক স্থিতিশীলতা বজায় রাখা, পরিকাঠামোতে বিচক্ষণতার সাথে বিনিয়োগ করা এবং আমাদের কমিউনিটিকে বসবাস ও পরিবার গড়ে তোলার জন্য অন্যতম সেরা স্থান হিসেবে টিকিয়ে রাখার বিষয়ে আমি প্রতিশ্রুতিবদ্ধ।</p><p dir=\"auto\">সততা, জবাবদিহিতা ও নিষ্ঠার সঙ্গে আমাদের বাসিন্দাদের সেবা করে যাওয়ার সুযোগ পাওয়া আমার জন্য সম্মানের হবে। আমি বিনীতভাবে আপনার সমর্থন ও ভোট প্রার্থনা করছি, যাতে আমরা সকলে মিলে San Marino-র জন্য আরও শক্তিশালী ভবিষ্যৎ গড়ে তুলতে পারি।</p>","CC":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO（卡爾文·勞）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議會議員候選人</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市市政大選</h3><p dir=\"auto\">年齡：56</p><p dir=\"auto\">職業：自僱業者</p><p dir=\"auto\">身為現任議員，能夠為San Marino居民服務一直是我的榮幸。自2007年將San Marino定為我的家以來，我親身體驗到讓我們社區與眾不同之處：優異的學校、安全的社區、美麗的公園，以及深切關心本市未來的積極居民。</p><p dir=\"auto\">在市議會任職期間，我致力於推動財政責任、維護我們社區的特色、強化公共安全，並支持高品質的市府服務。我相信地方政府在透明、尊重且專注於務實解決方案時，運作得最好。</p><p dir=\"auto\">San Marino的成功建立在深思熟慮的規劃與負責任的領導之上。我仍致力於守護我們的生活品質、維持本市長期的財政實力、明智投資我們的基礎建設，並確保我們的社區持續是最適合居住與養育家庭的地方之一。</p><p dir=\"auto\">我將以誠信、負責與奉獻精神，繼續為我們的居民服務為榮。我恭敬地請求您的支持與一票，讓我們攜手為San Marino打造更強大的未來。</p>","EN":"<h1 dir=\"auto\" style=\"text-align: center\">STATEMENT OF CALVIN LO</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATE FOR MEMBER OF THE CITY COUNCIL</h2><h3 dir=\"auto\" style=\"text-align: center\">CITY OF SAN MARINO GENERAL MUNICIPAL ELECTION</h3><p dir=\"auto\">Age: 56</p><p dir=\"auto\">Occupation: Self-Employed</p><p dir=\"auto\">As the incumbent, it has been a privilege to serve the residents of San Marino. Since making San Marino my home in<strong> </strong>2007, I have experienced firsthand what makes our community exceptional: outstanding schools, safe neighborhoods, beautiful parks, and engaged residents who care deeply about our city's future.</p><p dir=\"auto\">During my time on the City Council, I have worked to promote fiscal responsibility, preserve the character of our neighborhoods, strengthen public safety, and support high-quality city services. I believe local government works best when it is transparent, respectful, and focused on practical solutions.</p><p dir=\"auto\">San Marino's success is built on thoughtful planning and responsible leadership. I remain committed to protecting our quality of life, maintaining the City's long-term financial strength, investing wisely in our infrastructure, and ensuring our community remains one of the best places to live and raise a family.</p><p dir=\"auto\">I would be honored to continue serving our residents with integrity, accountability, and dedication. I respectfully ask for your support and your vote so that, together, we can continue building an even stronger future for San Marino.</p>","ES":"<h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE CALVIN LO</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATO PARA MIEMBRO DEL CONCEJO DE LA CIUDAD</h2><h3 dir=\"auto\" style=\"text-align: center\">ELECCIÓN MUNICIPAL GENERAL DE LA CIUDAD DE SAN MARINO</h3><p dir=\"auto\">Edad: 56</p><p dir=\"auto\">Ocupación: Trabajador Independiente</p><p dir=\"auto\">Como titular, ha sido un privilegio servir a los residentes de San Marino. Desde que fijé mi hogar en San Marino en<strong> </strong>2007, he experimentado de primera mano aquello que hace excepcional a nuestra comunidad: escuelas sobresalientes, vecindarios seguros, parques hermosos y residentes comprometidos que se preocupan profundamente por el futuro de nuestra ciudad.</p><p dir=\"auto\">Durante mi período en el Concejo de la Ciudad, he trabajado para promover la responsabilidad fiscal, preservar el carácter de nuestros vecindarios, fortalecer la seguridad pública y brindar servicios de la ciudad de alta calidad. Creo que el gobierno local funciona mejor cuando es transparente y respetuoso y se enfoca en soluciones prácticas.</p><p dir=\"auto\">El éxito de San Marino se basa en una planificación reflexiva y un liderazgo responsable. Mantengo mi compromiso de proteger nuestra calidad de vida, conservar la solidez financiera de la Ciudad a largo plazo, invertir con prudencia en nuestra infraestructura y garantizar que nuestra comunidad siga siendo uno de los mejores lugares para vivir y criar una familia.</p><p dir=\"auto\">Sería un honor continuar sirviendo a nuestros residentes con integridad, responsabilidad y dedicación. Les pido respetuosamente su apoyo y su voto para que, juntos, podamos seguir construyendo un futuro aún más sólido para San Marino.</p>\n","FA":"<h1 dir=\"rtl\" style=\"text-align: center\">بیانیه CALVIN LO (کالوین لو)</h1><h2 dir=\"rtl\" style=\"text-align: center\">کاندید برای عضو شورای شهر</h2><h3 dir=\"rtl\" style=\"text-align: center\">انتخابات عمومی شهرداری شهر SAN MARINO</h3><p dir=\"rtl\">سن: 56</p><p dir=\"rtl\">شغل: خوداشتغالی</p><p dir=\"rtl\">به‌عنوان عضو فعلی شورای شهر ، خدمت به ساکنان San Marino برای من افتخار بزرگی بوده است. از زمانی که در<strong> </strong>سال 2007 San Marino را خانه خود قرار دادم، از نزدیک تجربه کرده‌ام که چه چیزهایی جامعه ما را استثنایی می‌کند: مدارس ممتاز، محله‌های امن، پارک‌های زیبا و ساکنانی فعال که عمیقاً به آینده شهرمان اهمیت می‌دهند.</p><p dir=\"rtl\">در طول دوران خدمتم در شورای شهر، برای ترویج مسئولیت‌پذیری مالی، حفظ ویژگی محله‌هایمان، تقویت امنیت عمومی و حمایت از خدمات شهری باکیفیت تلاش کرده‌ام. من معتقدم دولت محلی زمانی بهترین عملکرد را دارد که شفاف، محترمانه و متمرکز بر راه‌حل‌های عملی باشد.</p><p dir=\"rtl\">موفقیت San Marino بر برنامه‌ریزی سنجیده و رهبری مسئولانه بنا شده است. همچنان متعهد هستم که از کیفیت زندگی‌مان محافظت کنم، قدرت مالی بلندمدت شهرداری را حفظ کنم، با تدبیر در زیرساخت‌هایمان سرمایه‌گذاری کنم و اطمینان حاصل کنم که جامعه ما همچنان یکی از بهترین مکان‌ها برای زندگی و تشکیل خانواده باقی بماند.</p><p dir=\"rtl\">باعث افتخار من خواهد بود که با صداقت، پاسخ‌گویی و تعهد به خدمت به ساکنانمان ادامه دهم. با احترام از شما درخواست حمایت و رأی‌تان را دارم تا بتوانیم در کنار یکدیگر، به ساختن آینده‌ای حتی قدرتمندتر برای San Marino ادامه دهیم.</p>","GU":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO (કેલ્વિન લો)નું નિવેદન</h1><h2 dir=\"auto\" style=\"text-align: center\">શહેર પરિષદના સભ્ય માટેના ઉમેદવાર</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO શહેરની સામાન્ય નગરપાલિકા ચૂંટણી</h3><p dir=\"auto\">ઉંમર: 56</p><p dir=\"auto\">વ્યવસાય: સ્વ-રોજગાર</p><p dir=\"auto\">પદાધિકારી તરીકે, San Marinoના રહેવાસીઓની સેવા કરવાનો લહાવો રહ્યો છે. 2007 માં San Marinoને મારું ઘર બનાવ્યા પછી,<strong> </strong>મેં આપણા સમુદાયને અપવાદરૂપ બનાવતી બાબતોનો અનુભવ જાતે કર્યો છે: ઉત્કૃષ્ટ શાળાઓ, આસપાસના વિસ્તારની સુરક્ષા, સુંદર ઉદ્યાનો, અને આપણા શહેરના ભવિષ્યની ખૂબ કાળજી રાખતા વ્યસ્ત રહેવાસીઓ.</p><p dir=\"auto\">શહેર પરિષદમાં મારા કાર્યકાળ દરમિયાન, મેં નાણાકીય જવાબદારીને પ્રોત્સાહન આપવા, આપણા આસપાસના વિસ્તારની લાક્ષણિકતાને જાળવવા, જાહેર સુરક્ષાને મજબૂત બનાવવા અને ઉચ્ચ-ગુણવત્તાવાળી શહેર સેવાઓને ટેકો આપવા માટે કામ કર્યું છે. મારું માનવું છે કે સ્થાનિક સરકાર શ્રેષ્ઠ રીતે કાર્ય કરે છે તેમ ત્યારે કહેવાય જ્યારે તે પારદર્શક, આદરણીય, અને વ્યવહારુ ઉકેલો પર ધ્યાન કેન્દ્રિત કરે.</p><p dir=\"auto\">San Marinoની સફળતા વિચારશીલ આયોજન અને જવાબદાર નેતૃત્વ પર આધારિત છે. હું આપણા જીવનની ગુણવત્તાનું રક્ષણ કરવા, શહેરનું લાંબા ગાળાનું નાણાકીય સામર્થ્ય જાળવવા, આપણી માળખાગત સુવિધાઓમાં સમજદારીપૂર્વક રોકાણ કરવા અને આપણો સમુદાય રહેવા અને પરિવારના ઉછેર માટે શ્રેષ્ઠ સ્થળોમાંનો એક રહે તેની ખાતરી કરવા માટે પ્રતિબદ્ધ છું.</p><p dir=\"auto\">મને આપણા રહેવાસીઓની પ્રામાણિકતા, જવાબદારી અને સમર્પણ સાથે સેવા કરવાનું ચાલુ રાખવાનો ગર્વ થશે. હું આદરપૂર્વક તમારા સમર્થન અને મત માટે વિનંતી કરું છું જેથી કરીને, સાથે મળીને, આપણે San Marinoનો માટે વધુ મજબૂત ભવિષ્યનું નિર્માણ ચાલુ રાખી શકીએ.</p>","HI":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO (कैल्विन लो) का वक्तव्य</h1><h2 dir=\"auto\" style=\"text-align: center\">नगर परिषद सदस्य के लिए उम्मीदवार</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO शहर आम नगरपालिका चुनाव</h3><p dir=\"auto\">उम्र: 56</p><p dir=\"auto\">व्यवसाय: स्वतंत्र पेशेवर</p><p dir=\"auto\">वर्तमान पदधारी के रूप में, San Marino के निवासियों की सेवा करना मेरे लिए सौभाग्य की बात रही है। 2007<strong> </strong>में San Marino में अपना घर बनाने के बाद से, मैंने प्रत्यक्ष रूप से अनुभव किया है कि हमारे समुदाय को क्या विशिष्ट बनाता है: उत्कृष्ट स्कूल, सुरक्षित पड़ोस, सुंदर पार्क और ऐसे जागरूक निवासी जो हमारे शहर के भविष्य के बारे में गहराई से परवाह करते हैं।</p><p dir=\"auto\">नगर परिषद में अपने कार्यकाल के दौरान, मैंने वित्तीय जवाबदेही को बढ़ावा देने, हमारे आस-पड़ोस के स्वरूप को संरक्षित करने, सार्वजनिक सुरक्षा को मजबूत करने और उच्च गुणवत्ता वाली शहरी सेवाओं का समर्थन करने के लिए काम किया है। मेरा मानना है कि स्थानीय सरकार तभी सबसे अच्छा काम करती है जब वह पारदर्शी, सम्मानजनक और व्यावहारिक समाधानों पर केंद्रित हो।</p><p dir=\"auto\">San Marino की सफलता सोची-समझी योजना और जिम्मेदार नेतृत्व पर आधारित है। मैं हमारे जीवन की गुणवत्ता की रक्षा करने, शहर की दीर्घकालिक वित्तीय मजबूती बनाए रखने, हमारे बुनियादी ढाँचे में बुद्धिमानी से निवेश करने और यह सुनिश्चित करने के लिए प्रतिबद्ध हूँ कि हमारा समुदाय रहने और परिवार पालने के लिए सबसे अच्छे स्थानों में से एक बना रहे।</p><p dir=\"auto\">ईमानदारी, जवाबदेही और समर्पण के साथ हमारे निवासियों की सेवा जारी रखने का अवसर पाना मेरे लिए सम्मान की बात होगी। मैं आपसे समर्थन करने और वोट देने का विनम्रतापूर्वक अनुरोध करता हूँ ताकि हम मिलकर San Marino के लिए और भी मजबूत भविष्य का निर्माण जारी रख सकें।</p>","HY":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO-Ի (ՔԵԼՎԻՆ ԼՈ) ՀԱՅՏԱՐԱՐՈՒԹՅՈՒՆԸ</h1><h2 dir=\"auto\" style=\"text-align: center\">ՔԱՂԱՔԱՅԻՆ ԽՈՐՀՐԴԻ ԱՆԴԱՄԻ ԹԵԿՆԱԾՈՒ</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO ՔԱՂԱՔԻ ԸՆԴՀԱՆՈՒՐ ՔԱՂԱՔԱՅԻՆ ԸՆՏՐՈՒԹՅՈՒՆՆԵՐ</h3><p dir=\"auto\">Տարիքը՝ 56</p><p dir=\"auto\">Գործունեությունը՝ Անկախ աշխատող</p><p dir=\"auto\">Որպես գործող պաշտոնյա՝ ինձ համար մեծ պատիվ է ծառայել San Marino-ի բնակիչներին։ 2007<strong> </strong>թվականին San Marino-ն իմ տունը դարձնելուց ի վեր ես սեփական փորձով զգացել եմ, թե ինչն է մեր համայնքն առանձնահատուկ դարձնում՝ բարձրակարգ դպրոցներ, անվտանգ թաղամասեր, գեղեցիկ այգիներ և ակտիվ բնակիչներ, ովքեր խորապես հոգ են տանում մեր քաղաքի ապագայի մասին։</p><p dir=\"auto\">Քաղաքային խորհրդում աշխատելու ընթացքում ես աշխատել եմ ֆինանսական պատասխանատվությունը խթանելու, մեր թաղամասերի բնույթը պահպանելու, հանրային անվտանգությունն ամրապնդելու և բարձրորակ քաղաքային ծառայություններին աջակցելու ուղղությամբ։ Կարծում եմ՝ տեղական ինքնակառավարումն առավել արդյունավետ է, երբ այն թափանցիկ է, հարգալից և կենտրոնացած է գործնական լուծումների վրա։</p><p dir=\"auto\">San Marino-ի հաջողությունը հիմնված է մտածված պլանավորման և պատասխանատու ղեկավարության վրա։ Ես շարունակում եմ հանձնառու լինել մեր կյանքի որակի պահպանմանը, քաղաքի երկարաժամկետ ֆինանսական կայունության ապահովմանը, մեր ենթակառուցվածքներում խելամիտ ներդրումներ կատարելուն և ապահովելուն, որ մեր համայնքը շարունակի մնալ ապրելու և ընտանիք մեծացնելու լավագույն վայրերից մեկը։</p><p dir=\"auto\">Ինձ համար մեծ պատիվ կլինի շարունակել ծառայել մեր բնակիչներին՝ ազնվությամբ, հաշվետվողականությամբ և նվիրվածությամբ։ Հարգանքով խնդրում եմ Ձեր աջակցությունն ու քվեն, որպեսզի միասին շարունակենք San Marino-ի համար կառուցել ավելի ամուր ապագա։</p>","ID":"<h1 dir=\"auto\" style=\"text-align: center\">PERNYATAAN CALVIN LO</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDAT UNTUK ANGGOTA DEWAN KOTA</h2><h3 dir=\"auto\" style=\"text-align: center\">PEMILIHAN UMUM TINGKAT KOTAMADYA KOTA SAN MARINO</h3><p dir=\"auto\">Usia: 56</p><p dir=\"auto\">Pekerjaan: Wiraswasta</p><p dir=\"auto\">Sebagai petahana, merupakan suatu kehormatan bagi saya untuk melayani penduduk San Marino. Sejak menjadikan San Marino sebagai rumah saya pada<strong> </strong>2007, saya telah merasakan secara langsung apa yang membuat masyarakat kita istimewa: sekolah-sekolah unggulan, lingkungan yang aman, taman-taman yang indah, dan penduduk yang aktif serta sangat peduli terhadap masa depan kota kita.</p><p dir=\"auto\">Selama menjabat sebagai Anggota Dewan Kota, saya telah bekerja untuk mendorong tanggung jawab fiskal, mempertahankan karakter lingkungan kita, memperkuat keselamatan publik, dan mendukung layanan-layanan kota berkualitas tinggi. Saya percaya bahwa pemerintahan daerah bekerja paling baik ketika dijalankan secara transparan, penuh rasa hormat, dan berfokus pada solusi-solusi praktis.</p><p dir=\"auto\">Keberhasilan San Marino dibangun melalui perencanaan yang matang dan kepemimpinan yang bertanggung jawab. Saya tetap berkomitmen untuk melindungi kualitas hidup kita, menjaga kekuatan keuangan Kota dalam jangka panjang, berinvestasi secara bijak pada infrastruktur kita, dan memastikan komunitas kita tetap menjadi salah satu tempat terbaik untuk hidup dan membesarkan keluarga.</p><p dir=\"auto\">Saya akan merasa terhormat untuk terus melayani penduduk kita dengan integritas, akuntabilitas, dan dedikasi. Dengan hormat saya memohon dukungan dan suara Anda agar, bersama-sama, kita dapat terus membangun masa depan yang lebih kuat bagi San Marino.</p>","JA":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO（カルビン・ロー）の声明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議会議員の候補者</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市会総選挙</h3><p dir=\"auto\">年齢：56歳</p><p dir=\"auto\">職業：自営業</p><p dir=\"auto\">現職者として、San Marinoの住民の皆様に奉仕できたことは光栄でした。2007年にSan Marinoを故郷にして以来、私は私たちの地域社会を特別なものにしているものを身をもって経験してきました。それは、優れた学校、安全な地域、美しい公園、そして街の未来を深く考える積極的な住民です。</p><p dir=\"auto\">市議会議員を務めた期間中、私は財務責任の促進、地域社会の特性の維持、公共安全の強化、そして質の高い市の事業の支援に尽力してきました。地方自治体は、透明性があり、敬意を払い、実践的な解決策に焦点を当てている場合に最も効果的に機能すると私は信じています。</p><p dir=\"auto\">San Marinoの成功は、綿密な計画と責任ある指導力の上に成り立っています。私は、生活の質を守り、市の長期的な財政健全性を維持し、基盤施設に賢明に投資し、私たちの地域社会が居住し、家族を育てるのに最も適した場所の一つであり続けるよう尽力することを約束します。</p><p dir=\"auto\">誠実さ、説明責任、そして献身的な姿勢をもって、引き続き住民の皆様に奉仕できることを光栄に思います。皆様のご支援とご投票を心よりお願い申し上げます。共に力を合わせ、San Marinoのより強い未来を築き上げていきましょう。</p>","KM":"<h1 dir=\"auto\" style=\"text-align: center\">សេចក្ដីថ្លែងការណ៍របស់ CALVIN LO (កាល់វីន ឡូ)</h1><h2 dir=\"auto\" style=\"text-align: center\">បេក្ខជន​សំរាប់ សមាជិកក្រុមប្រឹក្សាក្រុង</h2><h3 dir=\"auto\" style=\"text-align: center\">ការ​បោះឆ្នោតឃុំ សង្កាត់ ទូទៅរបស់​ក្រុង ទីក្រុង SAN MARINO</h3><p dir=\"auto\">អាយុ ៖ 56 ឆ្នាំ</p><p dir=\"auto\">មុខរបរ ៖ ធ្វេីការដោយខ្លួន​ឯង</p><p dir=\"auto\">ក្នុងនាមជាអ្នក​កំពុង​កាន់​តំណែង​ វាជាឯកសិទ្ធិមួយក្នុងការបម្រើអ្នករស់នៅទីក្រុង San Marino ។ ចាប់តាំងពីកសាងផ្ទះរបស់ខ្ញុំនៅទីក្រុង San Marino នៅឆ្នាំ<strong> </strong>2007 ខ្ញុំបានជួបប្រទះដោយផ្ទាល់នូវអ្វីដែលធ្វើឱ្យសហគមន៍របស់យើងមានភាពលេចធ្លោ៖ សាលារៀនឆ្នើម សង្កាត់មានសុវត្ថិភាព ឧទ្យានដ៏ស្រស់ស្អាត និងអ្នករស់នៅដែលចូលរួម ដែលយកចិត្តទុកដាក់យ៉ាងជ្រាលជ្រៅចំពោះអនាគតទីក្រុងរបស់យើង ។</p><p dir=\"auto\">ក្នុងអំឡុងពេលរបស់ខ្ញុំនៅក្នុងក្រុមប្រឹក្សាក្រុង ខ្ញុំបានធ្វើការដើម្បីលើកកម្ពស់ការទទួលខុសត្រូវផ្នែកសារពើពន្ធ អភិរក្សលក្ខណៈនៃសង្កាត់របស់យើង ពង្រឹងសុវត្ថិភាពសាធារណៈ និងគាំទ្រសេវាកម្មទីក្រុងដែលមានគុណភាពខ្ពស់ ។ ខ្ញុំជឿថារដ្ឋាភិបាលមូលដ្ឋានដំណើរការល្អបំផុតនៅពេលដែលមានតម្លាភាព ការគោរព និងផ្តោតលើដំណោះស្រាយជាក់ស្តែង ។</p><p dir=\"auto\">ភាពជោគជ័យរបស់ទីក្រុង San Marino ត្រូវបានកសាងឡើងនៅលើការរៀបចំផែនការប្រកបដោយការគិតគូរ និងភាពជាអ្នកដឹកនាំប្រកបដោយការទទួលខុសត្រូវ ។ ខ្ញុំនៅតែប្តេជ្ញាចិត្តក្នុងការការពារគុណភាពជីវិតរបស់យើង រក្សាភាពរឹងមាំផ្នែកហិរញ្ញវត្ថុរយៈពេលវែងរបស់ទីក្រុង វិនិយោគដោយឈ្លាសវៃលើហេដ្ឋារចនាសម្ព័ន្ធរបស់យើង និងធានាថាសហគមន៍របស់យើងនៅតែជាកន្លែងដ៏ល្អបំផុតមួយក្នុងការរស់នៅ និងចិញ្ចឹមគ្រួសារ ។</p><p dir=\"auto\">ខ្ញុំនឹងមានកិត្តិយសក្នុងការបន្តបម្រើអ្នករស់នៅទីក្រុងរបស់យើងដោយសុចរិតភាព គណនេយ្យភាព និងការខិតខំប្រឹងប្រែង ។ ខ្ញុំសូមអំពាវនាវដោយសេចក្តីគោរពនូវការគាំទ្រ និងសំឡេងឆ្នោតរបស់អ្នក ដើម្បីឱ្យយើងរួមគ្នា អាចបន្តកសាងអនាគតកាន់តែរឹងមាំសម្រាប់ទីក្រុង San Marino ។</p>","KO":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO (캘빈 로) 의 성명서</h1><h2 dir=\"auto\" style=\"text-align: center\">시의회 의원 후보</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 시 총지방선거</h3><p dir=\"auto\">연령: 56</p><p dir=\"auto\">직업: 자영업자</p><p dir=\"auto\">현직 의원으로서 San Marino 주민들을 위해 봉사할 수 있었던 것은 큰 영광이었습니다. 2007년 San Marino에 정착한 이후, 저는 우리 지역 사회를 특별하게 만드는 요소들을 직접 경험해 왔습니다: 훌륭한 학교, 안전한 동네, 아름다운 공원, 그리고 우리 도시의 미래에 깊은 관심을 가진 적극적인 주민들이 바로 그것입니다.</p><p dir=\"auto\">시의회 의원으로 재임하는 동안 저는 재정적 책임감을 고취하고, 우리 동네의 특성을 보존하며, 공공 안전을 강화하고, 양질의 시정 서비스를 지원하기 위해 노력해 왔습니다. 저는 지방 정부가 투명하고, 서로를 존중하며, 실질적인 해결책에 집중할 때 가장 효율적으로 운영된다고 믿습니다.</p><p dir=\"auto\">San Marino의 성공은 사려 깊은 계획과 책임감 있는 리더십에 기반을 두고 있습니다. 저는 우리 시민들의 삶의 질을 보호하고, 시의 장기적인 재정 건전성을 유지하며, 기반 시설에 현명하게 투자하고, 우리 지역사회가 살기 좋고 가족을 키우기에 가장 좋은 곳 중 하나로 남을 수 있도록 최선을 다할 것입니다.</p><p dir=\"auto\">저는 성실함과 책임감, 헌신적인 자세로 계속해서 주민 여러분을 위해 일할 수 있게 된다면 큰 영광으로 생각하겠습니다. San Marino의 더욱 강한 미래를 함께 만들어 나갈 수 있도록 여러분의 지지와 투표를 정중히 부탁드립니다.</p>","MN":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO (КАЛВИН ЛO)-ИЙН МЭДЭГДЭЛ</h1><h2 dir=\"auto\" style=\"text-align: center\">ХОТЫН ЗӨВЛӨЛИЙН ГИШҮҮНД НЭР ДЭВШИГЧ</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO ХОТЫН ЗАСАГ ЗАХИРГААНЫ ЕРӨНХИЙ СОНГУУЛЬ</h3><p dir=\"auto\">Нас: 56</p><p dir=\"auto\">Ажил мэргэжил: Хувиараа хөдөлмөр эрхлэгч</p><p dir=\"auto\">Одоогийн хотын зөвлөлийн гишүүний хувьд San Marino-гийн оршин суугчдадаа үйлчлэх нь миний хувьд асар их нэр төрийн хэрэг билээ. 2007<strong> </strong>онд San Marino-г гэр орноо болгосноос хойш манай орон нутгийг онцгой болгодог зүйлс болох шилдэг сургуулиуд, аюулгүй хорооллууд, үзэсгэлэнт цэцэрлэгт хүрээлэнгүүд болон хотынхоо ирээдүйд чин сэтгэлээсээ санаа тавьдаг, идэвхтэй оршин суугчдыг би өөрийн биеэр мэдэрч ирсэн.</p><p dir=\"auto\">Хотын зөвлөлийн гишүүнээр ажиллах хугацаандаа би санхүүгийн хариуцлагатай байдлыг дэмжих, хорооллуудынхаа онцлогийг хадгалах, олон нийтийн аюулгүй байдлыг бэхжүүлэх, өндөр чанартай хотын үйлчилгээг дэмжихийн төлөө ажилласан. Орон нутгийн засаг захиргаа ил тод, хүндэтгэлтэй байж, ажил хэрэгч шийдэлд төвлөрөх үед хамгийн сайн ажилладаг гэж би үздэг.</p><p dir=\"auto\">San Marino-ийн амжилт нь бодож төлөвлөсөн төлөвлөлт, хариуцлагатай манлайлал дээр тогтдог. Би амьдралын чанарыг хамгаалах, хотын урт хугацааны санхүүгийн чадавхыг хадгалах, дэд бүтцэд ухаалгаар хөрөнгө оруулах, мөн манай орон нутгийг амьдрах болон гэр бүлээ өсгөн хүмүүжүүлэхэд хамгийн тохиромжтой газруудын нэг хэвээр байлгахын төлөө тууштай ажилласаар байна.</p><p dir=\"auto\">Оршин суугчдадаа зарчимч шударга байдал, хариуцлагатай байдал, тууштай зүтгэлээр үргэлжлүүлэн үйлчлэх нь миний хувьд нэр төрийн хэрэг байх болно. Бид хамтдаа San Marino-ийн улам хүчирхэг ирээдүйг үргэлжлүүлэн бүтээхийн тулд та бүхний дэмжлэг, саналыг хүндэтгэлтэйгээр хүсэж байна.</p>","MY":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO (ကယ်လ်ဗင် လို) ၏ ထုတ်ပြန်ချက်</h1><h2 dir=\"auto\" style=\"text-align: center\">မြို့တော်ကောင်စီ၏ အဖွဲ့ဝင်အတွက် ကိုယ်စားလှယ်လောင်း</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO မြို့တော် အထွေထွေ မြူနီစီပယ် ရွေးကောက်ပွဲ</h3><p dir=\"auto\">အသက်- 56 နှစ် </p><p dir=\"auto\">အလုပ်အကိုင်- ကိုယ်ပိုင်အလုပ်လုပ်ကိုင်သူ</p><p dir=\"auto\">လက်ရှိတာဝန်ထမ်းဆောင်နေသူအနေဖြင့်၊ San Marino နေထိုင်သူများကို ဝန်ဆောင်မှုပေးရခြင်းမှာ ဂုဏ်ယူစရာတစ်ခုဖြစ်ပါတယ်။ 2007<strong> </strong>ခုနှစ်တွင် San Marino ကို ကျွန်တော့်ရဲ့ နေအိမ်အဖြစ် သတ်မှတ်ပြီးကတည်းက၊ ကျွန်တော်တို့ရဲ့ အသိုင်းအဝိုင်းကို တမှုထူးခြားစေသည့်အရာများကို ကျွန်တော်ကိုယ်တိုင် ကြုံတွေ့ခဲ့ရပါတယ်- ထူးချွန်သောကျောင်းများ၊ ဘေးကင်းသောရပ်ကွက်များ၊ လှပသောပန်းခြံများနှင့် ကျွန်ုပ်တို့ မြို့တော်၏အနာဂတ်ကို အလွန်ဂရုစိုက်သော တက်ကြွသောနေထိုင်သူများ ဖြစ်ပါတယ်။</p><p dir=\"auto\">မြို့တော်ကောင်စီတွင် ကျွန်တော်တာဝန်ထမ်းဆောင်စဉ်ကာလအတွင်း၊ ဘဏ္ဍာရေးဆိုင်ရာ တာဝန်ယူမှုကို မြှင့်တင်ရန်၊ ကျွန်တော်တို့၏ရပ်ကွက်များ၏ ဝိသေသလက္ခဏာကို ထိန်းသိမ်းရန်၊ အများပြည်သူဘေးကင်းရေးကို အားကောင်းစေရန်နှင့် အရည်အသွေးမြင့် မြို့တော်ဝန်ဆောင်မှုများကို ပံ့ပိုးရန် ကျွန်တော်လုပ်ဆောင်ခဲ့ပါတယ်။ ကျွန်တော့်အနေနဲ့ ဒေသန္တရအစိုးရသည် ပွင့်လင်းမြင်သာမှု၊ လေးစားမှုနှင့် လက်တွေ့ကျသောဖြေရှင်းချက်များကို အာရုံစိုက်သည့်အခါ အကောင်းဆုံးလုပ်ဆောင်နိုင်သည်ဟု ယုံကြည်ပါတယ်။</p><p dir=\"auto\">San Marino ၏အောင်မြင်မှုသည် ဂရုတစိုက်စီစဉ်ခြင်းနှင့် တာဝန်ယူမှုရှိသောခေါင်းဆောင်မှုပေါ်တွင် တည်ဆောက်ထားပါတယ်။ ကျွန်တော်တို့၏ ဘဝအရည်အသွေးကို ကာကွယ်ရန်၊ မြို့တော်၏ ရေရှည်ဘဏ္ဍာရေးအင်အားကို ထိန်းသိမ်းရန်၊ ကျွန်တော်တို့၏ အခြေခံအဆောက်အအုံများတွင် ပညာရှိရှိ ရင်းနှီးမြှုပ်နှံရန်နှင့် ကျွန်တော်တို့၏ အသိုက်အဝန်းသည် နေထိုင်ရန်နှင့် မိသားစုတစ်ခု တည်ဆောက်ရန် အကောင်းဆုံးနေရာများထဲမှ တစ်ခုဖြစ်နေကြောင်း သေချာစေရန် ကျွန်တော် ကတိပြုထားပါတယ်။</p><p dir=\"auto\">ကျွန်တော်တို့၏ ဒေသခံများအား သမာဓိ၊ တာဝန်ခံမှုနှင့် စေတနာအပြည့်ဖြင့် ဆက်လက်ဝန်ဆောင်မှုပေးနိုင်ပါက ကျွန်တော် ဂုဏ်ယူမိမှာပါ။ ထို့ကြောင့် San Marino အတွက် ပိုမိုအားကောင်းသော အနာဂတ်ကို အတူတကွ ဆက်လက်တည်ဆောက်နိုင်ရန် ကျွန်တော့်အနေဖြင့် လူကြီးမင်းတို့ရဲ့ ပံ့ပိုးမှုနဲ့ ဆန္ဒမဲကို လေးစားစွာ တောင်းဆိုပါတယ်။</p>","RU":"<h1 dir=\"auto\" style=\"text-align: center\">ЗАЯВЛЕНИЕ CALVIN LO (КАЛВИН ЛО)</h1><h2 dir=\"auto\" style=\"text-align: center\">КАНДИДАТ В ЧЛЕНЫ ГОРОДСКОГО СОВЕТА</h2><h3 dir=\"auto\" style=\"text-align: center\">ОБЩИЕ МУНИЦИПАЛЬНЫЕ ВЫБОРЫ ГОРОДА SAN MARINO</h3><p dir=\"auto\">Возраст: 56</p><p dir=\"auto\">Род занятий: Индивидуальный предприниматель</p><p dir=\"auto\">Как действующему должностному лицу, для меня было честью служить жителям San Marino. С тех пор как я поселился в San Marino в<strong> </strong>2007 году, я на собственном опыте убедился в том, что делает наше сообщество уникальным: превосходные школы, безопасные районы, красивые парки и активные жители, которым небезразлично будущее нашего города.</p><p dir=\"auto\">За время работы в городском совете я стремился продвигать фискальную ответственность, сохранять характер наших районов, укреплять общественную безопасность и поддерживать высокое качество городских служб. Я считаю, что местное правительство работает наиболее эффективно, когда оно открыто, уважительно и работает над практическими решениями.</p><p dir=\"auto\">Успех San Marino основан на продуманном планировании и ответственном руководстве. Я по-прежнему планирую защищать наше качество жизни, поддерживать долгосрочную финансовую стабильность города, разумно инвестировать в нашу инфраструктуру и работать, чтобы наш город оставался одним из лучших мест для жизни и воспитания детей.</p><p dir=\"auto\">Для меня было бы большой честью и впредь честно, ответственно и самоотверженно служить интересам наших жителей. Я с уважением прошу вашей поддержки и вашего голоса, чтобы мы вместе могли продолжить строить лучшее будущее для San Marino.</p>","TE":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO (కాల్విన్ లో) స్టేట్‌మెంట్</h1><h2 dir=\"auto\" style=\"text-align: center\">నగర పాలక మండలి సభ్యుని కొరకు అభ్యర్థి</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO నగర సాధారణ మునిసిపల్ ఎలక్షన్</h3><p dir=\"auto\">వయస్సు: 56</p><p dir=\"auto\">వృత్తి: స్వయం ఉపాధి పొందిన వ్యక్తి</p><p dir=\"auto\">ప్రస్తుతం పదవిలో ఉన్న వ్యక్తిగా, San Marino నివాసితులకు సేవ చేయడం పట్ల నాకు గౌరవంగా ఉంటోంది. 2007 లో San Marino ను నా నివాసంగా చేసుకున్నప్పటి నుండీ<strong> </strong>మన కమ్యూనిటీని విశిష్టంగా నిలిపే అంశాలను నేను స్వయంగా అనుభవించాను: అద్భుతమైన పాఠశాలలు, సురక్షితమైన ఇరుగుపొరుగు పరిసరాలు, అందమైన పార్కులు మరియు మన నగరం యొక్క భవిష్యత్తు గురించి ఎంతో లోతైన శ్రద్ధ వహించే నిబద్ధత గల నివాసితులు.</p><p dir=\"auto\">నగర పాలక మండలిలో నా పదవీకాలంలో, ఆర్థిక బాధ్యతను ప్రోత్సహించడానికి, మన ఇరుగుపొరుగు పరిసరాల స్వరూపాన్ని పరిరక్షించడానికి, ప్రజా భద్రతను బలోపేతం చేయడానికి మరియు అత్యంత నాణ్యమైన నగర సేవలకు మద్దతు ఇవ్వడానికి నేను కృషి చేశాను. స్థానిక ప్రభుత్వం పారదర్శకంగా, గౌరవప్రదంగా, ఆచరణాత్మక పరిష్కారాలపై దృష్టి సారించినప్పుడే అది అత్యుత్తమంగా పని చేస్తుందని నేను నమ్ముతాను.</p><p dir=\"auto\">San Marino విజయం ఆలోచనాత్మక ప్రణాళిక మరియు బాధ్యతాయుతమైన నాయకత్వంపై నిర్మించబడింది.మన జీవన నాణ్యతను పరిరక్షించడానికి, నగరం యొక్క దీర్ఘకాలిక ఆర్థిక బలాన్ని కాపాడుకోవడానికి, మన మౌలిక సదుపాయాలలో తెలివిగా పెట్టుబడి చేయడానికి, మరియు మన కమ్యూనిటీ నివసించడానికి, కుటుంబాన్ని పెంచి పోషించడానికి అత్యుత్తమ ప్రదేశాలలో ఒకటిగా ఉండేలా చూసుకోవడానికి నేను కట్టుబడి ఉన్నాను.</p><p dir=\"auto\">సమగ్రత, జవాబుదారీతనం మరియు అంకితభావంతో మన నివాసితులకు సేవ చేయడం కొనసాగించడం నాకు గౌరవంగా ఉంటుంది. మనందరం కలిసి, San Marino కు మరింత బలమైన భవిష్యత్తును నిర్మించడం కొనసాగించడానికి, నేను మీ మద్దతు మరియు మీ ఓటును వినయపూర్వకంగా అభ్యర్థిస్తున్నాను.</p>","TH":"<h1 dir=\"auto\" style=\"text-align: center\">แถลงการณ์ของ CALVIN LO (คาลวิน โล)</h1><h2 dir=\"auto\" style=\"text-align: center\">ผู้สมัครรับเลือกตั้งสำหรับตำแหน่งสมาชิกสภาเทศบาลเมือง</h2><h3 dir=\"auto\" style=\"text-align: center\">การเลือกตั้งทั่วไปเทศบาลเมือง SAN MARINO</h3><p dir=\"auto\">อายุ: 56</p><p dir=\"auto\">อาชีพ: ธุรกิจส่วนตัว</p><p dir=\"auto\">ในฐานะสมาชิกสภาเทศบาลเมืองคนปัจจุบัน ถือเป็นเกียรติอย่างยิ่งที่ผมได้มีโอกาสรับใช้พี่น้องชาวเมือง San Marino นับตั้งแต่ย้ายได้มาปักหลักสร้างครอบครัวที่ San Marino ในปี<strong> </strong>2007 ผมได้สัมผัสด้วยตนเองถึงสิ่งพิเศษที่ทำให้ชุมชนของเราไม่เหมือนใคร ทั้งโรงเรียนที่ยอดเยี่ยม ชุมชนที่ปลอดภัย สวนสาธารณะที่สวยงาม และประชาชนที่มีส่วนร่วมและใส่ใจอนาคตของเมืองอย่างแท้จริง</p><p dir=\"auto\">ตลอดระยะเวลาการทำงานในสภาเทศบาลเมือง ผมได้มุ่งมั่นส่งเสริมวินัยทางการคลัง การรักษาอัตลักษณ์ความเป็นอยู่ของชุมชน การยกระดับความปลอดภัยของสาธารณะ ตลอดจนการสนับสนุนบริการของเมืองให้มีคุณภาพสูง ผมเชื่อมั่นว่าการบริหารราชการส่วนท้องถิ่นจะมีประสิทธิภาพสูงสุด เมื่อดำเนินงานด้วยความโปร่งใส ให้ความเคารพประชาชน และมุ่งเน้นการแก้ไขปัญหาที่เกิดผลสัมฤทธิ์ได้จริง</p><p dir=\"auto\">ความสำเร็จของ San Marino ขับเคลื่อนด้วยการวางแผนที่รอบคอบและการเป็นผู้นำที่มีความรับผิดชอบ ผมยังคงมุ่งมั่นที่จะปกป้องคุณภาพชีวิตของพวกเรา รักษาความมั่นคงทางการคลังระยะยาวของเมือง ลงทุนในระบบสาธารณูปโภคพื้นฐานอย่างชาญฉลาด และสร้างหลักประกันว่าชุมชนของเราจะยังคงเป็นหนึ่งในสถานที่ที่ดีที่สุดสำหรับการอยู่อาศัยและการสร้างครอบครัว</p><p dir=\"auto\">ผมรู้สึกเป็นเกียรติอย่างยิ่งหากได้ทำหน้าที่รับใช้ประชาชนต่อไปด้วยความซื่อสัตย์สุจริต ความรับผิดชอบ และความทุ่มเท ผมขอคะแนนเสียงและการสนับสนุนจากทุกท่านด้วยความเคารพ เพื่อที่พวกเราจะได้ร่วมมือกันสร้างอนาคตของ San Marino ให้แข็งแกร่งยิ่งขึ้นต่อไป</p>","TL":"<h1 dir=\"auto\" style=\"text-align: center\">PAHAYAG NI CALVIN LO</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDATO PARA MIYEMBRO NG KONSEHO NG LUNGSOD</h2><h3 dir=\"auto\" style=\"text-align: center\">PANGKALAHATANG HALALANG MUNISIPAL NG LUNGSOD NG SAN MARINO</h3><p dir=\"auto\">Edad: 56</p><p dir=\"auto\">Trabaho: Nagtatrabaho para sa sarili</p><p dir=\"auto\">Bilang nanunungkulan, isang pribilehiyo ang makapaglingkod sa mga residente ng San Marino. Simula nang gawing tahanan ko ang San Marino noong<strong> </strong>2007, naranasan ko mismo kung ano ang nagpapatangi sa ating komunidad: mga natatanging paaralan, ligtas na mga kapitbahayan, magagandang parke, at mga residenteng nakikibahagi na lubos na nagmamalasakit sa kinabukasan ng ating lungsod.</p><p dir=\"auto\">Sa aking panunungkulan sa Konseho ng Lungsod, nagtrabaho ako upang itaguyod ang responsibilidad sa pananalapi, pangalagaan ang katangian ng ating mga kapitbahayan, palakasin ang kaligtasan ng publiko, at suportahan ang mataas na kalidad na mga serbisyo ng lungsod. Naniniwala akong mas mahusay na gumagana ang lokal na pamahalaan kapag ito ay malinaw, magalang, at nakatuon sa mga praktikal na solusyon.</p><p dir=\"auto\">Ang tagumpay ng San Marino ay nakabatay sa maalalahaning pagpaplano at responsableng pamumuno. Nanatili akong nakatuon sa pagprotekta sa kalidad ng ating buhay, pagpapanatili ng pangmatagalang lakas pinansyal ng Lungsod, matalinong pamumuhunan sa ating imprastraktura, at pagtiyak na ang ating komunidad ay mananatiling isa sa mga pinakamagandang lugar para manirahan at magpalaki ng pamilya.</p><p dir=\"auto\">Ikararangal ko na patuloy na maglingkod sa ating mga residente nang may integridad, pananagutan, at dedikasyon. Magalang kong hinihingi ang inyong suporta at boto upang, sama-sama, maipagpatuloy natin ang pagbuo ng mas matibay na kinabukasan para sa San Marino.</p>\n","VI":"<h1 dir=\"auto\" style=\"text-align: center\">BÀI PHÁT BIỂU CỦA CALVIN LO</h1><h2 dir=\"auto\" style=\"text-align: center\">ỨNG CỬ VIÊN CHO CHỨC VỤ ỦY VIÊN HỘI ĐỒNG THÀNH PHỐ</h2><h3 dir=\"auto\" style=\"text-align: center\">TỔNG TUYỂN CỬ ĐỊA PHƯƠNG CỦA THÀNH PHỐ SAN MARINO</h3><p dir=\"auto\">Tuổi: 56</p><p dir=\"auto\">Nghề Nghiệp: Tự Làm Chủ</p><p dir=\"auto\">Với tư cách là đương nhiệm, tôi cảm thấy vinh dự khi được phục vụ người dân San Marino. Kể từ khi tôi chọn San Marino làm quê hương của mình vào<strong> </strong>năm 2007, tôi đã trực tiếp trải nghiệm những điều làm nên sự vượt trội của cộng đồng chúng ta: trường học xuất sắc, khu phố an toàn, công viên xinh đẹp và cư dân tích cực quan tâm sâu sắc đến tương lai của thành phố.</p><p dir=\"auto\">Trong thời gian làm việc tại Hội Đồng Thành Phố, tôi đã nỗ lực thúc đẩy trách nhiệm tài khóa, bảo tồn bản sắc của các khu phố, tăng cường an toàn công cộng và hỗ trợ các dịch vụ thành phố chất lượng cao. Tôi tin rằng chính quyền địa phương hoạt động hiệu quả nhất khi chính quyền này minh bạch, tôn trọng và tập trung vào các giải pháp thiết thực.</p><p dir=\"auto\">Thành công của San Marino được xây dựng dựa trên việc lập kế hoạch chu đáo và lãnh đạo có trách nhiệm. Tôi vẫn luôn cam kết bảo vệ chất lượng cuộc sống của chúng ta, duy trì sức mạnh tài chính dài hạn của Thành Phố, đầu tư khôn ngoan vào cơ sở hạ tầng và đảm bảo cộng đồng của chúng ta vẫn là một trong những nơi tốt nhất để sinh sống và nuôi dạy con cái.</p><p dir=\"auto\">Tôi rất vinh dự được tiếp tục phục vụ cư dân của chúng ta với sự chính trực, trách nhiệm giải trình và sự tận tâm. Tôi trân trọng kính mong sự ủng hộ và lá phiếu của quý vị để cùng nhau, chúng ta có thể tiếp tục xây dựng một tương lai vững mạnh hơn nữa cho San Marino.</p>","ZH":"<h1 dir=\"auto\" style=\"text-align: center\">CALVIN LO（卡爾文·勞）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議會議員候選人</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市市政大選</h3><p dir=\"auto\">年齡：56</p><p dir=\"auto\">職業：自僱業者</p><p dir=\"auto\">身為現任議員，能夠為San Marino居民服務一直是我的榮幸。自2007年將San Marino定為我的家以來，我親身體驗到讓我們社區與眾不同之處：優異的學校、安全的社區、美麗的公園，以及深切關心本市未來的積極居民。</p><p dir=\"auto\">在市議會任職期間，我致力於推動財政責任、維護我們社區的特色、強化公共安全，並支持高品質的市府服務。我相信地方政府在透明、尊重且專注於務實解決方案時，運作得最好。</p><p dir=\"auto\">San Marino的成功建立在深思熟慮的規劃與負責任的領導之上。我仍致力於守護我們的生活品質、維持本市長期的財政實力、明智投資我們的基礎建設，並確保我們的社區持續是最適合居住與養育家庭的地方之一。</p><p dir=\"auto\">我將以誠信、負責與奉獻精神，繼續為我們的居民服務為榮。我恭敬地請求您的支持與一票，讓我們攜手為San Marino打造更強大的未來。</p>"},"CandidateID":"RD","SequenceOrder":209}],"order":1,"isWriteIn":false,"isPresidential":false},{"id":"RE","name":[{"BN":"জন ডাস্টিন","CC":"約翰·達斯汀","EN":"JOHN DUSTIN","FA":"جان داستین","GU":"જોહ્ન ડસ્ટિન","HI":"जॉन डस्टिन","HY":"ՋՈՆ ԴԱՍԹԻՆ","JA":"ジョン・ダスティン","KM":"ចន ដាស្ទីន","KO":"존 더스틴","MN":"ЖОН ДАСТИН","MY":"ဂျွန် ဒတ်စ်တင်","RU":"ДЖОН ДАСТИН","TE":"జాన్ డస్టిన్","TH":"จอห์น ดัสติน","ZH":"約翰·達斯汀"}],"short_name":[{"EN":"JOHN DUSTIN"}],"occupation":[{"BN":"গুণমান উন্নয়ন বিশেষজ্ঞ","CC":"品質改善專員","EN":"Quality Improvement Specialist","ES":"Especialista en Mejora de la Calidad","FA":"متخصص بهبود کیفیت","GU":"ગુણવત્તા સુધારણા વિશેષજ્ઞ","HI":"गुणवत्ता सुधार विशेषज्ञ","HY":"Որակի բարելավման մասնագետ","ID":"Spesialis Peningkatan Kualitas","JA":"品質改善専門家","KM":"អ្នកឯកទេសផ្នែកកែលម្អគុណភាព","KO":"품질 개선 전문가","MN":"Чанар сайжруулалтын мэргэжилтэн","MY":"အရည်အသွေးမြှင့်တင်ရေး အထူးကျွမ်းကျင်သူ","RU":"Специалист по улучшению качества","TE":"నాణ్యతా మెరుగుదల నిపుణులు","TH":"ผู้เชี่ยวชาญด้านการปรับปรุงคุณภาพ","TL":"Espesyalista sa Pagpapabuti ng Kalidad","VI":"Chuyên Gia Cải Tiến Chất Lượng","ZH":"品質改善專員"}],"statements":[{"ID":"C0002673705E","FullHTML":{"BN":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN (জন ডাস্টিন)-এর বিবৃতি</h1><h2 dir=\"auto\" style=\"text-align: center\">সিটি কাউন্সিলের সদস্য প্রার্থী</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO সিটি সাধারণ পৌরসভা নির্বাচন</h3><p dir=\"auto\">বয়স: 62</p><p dir=\"auto\">পেশা: গুণমান উন্নয়ন বিশেষজ্ঞ</p><p dir=\"auto\">1969 সাল থেকে আমি San Marino কে নিজের বাড়ি বলতে পেরে গর্বিত। Carver এলিমেন্টারি, Huntington মিডল স্কুল এবং San Marino হাই স্কুলের প্রাক্তন শিক্ষার্থী হিসেবে এই সম্প্রদায়ের সঙ্গে আমার গভীর সম্পর্ক রয়েছে। আমার মেয়ে Stepahanie সেই একই পথ অনুসরণ করতে এবং সেই একই স্কুলগুলো থেকে স্নাতক হতে দেখাটা বিশেষভাবে অর্থবহ।</p><p dir=\"auto\">জনসেবা আমার জীবনের একটি কেন্দ্রীয় অংশ। আমি ডিজাইন রিভিউ কমিটিতে তিন বছর এবং পরিকল্পনা কমিশনে আট বছর দায়িত্ব পালনের সৌভাগ্য লাভ করেছি। এছাড়াও আমি 2011 সাল থেকে San Marino কমিউনিটি ইমার্জেন্সি রেসপন্স টিম (CERT)-এর সাথে স্বেচ্ছাসেবী হিসেবে কাজ করছি এবং 2011 সাল থেকে San Marino গ্র্যাড নাইট নির্মাণ দলের সদস্য হিসেবে রয়েছি।</p><p dir=\"auto\">পেশাগতভাবে আমি স্বাস্থ্য বীমা শিল্পে গুণগত মান উন্নয়ন এবং ডেটা বিশ্লেষণে বিশেষজ্ঞ হিসেবে কাজ করি। আমার কাজের জন্য রাজ্য ও কেন্দ্রীয় বিধি-বিধান অনুসরণ করতে হয় এবং জবাবদিহিতা ও উৎকর্ষ নিশ্চিত করতে নিয়ন্ত্রক সংস্থাগুলোর সাথে সহযোগিতা করতে হয়।</p><p dir=\"auto\">আমার স্ত্রী, Atlántida, এবং আমি এসএস-এর সদস্য। Felicitas ও Perpetua চার্চ, এবং এমন একটি বিশেষ সম্প্রদায়ের অংশ হতে পেরে আমরা কৃতজ্ঞ। আমি San Marino র অনন্য বৈশিষ্ট্য, সৌন্দর্য এবং ছোট শহরের আমেজ রক্ষা করতে প্রতিশ্রুতিবদ্ধ এবং San Marino বাসিন্দাদের সেবা অব্যাহত রাখতে পারলে আমি সম্মানিত বোধ করব।</p>","CC":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN（約翰·達斯汀）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議會議員候選人</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市市政大選</h3><p dir=\"auto\">年齡：62</p><p dir=\"auto\">職業：品質改善專員</p><p dir=\"auto\">自 1969 年以來，我一直引以為傲地將 San Marino 視為自己的家。我畢業於 Carver 小學、Huntington 中學以及 San Marino 高中，在這個社區有深厚的在地淵源。看著我的女兒 Stepahanie 走上同樣的求學道路，也從這些學校畢業，對我來說意義格外深遠。</p><p dir=\"auto\">公共服務一直是我生活中至關重要的一部分。我有幸在設計審查委員會服務三年，在規劃委員會服務八年。我自 2011 年起擔任 San Marino 社區緊急應變團隊（CERT）義工，並自 2013 年起成為 San Marino Grad Night 活動搭建團隊的成員。</p><p dir=\"auto\">職業方面，我任職於健康保險產業，專長為品質改善與數據分析。我的工作需要熟稔州與聯邦法規，並與監管機關合作，落實問責機制，追求卓越表現。</p><p dir=\"auto\">我與妻子 Atlántida 是 Ss. Felicitas and Perpetua Church 的教友，很感恩能夠身處這個如此溫馨的社區。我致力守護 San Marino 獨特的風貌、景觀與小鎮精神，若能繼續為 San Marino 的居民服務，我將深感榮幸。</p>","EN":"<h1 dir=\"auto\" style=\"text-align: center\">STATEMENT OF JOHN DUSTIN</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATE FOR MEMBER OF THE CITY COUNCIL</h2><h3 dir=\"auto\" style=\"text-align: center\">CITY OF SAN MARINO GENERAL MUNICIPAL ELECTION</h3><p dir=\"auto\">Age: 62</p><p dir=\"auto\">Occupation: Quality Improvement Specialist</p><p dir=\"auto\">I have been proud to call San Marino home since 1969. As a graduate of Carver Elementary, Huntington Middle School, and San Marino High School, I have deep roots in this community. It has been especially meaningful to watch my daughter, Stepahanie, follow that same path and graduate from those same schools.</p><p dir=\"auto\">Public service has been a central part of my life. I have had the privilege of service three years on the Design Review Committee and eight years on the Planning Commission. I have also volunteered with the San Marino Community Emergency Response Team (CERT) since 2011 and have been a member of the San Marino Grad Night construction crew since 2013.</p><p dir=\"auto\">Professionally, I work in the health insurance industry, specializing in quality improvement and data analysis. My work requires navigating state and federal regulations and collaborating with regulatory agencies to ensure accountability and excellence.</p><p dir=\"auto\">My wife, Atlántida, and I are members of Ss. Felicitas and Perpetua Church, and we are grateful to be part of such a special community. I am committed to preserving San Marino's unique character, beauty, and small-town spirit, and I would be honored to continue serving the residents of San Marino.</p>","ES":"<h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE JOHN DUSTIN</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATO PARA MIEMBRO DEL CONCEJO DE LA CIUDAD</h2><h3 dir=\"auto\" style=\"text-align: center\">ELECCIÓN MUNICIPAL GENERAL DE LA CIUDAD DE SAN MARINO</h3><p dir=\"auto\">Edad: 62</p><p dir=\"auto\">Ocupación: Especialista en Mejora de la Calidad</p><p dir=\"auto\">Desde 1969, me enorgullece llamar a San Marino mi hogar. Como exalumno de la Escuela Primaria Carver (Carver Elementary), la Escuela Secundaria Huntington (Huntington Middle School) y la Preparatoria San Marino (San Marino High School), tengo profundas raíces en esta comunidad. Ha sido especialmente significativo ver a mi hija, Stephanie, seguir ese mismo camino y graduarse de esas mismas escuelas.</p><p dir=\"auto\">El servicio público ha sido una parte fundamental de mi vida. He tenido el privilegio de servir tres años en el Comité de Revisión de Diseño (Design Review Committee) y ocho años en la Comisión de Planificación (Planning Commission). También he sido voluntario del Equipo Comunitario de Respuesta a Emergencias (CERT) de San Marino desde 2011 y he formado parte del equipo de construcción de la Noche de Graduación de San Marino (San Marino Grad Night) desde 2013.</p><p dir=\"auto\">Profesionalmente, trabajo en el sector de los seguros de salud, especializándome en la mejora de la calidad y el análisis de datos. Mi trabajo requiere conocer las regulaciones estatales y federales y colaborar con los organismos reguladores para garantizar la rendición de cuentas y la excelencia.</p><p dir=\"auto\">Mi esposa, Atlántida, y yo somos miembros de la Iglesia Ss. Felicitas y Perpetua, y estamos agradecidos de ser parte de una comunidad tan especial. Estoy comprometido con la preservación del carácter único, la belleza y el espíritu de pueblo pequeño de San Marino, y sería un honor para mí seguir sirviendo a los residentes de San Marino.</p>","FA":"<h1 dir=\"rtl\" style=\"text-align: center\">بیانیه JOHN DUSTIN (جان داستین)</h1><h2 dir=\"rtl\" style=\"text-align: center\">کاندید برای عضو شورای شهر</h2><h3 dir=\"rtl\" style=\"text-align: center\">انتخابات عمومی شهرداری شهر SAN MARINO</h3><p dir=\"rtl\">سن: 62</p><p dir=\"rtl\">شغل: متخصص بهبود کیفیت</p><p dir=\"rtl\">من از سال 1969 افتخار می‌کنم که San Marino را خانه خود می‌نامم. من به عنوان فارغ‌التحصیل دبستان Carver، مدرسه راهنمایی Huntington و دبیرستان San Marino، ریشه‌های عمیقی در این جامعه دارم. دیدن دخترم، Stepahanie، که همان مسیر را دنبال کرد و از همان مدارس فارغ‌التحصیل شد، معنای خاصی برایم دارد.</p><p dir=\"rtl\">خدمت به مردم بخش مهمی از زندگی من بوده است. من به مدت سه سال در کمیته بررسی طرح و هشت سال در کمیسیون برنامه‌ریزی افتخار خدمت داشته‌ام. من همچنین از سال 2011 به صورت داوطلبانه در تیم واکنش اضطراری جامعه </p><p dir=\"rtl\">San Marino فعالیت داشته‌ام و از سال 2013 عضوی از تیم ساختمانی</p><p dir=\"rtl\">San Marino Grad Night بوده‌ام.</p><p dir=\"rtl\">به لحاظ حرفه‌ای، من در صنعت بیمه سلامت کار می‌کنم و در زمینه بهبود کیفیت و تحلیل داده‌ها تخصص دارم. کار من مستلزم بررسی مقررات ایالتی و فدرال و همکاری با سازمان‌های نظارتی برای تضمین پاسخگویی و تعالی است.</p><p dir=\"rtl\">من و همسرم، Atlántida، عضو کلیسای Ss Felicitas and Perpetua هستیم و از اینکه عضوی از چنین جامعه‌ی ویژه‌ای هستیم، شکرگزاریم. من متعهد به حفظ شخصیت، زیبایی و روحیه منحصر به فرد شهر کوچک San Marino هستم و مفتخرم که به خدمت به ساکنان San Marino ادامه دهم.</p>","GU":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN (જોહ્ન ડસ્ટિન)નું નિવેદન</h1><h2 dir=\"auto\" style=\"text-align: center\">શહેર પરિષદના સભ્ય માટેના ઉમેદવાર</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO શહેરની સામાન્ય નગરપાલિકા ચૂંટણી</h3><p dir=\"auto\">ઉંમર: ‎62</p><p dir=\"auto\">વ્યવસાય: ગુણવત્તા સુધારણા વિશેષજ્ઞ</p><p dir=\"auto\">1969 થી મને San Marino ને પોતાનું ઘર કહેવાનો ગર્વ છે. Carver પ્રાથમિક, Huntington માધ્યમિક શાળા અને San Marino ઉચ્ચ શાળાના સ્નાતક તરીકે, મારા મૂળ આ સમુદાયમાં ઊંડા છે. મારી પુત્રી, Stepahanie, તે જ માર્ગ પર ચાલતી અને તે જ શાળાઓમાંથી સ્નાતક થતી જોવી ખાસ કરીને અર્થપૂર્ણ રહી છે.</p><p dir=\"auto\">જાહેર સેવા મારા જીવનનો મુખ્ય ભાગ રહી છે. મને ડિઝાઇન સમીક્ષા સમિતિમાં ત્રણ વર્ષ નો અને આયોજન પંચમાં આઠ વર્ષોની સેવા આપવાનો લહાવો મળ્યો છે. મેં 2011 થી San Marino સમુદાય કટોકટી પ્ર​તિભાવ ટીમ (CERT) સાથે પણ સ્વયંસેવા આપી છે અને 2013 થી San Marino ગ્રાડ નાઇટ બાંધકામ ક્રૂનો સભ્ય છું.</p><p dir=\"auto\">વ્યાવસાયિક રીતે, હું આરોગ્ય વીમા ઉદ્યોગમાં કામ કરું છું, ગુણવત્તા સુધારણા અને ડેટા વિશ્લેષણમાં નિષ્ણાત છું. મારા કાર્ય માટે રાજ્ય અને સંઘીય નિયમોનું પાલન કરવું અને જવાબદારી અને શ્રેષ્ઠતા સુનિશ્ચિત કરવા માટે નિયમનકારી સંસ્થાઓ સાથે સહયોગ કરવો જરૂરી છે.</p><p dir=\"auto\">મારી પત્ની, Atlántida, અને હું Ss ના સભ્યો છીએ. Felicitas અને Perpetua ચર્ચ, અને અમે આવા ખાસ સમુદાયનો ભાગ બનવા બદલ આભારી છીએ. હું San Marino ના અનોખા પાત્ર, સુંદરતા, અને નાના શહેરની ભાવનાને જાળવી રાખવા માટે પ્રતિબદ્ધ છું, અને San Marinoના રહેવાસીઓની સેવા કરવાનું ચાલુ રાખવાનો મને ગર્વ થશે.</p>","HI":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN (जॉन डस्टिन) का वक्तव्य</h1><h2 dir=\"auto\" style=\"text-align: center\">नगर परिषद सदस्य के लिए उम्मीदवार</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO शहर आम नगरपालिका चुनाव</h3><p dir=\"auto\">उम्र: 62</p><p dir=\"auto\">व्यवसाय: गुणवत्ता सुधार विशेषज्ञ</p><p dir=\"auto\">San Marino को 1969 से मुझे अपना घर कहने पर गर्व रहा है। Carver एलीमेंट्री स्कूल, Huntington मिडिल स्कूल और San Marino हाई स्कूल के स्नातक के रूप में, इस समुदाय से मेरा गहरा जुड़ाव है। मेरी बेटी Stepahanie को उसी राह पर चलते हुए और उन्हीं स्कूलों से स्नातक होते देखना मेरे लिए विशेष रूप से सार्थक रहा है।</p><p dir=\"auto\">लोक सेवा मेरे जीवन का एक केंद्रीय हिस्सा रही है। मुझे डिजाइन समीक्षा समिति में तीन साल और योजना आयोग में आठ साल तक सेवा करने का सौभाग्य प्राप्त हुआ है। मैं 2011 से San Marino कम्युनिटी इमरजेंसी रिस्पांस टीम (CERT) के साथ स्वयंसेवक के रूप में भी काम कर रहा हूँ और 2013 से San Marino Grad Night कंस्ट्रक्शन क्रू का सदस्य रहा हूँ।</p><p dir=\"auto\">पेशेवर तौर पर, मैं स्वास्थ्य बीमा उद्योग में काम करता हूँ, जहाँ मैं गुणवत्ता सुधार और डेटा विश्लेषण में विशेषज्ञता रखता हूँ। मेरे काम में राज्य और संघीय नियमों का अनुपालन करना और जवाबदेही और उत्कृष्टता सुनिश्चित करने के लिए नियामक एजेंसियों के साथ सहयोग करना भी शामिल है।</p><p dir=\"auto\">मेरी पत्नी Atlántida और मैं Ss के सदस्य हैं। Felicitas और Perpetua चर्च के भी हम सदस्य है और ऐसे विशेष समुदाय का हिस्सा बनकर हम आभारी हैं। मैं San Marino के अनूठे चरित्र, सुंदरता और छोटे शहर की भावना को संरक्षित करने के लिए प्रतिबद्ध हूँ, और San Marino के निवासियों की सेवा जारी रखना मेरे लिए सम्मान की बात होगी।</p>","HY":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN-Ի (ՋՈՆ ԴԱՍԹԻՆ) ՀԱՅՏԱՐԱՐՈՒԹՅՈՒՆԸ</h1><h2 dir=\"auto\" style=\"text-align: center\">ՔԱՂԱՔԱՅԻՆ ԽՈՐՀՐԴԻ ԱՆԴԱՄԻ ԹԵԿՆԱԾՈՒ</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO ՔԱՂԱՔԻ ԸՆԴՀԱՆՈՒՐ ՔԱՂԱՔԱՅԻՆ ԸՆՏՐՈՒԹՅՈՒՆ</h3><p dir=\"auto\">Տարիքը՝ 62</p><p dir=\"auto\">Մասնագիտությունը՝ Որակի բարելավման մասնագետ</p><p dir=\"auto\">Հպարտությամբ San Marino-ն տուն եմ կոչել 1969 թվականից ի վեր։ Որպես Carver Elementary տարրական դպրոցի, Huntington միջին դպրոցի և San Marino-ի ավագ դպրոցի շրջանավարտ, խոր արմատներ ունեմ այս համայնքում։ Հատկապես նշանակալից էր հետևելը, թե ինչպես է դուստրս՝ Stephanie-ն, անցնում նույն ճանապարհը և ավարտում նույն դպրոցները։</p><p dir=\"auto\">Հանրային ծառայությունը կենտրոնական դեր է խաղացել իմ կյանքում։ Ես պատիվ եմ ունեցել երեք տարի ծառայելու նախագծի վերանայման կոմիտեում և ութ տարի՝ պլանավորման հանձնաժողովում։ Ես նաև կամավորական աշխատանք եմ կատարել San Marino-ի համայնքային արտակարգ իրավիճակների արձագանքման խմբում (CERT) 2011 թվականից ի վեր և San Marino-ի «Գրադ Նայթ» (ավարտական երեկո) կազմակերպման և ձևավորման աշխատանքների խմբի անդամ եմ 2013 թվականից ի վեր։</p><p dir=\"auto\">Մասնագիտորեն ես աշխատում եմ առողջության ապահովագրության ոլորտում՝ մասնագիտանալով որակի բարելավման և տվյալների վերլուծության մեջ։ Իմ աշխատանքը պահանջում է նահանգային և դաշնային կանոնակարգերում կողմնորոշում և կարգավորող մարմինների հետ համագործակցություն՝ հաշվետվողականությունն ու գերազանցությունն ապահովելու համար։</p><p dir=\"auto\">Ես և կինս՝ Atlántida-ն, Սբ. Felicitas և Perpetua եկեղեցու անդամ ենք, և շնորհակալ ենք նման յուրահատուկ համայնքի մաս կազմելու համար։ Ես հանձնառու եմ պահպանել San Marino-ի յուրահատուկությունը, գեղեցկությունը և փոքր քաղաքի ոգին, և ինձ համար պատիվ կլինի շարունակել ծառայել San Marino-ի բնակիչներին։</p>","ID":"<h1 dir=\"auto\" style=\"text-align: center\">PERNYATAAN JOHN DUSTIN</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDAT UNTUK ANGGOTA DEWAN KOTA</h2><h3 dir=\"auto\" style=\"text-align: center\">PEMILIHAN UMUM TINGKAT KOTAMADYA KOTA SAN MARINO</h3><p dir=\"auto\">Usia: 62</p><p dir=\"auto\">Pekerjaan: Spesialis Peningkatan Kualitas</p><p dir=\"auto\">Saya bangga menyebut San Marino sebagai rumah saya sejak 1969. Sebagai lulusan Sekolah Dasar Carver, Sekolah Menengah Pertama Huntington, dan Sekolah Menengah Atas San Marino, saya memiliki ikatan yang kuat dengan masyarakat ini. Sungguh berbahagia sekali menyaksikan putri saya, Stepahanie, mengikuti jejak yang sama dan lulus dari sekolah-sekolah yang sama.</p><p dir=\"auto\">Pengabdian kepada masyarakat telah menjadi bagian penting dalam hidup saya. Saya mendapat kehormatan untuk mengabdi selama tiga tahun di Komite Peninjauan Desain dan delapan tahun di Komisi Perencanaan. Saya juga telah menjadi sukarelawan di Tim Tanggap Darurat Masyarakat (CERT) San Marino sejak 2011 dan telah menjadi anggota kru konstruksi San Marino Grad Night sejak 2013.</p><p dir=\"auto\">Secara profesional, saya bekerja di industri asuransi kesehatan, dengan spesialisasi dalam peningkatan kualitas dan analisis data. Pekerjaan saya mengharuskan saya untuk memahami peraturan negara bagian dan federal serta berkolaborasi dengan lembaga pengatur untuk memastikan akuntabilitas dan keunggulan.</p><p dir=\"auto\">Saya dan istri saya, Atlántida, adalah anggota Ss. Felicitas dan Gereja Perpetua, dan kami bersyukur menjadi bagian dari masyarakat yang istimewa ini. Saya berkomitmen untuk melestarikan karakter yang unik, keindahan, dan semangat kota kecil San Marino, dan saya akan merasa terhormat untuk terus melayani penduduk San Marino.</p>","JA":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN （ジョン・ダスティン）の声明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議会議員の候補者</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市会総選挙</h3><p dir=\"auto\">年齢：62歳</p><p dir=\"auto\">職業：品質改善専門家</p><p dir=\"auto\">1969年以来、San Marinoを故郷と呼べることを誇りに思ってきました。Carver小学校、Huntington中学校、およびSan Marino高校の卒業生として、私はこの地域社会に深く根ざしています。娘のStepahanieが同じ道を歩み、同じ学校を卒業するのを見守ることは、とりわけ感慨深いものでした。</p><p dir=\"auto\">公共奉仕は私の人生の中心的な部分を占めてきました。私は設計審査委員会（Design Review Committee）で3年間、計画委員会（Planning Commission）で八年間、委員を務める機会に恵まれました。私は2011年からSan Marino市民緊急対応チーム（CERT）でボランティア活動をしており、2013年からはSan Marino卒業記念行事（San Marino Grad Night）の設営団体の一員でもあります。</p><p dir=\"auto\">私は職業上、医療保険業界で、品質改善と資料分析を専門としています。私の仕事では、州および連邦の規制を的確に把握し、説明責任と卓越性を確保するために規制機関と協力することが求められます。</p><p dir=\"auto\">妻のAtlántidaとともに私たちは聖Felicitas and Perpetua教会（Ss. Felicitas and Perpetua Church）の信徒であり、このような特別な地域社会の一員であることに感謝しています。私はSan Marinoの独自の特色、美しさ、そして小さな町の精神を守ることに尽力しており、引き続きSan Marinoの住民の皆様に奉仕できれば光栄です。</p>","KM":"<h1 dir=\"auto\" style=\"text-align: center\">សេចក្តីថ្លែងការណ៍របស់ JOHN DUSTIN (ចន ដាស្ទីន)</h1><h2 dir=\"auto\" style=\"text-align: center\">បេក្ខជនសំរាប់ សមាជិកក្រុមប្រឹក្សាក្រុង</h2><h3 dir=\"auto\" style=\"text-align: center\">ការបោះឆ្នោតឃុំ សង្កាត់ ទូទៅរបស់ក្រុង ទីក្រុង SAN MARINO</h3><p dir=\"auto\">អាយុ ៖ 62 ឆ្នាំ</p><p dir=\"auto\">មុខរបរ ៖ អ្នកឯកទេសផ្នែកកែលម្អគុណភាព</p><p dir=\"auto\">ខ្ញុំមានមោទនភាពដែលបានហៅ San Marino ថាជាផ្ទះរបស់ខ្ញុំតាំងពីឆ្នាំ 1969 ។ ក្នុងនាមជាអតីតសិស្សនៃសាលាបឋមសិក្សា Carver សាលាមធ្យមសិក្សា Huntington និងវិទ្យាល័យ San Marino ខ្ញុំមានឫសគល់យ៉ាងជ្រៅនៅក្នុងសហគមន៍នេះ ។ វាមានអត្ថន័យយ៉ាងពិសេសសម្រាប់ខ្ញុំដែលបានឃើញកូនស្រីរបស់ខ្ញុំ Stepahanie ដើរតាមផ្លូវដូចគ្នា និងបញ្ចប់ការសិក្សាពីសាលាដដែលទាំងនេះ ។</p><p dir=\"auto\">ការបម្រើសាធារណៈគឺជាផ្នែកសំខាន់មួយនៃជីវិតរបស់ខ្ញុំ ។ ខ្ញុំមានកិត្តិយសបានបម្រើការរយៈពេលបីឆ្នាំនៅគណៈកម្មាធិការពិនិត្យការរចនា និងប្រាំបីឆ្នាំនៅគណៈកម្មការរៀបចំផែនការ ។ ខ្ញុំក៏បានធ្វើការងារស្ម័គ្រចិត្តជាមួយក្រុមឆ្លើយតបគ្រាអាសន្នសហគមន៍ San Marino (CERT) ចាប់តាំងពីឆ្នាំ 2011 និងជាសមាជិកក្រុមការងារសាងសង់សម្រាប់ព្រឹត្តិការណ៍ Grad Night របស់ San Marino ចាប់តាំងពីឆ្នាំ 2013 ។</p><p dir=\"auto\">ក្នុងវិជ្ជាជីវៈ ខ្ញុំធ្វើការក្នុងវិស័យធានារ៉ាប់រងសុខភាព ដោយផ្តោតលើការកែលម្អគុណភាព និងការវិភាគទិន្នន័យ ។ ការងាររបស់ខ្ញុំតម្រូវឱ្យដោះស្រាយបទប្បញ្ញត្តិរបស់រដ្ឋ និងសហព័ន្ធ និងសហការជាមួយស្ថាប័ននិយតកម្ម ដើម្បីធានាការទទួលខុសត្រូវ និងឧត្តមភាព ។</p><p dir=\"auto\">ភរិយារបស់ខ្ញុំ Atlántida និងខ្ញុំ ជាសមាជិកនៃព្រះវិហារ Ss. ព្រះវិហារ Felicitas and Perpetua ហើយយើងខ្ញុំមានអំណរគុណដែលបានក្លាយជាផ្នែកមួយនៃសហគមន៍ដ៏ពិសេសនេះ ។ ខ្ញុំប្តេជ្ញារក្សាលក្ខណៈពិសេស សម្រស់ និងស្មារតីទីក្រុងតូចរបស់ San Marino ហើយខ្ញុំនឹងមានកិត្តិយស ប្រសិនបើបានបន្តបម្រើប្រជាពលរដ្ឋរបស់ San Marino ។</p>","KO":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN (존 더스틴) 의 성명서</h1><h2 dir=\"auto\" style=\"text-align: center\">시의회 의원 후보</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 시 총지방선거</h3><p dir=\"auto\">연령: 62</p><p dir=\"auto\">직업: 품질 개선 전문가</p><p dir=\"auto\">저는 1969년부터 San Marino를 자랑스럽게 제 고향이라고 생각하며 살아왔습니다. 저는 Carver 초등학교, Huntington 중학교, San Marino 고등학교를 졸업했으며, 이 지역사회에 깊은 뿌리를 두고 있습니다. 제 딸 Stepahanie가 같은 학교들을 다니고 졸업하는 모습을 지켜본 것은 특히 뜻깊은 일이었습니다.</p><p dir=\"auto\">공공 서비스는 제 삶에서 중요한 부분을 차지해 왔습니다. 저는 디자인 검토 위원회에서 삼 년, 도시계획위원회에서 팔 년 동안 봉사할 수 있는 영광을 누렸습니다. 또한 2011년부터 San Marino Community Emergency Response Team (CERT)(San Marino 지역사회 비상대응팀)에서 자원봉사자로 활동해 왔으며, 2013년부터는 San Marino Grad Night(San Marino 졸업생들의 밤) 건설팀의 일원으로도 활동해 왔습니다.</p><p dir=\"auto\">직업적으로는 건강보험 업계에서 품질 개선 및 자료 분석을 전문으로 일하고 있습니다. 제 업무에는 주 및 연방 규정을 준수하고, 규제 기관들과 협력하여 책임성과 우수성을 확보하는 일이 포함됩니다.</p><p dir=\"auto\">제 아내 Atlántida와 저는 Ss. Felicitas and Perpetua 교회의 교인이며, 이렇게 특별한 지역사회의 일원이 될 수 있어 감사하게 생각합니다. 저는 San Marino의 고유한 특성과 아름다움, 소도시의 정취를 보존하는 데 전념하고 있으며, 주민들을 위해 계속 봉사할 수 있다면 영광으로 생각하겠습니다.</p>","MN":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN (ЖОН ДАСТИН)-ИЙН МЭДЭГДЭЛ</h1><h2 dir=\"auto\" style=\"text-align: center\">ХОТЫН ЗӨВЛӨЛИЙН ГИШҮҮНД НЭР ДЭВШИГЧ</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO ХОТЫН ЗАСАГ ЗАХИРГААНЫ ЕРӨНХИЙ СОНГУУЛЬ</h3><p dir=\"auto\">Нас: ‎62</p><p dir=\"auto\">Ажил мэргэжил: Чанар сайжруулалтын мэргэжилтэн</p><p dir=\"auto\">Би 1969 оноос хойш San Marino-г гэр орноо хэмээн бахархалтайгаар нэрлэж ирсэн. Carver бага сургууль, Huntington дунд сургууль болон San Marino ахлах сургуулийг төгссөн хүний хувьд би энэ орон нутагтайгаа гүн бат холбоотой. Охин Stepahanie маань мөн энэ замыг туулж, эдгээр сургуулиудыг төгссөнийг харах нь надад онцгой утга учиртай байлаа.</p><p dir=\"auto\">Төрийн алба миний амьдралын салшгүй хэсэг байсаар ирсэн. Би Дизайны Хяналтын хороонд гурван жил, Төлөвлөлтийн комисст найман жил ажилласан. Мөн 2011 оноос хойш San Marino Олон нийтийн онцгой байдлын үед хариу арга хэмжээ авах баг (CERT)-д сайн дурын ажил хийж, 2013 оноос San Marino Төгсөгчдийн үдэшлэгийн бүтээн байгуулалтын багийн гишүүнээр ажилласан.</p><p dir=\"auto\">Мэргэжлийн хувьд би эрүүл мэндийн даатгалын салбарт ажилладаг бөгөөд чанар сайжруулалт болон өгөгдлийн шинжилгээнд мэргэшсэн. Миний ажил нь мужийн болон холбооны дүрэм журмыг дагаж мөрдөх, хариуцлага болон өндөр чанарыг хангахын тулд зохицуулах байгууллагуудтай хамтран ажиллахыг шаарддаг.</p><p dir=\"auto\">Эхнэр Atlántida бид хоёр Ss. Felicitas and Perpetua сүмийн гишүүд бөгөөд ийм онцгой олон нийтийн нэг хэсэг байгаадаа талархдаг. Би San Marino-ийн өвөрмөц онцлог, үзэсгэлэнт байдал болон жижиг хотын уур амьсгалыг хадгалан хамгаалахыг эрмэлздэг бөгөөд San Marino-ийн оршин суугчдад цаашид үйлчлэх боломжтой бол нэр төрийн хэрэг гэж үзнэ.</p>","MY":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN (ဂျွန် ဒတ်စ်တင်) ၏ ထုတ်ပြန်ချက်</h1><h2 dir=\"auto\" style=\"text-align: center\">မြို့တော်ကောင်စီ၏ အဖွဲ့ဝင်အတွက် ကိုယ်စားလှယ်လောင်း</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO မြို့တော် အထွေထွေ မြူနီစီပယ် ရွေးကောက်ပွဲ</h3><p dir=\"auto\">အသက်- 62 နှစ်</p><p dir=\"auto\">အလုပ်အကိုင်- အရည်အသွေးမြှင့်တင်ရေး အထူးကျွမ်းကျင်သူ</p><p dir=\"auto\">1969 ခုနှစ်ကတည်းက San Marino မြို့ကို ကျွန်တော့်ရဲ့ အိမ်လို့ ခေါ်ခဲ့ရတာကို ဂုဏ်ယူမိပါတယ်။ Carver မူလတန်းကျောင်း၊ Huntington အလယ်တန်းကျောင်းနဲ့ San Marino အထက်တန်းကျောင်းတို့ရဲ့ ကျောင်းဆင်းတစ်ဦးအနေနဲ့ ဒီလူမှုအသိုင်းအဝိုင်းနဲ့ ကျွန်တော့်မှာ အမြစ်တွယ်နေတဲ့ နက်နက်ရှိုင်းရှိုင်း ဆက်နွယ်မှုတွေ ရှိပါတယ်။ ကျွန်တော့်သမီး Stepahanie လည်း အဲဒီလမ်းကြောင်းအတိုင်း လျှောက်လှမ်းပြီး အဲဒီကျောင်းတွေကနေပဲ ကျောင်းပြီးမြောက်ခဲ့တာကို မြင်တွေ့ရတာဟာ ကျွန်တော့်အတွက် အထူးပဲ အဓိပ္ပာယ်ရှိပြီး ဂုဏ်ယူစရာ ဖြစ်ပါတယ်။</p><p dir=\"auto\">လူထုအကျိုးသယ်ပိုးဆောင်ရွက်ခြင်းက ကျွန်တော့်ဘဝရဲ့ အမြဲတမ်းအဓိက ဖြစ်ခဲ့ပါတယ်။ ဒီဇိုင်း စိစစ်ရေး ကော်မတီမှာ သုံးနှစ်နဲ့ စီမံကိန်း ကော်မရှင်မှာ ရှစ်နှစ်ကြာ တာဝန်ထမ်းဆောင်ခွင့် ရရှိခဲ့တာဟာ ကျွန်တော့်အတွက် ဂုဏ်ယူစရာ အခွင့်ထူးတစ်ခု ဖြစ်ပါတယ်။ 2011 ခုနှစ်ကတည်းက San Marino CERT (ရပ်ရွာ အရေးပေါ် တုံ့ပြန်ရေးအဖွဲ့) မှာ စေတနာ့ဝန်ထမ်းအဖြစ် ပါဝင်ကူညီခဲ့ပြီး၊ 2013 ခုနှစ်ကစလို့ San Marino Grad Night (San Marino ကျောင်းဆင်းပွဲည) ဆောက်လုပ်ရေးအဖွဲ့သား တစ်ဦးအဖြစ်လည်း ပါဝင်ဆောင်ရွက်ခဲ့ပါတယ်။</p><p dir=\"auto\">အလုပ်အကိုင်အနေနဲ့ ကျန်းမာရေး အာမခံလုပ်ငန်းကဏ္ဍမှာ လုပ်ကိုင်နေပြီး အရည်အသွေး မြှင့်တင်ရေးနဲ့ အချက်အလက် ခွဲခြမ်းစိတ်ဖြာမှု ပညာရပ်တွေကို အထူးပြု လုပ်ကိုင်နေပါတယ်။ ကျွန်တော့်ရဲ့ အလုပ်တာဝန်တွေအရ ပြည်နယ်နဲ့ ဖက်ဒရယ် ဥပဒေစည်းမျဉ်းတွေကို လိုက်နာဆောင်ရွက်ရသလို၊ တာဝန်ယူမှု တာဝန်ခံမှုနဲ့ အကောင်းဆုံး အရည်အသွေးတွေ ပြည့်ဝစေဖို့အတွက် စည်းမျဉ်းထိန်းသိမ်းရေး အေဂျင်စီတွေနဲ့လည်း အနီးကပ် ပူးပေါင်းဆောင်ရွက်လျက် ရှိပါတယ်။</p><p dir=\"auto\">ကျွန်တော့်ဇနီး Atlántida နဲ့ ကျွန်တော်တို့က Ss. Felicitas နဲ့ Perpetua ဘုရားကျောင်း အသင်းဝင် ဖြစ်ပြီး ဒီလိုထူးခြားတဲ့ လူမှုအသိုင်းအဝိုင်းတစ်ခုရဲ့ အစိတ်အပိုင်းတစ်ခု ဖြစ်ခွင့်ရတဲ့အတွက် ကျေးဇူးတင်မိပါတယ်။ San Marino မြို့ရဲ့ ထူးခြားတဲ့ ပုံစံလက္ခဏာ၊ အလှအပနဲ့ မြို့ငယ်လေးတစ်မြို့ရဲ့ သွင်ပြင်လက္ခဏာတွေကို ထိန်းသိမ်းစောင့်ရှောက်ဖို့ ကျွန်တော် အပြည့်အဝ ကတိကဝတ်ပြုထားပြီး၊ San Marino မြို့သူမြို့သားတွေအတွက် ဆက်လက် တာဝန်ထမ်းဆောင်ခွင့် ရရှိမယ်ဆိုရင်လည်း အထူးပဲ ဂုဏ်ယူဝမ်းမြောက်မိမှာပါ။</p>","RU":"<h1 dir=\"auto\" style=\"text-align: center\">ЗАЯВЛЕНИЕ JOHN DUSTIN (ДЖОН ДАСТИН)</h1><h2 dir=\"auto\" style=\"text-align: center\">КАНДИДАТ В ЧЛЕНЫ ГОРОДСКОГО СОВЕТА</h2><h3 dir=\"auto\" style=\"text-align: center\">ОБЩИЕ МУНИЦИПАЛЬНЫЕ ВЫБОРЫ ГОРОДА SAN MARINO</h3><p dir=\"auto\">Возраст: 62</p><p dir=\"auto\">Род занятий: Специалист по улучшению качества</p><p dir=\"auto\">Я горжусь тем, что называю San Marino своим домом с 1969 года. Будучи выпускником начальной школы Carver, средней школы Huntington и старшей школы San Marino High, я глубоко связан с этим сообществом. Для меня особенно важно, что моя дочь Stepahanie выбрала тот же путь и окончила те же школы.</p><p dir=\"auto\">Государственная служба всегда занимала центральное место в моей жизни. Мне выпала честь три года проработать в Комитете по оценке дизайна и восемь лет в Комиссии по планированию. Кроме того, с 2011 года я являюсь волонтером в Группе реагирования на чрезвычайные ситуации в сообществе San Marino (CERT), а с 2013 года вхожу в состав строительной бригады, организующей ежегодный праздник для выпускников San Marino Grad Night.</p><p dir=\"auto\">В профессиональной сфере я работаю в индустрии медицинского страхования, специализируясь на повышении качества и анализе данных. Моя работа требует соблюдения норм штата и федеральных норм, а также сотрудничества с регулирующими органами для обеспечения подотчетности и высокого уровня обслуживания.</p><p dir=\"auto\">Моя жена Atlántida и я являемся прихожанами церкви Ss. Felicitas and Perpetua Church, и мы рады быть частью такого особенного сообщества. Я полон решимости сохранить уникальный характер, красоту и дух городка San Marino, и для меня большая честь продолжать служение его жителям.</p>","TE":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN (జాన్ డస్టిన్) స్టేట్​మెంట్</h1><h2 dir=\"auto\" style=\"text-align: center\">నగర పాలక మండలి సభ్యుని కొరకు అభ్యర్థి</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO నగర సాధారణ మునిసిపల్ ఎలక్షన్</h3><p dir=\"auto\">వయస్సు: 62</p><p dir=\"auto\">వృత్తి: నాణ్యతా మెరుగుదల నిపుణులు</p><p dir=\"auto\">నేను 1969 నుండి San Marino ను నా ఇల్లుగా పిలుచుకోవడం గర్వంగా భావిస్తున్నాను. Carver ఎలిమెంటరీ స్కూలు, Huntington మిడిల్ స్కూల్ మరియు San Marino హై స్కూలులో చదువుకున్న వ్యక్తిగా, ఈ కమ్యూనిటీలో నాకు లోతైన అనుబంధాలు ఉన్నాయి. నా కుమార్తె, Stephanie, కూడా అదే మార్గాన్ని అనుసరించి, అదే స్కూళ్ళల్లో చదువు పూర్తి చేయడం చూడటం నాకు ప్రత్యేకంగా ఎంతో అర్థవంతంగా అనిపించింది.</p><p dir=\"auto\">ప్రజా సేవ నా జీవితంలో కీలకమైన భాగంగా ఉంది. డిజైన్ సమీక్షా కమిటీలో మూడు సంవత్సరాలు మరియు ప్లానింగ్ కమిషన్‌లో ఎనిమిది సంవత్సరాలు సేవలందించే అవకాశం నాకు లభించింది. నేను 2011 నుండి San Marino కమ్యూనిటీ ఎమర్జెన్సీ రెస్పాన్స్ టీమ్ (CERT)తో వాలంటీర్‌గా ఉన్నాను మరియు 2013 నుండి San Marino Grad Night నిర్మాణ బృందంలో సభ్యుడిగా ఉన్నాను.</p><p dir=\"auto\">వృత్తిపరంగా, నేను ఆరోగ్య బీమా రంగంలో పనిచేస్తూ, నాణ్యత మెరుగుదల మరియు డేటా విశ్లేషణలో ప్రత్యేకత కలిగి ఉన్నాను. జవాబుదారీతనం మరియు అత్యుత్తమ ప్రమాణాలను నిర్ధారించేందుకు రాష్ట్ర మరియు ఫెడరల్ నిబంధనలను అనుసరించడం మరియు నియంత్రణ సంస్థలతో కలిసి పనిచేయడం నా పనిలో భాగం.</p><p dir=\"auto\">నా భార్య, Atlántida, మరియు నేను Ss. Felicitas మరియు Perpetua చర్చి సభ్యులం, మరియు ఇంత ప్రత్యేకమైన కమ్యూనిటీలో భాగంగా ఉండటం పట్ల మేము కృతజ్ఞులం. San Marino ప్రత్యేకత, అందం మరియు చిన్న పట్టణ స్ఫూర్తిని పరిరక్షించడానికి నేను కట్టుబడి ఉన్నాను, అలాగే San Marino నివాసితులకు సేవలందించడం కొనసాగించే అవకాశం నాకు లభిస్తే అది నాకు ఎంతో గౌరవంగా ఉంటుంది.</p>","TH":"<h1 dir=\"auto\" style=\"text-align: center\">แถลงการณ์ของ JOHN DUSTIN (จอห์น ดัสติน)</h1><h2 dir=\"auto\" style=\"text-align: center\">ผู้สมัครรับเลือกตั้งสำหรับตำแหน่ง<br dir=\"auto\">สมาชิกสภาเทศบาลเมือง</h2><h3 dir=\"auto\" style=\"text-align: center\">การเลือกตั้งทั่วไปเทศบาลเมือง SAN MARINO</h3><p dir=\"auto\">อายุ: 62</p><p dir=\"auto\">อาชีพ: ผู้เชี่ยวชาญด้านการปรับปรุงคุณภาพ</p><p dir=\"auto\">ผมภาคภูมิใจที่ได้เรียกเมือง San Marino เป็นบ้านมาตั้งแต่ปี 1969 ในฐานะศิษย์เก่าของโรงเรียนประถม Carver โรงเรียนมัธยมต้น Huntington และโรงเรียนมัธยมปลาย San Marino ผมจึงมีความผูกพันอย่างลึกซึ้งกับชุมชนแห่งนี้ การได้เห็นบุตรสาวของผม Stepahanie เดินตามเส้นทางเดียวกันกับผมและจบการศึกษาจากโรงเรียนเดียวกันนั้น เป็นสิ่งที่มีความหมายอย่างยิ่งสำหรับผม</p><p dir=\"auto\">การบริการสาธารณะเป็นส่วนสำคัญในชีวิตผมมาโดยตลอด ผมได้รับเกียรติให้ดำรงตำแหน่งในคณะกรรมาธิการพิจารณาการออกแบบเป็นเวลาสามปี และในคณะกรรมาธิการผังเมืองเป็นเวลาแปดปี นอกจากนี้ ผมยังเป็นอาสาสมัครให้กับทีมรับมือเหตุฉุกเฉินของชุมชน San Marino (CERT) มาตั้งแต่ปี 2011 และเป็นสมาชิกทีมจัดเตรียมงานเลี้ยงจบการศึกษาของโรงเรียนมัธยมปลาย San Marino มาตั้งแต่ปี 2013</p><p dir=\"auto\">ในด้านอาชีพ ผมทำงานในอุตสาหกรรมการประกันสุขภาพ โดยมีความเชี่ยวชาญด้านการปรับปรุงคุณภาพและการวิเคราะห์ข้อมูล งานของผมเกี่ยวข้องกับการทำความเข้าใจกฎระเบียบของรัฐและรัฐบาลกลาง และการทำงานร่วมกับหน่วยงานกำกับดูแลเพื่อให้มั่นใจได้ถึงความรับผิดชอบและความเป็นเลิศ</p><p dir=\"auto\">ผมและภรรยา Atlántida เป็นสมาชิกของโบสถ์ Ss. Felicitas and Perpetua และเรารู้สึกซาบซึ้งที่ได้เป็นส่วนหนึ่งของชุมชนที่พิเศษแห่งนี้ ผมมุ่งมั่นที่จะรักษาเอกลักษณ์ ความงดงาม และจิตวิญญาณของความเป็นเมืองเล็กอย่าง San Marino และผมรู้สึกเป็นเกียรติอย่างยิ่งที่จะได้ทำหน้าที่รับใช้ชาวเมือง San Marino ต่อไป</p>","TL":"<h1 dir=\"auto\" style=\"text-align: center\">PAHAYAG NI JOHN DUSTIN</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDATO PARA MIYEMBRO NG KONSEHO NG LUNGSOD</h2><h3 dir=\"auto\" style=\"text-align: center\">PANGKALAHATANG HALALANG MUNISIPAL NG LUNGSOD NG SAN MARINO</h3><p dir=\"auto\">Edad: 62</p><p dir=\"auto\">Trabaho: Espesyalista sa Pagpapabuti ng Kalidad</p><p dir=\"auto\">Ipinagmamalaki kong tawaging tahanan ang San Marino simula pa noong 1969. Bilang nagtapos sa Mababang Paaralan ng Carver, Gitnang Paaralan ng Huntington, at Mataas na Paaralan ng San Marino, malalim ang aking pinagmulan sa komunidad na ito. Lalong naging makabuluhan ang masaksihan ang aking anak na si Stepahanie, na tahakin ang parehong landas at magtapos mula sa mga paaralang iyon.</p><p dir=\"auto\">Ang paglingkod sa publiko ay naging mahalagang bahagi ng aking buhay. Nagkaroon ako ng pribilehiyong maglingkod nang tatlong taon sa Komite sa Pagsusuri ng Disenyo at walong taon sa Komisyon sa Pagpaplano. Nagboluntaryo rin ako sa San Marino Community Emergency Response Team (CERT) simula noong 2011 at naging miyembro ng mga manggagawa sa konstruksyon ng San Marino Grad Night simula noong 2013.</p><p dir=\"auto\">Sa propesyonal na aspeto, nagtatrabaho ako sa industriya ng mga segurong pangkalusugan, na dalubhasa sa pagpapabuti ng kalidad at pagsusuri ng datos. Ang aking trabaho ay nangangailangan ng pagsunod sa mga regulasyon ng estado at pederal at pakikipagtulungan sa mga ahensya ng regulasyon upang matiyak ang pananagutan at kahusayan.</p><p dir=\"auto\">Kami ng aking asawang si Atlántida ay mga miyembro ng Ss. Simbahan ng Felicitas at Perpetua, at nagpapasalamat kami na maging bahagi ng isang natatanging komunidad. Nakatuon ako sa pangangalaga ng natatanging katangian, kagandahan, at diwa ng maliit na bayan ng San Marino, at isang karangalan para sa akin na patuloy na maglingkod sa mga residente ng San Marino.</p>","VI":"<h1 dir=\"auto\" style=\"text-align: center\">BÀI PHÁT BIỂU CỦA JOHN DUSTIN</h1><h2 dir=\"auto\" style=\"text-align: center\">ỨNG CỬ VIÊN CHO CHỨC VỤ ỦY VIÊN HỘI ĐỒNG THÀNH PHỐ</h2><h3 dir=\"auto\" style=\"text-align: center\">TỔNG TUYỂN CỬ ĐỊA PHƯƠNG CỦA THÀNH PHỐ SAN MARINO</h3><p dir=\"auto\">Tuổi: ‎62</p><p dir=\"auto\">Nghề Nghiệp: Chuyên Gia Cải Tiến Chất Lượng</p><p dir=\"auto\">Tôi rất tự hào được coi San Marino là quê hương kể từ năm 1969. Là cựu học sinh Trường Tiểu Học Carver, Trường Trung Học Cơ Sở Huntington và Trường Trung Học Phổ Thông San Marino, tôi có sự gắn bó sâu sắc với cộng đồng này. Điều đặc biệt ý nghĩa đối với tôi là được chứng kiến con gái mình, Stepahanie, đi theo con đường tương tự và tốt nghiệp chính những ngôi trường đó.</p><p dir=\"auto\">Phục vụ cộng đồng đã trở thành một phần quan trọng trong cuộc đời tôi. Tôi đã có vinh dự phục vụ ba năm tại Ủy Ban Xem Xét Thiết Kế và tám năm tại Ủy ban Quy Hoạch. Tôi cũng đã tình nguyện tham gia Đội Ứng Phó Khẩn Cấp Cộng Đồng San Marino (CERT) từ năm 2011 và là thành viên của đội thi công San Marino Grad Night từ năm 2013.</p><p dir=\"auto\">Về chuyên môn, tôi làm việc trong ngành bảo hiểm y tế, chuyên về cải tiến chất lượng và phân tích dữ liệu. Công việc của tôi đòi hỏi phải tuân thủ các quy định của tiểu bang và liên bang, đồng thời phối hợp với các cơ quan quản lý để đảm bảo trách nhiệm giải trình và chất lượng cao.</p><p dir=\"auto\">Vợ tôi, Atlántida, và tôi là thành viên của Giáo xứ Ss. Felicitas and Perpetua, và chúng tôi rất biết ơn khi được là một phần của cộng đồng đặc biệt này. Tôi cam kết bảo tồn nét đặc trưng, vẻ đẹp và tinh thần của một thành phố nhỏ độc đáo của San Marino, và tôi sẽ rất vinh dự nếu được tiếp tục phục vụ cư dân San Marino.</p>","ZH":"<h1 dir=\"auto\" style=\"text-align: center\">JOHN DUSTIN（約翰·達斯汀）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議會議員候選人</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市市政大選</h3><p dir=\"auto\">年齡：62</p><p dir=\"auto\">職業：品質改善專員</p><p dir=\"auto\">自 1969 年以來，我一直引以為傲地將 San Marino 視為自己的家。我畢業於 Carver 小學、Huntington 中學以及 San Marino 高中，在這個社區有深厚的在地淵源。看著我的女兒 Stepahanie 走上同樣的求學道路，也從這些學校畢業，對我來說意義格外深遠。</p><p dir=\"auto\">公共服務一直是我生活中至關重要的一部分。我有幸在設計審查委員會服務三年，在規劃委員會服務八年。我自 2011 年起擔任 San Marino 社區緊急應變團隊（CERT）義工，並自 2013 年起成為 San Marino Grad Night 活動搭建團隊的成員。</p><p dir=\"auto\">職業方面，我任職於健康保險產業，專長為品質改善與數據分析。我的工作需要熟稔州與聯邦法規，並與監管機關合作，落實問責機制，追求卓越表現。</p><p dir=\"auto\">我與妻子 Atlántida 是 Ss. Felicitas and Perpetua Church 的教友，很感恩能夠身處這個如此溫馨的社區。我致力守護 San Marino 獨特的風貌、景觀與小鎮精神，若能繼續為 San Marino 的居民服務，我將深感榮幸。</p>"},"CandidateID":"RE","SequenceOrder":210}],"order":2,"isWriteIn":false,"isPresidential":false},{"id":"RF","name":[{"BN":"শেলি বয়েল","CC":"雪莉·博伊爾","EN":"SHELLEY BOYLE","FA":"شلی بویل","GU":"શેલી બૉયલ","HI":"शेली बॉयल","HY":"ՇԵԼԼԻ ԲՈՅԼ","JA":"シェリー・ボイル","KM":"សែលលី ប៊យល៍","KO":"셸리 보일","MN":"ШЕЛЛИ БОЙЛ","MY":"ရှယ်လီ ဘွိုင်းလ်","RU":"ШЕЛЛИ БОЙЛ","TE":"షెల్లీ బోయల్","TH":"เชลลีย์ บอยล์","ZH":"雪莉·博伊爾"}],"short_name":[{"EN":"SHELLEY BOYLE"}],"occupation":[{"BN":"অলাভজনক সংস্থার নির্বাহী পরিচালক","CC":"非營利組織執行董事","EN":"Non-Profit Executive Director","ES":"Directora Ejecutiva de Organización Sin Fines de Lucro","FA":"مدیر اجرایی سازمان غیرانتفاعی","GU":"બિન-લાભકારી સંસ્થા કાર્યકારી  નિર્દેશિકા","HI":"गैर-लाभकारी कार्यकारी निदेशिका","HY":"Շահույթ չհետապնդող ընկերության գործադիր տնօրեն","ID":"Direktur Eksekutif Organisasi Nirlaba","JA":"非営利団体事務局長","KM":"នាយកប្រតិបត្តិអង្គការមិនស្វែងរកប្រាក់ចំណេញ","KO":"비영리 단체 임원 이사","MN":"Ашгийн бус байгууллагын гүйцэтгэх захирал","MY":"အကျိုးအမြတ်မယူသောအဖွဲ့အစည်း၏ အမှုဆောင်ဒါရိုက်တာ","RU":"Исполнительный директор некоммерческой организации","TE":"నాన్​ప్రాఫిట్ ఎగ్జిక్యూటివ్ డైరెక్టర్","TH":"ผู้อำนวยการบริหารองค์กรไม่แสวงหากำไร","TL":"Tagapagpaganap na Direktor ng Di-Nagtutubo","VI":"Giám Đốc Điều Hành Tổ Chức Bất Vụ Lợi","ZH":"非營利組織執行董事"}],"statements":[{"ID":"C0002673405E","FullHTML":{"BN":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE (শেলি বয়েল)-এর বিবৃতি</h1><h2 dir=\"auto\" style=\"text-align: center\">সিটি কাউন্সিলের সদস্য প্রার্থী</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO সিটি সাধারণ পৌরসভা নির্বাচন</h3><p dir=\"auto\">বয়স: 55</p><p dir=\"auto\">পেশা: অলাভজনক সংস্থার নির্বাহী পরিচালক</p><p dir=\"auto\">San Marino তে জন্ম ও বেড়ে ওঠা আমার, যে সম্প্রদায়টি আমার জীবনকে গড়ে তুলেছে, সেই সম্প্রদায়ের সিটি কাউন্সিলের প্রার্থী হতে পেরে আমি সম্মানিত বোধ করছি। এখানে বেড়ে ওঠার ফলে San Marino মূল্যবোধ, ঐতিহ্য এবং সামাজিক সম্প্রীতির প্রতি আমার গভীর উপলব্ধি জন্মেছে, যা এই স্থানটিকে এতটা বিশেষ করে তুলেছে।</p><p dir=\"auto\">বিগত আট বছর ধরে, আমি San Marino পরিকল্পনা কমিশনে কাজ করার সৌভাগ্য লাভ করেছি, যেখানে আমি আমাদের শহরের বৈশিষ্ট্য সংরক্ষণের সাথে উন্নয়নের বিচক্ষণ ভারসাম্য রক্ষার জন্য কাজ করে চলেছি। আমি আমাদের ঐতিহাসিক বাড়িঘর রক্ষা করতে, নগর বন সংরক্ষণ করতে, দায়িত্বশীল অর্থনৈতিক উন্নয়নকে সমর্থন করতে এবং ভবিষ্যৎ সিদ্ধান্তগুলো যেন আমাদের বাসিন্দাদের অগ্রাধিকারকে প্রতিফলিত করে তা নিশ্চিত করতে প্রতিশ্রুতিবদ্ধ।</p><p dir=\"auto\">আমাদের সমাজ বিকশিত হওয়ার সাথে সাথে, San Marino পরিচয়বাহী বৈশিষ্ট্যগুলোকে সুরক্ষিত রেখে আমাদের অবশ্যই এমন সুযোগ গ্রহণ করতে হবে যা একে শক্তিশালী করে। আমি বিশ্বাস করি, আমরা আমাদের ইতিহাসকে সম্মান জানাতে, ভবিষ্যতে বিচক্ষণতার সাথে বিনিয়োগ করতে এবং বাসিন্দাদের প্রত্যাশিত অসাধারণ পরিষেবা ও সামাজিক সম্প্রীতি বজায় রাখতে পারব। আপনার সমর্থন এবং সিটি কাউন্সিলের সদস্য হিসেবে San Marino সেবা করার সুযোগ পেলে আমি কৃতজ্ঞ থাকব।</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","CC":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE（雪莉·博伊爾）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議會議員候選人</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市市政大選</h3><p dir=\"auto\">年齡：55</p><p dir=\"auto\">職業：非營利組織執行董事</p><p dir=\"auto\">我在 San Marino 土生土長，能夠作為候選人，參選這座形塑我人生的社區之市議會，我深感榮幸。在這裡成長，讓我深深體會造就 San Marino 如此獨特的價值觀、傳統與社區共識。</p><p dir=\"auto\">過去八年，我有幸任職 San Marino Planning Commission，致力於審慎平衡城市發展與維護本市既有風貌。我致力保護歷史住宅、守護城市林木、支持負責任的經濟發展，並確保未來各項決策能夠反映居民的優先訴求。</p><p dir=\"auto\">隨著社區不斷發展，我們必須把握機會壯大 San Marino，同時守護這座城市的獨特本質。我相信我們可以尊重歷史、審慎投資未來，維持居民所期待的高品質市政服務與社區凝聚力。若能獲得您的支持，有機會以市議會成員的身分為 San Marino 服務，我將滿心感激。</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","EN":"<h1 dir=\"auto\" style=\"text-align: center\">STATEMENT OF SHELLEY BOYLE</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATE FOR MEMBER OF THE CITY COUNCIL</h2><h3 dir=\"auto\" style=\"text-align: center\">CITY OF SAN MARINO GENERAL MUNICIPAL ELECTION</h3><p dir=\"auto\">Age: 55</p><p dir=\"auto\">Occupation: Non-Profit Executive Director</p><p dir=\"auto\">Born and raised in San Marino, I am honored to be a candidate for City Council in the community that has shaped my life. Growing up here gave me a deep appreciation for the values, traditions, and sense of community that make San Marino such a special place.</p><p dir=\"auto\">For the past eight years, I have had the privilege of serving on the San Marino Planning Commission, working to thoughtfully balance growth with preserving the character of our city. I am committed to protecting our historic homes, preserving our urban forest, supporting responsible economic development, and ensuring that future decisions reflect the priorities of our residents.</p><p dir=\"auto\">As our community evolves, we must embrace opportunities that strengthen San Marino while safeguarding the qualities that define it. I believe we can honor our history, invest wisely in our future, and maintain the exceptional services and sense of community that residents expect. I would be grateful for your support and the opportunity to serve San Marino as a member of the City Council.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","ES":"<h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE SHELLEY BOYLE</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATA PARA MIEMBRO DEL CONCEJO DE LA CIUDAD</h2><h3 dir=\"auto\" style=\"text-align: center\">ELECCIÓN MUNICIPAL GENERAL DE LA CIUDAD DE SAN MARINO</h3><p dir=\"auto\">Edad: 55</p><p dir=\"auto\">Ocupación: Directora Ejecutiva de Organización Sin Fines de Lucro</p><p dir=\"auto\">Nací y crecí en San Marino, y me siento honrada de ser candidata para el Concejo de la Ciudad de la comunidad que ha marcado mi vida. Haber crecido aquí me ha inculcado un profundo aprecio por los valores, las tradiciones y el sentido de comunidad que hacen de San Marino un lugar tan especial.</p><p dir=\"auto\">Durante los últimos ocho años, he tenido el privilegio de formar parte de la Comisión de Planificación de San Marino, trabajando para lograr un equilibrio entre el crecimiento y la preservación del carácter de nuestra ciudad. Me comprometo a proteger nuestras casas históricas, preservar nuestro bosque urbano, apoyar un desarrollo económico responsable y garantizar que las decisiones futuras reflejen las prioridades de nuestros residentes.</p><p dir=\"auto\">A medida que nuestra comunidad evoluciona, debemos aprovechar las oportunidades que fortalezcan San Marino, al tiempo que salvaguardamos las cualidades que la definen. Creo que podemos honrar nuestra historia, invertir sabiamente en nuestro futuro y mantener los servicios excepcionales y el sentido de comunidad que esperan los residentes. Agradecería su apoyo y la oportunidad de servir a San Marino como miembro del Concejo de la Ciudad.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>\n","FA":"<h1 dir=\"rtl\" style=\"text-align: center\">بیانیه SHELLEY BOYLE (شلی بویل)</h1><h2 dir=\"rtl\" style=\"text-align: center\">کاندید برای عضو شورای شهر</h2><h3 dir=\"rtl\" style=\"text-align: center\">انتخابات عمومی شهرداری شهر SAN MARINO</h3><p dir=\"rtl\">سن: 55</p><p dir=\"rtl\">شغل: مدیر اجرایی سازمان غیرانتفاعی</p><p dir=\"rtl\">من که در San Marino متولد و بزرگ شده‌ام، مفتخرم که نامزد شورای شهر در جامعه‌ای هستم که زندگی مرا شکل داده است. بزرگ شدن در اینجا به من درک عمیقی از ارزش‌ها، سنت‌ها و حس تعلق به جامعه داد که San Marino را به چنین مکان ویژه‌ای تبدیل کرده است.</p><p dir=\"rtl\">در هشت سال گذشته، افتخار خدمت در کمیسیون برنامه‌ریزی San Marino را داشته‌ام و تلاش کرده‌ام میان توسعه و حفظ هویت و ویژگی‌های منحصربه‌ فرد شهرمان، توازنی سنجیده برقرار کنم. من متعهد هستم از خانه‌های تاریخی‌مان محافظت کنم، پوشش درختی شهری‌مان را حفظ کنم، از توسعه اقتصادی مسئولانه حمایت کنم و اطمینان حاصل کنم که تصمیمات آینده، اولویت‌های اهالی شهرمان را منعکس می‌کنند.</p><p dir=\"rtl\">همزمان با تکامل جامعه ما، باید از فرصت‌هایی که San Marino را تقویت می‌کنند، استقبال کنیم و در عین حال از ویژگی‌هایی که آن را تعریف می‌کنند، محافظت کنیم. من معتقدم که می‌توانیم به تاریخ خود احترام بگذاریم، عاقلانه برای آینده خود سرمایه‌گذاری کنیم و خدمات استثنایی و حس تعلق اجتماعی را که ساکنان انتظار دارند، حفظ کنیم. از حمایت شما و فرصتی که برای خدمت به San Marino به عنوان عضوی از شورای شهر در اختیار من قرار می‌دهید، سپاسگزار خواهم بود.</p><p dir=\"rtl\"></p><p dir=\"rtl\"></p>","GU":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE (શેલી બૉયલ)નું નિવેદન</h1><h2 dir=\"auto\" style=\"text-align: center\">શહેર પરિષદના સભ્ય માટેના ઉમેદવાર</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO શહેર સામાન્ય નગરપાલિકા ચૂંટણી</h3><p dir=\"auto\">ઉંમર: 55</p><p dir=\"auto\">વ્યવસાય: બિન-લાભકારી સંસ્થાના કાર્યકારી નિયામક</p><p dir=\"auto\">San Marinoમાં જન્મેલા અને ઉછરેલા, મારા જીવનને આકાર આપનારા સમુદાયમાં શહેર પરિષદના ઉમેદવાર બનવાનો મને ગર્વ છે. અહીં ઉછરવાથી મને San Marinoને આટલું ખાસ સ્થાન બનાવતા મૂલ્યો, પરંપરાઓ, અને સમુદાયની ભાવના પ્રત્યે ઊંડી કદર થઈ છે.</p><p dir=\"auto\">છેલ્લા આઠ વર્ષોથી, મને San Marino આયોજન પંચમાં સેવા આપવાનો લહાવો મળ્યો છે, આપણા શહેરના પાત્રને જાળવવા સાથે વિકાસને વિચારપૂર્વક સંતુલિત કરવા માટે કામ કરી રહી છું. હું આપણા ઐતિહાસિક ઘરોનું રક્ષણ કરવા, આપણા શહેરી જંગલનું સંરક્ષણ કરવા, જવાબદાર આર્થિક વિકાસને ટેકો આપવા અને ભવિષ્યના નિર્ણયો આપણા રહેવાસીઓની પ્રાથમિકતાઓને પ્રતિબિંબિત કરે છે તેની ખાતરી કરવા માટે પ્રતિબદ્ધ છું.</p><p dir=\"auto\">જેમ જેમ આપણો સમુદાય વિકસિત થાય છે, તેમ તેમ આપણે એવી તકોને સ્વીકારવી જોઈએ જે તેને વ્યાખ્યાયિત કરતા ગુણોનું રક્ષણ કરતી વખતે San Marinoને મજબૂત બનાવે છે. હું માનું છું કે આપણે આપણા ઇતિહાસનું સન્માન કરી શકીએ છીએ, આપણા ભવિષ્યમાં સમજદારીપૂર્વક રોકાણ કરી શકીએ છીએ, અને રહેવાસીઓ અપેક્ષા રાખે છે તે અસાધારણ સેવાઓ અને સમુદાયની ભાવના જાળવી શકીએ છીએ. હું તમારા સમર્થન અને શહેર પરિષદના સભ્ય તરીકે San Marinoની સેવા કરવાની તક માટે આભારી રહીશ.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","HI":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE (शेली बॉयल) का वक्तव्य</h1><h2 dir=\"auto\" style=\"text-align: center\">नगर परिषद सदस्या के लिए उम्मीदवार</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO शहर आम नगरपालिका चुनाव</h3><p dir=\"auto\">उम्र: 55</p><p dir=\"auto\">व्यवसाय: गैर-लाभकारी कार्यकारी निदेशिका</p><p dir=\"auto\">San Marino में जन्मी और पली-बढ़ी होने के नाते, मुझे उस समुदाय में नगर परिषद के लिए उम्मीदवार होने का सम्मान प्राप्त है जिसने मेरे जीवन को आकार दिया है। San Marino में बड़े होने से मुझे उन मूल्यों, परंपराओं और सामुदायिक भावना के प्रति गहरी सराहना मिली जो San Marino को इतना खास स्थान बनाते हैं।</p><p dir=\"auto\">पिछले आठ वर्षों से, मुझे San Marino योजना आयोग में सेवा करने का सौभाग्य प्राप्त हुआ है, जहाँ मैंने शहर के चरित्र को संरक्षित करते हुए और विकास करने के बीच सोच-समझकर संतुलन बनाने के लिए काम किया है। मैं हमारे ऐतिहासिक घरों की रक्षा करने, हमारे शहरी वनों को संरक्षित करने, जिम्मेदार आर्थिक विकास का समर्थन करने और यह सुनिश्चित करने के लिए प्रतिबद्ध हूँ कि भविष्य के निर्णय हमारे निवासियों की प्राथमिकताओं को प्रतिबिंबित करें।</p><p dir=\"auto\">जैसे-जैसे हमारा समुदाय विकसित होता है, हमें उन अवसरों को अपनाना चाहिए जो San Marino को मजबूत करें और साथ ही उन गुणों की रक्षा करें जो इसे परिभाषित करते हैं। मुझे विश्वास है कि हम अपने इतिहास का सम्मान कर सकते हैं, अपने भविष्य में बुद्धिमानी से निवेश कर सकते हैं और निवासियों द्वारा अपेक्षित असाधारण सेवाओं और सामुदायिक भावना को बनाए रख सकते हैं। मैं आपके समर्थन और San Marino की नगर परिषद की सदस्या के रूप में सेवा करने के अवसर के लिए आभारी रहूँगी।</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","HY":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE-Ի (ՇԵԼԼԻ ԲՈՅԼ) ՀԱՅՏԱՐԱՐՈՒԹՅՈՒՆԸ</h1><h2 dir=\"auto\" style=\"text-align: center\">ՔԱՂԱՔԱՅԻՆ ԽՈՐՀՐԴԻ ԱՆԴԱՄԻ ԹԵԿՆԱԾՈՒ</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO ՔԱՂԱՔԻ ԸՆԴՀԱՆՈՒՐ ՔԱՂԱՔԱՅԻՆ ԸՆՏՐՈՒԹՅՈՒՆ</h3><p dir=\"auto\">Տարիքը՝ 55</p><p dir=\"auto\">Պաշտոնը՝ Շահույթ չհետապնդող ընկերության գործադիր տնօրեն</p><p dir=\"auto\">Ծնված և մեծացած լինելով San Marino քաղաքում, ինձ համար պատիվ է հանդես գալ որպես քաղաքային խորհրդի թեկնածու այն համայնքում, որը ձևավորել է իմ կյանքը։ Այստեղ մեծանալով, խորությամբ եմ գնահատում այն արժեքները, ավանդույթները և համայնքը, որոնք San Marino-ն դարձնում են այդ չափ յուրահատուկ վայր։</p><p dir=\"auto\">Վերջին ութ տարիների ընթացքում ես պատիվ եմ ունեցել ծառայելու San Marino-ի քաղաքաշինության հանձնաժողովում՝ աշխատելով մտածված կերպով հավասարակշռել զարգացումը մեր քաղաքի առանձնահատկությունների պահպանման հետ։ Ես հանձնառու եմ պաշտպանել մեր պատմական տները, պահպանել մեր քաղաքային անտառը, աջակցել պատասխանատու տնտեսական զարգացմանը և ապահովել, որ ապագա որոշումները արտացոլեն մեր բնակիչների առաջնահերթությունները։</p><p dir=\"auto\">Մեր համայնքի զարգացմանը զուգընթաց մենք պետք է օգտվենք այն հնարավորություններից, որոնք կամրապնդեն San Marino-ն՝ միաժամանակ պահպանելով քաղաքին հատուկ հատկանիշները։ Ես հավատում եմ, որ մենք կարող ենք հարգել մեր պատմությունը, իմաստուն կերպով ներդրումներ կատարել մեր ապագայի համար և պահպանել բնակիչների կողմից ակնկալվող բացառիկ ծառայություններն ու համախմբված համայնքի զգացումը։ Ես շնորհակալ կլինեմ ձեր աջակցության և San Marino-ի Քաղաքային խորհրդի անդամի կարգավիճակով ծառայելու հնարավորության համար։</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","ID":"<h1 dir=\"auto\" style=\"text-align: center\">PERNYATAAN SHELLEY BOYLE</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDAT UNTUK ANGGOTA DEWAN KOTA</h2><h3 dir=\"auto\" style=\"text-align: center\">PEMILIHAN UMUM TINGKAT KOTAMADYA KOTA SAN MARINO</h3><p dir=\"auto\">Usia: 55</p><p dir=\"auto\">Pekerjaan: Direktur Eksekutif Organisasi Nirlaba</p><p dir=\"auto\">Lahir dan besar di San Marino, saya merasa terhormat menjadi kandidat Dewan Kota di masyarakat yang telah membentuk hidup saya. Tumbuh dewasa di sini memberi saya apresiasi yang mendalam terhadap nilai-nilai, tradisi, dan rasa kebersamaan yang menjadikan San Marino tempat yang begitu istimewa.</p><p dir=\"auto\">Selama delapan tahun terakhir, saya telah mendapat kehormatan untuk bertugas di Komisi Perencanaan San Marino, bekerja untuk menyeimbangkan pertumbuhan dengan pelestarian karakter kota kita secara bijaksana. Saya berkomitmen untuk melindungi rumah-rumah bersejarah kita, melestarikan hutan kota kita, mendukung pembangunan ekonomi yang bertanggung jawab, dan memastikan bahwa keputusan-keputusan di masa mendatang mencerminkan prioritas warga kita.</p><p dir=\"auto\">Seiring perkembangan masyarakat kita, kita harus merangkul peluang yang memperkuat San Marino sekaligus menjaga kualitas yang mendefinisikannya. Saya percaya kita dapat menghormati sejarah kita, berinvestasi dengan bijak untuk masa depan kita, dan mempertahankan layanan luar biasa serta rasa kebersamaan yang diharapkan oleh warga. Saya akan sangat berterima kasih atas dukungan Anda dan kesempatan untuk melayani San Marino sebagai anggota Dewan Kota.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","JA":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE （シェリー・ボイル）の声明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議会議員の候補者</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市会総選挙</h3><p dir=\"auto\">年齢：55歳</p><p dir=\"auto\">職業：非営利団体事務局長</p><p dir=\"auto\">San Marinoで生まれ育った私は、私の人生を形作ってきたこの地域社会で市議会候補者になれたことを光栄に思います。ここで育ったことで、San Marinoを特別な場所にしている価値観、伝統、そして地域社会のつながりを深く理解し、感謝するようになりました。</p><p dir=\"auto\">過去八年間、私はSan Marino都市計画委員会（San Marino Planning Commission）の委員を務めるという光栄な機会に恵まれ、都市の成長と街の特性の維持との均衡を慎重に取るべく尽力してきました。私は、歴史的建造物の保護、都市森林の保全、責任ある経済発展の支援、そして将来の決定が住民の優先事項を反映したものとなるよう尽力します。</p><p dir=\"auto\">私たちの地域社会が発展していく中で、San Marinoを特徴づけるその要素を守りつつも、San Marinoを強化する機会を積極的に取り入れていかなければなりません。私たちは歴史を尊重し、未来に向けて賢明な投資を行い、住民が期待する優れた行政事業と地域社会のつながりを維持できると信じています。皆様のご支援と、市議会議員としてSan Marinoに奉仕する機会をいただければ幸いです。</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","KM":"<h1 dir=\"auto\" style=\"text-align: center\">សេចក្តីថ្លែងការណ៍របស់ SHELLEY BOYLE (សែលលី ប៊យល៍)</h1><h2 dir=\"auto\" style=\"text-align: center\">បេក្ខជនសំរាប់ សមាជិកក្រុមប្រឹក្សាក្រុង</h2><h3 dir=\"auto\" style=\"text-align: center\">ការបោះឆ្នោតឃុំ សង្កាត់ ទូទៅរបស់ក្រុង ទីក្រុង SAN MARINO</h3><p dir=\"auto\">អាយុ ៖ 55 ឆ្នាំ</p><p dir=\"auto\">មុខរបរ ៖ នាយកប្រតិបត្តិអង្គការមិនស្វែងរកប្រាក់ចំណេញ</p><p dir=\"auto\">កើត និងធំដឹងក្តីនៅ San Marino ខ្ញុំមានកិត្តិយសដែលបានក្លាយជាបេក្ខជនសម្រាប់ក្រុមប្រឹក្សាក្រុង ក្នុងសហគមន៍ដែលបានបង្កើតជីវិតរបស់ខ្ញុំ ។ ការធំដឹងក្តីនៅទីនេះបានផ្តល់ឱ្យខ្ញុំនូវការយល់ដឹងយ៉ាងជ្រាលជ្រៅអំពីគុណតម្លៃ ប្រពៃណី និងស្មារតីសហគមន៍ ដែលធ្វើឱ្យ San Marino ក្លាយជាទីកន្លែងដ៏ពិសេស ។</p><p dir=\"auto\">អស់រយៈពេលប្រាំបីឆ្នាំកន្លងមកនេះ ខ្ញុំមានកិត្តិយសបានបម្រើការនៅគណៈកម្មការរៀបចំផែនការរបស់ San Marino ដោយធ្វើការដើម្បីសម្របសម្រួលកំណើនប្រកបដោយការគិតគូរ ជាមួយនឹងការរក្សាលក្ខណៈពិសេសរបស់ទីក្រុងរបស់យើង ។ ខ្ញុំប្តេជ្ញាការពារផ្ទះប្រវត្តិសាស្ត្ររបស់យើង រក្សាព្រៃឈើក្នុងទីក្រុងរបស់យើង គាំទ្រការអភិវឌ្ឍសេដ្ឋកិច្ចប្រកបដោយការទទួលខុសត្រូវ និងធានាថា ការសម្រេចចិត្តនាពេលអនាគតឆ្លុះបញ្ចាំងពីអាទិភាពរបស់ប្រជាពលរដ្ឋរបស់យើង ។</p><p dir=\"auto\">នៅពេលសហគមន៍របស់យើងវិវត្ត យើងត្រូវទទួលយកឱកាសដែលពង្រឹង San Marino ខណៈពេលដែលការពារគុណលក្ខណៈដែលកំណត់អត្តសញ្ញាណរបស់ទីក្រុងនេះ ។ ខ្ញុំជឿថា យើងអាចគោរពប្រវត្តិសាស្ត្ររបស់យើង វិនិយោគប្រកបដោយការប្រុងប្រយ័ត្នទៅក្នុងអនាគតរបស់យើង និងរក្សាសេវាកម្មដ៏ល្អប្រសើរ និងស្មារតីសហគមន៍ដែលប្រជាពលរដ្ឋរំពឹងទុក ។ ខ្ញុំនឹងមានអំណរគុណចំពោះការគាំទ្ររបស់លោកអ្នក និងឱកាសក្នុងការបម្រើ San Marino ក្នុងនាមជាសមាជិកក្រុមប្រឹក្សាក្រុង ។</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","KO":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE (셸리 보일) 의 성명서</h1><h2 dir=\"auto\" style=\"text-align: center\">시의회 의원 후보</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 시 총지방선거</h3><p dir=\"auto\">연령: 55</p><p dir=\"auto\">직업: 비영리 단체 임원 이사</p><p dir=\"auto\">San Marino에서 태어나고 자란 저는 제 삶을 형성해 준 지역사회의 시의회 의원 후보로 출마하게 되어 영광입니다. 이곳에서 성장하며 San Marino를 특별한 곳으로 만드는 가치와 전통, 공동체 의식에 대해 깊은 감사를 갖게 되었습니다.</p><p dir=\"auto\">지난 8년 동안 저는 San Marino 도시 계획 위원회에서 봉사하며 도시의 고유한 특성을 보존하는 동시에 성장을 신중하게 조화시키기 위해 노력해 왔습니다. 저는 역사적인 주택을 보호하고, 도시의 녹지 환경을 보존하며, 책임 있는 경제 개발을 지원하고, 향후 세대를 위한 사려 깊은 의사결정을 보장하는 데 전념하고 있습니다.</p><p dir=\"auto\">우리 지역사회가 변화해 가는 가운데, 우리는 San Marino를 더욱 강화할 수 있는 기회를 받아들이는 동시에 San Marino를 정의하는 삶의 질을 지켜야 합니다. 저는 우리의 역사를 존중하고, 미래를 현명하게 준비하며, 주민들이 기대하는 뛰어난 서비스와 공동체 의식을 유지할 수 있다고 믿습니다. 여러분의 지지와 San Marino 시의회 의원으로 봉사할 기회를 주신다면 진심으로 감사하겠습니다.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","MN":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE (ШЕЛЛИ БОЙЛ)-ИЙН МЭДЭГДЭЛ</h1><h2 dir=\"auto\" style=\"text-align: center\">ХОТЫН ЗӨВЛӨЛИЙН ГИШҮҮНД НЭР ДЭВШИГЧ</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO ХОТЫН ЗАСАГ ЗАХИРГААНЫ ЕРӨНХИЙ СОНГУУЛЬ</h3><p dir=\"auto\">Нас: ‎55</p><p dir=\"auto\">Ажил мэргэжил: Ашгийн бус байгууллагын гүйцэтгэх захирал</p><p dir=\"auto\">San Marino хотод төрж өссөн хүний хувьд миний амьдралыг төлөвшүүлсэн энэ хамтын нийгэмлэгийн Хотын зөвлөлийн гишүүнд нэр дэвшиж байгаадаа нэр төрийн хэрэг гэж үзэж байна. Энд өсөж хүмүүжсэнээр San Marino-г онцгой газар болгодог үнэт зүйлс, уламжлал болон хамтын нийгэмлэгийн мэдрэмжийг гүнээ үнэлдэг болсон.</p><p dir=\"auto\">Сүүлийн найман жилийн турш San Marino-ийн Төлөвлөлтийн комисст ажиллах завшаан тохиож, хотынхоо онцлогийг хадгалахын зэрэгцээ хөгжлийг ухаалгаар тэнцвэржүүлэхийн төлөө ажилласан. Би түүхэн үнэ цэнтэй орон сууцуудыг хамгаалах, хотын модон бүрхэвчийг хадгалах, хариуцлагатай эдийн засгийн хөгжлийг дэмжих, мөн ирээдүйн шийдвэрүүдийг оршин суугчдын тэргүүлэх чиглэлтэй нийцүүлэхийн төлөө тууштай ажиллана.</p><p dir=\"auto\">Манай хамтын нийгэмлэг хөгжихийн хэрээр San Marino-г бэхжүүлэх боломжуудыг ашиглахын зэрэгцээ хотын онцлогийг бүрдүүлдэг чанаруудаа хамгаалах ёстой. Бид түүхээ хүндэтгэн дээдэлж, ирээдүйдээ ухаалаг хөрөнгө оруулалт хийж, оршин суугчдын хүлээдэг өндөр түвшний үйлчилгээ болон хамтын нийгэмлэгийн мэдрэмжийг хадгалж чадна гэж би итгэдэг. Таны дэмжлэг болон San Marino хотод Хотын Зөвлөлийн гишүүний хувиар үйлчлэх боломж олдвол би талархах болно.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","MY":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE (ရှယ်လီ ဘွိုင်းလ်) ၏ ထုတ်ပြန်ချက်</h1><h2 dir=\"auto\" style=\"text-align: center\">မြို့တော်ကောင်စီ၏ အဖွဲ့ဝင်အတွက် ကိုယ်စားလှယ်လောင်း</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO မြို့တော် အထွေထွေ မြူနီစီပယ် ရွေးကောက်ပွဲ</h3><p dir=\"auto\">အသက်- 55 နှစ်</p><p dir=\"auto\">အလုပ်အကိုင်- အကျိုးအမြတ်မယူသောအဖွဲ့အစည်း၏ အမှုဆောင်ဒါရိုက်တာ</p><p dir=\"auto\">San Marino မြို့မှာ မွေးဖွားကြီးပြင်းလာခဲ့ရတဲ့ ကျွန်မဟာ ကျွန်မဘဝကို ပုံဖော်ပေးခဲ့တဲ့ ရပ်ရွာအသိုင်းအဝိုင်းအတွက် မြို့တော်ကောင်စီ ကိုယ်စားလှယ်လောင်းတစ်ဦးအဖြစ် ယှဉ်ပြိုင်ခွင့်ရတဲ့အတွက် ဂုဏ်ယူဝမ်းမြောက်ပါတယ်။ ဒီမှာ ကြီးပြင်းလာခဲ့ရတာက San Marino မြို့ကို ဒီလိုထူးခြားတဲ့နေရာတစ်ခု ဖြစ်စေတဲ့ တန်ဖိုးတွေ၊ ရိုးရာအစဉ်အလာတွေနဲ့ ရပ်ရွာအသိုင်းအဝိုင်းရဲ့ နွေးထွေးတဲ့ စိတ်ဓာတ်တွေကို ကျွန်မ အထူးတလည် တန်ဖိုးထားတတ်လာစေခဲ့ပါတယ်။</p><p dir=\"auto\">လွန်ခဲ့တဲ့ ရှစ်နှစ်တာကာလအတွင်း San Marino စီမံကိန်း ကော်မရှင်မှာ တာဝန်ထမ်းဆောင်ခွင့် ရရှိခဲ့တာဟာ ကျွန်မအတွက် အခွင့်ထူးတစ်ခု ဖြစ်ပြီး၊ မြို့ရဲ့ သွင်ပြင်လက္ခဏာကို မပျက်မယွင်း ထိန်းသိမ်းရင်းနဲ့ တိုးတက်ပြောင်းလဲမှုတွေကိုပါ မျှတစွာ ဟန်ချက်ညီညီ လုပ်ဆောင်နိုင်ဖို့ အစွမ်းကုန် ကြိုးပမ်းခဲ့ပါတယ်။ ကျွန်မတို့ရဲ့ သမိုင်းဝင် အိမ်ရာတွေကို ကာကွယ်စောင့်ရှောက်ဖို့၊ မြို့ပြ သစ်တောတွေကို ထိန်းသိမ်းဖို့၊ တာဝန်ယူမှုရှိရှိ စီးပွားရေး ဖွံ့ဖြိုးတိုးတက်မှုကို အားပေးကူညီဖို့နဲ့ နောင်လာမယ့် ဆုံးဖြတ်ချက်တွေ အားလုံးက ကျွန်မတို့ မြို့သူမြို့သားတွေရဲ့ ဦးစားပေး ရည်မှန်းချက်တွေကို ထင်ဟပ်စေဖို့ ကျွန်မ ကတိကဝတ်ပြုထားပါတယ်။</p><p dir=\"auto\">ကျွန်မတို့ရဲ့ ရပ်ရွာအသိုင်းအဝိုင်း တိုးတက်ပြောင်းလဲလာတာနဲ့အမျှ San Marino မြို့ကို ပိုမိုခိုင်မာအားကောင်းစေမယ့် အခွင့်အလမ်းတွေကို လက်ခံရယူကြရမယ့်အပြင်၊ မြို့ရဲ့ မူလဝိသေသလက္ခဏာတွေကိုလည်း ဆက်လက် ထိန်းသိမ်းစောင့်ရှောက်သွားရမှာ ဖြစ်ပါတယ်။ ကျွန်မတို့ရဲ့ သမိုင်းကြောင်းကို လေးစားတန်ဖိုးထားနိုင်သလို၊ အနာဂတ်အတွက်လည်း အမျှော်အမြင်ရှိရှိ ရင်းနှီးမြှုပ်နှံနိုင်ပြီး၊ မြို့သူမြို့သားတွေ မျှော်လင့်ထားကြတဲ့ ထူးချွန်တဲ့ ဝန်ဆောင်မှုတွေနဲ့ ရပ်ရွာအသိုင်းအဝိုင်းရဲ့ နွေးထွေးတဲ့ စိတ်ဓာတ်တွေကိုလည်း ဆက်လက် ထိန်းသိမ်းသွားနိုင်မယ်လို့ ကျွန်မ ခိုင်ခိုင်မာမာ ယုံကြည်ပါတယ်။ San Marino မြို့တော်ကောင်စီ၏ အဖွဲ့ဝင်တစ်ဦးအဖြစ် တာဝန်ထမ်းဆောင်ခွင့်နဲ့ လူကြီးမင်းတို့ရဲ့ ထောက်ခံမှုတွေအတွက် ကျွန်မ အထူးပဲ ကျေးဇူးတင်ရှိမှာပါ။</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","RU":"<h1 dir=\"auto\" style=\"text-align: center\">ЗАЯВЛЕНИЕ SHELLEY BOYLE (ШЕЛЛИ БОЙЛ)</h1><h2 dir=\"auto\" style=\"text-align: center\">КАНДИДАТ В ЧЛЕНЫ ГОРОДСКОГО СОВЕТА</h2><h3 dir=\"auto\" style=\"text-align: center\">ОБЩИЕ МУНИЦИПАЛЬНЫЕ ВЫБОРЫ ГОРОДА SAN MARINO</h3><p dir=\"auto\">Возраст: 55</p><p dir=\"auto\">Род занятий: Исполнительный директор некоммерческой организации</p><p dir=\"auto\">Я родилась и выросла в San Marino, и для меня огромная честь стать кандидатом в городской совет сообщества, которое определило мою жизнь. То, что я выросла здесь, научило меня глубоко ценить те ценности, традиции и чувство принадлежности к сообществу, которые делают San Marino столь особенным местом.</p><p dir=\"auto\">Последние восемь лет я посвятила работе в Комиссии по планированию San Marino, стремясь найти разумный баланс между ростом и сохранением облика нашего города. Я стремлюсь защищать наши исторические дома, сохранять наши городские леса, поддерживать ответственное экономическое развитие и гарантировать, чтобы будущие решения отражали приоритеты наших жителей.</p><p dir=\"auto\">По мере развития нашего сообщества мы должны использовать возможности, которые укрепляют San Marino, сохраняя при этом качества, определяющие его уникальность. Я верю, что мы можем чтить нашу историю, разумно инвестировать в наше будущее и поддерживать исключительный уровень услуг и чувство принадлежности к сообществу, которых ожидают жители. Я буду благодарна за поддержку и возможность служить San Marino в качестве члена городского совета.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","TE":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE (షెల్లీ బోయల్) స్టేట్​మెంట్</h1><h2 dir=\"auto\" style=\"text-align: center\">నగర పాలక మండలి సభ్యుని కొరకు అభ్యర్థి</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO నగర సాధారణ మునిసిపల్ ఎలక్షన్</h3><p dir=\"auto\">వయస్సు: 55</p><p dir=\"auto\">వృత్తి: నాన్​ప్రాఫిట్ ఎగ్జిక్యూటివ్ డైరెక్టర్</p><p dir=\"auto\">San Marinoలో పుట్టి పెరిగిన నేను, నా జీవితాన్ని తీర్చిదిద్దిన ఈ కమ్యూనిటీలో నగర పాలక మండలి సభ్యుని కొరకు అభ్యర్థిగా ఉండటం నాకు ఎంతో గౌరవంగా ఉంది. ఇక్కడ పెరగడం వల్ల San Marinoను ఇంత ప్రత్యేకమైన ప్రదేశంగా నిలబెట్టే విలువలు, సంప్రదాయాలు మరియు కమ్యూనిటీ భావన పట్ల నాకు లోతైన అభిమానం ఏర్పడింది.</p><p dir=\"auto\">గత ఎనిమిది సంవత్సరాలుగా, San Marino ప్లానింగ్ కమిషన్‌లో సేవలందించే అవకాశం నాకు లభించింది. మన నగర ప్రత్యేకతను కాపాడుతూనే అభివృద్ధిని సముచితంగా సమతుల్యం చేసేందుకు నేను కృషి చేశాను. మన చారిత్రక గృహాలను రక్షించడం, మన పట్టణ వనాలను పరిరక్షించడం, బాధ్యతాయుతమైన ఆర్థిక అభివృద్ధికి మద్దతు ఇవ్వడం మరియు భవిష్యత్తు నిర్ణయాలు మనం నివాసితుల ప్రాధాన్యతలను ప్రతిబింబించేలా చూడడం కోసం నేను కట్టుబడి ఉన్నాను.</p><p dir=\"auto\">మన కమ్యూనిటీ అభివృద్ధి చెందుతున్న కొద్దీ, San Marinoను బలోపేతం చేసే అవకాశాలను మనం స్వీకరించాలి, అదే సమయంలో దానిని ప్రత్యేకంగా నిలబెట్టే లక్షణాలను కాపాడాలి. మన చరిత్రను గౌరవిస్తూ, మనం భవిష్యత్తులో వివేకవంతంగా పెట్టుబడి పెట్టడంతో పాటు, నివాసితులు ఆశించే అత్యుత్తమ సేవలను మరియు కమ్యూనిటీ భావనను కొనసాగించగలమని నేను నమ్ముతున్నాను. మీ మద్దతు మరియు నగర పాలక మండలి సభ్యురాలిగా San Marinoకు సేవ చేసే అవకాశాన్ని అందించినందుకు నేను కృతజ్ఞురాలిగా ఉంటాను.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","TH":"<h1 dir=\"auto\" style=\"text-align: center\">แถลงการณ์ของ SHELLEY BOYLE (เชลลีย์ บอยล์)</h1><h2 dir=\"auto\" style=\"text-align: center\">ผู้สมัครรับเลือกตั้งสำหรับตำแหน่ง<br dir=\"auto\">สมาชิกสภาเทศบาลเมือง</h2><h3 dir=\"auto\" style=\"text-align: center\">การเลือกตั้งทั่วไปเทศบาลเมือง SAN MARINO</h3><p dir=\"auto\">อายุ: 55</p><p dir=\"auto\">อาชีพ: ผู้อำนวยการบริหารองค์กรที่ไม่แสวงหาผลกำไร</p><p dir=\"auto\">ดิฉันเกิดและเติบโตในเมือง San Marino และรู้สึกเป็นเกียรติอย่างยิ่งที่ได้เป็นผู้สมัครรับเลือกตั้งเป็นสมาชิกสภาเทศบาลเมืองในชุมชนที่หล่อหลอมชีวิตของดิฉัน การเติบโตขึ้นมาที่นี่ทำให้ดิฉันซาบซึ้งต่อคุณค่า ประเพณี และความรู้สึกของการเป็นส่วนหนึ่งของชุมชน ซึ่งทำให้ San Marino เป็นสถานที่พิเศษเช่นนี้</p><p dir=\"auto\">ตลอดแปดปีที่ผ่านมา ดิฉันได้รับเกียรติให้ดำรงตำแหน่งในคณะกรรมาธิการผังเมือง San Marino โดยทำงานเพื่อสร้างความสมดุลระหว่างการเติบโตและการอนุรักษ์เอกลักษณ์ของเมืองของเราอย่างรอบคอบ ดิฉันมุ่งมั่นที่จะปกป้องบ้านหลายหลังที่มีคุณค่าทางประวัติศาสตร์ อนุรักษ์ป่าในเมือง สนับสนุนการพัฒนาเศรษฐกิจอย่างมีความรับผิดชอบ และทำให้แน่ใจว่าการตัดสินใจในอนาคตจะสะท้อนถึงลำดับความสำคัญของชาวบ้านของเรา</p><p dir=\"auto\">เมื่อชุมชนของเราพัฒนาไป เราต้องคว้าโอกาสที่จะเสริมสร้างความแข็งแกร่งให้กับ San Marino พร้อมทั้งรักษาคุณค่าที่เป็นเอกลักษณ์ของเมืองเอาไว้ด้วย ดิฉันเชื่อว่าเราสามารถสืบสานประวัติศาสตร์ของเรา ลงทุนอย่างชาญฉลาดในอนาคต และรักษามาตรฐานการบริการที่เป็นเลิศ และรักษาความรู้สึกของการเป็นส่วนหนึ่งของชุมชนที่ชาวบ้านคาดหวังไว้ได้ ดิฉันจะรู้สึกขอบคุณเป็นอย่างยิ่งหากท่านให้การสนับสนุนและมอบโอกาสให้ดิฉันได้ทำหน้าที่เป็นสมาชิกสภาเทศบาลเมือง San Marino</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","TL":"<h1 dir=\"auto\" style=\"text-align: center\">PAHAYAG NI SHELLEY BOYLE</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDATO PARA MIYEMBRO NG KONSEHO NG LUNGSOD</h2><h3 dir=\"auto\" style=\"text-align: center\">PANGKALAHATANG HALALANG MUNISIPAL NG LUNGSOD NG SAN MARINO</h3><p dir=\"auto\">Edad: 55</p><p dir=\"auto\">Trabaho: Tagapagpaganap na Direktor ng Di-Nagtutubo</p><p dir=\"auto\">Ipinanganak at lumaki sa San Marino, isang karangalan para sa akin ang maging kandidato para sa Konseho ng Lungsod sa komunidad na humubog sa aking buhay. Ang paglaki rito ay nagbigay sa akin ng malalim na pagpapahalaga sa mga aral, tradisyon, at diwa ng komunidad na siyang dahilan kung bakit isang espesyal na lugar ang San Marino.</p><p dir=\"auto\">Sa nakalipas na walong taon, nagkaroon ako ng pribilehiyong maglingkod sa Komisyoner sa Pagpaplano ng San Marino, na nagsusumikap na maingat na balansehin ang paglago at ang pangangalaga sa katangian ng ating lungsod. Nakatuon ako sa pagprotekta sa ating mga makasaysayang tahanan, pangangalaga sa ating kagubatan sa lungsod, pagsuporta sa responsableng pag-unlad ng ekonomiya, at pagtiyak na ang mga desisyon sa hinaharap ay sumasalamin sa mga prayoridad ng ating mga residente.</p><p dir=\"auto\">Habang umuunlad ang ating komunidad, dapat nating yakapin ang mga oportunidad na magpapalakas sa San Marino habang pinangangalagaan ang mga katangiang nagbibigay-kahulugan dito. Naniniwala ako na kaya nating igalang ang ating kasaysayan, mamuhunan nang matalino para sa ating kinabukasan, at mapanatili ang mga natatanging serbisyo at diwa ng pagkakaisa na inaasahan ng mga residente. Lubos akong magpapasalamat sa inyong suporta at sa pagkakataong maglingkod sa San Marino bilang miyembro ng Konseho ng Lungsod.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","VI":"<h1 dir=\"auto\" style=\"text-align: center\">BÀI PHÁT BIỂU CỦA SHELLEY BOYLE</h1><h2 dir=\"auto\" style=\"text-align: center\">ỨNG CỬ VIÊN CHO CHỨC VỤ ỦY VIÊN HỘI ĐỒNG THÀNH PHỐ</h2><h3 dir=\"auto\" style=\"text-align: center\">TỔNG TUYỂN CỬ ĐỊA PHƯƠNG CỦA THÀNH PHỐ SAN MARINO</h3><p dir=\"auto\">Tuổi: ‎55</p><p dir=\"auto\">Nghề Nghiệp: Giám Đốc Điều Hành Tổ Chức Bất Vụ Lợi</p><p dir=\"auto\">Sinh ra và lớn lên tại San Marino, tôi rất vinh dự được trở thành ứng cử viên cho Hội Đồng Thành Phố tại cộng đồng đã góp phần hình thành cuộc đời tôi. Lớn lên tại đây đã giúp tôi thêm trân trọng những giá trị, truyền thống, và tinh thần cộng đồng làm nên một San Marino đặc biệt như ngày nay.</p><p dir=\"auto\">Trong tám năm qua, tôi đã có vinh dự phục vụ tại Ủy Ban Kế Hoạch San Marino, nỗ lực cân bằng một cách thận trọng giữa phát triển và việc bảo tồn nét đặc trưng của thành phố. Tôi cam kết bảo vệ những ngôi nhà có giá trị lịch sử, gìn giữ hệ thống cây xanh đô thị, hỗ trợ phát triển kinh tế có trách nhiệm và đảm bảo các quyết định trong tương lai phản ánh những ưu tiên của cư dân.</p><p dir=\"auto\">Khi cộng đồng của chúng ta phát triển, chúng ta phải nắm bắt những cơ hội giúp San Marino vững mạnh hơn, đồng thời bảo vệ những đặc điểm làm nên bản sắc của thành phố. Tôi tin rằng chúng ta có thể trân trọng lịch sử, đầu tư khôn ngoan cho tương lai, và duy trì các dịch vụ xuất sắc cũng như tinh thần cộng đồng mà cư dân mong đợi. Tôi sẽ rất biết ơn nếu nhận được sự ủng hộ của quý vị và có cơ hội phục vụ San Marino với tư cách là ủy viên Hội Đồng Thành Phố.</p><p dir=\"auto\"></p><p dir=\"auto\"></p>","ZH":"<h1 dir=\"auto\" style=\"text-align: center\">SHELLEY BOYLE（雪莉·博伊爾）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">市議會議員候選人</h2><h3 dir=\"auto\" style=\"text-align: center\">SAN MARINO 市市政大選</h3><p dir=\"auto\">年齡：55</p><p dir=\"auto\">職業：非營利組織執行董事</p><p dir=\"auto\">我在 San Marino 土生土長，能夠作為候選人，參選這座形塑我人生的社區之市議會，我深感榮幸。在這裡成長，讓我深深體會造就 San Marino 如此獨特的價值觀、傳統與社區共識。</p><p dir=\"auto\">過去八年，我有幸任職 San Marino Planning Commission，致力於審慎平衡城市發展與維護本市既有風貌。我致力保護歷史住宅、守護城市林木、支持負責任的經濟發展，並確保未來各項決策能夠反映居民的優先訴求。</p><p dir=\"auto\">隨著社區不斷發展，我們必須把握機會壯大 San Marino，同時守護這座城市的獨特本質。我相信我們可以尊重歷史、審慎投資未來，維持居民所期待的高品質市政服務與社區凝聚力。若能獲得您的支持，有機會以市議會成員的身分為 San Marino 服務，我將滿心感激。</p><p dir=\"auto\"></p><p dir=\"auto\"></p>"},"CandidateID":"RF","SequenceOrder":211}],"order":3,"isWriteIn":false,"isPresidential":false},{"id":"3M7","name":[{"BN":"রাইট-ইন(তালিকা বহির্ভূত)প্রার্থী","CC":"自填候選人","EN":"Write-In Candidate","ES":"Candidato por Escrito","FA":"کاندیدا خارج از لیست","GU":"અંદર લખવાના ઉમેદવાર","HI":"राइट–इन उम्मीदवार","HY":"Գրավոր առաջադրված թեկնածու","ID":"Calon Tidak Terdaftar dalam Surat Suara","JA":"記入候補者","KM":"បេក្ខជនសរសេរបញ្ចូលឈ្មោះ","KO":"기명 후보자","MN":"Бичигдэх нэр дэвшигч","MY":"ထပ်ဖြည့်သော ကိုယ်စားလှယ်လောင်း","RU":"Вписанный кандидат","TE":"రైట్-ఇన్ అభ్యర్ధి","TH":"ผู้สมัครรับเลือกตั้งแบบเขียนชื่อ","TL":"Isinusulat-lamang na Kandidato","VI":"Ứng Cử Viên Viết Tên Vào","ZH":"自填候選人"}],"short_name":[{"EN":"Write-In Candidate"}],"occupation":[null],"statements":[],"order":7,"isWriteIn":true,"isPresidential":false},{"id":"3M8","name":[{"BN":"রাইট-ইন(তালিকা বহির্ভূত)প্রার্থী","CC":"自填候選人","EN":"Write-In Candidate","ES":"Candidato por Escrito","FA":"کاندیدا خارج از لیست","GU":"અંદર લખવાના ઉમેદવાર","HI":"राइट–इन उम्मीदवार","HY":"Գրավոր առաջադրված թեկնածու","ID":"Calon Tidak Terdaftar dalam Surat Suara","JA":"記入候補者","KM":"បេក្ខជនសរសេរបញ្ចូលឈ្មោះ","KO":"기명 후보자","MN":"Бичигдэх нэр дэвшигч","MY":"ထပ်ဖြည့်သော ကိုယ်စားလှယ်လောင်း","RU":"Вписанный кандидат","TE":"రైట్-ఇన్ అభ్యర్ధి","TH":"ผู้สมัครรับเลือกตั้งแบบเขียนชื่อ","TL":"Isinusulat-lamang na Kandidato","VI":"Ứng Cử Viên Viết Tên Vào","ZH":"自填候選人"}],"short_name":[{"EN":"Write-In Candidate"}],"occupation":[null],"statements":[],"order":8,"isWriteIn":true,"isPresidential":false},{"id":"3M9","name":[{"BN":"রাইট-ইন(তালিকা বহির্ভূত)প্রার্থী","CC":"自填候選人","EN":"Write-In Candidate","ES":"Candidato por Escrito","FA":"کاندیدا خارج از لیست","GU":"અંદર લખવાના ઉમેદવાર","HI":"राइट–इन उम्मीदवार","HY":"Գրավոր առաջադրված թեկնածու","ID":"Calon Tidak Terdaftar dalam Surat Suara","JA":"記入候補者","KM":"បេក្ខជនសរសេរបញ្ចូលឈ្មោះ","KO":"기명 후보자","MN":"Бичигдэх нэр дэвшигч","MY":"ထပ်ဖြည့်သော ကိုယ်စားလှယ်လောင်း","RU":"Вписанный кандидат","TE":"రైట్-ఇన్ అభ్యర్ధి","TH":"ผู้สมัครรับเลือกตั้งแบบเขียนชื่อ","TL":"Isinusulat-lamang na Kandidato","VI":"Ứng Cử Viên Viết Tên Vào","ZH":"自填候選人"}],"short_name":[{"EN":"Write-In Candidate"}],