","TL":"Retiradong Inhinyero sa Panghimpapawid","VI":"Kỹ Sư Ngành Không Gian Hồi Hưu","ZH":"退休航太工程師"}],"statements":[],"order":0,"isWriteIn":false,"isPresidential":false},{"id":"WR","name":[{"BN":"ডেনিস এম. কনর","CC":"丹尼斯·M.·康納","EN":"DENNIS M. CONNOR","FA":"دنیس ام. کانر","GU":"ડેનિસ એમ. કોન્નર","HI":"डेनिस एम. कॉनर","HY":"ԴԵՆՆԻՍ Մ. ՔՈՆՈՐ","JA":"デニス・M.・コナー","KM":"ដេនីស អេម. ខូណ័រ","KO":"데니스 M. 코너","MN":"ДЕННИС М. КОННОР","MY":"ဒန်းနစ် အမ် ကော်နာ","RU":"ДЕННИС М. КОННОР","TE":"డెన్నిస్ ఎమ్. కాన్నర్","TH":"เดนนิส เอ็ม. คอนเนอร์","ZH":"丹尼斯·M.·康納"}],"short_name":[{"EN":"DENNIS M CONNOR"}],"occupation":[{"BN":"অবসরপ্রাপ্ত প্রযুক্তিগত লেখক","CC":"退休技術作家","EN":"Retired Technical Writer","ES":"Redactor Técnico Jubilado","FA":"نویسنده فنی بازنشسته","GU":"નિવૃત્ત ટેકનીકલ લેખક","HI":"सेवानिवृत्त तकनीकी लेखक","HY":"Թոշակառու տեխնիկական գրող","ID":"Pensiunan Penulis Teknis","JA":"元技術文書作成者","KM":"អ្នកសរសេរបច្ចេកទេសដែលចូលនិវត្តន៍","KO":"은퇴한 기술 저자","MN":"Тэтгэвэрт гарсан техникийн бичээч","MY":"အငြိမ်းစား နည်းပညာဆိုင်ရာ စာရေးဆရာ","RU":"Технический писатель на пенсии","TE":"రిటైర్డ్ టెక్నికల్ రైటర్","TH":"นักเขียนเชิงเทคนิคเกษียณอายุแล้ว","TL":"Retiradong Teknikal na Manunulat","VI":"Nhà Viết Sách Kỹ Thuật Hồi Hưu","ZH":"退休技術作家"}],"statements":[],"order":1,"isWriteIn":false,"isPresidential":false},{"id":"WS","name":[{"BN":"এভরেন ওজবে","CC":"埃弗倫·奧茲貝","EN":"EVREN OZBEY","FA":"اورن اوزبی","GU":"એવરેન ઓઝબે","HI":"एवरेन ओज़बे","HY":"ԷՎՐԵՆ ՕԶԲԵՅ","JA":"エヴレン・オズベイ","KM":"អីរ៉េន អូសប៊ី","KO":"에브렌 오즈베이","MN":"ЭВРЕН ОЗБЕЙ","MY":"အီဗရန် အိုဇ်ဘေး","RU":"ЭВРЕН ОЗБЕЙ","TE":"ఎవ్రెన్ ఒజ్బే","TH":"เอฟเรน ออซเบย์","ZH":"埃弗倫·奧茲貝"}],"short_name":[{"EN":"EVREN OZBEY"}],"occupation":[{}],"statements":[],"order":2,"isWriteIn":false,"isPresidential":false},{"id":"WT","name":[{"BN":"পল জেরার্ড","CC":"保羅·傑拉德","EN":"PAUL GERARD","FA":"پاول جرارد","GU":"પૌલ જેરાર્ડ","HI":"पॉल जेरार्ड","HY":"ՓՈԼ ՋԵՐԱՐԴ","JA":"ポール・ジェラード","KM":"ប៉ូល ជើរ៉ាដ","KO":"폴 제라드","MN":"ПАУЛ ЖЕРАРД","MY":"ပေါလ် ဂျရာ့ဒ်","RU":"ПОЛ ДЖЕРАРД","TE":"పాల్ జెరార్డ్","TH":"พอล เจอราร์ด","ZH":"保羅·傑拉德"}],"short_name":[{"EN":"PAUL GERARD"}],"occupation":[{"BN":"কলেজের অধ্যাপক/অভিভাবক","CC":"大學教授/家長","EN":"College Professor/Parent","ES":"Profesor de Colegio/Padre","FA":"استاد کالج/پدر","GU":"મહાવિદ્યાલય પ્રાધ્યાપક/માતાપિતા","HI":"कॉलेज प्रोफेसर/अभिभावक","HY":"Քոլեջի պրոֆեսոր/Ծնող","ID":"Profesor Perguruan Tinggi/Orang Tua","JA":"大学教授／保護者","KM":"សាស្ត្រាចារ្យមហាវិទ្យាល័យ/ឪពុកឬម្ដាយ","KO":"칼리지 교수/부모","MN":"Коллежийн профессор/Эцэг эх","MY":"ကောလိပ်ပါမောက္ခ/မိဘ","RU":"Профессор колледжа/родитель","TE":"కాలేజీ ప్రొఫెసర్/పేరెంట్","TH":"อาจารย์วิทยาลัย/ผู้ปกครอง","TL":"Propesor ng Kolehiyo/Magulang","VI":"Giáo Sư Đại Học/Phụ Huynh","ZH":"大學教授/家長"}],"statements":[{"ID":"C0002619505E","FullHTML":{"BN":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD (পল জেরার্ড)-এর বিবৃতি</h1><h2 dir=\"auto\" style=\"text-align: center\">পরিচালনা পর্ষদের সদস্য প্রার্থী,<br dir=\"auto\">ট্রাস্টি এলাকা নং 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK ইউনিফায়েড স্কুল ডিস্ট্রিক্ট</h3><p dir=\"auto\">বয়স: 59</p><p dir=\"auto\">পেশা: কলেজের অধ্যাপক/অভিভাবক</p><p dir=\"auto\">Burbank শিক্ষা বোর্ডের একজন ট্রাস্টি হিসেবে, আমি এমন কৌশলগত পরিকল্পনা নিশ্চিত করতে কাজ করব যা শিক্ষার্থীদের কৃতিত্বকে সমর্থন করে এবং একই সাথে Burbank-এর তরুণদের শিক্ষাকে ডিস্ট্রিক্টের সর্বোচ্চ অগ্রাধিকার হিসেবে রাখবে।</p><p dir=\"auto\" style=\"text-align: justify\">আমি শিক্ষার্থী, অভিভাবক, সকল কর্মী, এবং সমাজের অংশীজনদের পক্ষে একজন সমর্থক হিসেবে কাজ করব। আমি শুনব, সহযোগিতামূলকভাবে কাজ করব, এবং অভিভাবক গোষ্ঠী, স্থানীয় ব্যবসা প্রতিষ্ঠান ও Burbank সিটি কর্তৃপক্ষের সাথে আরও অংশীদারিত্ব গড়ে তুলতে উৎসাহিত করব।</p><p dir=\"auto\">শিক্ষার্থী সংখ্যা হ্রাসের প্রতিবন্ধকতা মোকাবেলার জন্য আমি ডিস্ট্রিক্ট নেতৃত্ব দল এবং সমগ্র কমিউনিটির সাথে কাজ করব এবং একই সাথে আমাদের শিক্ষা কার্যক্রম, স্কুল পরিকাঠামো ও কর্মীদের বেতন সর্বোচ্চ সম্ভাব্য পর্যায়ে বজায় রাখব।</p><p dir=\"auto\">ট্রাস্টি হিসেবে আমি বুঝি যে, নৈতিকভাবে আচরণ করার একটি আইনগত দায়িত্ব আমার রয়েছে। আমি সমগ্র কমিউনিটির কাছে সৎ এবং আইন যতটুকু অনুমতি দেয় ততটুকু স্বচ্ছ থাকার প্রতিশ্রুতি দিচ্ছি।</p><p dir=\"auto\">আমি নিশ্চিত করব যে সমস্ত ব্যয় এমন লক্ষ্যের সাথে সামঞ্জস্যপূর্ণ যা শিক্ষার্থীদের কৃতিত্বকে সমর্থন করে এবং ব্যয় করা প্রতিটি ডলারের সঠিক নিরীক্ষার মাধ্যমে ডিস্ট্রিক্টের আর্থিক বিষয়ে সততা ও স্বচ্ছতা বজায় রাখার জন্য সর্বাত্মক প্রচেষ্টা করা হয়।</p><p dir=\"auto\">Paul-এর সাথে <u>GerardForBUSD@protonmail.com</u>-এ যোগাযোগ করুন</p><p dir=\"auto\"></p>","CC":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD（保羅·傑拉德）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理委員會委員候選人，<br dir=\"auto\">第3託管區</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK 聯合學區</h3><p dir=\"auto\">年齡：59</p><p dir=\"auto\">職業：大學教授/家長</p><p dir=\"auto\">身為 Burbank 教育委員會委員，我將致力推動制訂策略計畫，把 Burbank 青少年的教育列為學區最高優先事項，藉此提升學生學習成效。</p><p dir=\"auto\" style=\"text-align: justify\">我將為學生、家長、全體教職員以及社區利害關係人發聲。我將傾聽各方意見、協同合作，並促進與家長團體、在地企業以及 Burbank 市政府建立更多合作關係。</p><p dir=\"auto\">我將與學區領導團隊及全體社區民眾共同面對入學人數下滑的挑戰，同時盡可能維持教育課程、校園設施與教職員薪酬的最高水準。</p><p dir=\"auto\">身為委員，我明白自己負有恪守倫理行事的法律責任。我承諾對全體社區誠實以對，並在法律允許範圍內做到最大限度公開透明。</p><p dir=\"auto\">我將確保所有支出都契合提升學生學習成效的目標，並盡一切努力，透過對每一筆經費進行精確審計，讓學區財務做到誠實與公開透明。</p><p dir=\"auto\">請致函 <u>GerardForBUSD@protonmail.com</u> 聯絡 Paul</p><p dir=\"auto\"></p>","EN":"<h1 dir=\"auto\" style=\"text-align: center\">STATEMENT OF PAUL GERARD</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATE FOR GOVERNING BOARD MEMBER,<br dir=\"auto\">Trustee Area No. 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK UNIFIED SCHOOL DISTRICT</h3><p dir=\"auto\">Age: 59</p><p dir=\"auto\">Occupation: College Professor/Parent</p><p dir=\"auto\">As a trustee of the Burbank Board of Education, I will work to ensure that there are strategic plans that support student achievement by keeping the education of Burbank's youth as the top priority of the district.</p><p dir=\"auto\">I will be an advocate for students, parents, all staff, and community stakeholders. I will listen, work collaboratively, and encourage more partnerships with parent groups, local businesses, and the City of Burbank.</p><p dir=\"auto\">I will work with the district leadership team and the entire community to face the challenges of declining enrollment while keeping our educational programs, school facilities, and staff compensation at the highest levels possible.</p><p dir=\"auto\">As a trustee, I understand that I have a legal responsibility to conduct myself ethically. I promise to be honest with the entire community and as transparent as the law allows.</p><p dir=\"auto\">I will ensure that all expenses are aligned with goals that support student achievement and that every effort is made to have honesty and transparency about the district's finances supported by accurate auditing of every dollar spent.</p><p dir=\"auto\">Contact Paul at <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","ES":"<h1 dir=\"auto\" style=\"text-align: center\">DECLARACIÓN DE PAUL GERARD</h1><h2 dir=\"auto\" style=\"text-align: center\">CANDIDATO PARA MIEMBRO DE LA JUNTA GUBERNATIVA,<br dir=\"auto\">Área Sindical N.° 3</h2><h3 dir=\"auto\" style=\"text-align: center\">DISTRITO ESCOLAR UNIFICADO DE BURBANK</h3><p dir=\"auto\">Edad: 59</p><p dir=\"auto\">Ocupación: Profesor de Colegio/Padre</p><p dir=\"auto\">Como síndico de la Junta de Educación de Burbank, trabajaré para garantizar que existan planes estratégicos que apoyen el rendimiento estudiantil, manteniendo la educación de la juventud de Burbank como la máxima prioridad del distrito.</p><p dir=\"auto\">Seré un defensor de los estudiantes, los padres, todo el personal y los miembros de la comunidad. Escucharé, trabajaré en colaboración y fomentaré una mayor colaboración con grupos de padres, empresas locales y la Ciudad de Burbank.</p><p dir=\"auto\">Trabajaré con el equipo directivo del distrito y con toda la comunidad para afrontar los retos que supone la disminución de la matrícula, manteniendo al mismo tiempo nuestros programas educativos, las instalaciones escolares y la remuneración del personal en los niveles más altos posibles.</p><p dir=\"auto\">Como síndico, entiendo que tengo la responsabilidad legal de comportarme de manera ética. Prometo ser honesto con toda la comunidad y tan transparente como lo permita la ley.</p><p dir=\"auto\">Me aseguraré de que todos los gastos estén alineados con los objetivos que apoyan el rendimiento estudiantil y de que se haga todo lo posible por lograr la honestidad y la transparencia en las finanzas del distrito, respaldadas por una auditoría precisa de cada dólar gastado.</p><p dir=\"auto\">Póngase en contacto con Paul en <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","FA":"<h1 dir=\"rtl\" style=\"text-align: center\">بیانیه PAUL GERARD (پاول جرارد)</h1><h2 dir=\"rtl\" style=\"text-align: center\">کاندیدا برای عضو هیئت حاکمه،<br dir=\"auto\">امین منطقه شماره 3</h2><h3 dir=\"rtl\" style=\"text-align: center\">اتحاد ناحیه مدارس BURBANK</h3><p dir=\"rtl\">سن: 59</p><p dir=\"rtl\">شغل: استاد کالج/پدر</p><p dir=\"rtl\">من به عنوان یکی از امنای هیئت مدیره آموزش و پرورش Burbank، تلاش خواهم کرد تا با قرار دادن آموزش جوانان Burbank به عنوان اولویت اصلی ناحیه، برنامه‌های استراتژیکی را برای حمایت از پیشرفت تحصیلی دانش‌آموزان تدوین کنم.</p><p dir=\"rtl\" style=\"text-align: justify\">من مدافع دانش‌آموزان، والدین، همه کارکنان و ذی‌نفعان جامعه خواهم بود. من گوش خواهم داد، به‌صورت مشارکتی همکاری خواهم کرد و ایجاد همکاری‌های بیشتر با گروه‌های والدین، کسب‌وکارهای محلی و شهرداری Burbank را تشویق خواهم کرد.</p><p dir=\"rtl\">من با تیم رهبری ناحیه و کل جامعه همکاری خواهم کرد تا با چالش‌های ناشی از کاهش ثبت‌نام روبرو شویم و در عین حال برنامه‌های آموزشی، امکانات مدرسه و حقوق و مزایای کارکنان را در بالاترین سطح ممکن حفظ کنیم.</p><p dir=\"rtl\">به عنوان یک امین، می‌دانم که از نظر قانونی موظفم به‌صورت اخلاقی و اصول‌مدارانه رفتار کنم. من قول می‌دهم که با تمام جامعه صادق باشم و تا جایی که قانون اجازه می‌دهد، شفاف باشم.</p><p dir=\"rtl\">من اطمینان حاصل خواهم کرد که تمام هزینه‌ها با اهدافی همسو باشند که از پیشرفت تحصیلی دانش‌آموزان پشتیبانی می‌کنند، و تمام تلاش خود را به کار خواهم گرفت تا در خصوص امور مالی ناحیه، صداقت و شفافیت حاکم باشد و هر دلار هزینه‌شده با حسابرسی دقیق مورد بررسی قرار گیرد.</p><p dir=\"rtl\">با Paul در تماس باشید <u>GerardForBUSD@protonmail.com</u></p><p dir=\"rtl\"></p>","GU":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD (પૌલ જેરાર્ડ) નું નિવેદન</h1><h2 dir=\"auto\" style=\"text-align: center\">સંચાલક મંડળ સભ્ય માટેના ઉમેદવાર,<br dir=\"auto\">ટ્રસ્ટી એરિયા નં. 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK એકીકૃત શાળા જિલ્લો</h3><p dir=\"auto\">ઉંમર: 59</p><p dir=\"auto\">વ્યવસાય: મહાવિદ્યાલય પ્રાધ્યાપક/માતા-પિતા</p><p dir=\"auto\">Burbank શિક્ષણ સમિતિના ટ્રસ્ટી તરીકે, હું એ સુનિશ્ચિત કરવા માટે કામ કરીશ કે વિદ્યાર્થીઓની શૈક્ષણિક સફળતાને સમર્થન આપતી વ્યૂહાત્મક યોજનાઓ બનાવવામાં આવે, અને Burbankના યુવાનોનું શિક્ષણ શાળા જિલ્લાના સૌથી મહત્વપૂર્ણ પ્રાથમિકતા તરીકે જળવાઈ રહે.</p><p dir=\"auto\">હું વિદ્યાર્થીઓ, માતા-પિતા, તમામ કર્મચારીઓ અને સમુદાય સાથે જોડાયેલા તમામ લોકોના હિત માટે અવાજ ઉઠાવીશ. હું સૌની વાત સાંભળીશ, સાથે મળીને કામ કરીશ અને માતા-પિતાના જૂથો, સ્થાનિક વ્યવસાયો અને Burbank શહેર સાથે વધુ ભાગીદારીને પ્રોત્સાહન આપીશ.</p><p dir=\"auto\">હું શાળા જિલ્લાના નેતૃત્વ અને સમગ્ર સમુદાય સાથે મળીને વિદ્યાર્થીઓની ઘટતી સંખ્યા જેવા પડકારોનો સામનો કરીશ, અને સાથે-સાથે શૈક્ષણિક કાર્યક્રમો, શાળાની સુવિધાઓ અને કર્મચારીઓના પગાર-વળતરનું શક્ય તેટલું ઊંચું સ્તર જાળવી રાખવા માટે કામ કરીશ.</p><p dir=\"auto\">ટ્રસ્ટી તરીકે, હું સમજું છું કે નૈતિક રીતે વર્તવું મારી કાનૂની જવાબદારી છે. હું સમગ્ર સમુદાય સાથે ઈમાનદારીથી વર્તવાનું અને કાયદા દ્વારા જેટલી પારદર્શિતા રાખવાની મંજૂરી હોય તેટલી પારદર્શિતા જાળવવાનું વચન આપું છું.</p><p dir=\"auto\">હું એ સુનિશ્ચિત કરીશ કે તમામ ખર્ચ વિદ્યાર્થીઓની શૈક્ષણિક સફળતાને સમર્થન આપતા લક્ષ્યો સાથે સુસંગત હોય અને શાળા જિલ્લાના નાણાંકીય વ્યવહારોમાં ઈમાનદારી અને પારદર્શિતા જળવાઈ રહે તે માટે દરેક પ્રયાસ કરવામાં આવે. તેમજ ખર્ચ કરવામાં આવેલા દરેક ડૉલરનું સચોટ ઓડિટ (હિસાબ-તપાસ) કરવામાં આવે તે સુનિશ્ચિત કરીશ.</p><p dir=\"auto\">Paul નો સંપર્ક કરવા માટે <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","HI":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD (पॉल जेरार्ड) का वक्तव्य</h1><h2 dir=\"auto\" style=\"text-align: center\">गवर्निंग बोर्ड सदस्य के लिए उम्मीदवार,<br dir=\"auto\">ट्रस्टी क्षेत्र सं. 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK एकीकृत स्कूल जिला</h3><p dir=\"auto\">उम्र: 59</p><p dir=\"auto\">व्यवसाय: कॉलेज प्राध्यापक/अभिभावक</p><p dir=\"auto\">Burbank बोर्ड ऑफ एजुकेशन के ट्रस्टी के रूप में, मैं यह सुनिश्चित करने के लिए काम करूँगा कि ऐसी रणनीतिक योजनाएं बनें जो छात्रों की उपलब्धि को बढ़ावा दें और Burbank के युवाओं की शिक्षा को जिले की सर्वोच्च प्राथमिकता बनाए रखें।</p><p dir=\"auto\" style=\"text-align: justify\">मैं छात्रों, अभिभावकों, सभी कर्मचारियों और समुदाय के हितधारकों का पक्ष समथर्क बनूँगा। मैं सबकी बात सुनूँगा, सहयोग से काम करूँगा और अभिभावक समूहों, स्थानीय व्यवसायों और Burbank शहर के साथ अधिक साझेदारी को प्रोत्साहित करूँगा।</p><p dir=\"auto\">मैं छात्रों के घटते नामांकन की चुनौतियों का सामना करने के लिए जिला नेतृत्व और पूरे समुदाय के साथ मिलकर काम करूँगा, साथ ही यह सुनिश्चित करने का प्रयास करूँगा ताकि हमारे बेजोड़ शैक्षणिक स्तर, स्कूल के बुनियादी ढाँचे और कर्मचारियों के मानदेय में कोई कमी न आने पाए।</p><p dir=\"auto\">एक ट्रस्टी के तौर पर, मैं समझता हूँ कि नैतिक रूप से आचरण करना मेरी कानूनी जिम्मेदारी है। मैं पूरे समुदाय के प्रति ईमानदार रहने और कानून द्वारा अनुमत सीमा तक पारदर्शिता बनाए रखने का वादा करता हूँ।</p><p dir=\"auto\">मैं यह सुनिश्चित करूँगा कि सभी खर्च ऐसे लक्ष्यों के अनुरूप हों जो छात्रों की उपलब्धि को बढ़ावा देते हैं, और हर खर्च किए गए डॉलर का सटीक ऑडिट कराकर जिले के वित्तीय मामलों में पूरी ईमानदारी और पारदर्शिता बनाए रखने का हर संभव प्रयास किया जाए।</p><p dir=\"auto\">Paul से संपर्क करें <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","HY":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD-Ի (ՓՈԼ ՋԵՐԱՐԴ) ՀԱՅՏԱՐԱՐՈՒԹՅՈՒՆԸ</h1><h2 dir=\"auto\" style=\"text-align: center\">ԿԱՌԱՎԱՐՄԱՆ ԽՈՐՀՐԴԻ ԱՆԴԱՄԻ ԹԵԿՆԱԾՈՒ,<br dir=\"auto\">Հոգաբարձու գոտի համար 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK ՄԻԱՑՅԱԼ ԴՊՐՈՑԱԿԱՆ ՇՐՋԱՆ</h3><p dir=\"auto\">Տարիքը՝ 59</p><p dir=\"auto\">Գործունեությունը՝ Քոլեջի պրոֆեսոր/Ծնող</p><p dir=\"auto\">Որպես Burbank-ի կրթության խորհրդի հոգաբարձու՝ ես կաշխատեմ ապահովել, որ լինեն ռազմավարական ծրագրեր, որոնք կաջակցեն աշակերտների առաջադիմությանը՝ Burbank-ի երիտասարդության կրթությունը շրջանի գերակա խնդիր համարելով։</p><p dir=\"auto\" style=\"text-align: justify\">Ես կլինեմ ուսանողների, ծնողների, բոլոր աշխատակիցների և համայնքային շահագրգիռ կողմերի պաշտպանը։ Ես կլսեմ, փոխհամագործակցությամբ կաշխատեմ և կխրախուսեմ ծնողական խմբերի, տեղական բիզնեսների և Burbank քաղաքի հետ ավելի շատ գործընկերությունների հաստատումը։</p><p dir=\"auto\">Ես կաշխատեմ շրջանի ղեկավարության թիմի և ամբողջ համայնքի հետ՝ դիմագրավելու աշակերտների թվի նվազման հետ կապված մարտահրավերներին՝ միաժամանակ պահպանելով մեր կրթական ծրագրերը, դպրոցական կառույցները և անձնակազմի վարձատրությունը հնարավորինս բարձր մակարդակի վրա։</p><p dir=\"auto\">Որպես հոգաբարձու, ես հասկանում եմ, որ ունեմ իրավական պատասխանատվություն՝ էթիկական վարքագիծ դրսևորելու համար։ Ես խոստանում եմ լինել ազնիվ ամբողջ համայնքի հետ և այնքան թափանցիկ, որքան թույլատրում է օրենքը։</p><p dir=\"auto\">Ես կապահովեմ, որ բոլոր ծախսերը համապատասխանեն աշակերտների առաջադիմությանը նպաստող նպատակներին, և որ ամեն ինչ արվի շրջանի ֆինանսների վերաբերյալ ազնվության և թափանցիկության ապահովման համար, որը կհիմնվի յուրաքանչյուր ծախսված դոլարի ճշգրիտ աուդիտի վրա։</p><p dir=\"auto\">Կապ հաստատեք Paul-ի հետ՝ <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","ID":"<h1 dir=\"auto\" style=\"text-align: center\">PERNYATAAN PAUL GERARD</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDAT UNTUK ANGGOTA DEWAN PENGURUS,<br dir=\"auto\">Daerah Pengawas No. 3</h2><h3 dir=\"auto\" style=\"text-align: center\">DISTRIK SEKOLAH TERPADU BURBANK</h3><p dir=\"auto\">Usia: 59</p><p dir=\"auto\">Pekerjaan: Profesor Perguruan Tinggi/Orang Tua</p><p dir=\"auto\">Saya sebagai pengawas Dewan Pendidikan Burbank, akan bekerja untuk memastikan adanya rencana strategis yang mendukung prestasi siswa dengan menjadikan pendidikan generasi muda Burbank sebagai prioritas utama distrik.</p><p dir=\"auto\" style=\"text-align: justify\">Saya akan menjadi pembela bagi para siswa, orang tua, seluruh staf, dan para pemangku kepentingan masyarakat. Saya akan mendengarkan, bekerja sama, dan mendorong lebih banyak kemitraan dengan kelompok orang tua, pebisnis lokal, dan Kota Burbank.</p><p dir=\"auto\">Saya akan bekerja sama dengan tim kepemimpinan distrik dan seluruh masyarakat untuk menghadapi tantangan penurunan jumlah siswa sekaligus tetap menjaga program pendidikan, fasilitas sekolah, dan kompensasi staf semaksimal mungkin.</p><p dir=\"auto\">Sebagai seorang pengawas, saya sangat memahami bahwa saya memiliki tanggung jawab hukum untuk berperilaku secara etis. Saya berjanji untuk jujur kepada seluruh masyarakat dan setransparan mungkin sesuai dengan hukum yang berlaku.</p><p dir=\"auto\">Saya akan memastikan bahwa semua pengeluaran selaras dengan tujuan yang mendukung prestasi siswa dan bahwa setiap upaya dilakukan untuk mewujudkan kejujuran dan transparansi terkait keuangan distrik yang didukung oleh audit yang akurat atas setiap dollar yang dibelanjakan.</p><p dir=\"auto\">Hubungi Paul di <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","JA":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD（ポール・ジェラード）の声明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理役員会役員の候補者、<br dir=\"auto\">管財区番号３</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK 統一学区</h3><p dir=\"auto\">年齢：59歳</p><p dir=\"auto\">職業：大学教授／保護者</p><p dir=\"auto\">Burbank 教育委員会の理事として、Burbank の若者の教育を学区の最優先事項とすることで、生徒の学業成績向上を支援する戦略計画が策定されるよう尽力します。</p><p dir=\"auto\" style=\"text-align: justify\">私は生徒、保護者、全職員、そして地域社会の関係者の擁護者となります。私は耳を傾け、協力して取り組み、保護者団体、地元企業、そしてBurbank 市との連携をさらに促進していきます。</p><p dir=\"auto\">私は学区の指導チームおよび地域社会全体と協力し、生徒数の減少という課題に立ち向かいながら、教育プログラム、学校施設、職員の報酬を可能な限り高い水準に維持していきます。</p><p dir=\"auto\">理事として、私は倫理的に行動する法的責任があることを理解しています。私は地域社会全体に対して誠実であり、法律が許す限り透明性を保つことを約束します。</p><p dir=\"auto\">私は、すべての支出が生徒の学業成績向上を支える目標に沿っていることを確実とし、支出されたすべての資金について正確な監査を実施することで、学区の財政に関する誠実さと透明性を確保するためにあらゆる努力を尽くします。</p><p dir=\"auto\">Paul への連絡先：<u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","KM":"<h1 dir=\"auto\" style=\"text-align: center\">សេចក្តី​​ថ្លែងការណ៍​របស់ PAUL GERARD (ប៉ូល ជេីរ៉ាដ)</h1><h2 dir=\"auto\" style=\"text-align: center\">បេក្ខជន​សំរាប់ សមាជិក​គណៈ​កម្មការ​គ្រប់គ្រង,<br dir=\"auto\">ប្រឹក្សា​ភិបាល​តំបន់​លេខ 3</h2><h3 dir=\"auto\" style=\"text-align: center\">មណ្ឌលសិក្សាធិការរួបរួម BURBANK</h3><p dir=\"auto\">អាយុ ៖ 59 ឆ្នាំ</p><p dir=\"auto\">មុខរបរ ៖ សាស្ត្រាចារ្យមហាវិទ្យាល័យ/ឪពុកឬម្ដាយ</p><p dir=\"auto\">ក្នុងនាមជាប្រឹក្សាភិបាលនៃគណៈកម្មការអប់រំ Burbank ខ្ញុំនឹងធ្វើការដើម្បីធានាថា មានផែនការយុទ្ធសាស្ត្រដែលគាំទ្រដល់សមិទ្ធផលសិក្សារបស់សិស្ស ដោយដាក់ការអប់រំរបស់យុវជននៅ Burbank ជាអាទិភាពខ្ពស់បំផុតរបស់មណ្ឌល ។</p><p dir=\"auto\" style=\"text-align: justify\">ខ្ញុំនឹងធ្វើជាអ្នកតស៊ូមតិសម្រាប់សិស្ស មាតាបិតា បុគ្គលិកគ្រប់រូប និងភាគីពាក់ព័ន្ធទាំងអស់ក្នុងសហគមន៍ ។ ខ្ញុំនឹងស្តាប់ ធ្វើការរួមគ្នា និងលើកទឹកចិត្តឱ្យមានភាពជាដៃគូកាន់តែច្រើនជាមួយក្រុមមាតាបិតា អាជីវកម្មក្នុងមូលដ្ឋាន និងទីក្រុង Burbank ។</p><p dir=\"auto\">ខ្ញុំនឹងធ្វើការជាមួយក្រុមថ្នាក់ដឹកនាំរបស់មណ្ឌល និងសហគមន៍ទាំងមូល ដើម្បីប្រឈមមុខនឹងបញ្ហាការថយចុះនៃចំនួនសិស្សចុះឈ្មោះ ខណៈពេលរក្សាកម្មវិធីអប់រំ សម្ភារៈបរិក្ខារសាលារៀន និងប្រាក់បៀវត្សរ៍បុគ្គលិកឱ្យស្ថិតក្នុងកម្រិតខ្ពស់បំផុតតាមដែលអាចធ្វើទៅបាន ។</p><p dir=\"auto\">ក្នុងនាមជាប្រឹក្សាភិបាល ខ្ញុំយល់ថា ខ្ញុំមានការទទួលខុសត្រូវតាមច្បាប់ក្នុងការប្រព្រឹត្តខ្លួនដោយមានក្រមសីលធម៌ ។ ខ្ញុំសន្យាថា នឹងមានភាពស្មោះត្រង់ជាមួយសហគមន៍ទាំងមូល និងមានតម្លាភាពតាមដែលច្បាប់អនុញ្ញាត ។</p><p dir=\"auto\">ខ្ញុំនឹងធានាថា រាល់ការចំណាយទាំងអស់ស្របតាមគោលដៅដែលគាំទ្រដល់សមិទ្ធផលសិក្សារបស់សិស្ស ហើយខិតខំគ្រប់បែបយ៉ាងដើម្បីធានាឱ្យមានភាពស្មោះត្រង់ និងតម្លាភាពអំពីហិរញ្ញវត្ថុរបស់មណ្ឌល ដោយមានការធ្វើសវនកម្មយ៉ាងត្រឹមត្រូវលើរាល់ប្រាក់ដែលបានចំណាយ ។</p><p dir=\"auto\">ទំនាក់ទំនង Paul តាមរយៈ <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","KO":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD (폴 제라드) 의 성명서</h1><h2 dir=\"auto\" style=\"text-align: center\">이사회 이사 후보,<br dir=\"auto\">이사 구역 번호 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK 통합교육구</h3><p dir=\"auto\">연령: 59</p><p dir=\"auto\">직업: 칼리지 교수/부모</p><p dir=\"auto\">Burbank 교육위원회 이사로서 저는 Burbank 청소년 교육을 최우선 과제로 삼고, 학생들의 학업 성취를 지원하는 전략 계획이 수립되도록 노력하겠습니다.</p><p dir=\"auto\" style=\"text-align: justify\">저는 학생, 학부모, 모든 직원 및 지역사회 이해관계자들을 적극적으로 대변하겠습니다. 저는 학부모 단체, 지역 기업 및 Burbank 시와의 더 많은 협력관계를 구축하도록 장려하면서 경청하고 협력하겠습니다.</p><p dir=\"auto\">저는 교육구 지도부와 지역사회 전체와 협력하여 학생 수 감소라는 문제를 해결하는 한편, 교육 프로그램, 학교 시설 및 최고 수준의 인재에 대한 투자를 유지할 수 있도록 노력하겠습니다.</p><p dir=\"auto\">이사로서 저는 윤리적으로 행동해야 할 법적 책임이 있음을 이해하고 있습니다. 저는 지역사회 전체에 정직하게 행동하고, 법이 허용하는 범위 내에서 최대한 투명하게 임하겠습니다.</p><p dir=\"auto\">저는 모든 지출이 학생 성취도를 지원하는 목표에 부합하도록 하고, 교육구의 재정 지원에 대해 모든 청구서가 정직하고 투명하게 작성되며 모든 지출이 정확하게 검토되도록 하겠습니다.</p><p dir=\"auto\">연락처: Paul — <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","MN":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD (ПАУЛ ЖЕРАРД)-ИЙН МЭДЭГДЭЛ</h1><h2 dir=\"auto\" style=\"text-align: center\">УДИРДАХ ЗӨВЛӨЛИЙН ГИШҮҮНД НЭР ДЭВШИГЧ,<br dir=\"auto\">Итгэмжлэгдсэн хэсэг No. 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK НЭГДСЭН СУРГУУЛИЙН ДҮҮРЭГ</h3><p dir=\"auto\">Нас: ‎59</p><p dir=\"auto\">Ажил мэргэжил: Коллежийн профессор/Эцэг эх</p><p dir=\"auto\">Burbank-ийн Боловсролын зөвлөлийн гишүүний хувьд би Burbank-ийн залуу үеийн боловсролыг дүүргийн хамгийн тэргүүлэх зорилго хэвээр байлгаж, сурагчдын сурлагын амжилтыг дэмжих стратегийн төлөвлөгөөнүүдийг хэрэгжүүлэхийн төлөө ажиллана.</p><p dir=\"auto\" style=\"text-align: justify\">Би сурагчид, эцэг эхчүүд, бүх ажилтнууд болон хамтын нийгэмлэгийн оролцогч талуудын эрх ашгийг хамгаалан ажиллана. Би тэдний саналыг сонсож, хамтран ажиллаж, эцэг эхийн бүлгүүд, орон нутгийн бизнесүүд болон Burbank хоттой хамтын ажиллагаа, түншлэлийг улам өргөжүүлэхийг дэмжинэ.</p><p dir=\"auto\">Би дүүргийн удирдлагын баг болон нийт хамтын нийгэмлэгтэй хамтран сурагчдын тоо буурч буйтай холбоотой бэрхшээлүүдийг шийдвэрлэхийн зэрэгцээ боловсролын хөтөлбөрүүд, сургуулийн байгууламжууд болон ажилтнуудын цалин, урамшууллыг аль болох өндөр түвшинд хадгалахын төлөө ажиллана.</p><p dir=\"auto\">Боловсролын зөвлөлийн гишүүний хувьд би ёс зүйн хэм хэмжээг сахин ажиллах хууль ёсны үүрэгтэй гэдгээ бүрэн ухамсарлаж байна. Нийт хамтын нийгэмлэгийнхээ өмнө үнэнч шударга байж, хуулиар зөвшөөрсөн хэмжээнд үйл ажиллагаагаа ил тод явуулахыг амлаж байна.</p><p dir=\"auto\">Бүх зардлыг сурагчдын сурлагын амжилтыг дэмжих зорилтуудтай уялдуулж, зарцуулсан доллар бүрийг үнэн зөв аудитын хяналтаар баталгаажуулан, дүүргийн санхүүгийн асуудлаар үнэн зөв, ил тод байдлыг хангахын төлөө бүхий л хүчин чармайлтаа гарган ажиллана.</p><p dir=\"auto\">Paul-тай <u>GerardForBUSD@protonmail.com</u> хаягаар холбогдоорой</p><p dir=\"auto\"></p>","MY":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD (ပေါလ် ဂျရာ့ဒ်) ၏ ထုတ်ပြန်ချက်</h1><h2 dir=\"auto\" style=\"text-align: center\">အုပ်ချုပ်ရေးဘုတ်အဖွဲ့ဝင်အတွက် ကိုယ်စားလှယ်လောင်း၊<br dir=\"auto\">အုပ်ထိန်းရေး ဧရိယာ အမှတ် 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK စုပေါင်းကျောင်းခရိုင်</h3><p dir=\"auto\">အသက်- 59 နှစ်</p><p dir=\"auto\">အလုပ်အကိုင်- ကောလိပ်ပါမောက္ခ/မိဘ</p><p dir=\"auto\">Burbank ပညာရေးဘုတ်အဖွဲ့ရဲ့ ယုံကြည်အပ်နှံခံရသူတစ်ယောက်အနေနဲ့ ကျွန်တော်ဟာ Burbank လူငယ်တွေရဲ့ ပညာရေးကို ခရိုင်ရဲ့ အဓိကဦးစားပေးအဖြစ် ထားရှိခြင်းဖြင့် ကျောင်းသား/သူအောင်မြင်မှုကို ပံ့ပိုးတဲ့ ဗျူဟာမြောက် အစီအစဉ်တွေ ရှိစေဖို့ သေချာအောင် လုပ်ဆောင်ပါမယ်။</p><p dir=\"auto\" style=\"text-align: justify\">ကျွန်တော်က ကျောင်းသား/သူတွေ၊ မိဘတွေ၊ ဝန်ထမ်းတွေအားလုံးနဲ့ လူထုအကျိုးပါဝင်ပတ်သက်သူတွေအတွက် ထောက်ခံအားပေးသူအဖြစ် ရပ်တည်ပေးပါမယ်။ ကျွန်တော်က လူထုအသံကို နားစွင့်ပြီး ပူးပေါင်းဆောင်ရွက်မှုရှိရှိ လုပ်ဆောင်မှာဖြစ်သလို မိဘအဖွဲ့တွေ၊ ဒေသတွင်းလုပ်ငန်းတွေ၊ Burbank မြို့တော်နဲ့အတူ ပိုမိုလက်တွဲဆောင်ရွက်ဖို့ တိုက်တွန်းအားပေးပါမယ်။</p><p dir=\"auto\">ကျွန်တော်တို့ရဲ့ ပညာရေးပရိုဂရမ်တွေ၊ ကျောင်းအဆောက်အအုံတွေနဲ့ ဝန်ထမ်းလုပ်ခလစာတွေကို တတ်နိုင်သမျှ အမြင့်ဆုံးမှာထားလျက် ကျောင်းအပ်နှံမှု လျော့ကျလာတဲ့ စိန်ခေါ်မှုတွေကို ရင်ဆိုင်ကျော်လွှားဖို့ ခရိုင်ခေါင်းဆောင်မှုအဖွဲ့နဲ့ အသိုင်းအဝိုင်းတစ်ခုလုံးနဲ့ ကျွန်တော် လက်တွဲဆောင်ရွက်ပါမယ်။</p><p dir=\"auto\">ယုံကြည်အပ်နှံခံရသူအနေနဲ့ ကျွန်တော့်မှာ ကျင့်ဝတ်နဲ့အညီ ဆောင်ရွက်ဖို့ ဥပဒေအရ တာဝန်ရှိတယ်ဆိုတာ နားလည်ပါတယ်။ အသိုင်းအဝိုင်းတစ်ခုလုံးအပေါ် ရိုးသားမှုရှိပြီး ဥပဒေအရ ခွင့်ပြုထားတဲ့ အတိုင်းအတာအထိ ပွင့်လင်းမြင်သာမှုရှိစေဖို့ ကျွန်တော် ကတိပေးပါတယ်။</p><p dir=\"auto\">အသုံးစရိတ်အားလုံးဟာ ကျောင်းသားအောင်မြင်မှုကို ပံ့ပိုးတဲ့ ပန်းတိုင်တွေနဲ့ ကိုက်ညီမှုရှိစေရေး၊ သုံးစွဲခဲ့တဲ့ဒေါ်လာတိုင်းကို တိတိကျကျ စာရင်းစစ်ပြီး အထောက်အထားပြခြင်းဖြင့် ခရိုင်ရဲ့ ဘဏ္ဍာငွေနဲ့ပတ်သက်ပြီး ရိုးသားမှုနဲ့ ပွင့်လင်းမြင်သာမှုရှိစေရေး အစွမ်းကုန်ကြိုးပမ်းဆောင်ရွက်သွားပါမယ်။</p><p dir=\"auto\"><u>GerardForBUSD@protonmail.com</u> မှာ Paul ကို ဆက်သွယ်ပါ</p><p dir=\"auto\"></p>","RU":"<h1 dir=\"auto\" style=\"text-align: center\">ЗАЯВЛЕНИЕ PAUL GERARD (ПОЛ ДЖЕРАРД)</h1><h2 dir=\"auto\" style=\"text-align: center\">КАНДИДАТ В ЧЛЕНЫ УПРАВЛЯЮЩЕГО СОВЕТА,<br dir=\"auto\">Попечительский участок № 3</h2><h3 dir=\"auto\" style=\"text-align: center\">ОБЪЕДИНЕННЫЙ ШКОЛЬНЫЙ РАЙОН BURBANK</h3><p dir=\"auto\">Возраст: 59</p><p dir=\"auto\">Род занятий: Профессор колледжа/родитель</p><p dir=\"auto\">Как попечитель Совета по вопросам образования Burbank, я буду работать над тем, чтобы стратегические планы поддерживали достижения учащихся, сохраняя образование молодежи Burbank главным приоритетом района.</p><p dir=\"auto\">Я буду отстаивать интересы учащихся, родителей, всего персонала и представителей общественности. Я буду слушать, работать совместно и способствовать расширению партнерских отношений с родительскими группами, местным бизнесом и властями города Burbank.</p><p dir=\"auto\">Я буду работать с руководящей командой района и всем сообществом, чтобы противостоять вызовам, связанным со снижением числа учащихся, сохраняя при этом образовательные программы, школьные помещения и оплату труда персонала на самом высоком уровне.</p><p dir=\"auto\">Как попечитель, я понимаю, что несу юридическую ответственность за этичное поведение. Я обещаю быть честным со всем сообществом и настолько прозрачным, насколько позволяет закон.</p><p dir=\"auto\">Я приложу все усилия, чтобы наши расходы соответствовали целям поддержки успеваемости учащихся, и обеспечу честность и прозрачность финансов района, контролируя каждый потраченный доллар с помощью точных аудитов.</p><p dir=\"auto\">Свяжитесь с Paul по адресу <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","TE":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD (పాల్ జెరార్డ్) స్టేట్‌మెంట్</h1><h2 dir=\"auto\" style=\"text-align: center\">గవర్నింగ్ బోర్డు సభ్యుని కొరకు అభ్యర్థి,<br dir=\"auto\">ధర్మకర్త ప్రాంతం నెంబరు 3</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK ఏకీకృత స్కూలు డిస్ట్రిక్ట్</h3><p dir=\"auto\">వయస్సు: 59</p><p dir=\"auto\">వృత్తి: కాలేజీ ప్రొఫెసర్/పేరెంట్</p><p dir=\"auto\">Burbank విద్యా బోర్డు ధర్మకర్తగా, Burbank డిస్ట్రిక్ట్ యువత విద్యకు తొలి ప్రాధాన్యతనిస్తూ, విద్యార్థుల పురోగతికి తోడ్పడే వ్యూహాత్మక ప్రణాళికలు ఉండేలా నేను కృషి చేస్తాను.</p><p dir=\"auto\" style=\"text-align: justify\">నేను విద్యార్థులు, తల్లిదండ్రులు, సిబ్బంది అందరూ మరియు కమ్యూనిటీ భాగస్వాములకు ప్రతినిధిగా ఉంటాను. నేను వింటాను, కలిసి పనిచేస్తాను, మరియు తల్లిదండ్రుల గ్రూపులు, స్థానిక వ్యాపారాలు మరియు Burbank నగరంతో మరిన్ని భాగస్వామ్యాలను ప్రోత్సహిస్తాను.</p><p dir=\"auto\">మన విద్యా పురోగతి, స్కూలు సదుపాయాలు, సిబ్బంది వేతనం సాధ్యమైనంత వరకు గరిష్టంగా ఉండేలా చూస్తూనే, ఎన్‌రోల్‌మెంట్ తగ్గిపోవడానికి సంబంధించిన సవాళ్లను ఎదుర్కొనడానికి నేను డిస్ట్రిక్ట్ నాయకత్వ బృందం మరియు మొత్తం కమ్యూనిటీతో కలిసి పనిచేస్తాను.</p><p dir=\"auto\">ధర్మకర్తగా, నైతికంగా నడుచుకోవాల్సిన చట్టబద్ధమైన బాధ్యత నాకు ఉందని నేను గ్రహించాను. మొత్తం కమ్యూనిటీతో నిజాయితీగా ఉండేందుకు మరియు చట్టం అనుమతించిన మేరకు పారదర్శకంగా ఉంటానని నేను వాగ్ధానం చేస్తున్నాను.</p><p dir=\"auto\">నేను మొత్తం ఖర్చులన్నీ కూడా, విద్యార్థుల పురోగతికి తోడ్పడే లక్ష్యాలకు అనుగుణంగా ఉండేలా చూస్తాను. అలాగే ఖర్చు చేసే ప్రతి డాలర్‌కు సంబంధించి ఖచ్చితమైన ఆడిటింగ్ ద్వారా డిస్ట్రిక్ట్ ఆర్థిక వ్యవహారాల్లో నిజాయితీ, పారదర్శకత ఉండేందుకు అన్ని విధాలా కృషి చేస్తాను.</p><p dir=\"auto\"><u>GerardForBUSD@protonmail.com</u> వద్ద Paulను సంప్రదించండి.</p><p dir=\"auto\"></p>","TH":"<h1 dir=\"auto\" style=\"text-align: center\">แถลงการณ์ของ PAUL GERARD (พอล เจอราร์ด)</h1><h2 dir=\"auto\" style=\"text-align: center\">ผู้สมัครรับเลือกตั้งสำหรับตำแหน่งสมาชิกของคณะกรรมการกำกับดูแล<br dir=\"auto\">ทรัสตีพื้นที่หมายเลข 3</h2><h3 dir=\"auto\" style=\"text-align: center\">เขตโรงเรียนร่วม BURBANK</h3><p dir=\"auto\">อายุ: 59</p><p dir=\"auto\">อาชีพ: อาจารย์วิทยาลัย/ผู้ปกครอง</p><p dir=\"auto\">ในฐานะกรรมการกำกับดูแลการศึกษาเมือง Burbank ผมจะทำงานเพื่อให้แน่ใจว่ามีแผนยุทธศาสตร์ที่สนับสนุนความสำเร็จของนักเรียน โดยให้ความสำคัญทางการศึกษาแก่เยาวชนเมือง Burbank</p><p dir=\"auto\" style=\"text-align: justify\">ผมจะเป็นผู้สนับสนุนนักเรียน ผู้ปกครอง บุคลากรทุกคน และผู้มีส่วนได้เสียในชุมชน ผมจะรับฟัง ทำงานอย่างร่วมมือร่วมใจกัน และส่งเสริมความร่วมมือกันเพิ่มขึ้นกับกลุ่มผู้ปกครอง ธุรกิจในท้องถิ่น และเทศบาลเมือง Burbank</p><p dir=\"auto\">ผมจะทำงานร่วมกับทีมผู้บริหารเขตโรงเรียนร่วมและชุมชนทั้งหมด เพื่อรับมือกับความท้าทายของจำนวนนักเรียนที่ลดลง ในขณะที่ต้องคงไว้ซึ่งโปรแกรมการศึกษาต่างๆ อาคารสถานที่และสิ่งอำนวยความสะดวกในโรงเรียน และค่าตอบแทนบุคลากรให้สูงที่สุดเท่าที่จะเป็นไปได้</p><p dir=\"auto\">ในฐานะกรรมการกำกับดูแลทรัสตี ผมเข้าใจถึงหน้าที่ผูกพันตามกฎหมายที่ผมจะต้องประพฤติปฏิบัติตนอย่างมีจริยธรรม ผมขอสัญญาว่าจะซื่อสัตย์ต่อทั้งชุมชน และโปร่งใสตามที่กฎหมายกำหนด</p><p dir=\"auto\">ผมจะดูแลค่าใช้จ่ายทั้งหมดให้เป็นไปตามเป้าหมายที่สอดคล้องกับผลสัมฤทธิ์ทางการเรียนของนักเรียน และจะพยายามอย่างเต็มที่เพื่อให้เกิดความซื่อสัตย์และโปร่งใสทางการเงินของเขตโรงเรียนร่วม โดยให้มีการตรวจสอบทางบัญชีอย่างถูกต้องแม่นยำสำหรับทุกเม็ดเงินที่ใช้จ่ายไป</p><p dir=\"auto\">ติดต่อ Paul ได้ที่ <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","TL":"<h1 dir=\"auto\" style=\"text-align: center\">PAHAYAG NI PAUL GERARD</h1><h2 dir=\"auto\" style=\"text-align: center\">KANDIDATO PARA MIYEMBRO NG NAMAMAHALANG LUPON,<br dir=\"auto\">Lugar ng Katiwala Blg. 3</h2><h3 dir=\"auto\" style=\"text-align: center\">PINAG-ISANG DISTRITO NG PAARALAN NG BURBANK</h3><p dir=\"auto\">Edad: 59</p><p dir=\"auto\">Trabaho: Propesor ng Kolehiyo/Magulang</p><p dir=\"auto\">Bilang isang katiwala ng Lupon ng Edukasyon ng Burbank, sisikapin kong tiyakin na may mga estratehikong plano na sumusuporta sa tagumpay ng mga estudyante sa pamamagitan ng pagpapanatili sa edukasyon ng mga kabataan ng Burbank bilang pangunahing prayoridad ng distrito.</p><p dir=\"auto\" style=\"text-align: justify\">Ako ay magiging tagapagtaguyod para sa mga estudyante, magulang, lahat ng kawani, at mga may nakataya ng komunidad. Makikinig ako, makikipagtulungan ako, at hihikayatin ko ang mas maraming pakikipagtulungan sa mga grupo ng mga magulang, mga lokal na negosyo, at sa Lungsod ng Burbank.</p><p dir=\"auto\">Makikipagtulungan ako sa pangkat ng pamunuan ng distrito at sa buong komunidad upang harapin ang mga hamon ng pagbaba ng bilang ng mga mag-aaral habang pinapanatili ang ating mga programang pang-edukasyon, mga pasilidad ng paaralan, at kabayaran sa mga kawani sa pinakamataas na antas na posible.</p><p dir=\"auto\">Bilang isang tagapangasiwa, nauunawaan kong mayroon akong legal na responsibilidad na kumilos nang ayon sa etika. Nangangako akong magiging tapat sa buong komunidad at nang may kalinawan hangga't maaari ayon sa pinahihintulutan ng batas.</p><p dir=\"auto\">Sisiguraduhin kong naaayon ang lahat ng gastusin sa mga layuning sumusuporta sa tagumpay ng mga mag-aaral at ginagawa ang bawat pagsisikap upang magkaroon ng katapatan at kalinawan tungkol sa pananalapi ng distrito na sinusuportahan ng tumpak na pagsusuri ng bawat dolyar na ginagastos.</p><p dir=\"auto\">Makipag-ugnayan kay Paul sa <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","VI":"<h1 dir=\"auto\" style=\"text-align: center\">BÀI PHÁT BIỂU CỦA PAUL GERARD</h1><h2 dir=\"auto\" style=\"text-align: center\">ỨNG CỬ VIÊN CHO CHỨC VỤ ỦY VIÊN HỘI ĐỒNG QUẢN TRỊ,<br dir=\"auto\">Chưởng Quản Khu Số 3</h2><h3 dir=\"auto\" style=\"text-align: center\">KHU HỌC CHÁNH THỐNG NHẤT BURBANK</h3><p dir=\"auto\">Tuổi: 59</p><p dir=\"auto\">Nghề Nghiệp: Giáo Sư Đại Học/Phụ Huynh</p><p dir=\"auto\">Với tư cách là chưởng quản Hội Đồng Giáo Dục Burbank, tôi sẽ nỗ lực bảo đảm có các kế hoạch chiến lược nhằm hỗ trợ thành tích học tập của học sinh, trong đó việc giáo dục thế hệ trẻ Burbank được đặt ở vị trí ưu tiên hàng đầu của khu học chánh.</p><p dir=\"auto\" style=\"text-align: justify\">Tôi sẽ lên tiếng bảo vệ quyền lợi của học sinh, phụ huynh, toàn thể nhân viên và các bên liên quan trong cộng đồng. Tôi sẽ lắng nghe, hợp tác và khuyến khích tăng cường quan hệ đối tác với các nhóm phụ huynh, thương nghiệp địa phương và Thành Phố Burbank.</p><p dir=\"auto\">Tôi sẽ phối hợp với đội ngũ lãnh đạo khu học chánh và toàn thể cộng đồng để giải quyết những thách thức do số lượng ghi danh giảm, đồng thời duy trì các chương trình giáo dục, cơ sở vật chất trường học và chế độ đãi ngộ cho nhân viên ở mức cao nhất có thể.</p><p dir=\"auto\">Với tư cách là một chưởng quản, tôi hiểu rằng mình có trách nhiệm pháp lý phải tự hành xử một cách có đạo đức. Tôi cam kết trung thực với toàn thể cộng đồng và minh bạch theo quy định của pháp luật.</p><p dir=\"auto\">Tôi sẽ bảo đảm mọi khoản chi tiêu đều phù hợp với các mục tiêu hỗ trợ thành tích học tập của học sinh, đồng thời nỗ lực hết sức để bảo đảm tính trung thực và minh bạch trong vấn đề tài chính của khu học chánh thông qua việc kiểm toán chính xác từng khoản tiền đã chi dụng.</p><p dir=\"auto\">Liên lạc Paul qua <u>GerardForBUSD@protonmail.com</u></p><p dir=\"auto\"></p>","ZH":"<h1 dir=\"auto\" style=\"text-align: center\">PAUL GERARD（保羅·傑拉德）之競選聲明</h1><h2 dir=\"auto\" style=\"text-align: center\">管理委員會委員候選人，<br dir=\"auto\">第3託管區</h2><h3 dir=\"auto\" style=\"text-align: center\">BURBANK 聯合學區</h3><p dir=\"auto\">年齡：59</p><p dir=\"auto\">職業：大學教授/家長</p><p dir=\"auto\">身為 Burbank 教育委員會委員，我將致力推動制訂策略計畫，把 Burbank 青少年的教育列為學區最高優先事項，藉此提升學生學習成效。</p><p dir=\"auto\" style=\"text-align: justify\">我將為學生、家長、全體教職員以及社區利害關係人發聲。我將傾聽各方意見、協同合作，並促進與家長團體、在地企業以及 Burbank 市政府建立更多合作關係。</p><p dir=\"auto\">我將與學區領導團隊及全體社區民眾共同面對入學人數下滑的挑戰，同時盡可能維持教育課程、校園設施與教職員薪酬的最高水準。</p><p dir=\"auto\">身為委員，我明白自己負有恪守倫理行事的法律責任。我承諾對全體社區誠實以對，並在法律允許範圍內做到最大限度公開透明。</p><p dir=\"auto\">我將確保所有支出都契合提升學生學習成效的目標，並盡一切努力，透過對每一筆經費進行精確審計，讓學區財務做到誠實與公開透明。</p><p dir=\"auto\">請致函 <u>GerardForBUSD@protonmail.com</u> 聯絡 Paul</p><p dir=\"auto\"></p>"},"CandidateID":"WT","SequenceOrder":358}],"order":3,"isWriteIn":false,"isPresidential":false},{"id":"WU","name":[{"BN":"রোজমেরি টি. মরিসন","CC":"露絲瑪麗·T.·莫里森","EN":"ROSEMARY T. MORRISON","FA":"رزماری تی. موریسون","GU":"રોઝમૅરી ટી. મોરિસન","HI":"रोज़मेरी टी. मॉरिसन","HY":"ՌՈՍՄԵՐԻ Թ. ՄՈՐԻՍՈՆ","JA":"ローズマリー・T.・モリソン","KM":"រ៉ូសម៉ារី ធី. ម៉ូរីសុន","KO":"로즈메리 T. 모리슨","MN":"РОУЗМЭРИ Т. МОРРИСОН","MY":"ရို့စ်မေရီ တီ မောရစ်ဆန်","RU":"РОЗМАРИ Т. МОРРИСОН","TE":"రోజ్‌మేరీ టి. మోరిసన్","TH":"โรสแมรี ที. มอร์ริสัน","ZH":"露絲瑪麗·T.·莫里森"}],"short_name":[{"EN":"R T MORRISON"}],"occupation":[{"BN":"মা/শিক্ষক/ছাত্রী","CC":"母親/教師/學生","EN":"Mother/Teacher/Student","ES":"Madre/Maestra/Estudiante","FA":"مادر/معلم/دانش‌آموز","GU":"માતા/શિક્ષિકા/વિદ્યાર્થી","HI":"माँ/अध्यापिका/छात्रा","HY":"Մայր/Ուսուցիչ/Ուսանող","ID":"Ibu/Guru/Pelajar","JA":"母親／教師／生徒","KM":"ម្ដាយ/គ្រូបង្រៀន/សិស្ស","KO":"어머니/교사/학생","MN":"Эх/Багш/Оюутан","MY":"မိခင်/ဆရာမ/ကျောင်းသူ","RU":"Мать/учитель/студент","TE":"తల్లి/టీచర్/విద్యార్ధి","TH":"แม่/ครู/นักเรียน","TL":"Ina/Guro/Estudyante","VI":"Người Mẹ/Giáo Viên/Học Sinh","ZH":"母親/教師/學生"}],"statements":[],"order":4,"isWriteIn":false,"isPresidential":false},{"id":"3PH","name":[{"BN":"রাইট-ইন(তালিকা বহির্ভূত)প্রার্থী","CC":"自填候選人","EN":"Write-In Candidate","ES":"Candidato por Escrito","FA":"کاندیدا خارج از لیست","GU":"અંદર લખવાના ઉમેદવાર","HI":"राइट–इन उम्मीदवार","HY":"Գրավոր առաջադրված թեկնածու","ID":"Calon Tidak Terdaftar dalam Surat Suara","JA":"記入候補者","KM":"បេក្ខជនសរសេរបញ្ចូលឈ្មោះ","KO":"기명 후보자","MN":"Бичигдэх нэр дэвшигч","MY":"ထပ်ဖြည့်သော ကိုယ်စားလှယ်လောင်း","RU":"Вписанный кандидат","TE":"రైట్-ఇన్ అభ్యర్ధి","TH":"ผู้สมัครรับเลือกตั้งแบบเขียนชื่อ","TL":"Isinusulat-lamang na Kandidato","VI":"Ứng Cử Viên Viết Tên Vào","ZH":"自填候選人"}],"short_name":[{"EN":"Write-In Candidate"}],"occupation":[null],"statements":[],"order":6,"isWriteIn":true,"isPresidential":false}],"statements":[]}