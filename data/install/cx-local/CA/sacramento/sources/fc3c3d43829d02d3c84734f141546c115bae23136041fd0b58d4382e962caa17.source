<script>
	(function () {
  document.addEventListener("DOMContentLoaded", function () {
    var skipLinkId = "skip-to-main-content-link";
    var mainContentId = "main-content";

    if (document.getElementById(skipLinkId)) return;

    // Find the first main
    var main = Array.from(document.querySelectorAll("main")).find(function (el) {
      return !el.parentElement.closest("main");
    });

    if (!main) return;

    // Ensure the main has the correct ID
    var existingMainContent = document.getElementById(mainContentId);

    if (!existingMainContent) {
      main.id = mainContentId;
    } else if (existingMainContent !== main) {
      main = existingMainContent;
    }

    // Make main focusable
    if (!main.hasAttribute("tabindex")) {
      main.setAttribute("tabindex", "-1");
    }

    // Create skip to link
    var skipLink = document.createElement("a");
    skipLink.id = skipLinkId;
    skipLink.href = "#" + main.id;

    // Add style classes
    skipLink.className =
      "skip-to-main-content-link d-inline-flex align-items-center gap-2 " +
      "bg-danger text-white fw-semibold text-decoration-none " +
      "px-4 py-3 rounded shadow-lg rounded-pill";

    skipLink.innerHTML = `
<span>Skip to main content</span>
<i class="bi bi-arrow-right" aria-hidden="true"></i>
    `;

    document.body.insertBefore(skipLink, document.body.firstChild);

    // Position link
    var style = document.createElement("style");
    style.textContent = `

      .skip-to-main-content-link {
        position: absolute;
        top: 1rem;
        left: 1rem;
        z-index: 999999;
        transform: translateY(-250%);
        transition: transform .25s ease;
        border: 2px solid #fff;
        box-shadow:
          0 .75rem 1.5rem rgba(0,0,0,.45),
          0 0 0 .25rem rgba(255,255,255,.25)!important;
      }

      .skip-to-main-content-link:focus,
      .skip-to-main-content-link:active,
      .skip-to-main-content-link:focus-visible {
        transform: translateY(0);
        outline: 3px solid #fff;
        outline-offset: 3px;
        color: #fff;
      }

      .skip-to-main-content-link:hover {
        color: #fff;
        text-decoration: none;
      }
    `;
    document.head.appendChild(style);

    // Activation for accessibility
    skipLink.addEventListener("click", function (event) {
      event.preventDefault();

      var target = document.getElementById(main.id);
      if (!target) return;

      target.focus({ preventScroll: true });

      target.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });

      if (history.pushState) {
        history.pushState(null, "", "#" + target.id);
      } else {
        window.location.hash = target.id;
      }
    });
  });
})();
</script>
