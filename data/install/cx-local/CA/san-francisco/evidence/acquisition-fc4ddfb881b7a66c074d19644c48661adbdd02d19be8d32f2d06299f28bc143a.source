        {
            "id": 51889,
            "meta": {
                "type": "cms.BaseDocument",
                "download_url": "https://api.sf.gov/documents/51889/Charter_Amendment_-_Fixing_Our_Broken_Ballot_Process.pdf"
            },
            "title": "Charter Amendment - Fixing Our Broken Ballot Process",
            "collection": {
                "id": 1,
                "meta": {
                    "type": "wagtailcore.Collection"
                }
            },
