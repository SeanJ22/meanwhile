{"theme":{"name":"JewelryBoxTheme","styles":["yellow","default","black","green","cyan","red","purple","blue"],"version":"2.24","sharedTheme":{"useHeader":false,"useLogo":false,"isPortalSupport":true},"customStyles":{"mainBackgroundColor":"#1682b6"}},"portalUrl":"https://bart.maps.arcgis.com","appId":"","authorizedCrossOriginDomains":[],"title":"BART Director District Boundary Viewer","subtitle":"","keepAppState":false,"logo":"https://bart.maps.arcgis.com/sharing/rest/content/items/${itemId}/resources/inConfig/7039180084177712.png","geometryService":"https://utility.arcgisonline.com/arcgis/rest/services/Geometry/GeometryServer","links":[{"label":"BART Board of Directors Homepage","url":"https://www.bart.gov/about/bod"}],"widgetOnScreen":{"widgets":[{"uri":"themes/JewelryBoxTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.24","id":"themes_JewelryBoxTheme_widgets_HeaderController_Widget_21","name":"HeaderController"},{"uri":"widgets/Scalebar/Widget","position":{"left":7,"bottom":25,"relativeTo":"map"},"version":"2.24","id":"widgets_Scalebar_Widget_22","name":"Scalebar","config":{"scalebar":{"scalebarStyle":"","scalebarUnit":"","decimalPlaces":0,"addSeparator":false}},"visible":false},{"uri":"widgets/Search/Widget","position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.24","id":"widgets_Search_Widget_23","name":"Search","config":{"allPlaceholder":"","showInfoWindowOnSelect":true,"sources":[]},"visible":false},{"uri":"widgets/Coordinate/Widget","position":{"left":7,"bottom":5,"relativeTo":"map"},"version":"2.24","id":"widgets_Coordinate_Widget_24","name":"Coordinate","config":{"spatialReferences":[],"decimalPlaces":3,"addSeparator":true,"displayOrderLonLat":true},"visible":false},{"position":{"left":55,"top":45,"relativeTo":"map"},"placeholderIndex":1,"id":"_25"},{"position":{"left":105,"top":45,"relativeTo":"map"},"placeholderIndex":2,"id":"_26"},{"position":{"left":155,"top":45,"relativeTo":"map"},"placeholderIndex":3,"id":"_27"},{"uri":"widgets/OverviewMap/Widget","position":{"right":0,"bottom":0,"relativeTo":"map"},"version":"2.24","id":"widgets_OverviewMap_Widget_28","name":"OverviewMap","config":{"overviewMap":{"visible":false,"baseLayer":{"url":"","type":"baseMap"}}}},{"uri":"widgets/HomeButton/Widget","position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.24","id":"widgets_HomeButton_Widget_29","name":"HomeButton"},{"uri":"widgets/MyLocation/Widget","position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.24","id":"widgets_MyLocation_Widget_30","name":"MyLocation"},{"uri":"widgets/AttributeTable/Widget","version":"2.24","position":{"relativeTo":"browser"},"id":"widgets_AttributeTable_Widget_31","name":"AttributeTable","config":{"layerInfos":[],"table":{"pageSizeOptions":[25,50,100,1000]},"hideExportButton":true,"initiallyExpand":false,"filterByMapExtent":true,"allowTextSelection":true,"syncWithLayers":false},"visible":false},{"uri":"widgets/Splash/Widget","position":{"relativeTo":"browser"},"version":"2.24","id":"widgets_Splash_Widget_32","name":"Splash","config":{"splash":{"splashContent":"<p style=\"text-align: center;\">\n\t<font face=\"Arial\" size=\"6\" style=\"color: rgb(0, 0, 1);\"><span style=\"line-height: 107%;\"><b style=\"\">BART Director District Boundary Viewer</b></span></font></p><p style=\"text-align: center;\"><font face=\"Arial\" size=\"6\" style=\"color: rgb(0, 0, 1);\"><span style=\"line-height: 107%;\"><b style=\"\"><br /></b></span></font></p><p style=\"text-align: center;\"><img alt=\"BART_Logo_Color_Medium.png\" id=\"img_1651184314197\" src=\"data:image/png;base64,\" /><br /></p><p style=\"text-align: center;\"><br /></p><p style=\"text-align: center;\"><br /></p>\n<p>\n\t<font face=\"Arial\" size=\"2\" style=\"color: rgb(0, 0, 1);\"><span style=\",serif; Times New Roman' font-family: ' font-size:12.0pt; line-height:107%;\">The San Francisco Bay Area Rapid Transit District (BART) presents this web map to visualize BART Board of Directors Districts. The data provided is based on U.S. Census Boundaries and the work product of GEOinov</span></font><span style=\"color: rgb(0, 0, 1); font-family: Arial; font-size: small;\">o Solutions Inc.,</span><span style=\"color: rgb(0, 0, 1); font-family: Arial; font-size: small;\"> BART's redistricting consultant. </span></p><p><b style=\"color: rgb(0, 0, 1); font-family: Arial;\"><span style=\",serif; Times New Roman' font-family:' font-size:12.0pt; line-height:107%;\"><font size=\"2\"><br /></font></span></b></p><p><span style=\"color: rgb(0, 0, 1); font-family: Arial; font-size: small;\">This application includes the newly redistricted BART Board of Directors (BOD) District boundaries, the legacy BOD District boundaries, BART stations, and BART tracks. </span></p><p><span style=\"color: rgb(0, 0, 1); font-family: Arial; font-size: small;\"><br /></span></p><p><span style=\"color: rgb(0, 0, 1); font-family: Arial; font-size: small;\">The Director District Lookup Widget on the left-hand side of the screen allows you to search for districts containing a given address. </span><span style=\"color: rgb(0, 0, 1); font-family: Arial; font-size: small;\">The legend, layer list, and basemap gallery widgets in the top right corner of the screen display the layers visible in the map, allow you to toggle layer visibility, and allow you to switch between basemaps, respectively.</span></p>","requireConfirm":false,"confirm":{"text":"","color":"#696969","transparency":0},"showOption":true,"confirmEverytime":true,"contentVertical":"top","size":{"mode":"percent","percent":"50%","wh":{"w":748,"h":264}},"background":{"mode":"color","image":null,"type":"fill","fileName":"No%20file%20chosen","color":"#d6dfe3","transparency":0.25},"button":{"color":"#518dca","transparency":0,"text":"OK"}}}},{"uri":"widgets/ZoomSlider/Widget","position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.24","id":"widgets_ZoomSlider_Widget_33","name":"ZoomSlider"},{