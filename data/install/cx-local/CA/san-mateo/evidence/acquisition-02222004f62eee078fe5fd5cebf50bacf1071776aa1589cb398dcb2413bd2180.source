<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">

    <title>Page not found</title>

    <link href="https://fonts.googleapis.com/css?family=Raleway:400,700" rel="stylesheet" type="text/css">
    <style>
      body {
        font-family: 'Raleway', Helvetica, sans-serif;
        background-color: #fff;
      }

      a {
        text-decoration: none;
      }

      a:hover, a:focus {
        text-decoration: underline;
      }

      .sign {
        position: relative;
        width: 300px;
        margin: 5em auto;
      }

      .sign img {
        width: 100%;
      }

      .sign h1 {
        position: absolute;
        left: 59%;
        right: 15%;
        top: 5%;
        text-align: center;
        font-weight: normal;
        font-size: 1em;
      }

      .text {
        width: 300px;
        margin: 0 auto;
        color: #A0A8AF;
        text-align: center;
        font-size: 1.5em;
      }
    </style>
  </head>
  <body>
    <div class="sign">
      <img src="/404.svg" alt="" />
      <h1>Page not found</h1>
    </div>

    <div class="text">
      <p>Sorry, we can't find the page you're looking for.</p>
      <p><a href="/">Return to the homepage</a></p>
    </div>
  <script type="text/javascript" src="/_Incapsula_Resource?SWJIYLWA=719d34d31c8e3a6e6fffd425f7e032f3&ns=1&cb=1142364565" async></script></body>
</html>
