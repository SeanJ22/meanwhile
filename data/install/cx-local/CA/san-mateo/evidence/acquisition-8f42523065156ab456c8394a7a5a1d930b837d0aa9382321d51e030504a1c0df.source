</td>
<td>
<p><span><span><span><span><span><span><span><span>Starting October 5</span></span></span></span></span></span></span></span></p>
<p><span><span><span><span><span><span><span><span>Ending November 3 at 8 p.m.</span></span></span></span></span></span></span></span></p>
