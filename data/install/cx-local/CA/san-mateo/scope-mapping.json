  {
    "contestId": "ca-cx-local-2026-san-mateo-3103",
    "ocdId": "ocd-division/country:us/state:ca/school_district:san_mateo_county_community_college_district/trustee_area:2",
    "presentInCheckedInRegistry": false,
    "electorateProvenance": [
      {
        "sourceUrl": "https://www.smccd.edu/boardoftrustees/notice-hearing-by-trustee-area-elections.php",
        "sourceOrg": "San Mateo County Community College District",
        "collectedAt": "2026-11-03T09:29:17.093218+00:00",
        "verifiedAt": "2026-11-03T09:39:32.503626+00:00",
        "quote": "The San Mateo County Community College District Board of Trustees transitioned to a by-trustee-area election system in 2018, with the county divided into distinct areas, each electing one member to the Board of Trustees."
      }
    ],
    "wholeCountyScope": false,
    "geometryPrepared": false,
    "readerMappingStatus": "PRECISE_DIVISION_NOT_YET_JOINED"
  },
  {
    "contestId": "ca-cx-local-2026-san-mateo-3204",
    "ocdId": "ocd-division/country:us/state:ca/school_district:cabrillo_unified_school_district/trustee_area:c",
    "presentInCheckedInRegistry": false,
    "electorateProvenance": [
      {
        "sourceUrl": "https://cabrillousd.ss10.sharpschool.com/about_us/governing_board/elections",
        "sourceOrg": "Cabrillo Unified School District",
        "collectedAt": "2026-11-03T09:30:12.996745+00:00",
        "verifiedAt": "2026-11-03T09:39:32.503626+00:00",
        "quote": "Board members of the Cabrillo Unified School District were previously elected “at-large,” meaning that candidates were required to reside within the attendance areas of the Cabrillo Unified School District and the voters of the entire district elected the candidates to the Board. A “by-trustee area” election, wherein one candidate residing in each trustee area is elected by only the registered voters in that particular trustee area, ensures compliance with the California Voting Rights Act (CVRA). The Board moved to a “by-trustee area” electoral system in 2019, which began with the 2020 Board election.  Please see the relevant information below."
      }
    ],
    "wholeCountyScope": false,
    "geometryPrepared": false,
    "readerMappingStatus": "PRECISE_DIVISION_NOT_YET_JOINED"
  },
