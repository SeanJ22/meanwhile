	<div class="fsElement fsLayout fsTwoColumnLayout fsStyleAutoclear" id="fsEl_21615" data-use-new="true" >

						<div class=" fsDiv fsStyleColumn fsStyleColumn-1 fsStyleAutoclear" id="fsEl_21616"  >

				<div class="fsElement fsContent" id="fsEl_19153" data-use-new="true" >

				<div class="fsElementContent" >
			<p><span class="lead-in">The San Mateo County Board of Education is comprised of seven members who are elected to four-year terms.&nbsp; Each member is a registered voter in the&nbsp;Trustee Area&nbsp;they represent. Each member is elected by the registered voters of their trustee area.&nbsp; The Board elects a president and a vice president at its annual organizational meeting in December.&nbsp; Four members are required to conduct regular business.</span></p>


	</div>


	</div>
	
	<section class="fsElement fsResourceElement fsSingleItem" id="fsEl_21619" data-use-new="true" data-source-element-id="21619" data-source-page-id="2310" data-display-items="collections_and_resources" >

				<header>
					<h2 class="fsElementTitle" id="fsElementTitle_21619">Trustee Area Boundaries</h2>
	</header>
	<div class="fsElementContent" >
		<div
	class="fsResource fsResourceTypeImage"
	data-controller="single-image"
	data-resource-type="image"
	data-single-image-resource-uuid-value="f5059b5b-85be-4303-95da-cde716a8f477"
	data-single-image-resource-type-value="image"
	data-single-image-preview-value="false">
			<div class='fsA11yImage fsA11yImageSingle'>

		<figure>
				<picture>
					<img alt="Trustee Boundaries" data-resource-uuid="f5059b5b-85be-4303-95da-cde716a8f477" data-permitted-user="true" data-single-image-target="image" data-image-sizes="[{&quot;url&quot;:&quot;https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_1/v1755018098/smcoeorg/lk0maq341djai07s9tof/trustee_boundaries.png&quot;,&quot;width&quot;:256},{&quot;url&quot;:&quot;https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_2/v1755018098/smcoeorg/lk0maq341djai07s9tof/trustee_boundaries.png&quot;,&quot;width&quot;:512},{&quot;url&quot;:&quot;https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_3/v1755018098/smcoeorg/lk0maq341djai07s9tof/trustee_boundaries.png&quot;,&quot;width&quot;:800},{&quot;url&quot;:&quot;https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_4/v1755018098/smcoeorg/lk0maq341djai07s9tof/trustee_boundaries.png&quot;,&quot;width&quot;:1200},{&quot;url&quot;:&quot;https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_5/v1755018098/smcoeorg/lk0maq341djai07s9tof/trustee_boundaries.png&quot;,&quot;width&quot;:1600},{&quot;url&quot;:&quot;https://resources.finalsite.net/images/f_auto,q_auto/v1755018098/smcoeorg/lk0maq341djai07s9tof/trustee_boundaries.png&quot;,&quot;width&quot;:1714}]" data-aspect-ratio="1.3360560093348892" data-resource-title="Trustee Boundaries" src="" />
				</picture>

		</figure>
	</div>

</div>

	</div>


