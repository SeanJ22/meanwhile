5efebfdb1912ae1743adb17fe859737c2e48"},{"ver":7,"id":107043,"updated_at":"2026-09-16T23:31:26.056Z","created_at":"2026-09-14T21:33:05.462Z","account_id":"06085","meta":{"import":{"Audio: Text 1":{"audio":{},"format":"style","style":"default","translations":{"es":"Miembro del Concejo Municipal, Distrito 4","hi":"सदस्य, शहर काउंसिल, डिस्ट्रिक्ट 4","ja":"市議会議員、第4区","km":"សមាជិក, ក្រុម​ប្រឹក្សា​ក្រុង,សង្កាត់ទី 4","ko":"제 4 지구 시의회 의원","tl":"Miyembro, Konseho ng Lunsod, Distrito 4","vt":"Ủy Viên, Hội Đồng Thành Phố, Khu 4","zh-hant":"市議會議員，第4選區"},"value":"Member, City Council, District 4"},"Audio: Text 2":{"audio":{},"format":"style","style":"default","translations":{"es":"Vote por Uno","hi":"एक  के लिए मतदान करें","ja":"1人に投票","km":"សូមបោះឆ្នោតជ្រើសរើស មួយ","ko":"한 명만 기표하시오","tl":"Bumoto ng Isa","vt":"Bầu Một Người","zh-hant":"選一人"},"value":"Vote for One"},"Audio: Text 3":{"audio":{},"format":"html","style":"default","translations":{"es":"*♦ Un diamante significa que el candidato ha acordado limitar voluntariamente los gastos de su campaña.","hi":"*♦ डायमंड का अर्थ है कि उम्मीदवार स्वेच्छा से अभियान खर्च सीमित करने पर सहमत हो गया है।","ja":"*♦ ダイヤモンドの印は、候補者が自主的に選挙運動資金を制限したことを示します。","km":"*♦ សញ្ញាពេជ្រមានន័យថា បេក្ខជនបានយល់ព្រមដាក់កម្រិតលើការចំណាយក្នុងយុទ្ធនាការដោយស្ម័គ្រចិត្ត។","ko":"*♦ 다이아몬드 부호는 자발적으로 선거운동 비용을 제한하기로 동의한 후보자를 의미함","tl":"*♦ Ang isang diyamante ay nangangahulugang ang kandidato ay sumang-ayon na kusang-loob na limitahan ang paggasta sa kampanya.","vt":"*♦ Dấu hình thoi có nghĩa là ứng cử viên đồng ý tự nguyện giới hạn mức chi tiêu trong cuộc vận động.","zh-hant":"*♦ 菱形標記表示候選人已同意自願限制其競選經費。"},"value":"*♦ A diamond means the candidate has agreed to voluntarily limit campaign spending."},"Choice Template 1":"AC - CEPSTRAL - CHOICE - CAND,OCC","Choice Template 2":"BC - CHOICE - DIAMOND - CAND,OCC - EN-ES-TL-VI","Choice Template 3":"BC - CHOICE - DIAMOND - CAND,OCC - EN-CHN-HI-JA-KO","Choice Template 4":"BC - CHOICE - DIAMOND - CAND,OCC - EN-KM","Contest Templat