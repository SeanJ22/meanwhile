{
 "currentVersion": 11.3,
 "cimVersion": "3.3.0",
 "id": 11,
 "name": "Oxnard School District",
 "type": "Feature Layer",
 "description": "The boundary of the individual Trustee Districts was provided by the School District to the Ventura County Clerk/Recorder Elections Division. These boundaries are based on Census data from the 2020 census. The census data does not follow current GIS data for the County of Ventura. The data was used to modify the Election Precincts as maintained by the Ventura County Clerk/Recorder Elections Division. The boundary was then provided to Information Technology Services Department/GIS division to be matched up to the boundary of the School District. The interior lines were redrawn to match Election Precinct polygons. The next scheduled changes should be for the 2030 census data in 2032. ",
 "geometryType": "esriGeometryPolygon",
