        <div  class="accordion__body mt-8">
      <div class="block__elemental_component--text block__elemental_component--text--default block block-elemental block-elemental-component-blocktext">
  
    
      <div class="elemental_component text text--default elemental_component mb-4">
  
            <div class="field text--field-text field-text field__text--default clearfix text-formatted field--name-field-text field--type-text-long field--label-hidden field__item"><p><a href="https://www.coloradojudicial.gov/sites/default/files/2026-09/Additional%20Resources%2009.17.26.pdf"><strong>Follow this link for a full list of resources.&nbsp;</strong></a></p><p><a href="https://www.coloradojudicial.gov/media/21494"><strong>Lista De Recursos (Resource List Spanish Version)</strong></a></p><p>&nbsp;</p><p><strong>Education</strong></p><table class="table"><tbody><tr><td>Agency Name</td><td>Contact Information</td><td>Link</td></tr><tr><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;"><strong>Star Girlz Empowerment</strong>&nbsp;&nbsp;</span></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">720-572-5840&nbsp;</span></td><td><a href="https://stargirlzempower.org/"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">https://stargirlzempower.org/</span></a></td></tr><tr><td><strong>Collaborative Healing Initiatives within Communities (CHIC)</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">303-993-8511&nbsp;</span></td><td><a href="https://chicdenver.org/"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">https://chicdenver.org/</span></a></td></tr><tr><td><strong>Royal Mentoring Group</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">720-532-5519&nbsp;</span></td><td><a href="https://www.royalforyouth.org/"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">https://www.royalforyouth.org/</span></a></td></tr></tbody></table><p><strong>Employment</strong></p><table class="table"><tbody><tr><td>Agency Name</td><td>Contact Information</td><td>Link</td></tr><tr><td><strong>Denver Workforce</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">720-337-9675&nbsp;</span></td><td><a href="https://cdle.colorado.gov/jobs-training/workforce-centers"><span>https://cdle.colorado.gov/jobs-training/workforce-centers</span></a></td></tr><tr><td><strong>Youth Employment Academy</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">720-956-3833&nbsp;</span></td><td><a href="https://www.youthemploymentacademy.org/"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">https://www.youthemploymentacademy.org/</span></a></td></tr></tbody></table><p><strong>Mental Health</strong></p><table class="table"><tbody><tr><td>Agency Name</td><td>Contact Information</td><td>Link</td></tr><tr><td><strong>LifeStance Health</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">877-780-5227&nbsp;</span></td><td><a href="https://lifestance.com/"><span>Online &amp; In-Person Therapy &amp; Psychiatry Appointments</span></a><span>&nbsp;</span></td></tr><tr><td><strong>Guadalupe Project</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">720-387-7373&nbsp;</span></td><td><a href="https://www.theguadalupeproject.services/"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">The Guadalupe Project</span></a></td></tr><tr><td><strong>Denver Health Adolescent Outpatient</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">303-436-5690&nbsp;</span></td><td><a href="https://www.denverhealth.org/services/behavioral-health"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">Behavioral &amp; Mental Health Services | Denver Health | Denver Health</span></a></td></tr></tbody></table><p><strong>Food Pantry + Clothing</strong></p><table class="table"><tbody><tr><td>Agency Name</td><td>Contact Information</td><td>Link</td></tr><tr><td><strong>Campbell Chapel AME Church</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">303-839-5058&nbsp;</span></td><td><a href="https://www.campbelldenver.org/"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">CAMPBELL CHAPEL AFRICAN METHODIST EPISCOPAL CHURCH - Home</span></a></td></tr><tr><td><strong>Mile High Behavioral Preservation Center</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">303-318-4242&nbsp;</span></td><td><a href="https://www.milehighbehavioralhealthcare.org/family-preservation-center"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">https://www.milehighbehavioralhealthcare.org/family-preservation-center</span></a></td></tr><tr><td><strong>We Don't Waste Mobile Meal Markets</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">720-443-6113&nbsp;</span></td><td><a href="https://www.wedontwaste.org/"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">We Don't Waste - Saving Food • Protecting the Planet • Feeding People</span></a></td></tr></tbody></table><p><strong>Housing</strong></p><table class="table"><tbody><tr><td>Agency Name</td><td>Contact Information</td><td>Link</td></tr><tr><td><strong>Colorado Housing Connects</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">303-202-6340&nbsp;</span></td><td><a href="https://coloradohousingconnects.org/"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">https://coloradohousingconnects.org/</span></a></td></tr><tr><td><strong>Delores Project</strong></td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">303-534-5411&nbsp;</span></td><td><a href="https://thedeloresproject.org/"><span>https://thedeloresproject.org/</span></a></td></tr></tbody></table><p><strong>Transportation</strong></p><table class="table"><tbody><tr><td>Agency Name</td><td>Contact Information</td><td>Link</td></tr><tr><td>Bikes Together</td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">720-403-8757&nbsp;</span></td><td><a href="https://www.bikestogether.org/shop"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">GET A BIKE | Bikes Together</span></a><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">&nbsp;</span></td></tr><tr><td>RTD-Zero Fare for Youth</td><td><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">303-299-2668&nbsp;</span></td><td><a href="https://www.rtd-denver.com/zero-fare-for-youth"><span style="color:black;font-family:&quot;Aptos&quot;,sans-serif;font-size:12.0pt;">Zero Fare for Youth | RTD-Denver</span></a></td></tr></tbody></table><h6>&nbsp;</h6><h6>&nbsp;</h6><h4><strong>Resource Search Engines</strong></h4><p><a href="https://www.denvergov.org/Government/Agencies-Departments-Offices/Agencies-Departments-Offices-Directory/Denver-Human-Services">Denver Human Services (DHS)</a></p><p><a href="https://denvercasa.org/">Denver CASA (Court Appointed Special Advocate)</a></p><p><a href="https://denverchafee.org/">Denver Chafee - Foster Care Independence Program</a></p><p><a href="https://roseandomcenter.org/">Rose Andom Center - Domestic Violence or Sexual Assault Resource</a>&nbsp;</p><p><a href="https://remerg.com/">Re-entry Resource&nbsp;</a></p><p><a href="https://www.211colorado.org/">2-1-1: Connection to Resources Across the State</a></p><p><a href="https://peak.my.site.com/peak/s/peak-landing-page?language=en_US">Colorado Peak - Benefits</a></p><p><a href="https://www.988colorado.com/en">988 - Colorado Mental Health Line</a></p><p><a href="https://dcs.colorado.gov/acp">Address Confidentiality Program</a></p><p>&nbsp;</p></div>
      </div>

