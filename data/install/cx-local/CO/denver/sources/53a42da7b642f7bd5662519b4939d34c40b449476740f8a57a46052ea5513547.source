slate-y-1/2 w-4 h-4  pointer-events-none"><span class="w-full h-full block border-4 border-white border-b-transparent border-r-transparent rounded-full transition animate-spin opacity-0"></span></span></button><button class="rounded-md border inline-flex items-center justify-start gap-2 relative [&amp;&gt;span&gt;span]:border-b-transparent [&amp;&gt;span&gt;span]:border-r-transparent transition-all bg-white border-gray-300 text-gray-800 hover:bg-gray-50 hover:text-gray-800 focus:text-gray-800 focus:shadow-focused-xs [&amp;&gt;svg]:text-gray-800 p-2" type="button" data-busy="false" aria-label="Open search bar"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"></path></svg><span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4  pointer-events-none"><span class="w-full h-full block border-4 border-white border-b-transparent border-r-transparent rounded-full transition animate-spin opacity-0"></span></span></button></div></section></div></nav></header><!--/$--><div class="xl:pt-[129px]"><nav class="bg-gray-50 xl:fixed z-20 w-full border-b border-b-gray-100" aria-label="Breadcrumb"><ol class="page-gutter-max grid grid-flow-col-dense grid-rows-1 place-content-start py-3 text-body-xs lg:text-body-sm tracking-normal leading-none gap-2"><li class="flex items-start self-center"><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red" href="/" aria-label="RTD "><span class="inline-block md:hidden">...</span><span class="hidden md:inline-block">RTD </span></a></li><li class="hidden items-start gap-2 truncate [&amp;:nth-last-of-type(1)]:flex [&amp;:nth-last-of-type(2)]:flex sm:[&amp;:nth-last-of-type(3)]:flex md:[&amp;:nth-last-of-type(4)]:flex lg:flex"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="text-gray-500 w-5 h-5 shrink-0"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"></path></svg><a class="gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-start self-center font-bold line-clamp-1 truncate block" href="/about-rtd" aria-label="About RTD">About RTD</a></li><li class="hidden items-start gap-2 truncate [&amp;:nth-last-of-type(1)]:flex [&amp;:nth-last-of-type(2)]:flex sm:[&amp;:nth-last-of-type(3)]:flex md:[&amp;:nth-last-of-type(4)]:flex lg:flex"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="text-gray-500 w-5 h-5 shrink-0"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"></path></svg><a class="gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-start self-center line-clamp-1 truncate block font-normal" href="/about-rtd/board-of-directors" aria-label="Board of Directors" aria-current="page">Board of Directors</a></li></ol></nav><div class="xl:pt-[45px]"><main><div class="py-12 lg:py-24 relative bg-red min-h-[228px] md:min-h-[300px] lg:min-h-[386px]"><picture><img alt="Photo of passengers boarding the Flatiron Flyer" src="https://cdn.rtd-denver.com/image/upload/v1697580200/Website_Banners_2880x1234_S0A0750_bus_jxbitk.jpg" class="absolute inset-0 w-full h-full object-cover" srcSet="https://cdn.rtd-denver.com/image/upload/t_hero_sm/v1697580200/Website_Banners_2880x1234_S0A0750_bus_jxbitk.jpg 570w,https://cdn.rtd-denver.com/image/upload/t_hero_md/v1697580200/Website_Banners_2880x1234_S0A0750_bus_jxbitk.jpg 768w,https://cdn.rtd-denver.com/image/upload/t_hero_lg/v1697580200/Website_Banners_2880x1234_S0A0750_bus_jxbitk.jpg 1140w,https://cdn.rtd-denver.com/image/upload/t_hero_xl/v1697580200/Website_Banners_2880x1234_S0A0750_bus_jxbitk.jpg 1600w,https://cdn.rtd-denver.com/image/upload/t_hero_xxl/v1697580200/Website_Banners_2880x1234_S0A0750_bus_jxbitk.jpg 2880w"/></picture><div class="page-gutter-max"><div class="flex flex-col gap-6 lg:gap-8 relative z-10  max-w-2xl"></div><div class="absolute w-full h-full top-0 right-0 z-0"></div></div></div><div class="page-gutter space-y-16 py-16"><section class="flex flex-col lg:flex-row lg:space-x-8 space-y-8"><div class="space-y-8 basis-2/3"><div><div class="h-1.5 w-16 bg-red"></div><h1 class="text-heading-xl lg:text-heading-3xl font-bold py-4 text-gray-800">Board of Directors</h1></div><a class="font-bold rounded-md border inline-flex items-center justify-start gap-2 relative [&amp;&gt;span&gt;span]:border-b-transparent [&amp;&gt;span&gt;span]:border-r-transparent transition-all px-4.5 py-2.5 bg-red border-red text-white hover:bg-red-800 hover:border-red-700 hover:text-white focus:text-white focus:shadow-focused-xs [&amp;&gt;svg]:text-white" href="https://rtd.iqm2.com/Citizens/Default.aspx" target="_blank" rel="noopener noreferrer"><span>Meeting Agendas</span></a><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Contact information for individual Directors is listed below. If you are unsure as to the Director District in which you reside, feel free to access the <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://rtd-denver.maps.arcgis.com/apps/webappviewer/index.html?id=e6aa4fe07b284f98bd164faad0c472be" target="_blank" rel="noopener noreferrer">Board of Directors District Map</a> or use the “Look Up Your RTD District” tool on this page.</p><p class="text-body first:mt-0">If you would like to provide public comment and/or general feedback to the Board as a whole, you may reach all Directors at <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="/cdn-cgi/l/email-protection#693b3d2d472d001b0c0a1d061b1a291b1d0d440d0c071f0c1b470a0604" target="_blank" rel="noopener noreferrer"><span class="__cf_email__" data-cfemail="055751412b416c776066716a7776457771612861606b7360772b666a68">[email&#160;protected]</span></a>.</p><p class="text-body first:mt-0"><strong>For remote meeting access and dial-in information</strong> refer to the Board Meeting Agenda for the specific meeting date located in the RTD Board Resources <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://rtd.iqm2.com/Citizens/Default.aspx" target="_blank" rel="noopener noreferrer"><strong>Meeting Agendas</strong></a>.</p><p class="text-body first:mt-0"><strong>Accessibility services including translation, interpretation, and assistive listening devices are available for all meetings of the RTD Board of Directors.</strong> By default, each RTD Board and Committee meeting offers Communication Access Realtime Translation (CART); likewise, the CART transcript can be automatically translated into Spanish. To access a CART link for a RTD Board of Directors meeting, please contact the RTD Board Office at <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="/cdn-cgi/l/email-protection#94e6e0f0baf6fbf5e6f0fbf2f2fdf7f1d4e6e0f0b9f0f1fae2f1e6baf7fbf9" target="_blank" rel="noopener noreferrer"><span class="__cf_email__" data-cfemail="5d2f2939733f323c2f39323b3b343e381d2f2939703938332b382f733e3230">[email&#160;protected]</span></a>. <strong>Additional accessibility services and resources including language interpretation, sign-language interpretation, document translation, alternative formatting for documents, and assistive listening devices are available upon request.</strong> Please notify RTD of the communication assistance you require at least 48 business hours in advance of a meeting you wish to attend by calling the Executive Manager of the Office of the RTD Board of Directors at 303-299-2307 or emailing <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="/cdn-cgi/l/email-protection#661412024804090714020900000f0503261412024b0203081003144805090b" target="_blank" rel="noopener noreferrer"><span class="__cf_email__" data-cfemail="463432226824292734222920202f2523063432226b2223283023346825292b">[email&#160;protected]</span></a>.</p><p class="text-body first:mt-0">Interested in more information? Our Board Office page details our committees, upcoming meetings and provides additional resources. <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.rtd-denver.com/about-rtd/board-office"><strong>Click Here to see the Board Office page.</strong></a><br/><br/>–––––––</p><p class="text-body first:mt-0"><strong>NOTICE OF BUDGET<br/></strong>RTD&#x27;s FY 2026 adopted budget is available at <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.rtd-denver.com/budget">rtd-denver.com/budget</a>.</p></div><a class="font-bold rounded-md border inline-flex items-center justify-start gap-2 relative [&amp;&gt;span&gt;span]:border-b-transparent [&amp;&gt;span&gt;span]:border-r-transparent transition-all px-4.5 py-2.5 bg-white border-gray-300 text-gray-800 hover:bg-gray-50 hover:text-gray-800 focus:text-gray-800 focus:shadow-focused-xs [&amp;&gt;svg]:text-gray-800" href="#Resources"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="shrink-0 w-5 h-5"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0 7-7m-7 7-7-7"></path></svg><span>See All Resources</span></a></div><div class="basis-1/3"><div class="rounded-xl bg-gray-50 p-8 flex flex-col text-gray-800"><h2 class="text-heading font-bold mb-6">Look up your RTD district</h2><form class="flex flex-col gap-6" action="/api/district-lookup" method="get"><div class="flex flex-col gap-2 items-stretch"><label class="text-sm text-gray-700" for="Address">Address<!-- --> <span class="text-red">*</span></label><div class="flex flex-col justify-center relative"><input type="text" id="Address" class="w-full py-2.5 px-3.5 rounded-md transition-shadow disabled:bg-gray-50 font-normal focus:ring-transparent focus:shadow-focused-xs focus:border-gray-300 border-gray-300 focus:border-gray-300" placeholder="" required="" name="address" value=""/></div></div><button class="rounded-md border inline-flex items-center gap-2 relative [&amp;&gt;span&gt;span]:border-b-transparent [&amp;&gt;span&gt;span]:border-r-transparent transition-all px-4.5 py-2.5 bg-red border-red text-white hover:bg-red-800 hover:border-red-700 hover:text-white focus:text-white focus:shadow-focused-xs [&amp;&gt;svg]:text-white justify-center font-bold" type="submit" data-busy="false">Find your RTD District<span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4  pointer-events-none"><span class="w-full h-full block border-4 border-white border-b-transparent border-r-transparent rounded-full transition animate-spin opacity-0"></span></span></button></form></div></div></section><div class="p-5 rounded-lg border flex justify-between gap-4 bg-blue-50 border-blue-100 text-blue"><div class="h-fit flex gap-2"><div><p class="text-heading-2xs font-bold">Questions, Comments, or Complaints</p><div class="[&amp;&gt;*]:my-4 [&amp;&gt;.text-body]:m-0"><p class="text-body first:mt-0">If you have a question, comment, or complaint about your experience using RTD we ask that you contact <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.rtd-denver.com/customer-comments"><strong>Customer Care</strong></a>. To speak with a Customer Care Representative immediately Monday-Friday from 6 a.m.-8 p.m., or weekends/holidays from 9 a.m.-6 p.m., please call <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="tel:+13032996000" target="_blank" rel="noopener noreferrer"><strong>303-299-6000</strong></a>. We also welcome your feedback through our <a class="font-bold gap-2 transition-all [&amp;&gt;svg]:text-red inline-flex text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.rtd-denver.com/customer-comments"><strong>Customer Care comment form</strong></a>.</p><p class="text-body first:mt-0">If your concern cannot be addressed by Customer Care, please know that incidents reviewed by our Board of Directors may take up to 14 days to process.</p></div></div></div></div><!--$?--><template id="B:2"></template><div class="bg-gray-50 p-8 rounded-xl"><div class="flex"><div class="relative w-full lg:w-auto"><label class="text-gray-700 text-sm" for="District">District</label><button type="button" role="combobox" aria-controls="radix-_R_jkluiv5uanivb_" aria-expanded="false" aria-autocomplete="none" dir="ltr" data-state="closed" class="flex gap-3.5 w-full justify-between items-center px-3.5 py-2.5 rounded-lg bg-white border border-gray-300 text-gray-900 appearance-none text-ellipsis focus:border-gray-600 focus:outline-none mt-1.5 lg:justify-center lg:max-w-[280px]" aria-label="District"><span style="pointer-events:none"></span><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></span></button><select aria-hidden="true" tabindex="-1" name="District" style="position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;word-wrap:normal"></select></div></div></div><div class="sr-only" role="status" aria-live="polite">Showing District All Districts</div><ul class="pb-6"><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtA">District A</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931234/f909d507-4025-478f-ad5d-e95bb68dffe3.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District A Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702064/Nicholson_Web26_ap2vkl.jpg" alt="" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Nicholson</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Chris Nicholson</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:303-299-3325">303-299-3325</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#bffcd7cdd6cc91f1d6dcd7d0d3ccd0d1ffcdcbdb92dbdad1c9dacd91dcd0d2" target="_blank" rel="noopener noreferrer">Email Director Nicholson</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Executive Committee (Secretary)</li><li class="list-disc">Performance Committee (Vice Chair)</li><li class="list-disc">Operations, Safety, and Security Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.metromayors.org/89/About-MMC" target="_blank" rel="noopener noreferrer">Metro Mayors Caucus Liason</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2028</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Chris Nicholson</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Chris Nicholson was elected to the RTD Board of Directors in November 2024 and represents District A, comprising the neighborhoods of Central Denver south of Colfax Ave, Capitol Hill, Upper Downtown, and the city of Glendale. </p><p class="text-body first:mt-0">Chris is a proud urbanist and a dedicated full-time transit rider who has relied on RTD since moving to Colorado in 2017.</p><p class="text-body first:mt-0">Professionally, Chris has built a career in public policy, technology, and professional politics. He co-founded Global EIR, where he helped craft policy solutions for immigrant entrepreneurs navigating the U.S. immigration system. In addition, Chris has spent twenty years serving as technical consultant, campaign manager and political advisor to state and local elected officials.</p><p class="text-body first:mt-0">Chris is active in LGBT and Jewish life, and advocates for increased housing production in his spare time as a leader of YIMBY Denver. He holds a Bachelor of Arts degree in Political Science from the University of Southern California.</p><p class="text-body first:mt-0">Outside of work Chris can often be found walking along the 16th Street Mall—his neighborhood since moving to Denver—heading to a great downtown restaurant, a Broadway show at DCPA, or grabbing a beer with friends. If you see him, please say hello!</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtB">District B</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931243/195d7342-c6a5-4485-a94f-24988586d414.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District B Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1698851625/Ruscha_zaato7.jpg" alt="Photo of Director JoyAnn Ruscha" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Ruscha</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">JoyAnn Ruscha</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-919-0476">720-919-0476</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#1b7174627a757535696e6878737a5b696f7f367f7e756d7e6935787476" target="_blank" rel="noopener noreferrer">Email Director Ruscha</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Finance and Planning Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.metromayors.org/89/About-MMC" target="_blank" rel="noopener noreferrer">Metro Mayors Caucus Liason (Alternate)</a></li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.e-470.com/about-us/" target="_blank" rel="noopener noreferrer">E-470 Public Highway Authority Board (Alternate)</a></li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.ac-rep.org/" target="_blank" rel="noopener noreferrer">Adams County Regional Economic Partnership (AC-REP) (Alternate)</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2026</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about JoyAnn Ruscha</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Director JoyAnn Ruscha (they/them) was elected to the Board in 2022 and represents District B, which spans the Denver neighborhoods of Park Hill, Central Park, Montbello, Green Valley Ranch, DIA, a portion of East Colfax, as well as north of Colfax in Aurora and parts of unincorporated Adams County.<br/><br/>Director Ruscha is public affairs and grants advisor specializing in disability, labor, and consumer protection rights, as well as transportation equity. JoyAnn is also a pro bono advisor to an international ecology NGO and has extensive board experience, having worked with several Colorado nonprofits and as a Governor Polis appointee to two commissions.<br/><br/>JoyAnn has a deep connection to District B schools—a former teacher, JoyAnn worked at the original Montbello High School in Denver and at a school for at-risk youth in Aurora. JoyAnn’s son, a longtime RTD rider, is a DPS graduate (and happily car-less).<br/><br/>In other roles, JoyAnn was a card-carrying member of SEIU Local 105 and Carpenters Local 555. In 2021, as a recognition of their demonstrated commitment to the rights of workers across the globe, JoyAnn was awarded an honorary lifetime membership by Steelworkers Local 3267.<br/><br/>In 2022, JoyAnn was honored with the Colorado Cross-Disability Coalition’s George Roberts &amp; Jeanette Klimach Foot Soldier of the Year Award, which is given to a person who goes above and beyond in fighting for the Americans with Disabilities Act. As director, JoyAnn remains inspired by the Gang of 19, a group of disabled ADAPT activists who protested RTD’s inaccessible system in 1978.<br/><br/>JoyAnn is an active member of the American Public Transportation Association (APTA) and Women in Transportation Seminar (WTS), focusing on safety, security, and risk management.<br/><br/>Director Ruscha lives in Denver with their best friend, Max—the most amazing rescue dog ever.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtC">District C</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931250/2a520001-d082-4c9e-b46e-60f55cc1a2c0.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District C Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702068/Guzman_Web26_gynrgy.jpg" alt="" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Guzman</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Michael Guzman</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-252-4961">720-252-4961</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#224f4b414a43474e0c4557584f434c625056460f46474c5447500c414d4f" target="_blank" rel="noopener noreferrer">Email Director Guzman</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Finance and Planning Committee</li><li class="list-disc">Performance Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee" target="_blank" rel="noopener noreferrer">DRCOG Regional Transportation Committee</a></li><li class="list-disc">Audit Committee (Chair)</li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2026</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Michael Guzman</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Proud to be the elected Director of District C on the RTD Denver, Michael brings a deep community understanding of regional transportation needs and a commitment to public service. A lifelong RTD rider and Denver native, representing Denver’s North-West community which he proudly calls home, growing up in the and around the Historic Baker Neighborhood and currently residing in Sunnyside, he served as Board Secretary in 2024 and currently chairs of both the Finance and Planning Committee and the Performance Committee, demonstrating a steady leadership in agency fiscal and operational oversight. He serves as an RTD member on the Regional Transportation Committee of DRCOG.</p><p class="text-body first:mt-0">Michael&#x27;s dedication to effective public transit is evident in key initiatives such as voting for Zero Fare for Youth, amending RTD&#x27;s &quot;Respect the Ride&quot;, Board Director On-boarding and Training policies.</p><p class="text-body first:mt-0">He continues to enhance his public transportation expertise through completing the DRCOG Civic Academy (2023), Latinos In Transit Leadership Academy (LITLA) Director Track (2024) while simultaneously earning The Harvard Kennedy School State and Local Leadership Certification as a Gates Family Foundation Fellow 2024. Attending courses through the National Transit Institute at Rutgers University, Michael has earned certifications in Public Engagement for Public Transit, Assault Awareness and Prevention for Transit Operators, as well as others, equipping Michael to address the complexities of transit operations, understand operational complexities, and functional methods of healthy community engagement. Drawing on more than two decades of retail customer service experience, he is adept at managing complex training, scheduling, human resource, and operational situations, always striving to &quot;leave it better than he found it&quot; for all Coloradans. Michael was conferred his B.A. in Spanish from St. John&#x27;s University in Collegeville, MN. He is fluent in English, Spanish, and Portuguese, with a strong competence in other Romance Languages, and is actively learning ASL.</p><p class="text-body first:mt-0">You can find him on the 19, 44, 52, A, or G lines most often! Heading to work, reading, or sometimes just out adventuring through the city with his beloved niece finding fun routes to cool places and events.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtD">District D</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931300/27beaf01-527d-4177-9d14-b3a59870f02a.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District D Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702070/Gutschenritter_Web26_jxti0o.jpg" alt="Photo of Director Chris Gutschenritter" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Gutschenritter</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Chris Gutschenritter</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-850-1194">720-850-1194</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#b7f4dfc5dec4c3d8c7dfd2c599f0c2c3c4d4dfd2d9c5dec3c3d2c5f7c5c3d39ad3d2d9c1d2c599d4d8da" target="_blank" rel="noopener noreferrer">Email Director Gutschenritter</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Executive Committee (Second Vice Chair)</li><li class="list-disc">Finance and Planning Committee</li><li class="list-disc">Performance Committee (Chair)</li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2028</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Chris Gutschenritter</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Chris is currently serving as the IT Director for a local healthcare company. Throughout his career he has gained extensive experience in human capital management consulting, working with renowned firms such as Deloitte and Accenture. His diverse background includes consulting for global fortune 100 companies as well as small private businesses. Notably, Chris has deep expertise in industries such as rail transportation (including Amtrak), healthcare, and retail.</p><p class="text-body first:mt-0">In November 2024, Chris was elected to the RTD Board of Directors (District D), where he represents Englewood, parts of South Denver, Littleton, and Jefferson County. His key priorities as a board member are to drive increased ridership, enhance the ridership experience (focusing on safety, cleanliness, and ease of use), and improve operational reliability.</p><p class="text-body first:mt-0">A proud Colorado resident since 2018, Chris lives in Englewood with his wife, Jessica, and their daughter. When traveling on RTD, you’ll often find Chris on the D, E, or A lines, or riding the 0 bus route.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtE">District E</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931313/7350f082-f40f-4012-a346-05e977a4e932.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District E Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1738362717/thumbnail_Larsen_eco5rh.jpg" alt="Photo of Director Larsen" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Larsen</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Matt Larsen</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-595-6325">720-595-6325</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#80cde1f4f4aecce1f2f3e5eec0f2f4e4ade4e5eef6e5f2aee3efed" target="_blank" rel="noopener noreferrer">Email Director Larsen</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Finance and Planning Committee</li><li class="list-disc">Performance Committee</li><li class="list-disc">Audit Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee" target="_blank" rel="noopener noreferrer">DRCOG Regional Transportation Committee</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2028</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Matt Larsen</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Director Larsen was elected to the RTD Board of Directors in November 2024 and took office in January 2025, representing District E, which includes parts of Aurora, Denver, Greenwood Village, and Centennial.</p><p class="text-body first:mt-0">Matt currently serves as Senior Director of Strategic Projects for a global medical device company. His diverse business career has included advising economic development agencies, consulting for Fortune 500 companies, and managing performance plans for sales teams.</p><p class="text-body first:mt-0">Matt is a lead with YIMBY Denver, a member of Greater Denver Transit, and serves on the board of the Denver Press Club. He lives in the Southmoor neighborhood of Denver with his wife and three children.</p><p class="text-body first:mt-0">Matt graduated from the University of Pennsylvania with a degree in English and in Urban Studies, and received an MBA from the Yale School of Management.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtF">District F</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931256/1314a827-a0af-4fe0-a461-326ef023d351.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District F Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702079/Chandler_Web26_kkffqn.jpg" alt="Photo of Director Kathleen Chandler" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Chandler</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Kathleen Chandler</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-940-4335">720-940-4335</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#da91bbaeb2b6bfbfb4f499b2bbb4beb6bfa89aa8aebef7bebfb4acbfa8f4b9b5b7" target="_blank" rel="noopener noreferrer">Email Director Chandler</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Operations, Safety, and Security Committee (Vice Chair)</li><li class="list-disc">Performance Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.e-470.com/about-us/" target="_blank" rel="noopener noreferrer">E-470 Public Highway Authority Board</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2028</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Kathleen Chandler</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Kathleen Chandler, a fourth-generation native of Colorado, proudly represents District F. As a resident of the Aurora/Centennial area since 1992, she has been actively involved in Arapahoe County.</p><p class="text-body first:mt-0">Kathleen’s primary goal is to ensure the safety and reliability of RTD. She believes that safety encompasses not only the well-maintained condition of the system but also the security of riders and drivers. Prioritizing the security of those who rely on RTD is crucial for the system’s overall health. Kathleen is a strong advocate for the para-transit and transit-dependent constituents, recognizing the importance of serving those who use the service daily. Ensuring RTD’s reliability and safety is essential to meet their needs effectively.</p><p class="text-body first:mt-0">Kathleen is deeply connected to Colorado and the western can-do spirit. As a community representative, she strives to include a diverse range of voices in her decision-making processes.</p><p class="text-body first:mt-0">Kathleen is married with two sons, two grandchildren, three chickens, and a cat. She is an avid gardener who enjoys canning vegetables during the summer months. In the winter, she relishes spending time in a hot tub while her husband enjoys skiing.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtG">District G</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931226/012d28e8-745d-4409-8b5e-6fbebbde0e6b.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District G Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702066/Bouquet_Web26_coravr.jpg" alt="Photo of Director Julien Bouquet" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Bouquet</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Julien Bouquet</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-892-7084">720-892-7084</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#b4fec1d8ddd1da9af6dbc1c5c1d1c0f4c6c0d099d0d1dac2d1c69ad7dbd9" target="_blank" rel="noopener noreferrer">Email Director Bouquet</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Operations, Safety, and Security Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee" target="_blank" rel="noopener noreferrer">DRCOG Regional Transportation Committee (Alternate)</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2028</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Julien Bouquet</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Director Bouquet was elected to the RTD Board in the 2020 general election on November 3rd. Director Bouquet was sworn in as Director on January 5, 2021. Director Bouquet represents RTD District G which includes most of Parker and Lone Tree and portions of Centennial, Aurora and Castle Rock.</p><p class="text-body first:mt-0">Director Bouquet is a full time middle school teacher for Douglas County School District. He teaches elective classes on media and broadcast production, as well as a class on photojournalism and electronic publishing. His classes have won multiple district and statewide student-media and student-journalism awards.</p><p class="text-body first:mt-0">He has grown up in Douglas County and has lived most of his life in the county. Director Bouquet is a frequent RTD rider, and was first introduced to RTD while attending the University of Denver. He used the E or F line almost everyday in college. Director Bouquet graduated from the University of Denver in 2016 with a Bachelor of Arts in Political Science.</p><p class="text-body first:mt-0">Director Bouquet has been involved in several political campaigns since 2012. He has served as a non-paid volunteer, an organizer and a canvas manager. He is also a proud Eagle Scout and credits most of his civic engagement from his time in the scouts.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtH">District H</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931262/9660a148-6a1a-4359-930d-4c3c9ff1473c.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District H Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702063/OKeefe_Web26_f0sm9w.jpg" alt="Photo of Director Patrick O’Keefe" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director O’Keefe</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Patrick O’Keefe</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-940-4324">720-940-4324</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#42122336302b21296c0d64613a7075792927272427023036266f26272c3427306c212d2f" target="_blank" rel="noopener noreferrer">Email Director O’Keefe</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Executive Committee (Chair)</li><li class="list-disc">Performance Committee</li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2028</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Patrick O’Keefe</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Patrick has spent his career working at the cross section of infrastructure development and public policy. Starting his career on Capitol Hill working for Colorado Congressman Dan Schaefer on a wide range of issues, he learned the importance of thoughtful collaboration and principled stands on the most important issues.</p><p class="text-body first:mt-0">He transitioned to practical implementation of policy ideas working in the private sector. As a senior executive for a Colorado-based Fortune 500 engineering company, he was able to work with teams delivering some of the most iconic and challenging infrastructure in the world…and right here in Colorado. In 2020, he started a growing small business focused on infrastructure advisory services helping clients build projects on-schedule and within budget to solve the needs of a growing Front Range economy.</p><p class="text-body first:mt-0">Patrick and his wife Karen raised three children in Highlands Ranch, where they have lived for over two decades. He is active in the community serving on the board of a non-profit committed to food security. In his free time, he loves playing ice hockey, fly fishing, bumbling around a golf course and reading history.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtI">District I</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931319/dbb0b0f1-966a-4e64-9584-61deba9c3d04.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District I Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702075/Benker_Web26_fh5uce.jpg" alt="Photo of Director Karen Benker" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Benker</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Karen Benker</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-939-3115">720-939-3115</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#440f2536212a6a06212a2f2136043630206920212a3221366a272b29" target="_blank" rel="noopener noreferrer">Email Director Benker</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Executive Committee (Treasurer)</li><li class="list-disc">Finance and Planning Committee (Chair)</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee" target="_blank" rel="noopener noreferrer">DRCOG Regional Transportation Committee</a></li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.codot.gov/about/governmentrelations/local-government-liaison" target="_blank" rel="noopener noreferrer">CDOT Liason</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2028</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Karen Benker</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Karen previously served two terms on the RTD Board in the 1990s representing District M where she worked hard to build the SW rail line--now known as the D Line. She now serves District I which covers Longmont, Broomfield, Lafayette, and Erie.</p><p class="text-body first:mt-0">She loves reading government budgets because she worked many years in the Colorado Governor’s budget office and was the Budget Director for the Colorado Department of Labor and Employment. Prior to that she lived in Washington D.C. working for the National Association of State Budget Officers.</p><p class="text-body first:mt-0">Karen co-founded the Fort Morgan Humane Society and now serves on the Board writing grants and holding fundraising events. The small, but mighty, humane society on the Eastern Plains saves over 650 dogs and cats each year. She also is the owner of her small dog biscuit company – Furry Friends Biscuit Bakery.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtJ">District J</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931268/8a93e33a-c219-40df-8625-781f77e0aa78.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District J Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1787252540/Downing_Joyce_weebly_dglc7z.jpg" alt="" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Downing</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Joyce Downing</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-232-4402">720-232-4402</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#0b416472686e254f647c6562656c4b797f6f266f6e657d6e7925686466" target="_blank" rel="noopener noreferrer">Email Director Downing</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Operations, Safety, and Security Committee</li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2026</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Joyce Downing</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Director Joyce Downing was appointed on July 21st, 2026 and took office on July 28th 2026 to fill a vacancy left by former Director Vince Buzek representing District J which includes the cities of Westminster, Northglenn, Federal Heights, portions of western Thornton and portions of unincorporated Adams and Jefferson Counties.</p><p class="text-body first:mt-0">Joyce is the former Mayor of the City of Northglenn. She served several years as the Mayor Pro Tem and Council Member. She served as chair of both the North Area Transportation Alliance (NATA) and Smart Commute. She also served as a member of the Denver Regional Council of Governments (DRCOG)</p><p class="text-body first:mt-0">Joyce is married with 6 children and 15 grandchildren. She enjoys volunteering with the Northglenn Historic Commission, Northglenn Arts and Humanities Foundation and the Victim Assistance and Law Enforcement Board (VALE). She enjoys traveling in her spare time.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtK">District K</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931275/2083d186-b756-4595-89c5-aadc68ee8175.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District K Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1695931271/5534c3fe-da3b-46bd-a8f4-ba2436bdb23c.jpg" alt="Photo of Director Troy L. Whitmore" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Whitmore</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Troy L. Whitmore</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-614-7267">720-614-7267</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#f387819c8add849b9a879e9c8196b3818797de97969d859681dd909c9e" target="_blank" rel="noopener noreferrer">Email Director Whitmore</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Operations, Safety, and Security Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.ac-rep.org/" target="_blank" rel="noopener noreferrer">Adams County Regional Economic Partnership (AC-REP)</a></li><li class="list-disc">RTD Salaried Employee Pension Trust</li><li class="list-disc">RTD Salaried Employee Defined Contribution Plan Trust</li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2026</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Troy L. Whitmore</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Director Troy Whitmore was elected to the RTD Board of Directors in November 2018 and took office in January 2019, representing District K. District K is RTD’s most northeastern district which includes Brighton, Commerce City, much of Thornton and unincorporated Adams County.</p><p class="text-body first:mt-0">Troy Whitmore is an active community servant who has been a United Power employee for more than 30 years. In his current position as Public Affairs Officer, he oversees communications, marketing, key accounts, governmental affairs and community relations functions for the electric distribution cooperative based in Brighton, Colorado.</p><p class="text-body first:mt-0">A northeastern Colorado native, Troy is a 1983 graduate of Northeastern Junior College and a 1985 graduate of Colorado State University.</p><p class="text-body first:mt-0">A former Thornton City Council member, Troy remains very active in his community. He is past Chair of the Board of Directors of the MetroNorth Chamber of Commerce, past Chair and Board member of the Brighton Economic Development Corporation and past President and Board member of Almost Home, Inc. He serves as a Board Member for Smart Commute MetroNorth and Adams County Economic Development. He also chairs School District 27J’s Bond Advisory Committee and is Vice Chair of the Board of Energy Outreach Colorado (EOC) which is Colorado’s premier energy assistance foundation.</p><p class="text-body first:mt-0">The MetroNorth Chamber named him Business Person of the Year in 2011 and recognized him with the Chairman’s Award in 2016. He was awarded the Pathfinder Award by Northeastern Junior College in 2015. In 2017, Whitmore was honored by Pro 15 with the Alumni of the Plains recognition. Director Whitmore is committed to building a world-class transit system that effectively serves constituents in all socio-economic classes and prompts economic development throughout the RTD service area.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtL">District L</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931281/51c16f14-508e-44f3-87be-443c17219b38.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District L Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1738598919/thumbnail_Harwick_ut6xcb.jpg" alt="Photo of Director Harwick" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Harwick</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Ian Harwick</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-260-4515">720-260-4515</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#472e2629692f2635302e242c073533236a2322293122356924282a" target="_blank" rel="noopener noreferrer">Email Director Harwick</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Operations, Safety, and Security Committee (Chair)</li><li class="list-disc">Executive Committee (Vice Chair)</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee" target="_blank" rel="noopener noreferrer">DRCOG Regional Transportation Committee (Alternate)</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2026</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Ian Harwick</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Ian Harwick is a mostly native of Colorado, having spent his first 6 months in Ohio. He moved to Arvada in 1988 and has spent a good portion of his life there.</p><p class="text-body first:mt-0">He graduated with a degree in Business Management from Johnson &amp; Wales University, attending at their Providence campus, as well as their now-closed Denver campus.</p><p class="text-body first:mt-0">Ian joined RTD in January 2023 after a write-in campaign in 2022. He has been a staunch advocate for transit, cycling, walking, and adaptive mobility for the last 20 years.</p><p class="text-body first:mt-0">For his day job, Ian works for the City of Denver in the Office of Climate Action, Sustainability &amp; Resiliency. His prior work at the city included a small stint at DDPHE (during the start of the Covid pandemic) and then a longer stay at the Denver Office of the Medical Examiner. Prior to his time there he spent ten years running a small consulting business and has been highly involved in the Athmar Park Neighborhood Association, Denver’s YIMBY’s and New Leaders Council.</p><p class="text-body first:mt-0">He is now back in Arvada where he parents a feisty 6-year-old girl with his wife, Kristin. He spends his spare time fixing up his house, playing volleyball, and attempting to read more books.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtM">District M</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931288/a7099c9d-755e-413e-86ba-9bbaedd6852f.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District M Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1738362746/thumbnail_Paglieri_cgpwng.jpg" alt="Photo of Director Paglieri" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Paglieri</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Brett Paglieri</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-939-3074">720-939-3074</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#84c6f6e1f0f0aad4e5e3e8ede1f6edc4f6f0e0a9e0e1eaf2e1f6aae7ebe9" target="_blank" rel="noopener noreferrer">Email Director Paglieri</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Operations, Safety, and Security Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.jeffco.us/2855/JEFFTAAG-Jeffco-Forum" target="_blank" rel="noopener noreferrer">Jefferson County Transportation Advisory Group</a></li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee" target="_blank" rel="noopener noreferrer">DRCOG Regional Transportation Committee (Alternate)</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2028</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Brett Paglieri</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Director Paglieri is proud to represent areas of Lakewood, Golden, Edgewater, Wheat Ridge, Mountain View, Lakeside and beyond. He was elected in November 2024 and took office in January 2025.</p><p class="text-body first:mt-0">Brett is multimodal advocate, working closely with nonprofits and grass roots advocacy groups to improve the transit, biking, walking and rolling experience in JeffCo and throughout Denver. He uses his background in customer experience to focus on improving the rider experience and strongly supports creating a more welcoming transit environment for everyone.</p><p class="text-body first:mt-0">In addition to serving as a Director, he works full time in the tech industry as a Product Manager. He holds a Bachelor&#x27;s of Science in Computer Science from Regis University.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtN">District N</h3></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702077/Arcuri_Web26_y13zsu.jpg" alt="Photo of Director Cindy Arcuri" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Arcuri</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Cindy Arcuri</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-871-3412">720-871-3412</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#0d4e64636974234c7f6e787f644d7f7969206968637b687f236e6260" target="_blank" rel="noopener noreferrer">Email Director Arcuri</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Finance and Planning Committee (Vice Chair)</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.jeffco.us/2855/JEFFTAAG-Jeffco-Forum" target="_blank" rel="noopener noreferrer">Jefferson County Transportation Advisory Group</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2026</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Cindy Arcuri</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Cindy Arcuri was appointed by the Jefferson County Commissioners on a 2-0 vote with one absent after the position was vacated by former Board member Peggy Catlin. Arcuri&#x27;s appointment will last through the 2026 General Election and subsequent swearing in of a successor.</p></div></div></details></div></div></li><li class="text-gray-800"><div class="flex bg-gray-50 p-4 rounded font-bold justify-between"><h3 id="districtO">District O</h3><a class="font-bold flex gap-2 text-gray-700 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red items-center" href="https://cdn.rtd-denver.com/image/upload/v1695931294/89b3116b-0ae7-4554-b781-b77684092833.pdf" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22c4-4 8-7.582 8-12a8 8 0 1 0-16 0c0 4.418 4 8 8 12Z"></path></svg><p>District O Map</p></a></div><div class="flex py-8 md:space-x-8 flex-col md:flex-row"><div class="flex flex-col"><img src="https://cdn.rtd-denver.com/image/upload/t_default_headshot/f_auto,q_auto/v1769702073/Guissinger_Web26_crv1ub.jpg" alt="Photo of Director Lynn Guissinger" class="w-[166px] h-[166px] rounded"/><p class="max-w-[166px]">Photo of Director Guissinger</p></div><div class="flex-1 space-y-4"><p class="text-heading font-bold mb-4 mt-8 md:mt-0">Lynn Guissinger</p><div class="flex gap-8 justify-between flex-col md:flex-row"><div><p class="pb-2 text-base font-bold text-gray-800">Contact</p><address class="flex flex-col items-start gap-2 not-italic"><a href="tel:720-320-3058">720-320-3058</a><span class="flex gap-2 items-center"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 text-red"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m2 7 8.165 5.715c.661.463.992.695 1.351.784a2 2 0 0 0 .968 0c.36-.09.69-.32 1.351-.784L22 7M6.8 20h10.4c1.68 0 2.52 0 3.162-.327a3 3 0 0 0 1.311-1.311C22 17.72 22 16.88 22 15.2V8.8c0-1.68 0-2.52-.327-3.162a3 3 0 0 0-1.311-1.311C19.72 4 18.88 4 17.2 4H6.8c-1.68 0-2.52 0-3.162.327a3 3 0 0 0-1.311 1.311C2 6.28 2 7.12 2 8.8v6.4c0 1.68 0 2.52.327 3.162a3 3 0 0 0 1.311 1.311C4.28 20 5.12 20 6.8 20Z"></path></svg><a class="font-bold flex gap-2 hover:text-red focus:text-red transition-all [&amp;&gt;svg]:text-red border-gray-700 hover:border-red text-gray-800" href="/cdn-cgi/l/email-protection#a7cbdec9c989c0d2ced4d4cec9c0c2d5e7d5d3c38ac3c2c9d1c2d589c4c8ca" target="_blank" rel="noopener noreferrer">Email Director Guissinger</a></span></address></div><div class="space-y-1"><p class="text-base font-bold text-gray-800">Committee and Liaison Assignments</p><ul class="pl-5"><li class="list-disc">Finance and Planning Committee</li><li class="list-disc">Performance Committee</li><li class="list-disc"><a class="font-bold flex gap-2 transition-all [&amp;&gt;svg]:text-red text-blue-700 hover:text-blue-500 focus:text-blue-500 underline" href="https://www.codot.gov/about/governmentrelations/local-government-liaison" target="_blank" rel="noopener noreferrer">CDOT Liason (Alternate)</a></li></ul></div><div class="space-y-1 md:text-right"><p class="text-base font-bold text-gray-800">Term Ends</p>December 31, 2026</div></div><details class="group w-fit text-gray-700 hover:[&amp;&gt;summary]:text-red [&amp;&gt;summary&gt;svg]:text-red [&amp;&gt;summary&gt;svg]:left-0 [&amp;&gt;summary&gt;p]:ml-8 [&amp;&gt;summary&gt;p]:max-w-none [&amp;&gt;summary]:hover:bg-transparent [&amp;&gt;summary]:pl-0"><summary class="flex p-4 list-none relative text-base font-semibold cursor-default transition-all duration-1000 group-open:mb-4 border border-transparent hover:bg-gray-100"><p class="max-w-[80%]">Read more about Lynn Guissinger</p><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="absolute w-6 h-6 right-4 top-1/2 -translate-y-1/2 transition group-open:rotate-180"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg></summary><div class="p-4 pt-0"><div class="[&amp;&gt;*]:my-4"><p class="text-body first:mt-0">Director Lynn Guissinger was elected to the RTD Board of Directors in November 2018 and took office in January, 2019 representing District O. District O represents the most northwestern portion of the RTD area including all of the City of Boulder, Jamestown, Louisville, Lyons, Nederland, and Ward, the portion of Longmont west of North 95th St. and south of Mountain View Ave., all of Superior within Boulder County, and the majority of unincorporated Boulder County, generally lying west of North 95th St.</p><p class="text-body first:mt-0">Director Guissinger is a small business owner and former attorney with broad experience in managing a business, and in financial analysis and creative fundraising.</p><p class="text-body first:mt-0">Guissinger’s business, Catalyst Communication, partnered with city transportation departments around the country (including Seattle, Cambridge, Denver, Boulder, Tucson, Anchorage, and others) to market and promote their transit, biking, and walking options. Catalyst Communication worked for years in the bicycle and outdoor industries, and Guissinger has worked with advocacy efforts in these areas.</p><p class="text-body first:mt-0">Guissinger graduated from CU Law School, and practiced law for a number of years. She clerked on the United States Court of Appeals for the Tenth Circuit. After practicing law at Holland &amp; Hart, Guissinger taught Land Use Planning and Local Government Law at CU Law School.</p><p class="text-body first:mt-0">Civic and community activities include:</p><ul class="list-[revert] p-[revert]"><li>City of Boulder Transportation Advisory Board (chair), 2005-2009</li><li>Chair, Successful campaign for 2M and 2N, the Community Culture and Safety tax, 2017</li><li>Commuting Solutions board</li><li>Boulder Housing Partners Foundation board, president</li><li>Colorado Fourteeners Initiative board</li><li>Senior Fellow, Getches Wilkinson Center for Natural Resources and Environment, CU Law School, current</li><li>Community Cycles Capital Campaign</li><li>Focus Reentry, treasurer</li><li>Emergency Family Assistance Foundation, past president, 1990s</li><li>Intercambio Uniting Communities, past member 2009-2011</li><li>City of Boulder Greenways Advisory Committee, 2007-2009</li><li>Democratic Women of Boulder County, past president</li></ul><p class="text-body first:mt-0">Director Guissinger is passionate about helping build strong communities through transportation options that work for people’s lives. She is excited to represent much of Boulder County and the Northwest Corridor on the RTD board.</p></div></div></details></div></div></li></ul><!--/$--></div><div class="bg-gray-50 py-12"><div class="page-gutter-max my-8"><div id="Resources"><h3 class="text-heading font-bold text-gray-800 mb-4">Resources</h3><ol class="flex gap-8 flex-wrap"><li class="w-fit"><a class="font-bold inline-flex items-center justify-start gap-2 relative [&amp;&gt;span&gt;span]:border-b-transparent [&amp;&gt;span&gt;span]:border-r-transparent transition-all hover:bg-gray-50 hover:text-gray-800 focus:text-gray-800 focus:shadow-focused-xs bg-white w-full text-gray-800 p-4 rounded-xl bor