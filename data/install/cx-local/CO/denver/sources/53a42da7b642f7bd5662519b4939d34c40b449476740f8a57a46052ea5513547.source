ax\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 lg:gap-8 relative z-10  max-w-2xl\",\"children\":[null,\"$undefined\",\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"absolute w-full h-full top-0 right-0 z-0\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"page-gutter space-y-16 py-16\",\"children\":[[\"$\",\"section\",null,{\"className\":\"flex flex-col lg:flex-row lg:space-x-8 space-y-8\",\"children\":[[\"$\",\"$L21\",null,{\"showCta\":true,\"title\":\"Board of Directors\",\"subtitle\":null,\"headerButton\":{\"text\":\"Meeting Agendas\",\"to\":{\"_id\":\"e97033d5-5dec-4405-900f-d4756db6ff48\",\"_type\":\"externalRoute\",\"title\":\"Board Office Website\",\"url\":\"https://rtd.iqm2.com/Citizens/Default.aspx\"},\"displayType\":\"button\",\"mediaLink\":null,\"size\":\"md\",\"variant\":\"primary\",\"showIcon\":\"$undefined\",\"iconOptions\":\"$undefined\"},\"description\":[{\"_type\":\"block\",\"_key\":\"6bdc9f153872\",\"children\":[{\"_key\":\"0ee4c66916a8\",\"_type\":\"span\",\"text\":\"Contact information for individual Directors is listed below. If you are unsure as to the Director District in which you reside, feel free to access the \",\"marks\":[]},{\"_key\":\"e38ad77a1ca3\",\"_type\":\"span\",\"text\":\"Board of Directors District Map\",\"marks\":[\"8dce9cbb8e59\"]},{\"_key\":\"3a2c19c3d806\",\"_type\":\"span\",\"text\":\" or use the “Look Up Your RTD District” tool on this page.\",\"marks\":[]}],\"markDefs\":[{\"_type\":\"link\",\"_key\":\"8dce9cbb8e59\",\"href\":\"https://rtd-denver.maps.arcgis.com/apps/webappviewer/index.html?id=e6aa4fe07b284f98bd164faad0c472be\"}],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"715476116448\",\"children\":[{\"_key\":\"997eef92c3360\",\"_type\":\"span\",\"text\":\"If you would like to provide public comment and/or general feedback to the Board as a whole, you may reach all Directors at \",\"marks\":[]},{\"_key\":\"997eef92c3361\",\"_type\":\"span\",\"text\":\"RTD.Directors@rtd-denver.com\",\"marks\":[\"50635f963af6\"]},{\"_key\":\"997eef92c3362\",\"_type\":\"span\",\"text\":\".\",\"marks\":[]}],\"markDefs\":[{\"_type\":\"link\",\"_key\":\"50635f963af6\",\"href\":\"mailto:RTD.Directors@rtd-denver.com\"}],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"71a197cc9f94\",\"children\":[{\"_key\":\"55800d2639730\",\"_type\":\"span\",\"text\":\"For remote meeting access and dial-in information\",\"marks\":[\"strong\"]},{\"_key\":\"cbbebb5e47b8\",\"_type\":\"span\",\"text\":\" refer to the Board Meeting Agenda for the specific meeting date located in the RTD Board Resources \",\"marks\":[]},{\"_key\":\"a3673292d25a\",\"_type\":\"span\",\"text\":\"Meeting Agendas\",\"marks\":[\"strong\",\"6f09c2fe7236\"]},{\"_key\":\"a14b23fcd509\",\"_type\":\"span\",\"text\":\".\",\"marks\":[]}],\"markDefs\":[{\"_type\":\"link\",\"_key\":\"6f09c2fe7236\",\"href\":\"https://rtd.iqm2.com/Citizens/Default.aspx\"}],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"5f07d1b6d0b7\",\"children\":[{\"_key\":\"1e53fbd2f7720\",\"_type\":\"span\",\"text\":\"Accessibility services including translation, interpretation, and assistive listening devices are available for all meetings of the RTD Board of Directors.\",\"marks\":[\"strong\"]},{\"_key\":\"1e53fbd2f7721\",\"_type\":\"span\",\"text\":\" By default, each RTD Board and Committee meeting offers Communication Access Realtime Translation (CART); likewise, the CART transcript can be automatically translated into Spanish. To access a CART link for a RTD Board of Directors meeting, please contact the RTD Board Office at \",\"marks\":[]},{\"_key\":\"c8d1a2fae4eb\",\"_type\":\"span\",\"text\":\"rtd.boardoffice@rtd-denver.com\",\"marks\":[\"2051d236e11e\"]},{\"_key\":\"029ea2f55ebb\",\"_type\":\"span\",\"text\":\". \",\"marks\":[]},{\"_key\":\"1e53fbd2f7724\",\"_type\":\"span\",\"text\":\"Additional accessibility services and resources including language interpretation, sign-language interpretation, document translation, alternative formatting for documents, and assistive listening devices are available upon request.\",\"marks\":[\"strong\"]},{\"_key\":\"1e53fbd2f7725\",\"_type\":\"span\",\"text\":\" Please notify RTD of the communication assistance you require at least 48 business hours in advance of a meeting you wish to attend by calling the Executive Manager of the Office of the RTD Board of Directors at 303-299-2307 or emailing \",\"marks\":[]},{\"_key\":\"1e53fbd2f7726\",\"_type\":\"span\",\"text\":\"rtd.boardoffice@rtd-denver.com\",\"marks\":[\"8a1ccea43570\"]},{\"_key\":\"1e53fbd2f7727\",\"_type\":\"span\",\"text\":\".\",\"marks\":[]}],\"markDefs\":[{\"_type\":\"link\",\"_key\":\"8a1ccea43570\",\"href\":\"mailto:rtd.boardoffice@rtd-denver.com\"},{\"_type\":\"link\",\"_key\":\"2051d236e11e\",\"href\":\"mailto:rtd.boardoffice@rtd-denver.com\"}],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"d5b1797fcc5c\",\"children\":[{\"_key\":\"ac725a2b8d72\",\"_type\":\"span\",\"text\":\"Interested in more information? Our Board Office page details our committees, upcoming meetings and provides additional resources. \",\"marks\":[]},{\"_key\":\"600f5bae87c4\",\"_type\":\"span\",\"text\":\"Click Here to see the Board Office page.\",\"marks\":[\"9c19901d3eba\",\"strong\"]},{\"_key\":\"bc9a8c95511c\",\"_type\":\"span\",\"text\":\"\\n\\n–––––––\",\"marks\":[]}],\"markDefs\":[{\"_type\":\"link\",\"_key\":\"9c19901d3eba\",\"href\":\"https://www.rtd-denver.com/about-rtd/board-office\"}],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"4cb5a75ef443\",\"children\":[{\"_key\":\"804a83b98aa1\",\"_type\":\"span\",\"text\":\"NOTICE OF BUDGET\\n\",\"marks\":[\"strong\"]},{\"_key\":\"d83e158b304f\",\"_type\":\"span\",\"text\":\"RTD's FY 2026 adopted budget is available at \",\"marks\":[]},{\"_key\":\"0ad7c7ab714a\",\"_type\":\"span\",\"text\":\"rtd-denver.com/budget\",\"marks\":[\"fb28dd01ffe1\"]},{\"_key\":\"f3c5227a93cc\",\"_type\":\"span\",\"text\":\".\",\"marks\":[]}],\"markDefs\":[{\"_type\":\"link\",\"_key\":\"fb28dd01ffe1\",\"href\":\"https://www.rtd-denver.com/budget\"}],\"style\":\"normal\"}]}],\"$L22\"]}],\"$L23\",\"$L24\"]}],\"$undefined\",\"$L25\"]}]}]\n"])</script><script>self.__next_f.push([1,"26:I[99591,[\"9576\",\"static/chunks/9576-9c7033f1c33d392f.js\",\"7181\",\"static/chunks/7181-b84e97a4f8f19fdb.js\",\"6215\",\"static/chunks/6215-1e5ce9664fd53db5.js\",\"6966\",\"static/chunks/6966-a0e471e0e2934c5e.js\",\"7148\",\"static/chunks/7148-aa2b7ade8875d6d8.js\",\"8321\",\"static/chunks/app/%5Blang%5D/about-rtd/board-of-directors/page-f78e32e1289cbb39.js\"],\"DistrictLookupForm\"]\n27:I[87006,[\"9576\",\"static/chunks/9576-9c7033f1c33d392f.js\",\"7181\",\"static/chunks/7181-b84e97a4f8f19fdb.js\",\"6215\",\"static/chunks/6215-1e5ce9664fd53db5.js\",\"6966\",\"static/chunks/6966-a0e471e0e2934c5e.js\",\"7148\",\"static/chunks/7148-aa2b7ade8875d6d8.js\",\"8321\",\"static/chunks/app/%5Blang%5D/about-rtd/board-of-directors/page-f78e32e1289cbb39.js\"],\"BoardMemberPageCallout\"]\n28:I[56538,[\"9576\",\"static/chunks/9576-9c7033f1c33d392f.js\",\"7181\",\"static/chunks/7181-b84e97a4f8f19fdb.js\",\"6215\",\"static/chunks/6215-1e5ce9664fd53db5.js\",\"6966\",\"static/chunks/6966-a0e471e0e2934c5e.js\",\"7148\",\"static/chunks/7148-aa2b7ade8875d6d8.js\",\"8321\",\"static/chunks/app/%5Blang%5D/about-rtd/board-of-directors/page-f78e32e1289cbb39.js\"],\"BoardMembersList\"]\n2b:I[5626,[\"9576\",\"static/chunks/9576-9c7033f1c33d392f.js\",\"7181\",\"static/chunks/7181-b84e97a4f8f19fdb.js\",\"6215\",\"static/chunks/6215-1e5ce9664fd53db5.js\",\"6966\",\"static/chunks/6966-a0e471e0e2934c5e.js\",\"7148\",\"static/chunks/7148-aa2b7ade8875d6d8.js\",\"8321\",\"static/chunks/app/%5Blang%5D/about-rtd/board-of-directors/page-f78e32e1289cbb39.js\"],\"CallToAction\"]\n22:[\"$\",\"div\",null,{\"className\":\"basis-1/3\",\"children\":[\"$\",\"$L26\",null,{}]}]\n"])</script><script>self.__next_f.push([1,"23:[\"$\",\"$L27\",null,{\"heading\":\"Questions, Comments, or Complaints\",\"content\":[{\"_type\":\"block\",\"_key\":\"18e02bbb9624\",\"children\":[{\"_key\":\"83e59a8311040\",\"_type\":\"span\",\"text\":\"If you have a question, comment, or complaint about your experience using RTD we ask that you contact \",\"marks\":[]},{\"_key\":\"83e59a8311041\",\"_type\":\"span\",\"text\":\"Customer Care\",\"marks\":[\"594a9bc94123\",\"strong\"]},{\"_key\":\"83e59a8311042\",\"_type\":\"span\",\"text\":\". To speak with a Customer Care Representative immediately Monday-Friday from 6 a.m.-8 p.m., or weekends/holidays from 9 a.m.-6 p.m., please call \",\"marks\":[]},{\"_key\":\"d5a3cbe5f7f2\",\"_type\":\"span\",\"text\":\"303-299-6000\",\"marks\":[\"strong\",\"28ba6c0a10d9\"]},{\"_key\":\"776e634fb643\",\"_type\":\"span\",\"text\":\". We also welcome your feedback through our \",\"marks\":[]},{\"_key\":\"83e59a8311043\",\"_type\":\"span\",\"text\":\"Customer Care comment form\",\"marks\":[\"01cec1d6176c\",\"strong\"]},{\"_key\":\"83e59a8311044\",\"_type\":\"span\",\"text\":\".\",\"marks\":[]}],\"markDefs\":[{\"_type\":\"link\",\"_key\":\"594a9bc94123\",\"href\":\"https://www.rtd-denver.com/customer-comments\"},{\"_type\":\"link\",\"_key\":\"01cec1d6176c\",\"href\":\"https://www.rtd-denver.com/customer-comments\"},{\"_type\":\"link\",\"_key\":\"28ba6c0a10d9\",\"href\":\"tel:+13032996000\"}],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"9296dcfc377e\",\"children\":[{\"_key\":\"4a320504b14a0\",\"_type\":\"span\",\"text\":\"If your concern cannot be addressed by Customer Care, please know that incidents reviewed by our Board of Directors may take up to 14 days to process.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"29:T746,"])</script><script>self.__next_f.push([1,"Director JoyAnn Ruscha (they/them) was elected to the Board in 2022 and represents District B, which spans the Denver neighborhoods of Park Hill, Central Park, Montbello, Green Valley Ranch, DIA, a portion of East Colfax, as well as north of Colfax in Aurora and parts of unincorporated Adams County.\n\nDirector Ruscha is public affairs and grants advisor specializing in disability, labor, and consumer protection rights, as well as transportation equity. JoyAnn is also a pro bono advisor to an international ecology NGO and has extensive board experience, having worked with several Colorado nonprofits and as a Governor Polis appointee to two commissions.\n\nJoyAnn has a deep connection to District B schools—a former teacher, JoyAnn worked at the original Montbello High School in Denver and at a school for at-risk youth in Aurora. JoyAnn’s son, a longtime RTD rider, is a DPS graduate (and happily car-less).\n\nIn other roles, JoyAnn was a card-carrying member of SEIU Local 105 and Carpenters Local 555. In 2021, as a recognition of their demonstrated commitment to the rights of workers across the globe, JoyAnn was awarded an honorary lifetime membership by Steelworkers Local 3267.\n\nIn 2022, JoyAnn was honored with the Colorado Cross-Disability Coalition’s George Roberts \u0026 Jeanette Klimach Foot Soldier of the Year Award, which is given to a person who goes above and beyond in fighting for the Americans with Disabilities Act. As director, JoyAnn remains inspired by the Gang of 19, a group of disabled ADAPT activists who protested RTD’s inaccessible system in 1978.\n\nJoyAnn is an active member of the American Public Transportation Association (APTA) and Women in Transportation Seminar (WTS), focusing on safety, security, and risk management.\n\nDirector Ruscha lives in Denver with their best friend, Max—the most amazing rescue dog ever."])</script><script>self.__next_f.push([1,"2a:T498,"])</script><script>self.__next_f.push([1,"He continues to enhance his public transportation expertise through completing the DRCOG Civic Academy (2023), Latinos In Transit Leadership Academy (LITLA) Director Track (2024) while simultaneously earning The Harvard Kennedy School State and Local Leadership Certification as a Gates Family Foundation Fellow 2024. Attending courses through the National Transit Institute at Rutgers University, Michael has earned certifications in Public Engagement for Public Transit, Assault Awareness and Prevention for Transit Operators, as well as others, equipping Michael to address the complexities of transit operations, understand operational complexities, and functional methods of healthy community engagement. Drawing on more than two decades of retail customer service experience, he is adept at managing complex training, scheduling, human resource, and operational situations, always striving to \"leave it better than he found it\" for all Coloradans. Michael was conferred his B.A. in Spanish from St. John's University in Collegeville, MN. He is fluent in English, Spanish, and Portuguese, with a strong competence in other Romance Languages, and is actively learning ASL."])</script><script>self.__next_f.push([1,"24:[\"$\",\"$L28\",null,{\"boardMembers\":[{\"_id\":\"12523b53-8a28-4aae-b451-032f204280a4\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T20:53:42.000Z\",\"name\":\"Chris Nicholson\",\"bio\":[{\"_type\":\"block\",\"_key\":\"6d638e12b48e\",\"children\":[{\"_key\":\"00f5d9c9f1530\",\"_type\":\"span\",\"text\":\"Chris Nicholson was elected to the RTD Board of Directors in November 2024 and represents District A, comprising the neighborhoods of Central Denver south of Colfax Ave, Capitol Hill, Upper Downtown, and the city of Glendale. \",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"4bfe8a1a079b\",\"children\":[{\"_key\":\"6f28b0b88361\",\"_type\":\"span\",\"text\":\"Chris is a proud urbanist and a dedicated full-time transit rider who has relied on RTD since moving to Colorado in 2017.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"86cde6f560e7\",\"children\":[{\"_key\":\"ce9fc59051b0\",\"_type\":\"span\",\"text\":\"Professionally, Chris has built a career in public policy, technology, and professional politics. He co-founded Global EIR, where he helped craft policy solutions for immigrant entrepreneurs navigating the U.S. immigration system. In addition, Chris has spent twenty years serving as technical consultant, campaign manager and political advisor to state and local elected officials.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"25e5d9d1b518\",\"children\":[{\"_key\":\"86d6a980b9cc\",\"_type\":\"span\",\"text\":\"Chris is active in LGBT and Jewish life, and advocates for increased housing production in his spare time as a leader of YIMBY Denver. He holds a Bachelor of Arts degree in Political Science from the University of Southern California.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"34ced06d19b2\",\"children\":[{\"_key\":\"40506a3fc9bf\",\"_type\":\"span\",\"text\":\"Outside of work Chris can often be found walking along the 16th Street Mall—his neighborhood since moving to Denver—heading to a great downtown restaurant, a Broadway show at DCPA, or grabbing a beer with friends. If you see him, please say hello!\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2028-12-31\",\"district\":\"A\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"303-299-3325\",\"email\":\"Chris.Nicholson@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Executive Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"6a94c2d480c5\",\"children\":[{\"_key\":\"77e40b1a3dd50\",\"_type\":\"span\",\"text\":\"The Executive Committee will review and establish the agenda for each regular meeting of the Board, and address public affairs, external relations, legislation, and ministerial matters affecting the Board.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"Secretary\"},{\"committee\":{\"name\":\"Performance Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Vice Chair\"},{\"committee\":{\"name\":\"Operations, Safety, and Security Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"8061c875d173\",\"children\":[{\"_key\":\"0b086f1cb5ca0\",\"_type\":\"span\",\"text\":\"The Operations and Safety Committee is responsible for all operational matters, including all contracted and non-contracted bus, rail, paratransit, and microtransit services, as well as safety and security matters.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Metro Mayors Caucus Liason\",\"isAdHoc\":null,\"to\":{\"_id\":\"7b5cd7a2-f62e-4fcf-8be3-e00863f0f141\",\"_type\":\"externalRoute\",\"title\":\"Metro Mayor Caucus\",\"url\":\"https://www.metromayors.org/89/About-MMC\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702064/Nicholson_Web26_ap2vkl.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"$undefined\",\"caption\":\"Photo of Director Nicholson\"}},\"file\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931234/f909d507-4025-478f-ad5d-e95bb68dffe3.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":{\"alt_text\":\"Map of District A\",\"caption\":\"$undefined\"}},\"lang\":\"en\"},{\"_id\":\"f2f7bc28-b5b9-4709-929a-69f2b7208717\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-01-21T16:51:25.000Z\",\"name\":\"JoyAnn Ruscha\",\"bio\":[{\"_type\":\"block\",\"_key\":\"cce1ed5e9621\",\"children\":[{\"_key\":\"6f3460b79e680\",\"_type\":\"span\",\"text\":\"$29\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2026-12-31\",\"district\":\"B\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-919-0476\",\"email\":\"joyann.ruscha@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":\"1660 Blake Street\",\"secondLine\":\"Denver, CO\",\"postalCode\":\"80202\",\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Finance and Planning Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Metro Mayors Caucus Liason\",\"isAdHoc\":null,\"to\":{\"_id\":\"7b5cd7a2-f62e-4fcf-8be3-e00863f0f141\",\"_type\":\"externalRoute\",\"title\":\"Metro Mayor Caucus\",\"url\":\"https://www.metromayors.org/89/About-MMC\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Alternate\"},{\"committee\":{\"name\":\"E-470 Public Highway Authority Board\",\"isAdHoc\":null,\"to\":{\"_id\":\"cec52f02-c9d7-4966-a658-50ec0883c9fc\",\"_type\":\"externalRoute\",\"title\":\"E-470 Public Highway Authority Board\",\"url\":\"https://www.e-470.com/about-us/\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Alternate\"},{\"committee\":{\"name\":\"Adams County Regional Economic Partnership (AC-REP)\",\"isAdHoc\":null,\"to\":{\"_id\":\"3cd9a5bc-417c-4d5d-96cb-74cb32aa950f\",\"_type\":\"externalRoute\",\"title\":\"Adams County Regional Economic Partnership (AC-REP)\",\"url\":\"https://www.ac-rep.org/\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Alternate\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1698851625/Ruscha_zaato7.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1066,\"height\":1600,\"metadata\":{\"alt_text\":\"Photo of Director JoyAnn Ruscha\",\"caption\":\"Photo of Director Ruscha\"}},\"file\":{\"url\":\"https://res.cloudinary.com/rtd/image/upload/v1695931243/195d7342-c6a5-4485-a94f-24988586d414.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":null},\"lang\":\"en\"},{\"_id\":\"81222de0-ebcf-4b49-a387-70da6f692c25\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T20:56:25.000Z\",\"name\":\"Michael Guzman\",\"bio\":[{\"_type\":\"block\",\"_key\":\"bb08628ea255\",\"children\":[{\"_key\":\"f946c25fdaf9\",\"_type\":\"span\",\"text\":\"Proud to be the elected Director of District C on the RTD Denver, Michael brings a deep community understanding of regional transportation needs and a commitment to public service. A lifelong RTD rider and Denver native, representing Denver’s North-West community which he proudly calls home, growing up in the and around the Historic Baker Neighborhood and currently residing in Sunnyside, he served as Board Secretary in 2024 and currently chairs of both the Finance and Planning Committee and the Performance Committee, demonstrating a steady leadership in agency fiscal and operational oversight. He serves as an RTD member on the Regional Transportation Committee of DRCOG.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"f251b765d715\",\"children\":[{\"_key\":\"b30bf89d9335\",\"_type\":\"span\",\"text\":\"Michael's dedication to effective public transit is evident in key initiatives such as voting for Zero Fare for Youth, amending RTD's \\\"Respect the Ride\\\", Board Director On-boarding and Training policies.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"77a3b10c451d\",\"children\":[{\"_key\":\"2dad6185f9f0\",\"_type\":\"span\",\"text\":\"$2a\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"60a0edb35554\",\"children\":[{\"_key\":\"f4621afb05d6\",\"_type\":\"span\",\"text\":\"You can find him on the 19, 44, 52, A, or G lines most often! Heading to work, reading, or sometimes just out adventuring through the city with his beloved niece finding fun routes to cool places and events.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2026-12-31\",\"district\":\"C\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-252-4961\",\"email\":\"michael.guzman@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":\"1660 Blake Street\",\"secondLine\":\"Denver, CO\",\"postalCode\":\"80202\",\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Finance and Planning Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Performance Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"DRCOG Regional Transportation Committee\",\"isAdHoc\":null,\"to\":{\"_id\":\"59dd1820-966f-4bd2-928d-511cc48b0ca5\",\"_type\":\"externalRoute\",\"title\":\"DRCOG Regional Transportation Committee\",\"url\":\"https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Audit Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"1662ef9bb3cf\",\"children\":[{\"_key\":\"0e501432c2ed0\",\"_type\":\"span\",\"text\":\"Consistent with the International Standards for the Professional Practice of Internal Auditing published by the Institute of Internal Auditors (Standards), the Board will appoint a separate, independent Audit Committee that will establish and oversee the internal audit function consistent with the Standards.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"Chair\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702068/Guzman_Web26_gynrgy.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"$undefined\",\"caption\":\"Photo of Director Guzman\"}},\"file\":{\"url\":\"https://res.cloudinary.com/rtd/image/upload/v1695931250/2a520001-d082-4c9e-b46e-60f55cc1a2c0.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":null},\"lang\":\"en\"},{\"_id\":\"ddd5e5c7-7b85-478f-9eac-095da997794a\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T20:57:09.000Z\",\"name\":\"Chris Gutschenritter\",\"bio\":[{\"_type\":\"block\",\"_key\":\"a61dc85b5c2f\",\"children\":[{\"_key\":\"fc86a7b61a720\",\"_type\":\"span\",\"text\":\"Chris is currently serving as the IT Director for a local healthcare company. Throughout his career he has gained extensive experience in human capital management consulting, working with renowned firms such as Deloitte and Accenture. His diverse background includes consulting for global fortune 100 companies as well as small private businesses. Notably, Chris has deep expertise in industries such as rail transportation (including Amtrak), healthcare, and retail.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"792f3cf9f3c0\",\"children\":[{\"_key\":\"6615e8d2a75b0\",\"_type\":\"span\",\"text\":\"In November 2024, Chris was elected to the RTD Board of Directors (District D), where he represents Englewood, parts of South Denver, Littleton, and Jefferson County. His key priorities as a board member are to drive increased ridership, enhance the ridership experience (focusing on safety, cleanliness, and ease of use), and improve operational reliability.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"c94d76cd56c1\",\"children\":[{\"_key\":\"b6a99c5366e10\",\"_type\":\"span\",\"text\":\"A proud Colorado resident since 2018, Chris lives in Englewood with his wife, Jessica, and their daughter. When traveling on RTD, you’ll often find Chris on the D, E, or A lines, or riding the 0 bus route.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2028-12-31\",\"district\":\"D\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-850-1194\",\"email\":\"Christopher.Gutschenritter@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Executive Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Second Vice Chair\"},{\"committee\":{\"name\":\"Finance and Planning Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"ddebbea5e126\",\"children\":[{\"_key\":\"2bc9f1e14b550\",\"_type\":\"span\",\"text\":\"The Finance and Planning Committee is responsible for agency financial matter, including but not limited to budget and monthly financial statement review, determination of the fiscal impact of all Board actions, asset management, and long-range planning and capital project.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Performance Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"fd3fc885bfbd\",\"children\":[{\"_key\":\"1c73de09cb7a0\",\"_type\":\"span\",\"text\":\"The Performance Committee is responsible for the performance management of the General Manager and CEO and the GM/CEO’s contract and annual comprehensive performance evaluation, as well as monitoring metrics as to agency’s performance related to the Strategic Plan success outcomes\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"Chair\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702070/Gutschenritter_Web26_jxti0o.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"Photo of Director Chris Gutschenritter\",\"caption\":\"Photo of Director Gutschenritter\"}},\"file\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931300/27beaf01-527d-4177-9d14-b3a59870f02a.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":{\"alt_text\":\"Map of District D\",\"caption\":\"$undefined\"}},\"lang\":\"en\"},{\"_id\":\"6380f637-7ba3-41d4-abe2-e06121543e85\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-01-21T16:56:12.000Z\",\"name\":\"Matt Larsen\",\"bio\":[{\"_type\":\"block\",\"_key\":\"239f803dbe32\",\"children\":[{\"_key\":\"957f80f003d10\",\"_type\":\"span\",\"text\":\"Director Larsen was elected to the RTD Board of Directors in November 2024 and took office in January 2025, representing District E, which includes parts of Aurora, Denver, Greenwood Village, and Centennial.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"48792b0f97d9\",\"children\":[{\"_key\":\"03794cf36e590\",\"_type\":\"span\",\"text\":\"Matt currently serves as Senior Director of Strategic Projects for a global medical device company. His diverse business career has included advising economic development agencies, consulting for Fortune 500 companies, and managing performance plans for sales teams.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"443de041831d\",\"children\":[{\"_key\":\"5a78f3103b100\",\"_type\":\"span\",\"text\":\"Matt is a lead with YIMBY Denver, a member of Greater Denver Transit, and serves on the board of the Denver Press Club. He lives in the Southmoor neighborhood of Denver with his wife and three children.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"e52c1af4b6c3\",\"children\":[{\"_key\":\"82536941d0d80\",\"_type\":\"span\",\"text\":\"Matt graduated from the University of Pennsylvania with a degree in English and in Urban Studies, and received an MBA from the Yale School of Management.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2028-12-31\",\"district\":\"E\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-595-6325\",\"email\":\"Matt.Larsen@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Finance and Planning Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"ddebbea5e126\",\"children\":[{\"_key\":\"2bc9f1e14b550\",\"_type\":\"span\",\"text\":\"The Finance and Planning Committee is responsible for agency financial matter, including but not limited to budget and monthly financial statement review, determination of the fiscal impact of all Board actions, asset management, and long-range planning and capital project.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Performance Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"fd3fc885bfbd\",\"children\":[{\"_key\":\"1c73de09cb7a0\",\"_type\":\"span\",\"text\":\"The Performance Committee is responsible for the performance management of the General Manager and CEO and the GM/CEO’s contract and annual comprehensive performance evaluation, as well as monitoring metrics as to agency’s performance related to the Strategic Plan success outcomes\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Audit Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"DRCOG Regional Transportation Committee\",\"isAdHoc\":null,\"to\":{\"_id\":\"59dd1820-966f-4bd2-928d-511cc48b0ca5\",\"_type\":\"externalRoute\",\"title\":\"DRCOG Regional Transportation Committee\",\"url\":\"https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1738362717/thumbnail_Larsen_eco5rh.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":250,\"height\":375,\"metadata\":{\"alt_text\":\"Photo of Director Larsen\",\"caption\":\"Photo of Director Larsen\"}},\"file\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931313/7350f082-f40f-4012-a346-05e977a4e932.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":{\"alt_text\":\"Map of District E\",\"caption\":\"$undefined\"}},\"lang\":\"en\"},{\"_id\":\"3dbda5df-b365-427c-b57f-36f464d3c759\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T20:57:39.000Z\",\"name\":\"Kathleen Chandler\",\"bio\":[{\"_type\":\"block\",\"_key\":\"dad21a38adfb\",\"children\":[{\"_key\":\"796c187773650\",\"_type\":\"span\",\"text\":\"Kathleen Chandler, a fourth-generation native of Colorado, proudly represents District F. As a resident of the Aurora/Centennial area since 1992, she has been actively involved in Arapahoe County.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"ef2957573665\",\"children\":[{\"_key\":\"0dbea0603d020\",\"_type\":\"span\",\"text\":\"Kathleen’s primary goal is to ensure the safety and reliability of RTD. She believes that safety encompasses not only the well-maintained condition of the system but also the security of riders and drivers. Prioritizing the security of those who rely on RTD is crucial for the system’s overall health. Kathleen is a strong advocate for the para-transit and transit-dependent constituents, recognizing the importance of serving those who use the service daily. Ensuring RTD’s reliability and safety is essential to meet their needs effectively.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"110388bd103f\",\"children\":[{\"_key\":\"bb3535e9cf3a0\",\"_type\":\"span\",\"text\":\"Kathleen is deeply connected to Colorado and the western can-do spirit. As a community representative, she strives to include a diverse range of voices in her decision-making processes.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"ce67927ee1cb\",\"children\":[{\"_key\":\"1c4c0b69829f0\",\"_type\":\"span\",\"text\":\"Kathleen is married with two sons, two grandchildren, three chickens, and a cat. She is an avid gardener who enjoys canning vegetables during the summer months. In the winter, she relishes spending time in a hot tub while her husband enjoys skiing.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2028-12-31\",\"district\":\"F\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-940-4335\",\"email\":\"Kathleen.Chandler@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Operations, Safety, and Security Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"8061c875d173\",\"children\":[{\"_key\":\"0b086f1cb5ca0\",\"_type\":\"span\",\"text\":\"The Operations and Safety Committee is responsible for all operational matters, including all contracted and non-contracted bus, rail, paratransit, and microtransit services, as well as safety and security matters.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"Vice Chair\"},{\"committee\":{\"name\":\"Performance Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"E-470 Public Highway Authority Board\",\"isAdHoc\":null,\"to\":{\"_id\":\"cec52f02-c9d7-4966-a658-50ec0883c9fc\",\"_type\":\"externalRoute\",\"title\":\"E-470 Public Highway Authority Board\",\"url\":\"https://www.e-470.com/about-us/\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702079/Chandler_Web26_kkffqn.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"Photo of Director Kathleen Chandler\",\"caption\":\"Photo of Director Chandler\"}},\"file\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931256/1314a827-a0af-4fe0-a461-326ef023d351.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":{\"alt_text\":\"Map of District F\",\"caption\":\"$undefined\"}},\"lang\":\"en\"},{\"_id\":\"be5ec2a2-f8a1-4ef8-b0ae-e2df322929dc\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T20:58:04.000Z\",\"name\":\"Julien Bouquet\",\"bio\":[{\"_type\":\"block\",\"_key\":\"6e71322ab892\",\"children\":[{\"_key\":\"6e71322ab8920\",\"_type\":\"span\",\"text\":\"Director Bouquet was elected to the RTD Board in the 2020 general election on November 3rd. Director Bouquet was sworn in as Director on January 5, 2021. Director Bouquet represents RTD District G which includes most of Parker and Lone Tree and portions of Centennial, Aurora and Castle Rock.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"ef3c7eed8dc2\",\"children\":[{\"_key\":\"ef3c7eed8dc20\",\"_type\":\"span\",\"text\":\"Director Bouquet is a full time middle school teacher for Douglas County School District. He teaches elective classes on media and broadcast production, as well as a class on photojournalism and electronic publishing. His classes have won multiple district and statewide student-media and student-journalism awards.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"43009d83fc20\",\"children\":[{\"_key\":\"43009d83fc200\",\"_type\":\"span\",\"text\":\"He has grown up in Douglas County and has lived most of his life in the county. Director Bouquet is a frequent RTD rider, and was first introduced to RTD while attending the University of Denver. He used the E or F line almost everyday in college. Director Bouquet graduated from the University of Denver in 2016 with a Bachelor of Arts in Political Science.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"40a8186382f6\",\"children\":[{\"_key\":\"40a8186382f60\",\"_type\":\"span\",\"text\":\"Director Bouquet has been involved in several political campaigns since 2012. He has served as a non-paid volunteer, an organizer and a canvas manager. He is also a proud Eagle Scout and credits most of his civic engagement from his time in the scouts.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2028-12-31\",\"district\":\"G\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-892-7084\",\"email\":\"Julien.Bouquet@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":\"1660 Blake Street\",\"secondLine\":\"Denver, CO\",\"postalCode\":\"80202\",\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Operations, Safety, and Security Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"8061c875d173\",\"children\":[{\"_key\":\"0b086f1cb5ca0\",\"_type\":\"span\",\"text\":\"The Operations and Safety Committee is responsible for all operational matters, including all contracted and non-contracted bus, rail, paratransit, and microtransit services, as well as safety and security matters.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"DRCOG Regional Transportation Committee\",\"isAdHoc\":null,\"to\":{\"_id\":\"59dd1820-966f-4bd2-928d-511cc48b0ca5\",\"_type\":\"externalRoute\",\"title\":\"DRCOG Regional Transportation Committee\",\"url\":\"https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Alternate\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702066/Bouquet_Web26_coravr.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"Photo of Director Julien Bouquet\",\"caption\":\"Photo of Director Bouquet\"}},\"file\":{\"url\":\"https://res.cloudinary.com/rtd/image/upload/v1695931226/012d28e8-745d-4409-8b5e-6fbebbde0e6b.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":null},\"lang\":\"en\"},{\"_id\":\"e339ec7e-71f3-4224-b30d-afaec208eb91\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T20:58:32.000Z\",\"name\":\"Patrick O’Keefe\",\"bio\":[{\"_type\":\"block\",\"_key\":\"7c30649bfe3b\",\"children\":[{\"_key\":\"39bf8259a00c0\",\"_type\":\"span\",\"text\":\"Patrick has spent his career working at the cross section of infrastructure development and public policy. Starting his career on Capitol Hill working for Colorado Congressman Dan Schaefer on a wide range of issues, he learned the importance of thoughtful collaboration and principled stands on the most important issues.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"da9974f20115\",\"children\":[{\"_key\":\"771b6a5d718d0\",\"_type\":\"span\",\"text\":\"He transitioned to practical implementation of policy ideas working in the private sector. As a senior executive for a Colorado-based Fortune 500 engineering company, he was able to work with teams delivering some of the most iconic and challenging infrastructure in the world…and right here in Colorado. In 2020, he started a growing small business focused on infrastructure advisory services helping clients build projects on-schedule and within budget to solve the needs of a growing Front Range economy.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"10ca99c5d484\",\"children\":[{\"_key\":\"3205cd9544270\",\"_type\":\"span\",\"text\":\"Patrick and his wife Karen raised three children in Highlands Ranch, where they have lived for over two decades. He is active in the community serving on the board of a non-profit committed to food security. In his free time, he loves playing ice hockey, fly fishing, bumbling around a golf course and reading history.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2028-12-31\",\"district\":\"H\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-940-4324\",\"email\":\"Patrick.O'keefe@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Executive Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"6a94c2d480c5\",\"children\":[{\"_key\":\"77e40b1a3dd50\",\"_type\":\"span\",\"text\":\"The Executive Committee will review and establish the agenda for each regular meeting of the Board, and address public affairs, external relations, legislation, and ministerial matters affecting the Board.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"Chair\"},{\"committee\":{\"name\":\"Performance Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702063/OKeefe_Web26_f0sm9w.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"Photo of Director Patrick O’Keefe\",\"caption\":\"Photo of Director O’Keefe\"}},\"file\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931262/9660a148-6a1a-4359-930d-4c3c9ff1473c.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":{\"alt_text\":\"Map of District H\",\"caption\":\"$undefined\"}},\"lang\":\"en\"},{\"_id\":\"696845fe-5ed3-49df-bd20-059cdec545f6\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T20:59:07.000Z\",\"name\":\"Karen Benker\",\"bio\":[{\"_type\":\"block\",\"_key\":\"a7b6c3a8379a\",\"children\":[{\"_key\":\"47f5701d0acb0\",\"_type\":\"span\",\"text\":\"Karen previously served two terms on the RTD Board in the 1990s representing District M where she worked hard to build the SW rail line--now known as the D Line. She now serves District I which covers Longmont, Broomfield, Lafayette, and Erie.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"76ed3bdd1e62\",\"children\":[{\"_key\":\"420a7f8ff16c0\",\"_type\":\"span\",\"text\":\"She loves reading government budgets because she worked many years in the Colorado Governor’s budget office and was the Budget Director for the Colorado Department of Labor and Employment. Prior to that she lived in Washington D.C. working for the National Association of State Budget Officers.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"7f346066f0a1\",\"children\":[{\"_key\":\"65b55b7d58320\",\"_type\":\"span\",\"text\":\"Karen co-founded the Fort Morgan Humane Society and now serves on the Board writing grants and holding fundraising events. The small, but mighty, humane society on the Eastern Plains saves over 650 dogs and cats each year. She also is the owner of her small dog biscuit company – Furry Friends Biscuit Bakery.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2028-12-31\",\"district\":\"I\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-939-3115\",\"email\":\"Karen.Benker@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Executive Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"6a94c2d480c5\",\"children\":[{\"_key\":\"77e40b1a3dd50\",\"_type\":\"span\",\"text\":\"The Executive Committee will review and establish the agenda for each regular meeting of the Board, and address public affairs, external relations, legislation, and ministerial matters affecting the Board.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"Treasurer\"},{\"committee\":{\"name\":\"Finance and Planning Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"ddebbea5e126\",\"children\":[{\"_key\":\"2bc9f1e14b550\",\"_type\":\"span\",\"text\":\"The Finance and Planning Committee is responsible for agency financial matter, including but not limited to budget and monthly financial statement review, determination of the fiscal impact of all Board actions, asset management, and long-range planning and capital project.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"Chair\"},{\"committee\":{\"name\":\"DRCOG Regional Transportation Committee\",\"isAdHoc\":null,\"to\":{\"_id\":\"59dd1820-966f-4bd2-928d-511cc48b0ca5\",\"_type\":\"externalRoute\",\"title\":\"DRCOG Regional Transportation Committee\",\"url\":\"https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"CDOT Liason\",\"isAdHoc\":null,\"to\":{\"_id\":\"9c9126cc-3d76-4905-be70-2d898d0867f1\",\"_type\":\"externalRoute\",\"title\":\"CDOT Liaison\",\"url\":\"https://www.codot.gov/about/governmentrelations/local-government-liaison\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702075/Benker_Web26_fh5uce.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"Photo of Director Karen Benker\",\"caption\":\"Photo of Director Benker\"}},\"file\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931319/dbb0b0f1-966a-4e64-9584-61deba9c3d04.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":{\"alt_text\":\"Map of District I\",\"caption\":\"$undefined\"}},\"lang\":\"en\"},{\"_id\":\"7e540782-ff95-4436-aade-783a0d0dc390\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-27T16:23:20.000Z\",\"name\":\"Joyce Downing\",\"bio\":[{\"_type\":\"block\",\"_key\":\"483b1d8ebd33\",\"children\":[{\"_key\":\"cb3232dcd16d\",\"_type\":\"span\",\"text\":\"Director Joyce Downing was appointed on July 21st, 2026 and took office on July 28th 2026 to fill a vacancy left by former Director Vince Buzek representing District J which includes the cities of Westminster, Northglenn, Federal Heights, portions of western Thornton and portions of unincorporated Adams and Jefferson Counties.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"67537f81579a\",\"children\":[{\"_key\":\"d8907d8ab647\",\"_type\":\"span\",\"text\":\"Joyce is the former Mayor of the City of Northglenn. She served several years as the Mayor Pro Tem and Council Member. She served as chair of both the North Area Transportation Alliance (NATA) and Smart Commute. She also served as a member of the Denver Regional Council of Governments (DRCOG)\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"199779dd1b79\",\"children\":[{\"_key\":\"ba22a582cbc5\",\"_type\":\"span\",\"text\":\"Joyce is married with 6 children and 15 grandchildren. She enjoys volunteering with the Northglenn Historic Commission, Northglenn Arts and Humanities Foundation and the Victim Assistance and Law Enforcement Board (VALE). She enjoys traveling in her spare time.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2026-12-31\",\"district\":\"J\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-232-4402\",\"email\":\"Joyce.Downing@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Operations, Safety, and Security Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"8061c875d173\",\"children\":[{\"_key\":\"0b086f1cb5ca0\",\"_type\":\"span\",\"text\":\"The Operations and Safety Committee is responsible for all operational matters, including all contracted and non-contracted bus, rail, paratransit, and microtransit services, as well as safety and security matters.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1787252540/Downing_Joyce_weebly_dglc7z.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":933,\"height\":699,\"metadata\":{\"alt_text\":\"$undefined\",\"caption\":\"Photo of Director Downing\"}},\"file\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931268/8a93e33a-c219-40df-8625-781f77e0aa78.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":{\"alt_text\":\"Map of District J\",\"caption\":\"$undefined\"}},\"lang\":\"en\"},{\"_id\":\"ca9b19f7-eacd-40db-b694-a4650efc253b\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-01-21T18:03:55.000Z\",\"name\":\"Troy L. Whitmore\",\"bio\":[{\"_type\":\"block\",\"_key\":\"5abf009740b9\",\"children\":[{\"_key\":\"5abf009740b90\",\"_type\":\"span\",\"text\":\"Director Troy Whitmore was elected to the RTD Board of Directors in November 2018 and took office in January 2019, representing District K. District K is RTD’s most northeastern district which includes Brighton, Commerce City, much of Thornton and unincorporated Adams County.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"b16acbbf8915\",\"children\":[{\"_key\":\"b16acbbf89150\",\"_type\":\"span\",\"text\":\"Troy Whitmore is an active community servant who has been a United Power employee for more than 30 years. In his current position as Public Affairs Officer, he oversees communications, marketing, key accounts, governmental affairs and community relations functions for the electric distribution cooperative based in Brighton, Colorado.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"dfe279505c1c\",\"children\":[{\"_key\":\"dfe279505c1c0\",\"_type\":\"span\",\"text\":\"A northeastern Colorado native, Troy is a 1983 graduate of Northeastern Junior College and a 1985 graduate of Colorado State University.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"61853529bad1\",\"children\":[{\"_key\":\"61853529bad10\",\"_type\":\"span\",\"text\":\"A former Thornton City Council member, Troy remains very active in his community. He is past Chair of the Board of Directors of the MetroNorth Chamber of Commerce, past Chair and Board member of the Brighton Economic Development Corporation and past President and Board member of Almost Home, Inc. He serves as a Board Member for Smart Commute MetroNorth and Adams County Economic Development. He also chairs School District 27J’s Bond Advisory Committee and is Vice Chair of the Board of Energy Outreach Colorado (EOC) which is Colorado’s premier energy assistance foundation.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"30b0f708dfdd\",\"children\":[{\"_key\":\"30b0f708dfdd0\",\"_type\":\"span\",\"text\":\"The MetroNorth Chamber named him Business Person of the Year in 2011 and recognized him with the Chairman’s Award in 2016. He was awarded the Pathfinder Award by Northeastern Junior College in 2015. In 2017, Whitmore was honored by Pro 15 with the Alumni of the Plains recognition. Director Whitmore is committed to building a world-class transit system that effectively serves constituents in all socio-economic classes and prompts economic development throughout the RTD service area.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2026-12-31\",\"district\":\"K\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-614-7267\",\"email\":\"troy.whitmore@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":\"1660 Blake Street\",\"secondLine\":\"Denver, CO\",\"postalCode\":\"80202\",\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Operations, Safety, and Security Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"8061c875d173\",\"children\":[{\"_key\":\"0b086f1cb5ca0\",\"_type\":\"span\",\"text\":\"The Operations and Safety Committee is responsible for all operational matters, including all contracted and non-contracted bus, rail, paratransit, and microtransit services, as well as safety and security matters.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Adams County Regional Economic Partnership (AC-REP)\",\"isAdHoc\":null,\"to\":{\"_id\":\"3cd9a5bc-417c-4d5d-96cb-74cb32aa950f\",\"_type\":\"externalRoute\",\"title\":\"Adams County Regional Economic Partnership (AC-REP)\",\"url\":\"https://www.ac-rep.org/\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"RTD Salaried Employee Pension Trust\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"RTD Salaried Employee Defined Contribution Plan Trust\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931271/5534c3fe-da3b-46bd-a8f4-ba2436bdb23c.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":133,\"height\":200,\"metadata\":{\"alt_text\":\"Photo of Director Troy L. Whitmore\",\"caption\":\"Photo of Director Whitmore\"}},\"file\":{\"url\":\"https://res.cloudinary.com/rtd/image/upload/v1695931275/2083d186-b756-4595-89c5-aadc68ee8175.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":null},\"lang\":\"en\"},{\"_id\":\"4f74369e-3d43-46c4-abab-9885848d3cbb\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-01-21T18:16:05.000Z\",\"name\":\"Ian Harwick\",\"bio\":[{\"_type\":\"block\",\"_key\":\"ff928f642b03\",\"children\":[{\"_key\":\"ff928f642b030\",\"_type\":\"span\",\"text\":\"Ian Harwick is a mostly native of Colorado, having spent his first 6 months in Ohio. He moved to Arvada in 1988 and has spent a good portion of his life there.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"89e4907053f8\",\"children\":[{\"_key\":\"89e4907053f80\",\"_type\":\"span\",\"text\":\"He graduated with a degree in Business Management from Johnson \u0026 Wales University, attending at their Providence campus, as well as their now-closed Denver campus.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"88a63d1b8c10\",\"children\":[{\"_key\":\"88a63d1b8c100\",\"_type\":\"span\",\"text\":\"Ian joined RTD in January 2023 after a write-in campaign in 2022. He has been a staunch advocate for transit, cycling, walking, and adaptive mobility for the last 20 years.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"9216b6311622\",\"children\":[{\"_key\":\"9216b63116220\",\"_type\":\"span\",\"text\":\"For his day job, Ian works for the City of Denver in the Office of Climate Action, Sustainability \u0026 Resiliency. His prior work at the city included a small stint at DDPHE (during the start of the Covid pandemic) and then a longer stay at the Denver Office of the Medical Examiner. Prior to his time there he spent ten years running a small consulting business and has been highly involved in the Athmar Park Neighborhood Association, Denver’s YIMBY’s and New Leaders Council.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"d55406dfaf86\",\"children\":[{\"_key\":\"d55406dfaf860\",\"_type\":\"span\",\"text\":\"He is now back in Arvada where he parents a feisty 6-year-old girl with his wife, Kristin. He spends his spare time fixing up his house, playing volleyball, and attempting to read more books.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2026-12-31\",\"district\":\"L\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-260-4515\",\"email\":\"ian.harwick@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":\"1660 Blake Street\",\"secondLine\":\"Denver, CO\",\"postalCode\":\"80202\",\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Operations, Safety, and Security Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"8061c875d173\",\"children\":[{\"_key\":\"0b086f1cb5ca0\",\"_type\":\"span\",\"text\":\"The Operations and Safety Committee is responsible for all operational matters, including all contracted and non-contracted bus, rail, paratransit, and microtransit services, as well as safety and security matters.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"Chair\"},{\"committee\":{\"name\":\"Executive Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Vice Chair\"},{\"committee\":{\"name\":\"DRCOG Regional Transportation Committee\",\"isAdHoc\":null,\"to\":{\"_id\":\"59dd1820-966f-4bd2-928d-511cc48b0ca5\",\"_type\":\"externalRoute\",\"title\":\"DRCOG Regional Transportation Committee\",\"url\":\"https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Alternate\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1738598919/thumbnail_Harwick_ut6xcb.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":533,\"height\":799,\"metadata\":{\"alt_text\":\"Photo of Director Harwick\",\"caption\":\"Photo of Director Harwick\"}},\"file\":{\"url\":\"https://res.cloudinary.com/rtd/image/upload/v1695931281/51c16f14-508e-44f3-87be-443c17219b38.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":null},\"lang\":\"en\"},{\"_id\":\"b7e30214-acf7-4f83-a297-0cec75e1465c\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-01-21T18:16:38.000Z\",\"name\":\"Brett Paglieri\",\"bio\":[{\"_type\":\"block\",\"_key\":\"7ca6eadca8fc\",\"children\":[{\"_key\":\"22e33420dc9a\",\"_type\":\"span\",\"text\":\"Director Paglieri is proud to represent areas of Lakewood, Golden, Edgewater, Wheat Ridge, Mountain View, Lakeside and beyond. He was elected in November 2024 and took office in January 2025.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"75186efcb0b5\",\"children\":[{\"_key\":\"eaaaefba84a7\",\"_type\":\"span\",\"text\":\"Brett is multimodal advocate, working closely with nonprofits and grass roots advocacy groups to improve the transit, biking, walking and rolling experience in JeffCo and throughout Denver. He uses his background in customer experience to focus on improving the rider experience and strongly supports creating a more welcoming transit environment for everyone.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"0fdf78d7a52a\",\"children\":[{\"_key\":\"299d8c551e9c\",\"_type\":\"span\",\"text\":\"In addition to serving as a Director, he works full time in the tech industry as a Product Manager. He holds a Bachelor's of Science in Computer Science from Regis University.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2028-12-31\",\"district\":\"M\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-939-3074\",\"email\":\"Brett.Paglieri@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Operations, Safety, and Security Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"8061c875d173\",\"children\":[{\"_key\":\"0b086f1cb5ca0\",\"_type\":\"span\",\"text\":\"The Operations and Safety Committee is responsible for all operational matters, including all contracted and non-contracted bus, rail, paratransit, and microtransit services, as well as safety and security matters.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Jefferson County Transportation Advisory Group\",\"isAdHoc\":null,\"to\":{\"_id\":\"53f2f370-773c-4d34-b0e5-9d3d830f12cb\",\"_type\":\"externalRoute\",\"title\":\"JEFFTAAG\",\"url\":\"https://www.jeffco.us/2855/JEFFTAAG-Jeffco-Forum\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"DRCOG Regional Transportation Committee\",\"isAdHoc\":null,\"to\":{\"_id\":\"59dd1820-966f-4bd2-928d-511cc48b0ca5\",\"_type\":\"externalRoute\",\"title\":\"DRCOG Regional Transportation Committee\",\"url\":\"https://drcog.org/about-drcog/get-involved/committees-working-groups/regional-transportation-committee\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Alternate\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1738362746/thumbnail_Paglieri_cgpwng.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":250,\"height\":375,\"metadata\":{\"alt_text\":\"Photo of Director Paglieri\",\"caption\":\"Photo of Director Paglieri\"}},\"file\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1695931288/a7099c9d-755e-413e-86ba-9bbaedd6852f.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":{\"alt_text\":\"Map of District M\",\"caption\":\"$undefined\"}},\"lang\":\"en\"},{\"_id\":\"613e62a4-9cd1-4ac8-89f1-a79a79e21c84\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T20:59:44.000Z\",\"name\":\"Cindy Arcuri\",\"bio\":[{\"_type\":\"block\",\"_key\":\"a50892c29056\",\"children\":[{\"_key\":\"127c2a8064cd\",\"_type\":\"span\",\"text\":\"Cindy Arcuri was appointed by the Jefferson County Commissioners on a 2-0 vote with one absent after the position was vacated by former Board member Peggy Catlin. Arcuri's appointment will last through the 2026 General Election and subsequent swearing in of a successor.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2026-12-31\",\"district\":\"N\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-871-3412\",\"email\":\"Cindy.Arcuri@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":null,\"secondLine\":null,\"postalCode\":null,\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Finance and Planning Committee\",\"isAdHoc\":null,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Vice Chair\"},{\"committee\":{\"name\":\"Jefferson County Transportation Advisory Group\",\"isAdHoc\":null,\"to\":{\"_id\":\"53f2f370-773c-4d34-b0e5-9d3d830f12cb\",\"_type\":\"externalRoute\",\"title\":\"JEFFTAAG\",\"url\":\"https://www.jeffco.us/2855/JEFFTAAG-Jeffco-Forum\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"$undefined\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702077/Arcuri_Web26_y13zsu.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"Photo of Director Cindy Arcuri\",\"caption\":\"Photo of Director Arcuri\"}},\"file\":null,\"lang\":\"en\"},{\"_id\":\"49ce9959-e750-45c6-9e81-08352e91d432\",\"_type\":\"boardMember\",\"_updatedAt\":\"$D2026-08-20T21:00:13.000Z\",\"name\":\"Lynn Guissinger\",\"bio\":[{\"_type\":\"block\",\"_key\":\"70bec01cee9d\",\"children\":[{\"_key\":\"70bec01cee9d0\",\"_type\":\"span\",\"text\":\"Director Lynn Guissinger was elected to the RTD Board of Directors in November 2018 and took office in January, 2019 representing District O. District O represents the most northwestern portion of the RTD area including all of the City of Boulder, Jamestown, Louisville, Lyons, Nederland, and Ward, the portion of Longmont west of North 95th St. and south of Mountain View Ave., all of Superior within Boulder County, and the majority of unincorporated Boulder County, generally lying west of North 95th St.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"04abdfb0c40c\",\"children\":[{\"_key\":\"04abdfb0c40c0\",\"_type\":\"span\",\"text\":\"Director Guissinger is a small business owner and former attorney with broad experience in managing a business, and in financial analysis and creative fundraising.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"088c739b2677\",\"children\":[{\"_key\":\"088c739b26770\",\"_type\":\"span\",\"text\":\"Guissinger’s business, Catalyst Communication, partnered with city transportation departments around the country (including Seattle, Cambridge, Denver, Boulder, Tucson, Anchorage, and others) to market and promote their transit, biking, and walking options. Catalyst Communication worked for years in the bicycle and outdoor industries, and Guissinger has worked with advocacy efforts in these areas.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"aa2010ca17b7\",\"children\":[{\"_key\":\"aa2010ca17b70\",\"_type\":\"span\",\"text\":\"Guissinger graduated from CU Law School, and practiced law for a number of years. She clerked on the United States Court of Appeals for the Tenth Circuit. After practicing law at Holland \u0026 Hart, Guissinger taught Land Use Planning and Local Government Law at CU Law School.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"f9d43150d462\",\"children\":[{\"_key\":\"f9d43150d4620\",\"_type\":\"span\",\"text\":\"Civic and community activities include:\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"83866b6dd71f\",\"children\":[{\"_key\":\"83866b6dd71f0\",\"_type\":\"span\",\"text\":\"City of Boulder Transportation Advisory Board (chair), 2005-2009\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"65f5ee058fb1\",\"children\":[{\"_key\":\"65f5ee058fb10\",\"_type\":\"span\",\"text\":\"Chair, Successful campaign for 2M and 2N, the Community Culture and Safety tax, 2017\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"6759be61ef5c\",\"children\":[{\"_key\":\"6759be61ef5c0\",\"_type\":\"span\",\"text\":\"Commuting Solutions board\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"f5974c99bf15\",\"children\":[{\"_key\":\"f5974c99bf150\",\"_type\":\"span\",\"text\":\"Boulder Housing Partners Foundation board, president\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"9b788c087dc2\",\"children\":[{\"_key\":\"9b788c087dc20\",\"_type\":\"span\",\"text\":\"Colorado Fourteeners Initiative board\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"31748aa39f14\",\"children\":[{\"_key\":\"31748aa39f140\",\"_type\":\"span\",\"text\":\"Senior Fellow, Getches Wilkinson Center for Natural Resources and Environment, CU Law School, current\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"7215dc0fbcda\",\"children\":[{\"_key\":\"7215dc0fbcda0\",\"_type\":\"span\",\"text\":\"Community Cycles Capital Campaign\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"8b2423a7f577\",\"children\":[{\"_key\":\"8b2423a7f5770\",\"_type\":\"span\",\"text\":\"Focus Reentry, treasurer\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"a0c9843850c0\",\"children\":[{\"_key\":\"a0c9843850c00\",\"_type\":\"span\",\"text\":\"Emergency Family Assistance Foundation, past president, 1990s\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"4d63aeab2ce9\",\"children\":[{\"_key\":\"4d63aeab2ce90\",\"_type\":\"span\",\"text\":\"Intercambio Uniting Communities, past member 2009-2011\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"d49dc7f901b5\",\"children\":[{\"_key\":\"d49dc7f901b50\",\"_type\":\"span\",\"text\":\"City of Boulder Greenways Advisory Committee, 2007-2009\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"4e1709f9b9dc\",\"children\":[{\"_key\":\"4e1709f9b9dc0\",\"_type\":\"span\",\"text\":\"Democratic Women of Boulder County, past president\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":\"bullet\",\"level\":1},{\"_type\":\"block\",\"_key\":\"ba21b7859d6c\",\"children\":[{\"_key\":\"ba21b7859d6c0\",\"_type\":\"span\",\"text\":\"Director Guissinger is passionate about helping build strong communities through transportation options that work for people’s lives. She is excited to represent much of Boulder County and the Northwest Corridor on the RTD board.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"termEnd\":\"2026-12-31\",\"district\":\"O\",\"active\":true,\"contact\":{\"person\":null,\"phone\":\"720-320-3058\",\"email\":\"lynn.guissinger@rtd-denver.com\",\"summary\":null},\"address\":{\"firstLine\":\"1660 Blake Street\",\"secondLine\":\"Denver, CO\",\"postalCode\":\"80202\",\"countryCode\":\"US\"},\"committees\":[{\"committee\":{\"name\":\"Finance and Planning Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"ddebbea5e126\",\"children\":[{\"_key\":\"2bc9f1e14b550\",\"_type\":\"span\",\"text\":\"The Finance and Planning Committee is responsible for agency financial matter, including but not limited to budget and monthly financial statement review, determination of the fiscal impact of all Board actions, asset management, and long-range planning and capital project.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"Performance Committee\",\"isAdHoc\":false,\"to\":null,\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":[{\"_type\":\"block\",\"_key\":\"fd3fc885bfbd\",\"children\":[{\"_key\":\"1c73de09cb7a0\",\"_type\":\"span\",\"text\":\"The Performance Committee is responsible for the performance management of the General Manager and CEO and the GM/CEO’s contract and annual comprehensive performance evaluation, as well as monitoring metrics as to agency’s performance related to the Strategic Plan success outcomes\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}]},\"position\":\"$undefined\"},{\"committee\":{\"name\":\"CDOT Liason\",\"isAdHoc\":null,\"to\":{\"_id\":\"9c9126cc-3d76-4905-be70-2d898d0867f1\",\"_type\":\"externalRoute\",\"title\":\"CDOT Liaison\",\"url\":\"https://www.codot.gov/about/governmentrelations/local-government-liaison\"},\"contact\":null,\"startDate\":null,\"endDate\":null,\"details\":null},\"position\":\"Alternate\"}],\"headshot\":{\"url\":\"https://cdn.rtd-denver.com/image/upload/v1769702073/Guissinger_Web26_crv1ub.jpg\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":400,\"height\":400,\"metadata\":{\"alt_text\":\"Photo of Director Lynn Guissinger\",\"caption\":\"Photo of Director Guissinger\"}},\"file\":{\"url\":\"https://res.cloudinary.com/rtd/image/upload/v1695931294/89b3116b-0ae7-4554-b781-b77684092833.pdf\",\"_type\":\"cloudinary.asset\",\"resource_type\":\"image\",\"width\":1224,\"height\":792,\"metadata\":null},\"lang\":\"en\"}],\"lang\":\"en\"}]\n"])</script><script>self.__next_f.push([1,"25:[\"$\",\"div\",null,{\"className\":\"bg-gray-50 py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-gutter-max my-8\",\"children\":[\"$\",\"div\",null,{\"id\":\"Resources\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-heading font-bold text-gray-800 mb-4\",\"children\":\"Resources\"}],\"$undefined\",[\"$\",\"ol\",null,{\"className\":\"flex gap-8 flex-wrap\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"w-fit\",\"children\":[\"$\",\"$L2b\",null,{\"displayType\":\"button\",\"size\":\"md\",\"className\":\"bg-white w-full text-gray-800 p-4 rounded-xl border border-gray-100 [\u0026\u003esv