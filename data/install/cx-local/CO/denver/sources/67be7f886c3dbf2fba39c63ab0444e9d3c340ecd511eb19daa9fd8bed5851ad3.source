a {
	text-decoration:none;
	font-weight:600;
}
h1 {
	color:#002868;
	border-bottom:2px solid #DDDDDD;
	margin:0px;
	padding-bottom:5px;
}
h2 {
	margin:0px;
	padding-bottom:5px;
}
h3 {
	margin:0px;
	padding-bottom:5px;
	color:#BF0A30;
}
h4 {
	margin:0px;
	padding-bottom:5px;
	color:#002868;
}
h5 {
	margin:0px;
	padding-bottom:5px;
}
p {
