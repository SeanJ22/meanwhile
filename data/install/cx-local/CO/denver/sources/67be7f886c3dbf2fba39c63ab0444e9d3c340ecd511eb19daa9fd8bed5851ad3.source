	<link rel="stylesheet" href="https://code.jquery.com/ui/1.14.2/themes/base/jquery-ui.css">
	<script type="text/javascript">
	   $(document).ready(function () {
			$(".dcc-toggle h1, .dcc-toggle h2, .dcc-toggle h3").click(function () {
				$(this).parent().find(".spinicon").toggleClass("dcc-rotate");
				$(this).parent().find(".dcc-hidden").slideToggle("slow");
				$(this).parent().find(".dcc-shown").slideToggle("slow");	
			});
		});
	</script>
	<!--JM 07/03/2025: Added script to append "aria-label" to any a with target="_blank" for accessibility.-->
	<script type="text/javascript">
		$(document).ready(function() {
		  $('a[target="_blank"][title]').each(function() {
			var title = $(this).attr('title');
			$(this).attr('aria-label', title + ' opens in new tab');
		  });
		});
	</script>
	
