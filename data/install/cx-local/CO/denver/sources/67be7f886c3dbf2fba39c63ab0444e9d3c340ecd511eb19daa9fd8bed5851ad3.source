<style id="wp-custom-css">
/*Dark Mode Style*/
[data-neve-theme="dark"] {
	h1 {
		color:#FFD700;
	}
	h3 {
		color:#DE294F;
	}
	th {
		color:#FFD700;
	}
	.red {
		color:#DE294F;
	}
	.red-button {
		background-color:#DE294F;
	}
	.blue {
		color:#FFD700;
	}
	input[type=submit]{
		background-color:#DE294F;
	}
	.home-page-background {
		background-color:unset;
	}
	.nv-single-post-wrap,.nv-single-page-wrap,.archive-container {
	background-color:rgba(0,0,0,0.9);
	}
	.article-content-col {
		background-color:rgba(0,40,104,0.9);
		
	}
	ul.lcp_catlist li {
		border:2px solid rgba(255,215,0,0.8);
		background-color:unset;
	}
	/*Data Table override*/
	.tablepress {
			border:1px solid #002868;
			--odd-text-color:white;
			--odd-bg-color:rgba(34,34,34,0.75);
		  --even-text-color:white;
		  --even-bg-color:rgba(34,34,34,0.2);
		  --hover-text-color:white;
		  --hover-bg-color:#001433;
		}

	
	table.court-forms tr th {
			color: white !important;	
	}

	table.court-forms tr th, table.court-forms tr th.dt-ordering-asc, table.court-forms tr th.dt-ordering-desc {
		background-color:rgba(64,64,64,0.05);
		border:1px solid #002868;
		color:#002868;
	}
	table.court-forms tr th.dt-ordering-asc span.dt-column-order, table.court-forms tr th.dt-ordering-desc span.dt-column-order {
		color:#BF0A30 !important;
	}
	table.court-forms tr {
		border:1px solid #002868 !important;
	}
	table.court-forms tr th:hover {
		background-color:#002868 !important;
		color:white !important;
	}
	span.dt-column-order {
		color:white !important;
	}
	table.court-forms tr th:hover div.dt-column-header span.dt-column-order {
		color:white !important;
	} 

	table.court-forms tr th.dt-ordering-desc:hover div.dt-column-header span.dt-column-order {
		color:#FFD700 !important;
	}
	table.court-forms tr th.dt-ordering-asc:hover div.dt-column-header span.dt-column-order {
		color:#FFD700 !important;
	}
	
}
/*Dark Mode Style End*/
.gtranslate_wrapper select {
	margin-left:5px;
	font-size:0.7em;
	background-color:#404040;
	color:white;
	min-height:20px;
}
.gtranslate_wrapper select option {
	min-height:0px;
	padding:0px;
	margin:0px;
}

/*Global Background Classes*/

.neve-main {
	/*background-image:url('http://wwwqa.denvercountycourt.org/dcc/images/www2.0-background-hd.jpg');*/
	background-image:linear-gradient(#000000,#002868,#001433);
	background-position:top center;
	background-repeat:no-repeat;
	background-color:#222222;
	/*background-size:cover;*/
	padding-left:5px;
	padding-right:5px;

}
.nv-single-post-wrap,.nv-single-page-wrap, .archive-container{
	background-color:rgba(255,255,255,0.98);
}

/*Global Color Classes*/
.blue {
	color:#002868;
}
.darkblue {
	color:#001433;
}
.red {
	color:#BF0A30;
}
.darkred {
	color:#830722;
}
.gold {
	color:#FFD700;
}
.darkgold {
	color:#D0AD00;
}
.orange {
	color:#FF8C00;
}
.darkorange {
	color:#C96F00;
}
.green {
	color:#00B050;
}
.darkgreen{
	color:#00863D;
}
.grey {
	color:#404040;
}
.darkgrey {
	color:#222222;
}
.white {
	color:white;
}
/*Custom DCC Objects*/
.dcc-notice-container{
	background-color:#222222;
	color:#FFD700;
	border-bottom:1px solid #002868;
}
.dcc-notice-content {
	width:80%;
	margin:0 auto;
}
.dcc-notice-message {
	width:75%;
	margin:0 auto;
	text-align:center;
}
.dcc-gtrans-plugin {
	float:left;
	width:125px;
	margin-top:-20px;
}

.dcc-rotate {
	transform: rotate(180deg);
	transition: transform 0.5s;
}
.dcc-hidden {
	display:none;
}
.dcc-shown {
	display:block;
}
.spinicon {
	transition: transform 0.5s;
}
/*DataTables CSS Override*/
.tablepress {
		border:1px solid #002868;
	}

table.court-forms tr th {
		color: #002868 !important;	
}

table.court-forms tr th, table.court-forms tr th.dt-ordering-asc, table.court-forms tr th.dt-ordering-desc {
	background-color:rgba(64,64,64,0.05);
	border:1px solid #002868;
	color:#002868;
}
table.court-forms tr th.dt-ordering-asc span.dt-column-order, table.court-forms tr th.dt-ordering-desc span.dt-column-order {
	color:#BF0A30 !important;
}
table.court-forms tr {
	border:1px solid #002868 !important;
}
table.court-forms tr th:hover {
	background-color:#002868 !important;
	color:white !important;
}
span.dt-column-order {
	color:white !important;
}
table.court-forms tr th:hover div.dt-column-header span.dt-column-order {
	color:white !important;
} 

table.court-forms tr th.dt-ordering-desc:hover div.dt-column-header span.dt-column-order {
	color:#FFD700 !important;
}
table.court-forms tr th.dt-ordering-asc:hover div.dt-column-header span.dt-column-order {
	color:#FFD700 !important;
}

/*Style Overrides*/
.nv-nav-wrap {
	background-color:white;
	border-radius:5px;
}
ul.primary-menu-ul {
	
}
ul.primary-menu-ul li {
	padding:10px;

}
ul.primary-menu-ul li:hover {
  background-color:#e6efff;

}

ul.sub-menu li {
	background-color:white !important;
	padding:unset !important;
}
ul.sub-menu li:hover {
	background-color:#e6efff !important;
}
.nav-ul .sub-menu {
    box-shadow: rgba(64,64,64,.3) 0 5px 20px;
}
input[type=submit] {
	background-color:#BF0A30;
}
input[type=submit]:hover {
	background-color:#222222;
}
ul.footer-menu a {
	color:#FFD700;
}
.m-style>ul>li>.wrap::after, .sm-style .sub-menu .wrap::after {
	background-color:#FFD700;
}
.builder-item--footer-menu {
	--hovercolor:white;
}
.builder-item--secondary-menu {
	--hovercolor:#FFD700;
}
.component-wrap p {
		display:none;
	}
.nv-single-post-wrap>div:not(:last-child) {
	margin-bottom:0px;
	padding-bottom:0px;
	margin-top:0px;
	padding-top:0px;
}
.nv-content-wrap ul {
	margin-top:0px;
	margin-left:50px;
}
.nv-index-posts {
	margin-top:0px;
}
.nv-content-wrap ol {
	margin-top:0px;
	margin-bottom:0px;
	margin-left:50px;
}

.scroll-to-top {
	background-color:#BF0A30;
}
.scroll-to-top:hover {
	background-color:#830722;
}
ul.lcp_catlist {
	list-style:none;
}
ul.lcp_catlist li {
padding:5px;
border:2px solid white;
background-color:rgba(255,255,255,0.6)
}
img.lcp_thumbnail {
	float:left;
	padding:5px;
}
/*Global Button Classes */
.red-button {
	background-color:#BF0A30;
	padding:5px;
