                        <div class="content-main-container">
                                                    
                            <!-- OC Layout Element Conent Template -->
                            <!--normalTemplateStart--><div class="visuallyhidden"><h1 class='oc-page-title '>Home</h1></div><div id="main-content"><section class="row-index-1"><div class="row-container full-width clearfix"><div class="row-content-container fixed-width clearfix"><div class="custom-hero-embed">
  <div class="hero-video-wrapper">

    <button
      id="videoToggleBtn"
      type="button"
      aria-label="Pause background video"
      aria-pressed="true"
      class="video-control-button"
    >
      Pause
    </button>

    <div
      id="heroVideo"
      title="Denver seasonal scenes and events"
      tabindex="-1"
      aria-hidden="true"
    ></div>

  </div>
</div>

<style>

/* styles */
.row-index-1 .row-content-container {
    padding: 0;
    font-size: 1rem !important;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

/* Hero Section */
.custom-hero-embed .hero-video-wrapper {
    background: url('https://denvergov.org/files/assets/public/v/1/global-ccd/images/bg-images/denver-afternoon-union.jpg') center center / cover no-repeat;
    width: 100%;
    padding-top: 25rem;
    position: relative;
    overflow: hidden;
    display: block;
    height: auto;
}

/* Video div / iframe — hidden until playing */
.custom-hero-embed .hero-video-wrapper iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 101%;
    height: 370%;
    border: 0;
    pointer-events: none;

    transform: translate3d(-50%, -50%, 0);
    will-change: transform;

    opacity: 0;
    transition: opacity 0.6s ease;
}

/* Visible state — added via JS once video is playing */
.custom-hero-embed .hero-video-wrapper iframe.is-visible {
    opacity: 1;
}

/* Video control button */
.custom-hero-embed .video-control-button {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 100;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-radius: 3px;
}

.custom-hero-embed .video-control-button:hover {
    background: rgba(0, 0, 0, 0.85);
}

.custom-hero-embed .video-control-button:focus {
    outline: 2px solid #fff;
    outline-offset: 2px;
}

/* Row Layout */
.row-index-2 {
    position: relative;
}

@media screen and (max-width: 768px) {

    .custom-hero-embed .hero-video-wrapper {
        padding-top: 18rem;
    }

    .custom-hero-embed .hero-video-wrapper iframe {
        height: 200%;
    }

    .custom-hero-embed .video-control-button {
        font-size: 0.875rem;
        padding: 0.25rem 0.5rem;
    }

    .row-index-1 .row-content-container {
        flex-direction: column;
    }
}

@media screen and (max-width: 480px) {

    .custom-hero-embed .hero-video-wrapper {
        padding-top: 14rem;
    }

    .custom-hero-embed .hero-video-wrapper iframe {
        height: 350%;
    }

    .custom-hero-embed .video-control-button {
        padding: 0.25rem 0.5rem;
    }
}

</style>

<script>
var player;
var isPlaying = true;
var hasRevealed = false;

/* Load YouTube IFrame API */
var tag = document.createElement('script');
tag.src = 'https://www.youtube.com/iframe_api';
var firstScriptTag = document.getElementsByTagName('script')[0];
firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

/* YouTube API calls this automatically when ready */
function onYouTubeIframeAPIReady() {

    player = new YT.Player('heroVideo', {
        videoId: 'YXLIgU3J4_c',
        playerVars: {
            autoplay: 1,
            mute: 1,
            controls: 0,
            showinfo: 0,
            rel: 0,
            loop: 1,
            playlist: 'YXLIgU3J4_c',
            modestbranding: 1,
            iv_load_policy: 3,
            disablekb: 1,
            fs: 0,
            playsinline: 1,
            origin: window.location.origin
        },
        events: {
            onReady: onPlayerReady,
            onStateChange: onPlayerStateChange
        }
    });
}

function onPlayerReady(event) {
    event.target.mute();
    event.target.playVideo();
}

function onPlayerStateChange(event) {

    /* Reveal iframe only once playback actually starts */
    if (event.data === YT.PlayerState.PLAYING && !hasRevealed) {
        var iframe = document.querySelector('#heroVideo iframe, iframe#heroVideo');
        if (!iframe) {
            iframe = player.getIframe();
        }
        if (iframe) {
            iframe.classList.add('is-visible');
        }
        hasRevealed = true;
    }

    /* Loop the video when it ends */
    if (event.data === YT.PlayerState.ENDED) {
        player.seekTo(0);
        player.playVideo();
    }
}

document.addEventListener('DOMContentLoaded', function () {

    var btn = document.getElementById('videoToggleBtn');

    btn.addEventListener('click', function () {

        try {

            var state = player.getPlayerState();

            if (state === YT.PlayerState.PAUSED || state === YT.PlayerState.ENDED) {

                player.playVideo();

                btn.textContent = 'Pause';
                btn.setAttribute(
                    'aria-label',
                    'Pause background video'
                );
                btn.setAttribute(
                    'aria-pressed',
                    'true'
                );

                isPlaying = true;

            } else {

                player.pauseVideo();

                btn.textContent = 'Play';
                btn.setAttribute(
                    'aria-label',
                    'Play background video'
                );
                btn.setAttribute(
                    'aria-pressed',
                    'false'
                );

                isPlaying = false;
            }

        } catch (e) {
            console.error(e);
        }
    });

    document.addEventListener('keydown', function (e) {

        if (
            ['INPUT', 'TEXTAREA', 'SELECT']
            .includes(document.activeElement.tagName)
        ) {
            return;
        }

        if (
            e.code === 'Space' ||
            e.key.toLowerCase() === 'p'
        ) {
            e.preventDefault();
            btn.click();
        }
    });

});
</script></div></div></section><section class="row-index-2"><div class="row-container full-width clearfix"><div class="row-content-container fixed-width clearfix"><div class="embed-homepage-row">
