c/chunks/9941-54720793fd9934ae.js\",\"8615\",\"static/chunks/8615-6279d500d750b71d.js\",\"81\",\"static/chunks/81-7e12cfdea3734f89.js\",\"1776\",\"static/chunks/1776-c31a6571b6287de1.js\",\"7481\",\"static/chunks/app/%5Blang%5D/%5B%5B...slug%5D%5D/page-22ba0007c2b34a33.js\"],\"PortableTextClient\"]\n"])</script><script>self.__next_f.push([1,"5:[[\"$\",\"$L1f\",null,{\"links\":[{\"text\":\"RTD \",\"url\":\"/\"},{\"text\":\"About RTD\",\"url\":\"/about-rtd\"},{\"text\":\"Board of Directors\",\"url\":\"/about-rtd/board-of-directors\"},{\"text\":\"RTD Redistricting Process\",\"url\":\"/about-rtd/board-of-directors/rtd-redistricting-process\"}],\"lang\":\"en\"}],[\"$\",\"div\",null,{\"className\":\"xl:pt-[45px]\",\"children\":[null,[\"$\",\"main\",null,{\"children\":[false,[\"$\",\"$L1b\",null,{\"lang\":\"en\",\"scope\":\"renderBlocks\",\"children\":[[\"$\",\"div\",\"aa0b93b6b2e0\",{\"className\":\"py-12 lg:py-24 relative bg-red min-h-[228px] md:min-h-[300px] lg:min-h-[386px]\",\"children\":[[\"$\",\"picture\",null,{\"children\":[\"$\",\"img\",null,{\"sizes\":\"(max-width: 570px) 768px, (max-width: 768px) 1140px, (max-width: 1140px) 1600px, (max-width: 1600px) 2880px, 100vw\",\"alt\":\"\",\"src\":\"https://cdn.rtd-denver.com/image/upload/v1698277006/thumbnail-25_oezktj_e8c7f0.jpg\",\"className\":\"absolute inset-0 w-full h-full object-cover\",\"srcSet\":\"https://cdn.rtd-denver.com/image/upload/t_hero_sm/v1698277006/thumbnail-25_oezktj_e8c7f0.jpg 570w,https://cdn.rtd-denver.com/image/upload/t_hero_md/v1698277006/thumbnail-25_oezktj_e8c7f0.jpg 768w,https://cdn.rtd-denver.com/image/upload/t_hero_lg/v1698277006/thumbnail-25_oezktj_e8c7f0.jpg 1140w,https://cdn.rtd-denver.com/image/upload/t_hero_xl/v1698277006/thumbnail-25_oezktj_e8c7f0.jpg 1600w,https://cdn.rtd-denver.com/image/upload/t_hero_xxl/v1698277006/thumbnail-25_oezktj_e8c7f0.jpg 2880w\"}]}],[\"$\",\"div\",null,{\"className\":\"page-gutter-max\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 lg:gap-8 relative z-10  max-w-2xl\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-heading-xl lg:text-heading-5xl font-bold lg:font-extrabold text-white\",\"children\":\"RTD Redistricting Process\"}],\"$undefined\",\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"absolute w-full h-full top-0 right-0 z-0 bg-black/20 bg-gradient-to-r from-black/50 to-black/10\"}]]}]]}],[\"$\",\"$L20\",\"70fed75360b6\",{\"blocks\":[{\"_type\":\"block\",\"_key\":\"1548cbb5ad42\",\"children\":[{\"_key\":\"3bbcec377c3e0\",\"_type\":\"span\",\"text\":\"RTD Redistricting Process\",\"marks\":[]}],\"markDefs\":[],\"style\":\"h2\"},{\"_type\":\"block\",\"_key\":\"f590b7141c08\",\"children\":[{\"_key\":\"4768f29d7b300\",\"_type\":\"span\",\"text\":\"State Statute requires that, following each federal census, the RTD Board of Directors “… apportion the composition of the Board into compact and contiguous director districts so that the fifteen directors will represent, to the extent practical, the people of the district on the basis of population.\\\" This redistricting must be completed before March 15 of the second year following the year in which the federal census is taken - in this case March 15, 2022. The approval of the redistricting requires a two-thirds majority of the full Board. If this deadline is not met, the State Legislative Council -- with assistance from the Director of Research of the Legislative Council and the Director of the Office of Legislative Legal Services will create the new Director District map.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"},{\"_type\":\"block\",\"_key\":\"bb91e866b143\",\"children\":[{\"_key\":\"5b6c51697b250\",\"_type\":\"span\",\"text\":\"RTD has engaged the consultant services of Farnsworth Group to assist with the preparation of the redistricting map for the Board's review, comments, and approval. Board Chair Malpiede has appointed Directors Broom and Sloan to the Redistricting Ad Hoc Committee to work with staff and the consultant to review alternatives and to recommend to the full Board a new Director District map. The Redistricting Ad Hoc Committee began meeting in September and will solicit input from each Director. The Redistricting Ad Hoc Committee future meeting dates will be posted on the RTD Board webpage’s Two Week Calendar.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"className\":\"my-8 page-gutter-max\",\"enableTracking\":\"$undefined\",\"trackingPrefix\":\"$undefined\",\"roundedImageCorners\":\"$undefined\",\"lang\":\"en\"}],\"$L21\",\"$L22\",\"$L23\"]}]]}]]}]]\n"])</script><script>self.__next_f.push([1,"24:I[5626,[\"4698\",\"static/chunks/fcee9500-a813d998f46701e6.js\",\"3549\",\"static/chunks/2aa41ec9-cfd64f40ad3de902.js\",\"9031\",\"static/chunks/1d507643-274314370575615f.js\",\"4819\",\"static/chunks/3d015ae9-af4365b308bddae0.js\",\"9576\",\"static/chunks/9576-9c7033f1c33d392f.js\",\"7181\",\"static/chunks/7181-b84e97a4f8f19fdb.js\",\"1001\",\"static/chunks/1001-f011938a5f348201.js\",\"1486\",\"static/chunks/1486-0e05ccdb9040dea9.js\",\"1998\",\"static/chunks/1998-2fef0964ea38d5ac.js\",\"5852\",\"static/chunks/5852-3368d3a7ed818e91.js\",\"6215\",\"static/chunks/6215-1e5ce9664fd53db5.js\",\"6966\",\"static/chunks/6966-a0e471e0e2934c5e.js\",\"7148\",\"static/chunks/7148-aa2b7ade8875d6d8.js\",\"9941\",\"static/chunks/9941-54720793fd9934ae.js\",\"8615\",\"static/chunks/8615-6279d500d750b71d.js\",\"81\",\"static/chunks/81-7e12cfdea3734f89.js\",\"1776\",\"static/chunks/1776-c31a6571b6287de1.js\",\"7481\",\"static/chunks/app/%5Blang%5D/%5B%5B...slug%5D%5D/page-22ba0007c2b34a33.js\"],\"CallToAction\"]\n"])</script><script>self.__next_f.push([1,"21:[\"$\",\"div\",\"b2eecb44f137\",{\"className\":\"page-gutter-max my-8\",\"children\":[\"$\",\"div\",null,{\"id\":\"$undefined\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-heading font-bold text-gray-800 mb-4\",\"children\":\"Upcoming Meetings\"}],\"$undefined\",[\"$\",\"ol\",null,{\"className\":\"flex gap-8 flex-wrap\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"w-fit\",\"children\":[\"$\",\"$L24\",null,{\"displayType\":\"button\",\"size\":\"md\",\"className\":\"bg-white w-full text-gray-800 p-4 rounded-xl border border-gray-100 [\u0026\u003esvg]:text-red\",\"showIcon\":true,\"variant\":\"secondary\",\"enableTracking\":false,\"trackingPrefix\":\"$undefined\",\"url\":\"https://rtd.iqm2.com/Citizens/Default.aspx\",\"text\":\"Meeting Calendar\",\"type\":\"external\",\"blockName\":\"extRes\",\"iconOptions\":{\"icon\":\"external\",\"iconSide\":\"left\"},\"openInNewTab\":true,\"tracking\":\"$undefined\"}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"22:[\"$\",\"$L20\",\"3932b618c6c5\",{\"blocks\":[{\"_type\":\"block\",\"_key\":\"f074855fba6a\",\"children\":[{\"_key\":\"1a037b12f8db0\",\"_type\":\"span\",\"text\":\"Redistricting Comments\",\"marks\":[]}],\"markDefs\":[],\"style\":\"h2\"},{\"_type\":\"block\",\"_key\":\"c09574e2b2a7\",\"children\":[{\"_key\":\"77bd8593e7060\",\"_type\":\"span\",\"text\":\"We would like to hear from you. Do you have any comments on the proposed maps?\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\"}],\"className\":\"my-8 page-gutter-max\",\"enableTracking\":\"$undefined\",\"trackingPrefix\":\"$undefined\",\"roundedImageCorners\":\"$undefined\",\"lang\":\"en\"}]\n23:[\"$\",\"div\",\"5b87ba5acfc8\",{\"className\":\"page-gutter-max\",\"children\":[\"$\",\"iframe\",null,{\"title\":\"Redistricting Comments\",\"src\":\"https://rtddenver.wufoo.com/forms/?formname=m14162sf0qpm1kl\u0026embed=1\u0026header=hide\",\"className\":\"w-full\",\"height\":437,\"sandbox\":\"allow-popups-to-escape-sandbox allow-top-navigation allow-scripts allow-popups allow-forms allow-same-origin\",\"data-chromatic\":\"ignore\"}]}]\n"])</script></body></html>