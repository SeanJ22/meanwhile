            <div class="content">
                
                    <h1 class=show-for-sr>2026 November Town Election Ballots</h1>
                <h1 style="text-align: center;"><strong>November 3, 2026</strong></h1>
<h1 style="text-align: center;"><strong>State Election Sample&nbsp;</strong><strong>Town Ballots</strong></h1>
<div style="text-align: center;">&nbsp;</div>
<div style="text-align: left;">(Click on town to view ballot)&nbsp;<strong>Please note: The sample ballots will be listed on a rolling basis as they become available. Updated 10/21/2026</strong></div>
<div style="text-align: center;">
<table border="1" cellspacing="0" cellpadding="0" style="width: 100%;">
    <tbody>
        <tr>
            <td valign="bottom" style="padding: 0in 5.4pt; border: 1pt solid black; border-image: none; width: 119.7pt; text-align: left; background-color: transparent;">
            <p style="margin: 0in 0in 0pt; text-align: center;"><a href="https://portal.ct.gov/-/media/sots/electionservices/town_ballots/2026/nov-ada-2026/andover_sample_ada.pdf?rev=5cfdbdb54428458a95cac91cc1c81c2c&amp;hash=2275ED2D4933F66237158C5274A4437B" target="_self">Andover</a>
            </p>
            </td>
            <td valign="bottom" style="border-width: 1pt 1pt 1pt medium; border-style: solid solid solid none; border-color: black black black #f0f0f0; padding: 0in 5.4pt; width: 119.7pt; text-align: left; background-color: transparent;">
            <p style="margin: 0in 0in 0pt; text-align: center;"><a href="https://portal.ct.gov/-/media/sots/electionservices/town_ballots/2026/nov-ada-2026/east-lyme-sample.pdf?rev=39bfb5f7d526478ca663d7e46d77792c&amp;hash=889752A0EA01F484F8551C1D13088E70" target="_self">East Lyme</a></p>
            </td>
            <td valign="bottom" style="border-width: 1pt 1pt 1pt medium; border-style: solid solid solid none; border-color: black black black #f0f0f0; padding: 0in 5.4pt; width: 119.7pt; text-align: left; background-color: transparent;">
            <p style="margin: 0in 0in 0pt; text-align: center;"><a href="https://portal.ct.gov/-/media/sots/electionservices/town_ballots/2026/nov-ada-2026/morris_sample.pdf?rev=06ad0a9dfb3b4d5e8ed3cc69369a9b2d&amp;hash=03270D74EBB9C14F2ED3AB66AF18C8C1" target="_self">Morris</a></p>
            </td>
            <td valign="bottom" style="border-width: 1pt 1pt 1pt medium; border-style: solid solid solid none; border-color: black black black #f0f0f0; padding: 0in 5.4pt; width: 119.7pt; text-align: left; background-color: transparent;">
            <p style="margin: 0in 0in 0pt; text-align: center;"><a href="https://portal.ct.gov/-/media/sots/electionservices/town_ballots/2026/nov-ada-2026/south-windsor-sample.pdf?rev=9213ff261dc7412ca389a9dd45e8fe9f&amp;hash=3075A75CA3E24FEBA60D9E6881605A46" target="_self">South Windsor</a></p>
            </td>
        </tr>
        <tr>
            <td valign="bottom" style="border-width: medium 1pt 1pt; border-style: none solid solid; border-color: #f0f0f0 black black; padding: 0in 5.4pt; width: 119.7pt; text-align: left; background-color: transparent;">
            <p style="margin: 0in 0in 0pt; text-align: center;"><a href="https://portal.ct.gov/-/media/sots/electionservices/town_ballots/2026/nov-ada-2026/ansonia_sample_ada.pdf?rev=0c9a2aec9f124fc68f0632ff1e802cde&amp;hash=DF7D66F4745D2D831BEDDC45FEA5238E" target="_self">Ansonia</a></p>
            </td>
            <td valign="bottom" style="border-width: medium 1pt 1pt medium; border-style: none solid solid none; border-color: #f0f0f0 black black #f0f0f0; padding: 0in 5.4pt; width: 119.7pt; text-align: left; background-color: transparent;">
            <p style="margin: 0in 0in 0pt; text-align: center;"><a href="https://portal.ct.gov/-/media/sots/electionservices/town_ballots/2026/nov-ada-2026/east_windsor_sample_ada.pdf?rev=2d961f4ab5be47cdad81e7fa05cf597b&amp;hash=FEF2D2EEEE104E8F879042EF14E3E664" target="_self">East Windsor</a></p>
            </td>
            <td valign="bottom" style="border-width: medium 1pt 1pt medium; border-style: none solid solid none; border-color: #f0f0f0 black black #f0f0f0; padding: 0in 5.4pt; width: 119.7pt; text-align: left; background-color: transparent;">
