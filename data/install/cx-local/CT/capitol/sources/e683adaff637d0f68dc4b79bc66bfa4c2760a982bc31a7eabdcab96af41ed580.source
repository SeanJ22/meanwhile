<!-- start Simple Custom CSS and JS -->
<script>
/* Default comment here */ 
jQuery(document).ready(function ($) {
  var $menuItems = $('.mega-menu-item-has-children');

  // Open submenu on focus or arrow keys
  $menuItems.children('a').on('focus keydown', function (e) {
    var $menuItem = $(this).parent();

    if (
      e.type === 'focus' ||
      e.key === 'ArrowRight' ||
      e.key === 'ArrowDown'
    ) {
      	$menuItem.addClass('mega-toggle-on');
      	$menuItem.children('.mega-sub-menu').attr('aria-hidden', 'false');
		
      // Arrow right moves focus into submenu
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        $menuItem.find('.mega-sub-menu a').first().focus();
      }
    }
  });

  // Keep submenu open while tabbing inside submenu
  $menuItems.on('focusin', function () {
    $(this).addClass('mega-toggle-on');
    $(this).children('.mega-sub-menu').attr('aria-hidden', 'false');
  });

  // Close only when focus leaves entire menu item
  $menuItems.on('focusout', function () {
    var $menuItem = $(this);

    setTimeout(function () {
      if (!$menuItem.find(':focus').length) {
        $menuItem.removeClass('mega-toggle-on');
        $menuItem.children('.mega-sub-menu').attr('aria-hidden', 'true');
      }
    }, 10);
  });

  // Close on Escape
  $menuItems.find('a').on('keydown', function (e) {
    if (e.key === 'Escape') {
      var $menuItem = $(this).closest('.mega-menu-item-has-children');

      $menuItem.removeClass('mega-toggle-on');
      $menuItem.children('.mega-sub-menu').attr('aria-hidden', 'true');
      $menuItem.children('a').focus();
    }
  });
});

jQuery(document).ready(function(){
	jQuery( document ).on( 'elementor/popup/show', ( event, id, instance ) => {
	    console.log( 'Popup ID ' + id + ' is now visible' );
	    if (id == 81838) { //If popup is the search form
			   setTimeout(() => {
			      jQuery('#search_site_input input').focus();
			   }, 300);
	    }
	});
	jQuery('.gt_selected a').attr('role', 'combobox');
	jQuery('.gt_selected a img').attr('alt', 'English');
	jQuery('.gt_option a').each(function() {
		jQuery(this).find('img').attr('alt', jQuery(this).attr('title'));
	});
	
	jQuery('.tribe-events-calendar-list__event-header').each(function () {
		var $header = jQuery(this);
		var $title = $header.find('.tribe-events-calendar-list__event-title');
		var $date = $header.find('.tribe-events-calendar-list__event-datetime-wrapper');

		if ($title.length && $date.length) {
			$date.insertBefore($title);
		}
	});

});</script>
