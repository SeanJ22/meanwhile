  <div class="clearfix text-formatted field field--name-body field--type-text-with-summary field--label-hidden field__items"><!-- Broward Votes AI Assistant Styles -->
<style>
  #chat-window {
    display: none;
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 420px;
    height: 620px;
    max-height: 85vh;
    background: white;
    border-radius: 16px;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  #chat-window iframe {
    display: block; /* kill the inline-baseline gap below the iframe */
  }

  /* Mobile Responsive Rule */
  @media (max-width: 768px) {
    #chat-window {
      position: fixed;
      bottom: 90px;
      right: 15px;
      left: 15px;
      width: auto;
      height: 75dvh;
      max-height: none;
    }
  }
</style>

<!-- Broward Votes AI Assistant Widget -->
<div
  id="bv-chat-widget"
  style="
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 999999;
    font-family: sans-serif;
  "
>
  <!-- The Floating Toggle Button (closed = LIVE CHAT icon, open = blue circle with X) -->
  <button
    id="chat-toggle"
    style="
      background: transparent;
      color: white;
      width: 60px;
      height: 60px;
      border-radius: 18%;
      border: none;
      padding: 0;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    "
  >
    <span
      id="toggle-icon"
      style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%"
    >
      <img
        src="https://chat.browardvotes.gov/chatbot_blue.png"
        alt="Live chat"
        style="width: 100%; height: 100%; display: block"
      />
    </span>
  </button>

  <!-- The Hidden Chat Window -->
  <div id="chat-window">
    <iframe
      src="https://chat.browardvotes.gov"
      width="100%"
      height="100%"
      frameborder="0"
      title="Broward Votes AI Assistant"
      allow="clipboard-write"
    ></iframe>
  </div>
</div>

<script>
  (function () {
    const btn = document.getElementById("chat-toggle");
    const win = document.getElementById("chat-window");
    const icon = document.getElementById("toggle-icon");

    // Pure strings to prevent Character Encoding issues in CMS systems
    const chatImg =
      '<img src="https://chat.browardvotes.gov/chatbot_blue.png" alt="Live chat" style="width:100%;height:100%;display:block;">';
    const closeSvg =
      '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';

    btn.onclick = () => {
      // Toggle logic
      const isHidden = window.getComputedStyle(win).display === "none";
      win.style.display = isHidden ? "block" : "none";
      icon.innerHTML = isHidden ? closeSvg : chatImg;
      // Open: blue circle with white X. Closed: the icon supplies its own
      // rounded-square background, so the button goes transparent.
      btn.style.background = isHidden ? "#004a98" : "transparent";
      btn.style.borderRadius = isHidden ? "50%" : "18%";
      btn.style.transform = isHidden
        ? "scale(0.9) rotate(90deg)"
        : "scale(1) rotate(0deg)";

      if (isHidden) {
        // Send a 'ready' signal to the iframe
        win.querySelector("iframe").contentWindow.focus();
      }
    };
  })();
</script>

  </div>
