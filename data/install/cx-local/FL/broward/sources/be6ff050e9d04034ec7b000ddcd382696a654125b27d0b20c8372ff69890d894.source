<!--OG: TOP TASKS BUTTONS-->

<style>
	
	
@media (min-width: 992px) {
/* Home buttons */

div#main-content section.row-index-1 div.row-container.full-width.clearfix div.row-content-container.fixed-width.clearfix div.profile-hero-container div.profile-video-listing div.ocp-video-banner.ocp-override.mobile-enabled {
    min-height: 500px;
}
div#main-content section.row-index-2 div.row-container.full-width.clearfix div.row-content-container.fixed-width.clearfix {
    margin-top: -146px;
}
/*Home page - Meetings tab section - height adjust*/
	
div#tabs-body.tab-group-body div#panel-2.tabs-panel.clearfix.tab-type-default.total-results-unknown.selected div.wysiwyg-content.body-content div div.profile-listing-container.profile-meetings-listing-container.profile-meetings-listing-option-1.clearfix div.profile-events-listing.without-images.clearfix div.grid div.col-xs-12.col-m-6.col-lg-4 a.profile-list {
    min-height: 350px;
}
	

/*	Home Page - Meeting Tiles*/
	
.profile-events-listing a {
    min-height: 310px;
}
}
/*----------------------END MQ-- min-width: 992px --------------------	*/
	
/* Home page - Pinned Story display workaround ------------------- 768PX TO 1024PX -- */

@media only screen and (min-width: 768px) and (max-width: 1024px) {
.profile-news-listing .grid .list-first-item a.profile-list {
    display: block;
}
.profile-news-listing .grid .list-first-item a.profile-list picture::after {
    display: none;
}
}
/*------------------------------------------*/

/*Removes border from iframes*/
iframe {
    border: none;
}
/*Back to Top Scroll button*/
#back-to-top {
    bottom: 166px !important;
}
/*USERWAY WIDGET*/
body .uwy.userway_p5 .userway_buttons_wrapper {
    bottom: 21px !important;
}
/*Calendar*/

.calendar-body-content-day.today {
    background-color: #F4F8FC;
}
.calendar-day-dialog .calendar-btn, .calendar-item-dialog .calendar-btn, .calendar-nav .calendar-btn {
    background-color: #F4F8FC;
}
/* --- Responsive Tables ---*/	
table.sc-responsive-table thead tr th, table.sc-responsive-table-heading thead tr th {
    border-color: #fff !important;
}
table.sc-responsive-table thead tr th p strong, table.sc-responsive-table thead tr th p {
    color: #fff !important;
}
/*pdf link file info*/
a.featured-link.document.ext-pdf.opens-in-new-tab span.file-info, a.document.ext-pdf span.file-info {
    display: none;
}
	
/*	Home Page - Event Tiles*/

.tabs-panel .large-thumbnail-image, .tabs-panel .more-than-3-items .item-0 .large-thumbnail-image {
    display: block !important;
}


</style>
    

