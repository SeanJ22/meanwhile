"news-section custom-section\\\" id=\\\"section-news\\\">\\n    <div class=\\\"title-container see-all-top\\\">\\n        <div id=\\\"news-title\\\" class=\\\"header-slot-container\\\">\\n            <h2>Team Duval News</h2>\\n        </div>\\n      <span class=\\\"button square outline\\\">\\n        <a href=\\\"{{section_page_url}}\\\" class=\\\"js-news-more-button see-all-button\\\">View More</a>\\n      </span>\\n    </div>\\n    <div id=\\\"news-articles-list\\\" class=\\\"articles-container\\\">\\n        <cms-media loop=\\\"3\\\">\\n            <a href=\\\"{{entry_url}}\\\" class=\\\"news-article\\\">                \\n                {{cover_image}}                \\n                <div class=\\\"content\\\">\\n                    <div class=\\\"date\\\">{{date}}</div>\\n                     \\n                        <h3 class=\\\"h3 title line-clamp-2\\\">{{title}}</h3>\\n                     \\n                     <p class=\\\"excerpt line-clamp-2\\\">{{snippet}}</p>\\n                    <div class=\\\"readmore\\\"><span\\n                            class=\\\"read-article-btn\\\">Read more</span></div>\\n                </div>\\n            </a>\\n        </cms-media> \\n    </div>\\n  <div class=\\\"button square outline mt-16 w-full laptop:hidden\\\">\\n      <span><a href=\\\"{{section_page_url}}\\\">View More</a></span>\\n    </div>\\n</div>\",\"scss_code\":\".custom-section {\\n  display: block !important;\\n}\",\"container_id\":\"media-custom-html-f9cfec41-d6f5-4807-b8df-83d5bc5c1de4\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#FFC425\"}}},{\"id\":\"31770eb3-330d-49cc-8388-4ddae6132e71\",\"type\":\"Fullwidth\",\"components\":[{\"name\":\"Custom Component\",\"options\":{\"global\":false,\"js_code\":\"const videoStoriesLightbox = GLightbox({ \\n  selector: '.video-link a',\\n  autoplayVideos: true,\\n  width: '90vw',\\n  height: '90vh'\\n});\\n\\ndocument.addEventListener('appLoaded', () => {\\n  document.querySelectorAll('.video-stories .video-stories-slides > div').forEach(slide => slide.classList.add('swiper-slide'));\\n\\n  new Swiper('.video-stories', {\\n    speed: 400,\\n      spaceBetween: 16,\\n      simulateTouch: true,\\n      slidesPerView: 1,\\n      centeredSlides: true,\\n      rewind: true,\\n     initialSlide: 2,\\n      // loop: true,\\n      // autoplay: {\\n      //   delay: 4500,\\n      //   disableOnInteraction: false,\\n      // },\\n      navigation: {\\n        nextEl: '.stories-swiper-button-next',\\n        prevEl: '.stories-swiper-button-prev',\\n      },\\n      breakpoints: {\\n        680: {\\n          slidesPerView: 2,\\n        },\\n        980: {\\n          slidesPerView: 3,\\n        },\\n      },\\n  });\\n});\\n\",\"css_code\":\"#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 {\\n  /* styling for CMS */\\n  /* can be with display: none in edit template code to be hidden as default */\\n}\\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 .custom-section {\\n  display: block !important;\\n}\\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 .custom-section:has(.link-actions) {\\n  padding: 20px;\\n}\\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 .custom-section:has(.link-actions) .hide-on-cms {\\n  display: none !important;\\n}\\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 label.only-in-cms {\\n  font-size: 16px;\\n  font-weight: 600;\\n  margin-top: 15px;\\n  margin-bottom: 10px;\\n  display: block;\\n  letter-spacing: 0.03em;\\n}\\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 label.only-in-cms:nth-child(2) {\\n  margin-top: 0;\\n}\\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 .custom-section:not(:has(.link-actions)) .only-in-cms {\\n  display: none !important;\\n}\\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 .custom-section .homepage-image-wrapper img.image-container-image {\\n  display: block;\\n  width: auto;\\n  height: auto;\\n  object-fit: contain;\\n  min-height: 1