"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}}]},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"columnsCount\":4,\"isLightbox\":false,\"showCaptions\":false,\"captionsAlignment\":\"center\"}}]}],\"parentAccordionId\":\"5ecd72c4-9019-495a-866b-9ae770efc844\"}]}]},{\"id\":\"06ada2e6-a342-436e-a4c3-bc9ec8ba0c4e\",\"name\":\"Card\",\"type\":\"CONTENT_NODE_CARD\",\"content\":{\"heading\":{\"id\":\"cardTitle_06ada2e6-a342-436e-a4c3-bc9ec8ba0c4e\",\"name\":\"Heading\",\"type\":\"CONTENT_NODE_HEADING\",\"content\":{\"html\":\"<h3><span>Cindy Pearson</span></h3>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"text\":{\"id\":\"cardContent_06ada2e6-a342-436e-a4c3-bc9ec8ba0c4e\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">Board Member</span></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">District 3</span></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"mailto:PearsonC1@duvalschools.org\\\">Email Cindy Pearson</a></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"tel:+19043902239\\\">904-302-4403</a></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"image\":{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3403865/a8929ee0-c9d8-4d18-a691-4f5ef7e70e5b.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3403865/a8929ee0-c9d8-4d18-a691-4f5ef7e70e5b.png\",\"assetId\":3403865,\"altText\":\"Cindy Pearson\"},\"properties\":{\"isDecorative\":false,\"naturalWidth\":450,\"naturalHeight\":450,\"focalPointPosition\":{\"x\":50,\"y\":50}}}},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"design\":\"box-shadow\",\"showImage\":true,\"showHeadline\":true,\"imagePosition\":\"left\",\"wrapText\":false,\"textCursor\":0,\"headlineCursor\":0}},{\"id\":\"2c3b0ddd-4ebe-4687-bf3d-71b714f2155b\",\"name\":\"Accordion\",\"type\":\"CONTENT_NODE_ACCORDION\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"iconStyle\":\"caret\",\"allowMultipleOpenPanels\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"d1821431-8c5a-43ab-8ae1-6551128f1728\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"About \",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"5d120ec9-8b6d-4a52-a3b1-9da806a7c20d\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">Cindy Pearson is a Jacksonville native who attended Duval County Public Schools K-12. She and her husband, Scott, have two students who graduated from DCPS schools and one student who currently attends a DCPS school. Cindy was elected to Duval County School Board in 2020 and re-elected in 2024.</span></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">&nbsp;Cindy holds a Bachelor of Arts in English from Florida State University and a Master of Science in Recreation Studies from University of Florida. She has worked for a city government and for a faith-based not-for-profit organization.</span></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">&nbsp;Cindy brings experience in mobilizing parents and community members to support local schools. She has worked to build a broad coalition of people who care about our public schools. She believes that we need to hear from many voices and many perspectives on how to create a countywide system of thriving schools.</span></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}}]}],\"parentAccordionId\":\"2c3b0ddd-4ebe-4687-bf3d-71b714f2155b\"},{\"id\":\"aeee2a5d-83c5-43ff-983b-42c522755a0a\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"List of Schools\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"dd5032c6-5620-4888-bfae-73c9e6a4a530\",\"name\":\"Table\",\"type\":\"CONTENT_NODE_TABLE\",\"content\":{\"html\":\"<table style=\\\"width: 100%; min-width: 100px\\\"><colgroup><col style=\\\"min-width: 100px\\\"></colgroup><tbody><tr><th colspan=\\\"1\\\" rowspan=\\\"1\\\" scope=\\\"col\\\"><p><strong>School Name</strong></p></th></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/ar\\\">Alden Road Exceptional Student Center</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/aims\\\">Alfred I. duPont Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/beauclerc\\\">Beauclerc Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/brookview\\\">Brookview Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/dahs\\\">Douglas Anderson School of the Arts</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/englewood\\\">Englewood Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><