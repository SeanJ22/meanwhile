a former NFL player. \",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":3024,\"naturalHeight\":3024,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4621896/8e97c8e8-94b5-4f7f-98ad-3be795776b97.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4621896/8e97c8e8-94b5-4f7f-98ad-3be795776b97.png\",\"assetId\":4621896,\"altText\":\"Children and Reginald Blount sitting in auditorium.\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":2973,\"naturalHeight\":2973,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4621717/474f0835-5e69-44f1-98f2-fb5b750b3732.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4621717/474f0835-5e69-44f1-98f2-fb5b750b3732.png\",\"assetId\":4621717,\"altText\":\"A boy getting a book from an adult female, and other students are in the background.\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":3024,\"naturalHeight\":3024,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4621725/6b18e1e9-2346-47c1-a4a6-3f1289b75af9.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4621725/6b18e1e9-2346-47c1-a4a6-3f1289b75af9.jpeg\",\"assetId\":4621725,\"altText\":\"Boys and girls getting books.\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}}]},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"columnsCount\":4,\"isLightbox\":false,\"showCaptions\":false,\"captionsAlignment\":\"center\"}},{\"id\":\"dc6dc78d-b414-4555-b348-0863feb66086\",\"name\":\"Gallery\",\"type\":\"CONTENT_NODE_GALLERY\",\"content\":{\"images\":[{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622332/5b5f2af9-9b69-47ff-9058-1bd673e0da13.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622332/5b5f2af9-9b69-47ff-9058-1bd673e0da13.png\",\"assetId\":4622332,\"altText\":\"Reginald Blount and a female teacher\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":443,\"naturalHeight\":443,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622339/78b09c03-5253-4ff2-8834-348dee67495d.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622339/78b09c03-5253-4ff2-8834-348dee67495d.jpeg\",\"assetId\":4622339,\"altText\":\"Reginald Blount with a female teacher\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}}]},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"columnsCount\":4,\"isLightbox\":false,\"showCaptions\":false,\"captionsAlignment\":\"center\"}}]}],\"parentAccordionId\":\"1f86108c-8f57-4ade-90bb-6405a4382d26\"}]}]},{\"id\":\"2c97583a-3223-43f4-a8be-60c260ffe105\",\"name\":\"Card\",\"type\":\"CONTENT_NODE_CARD\",\"content\":{\"heading\":{\"id\":\"cardTitle_2c97583a-3223-43f4-a8be-60c260ffe105\",\"name\":\"Heading\",\"type\":\"CONTENT_NODE_HEADING\",\"content\":{\"html\":\"<h3><span>Charlotte D. Joyce</span></h3>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"text\":{\"id\":\"cardContent_2c97583a-3223-43f4-a8be-60c260ffe105\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">Chair</span></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">District 6</span></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"mailto:joycec@duvalschools.org\\\">Email Charlotte D. Joyce</a></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"tel:+19043902373\\\">904-390-2373</a></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"image\":{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3403937/637ddefa-a1b2-48e5-b814-7097efc55b8b.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3403937/637ddefa-a1b2-48e5-b814-7097efc55b8b.png\",\"assetId\":3403937,\"altText\":\"Charlotte D. Joyce\"},\"properties\":{\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}}},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"design\":\"box-shadow\",\"showImage\":true,\"showHeadline\":true,\"imagePosition\":\"left\",\"wrapText\":false,\"textCursor\":0,\"headlineCursor\":0}},{\"id\":\"2a3703ad-d578-40e1-bf4c-f493d75899dd\",\"name\":\"Accordion\",\"type\":\"CONTENT_NODE_ACCORDION\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"iconStyle\":\"caret\",\"allowMultipleOpenPanels\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"bf87d5f2-397f-4e01-abb0-0579d8edda76\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"About \",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"726629b3-ac37-48c6-98a3-020a7ce20443\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p><span style=\\\"font-size: 16px\\\">Charlotte was born and raised on Jacksonville’s westside and is deeply invested in her community, particularly in our children’s education. She attended Joseph Stilwell Jr. High (now the Joseph Stilwell Military Academy of Leadership) and graduated from Ed White High School (now known as the Edward H. White Military Academy of Leadership).&nbsp;</span><br><br><span style=\\\"font-size: 16px\\\">After graduating from the University of North Florida, magna cum laude, with a Bachelor of Arts degree in political science, Charlotte began her teaching career at Stilwell. Before that, she was a homeschool mom, and also spent many years as a substitute teacher.&nbsp; She has had the privilege of instructing students all of the district in many of the classrooms around our city.&nbsp;</span><br><br><span style=\\\"font-size: 16px\\\">As an educator, Charlotte has a first-hand appreciation for the joys and challenges that are common to all students and teachers. As a Magnet Coordinator, Charlotte developed an in-depth understanding of academic and discipline data, the budget process, market development, ESE training, and student incentive promotions, and the need for parental involvement.&nbsp;</span><br><br><span style=\\\"font-size: 16px\\\">In 2014, Joseph Stilwell became a dedicated magnet school. Because of Charlotte’s experience as a “magnet school mom” – her own children attended Duval County Magnet Schools – she knew that successful schools require invested parents. She founded the Leadership Booster Club at Stilwell to develop community support and raise money for the magnet program. The Booster Club has played a vital role in funding the school’s leadership program. As the former parent liaison, she also oversaw parent groups such as SAC and PTSA. One of Charlotte’s children is a proud Stilwell cadet.&nbsp;</span><br><br><span style=\\\"font-size: 16px\\\">Charlotte has five children of her own and understands a parent’s desire to have his/her children delivered a world-class education. Experience has taught her that each child is unique and, as a result, may need a specialized program to maximize the likelihood of success. For this reason, Charlotte is a champion for school choice. She has witnessed, in the transformation of Joseph Stilwell, how Duval County’s magnet school program has transformed communities and lives.</span><br><br><span style=\\\"font-size: 16px\\\">Charlotte also enjoys advocating for agricultural education in our community.&nbsp; She works with Duval County Farm Bureau’s women’s leadership program in furtherance of that commitment.</span></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}}]}],\"parentAccordionId\":\"2a3703ad-d578-40e1-bf4c-f493d75899dd\"},{\"id\":\"97b53ea6-7657-479c-b00d-b6ca8ef4f7b9\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"List of Schools\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"35711123-b4ef-444b-919e-5b8d6b72ca8f\",\"name\":\"Table\",\"type\":\"CONTENT_NODE_TABLE\",\"content\":{\"html\":\"<table style=\\\"width: 100%; min-width: 100px\\\"><colgroup><col style=\\\"min-width: 100px\\\"></colgroup><tbody><tr><th colspan=\\\"1\\\" rowspan=\\\"1\\\" scope=\\\"col\\\"><p><strong>School Name</strong></p></th></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/bmsh\\\">Baldwin Middle-High School</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/chaffeetrail\\\">Chaffee Trail Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/ctms\\\">Chaffee Trail Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/cles\\\">Chimney Lakes Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/cse\\\">Crystal Springs Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/enterprise\\\">Enterprise Learning Academy</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/jhes\\\">Jacksonville Heights Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/stilwell\\\">Joseph Stilwell Military Academy of Leadership</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/majes\\\">Mamie Agnes Jones Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/nves\\\">Normandy Village Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/stt\\\">Sadie T. Tillis Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/tjes\\\">Thomas Jefferson Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/tes\\\">Timucuan Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/wehs\\\">Westside High School</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/westview\\\">Westview K-8 School</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/whitehouse\\\">Whitehouse Elementary</a></p></td></tr></tbody></table>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"alternatingColors\":true}}]}],\"parentAccordionId\":\"2a3703ad-d578-40e1-bf4c-f493d75899dd\"},{\"id\":\"6747d3a2-cbd6-442c-a86d-492f191c9c4b\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"Photo Gallery\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"b953ca91-9749-4b5c-9c75-c68492c739a3\",\"name\":\"Gallery\",\"type\":\"CONTENT_NODE_GALLERY\",\"content\":{\"images\":[{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3404044/81c6b7b5-45f6-407c-8473-480d893f8312.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3404044/81c6b7b5-45f6-407c-8473-480d893f8312.jpeg\",\"assetId\":3404044,\"altText\":\"Purple ball\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":496,\"naturalHeight\":496,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\