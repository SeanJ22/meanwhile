ties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}}]},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"columnsCount\":3,\"isLightbox\":false,\"showCaptions\":false,\"captionsAlignment\":\"center\"}},{\"id\":\"d583e96d-9feb-4fe7-9c53-aeb96226b71d\",\"name\":\"Gallery\",\"type\":\"CONTENT_NODE_GALLERY\",\"content\":{\"images\":[{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622659/10bff6f7-0f0e-4db9-b323-47eaa9ea6957.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622659/10bff6f7-0f0e-4db9-b323-47eaa9ea6957.png\",\"assetId\":4622659,\"altText\":\"Darryl Willie,another Board Member, children, and a group of adults playing soccer\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708594/7f308b16-c42e-4b9d-98d2-18ea90241d00.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708594/7f308b16-c42e-4b9d-98d2-18ea90241d00.png\",\"assetId\":4708594,\"altText\":\"Two men talking with a woman.\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708600/f4d8f900-37e7-43e5-bd75-7a3888296af8.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708600/f4d8f900-37e7-43e5-bd75-7a3888296af8.png\",\"assetId\":4708600,\"altText\":\"Group at Teacher Appreciation Event.\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}}]},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"columnsCount\":3,\"isLightbox\":false,\"showCaptions\":false,\"captionsAlignment\":\"center\"}}]}],\"parentAccordionId\":\"a164711e-fd78-4aca-98bc-b293744d76f0\"}]}]},{\"id\":\"48196e84-175e-47ef-8c09-12e1f9cbabaa\",\"name\":\"Card\",\"type\":\"CONTENT_NODE_CARD\",\"content\":{\"heading\":{\"id\":\"cardTitle_48196e84-175e-47ef-8c09-12e1f9cbabaa\",\"name\":\"Heading\",\"type\":\"CONTENT_NODE_HEADING\",\"content\":{\"html\":\"<h3>Reginald K. Blount</h3>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"text\":{\"id\":\"cardContent_48196e84-175e-47ef-8c09-12e1f9cbabaa\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">Board Member</span></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">District 5</span></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"mailto:BlountR@duvalschools.org\\\">Email Reginald K. Blount</a></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">904-390-2372</span></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"image\":{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989984/cb5a6494-ded6-4e3e-81bf-8b07cf76a358.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989984/cb5a6494-ded6-4e3e-81bf-8b07cf76a358.jpeg\",\"assetId\":3989984,\"altText\":\"Reginald Blount\"},\"properties\":{\"isDecorative\":false,\"naturalWidth\":3267,\"naturalHeight\":3267,\"focalPointPosition\":{\"x\":50,\"y\":50}}}},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"design\":\"box-shadow\",\"showImage\":true,\"showHeadline\":true,\"imagePosition\":\"left\",\"wrapText\":false,\"textCursor\":0,\"headlineCursor\":0}},{\"id\":\"1f86108c-8f57-4ade-90bb-6405a4382d26\",\"name\":\"Accordion\",\"type\":\"CONTENT_NODE_ACCORDION\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"iconStyle\":\"caret\",\"allowMultipleOpenPanels\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"0a713ccc-b376-4b70-ad1a-cf2ef8287cab\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"About\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"8fed7fbb-b1c7-479a-b43c-43ac3ce13cbe\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p><span style=\\\"font-size: 16px\\\">Reginald K. Blount is a lifelong resident of Jacksonville, Florida, and a respected community leader whose unwavering commitment to public service has earned him admiration throughout the region. A proud product of Duval County Public Schools, Reginald is a graduate of Paxon Senior High School. His educational journey includes an Associate’s degree in Commercial Graphics from Tampa Tech Institute, a Bachelor of Arts in Business Management, a Master’s in Public Policy from Liberty University, and a specialized graduate certificate in Security, Stability, and Development in Complex Operations from the Naval Postgraduate School. Additionally, he is a graduate of the Sergeant Major Academy Battle Staff Course and has held a TOP Secret Security Clearance/SCI.&nbsp;</span></p><p><span style=\\\"font-size: 16px\\\">With a distinguished 30-year career in the United States Army, Reginald completed four combat tours, including serving in Operation Desert Storm in Iraq, Bosnia, and Croatia, as well as two tours in Afghanistan. As Senior Team Leader for the Army’s Provincial Reconstruction Team under the U.S. Army Psychological Operations and Civil Affairs Command, he was instrumental in efforts in collaboration with U.S. government agencies, foreign dignitaries, and NGOs to assess and drive reconstruction initiatives in conflict zones. Reginald also served with the Joint Special Operations Command Task Forces in Afghanistan.</span></p><p><span style=\\\"font-size: 16px\\\">In 1995, Reginald was appointed to the Housing Policy and Education Council at Fort Knox, Kentucky, where he played a pivotal role in improving the quality of life for soldiers and their families. He later served as an assistant liaison for the U.S. Special Operations Capabilities and Equipment brief during Public Service Recognition Week in Washington, D.C., under the Obama Administration. In addition to his military and public service roles, Reginald has been an academic mentor and coach, leading high school track &amp; field teams both in the U.S. and abroad.&nbsp;</span></p><p><span style=\\\"font-size: 16px\\\">In 2017, Reginald chaired the restructuring committee for the Jacksonville Black Chamber, helping to revitalize the organization to better serve both residents and the business community. In addition, he contributed significantly to the development of the operations section of the adult continuing education program at Florida State College Jacksonville, where he served as Project Coordinator, Adjunct Instructor, and Childcare Assessment Coordinator. Today, Reginald continues to positively impact young lives by developing a life-skills curriculum for the male youth mentorship program at Biscayne High School.</span></p><p><span style=\\\"font-size: 16px\\\">His exceptional service has earned him numerous accolades including the Military Outstanding Volunteer Service Medal. A talented graphic artist, vocalist, and musician, Reginald has received national and international recognition for his work with the United States Army Band and Chorus Europe. He was also named to <em>Marquis Who’s Who</em> in America for 2024.&nbsp;</span></p><p><span style=\\\"font-size: 16px\\\">A devoted family man, Reginald is the proud father of six children, three of whom have followed in his footsteps into military service. He is an active member of the American Center for Law &amp; Justice, American Legion Post 197, the Disabled Veterans Association, and Omega Psi Phi Fraternity, Inc.</span></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}}]}],\"parentAccordionId\":\"1f86108c-8f57-4ade-90bb-6405a4382d26\"},{\"id\":\"c95417df-d45e-4ce4-8f21-bfdaa97e8b33\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"List of Schools\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"5231f182-9f6a-4655-a9b5-eda37d91708a\",\"name\":\"Table\",\"type\":\"CONTENT_NODE_TABLE\",\"content\":{\"html\":\"<table style=\\\"width: 100%; min-width: 100px\\\"><colgroup><col style=\\\"min-width: 100px\\\"></colgroup><tbody><tr><th colspan=\\\"1\\\" rowspan=\\\"1\\\" scope=\\\"col\\\"><p>School Name</p></th></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/aares\\\">Andrew A. Robinson Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/bes\\\">Bayview Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/biltmore\\\">Biltmore Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/bsms\\\">Bridge to Success Academy Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/ches\\\">Cedar Hills Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/cres\\\">Central Riverside Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/dchs\\\">Darnell-Cookman School of the Medical Arts</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/ewhs\\\">Edward H. White High</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/fes\\\">Fishweir Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/fhp\\\">Frank H. Peterson Academies of Technology</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/gdes\\\">Gregory Drive Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/hpes\\\">Hyde Park Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/JSA\\\"><span style=\\\"font-size: 16px\\\">Jacksonville STEM Academy</span></a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/jwms\\\">James Weldon Johnson College Preparatory</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/jefes\\\">John E. Ford Montessori</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/jlelces\\\">John Love Early Learning Center</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/jncses\\\">John N.C. Stockton Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/lsms\\\">Lake Shore Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/lavilla\\\">LaVilla School of the Arts</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/mgms\\\">Matthew W. Gilbert Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/mrae\\\">Mattie V. Rutherford Alternative Education Center</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/hesc\\\">Mount Herman Exceptional Student Center</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/o/ohas\\\">Oak Hill Academy</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a targe