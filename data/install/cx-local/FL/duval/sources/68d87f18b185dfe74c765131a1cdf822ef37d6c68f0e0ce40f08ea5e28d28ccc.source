</h1>\",\"content\":\"<p style=\\\"text-align: left\\\">Enriching the academic experience through extracurricular activities, off-site learning, and community partnerships.</p><p style=\\\"text-align: left\\\"><a rel=\\\"noopener noreferrer nofollow\\\" href=\\\"/\\\">Enroll Today</a></p>\",\"alt_text\":\"testing images\"}],\"widget\":{\"body\":\"\",\"link\":{\"href\":\"\",\"name\":\"\",\"target\":\"\"}}},\"parallax\":{},\"programs\":{\"33d993bd-1524-4543-910d-2e24e7e3241c_0\":{\"slider\":true,\"content\":[],\"see_all\":true,\"has_header\":true,\"has_snippet\":true,\"num_columns\":4,\"see_all_link\":{},\"read_more_link\":true,\"component_header\":\"Programs\",\"details_on_hover\":true,\"component_header_top\":\"Choose from our\"}},\"timeline\":{},\"athletics\":{},\"live_feed\":{\"74ba4b15-9027-4182-9ba6-bde4dfeef032_1\":{\"see_all_link\":{\"href\":\"/live-feed\",\"name\":\"See All Posts\",\"target\":\"_self\"},\"component_header\":\"Live Feed\",\"component_header_top\":\"Latest\"}},\"spotlights\":{\"b88044bd-c359-493b-a55e-d134449342ec_0\":{\"content\":[],\"show_name\":true,\"show_slider\":true,\"component_header\":\"Spotlight\"}},\"our_schools\":{\"35b0cfa6-4dc9-46d4-b192-173d54f8ba1c_0\":{\"content\":[],\"has_description\":true,\"component_header\":\"Our Schools\",\"component_header_top\":\"Our\",\"component_header_bottom\":\"Schools\",\"component_header_description\":\"We are a dynamic and innovative school with a strong commitment to teaching, learning and research.\"}},\"floating_nav\":{\"shape\":\"rounded\",\"buttons\":[],\"is_fixed\":true},\"schools_menu\":{\"menu\":[[],[],[]]},\"sticky_footer\":{\"pill_button\":{\"link\":\"\",\"title\":\"register\",\"opens_in_new_tab\":false},\"icon_buttons\":[],\"hide_text_label\":\"hide\",\"show_text_label\":\"show\",\"show_pill_button\":true,\"show_social_icons\":true,\"social_media_icons\":[],\"show_only_on_homepage\":true},\"call_to_action\":{},\"custom_component\":{\"1167a9da-50a8-4ec2-8c8b-92a00f4c2126_0\":{\"icon\":{},\"loop\":{\"cta-list\":[{\"image\":{\"cta-item-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/5021742/04bb14a1-7719-462f-876c-76eb8de02675.png\",\"alt_text\":\"Student \"}},\"input\":{\"cta-item-title\":{\"text\":\"Explore Schools\"},\"cta-item-button\":{\"href\":\"/page/explore-choices-directory\",\"text\":\"Discover More\",\"target\":\"_self\"}},\"textarea\":{\"cta-item-text\":{\"text\":\"From college acceleration to visual and performing arts and dual language to STEM,  our schools have a unique focus geared toward every child.\"}}},{\"image\":{\"cta-item-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/5021774/02f6c5cb-fbe2-4969-87cb-916ce911067d.png\",\"alt_text\":\"Academics\"}},\"input\":{\"cta-item-title\":{\"text\":\"Academics\"},\"cta-item-button\":{\"href\":\"/o/dcps/page/academics\",\"text\":\"Learn More\",\"target\":\"_self\"}},\"textarea\":{\"cta-item-text\":{\"text\":\"Learn more about our academic standards and how we prepare our students at the elementary, middle, and high school levels.\"}}},{\"image\":{\"cta-item-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/6387540/bfd4a293-74bf-42b3-a110-7c519c8661f6.png\",\"alt_text\":\"A person in a white hard hat and glasses holds onto a ladder with a utility pole in the background.\",\"ai_generated_alt_text\":true}},\"input\":{\"cta-item-title\":{\"text\":\"Career Education\"},\"cta-item-button\":{\"href\":\"https://dcps.duvalschools.org/o/dcps/page/career-and-technical-education\",\"text\":\"Find Out More\",\"target\":\"_self\"}},\"textarea\":{\"cta-item-text\":{\"text\":\"Discover career-pathways that prepare students for the workforce with engaging and interactive curriculum.\"}}},{\"image\":{\"cta-item-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/5021783/2eb98437-55d3-4045-bf6f-57a605b41d0a.png\",\"alt_text\":\"Arts\"}},\"input\":{\"cta-item-title\":{\"text\":\"Arts Programs\"},\"cta-item-button\":{\"href\":\"/o/dcps/page/arts\",\"text\":\"Explore Now\",\"target\":\"_self\"}},\"textarea\":{\"cta-item-text\":{\"text\":\"We embed arts education into the instructional experience for all students in addition to focused, specialized study. \"}}},{\"image\":{\"cta-item-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/5054291/bb7ac283-f13d-4557-8a0a-8ac3c40e6c3a.png\",\"alt_text\":\"Student Swimming\"}},\"input\":{\"cta-item-title\":{\"text\":\"Athletics\"},\"cta-item-button\":{\"href\":\"/o/dcps/page/duvalathletics\",\"text\":\"More Details\",\"target\":\"_self\"}},\"textarea\":{\"cta-item-text\":{\"text\":\"Building winners on and off the field through highly competitive sports in a safe environment.\"}}}]},\"image\":{},\"input\":{},\"textarea\":{},\"rich_textarea\":{}},\"31770eb3-330d-49cc-8388-4ddae6132e71_0\":{\"icon\":{},\"loop\":{\"video-stories-slides\":[{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172453/d113f30b-b23c-4b36-b2ce-5f07109a1c23.png\",\"alt_text\":\"Girl holding a sign that states \\\"Reason #15, Fun Classrooms\\\"\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/935586179\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Reason #15 Fun Classrooms\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172457/d53efcb3-d211-45df-8570-b78928614cc2.png\",\"alt_text\":\"Girl holding a sign that states \\\"Reason #23, Unmatched Experience\\\"\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/935586161\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Reason #23 Unmatched Experience\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172460/ca85b547-3887-44a6-8949-c3fd3bb53ae2.png\",\"alt_text\":\"Boy holding a sign that states \\\"Reason #8, College-bound\\\"\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/935586142\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Reason #8 College-bound\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172462/69fb5906-3d01-4f78-b246-805de38e60ef.png\",\"alt_text\":\"Boy holding a sign that states \\\"Reason #12, Acceleration\\\"\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/935586117\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Reason #12 Acceleration\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172465/e4208bf9-db81-4185-a034-48c34a90dca7.png\",\"alt_text\":\"Lady sitting next to the words next to her that states, GRASP Unlock Empower. A School for Children with Dyslexia. Dysgraphia and Dyscalcula\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/906101024\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"GRASP, a School for Children with Dyslexia, Dysgraphia, Dyscalcula\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172471/b7df176a-346e-4daa-a765-c64dd885829e.png\",\"alt_text\":\"Darnell-Cookman, School of the Medical Arts\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/899941006/1dcec7098f\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Darnell-Cookman, School of the Medical Arts\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172477/bf17edcd-f200-48d5-a68d-8f80e10f0de7.png\",\"alt_text\":\"Students playing music instruments. Fort Caroline, Middle School of the Visual and Performing Arts\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/896279213\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Fort Caroline Middle School of the Visual and Performing Arts\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172479/77fb8448-3833-4f64-95e6-f6cb0a8496b6.png\",\"alt_text\":\"Teacher high-five a student, while another goes though the door. \"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/879894507\",\"text\":\"See video\",\"target\":\"_blank\"}}}]},\"image\":{},\"input\":{\"video-stories-title\":{\"text\":\"The Duval Schools Story\"},\"video-stories-subtitle\":{\"text\":\"\"}},\"textarea\":{},\"rich_textarea\":{}},\"4a9a62bd-10b5-4559-8356-7cf9e1319b4d_0\":{\"icon\":{},\"loop\":{\"flip-cards\":[{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/6348600/05fab7ac-5150-4a8c-877f-b079af222a05.jpeg\",\"alt_text\":\"Two women in lab coats and glasses work on a project with a large orange and white object.\",\"ai_generated_alt_text\":true}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"98% A, B, or C Schools\"},\"flip-card-number\":{\"text\":\"98%\"},\"flip-card-subtitle\":{\"text\":\"A, B, or C Schools\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"Even with the state’s increased accountability standards, 98% of your district schools earned an A, B, or C grade.\"}}},{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3615570/4020dd1c-1ea5-42ff-b749-c228697476e3.png\",\"alt_text\":\"testing\"}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"97.6% Graduation Rate\"},\"flip-card-number\":{\"text\":\"97.6%\"},\"flip-card-subtitle\":{\"text\":\"Graduation Rate in Traditional District High Schools\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"Our graduation rate for our traditional district high schools has steadily increased from 80.5% in 2013 to 97.6% in 2025. \"}}},{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3615573/25b64d7b-a659-45d8-abc1-5321511d60f7.png\",\"alt_text\":\"Card image\"}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"Pass Rate in College-Credit Courses\"},\"flip-card-number\":{\"text\":\"97.6%\"},\"flip-card-subtitle\":{\"text\":\"Pass Rate in College-Credit Courses\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"We've made it possible for students to earn college credit while they're still in high school. Each of our high schools offers at least one pathway for students to begin working toward their college degree.\"}}},{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/6348878/2e6e247d-4adb-4dd4-9468-b741066a5540.jpeg\",\"alt_text\":\"Four boys in different colored tops tend to plants in an outdoor garden, with green plants and soil.\",\"ai_generated_alt_text\":true}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"Mental Health\"},\"flip-card-number\":{\"text\":\"100%\"},\"flip-card-subtitle\":{\"text\":\"Student Access to Mental Health Therapists\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"Students attending any Duval County Public School have access to free mental health counseling.\"}}},{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3615577/e391d4c6-8c68-4406-bb7c-0a0ebd5741aa.png\",\"alt_text\":\"card image\"}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"Inclusion rate for Students with Disabilities\"},\"flip-card-number\":{\"text\":\"80%\"},\"flip-card-subtitle\":{\"text\":\"Inclusion rate for Students with Disabilities\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"We strive to keep students with disabilities in inclusive classroom settings to ensure exposure to the most rigorous instruction.\"}}}]},\"image\":{},\"input\":{\"flip-card-section-title\":{\"text\":\"Duval County Public Schools  at a Glance\"}},\"textarea\":{},\"rich_textarea\":{}},\"528e141d-8b08-433c-9d27-6e6d82dc4ca5_0\":{