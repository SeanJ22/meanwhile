High School\"},\"media-item-link\":{\"href\":\"https://vimeo.com/1012484581/fdb362d4aa\",\"text\":\"See video\",\"target\":\"_blank\"},\"media-item-title\":{\"text\":\"Jasper\"}},\"textarea\":{\"media-item-text\":{\"text\":\"This 12th grader and student-athlete is able to succeed with the support he needs.\"}}}]},\"image\":{},\"input\":{\"media-title\":{\"text\":\"The Duval Schools Difference\"},\"media-all-button\":{\"href\":\"/\",\"text\":\"All Videos\",\"target\":\"_blank\"}},\"textarea\":{\"media-text\":{\"text\":\"As an A-rated school district, we have made extraordinary progress in student achievement with an unwavering focus on learning.\"}},\"rich_textarea\":{}},\"6dccec8e-4e00-4061-ab2d-d589114d0be1_0\":{\"icon\":{},\"loop\":{\"gallery-text-wrapper\":[{\"input\":{\"gallery-title\":{\"text\":\"Duval Delivers: A Florida A-Rated School District\"},\"gallery-button\":{\"href\":\"/page/enrollment\",\"text\":\"Enroll Today\",\"target\":\"_self\"}},\"textarea\":{\"gallery-textarea\":{\"text\":\"Preparing students for college and life success, now with the state’s highest rating.\"}}},{\"input\":{\"gallery-title\":{\"text\":\"An Individualized Learning Experience.\"},\"gallery-button\":{\"href\":\"/page/enrollment\",\"text\":\"Enroll Today\",\"target\":\"_self\"}},\"textarea\":{\"gallery-textarea\":{\"text\":\"Serving students of different learning abilities, styles, and languages.\"}}},{\"input\":{\"gallery-title\":{\"text\":\"A Focus on Real-World, Career Readiness.\"},\"gallery-button\":{\"href\":\"/page/enrollment\",\"text\":\"Enroll Today\",\"target\":\"_self\"}},\"textarea\":{\"gallery-textarea\":{\"text\":\"Providing enriching and hands-on experiences to prepare students for their futures.\"}}},{\"input\":{\"gallery-title\":{\"text\":\"Learning Beyond the Classroom.\"},\"gallery-button\":{\"href\":\"/page/enrollment\",\"text\":\"Enroll Today\",\"target\":\"_self\"}},\"textarea\":{\"gallery-textarea\":{\"text\":\"Enriching the academic experience through extr