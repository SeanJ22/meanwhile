dress":7,"email_address":81,"opens_in_new_tab":7},"/o/dcps/page/students-and-families","Students & Families",{"url":1879,"type":1851,"mailto":7,"content":1880,"ipAddress":7,"email_address":81,"opens_in_new_tab":12},"https://jobs.duvalschools.org/","Careers",{"url":1882,"type":1851,"mailto":7,"content":1883,"ipAddress":7,"email_address":81,"opens_in_new_tab":7},"/page/district-contact-us","Contact Us",{"url":1885,"type":1851,"mailto":7,"content":1886,"ipAddress":7,"email_address":81,"opens_in_new_tab":7},"https://www.duvalschools.org/sitemap.xml","Site Map",{"url":1888,"type":1851,"mailto":7,"content":1889,"ipAddress":7,"email_address":81,"opens_in_new_tab":7},"https://www.duvalschools.org/o/dcps/page/sexual-health-education","Reproductive Health & Disease Education",{"url":1891,"type":1851,"mailto":7,"content":1892,"ipAddress":7,"email_address":81,"opens_in_new_tab":7},"/page/web-accessibility","Web Accessibility",{"url":1894,"type":1851,"mailto":7,"content":1895,"ipAddress":7,"email_address":81,"opens_in_new_tab":12},"/o/humanresources/page/title-ix-and-sexual-harassment","Title IX",{"url":1897,"type":1851,"mailto":7,"content":1898,"ipAddress":7,"email_address":81,"opens_in_new_tab":12},"/o/humanresources/page/department-overview","ADA",{"url":1900,"type":1851,"mailto":7,"content":1901,"ipAddress":7,"email_address":81,"opens_in_new_tab":7},"/page/district-data","Privacy Promise",{"type":1903,"content":1904},"FooterTextField","Duval County Public Schools is an equal opportunity school district.\n\nDuval County Public Schools has policies and procedures in place to protect its employees, students and anyone associated with the District from discrimination, harassment, sexual harassment or retaliation. It prohibits discrimination based upon race, color, gender, age, religion, marital status, disability, sexual orientation, gender identity, political or religious beliefs, national or ethnic origin, pregnancy, genetic information and veteran status. ",{"items":1906,"header":1114,"hasHeader":12,"showSchools":12},[],{"items":1908,"header":1114,"hasHeader":12,"showSchools":12},[],{"items":1910,"header":1114,"hasHeader":12,"showSchools":12},[],"https://twitter.com/DuvalSchools","https://vimeo.com/duvalschools","https://www.facebook.com/duvalschools","https://www.instagram.com/duvalschools",[],"\u003Cp>Duval County Public Schools is an equal opportunity school district.\u003C/p>\u003Cp>DCPS has policies and procedures in place to protect its employees, students and anyone associated with the District from discrimination, harassment, sexual harassment or retaliation. It prohibits discrimination based upon race, color, gender, age, religion, marital status, disability, sexual orientation, gender identity, political or religious beliefs, national or ethnic origin, pregnancy, genetic information and veteran status. Click here to access full policy.\u003C/p>",{"zip":1918,"city":1919,"name":80,"email":81,"state":1920,"address":1921,"fax_number":81,"phone_number":1922},"32207","Jacksonville","FL","1701 Prudential Drive","Phone: 904-390-2000",{"links":1924,"icon_links":1925},[],[],{"042b4dc5-152f-44a4-be0d-4a0d45a02de9_0":1927},{"content":1928,"icons_active":12},[],{"slides":1930,"widget":1973},[1931,1937,1949,1961],{"url":1932,"index":1054,"sizes":1933,"title":1934,"content":1935,"alt_text":1936},"https://cmsv2-assets.apptegy.net/uploads/23734/file/5017188/d7214552-f81d-47ae-9ff5-8e612527472a.mp4",{"px600":8,"px960":8,"small":8,"custom":8,"px1280":8,"px1600":8,"px1920":8,"px2560":8},"\u003Ch1>This is a heading\u003C/h1>","\u003Cp>test\u003C/p>","Gallery video",{"url":1938,"index":1043,"sizes":1939,"title":1946,"content":1947,"alt_text":1948},"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg",{"px600":1940,"px960":1941,"small":8,"custom":8,"px1280":1942,"px1600":1943,"px1920":1944,"px2560":1945},"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px600_0135afbd-da25-409b-8c6d-5d561b