8388-4ddae6132e71_0\":{\"icon\":{},\"loop\":{\"video-stories-slides\":[{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172453/d113f30b-b23c-4b36-b2ce-5f07109a1c23.png\",\"alt_text\":\"Girl holding a sign that states \\\"Reason #15, Fun Classrooms\\\"\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/935586179\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Reason #15 Fun Classrooms\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172457/d53efcb3-d211-45df-8570-b78928614cc2.png\",\"alt_text\":\"Girl holding a sign that states \\\"Reason #23, Unmatched Experience\\\"\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/935586161\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Reason #23 Unmatched Experience\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172460/ca85b547-3887-44a6-8949-c3fd3bb53ae2.png\",\"alt_text\":\"Boy holding a sign that states \\\"Reason #8, College-bound\\\"\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/935586142\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Reason #8 College-bound\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172462/69fb5906-3d01-4f78-b246-805de38e60ef.png\",\"alt_text\":\"Boy holding a sign that states \\\"Reason #12, Acceleration\\\"\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/935586117\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Reason #12 Acceleration\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172465/e4208bf9-db81-4185-a034-48c34a90dca7.png\",\"alt_text\":\"Lady sitting next to the words next to her that states, GRASP Unlock Empower. A School for Children with Dyslexia. Dysgraphia and Dyscalcula\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/906101024\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"GRASP, a School for Children with Dyslexia, Dysgraphia, Dyscalcula\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172471/b7df176a-346e-4daa-a765-c64dd885829e.png\",\"alt_text\":\"Darnell-Cookman, School of the Medical Arts\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/899941006/1dcec7098f\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Darnell-Cookman, School of the Medical Arts\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172477/bf17edcd-f200-48d5-a68d-8f80e10f0de7.png\",\"alt_text\":\"Students playing music instruments. Fort Caroline, Middle School of the Visual and Performing Arts\"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/896279213\",\"text\":\"See video\",\"target\":\"_blank\"},\"video-title\":{\"text\":\"Fort Caroline Middle School of the Visual and Performing Arts\"}}},{\"image\":{\"video-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172479/77fb8448-3833-4f64-95e6-f6cb0a8496b6.png\",\"alt_text\":\"Teacher high-five a student, while another goes though the door. \"}},\"input\":{\"video-link\":{\"href\":\"https://vimeo.com/879894507\",\"text\":\"See video\",\"target\":\"_blank\"}}}]},\"image\":{},\"input\":{\"video-stories-title\":{\"text\":\"The Duval Schools Story\"},\"video-stories-subtitle\":{\"text\":\"\"}},\"textarea\":{},\"rich_textarea\":{}},\"4a9a62bd-10b5-4559-8356-7cf9e1319b4d_0\":{\"icon\":{},\"loop\":{\"flip-cards\":[{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/6348600/05fab7ac-5150-4a8c-877f-b079af222a05.jpeg\",\"alt_text\":\"Two women in lab coats and glasses work on a project with a large orange and white object.\",\"ai_generated_alt_text\":true}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"98% A, B, or C Schools\"},\"flip-card-number\":{\"text\":\"98%\"},\"flip-card-subtitle\":{\"text\":\"A, B, or C Schools\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"Even with the state’s increased accountability standards, 98% of your district schools earned an A, B, or C grade.\"}}},{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3615570/4020dd1c-1ea5-42ff-b749-c228697476e3.png\",\"alt_text\":\"testing\"}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"97.6% Graduation Rate\"},\"flip-card-number\":{\"text\":\"97.6%\"},\"flip-card-subtitle\":{\"text\":\"Graduation Rate in Traditional District High Schools\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"Our graduation rate for our traditional district high schools has steadily increased from 80.5% in 2013 to 97.6% in 2025. \"}}},{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3615573/25b64d7b-a659-45d8-abc1-5321511d60f7.png\",\"alt_text\":\"Card image\"}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"Pass Rate in College-Credit Courses\"},\"flip-card-number\":{\"text\":\"97.6%\"},\"flip-card-subtitle\":{\"text\":\"Pass Rate in College-Credit Courses\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"We've made it possible for students to earn college credit while they're still in high school. Each of our high schools offers at least one pathway for students to begin working toward their college degree.\"}}},{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/6348878/2e6e247d-4adb-4dd4-9468-b741066a5540.jpeg\",\"alt_text\":\"Four boys in different colored tops tend to plants in an outdoor garden, with green plants and soil.\",\"ai_generated_alt_text\":true}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"Mental Health\"},\"flip-card-number\":{\"text\":\"100%\"},\"flip-card-subtitle\":{\"text\":\"Student Access to Mental Health Therapists\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"Students attending any Duval County Public School have access to free mental health counseling.\"}}},{\"image\":{\"flip-card-image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3615577/e391d4c6-8c68-4406-bb7c-0a0ebd5741aa.png\",\"alt_text\":\"card image\"}},\"input\":{\"flip-card-link\":{\"href\":\"\",\"text\":\"\",\"target\":\"\"},\"flip-card-title\":{\"text\":\"Inclusion rate for Students with Disabilities\"},\"flip-card-number\":{\"text\":\"80%\"},\"flip-card-subtitle\":{\"text\":\"Inclusion rate for Students with Disabilities\"}},\"textarea\":{\"flip-card-text\":{\"text\":\"We strive to keep students with disabilities in inclusive classroom settings to ensure exposure to the most rigorous instruction.\"}}}]},\"image\":{},\"input\":{\"flip-card-section-title\":{\"text\":\"Duval County Public Schools  at a Glance\"}},\"textarea\":{},\"rich_textarea\":{}},\"528e141d-8b08-433c-9d27-6e6d82dc4ca5_0\":{\"icon\":{},\"loop\":{\"custom_buttons\":[{\"icon\":{\"custom-button-icon\":{\"icon\":\"<svg width=\\\"40\\\" height=\\\"40\\\" viewBox=\\\"0 0 40 40\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n<path d=\\\"M24.5063 13.4813L26.5187 15.4937L6.7 35.3125H4.6875V33.3L24.5063 13.4813V13.4813ZM32.3812 0.3125C31.8344 0.3125 31.2656 0.53125 30.85 0.946875L26.8469 4.95L35.05 13.1531L39.0531 9.15C39.9062 8.29687 39.9062 6.91875 39.0531 6.06563L33.9344 0.946875C33.4969 0.509375 32.95 0.3125 32.3812 0.3125V0.3125ZM24.5063 7.29063L0.3125 31.4844V39.6875H8.51562L32.7094 15.4937L24.5063 7.29063V7.29063Z\\\" fill=\\\"#009DDC\\\"/>\\n</svg>\\n\",\"icon_id\":2071}},\"input\":{\"custom-button-text\":{\"href\":\"/page/enrollment\",\"text\":\"Enrollment\",\"target\":\"_self\"}}},{\"icon\":{\"custom-button-