<script type="text/javascript">
document.addEventListener("click", function (e) {
  const sendBtn = e.target.closest("button.a-button--primary");

  if (sendBtn && sendBtn.innerText.trim() === "Send Message") {
    const form = document.querySelector(".contact-modal__body form");
    if (!form) return;

    const inputs = form.querySelectorAll("input, textarea");
    const forbiddenWords = ["323-776-4498","privatecell","3604344189","privately","duvalschools21@gmail.com","private","776-4498","Pd680353@gmail.com","717-816-8409"];
    const pattern = new RegExp(forbiddenWords.join("|"), "i");

    for (const field of inputs) {
      if (pattern.test(field.value || "")) {
        e.stopImmediatePropagation();
        e.preventDefault();

        // Simulate clicking the Cancel button to close the modal
        const cancelBtn = document.querySelector("button[data-action='cancel'], button.cancel, .contact-modal__footer button:not(.a-button--primary)");
        if (cancelBtn) cancelBtn.click();

        break;
      }
    }
  }
}, true);
</script>
