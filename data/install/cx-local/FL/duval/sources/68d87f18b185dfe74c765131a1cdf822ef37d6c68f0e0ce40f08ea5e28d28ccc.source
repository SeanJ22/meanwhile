,\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"TDD/TTY: Dial 711\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":true},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3649771/3337ff9b-1bdf-456e-b8a6-4d2b42c63625.png\",\"type\":\"FooterImage\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"caption\":\"\",\"display\":\"custom-size\",\"alt_text\":\"FortifyFl-Logo\",\"asset_id\":3649771,\"link_url\":\"https://getfortifyfl.com/\",\"set_ratio\":null,\"cropped_width\":{},\"cropped_height\":{},\"action_on_click\":\"link\",\"image_alignment\":\"right\",\"open_in_new_tab\":true,\"preferred_width\":\"160\",\"preferred_height\":42.5,\"caption_alignment\":\"center\",\"open_link_in_new_tab\":true}],\"header\":\"Find Us\",\"hasHeader\":false,\"showSchools\":true},{\"items\":[{\"url\":\"/page/financial-transparency\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Financial Transparency\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"/page/reconsideration-form\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Book Challenge Form\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"/o/dcps/page/students-and-families\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Students & Families\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"https://jobs.duvalschools.org/\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Careers\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":true},{\"url\":\"/page/district-contact-us\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Contact Us\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"https://www.duvalschools.org/sitemap.xml\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Site Map\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"https://www.duvalschools.org/o/dcps/page/sexual-health-education\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Reproductive Health & Disease Education\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"/page/web-accessibility\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Web Accessibility\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"/o/humanresources/page/title-ix-and-sexual-harassment\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Title IX\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":true},{\"url\":\"/o/humanresources/page/department-overview\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"ADA\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":true},{\"url\":\"/page/district-data\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Privacy Promise\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"type\":\"FooterTextField\",\"content\":\"Duval County Public Schools is an equal opportunity school district.\\n\\nDuval County Public Schools has policies and procedures in place to protect its employees, students and anyone associated with the District from discrimination, harassment, sexual harassment or retaliation. It prohibits discrimination based upon race, color, gender, age, religion, marital status, disability, sexual orientation, gender identity, political or religious beliefs, national or ethnic origin, pregnancy, genetic information and veteran status. \"}],\"header\":\"Schools\",\"hasHeader\":false,\"showSchools\":false},{\"items\":[],\"header\":\"Schools\",\"hasHeader\":true,\"showSchools\":true},{\"items\":[],\"header\":\"Schools\",\"hasHeader\":true,\"showSchools\":true},{\"items\":[],\"header\":\"Schools\",\"hasHeader\":true,\"showSchools\":true}],\"hasApps\":true,\"hasLogo\":true,\"threads\":\"\",\"twitter\":\"https://twitter.com/DuvalSchools\",\"youtube\":\"https://vimeo.com/duvalschools\",\"facebook\":\"https://www.facebook.com/duvalschools\",\"linkedin\":\"\",\"hasSocial\":true,\"instagram\":\"https://www.instagram.com/duvalschools\",\"organizations\":[],\"additionalText\":\"<p>Duval County Public Schools is an equal opportunity school district.</p><p>DCPS has policies and procedures in place to protect its employees, students and anyone associated with the District from discrimination, harassment, sexual harassment or retaliation. It prohibits discrimination based upon race, color, gender, age, religion, marital status, disability, sexual orientation, gender identity, political or religious beliefs, national or ethnic origin, pregnancy, genetic information and veteran status. Click here to access full policy.</p>\",\"hasAdditionalText\":false,\"organization_info\":{\"zip\":\"32207\",\"city\":\"Jacksonville\",\"name\":\"Duval County Public Schools\",\"email\":\"\",\"state\":\"FL\",\"address\":\"1701 Prudential Drive\",\"fax_number\":\"\",\"phone_number\":\"Phone: 904-390-2000\"},\"additionalTextAlignment\":\"left\"},\"header\":{\"links\":[],\"icon_links\":[]},\"buttons\":{\"042b4dc5-152f-44a4-be0d-4a0d45a02de9_0\":{\"content\":[],\"icons_active\":true}},\"gallery\":{\"slides\":[{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/5017188/d7214552-f81d-47ae-9ff5-8e612527472a.mp4\",\"index\":0,\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"title\":\"<h1>This is a heading</h1>\",\"content\":\"<p>test</p>\",\"alt_text\":\"Gallery video\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"index\":1,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px600_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px960_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px1280_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px1600_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px1920_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px2560_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\"},\"title\":\"<h1 style=\\\"text-align: left\\\">A Focus on Real-World, Career Readiness.</h1>\",\"content\":\"<p style=\\\"text-align: left\\\">Providing enriching and hands-on experiences to prepare students for their futures.</p><p style=\\\"text-align: left\\\"><a rel=\\\"noopener noreferrer nofollow\\\" href=\\\"/\\\">Enroll Today</a></p>\",\"alt_text\":\"Gallery image\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\",\"index\":2,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/px600_e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/px960_e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/px1280_e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/px1600_e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/px1920_e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/px2560_e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\"},\"title\":\"<h1 style=\\\"text-align: left\\\"><span>An Individualized Learning Experience.</span></h1>\",\"content\":\"<p style=\\\"text-align: left\\\">Serving students of different learning abilities, styles, and languages.</p><p style=\\\"text-align: left\\\"><a rel=\\\"noopener noreferrer nofollow\\\" href=\\\"/\\\">Enroll Today</a></p>\",\"alt_text\":\"Gallery image\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3625312/006f05c4-2da8-4a82-ba84-916013aad7f1.jpeg\",\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3625312/px600_006f05c4-2da8-4a82-ba84-916013aad7f1.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3625312/px960_006f05c4-2da8-4a82-ba84-916013aad7f1.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3625312/px1280_006f05c4-2da8-4a82-ba84-916013aad7f1.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3625312/px1600_006f05c4-2da8-4a82-ba84-916013aad7f1.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3625312/px1920_006f05c4-2da8-4a82-ba84-916013aad7f1.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3625312/px2560_006f05c4-2da8-4a82-ba84-916013aad7f1.jpeg\"},\"title\":\"<h1 style=\\\"text-align: left\\\">Learning Beyond the Classroom.</h1>\",\"content\":\"<p style=\\\"text-align: left\\\">Enriching the academic experience through extracurricular activities, off-site learning, and community partnerships.</p><p style=\\\"text-align: left\\\"><a rel=\\\"noopener noreferrer nofollow\\\" href=\\\"/\\\">Enroll Today</a></p>\",\"alt_text\":\"testing images\"}],\"widget\":{\"body\":\"\",\"link\":{\"href\":\"\",\"name\":\"\",\"target\":\"\"}}},\"parallax\":{},\"programs\":{\"33d993bd-1524-4543-910d-2e24e7e3241c_0\":{\"slider\":true,\"content\":[],\"see_all\":true,\"has_header\":true,\"has_snippet\":true,\"num_columns\":4,\"see_all_link\":{},\"read_more_link\":true,\"component_header\":\"Programs\",\"details_on_hover\":true,\"component_header_top\":\"Choose from our\"}},\"timeline\":{},\"athletics\":{},\"live_feed\":{\"74ba4b15-9027-4182-9ba6-bd