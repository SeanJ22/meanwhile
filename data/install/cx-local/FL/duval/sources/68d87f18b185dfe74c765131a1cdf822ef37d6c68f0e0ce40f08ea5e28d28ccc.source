ies":3549},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622446/e3100923-eca8-46a9-ba39-3ea5c0eba57b.jpeg",{"assetUrl":3545,"assetId":3547,"altText":3548,"caption":81},4622446,"Female principal, a male teacher, Darryl Willie, and another female",{"anchorTag":81,"customClasses":3535,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3550},{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3535,"columnsCount":1091,"isLightbox":7,"showCaptions":7,"captionsAlignment":1845},{"id":3553,"name":3179,"type":3180,"content":3554,"properties":3578},"d583e96d-9feb-4fe7-9c53-aeb96226b71d",{"images":3555},[3556,3564,3571],{"name":2381,"type":3061,"assetUrl":3557,"content":3558,"properties":3561},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622659/10bff6f7-0f0e-4db9-b323-47eaa9ea6957.png",{"assetUrl":3557,"assetId":3559,"altText":3560,"caption":81},4622659,"Darryl Willie,another Board Member, children, and a group of adults playing soccer",{"anchorTag":81,"customClasses":3562,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3563},[],{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3565,"content":3566,"properties":3569},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708594/7f308b16-c42e-4b9d-98d2-18ea90241d00.png",{"assetUrl":3565,"assetId":3567,"altText":3568,"caption":81},4708594,"Two men talking with a woman.",{"anchorTag":81,"customClasses":3562,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3570},{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3572,"content":3573,"properties":3576},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708600/f4d8f900-37e7-43e5-bd75-7a3888296af8.png",{"assetUrl":3572,"assetId":3574,"altText":3575,"caption":81},4708600,"Group at Teacher Appreciation Event.",{"anchorTag":81,"customClasses":3562,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3577},{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3562,"columnsCount":1091,"isLightbox":7,"showCaptions":7,"captionsAlignment":1845},{"id":3580,"name":3099,"type":3100,"content":3581,"properties":3602},"48196e84-175e-47ef-8c09-12e1f9cbabaa",{"heading":3582,"text":3588,"image":3594},{"id":3583,"name":3091,"type":3092,"content":3584,"properties":3586},"cardTitle_48196e84-175e-47ef-8c09-12e1f9cbabaa",{"html":3585},"\u003Ch3>Reginald K. Blount\u003C/h3>",{"anchorTag":81,"customClasses":3587},[],{"id":3589,"name":3110,"type":3111,"content":3590,"properties":3592},"cardContent_48196e84-175e-47ef-8c09-12e1f9cbabaa",{"html":3591},"\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">Board Member\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">District 5\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:BlountR@duvalschools.org\">Email Reginald K. Blount\u003C/a>\u003C/p>\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">904-390-2372\u003C/span>\u003C/p>",{"anchorTag":81,"customClasses":3593},[],{"name":2381,"type":3061,"assetUrl":3595,"content":3596,"properties":3599},"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989984/cb5a6494-ded6-4e3e-81bf-8b07cf76a358.jpeg",{"assetUrl":3595,"assetId":3597,"altText":3598},3989984,"Reginald Blount",{"isDecorative":7,"naturalWidth":3600,"naturalHeight":3600,"focalPointPosition":3601},3267,{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3603,"design":3127,"showImage":12,"showHeadline":12,"imagePosition":1842,"wrapText":7,"textCursor":1054,"headlineCursor":1054},[],{"id":3605,"name":3130,"type":3131,"properties":3606,"nodes":3608},"1f86108c-8f57-4ade-90bb-6405a4382d26",{"anchorTag":81,"customClasses":3607,"theme":3134,"iconStyle":3135,"allowMultipleOpenPanels":12},[],[3609],{"name":3057,"type":3038,"nodes":3610},[3611,3624,3637],{"id":3612,"name":3141,"type":3142,"properties":3613,"nodes":3615,"parentAccordionId":3605},"0a713ccc-b376-4b70-ad1a-cf2ef8287cab",{"anchorTag":81,"customClasses":3614,"text":1538,"panelExpanded":12},[],[3616],{"name":3057,"type":3038,"nodes":3617},[3618],{"id":3619,"name":3110,"type":3111,"content":3620,"properties":3622},"8fed7fbb-b1c7-479a-b43c-43ac3ce13cbe",{"html":3621},"\u003Cp>\u003Cspan style=\"font-size: 16px\">Reginald K. Blount is a lifelong resident of Jacksonville, Florida, and a respected community leader whose unwavering commitment to public service has earned him admiration throughout the region. A proud product of Duval County Public Schools, Reginald is a graduate of Paxon Senior High School. His educational journey includes an Associate’s degree in Commercial Graphics from Tampa Tech Institute, a Bachelor of Arts in Business Management, a Master’s in Public Policy from Liberty University, and a specialized graduate certificate in Security, Stability, and Development in Complex Operations from the Naval Postgraduate School. Additionally, he is a graduate of the Sergeant Major Academy Battle Staff Course and has held a TOP Secret Security Clearance/SCI.&nbsp;\u003C/span>\u003C/p>\u003Cp>\u003Cspan style=\"font-size: 16px\">With a distinguished 30-year career in the United States Army, Reginald completed four combat tours, including serving in Operation Desert Storm in Iraq, Bosnia, and Croatia, as well as two tours in Afghanistan. As Senior Team Leader for the Army’s Provincial Reconstruction Team under the U.S. Army Psychological Operations and Civil Affairs Command, he was instrumental in efforts in collaboration with U.S. government agencies, foreign dignitaries, and NGOs to assess and drive reconstruction initiatives in conflict zones. Reginald also served with the Joint Special Operations Command Task Forces in Afghanistan.\u003C/span>\u003C/p>\u003Cp>\u003Cspan style=\"font-size: 16px\">In 1995, Reginald was appointed to the Housing Policy and Education Council at Fort Knox, Kentucky, where he played a pivotal role in improving the quality of life for soldiers and their families. He later served as an assistant liaison for the U.S. Special Operations Capabilities and Equipment brief during Public Service Recognition Week in Washington, D.C., under the Obama Administration. In addition to his military and public service roles, Reginald has been an academic mentor and coach, leading high school track &amp; field teams both in the U.S. and abroad.&nbsp;\u003C/span>\u003C/p>\u003Cp>\u003Cspan style=\"font-size: 16px\">In 2017, Reginald chaired the restructuring committee for the Jacksonville Black Chamber, helping to revitalize the organization to better serve both residents and the business community. In addition, he contributed significantly to the development of the operations section of the adult continuing education program at Florida State College Jacksonville, where he served as Project Coordinator, Adjunct Instructor, and Childcare Assessment Coordinator. Today, Reginald continues to positively impact young lives by developing a life-skills curriculum for the male youth mentorship program at Biscayne High School.\u003C/span>\u003C/p>\u003Cp>\u003Cspan style=\"font-size: 16px\">His exceptional service has earned him numerous accolades including the Military Outstanding Volunteer Service Medal. A talented graphic artist, vocalist, and musician, Reginald has received national and international recognition for his work with the United States Army Band and Chorus Europe. He was also named to \u003Cem>Marquis Who’s Who\u003C/em> in America for 2024.&nbsp;\u003C/span>\u003C/p>\u003Cp>\u003Cspan style=\"font-size: 16px\">A devoted family man, Reginald is the proud father of six children, three of whom have followed in his footsteps into military service. He is an active member of the American Center for Law &amp; Justice, American Legion Post 197, the Disabled Veterans Association, and Omega Psi Phi Fraternity, Inc.\u003C/span>\u003C/p>",{"anchorTag":81,"customClasses":3623},[],{"id":3625,"name":3141,"type":3142,"properties":3626,"nodes":3628,"parentAccordionId":3605},"c95417df-d45e-4ce4-8f21-bfdaa97e8b33",{"anchorTag":81,"customClasses":3627,"text":2933,"panelExpanded":12},[],[3629],{"name":3057,"type":3038,"nodes":3630},[3631],{"id":3632,"name":3163,"type":3164,"content":3633,"properties":3635},"5231f182-9f6a-4655-a9b5-eda37d91708a",{"html":3634},"\u003Ctable style=\"width: 100%; min-width: 100px\">\u003Ccolgroup>\u003Ccol style=\"min-width: 100px\">\u003C/colgroup>\u003Ctbody>\u003Ctr>\u003Cth colspan=\"1\" rowspan=\"1\" scope=\"col\">\u003Cp>School Name\u003C/p>\u003C/th>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/aares\">Andrew A. Robinson Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/bes\">Bayview Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/biltmore\">Biltmore Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/bsms\">Bridge to Success Academy Middle\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/ches\">Cedar Hills Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/cres\">Central Riverside Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\