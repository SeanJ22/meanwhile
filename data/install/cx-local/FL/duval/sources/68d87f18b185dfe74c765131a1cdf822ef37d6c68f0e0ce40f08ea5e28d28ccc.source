ntent\":\"Book Challenge Form\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"/o/dcps/page/students-and-families\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Students & Families\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"https://jobs.duvalschools.org/\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Careers\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":true},{\"url\":\"/page/district-contact-us\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Contact Us\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"https://www.duvalschools.org/sitemap.xml\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Site Map\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"https://www.duvalschools.org/o/dcps/page/sexual-health-education\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Reproductive Health & Disease Education\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"/page/web-accessibility\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Web Accessibility\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"url\":\"/o/humanresources/page/title-ix-and-sexual-harassment\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Title IX\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":true},{\"url\":\"/o/humanresources/page/department-overview\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"ADA\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":true},{\"url\":\"/page/district-data\",\"type\":\"FooterLink\",\"mailto\":false,\"content\":\"Privacy Promise\",\"ipAddress\":false,\"email_address\":\"\",\"opens_in_new_tab\":false},{\"type\":\"FooterTextField\",\"content\":\"Duval County Public Schools is an equal opportunity school district.\\n\\nDuval County Public Schools has policies and procedures in place to protect its employees, students and anyone associated with the District from discrimination, harassment, sexual harassment or retaliation. It prohibits discrimination based upon race, color, gender, age, religion, marital status, disability, sexual orientation, gender identity, political or religious beliefs, national or ethnic origin, pregnancy, genetic information and veteran status. \"}],\"header\":\"Schools\",\"hasHeader\":false,\"showSchools\":false},{\"items\":[],\"header\":\"Schools\",\"hasHeader\":true,\"showSchools\":true},{\"items\":[],\"header\":\"Schools\",\"hasHeader\":true,\"showSchools\":true},{\"items\":[],\"header\":\"Schools\",\"hasHeader\":true,\"showSchools\":true}],\"hasApps\":true,\"hasLogo\":true,\"threads\":\"\",\"twitter\":\"https://twitter.com/DuvalSchools\",\"youtube\":\"https://vimeo.com/duvalschools\",\"facebook\":\"https://www.facebook.com/duvalschools\",\"linkedin\":\"\",\"hasSocial\":true,\"instagram\":\"https://www.instagram.com/duvalschools\",\"organizations\":[],\"additionalText\":\"<p>Duval County Public Schools is an equal opportunity school district.</p><p>DCPS has policies and procedures in place to protect its employees, students and anyone associated with the District from discrimination, harassment, sexual harassment or retaliation. It prohibits discrimination based upon race, color, gender, age, religion, marital status, disability, sexual orientation, gender identity, political or religious beliefs, national or ethnic origin, pregnancy, genetic information and veteran status. Click here to access full policy.</p>\",\"hasAdditionalText\":false,\"organization_info\":{\"zip\":\"32207\",\"city\":\"Jacksonville\",\"name\":\"Duval County Public Schools\",\"email\":\"\",\"state\":\"FL\",\"address\":\"1701 Prudential Drive\",\"fax_number\":\"\",\"phone_number\":\"Phone: 904-390-2000\"},\"additionalTextAlignment\":\"left\"},\"header\":{\"links\":[],\"icon_links\":[]},\"buttons\":{\"042b4dc5-152f-44a4-be0d-4a0d45a02de9_0\":{\"content\":[],\"icons_active\":true}},\"gallery\":{\"slides\":[{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/5017188/d7214552-f81d-47ae-9ff5-8e612527472a.mp4\",\"index\":0,\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"title\":\"<h1>This is a heading</h1>\",\"content\":\"<p>test</p>\",\"alt_text\":\"Gallery video\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"index\":1,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px600_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px960_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px1280_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px1600_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px1920_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588347/px2560_0135afbd-da25-409b-8c6d-5d561bb7e277.jpeg\"},\"title\":\"<h1 style=\\\"text-align: left\\\">A Focus on Real-World, Career Readiness.</h1>\",\"content\":\"<p style=\\\"text-align: left\\\">Providing enriching and hands-on experiences to prepare students for their futures.</p><p style=\\\"text-align: left\\\"><a rel=\\\"noopener noreferrer nofollow\\\" href=\\\"/\\\">Enroll Today</a></p>\",\"alt_text\":\"Gallery image\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\",\"index\":2,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3588361/px600_e1d74fd5-f415-4885-adcc-0a3d595da101.jpeg\",\"p