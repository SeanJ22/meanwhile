>\u003C/tr>\u003C/tbody>\u003C/table>",{"anchorTag":81,"customClasses":3263,"theme":3134,"alternatingColors":12},[],{"id":3265,"name":3141,"type":3142,"properties":3266,"nodes":3268,"parentAccordionId":3232},"34a3d88f-d3f8-415b-a34b-99271da8f260",{"anchorTag":81,"customClasses":3267,"text":3173,"panelExpanded":12},[],[3269],{"name":3057,"type":3038,"nodes":3270},[3271],{"id":3272,"name":3179,"type":3180,"content":3273,"properties":3303},"e43cdd9a-1f41-44e1-bc4f-6631f264fe7a",{"images":3274},[3275,3283,3290,3297],{"name":2381,"type":3061,"assetUrl":3276,"content":3277,"properties":3280},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4607060/07022376-7dbc-478f-9c19-3e1922dd5422.jpeg",{"assetUrl":3276,"assetId":3278,"altText":3279,"caption":81},4607060,"Woman Reading",{"anchorTag":81,"customClasses":3281,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3282},[],{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3284,"content":3285,"properties":3288},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4607064/5ad1b115-4008-4bef-b941-7a714ed88b41.jpeg",{"assetUrl":3284,"assetId":3286,"altText":3287,"caption":81},4607064,"Man and Woman smiling",{"anchorTag":81,"customClasses":3281,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3289},{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3291,"content":3292,"properties":3295},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4607073/909035da-a901-4ecf-8d59-c32ec6f49e4c.jpeg",{"assetUrl":3291,"assetId":3293,"altText":3294,"caption":81},4607073,"Teacher and students",{"anchorTag":81,"customClasses":3281,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3296},{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3298,"content":3299,"properties":3301},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4607079/3fcb48a5-7504-4345-a756-51da601752f6.jpeg",{"assetUrl":3298,"assetId":3300,"altText":3294,"caption":81},4607079,{"anchorTag":81,"customClasses":3281,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3302},{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3281,"columnsCount":1979,"isLightbox":7,"showCaptions":7,"captionsAlignment":1845},{"id":3305,"name":3099,"type":3100,"content":3306,"properties":3326},"06ada2e6-a342-436e-a4c3-bc9ec8ba0c4e",{"heading":3307,"text":3313,"image":3319},{"id":3308,"name":3091,"type":3092,"content":3309,"properties":3311},"cardTitle_06ada2e6-a342-436e-a4c3-bc9ec8ba0c4e",{"html":3310},"\u003Ch3>\u003Cspan>Cindy Pearson\u003C/span>\u003C/h3>",{"anchorTag":81,"customClasses":3312},[],{"id":3314,"name":3110,"type":3111,"content":3315,"properties":3317},"cardContent_06ada2e6-a342-436e-a4c3-bc9ec8ba0c4e",{"html":3316},"\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">Board Member\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">District 3\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:PearsonC1@duvalschools.org\">Email Cindy Pearson\u003C/a>\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"tel:+19043902239\">904-302-4403\u003C/a>\u003C/p>",{"anchorTag":81,"customClasses":3318},[],{"name":2381,"type":3061,"assetUrl":3320,"content":3321,"properties":3324},"https://cmsv2-assets.apptegy.net/uploads/23734/file/3403865/a8929ee0-c9d8-4d18-a691-4f5ef7e70e5b.png",{"assetUrl":3320,"assetId":3322,"altText":3323},3403865,"Cindy Pearson",{"isDecorative":7,"naturalWidth":3227,"naturalHeight":3227,"focalPointPosition":3325},{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3327,"design":3127,"showImage":12,"showHeadline":12,"imagePosition":1842,"wrapText":7,"textCursor":1054,"headlineCursor":1054},[],{"id":3329,"name":3130,"type":3131,"properties":3330,"nodes":3332},"2c3b0ddd-4ebe-4687-bf3d-71b714f2155b",{"anchorTag":81,"customClasses":3331,"theme":3134,"iconStyle":3135,"allowMultipleOpenPanels":12},[],[3333],{"name":3057,"type":3038,"nodes":3334},[3335,3349,3362],{"id":3336,"name":3141,"type":3142,"properties":3337,"nodes":3340,"parentAccordionId":3329},"d1821431-8c5a-43ab-8ae1-6551128f1728",{"anchorTag":81,"customClasses":3338,"text":3339,"panelExpanded":12},[],"About ",[3341],{"name":3057,"type":3038,"nodes":3342},[3343],{"id":3344,"name":3110,"type":3111,"content":3345,"properties":3347},"5d120ec9-8b6d-4a52-a3b1-9da806a7c20d",{"html":3346},"\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">Cindy Pearson is a Jacksonville native who attended Duval County Public Schools K-12. She and her husband, Scott, have two students who graduated from DCPS schools and one student who currently attends a DCPS school. Cindy was elected to Duval County School Board in 2020 and re-elected in 2024.\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">&nbsp;Cindy holds a Bachelor of Arts in English from Florida State University and a Master of Science in Recreation Studies from University of Florida. She has worked for a city government and for a faith-based not-for-profit organization.\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">&nbsp;Cindy brings experience in mobilizing parents and community members to support local schools. She has worked to build a broad coalition of people who care about our public schools. She believes that we need to hear from many voices and many perspectives on how to create a countywide system of thriving schools.\u003C/span>\u003C/p>",{"anchorTag":81,"customClasses":3348},[],{"id":3350,"name":3141,"type":3142,"properties":3351,"nodes":3353,"parentAccordionId":3329},"aeee2a5d-83c5-43ff-983b-42c522755a0a",{"anchorTag":81,"customClasses":3352,"text":2933,"panelExpanded":12},[],[3354],{"name":3057,"type":3038,"nodes":3355},[3356],{"id":3357,"name":3163,"type":3164,"content":3358,"properties":3360},"dd5032c6-5620-4888-bfae-73c9e6a4a530",{"html":3359},"\u003Ctable style=\"width: 100%; min-width: 100px\">\u003Ccolgroup>\u003Ccol style=\"min-width: 100px\">\u003C/colgroup>\u003Ctbody>\u003Ctr>\u003Cth colspan=\"1\" rowspan=\"1\" scope=\"col\">\u003Cp>\u003Cstrong>School Name\u003C/strong>\u003C/p>\u003C/th>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/ar\">Alden Road Exceptional Student Center\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/aims\">Alfred I. duPont Middle\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/beauclerc\">Beauclerc Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/brookview\">Brookview Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/dahs\">Douglas Anderson School of the Arts\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/englewood\">Englewood Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/ehs\">Englewood High\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\