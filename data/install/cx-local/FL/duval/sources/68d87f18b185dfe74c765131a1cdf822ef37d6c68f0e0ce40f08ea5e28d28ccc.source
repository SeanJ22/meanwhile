\":{\"hex\":\"#fff\"},\"widget_button_background_hover_color\":{\"hex\":\"#FFC425\",\"fixedColor\":\"secondary\"}}},\"containers\":[{\"id\":\"2fafe0e3-5558-4d96-ab32-eb2eb87bb768\",\"type\":\"Fullwidth\",\"components\":[{\"name\":\"Custom Code\",\"options\":{\"js_code\":\"\",\"css_code\":\"\",\"html_code\":\"<div id=\\\"gallery-language\\\">\\n    <div class=\\\"text\\\">\\n        <h3>Explore in Your Language</h3>\\n        <p>Use the up arrow key to navigate through the available languages.</p>\\n    </div>\\n    <div class=\\\"languages-list\\\">\\n        \\n    </div>\\n</div>\",\"scss_code\":\"\",\"container_id\":\"custom-html-7e4d692d-2792-4542-b48e-537044df940c\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#FFC425\"}}},{\"id\":\"63a75b72-7077-48f4-8987-b32af5bc106b\",\"type\":\"Fullwidth\",\"components\":[{\"name\":\"Custom Code\",\"options\":{\"js_code\":\"/*\\n(function () {\\n  const SCRIPT_ID = \\\"logwork-countdown-script\\\";\\n\\n  function initCountdown() {\\n    // Prevent loading the script multiple times.\\n    if (document.getElementById(SCRIPT_ID)) return;\\n\\n    const script = document.createElement(\\\"script\\\");\\n    script.id = SCRIPT_ID;\\n    script.src = \\\"https://cdn.logwork.com/widget/countdown.js\\\";\\n    script.async = true;\\n\\n    script.onload = () => {\\n      console.log(\\\"✅ LogWork Countdown loaded successfully.\\\");\\n    };\\n\\n    script.onerror = () => {\\n      console.error(\\\"❌ Failed to load LogWork Countdown.\\\");\\n    };\\n\\n    document.body.appendChild(script);\\n  }\\n\\n  if (document.readyState === \\\"loading\\\") {\\n    document.addEventListener(\\\"DOMContentLoaded\\\", initCountdown);\\n  } else {\\n    initCountdown();\\n  }\\n})();\\n*/\",\"css_code\":\"\",\"html_code\":\"<!--\\n<div class=\\\"countdown-widget\\\">\\n  <a\\n    href=\\\"https://logwork.com/countdown-timer\\\"\\n    class=\\\"countdown-timer\\\"\\n    data-timezone=\\\"America/New_York\\\"\\n    data-date=\\\"2026-08-10 00:00\\\"\\n    data-background=\\\"#1d4b83\\\"\\n    data-digitscolor=\\\"#ffffff\\\"\\n  >\\n    First Day of School - August 10, 2026\\n  </a>\\n</div>\\n-->\",\"scss_code\":\"\",\"container_id\":\"custom-html-e861ad63-12c8-4632-be7d-b6c261c58016\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#FFC425\"}}},{\"id\":\"6dccec8e-4e00-4061-ab2d-d589114d0be1\",\"type\":\"Fullwidth\",\"components\":[{\"name\":\"Custom Component\",\"options\":{\"global\":false,\"js_code\":\"document.addEventListener('appLoaded', () => {\\n\\n  const moveGalleryText = (callback) => {\\n    document.querySelectorAll('.gallery-text-wrapper > div').forEach(slide => slide.classList.add('swiper-slide'));\\n\\n    const galleryTextArrows = document.querySelector('.gallery-text-arrows');\\n\\n    const g2VideoWrapper = document.querySelector('#g2 .video-wrapper');\\n\\n    if (galleryTextArrows && g2VideoWrapper) {\\n      g2VideoWrapper.appendChild(galleryTextArrows);\\n    }\\n\\n    callback();\\n  };\\n\\n  const galleryTextSlider = () => {\\n    setTimeout(() => {\\n      new Swiper('#cms-gallery .gallery-text', {\\n        speed: 400,\\n        simulateTouch: false,\\n        slidesPerView: 1,\\n        rewind: true,\\n        autoHeight: true,\\n        loop: true,\\n        spaceBetween: 25,\\n        autoplay: {\\n          delay: 7500,\\n          disableOnInteraction: true,\\n        },\\n        pagination: {\\n          el: '.gallery-pagination',\\n          clickable: true,\\n        },\\n        navigation: {\\n          nextEl: '.gallery-swiper-button-next',\\n          prevEl: '.gallery-swiper-button-prev',\\n        },\\n      });\\n  }, 500);\\n    \\n  };\\n\\n  moveGalleryText(galleryTextSlider);\\n\\n\\n}); \",\"css_code\":\"#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d {\\n  /* styling for CMS */\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section:has(.link-actions) {\\n  padding: 20px;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d label.only-in-cms {\\n  font-size: 16px;\\n  font-weight: 600;\\n  margin-top: 15px;\\n  margin-bottom: 10px;\\n  display: block;\\n  letter-spacing: 0.03em;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d label.only-in-cms:nth-child(2) {\\n  margin-top: 0;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section:has(.link-actions) .hide-on-cms {\\n  display: none !important;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section:not(:has(.link-actions)) .only-in-cms {\\n  display: none !important;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-image-wrapper img.image-container-image {\\n  display: block;\\n  width: auto;\\n  height: auto;\\n  object-fit: contain;\\n  min-height: 150px;\\n  min-width: 150px;\\n  max-height: 250px;\\n  border: 1px solid #eee;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-image-wrapper {\\n  height: auto;\\n  margin-bottom: 10px;\\n  display: inline-block;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper.blank-icon {\\n  display: inline-block;\\n  width: auto;\\n  min-width: 75px;\\n  min-height: 75px;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper .raw-svg,\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper {\\n  display: inline-block;\\n  width: auto;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper svg {\\n  height: 75px;\\n  width: 75px;\\n  object-fit: contain;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper .raw-svg {\\n  border: 1px solid #eee;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-textarea-wrapper textarea,\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-input-wrapper input {\\n  border: 1px solid #ddd;\\n  padding: 5px;\\n  margin-bottom: 10px;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-component:has(.link-button) {\\n  padding-left: 20px;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-component .link-actions-container.link-actions-container-link {\\n  left: 0;\\n  visibility: visible;\\n}\\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-component-loop-wrapper > div {\\n  padding: 10px;\\n  box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);\\n  margin-bottom: 20px;\\n}\\n\",\"html_code\":\"<div class=\\\"custom-section gallery-text-arrows\\\">\\n  <div class=\\\"gallery-text swiper\\\">\\n    <cms-loop class=\\\"gallery-text-wrapper swiper-wrapper\\\" name=\\\"gallery-text-wrapper\\\">\\n      <label class=\\\"only-in-cms\\\">Add gallery title:</label>\\n      <div class=\\\"title\\\">        \\n        <cms-input name=\\\"gallery-title\\\"></cms-input>\\n      </div>\\n      <label class=\\\"only-in-cms\\\">Add gallery text:</label>\\n      <div class=\\\"description\\\">\\n        <p>\\n          <cms-textarea name=\\\"gallery-textarea\\\"></cms-textarea>\\n        </p>\\n      </div>\\n      <label class=\\\"only-in-cms\\\">Add gallery button:</label>\\n      <div class=\\\"button square light\\\"><cms-input name=\\\"gallery-button\\\" link></cms-input></div>\\n    </cms-loop>\\n  </div>\\n  <div class=\\\"gallery-arrows-buttons flex items-center gap-24 hide-on-cms\\\">\\n    <div class=\\\"gallery-swiper-button-prev swiper-button-prev\\\" tabindex=\\\"-1\\\" role=\\\"button\\\" aria-label=\\\"Previous slide\\\">\\n      <span>Previous slide</span>\\n    </div>\\n    <div class=\\\"gallery-pagination\\\"></div>\\n    <div class=\\\"gallery-swiper-button-next swiper-button-next\\\" tabindex=\\\"-1\\\" role=\\\"button\\\" aria-label=\\\"Next slide\\\">\\n      <span>Next slide</span>\\n    </div>\\n  </div>\\n</div>\",\"scss_code\":\"/* styling for CMS */ \\n.custom-section:has(.link-actions) {\\n    padding: 20px;\\n}\\nlabel.only-in-cms {\\n    font-size: 16px;\\n    font-weight: 600;\\n    margin-top: 15px;\\n    margin-bottom: 10px;\\n    display: block;\\n    letter-spacing: 0.03em;;\\n}\\nlabel.only-in-cms:nth-child(2) {\\n    margin-top: 0;\\n}\\n.custom-section:has(.link-actions) .hide-on-cms {\\n    display: none !important;\\n}\\n.custom-section:not(:has(.link-actions)) .only-in-cms {\\n    display: none !important;\\n}\\n.custom-section .homepage-image-wrapper img.image-container-image {\\n    display: block;\\n    width: auto;\\n    height: auto;\\n    object-fit: contain; \\n    min-height: 150px;\\n    min-width: 150px;\\n    max-height: 250px;\\n    border: 1px solid #eee;\\n}\\n.custom-section .homepage-image-wrapper {\\n    height: auto;\\n    margin-bottom: 10px;\\n    display: inline-block;\\n}\\n.custom-section .homepage-icon-wrapper.blank-icon {\\n    display: inline-block;\\n    width: auto;\\n    min-width: 75px;\\n    min-height: 75px;\\n}\\n.custom-section .homepage-icon-wrapper .raw-svg,\\n.custom-section .homepage-icon-wrapper {\\n    display: inline-block;\\n    width: auto;\\n}\\n.custom-section .homepage-icon-wrapper svg {\\n    height: 75px;\\n    width: 75px;\\n    object-fit: contain;\\n}\\n.custom-section .homepage-icon-wrapper .raw-svg {\\n    border: 1px solid #eee;\\n}\\n.custom-section .homepage-textarea-wrapper textarea,\\n.custom-section .homepage-input-wrapper input {\\n    border: 1px solid #ddd;\\n    padding: 5px;\\n    margin-bottom: 10px;\\n}\\n.custom-component:has(.link-button) {\\n    padding-left: 20px;\\n}\\n.custom-component .link-actions-container.link-actions-container-link {\\n    left: 0;\\n    visibility: visible;\\n}\\n.custom-component-loop-wrapper > div {\\n    padding: 10px;\\n    box-shadow: 0 0 15px rgba(0,0,0,0.5);\\n    margin-bottom: 20px;\\n}\",\"container_id\":\"custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#FFC425\"}}},{\"id\":\"528e141d-8b08-433c-9d27-6e6d82dc4ca5\",\"type\":\"Fullwidth\",\"components\":[{\"name\":\"Custom Component\",\"options\":{\"global\":false,\"js_code\":\"document.addEventListener('appLoaded', () => {\\n  const buttonDivs = document.querySelectorAll('.button-group > div');\\n  buttonDivs.forEach((div, index) => {\\n    if (index < buttonDivs.length - 1) {\\n      div.insertAdjacentHTML('afterend', '<div class=\\\"line\\\"></div>');\\n    }\\n  });\\n});\\n\",\"css_code\":\"#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 {\\n  /* styling for CMS */\\n  /* can be with display: none in edit template code to be hidden as default */\\n}\\n#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 .custom-section {\\n  display: block !important;\\n}\\n#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 .custom-section:has(.link-actions) {\\n  padding: 20px;\\n}\\n#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 label.only-in-cms {\\n  font-size: 16px;\\n  font-weight: 600;\\n  margin-top: 15px;\\n  margin-bottom: 10px;\\n  display: block;\\n  letter-spacing: 0.03em;\\n}\\n#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 label.only-in-cms:nth-child(2) {\\n  margin-top: 0;\\n}\\n#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 .custom-section:not(:has(.link-actions)) .only-in-cms {\\n  display: none !important;\\n}\\n#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 .custom-section .homepage-image-wrapper img.image-container-image {\\n  display: block;\\n  width: auto;\\n  height: auto;\\n  object-fit: contain;\\n  min-height: 150px;\\n  min-width: 150px;\\n  max-height: 250px;\\n  border: 1px solid #eee;\\n}\\n#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 .custom-section .homepage-image-wrapper {\\n  height: auto;\\n  margin-bottom: 10px;\\n  display: inline-block;\\n}\\n#custom-component-8fe7f0cb-4956-4c2d-ae3e-961612611770 .custom-section .h