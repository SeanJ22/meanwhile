e":3083},[],{"top":3005,"left":3005,"right":3005,"value":3005,"bottom":3005,"linked":12},{"top":1054,"left":1054,"right":1054,"value":1054,"bottom":1054,"linked":12},{"value":1054},{"value":81,"toggle":7},{"image":8,"toggle":7},[3085,3087],{"name":3057,"type":3038,"nodes":3086},[],{"name":3057,"type":3038,"nodes":3088},[3089,3097,3128,3206,3231,3304,3328,3430,3455,3579,3604,3701,3725,3843,3868],{"id":3090,"name":3091,"type":3092,"content":3093,"properties":3095},"d0a082d9-fe36-44ae-98ec-ae4e3cf33011","Heading","CONTENT_NODE_HEADING",{"html":3094},"\u003Ch1>School Board Members\u003C/h1>",{"anchorTag":81,"customClasses":3096},[],{"id":3098,"name":3099,"type":3100,"content":3101,"properties":3125},"36eaf8d1-d40e-41a5-b063-57a83441ad21","Card","CONTENT_NODE_CARD",{"heading":3102,"text":3108,"image":3116},{"id":3103,"name":3091,"type":3092,"content":3104,"properties":3106},"cardTitle_36eaf8d1-d40e-41a5-b063-57a83441ad21",{"html":3105},"\u003Ch3>Anthony Ricardo\u003C/h3>",{"anchorTag":81,"customClasses":3107},[],{"id":3109,"name":3110,"type":3111,"content":3112,"properties":3114},"cardContent_36eaf8d1-d40e-41a5-b063-57a83441ad21","Text","CONTENT_NODE_TEXT",{"html":3113},"\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">Board Member\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">District 1\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:RicardoA@duvalschools.org\">Email Anthony Ricardo\u003C/a>\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_self\" rel=\"noopener noreferrer nofollow\" href=\"tel:9043902371\">904-927-1700\u003C/a>\u003C/p>",{"anchorTag":81,"customClasses":3115},[],{"name":2381,"type":3061,"assetUrl":3117,"content":3118,"properties":3121},"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989971/6edb8acb-344d-4581-9810-9361f188ba7d.jpeg",{"assetUrl":3117,"assetId":3119,"altText":3120},3989971,"Anthony Ricardo",{"isDecorative":7,"naturalWidth":3122,"naturalHeight":3122,"focalPointPosition":3123},3044,{"x":3124,"y":3124},50,{"anchorTag":81,"customClasses":3126,"design":3127,"showImage":12,"showHeadline":12,"imagePosition":1842,"wrapText":7,"textCursor":1054,"headlineCursor":1054},[],"box-shadow",{"id":3129,"name":3130,"type":3131,"properties":3132,"nodes":3136},"93f44fc3-6e86-4aef-b9a0-60319f07bb2a","Accordion","CONTENT_NODE_ACCORDION",{"anchorTag":81,"customClasses":3133,"theme":3134,"iconStyle":3135,"allowMultipleOpenPanels":12},[],"dark","caret",[3137],{"name":3057,"type":3038,"nodes":3138},[3139,3154,3169],{"id":3140,"name":3141,"type":3142,"properties":3143,"nodes":3145,"parentAccordionId":3129},"33b36e8f-4ad5-42f5-8786-23ae4ca40d13","Accordion Panel","CONTENT_NODE_PANEL",{"anchorTag":81,"customClasses":3144,"text":1538,"panelExpanded":12},[],[3146],{"name":3057,"type":3038,"nodes":3147},[3148],{"id":3149,"name":3110,"type":3111,"content":3150,"properties":3152},"b2d5d24a-dd2a-43cd-82eb-b81039b256d4",{"html":3151},"\u003Cp>\u003Cspan style=\"font-size: 16px\">Anthony “Tony” Ricardo has been a resident of Jacksonville’s Northside since 1960. He is a former educator, a father of three, a grandfather of eight, and the proprietor of Ricardo Designs, a commercial art business he established in 1992. His innovative and distinctive creations in the signage industry have been showcased in esteemed trade publications and have earned him numerous international accolades. Interestingly, many of Tony’s meticulously hand-painted school mascots adorn gymnasiums across Florida and Georgia.\u003Cbr>\u003C/span>\u003Cbr>\u003Cspan style=\"font-size: 16px\">Upon graduating from Bishop Kenny High School, Tony obtained a Bachelor of Arts in Art Education. He taught at various public and private institutions, spanning from elementary to secondary levels, ultimately settling at Andrew Jackson High School where he taught Drawing, Painting, Photography, Cinematography, and also coached tennis, soccer, and baseball until 1992.\u003C/span>\u003Cbr>\u003Cspan style=\"font-size: 16px\">\u003Cbr>All three of his children completed their education at First Coast High School, and for over 35 years, he has been actively engaged in the local community and a dedicated member of First Coast Christian Center. Tony’s extensive business background and teaching experience provide him with a profound insight into the prevailing challenges in public education. His conservative values have instilled in him a fervent desire to address these issues. His deep-rooted affection for Jacksonville, his beloved hometown, propels him to seek opportunities to serve the community and contribute to providing students with the exceptional education they deserve, while also striving to enhance the working environment for educators. Endorsed by Gov. DeSantis, Tony Ricardo is a representative of Oceanway, North Arlington, and Fort Caroline schools.\u003C/span>\u003C/p>\u003Cp>\u003C/p>",{"anchorTag":81,"customClasses":3153},[],{"id":3155,"name":3141,"type":3142,"properties":3156,"nodes":3158,"parentAccordionId":3129},"93006c79-7246-4695-8799-92110a8fb7c3",{"anchorTag":81,"customClasses":3157,"text":2933,"panelExpanded":12},[],[3159],{"name":3057,"type":3038,"nodes":3160},[3161],{"id":3162,"name":3163,"type":3164,"content":3165,"properties":3167},"cbf5ae2e-f235-496c-bc22-3f46cdabbe45","Table","CONTENT_NODE_TABLE",{"html":3166},"\u003Ctable style=\"width: 100%; min-width: 100px\">\u003Ccolgroup>\u003Ccol style=\"min-width: 100px\">\u003C/colgroup>\u003Ctbody>\u003Ctr>\u003Cth colspan=\"1\" rowspan=\"1\" scope=\"col\">\u003Cp>School Name\u003C/p>\u003C/th>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/arlingtonelementary\">Arlington Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\