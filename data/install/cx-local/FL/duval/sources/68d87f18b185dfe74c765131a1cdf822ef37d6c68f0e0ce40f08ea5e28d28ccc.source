PointPosition":3827},1242,{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3829,"content":3830,"properties":3832},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4589667/ab9c4570-e906-428c-acc6-59a72ebb3977.jpeg",{"assetUrl":3829,"assetId":3831,"altText":3824,"caption":81},4589667,{"anchorTag":81,"customClasses":3775,"isDecorative":7,"naturalWidth":3833,"naturalHeight":3833,"focalPointPosition":3834},600,{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3836,"content":3837,"properties":3840},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4590544/d06175e3-16c0-4c3d-87ec-8728b47c4efc.jpeg",{"assetUrl":3836,"assetId":3838,"altText":3839,"caption":81},4590544,"Three Women ",{"anchorTag":81,"customClasses":3775,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3841},{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3775,"columnsCount":1979,"isLightbox":7,"showCaptions":7,"captionsAlignment":1845},{"id":3844,"name":3099,"type":3100,"content":3845,"properties":3866},"f5e0f0a8-3c3d-4f43-bd65-910aa5c0dac5",{"heading":3846,"text":3852,"image":3858},{"id":3847,"name":3091,"type":3092,"content":3848,"properties":3850},"cardTitle_f5e0f0a8-3c3d-4f43-bd65-910aa5c0dac5",{"html":3849},"\u003Ch3>Melody A. Bolduc\u003C/h3>",{"anchorTag":81,"customClasses":3851},[],{"id":3853,"name":3110,"type":3111,"content":3854,"properties":3856},"cardContent_f5e0f0a8-3c3d-4f43-bd65-910aa5c0dac5",{"html":3855},"\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">Board Member\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">District 7\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:BolducM@duvalschools.org\">Email Melody A. Bolduc\u003C/a>\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_self\" rel=\"noopener noreferrer nofollow\" href=\"tel:9049271699\">904-927-1699\u003C/a>\u003C/p>",{"anchorTag":81,"customClasses":3857},[],{"name":2381,"type":3061,"assetUrl":3859,"content":3860,"properties":3863},"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989995/bcaf124f-2d7c-4198-bd28-e5377e2aaf55.jpeg",{"assetUrl":3859,"assetId":3861,"altText":3862},3989995,"Melody Bolduc",{"isDecorative":7,"naturalWidth":3864,"naturalHeight":3864,"focalPointPosition":3865},3320,{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3867,"design":3127,"showImage":12,"showHeadline":12,"imagePosition":1842,"wrapText":7,"textCursor":1054,"headlineCursor":1054},[],{"id":3869,"name":3130,"type":3131,"properties":3870,"nodes":3872},"a3628389-cd28-4697-af47-fc47d23ef2eb",{"anchorTag":81,"customClasses":3871,"theme":3134,"iconStyle":3135,"allowMultipleOpenPanels":12},[],[3873],{"name":3057,"type":3038,"nodes":3874},[3875,3888,3901],{"id":3876,"name":3141,"type":3142,"properties":3877,"nodes":3879,"parentAccordionId":3869},"0acc5ba7-86ee-40bf-99cc-e19db13d0931",{"anchorTag":81,"customClasses":3878,"text":1538,"panelExpanded":12},[],[3880],{"name":3057,"type":3038,"nodes":3881},[3882],{"id":3883,"name":3110,"type":3111,"content":3884,"properties":3886},"a2e3dab3-daaa-49a7-81a8-221162d36302",{"html":3885},"\u003Cp>\u003Cspan style=\"font-size: 16px\">Raised in Jacksonville's Mandarin area by supportive parents who placed a high value on education, Melody Bolduc has dedicated her life to empowering students and teachers. A proud graduate of Bishop Kenny High School, where she graduated with honors and earned the Florida Merit Scholarship, Melody pursued her lifelong dream of becoming a teacher by attending the University of North Florida. She graduated summa cum laude in 2000 with a bachelor's degree in Secondary English Education.&nbsp; \u003Cbr>\u003Cbr>Melody is celebrating 18 years of marriage to her best friend from high school and is a proud mother to two talented teenage daughters who attend Mandarin High School. As a seasoned educator with over 24 years of experience in both public and private schools, Melody holds certifications for kindergarten through high school in multiple subject areas. Her career spans teaching diverse student populations, researching and developing curriculum, and consulting on best practices for individualized instruction.&nbsp; \u003Cbr>\u003Cbr>As the owner of a small educational resource center, Melody provides consulting and tutoring services tailored to students' unique needs. This experience has strengthened her commitment to ensuring taxpayer dollars are spent effectively and directly benefit students and teachers through quality classroom resources and support.&nbsp; \u003Cbr>\u003Cbr>Melody’s dedication extends beyond the classroom. She is an active community stakeholder, PTSA member, and school volunteer. Currently completing the final requirements for her doctorate and preparing to publish her first children’s book, Melody balances professional excellence with a passion for education advocacy.&nbsp; \u003Cbr>\u003Cbr>On the School Board, Melody is committed to fostering strong partnerships between teachers, parents, and the community. She recognizes the critical role of parental involvement in student success and values the perspectives of teachers in shaping policy. With a focus on transparency, fiscal responsibility, and innovative problem-solving, Melody strives to make Duval County Public Schools a competitive and attractive choice for families, teachers, and students.&nbsp; \u003Cbr>\u003Cbr>Melody’s purpose is clear: to serve as an active advocate and positive change agent for Duval County’s children, working collaboratively with all stakeholders to create a brighter future for public education.&nbsp;\u003C/span>\u003C/p>",{"anchorTag":81,"customClasses":3887},[],{"id":3889,"name":3141,"type":3142,"properties":3890,"nodes":3892,"parentAccordionId":3869},"0ecfd10f-a8d1-44c5-9baa-0a66e55cba7b",{"anchorTag":81,"customClasses":3891,"text":2933,"panelExpanded":12},[],[3893],{"name":3057,"type":3038,