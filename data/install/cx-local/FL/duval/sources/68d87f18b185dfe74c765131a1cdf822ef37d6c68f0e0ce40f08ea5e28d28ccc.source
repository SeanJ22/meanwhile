om-section\\\" id=\\\"section-events\\\">\\n    <div class=\\\"header see-all-container see-all-top\\\">\\n        <div id=\\\"events-title\\\" class=\\\"header-slot-container\\\">\\n            <h2>District Calendar</h2>\\n        </div>\\n      <div class=\\\"button square outline\\\">\\n        <a href=\\\"{{section_page_url}}\\\" class=\\\"see-all-button no-underline\\\">View Calendar</a>\\n      </div> \\n    </div>\\n    <div id=\\\"events-section\\\">\\n        <cms-media loop=\\\"6\\\">\\n            <div class=\\\"event-item\\\">\\n                <div class=\\\"event-item__date\\\">\\n                    {{date}}\\n                </div>\\n                <div class=\\\"event-details\\\">\\n                    <div class=\\\"event-item__title\\\">\\n                        <a href=\\\"{{entry_url}}\\\">\\n                            <h3 class=\\\"line-clamp-3\\\">{{title}}</h3>\\n                        </a>\\n                    </div>\\n                    <div class=\\\"event-item__time\\\">\\n                        {{time}}\\n                    </div>\\n                </div>            \\n            </div>\\n        </cms-media>\\n                                                    \\n    </div>\\n</div>\",\"scss_code\":\".custom-section {\\n  display: block !important;\\n}\",\"container_id\":\"media-custom-html-a63afd7b-2236-4933-9727-4dfbd9f3c814\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#FFC425\"}}},{\"id\":\"e5bf1751-534a-4b9b-b1d0-a94905010343\",\"type\":\"Fullwidth\",\"components\":[{\"name\":\"Custom Component\",\"options\":{\"global\":false,\"js_code\":\"document.addEventListener('appLoaded', () => {\\n  document.querySelectorAll('#section-every-student .slides.swiper-wrapper > div').forEach(slide => slide.classList.add('swiper-slide'));\\n\\n  new Swiper('.slideshow-container', {\\n    slidesPerView: 1,\\n    loop: true,\\n    effect: 'fade',\\n    autoplay: {\\n      delay: 4500,\\n      disableOnInteraction: false,\\n    },\\n    // pagination: {\\n    //   el: '.swiper-pagination',\\n    //   clickable: true,\\n    // }\\n  });\\n});\",\"css_code\":\"#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 {\\n  /* styling for CMS */\\n  /* can be with display: none in edit template code to be hidden as default */\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 .custom-section {\\n  display: block !important;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 .custom-section:has(.link-actions) {\\n  padding: 20px;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 label.only-in-cms {\\n  font-size: 16px;\\n  font-weight: 600;\\n  margin-top: 15px;\\n  margin-bottom: 10px;\\n  display: block;\\n  letter-spacing: 0.03em;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 .custom-section:has(.link-actions) .hide-on-cms {\\n  display: none !important;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 label.only-in-cms:nth-child(2) {\\n  margin-top: 0;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 .custom-section:not(:has(.link-actions)) .only-in-cms {\\n  display: none !important;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 .custom-section .homepage-image-wrapper img.image-container-image {\\n  display: block;\\n  width: auto;\\n  height: auto;\\n  object-fit: contain;\\n  min-height: 150px;\\n  min-width: 150px;\\n  max-height: 250px;\\n  border: 1px solid #eee;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 .custom-section .homepage-image-wrapper {\\n  height: auto;\\n  margin-bottom: 10px;\\n  display: inline-block;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 .custom-section .homepage-icon-wrapper.blank-icon {\\n  display: inline-block;\\n  width: auto;\\n  min-width: 75px;\\n  min-height: 75px;\\n}\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb8 .custom-section .homepage-icon-wrapper .raw-svg,\\n#custom-component-d32e90eb-0e0a-446c-8043-59ce66d28fb