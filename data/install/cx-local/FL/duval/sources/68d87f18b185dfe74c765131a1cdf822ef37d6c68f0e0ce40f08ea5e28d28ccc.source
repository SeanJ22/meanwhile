u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/sandalwood\">Sandalwood High\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/ssee\">Southside Estates Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/southside\">Southside Middle\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/springpark\">Spring Park Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>",{"anchorTag":81,"customClasses":3361,"theme":3134,"alternatingColors":12},[],{"id":3363,"name":3141,"type":3142,"properties":3364,"nodes":3366,"parentAccordionId":3329},"1cd20d3e-383c-485d-b5f1-c5974a102d77",{"anchorTag":81,"customClasses":3365,"text":3173,"panelExpanded":12},[],[3367],{"name":3057,"type":3038,"nodes":3368},[3369,3397,3410],{"id":3370,"name":3179,"type":3180,"content":3371,"properties":3396},"03c05f6f-28ee-49c7-8696-80466b417605",{"images":3372},[3373,3382,3389],{"name":2381,"type":3061,"assetUrl":3374,"content":3375,"properties":3378},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622089/c22a93a3-5b14-4e18-9ebd-e266aa389e92.png",{"assetUrl":3374,"assetId":3376,"altText":3377,"caption":81},4622089,"Cindy Pearson and a male Board Member.",{"anchorTag":81,"customClasses":3379,"isDecorative":7,"naturalWidth":3380,"naturalHeight":3380,"focalPointPosition":3381},[],1536,{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3383,"content":3384,"properties":3387},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622086/df94348f-d8a8-4729-a3a2-c9551cf902d5.png",{"assetUrl":3383,"assetId":3385,"altText":3386,"caption":81},4622086,"Cindy Pearson, a female teacher,  & female principal.",{"anchorTag":81,"customClasses":3379,"isDecorative":7,"naturalWidth":3196,"naturalHeight":3196,"focalPointPosition":3388},{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3390,"content":3391,"properties":3394},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622078/7c2594d5-d46e-4a8e-adbf-7599b7dd6f0c.jpeg",{"assetUrl":3390,"assetId":3392,"altText":3393,"caption":81},4622078,"Cindy Pearson and a female teacher.",{"anchorTag":81,"customClasses":3379,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3395},{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3379,"columnsCount":1091,"isLightbox":7,"showCaptions":7,"captionsAlignment":1845},{"id":3398,"name":3179,"type":3180,"content":3399,"properties":3409},"2929181e-a98f-4912-bcf3-c24e46bf69b4",{"images":3400},[3401],{"name":2381,"type":3061,"assetUrl":3402,"content":3403,"properties":3406},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622489/4f3ed400-14df-4a8e-9948-8b25e8cc0aef.jpeg",{"assetUrl":3402,"assetId":3404,"altText":3405,"caption":81},4622489,"Cindy Pearson reading to a female teacher",{"anchorTag":81,"customClasses":3407,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3408},[],{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3407,"columnsCount":1043,"isLightbox":7,"showCaptions":7,"captionsAlignment":1845},{"id":3411,"name":3179,"type":3180,"content":3412,"properties":3429},"7dd34759-0ce1-4fad-99bf-d665576a0fed",{"images":3413},[3414,3422],{"name":2381,"type":3061,"assetUrl":3415,"content":3416,"properties":3419},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4622513/6f5a1771-9242-47bc-be5d-a566951d6915.jpeg",{"assetUrl":3415,"assetId":3417,"altText":3418,"caption":81},4622513,"Cindy Pearson and two females",{"anchorTag":81,"customClasses":3420,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3421},[],{"x":3124,"y":3124},{"name":2381,"type":3061,"assetUrl":3423,"content":3424,"properties":3427},"https://cmsv2-assets.apptegy.net/uploads/23734/file/5972405/1d0c229e-6bc2-469b-8e92-291aa3d7a3f3.jpeg",{"assetUrl":3423,"assetId":3425,"altText":3426,"caption":81},5972405,"People in yellow shirts stand around a sand pile spelling 'HOGAN'. A sign is behind them, and construction equipment is in the background.",{"anchorTag":81,"customClasses":3420,"isDecorative":7,"naturalWidth":1054,"naturalHeight":1054,"focalPointPosition":3428},{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3420,"columnsCount":1043,"isLightbox":7,"showCaptions":7,"captionsAlignment":1845},{"id":3431,"name":3099,"type":3100,"content":3432,"properties":3453},"882de8dd-04bc-42d4-8879-353f2de15712",{"heading":3433,"text":3439,"image":3445},{"id":3434,"name":3091,"type":3092,"content":3435,"properties":3437},"cardTitle_882de8dd-04bc-42d4-8879-353f2de15712",{"html":3436},"\u003Ch3>Darryl D. Willie\u003C/h3>",{"anchorTag":81,"customClasses":3438},[],{"id":3440,"name":3110,"type":3111,"content":3441,"properties":3443},"cardContent_882de8dd-04bc-42d4-8879-353f2de15712",{"html":3442},"\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">Board Member\u003C/span>\u003C/p>\u003Cp style=\"text-align: left\">District 4\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:WillieD@duvalschools.org\">Email Darryl Willie\u003C/a>\u003C/p>\u003Cp style=\"text-align: left\">\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"tel:+19043902374\">904-390-2374\u003C/a>\u003C/p>",{"anchorTag":81,"customClasses":3444},[],{"name":2381,"type":3061,"assetUrl":3446,"content":3447,"properties":3450},"https://cmsv2-assets.apptegy.net/uploads/23734/file/3403894/f272f44b-8912-465d-a18b-54f9d524cca8.png",{"assetUrl":3446,"assetId":3448,"altText":3449},3403894,"Darryl Willie",{"isDecorative":7,"naturalWidth":3451,"naturalHeight":3451,"focalPointPosition":3452},445,{"x":3124,"y":3124},{"anchorTag":81,"customClasses":3454,"design":3127,"showImage":12,"showHeadline":12,"imagePosition":1842,"wrapText":7,"textCursor":1054,"headlineCursor":1054},[],{"id":3456,"name":3130,"type":3131,"properties":3457,"nodes":3459},"a164711e-fd78-4aca-98bc-b293744d76f0",{"anchorTag":81,"customClasses":3458,"theme":3134,"iconStyle":3135,"allowMultipleOpenPanels":12},[],[3460],{"name":3057,"type":3038,"nodes":3461},[3462,3475,3488],{"id":3463,"name":3141,"type":3142,"properties":3464,"nodes":3466,"parentAccordionId":3456},"c677767a-bbcf-4b09-87ff-6a58536d11cd",{"anchorTag":81,"customClasses":3465,"text":1538,"panelExpanded":12},[],[3467],{"name":3057,"type":3038,"nodes":3468},[3469],{"id":3470,"name":3110,"type":3111,"content":3471,"properties":3473},"3da8d2a0-6dc3-4b03-9d84-fd3b9d146543",{"html":3472},"\u003Cp style=\"text-align: left\">\u003Cspan style=\"font-size: 16px\">Darryl Willie is a dynamic education ambassador with experience from K-12 to higher education. He has worked in education for the past 20 years from the front lines as a classroom teacher in the Mississippi Delta; to Education Administrator in California at UC Berkeley to Executive Director of Teach for America in Jacksonville. He has served on the Duval County School Board for 6 years and will serve through 2026. While on the board he has been a part of securing monumental funding for the rebuilding of neighborhood schools, successfully raising teacher salaries with a county-wide vote, and changing the names of confederate schools in the community.\u003Cbr>\u003Cbr>Darryls’ work has been centered on impacting communities of color, with an intentional focus on sustainable outcomes for students and young adults. In addition to his school board role, Darryl also works as a non-profit leader and consultant in workforce development and education, developing community and business partnerships, managing strategic projects, accelerating and facilitating learning spaces across multiple cities and states. His work has not gone unnoticed as he was recognized as a Jacksonville Non-Profit Emerging leader, Leadership Jacksonville selection, School Board Partners National Fellow, Leadership Florida Education Class, and Jacksonville Business Journal top 40 under 40.\u003Cbr>\u003Cbr>Darryl also serves on several local boards and has served on advisory boards for university presidents at two institutions. His community involvement includes the following: &nbsp;Northwest Jacksonville Community Development Corporation, Jacksonville Arts and Music School, Level the Playing Field, Jacksonville Zoo and Gardens, Alpha Phi Alpha Fraternity Inc, and 100 Black Men of Jacksonville.\u003Cbr>\u003Cbr>Darryl is a proud military brat and has lived in many states and overseas. He attended North Carolina State University where he was Student Body President and holds a Masters Degree in Higher Education from the University of Georgia. Darryl lives on the Northside of Jacksonville with his brilliant and beautiful wife and his 3 inquisitive daughters.\u003C/span>\u003C/p>",{"anchorTag":81,"customClasses":3474},[],{"id":3476,"name":3141,"type":3142,"properties":3477,"nodes":3479,"parentAccordionId":3456},"c8b60554-6a11-48f0-b22c-54dab6e72146",{"anchorTag":81,"customClasses":3478,"text":2933,"panelExpanded":12},[],[3480],{"name":3057,"type":3038,"nodes":3481},[3482],{"id":3483,"name":3163,"type":3164,"content":3484,"properties":3486},"ab5fe87e-d57a-478c-90d7-fdf77c316a2f",{"html":3485},"\u003Ctable style=\"width: 100%; min-width: 100px\">\u003Ccolgroup>\u003Ccol style=\"min-width: 100px\">\u003C/colgroup>\u003Ctbody>\u003Ctr>\u003Cth colspan=\"1\" rowspan=\"1\" scope=\"col\">\u003Cp>\u003Cstrong>School Name\u003C/strong>\u003C/p>\u003C/th>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/prhs\">A. Philip Randolph Career Academies\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/ajhs\">Andrew Jackson High\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/biscayne\">Biscayne Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/bshs\">Bridge to Success Academy High\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/dinsmore\">Dinsmore Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/fch\">First Coast High\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/gardencity\">Garden City Elementary\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/gpc\">Grand Park Education Center\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dcps.duvalschools.org/o/hes\">Highlands Estates Academy\u003C/a>\u003C/p>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd colspan=\"1\" rowspan=\"1\">\u003Cp>\u003Ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" hre