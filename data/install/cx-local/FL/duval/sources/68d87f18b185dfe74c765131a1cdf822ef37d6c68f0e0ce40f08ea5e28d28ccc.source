\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3404097/843958a8-2323-463e-9c9e-e9dc773712cc.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3404097/843958a8-2323-463e-9c9e-e9dc773712cc.jpeg\",\"assetId\":3404097,\"altText\":\"Purple Ball 2019\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3404102/dfdcfd9c-1352-493e-9548-d4bd75bd6ed9.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3404102/dfdcfd9c-1352-493e-9548-d4bd75bd6ed9.jpeg\",\"assetId\":3404102,\"altText\":\"Little Langugae Learners 2019\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4589641/99e97f20-d725-47b2-b0ba-cb8a987beba4.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4589641/99e97f20-d725-47b2-b0ba-cb8a987beba4.png\",\"assetId\":4589641,\"altText\":\"Two Women\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":1242,\"naturalHeight\":1242,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4589667/ab9c4570-e906-428c-acc6-59a72ebb3977.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4589667/ab9c4570-e906-428c-acc6-59a72ebb3977.jpeg\",\"assetId\":4589667,\"altText\":\"Two Women\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":600,\"naturalHeight\":600,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4590544/d06175e3-16c0-4c3d-87ec-8728b47c4efc.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4590544/d06175e3-16c0-4c3d-87ec-8728b47c4efc.jpeg\",\"assetId\":4590544,\"altText\":\"Three Women \",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}}]},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"columnsCount\":4,\"isLightbox\":false,\"showCaptions\":false,\"captionsAlignment\":\"center\"}}]}],\"parentAccordionId\":\"2a3703ad-d578-40e1-bf4c-f493d75899dd\"}]}]},{\"id\":\"f5e0f0a8-3c3d-4f43-bd65-910aa5c0dac5\",\"name\":\"Card\",\"type\":\"CONTENT_NODE_CARD\",\"content\":{\"heading\":{\"id\":\"cardTitle_f5e0f0a8-3c3d-4f43-bd65-910aa5c0dac5\",\"name\":\"Heading\",\"type\":\"CONTENT_NODE_HEADING\",\"content\":{\"html\":\"<h3>Melody A. Bolduc</h3>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"text\":{\"id\":\"cardContent_f5e0f0a8-3c3d-4f43-bd65-910aa5c0dac5\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">Board Member</span></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">District 7</span></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"mailto:BolducM@duvalschools.org\\\">Email Melody A. Bolduc</a></p><p style=\\\"text-align: left\\\"><a target=\\\"_self\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"tel:9049271699\\\">904-927-1699</a></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"image\":{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989995/bcaf124f-2d7c-4198-bd28-e5377e2aaf55.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989995/bcaf124f-2d7c-4198-bd28-e5377e2aaf55.jpeg\",\"assetId\":3989995,\"altText\":\"Melody Bolduc\"},\"properties\":{\"isDecorative\":false,\"naturalWidth\":3320,\"naturalHeight\":3320,\"focalPointPosition\":{\"x\":50,\"y\":50}}}},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"design\":\"box-shadow\",\"showImage\":true,\"showHeadline\":true,\"imagePosition\":\"left\",\"wrapText\":false,\"textCursor\":0,\"headlineCursor\":0}},{\"id\":\"a3628389-cd28-4697-af47-fc47d23ef2eb\",\"name\":\"Accordion\",\"type\":\"CONTENT_NODE_ACCORDION\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"iconStyle\":\"caret\",\"allowMultipleOpenPanels\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"0acc5ba7-86ee-40bf-99cc-e19db13d0931\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"About\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"a2e3dab3-daaa-49a7-81a8-221162d36302\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p><span style=\\\"font-size: 16px\\\">Raised in Jacksonville's Mandarin area by supportive parents who placed a high value on education, Melody Bolduc has dedicated her life to empowering students and teachers. A proud graduate of Bishop Kenny High School, where she graduated with honors and earned the Florida Merit Scholarship, Melody pursued her lifelong dream of becoming a teacher by attending the University of North Florida. She graduated summa cum laude in 2000 with a bachelor's degree in Secondary English Education.&nbsp; <br><br>Melody is celebrating 18 years of marriage to her best friend from high school and is a proud mother to two talented teenage daughters who attend Mandarin High School. As a seasoned educator with over 24 years of experience in both public and private schools, Melody holds certifications for kindergarten through high school in multiple subject areas. Her career spans teaching diverse student populations, researching and developing curriculum, and consulting on best practices for individualized instruction.&nbsp; <br><br>As the owner of a small educational resource center, Melody provides consulting and tutoring services tailored to students' unique needs. This experience has strengthened her commitment to ensuring taxpayer dollars are spent effectively and directly benefit students and teachers through quality classroom resources and support.&nbsp; <br><br>Melody’s dedication extends beyond the classroom. She is an active community stakeholder, PTSA member, and school volunteer. Currently completing the final requirements for her doctorate and preparing to publish her first children’s book, Melody balances professional excellence with a passion for education advocacy.&nbsp; <br><br>On the School Board, Melody is committed to fostering strong partnerships between teachers, parents, and the community. She recognizes the critical role of parental involvement in student success and values the perspectives of teachers in shaping policy. With a focus on transparency, fiscal responsibility, and innovative problem-solving, Melody strives to make Duval County Public Schools a competitive and attractive choice for families, teachers, and students.&nbsp; <br><br>Melody’s purpose is clear: to serve as an active advocate and positive change agent for Duval County’s children, working collaboratively with all stakeholders to create a brighter future for public education.&nbsp;</span></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}}]}],\"parentAccordionId\":\"a3628389-cd28-4697-af47-fc47d23ef2eb\"},{\"id\":\"0ecfd10f-a8d1-44c5-9baa-0a66e55cba7b\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"List of Schools\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"217a44b9-74f9-4d5e-9c2b-c7a8f56c33e6\",\"name\":\"Table\",\"type\":\"CONTENT_NODE_TABLE\",\"content\":{\"html\":\"<table style=\\\"width: 100%; min-width: 100px\\\"><colgroup><col style=\\\"min-width: 100px\\\"></colgroup><tbody><tr><th colspan=\\\"1\\\" rowspan=\\\"1\\\" scope=\\\"col\\\"><p>School Name</p></th></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"http://www.duvalschools.org/achs\\\">Atlantic Coast High</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"http://www.duvalschools.org/bartramsprings\\\">Bartram Springs Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"http://www.duvalschools.org/crownpoint\\\">Crown Point Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"http://www.duvalschools.org/greenlandpines\\\">Greenland Pines Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"http://www.duvalschools.org/loretto\\\">Loretto Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"http://www.duvalschools.org/mhs\\\">Mandarin High</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blan