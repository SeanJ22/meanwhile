toggle\":false}},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"88b47d04-cedb-4bac-85d0-e75b7f80daef\",\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3397293/a8328e04-b1e1-4ae0-b523-a992bf2dfac7.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3397293/a8328e04-b1e1-4ae0-b523-a992bf2dfac7.png\",\"assetId\":3397293,\"altText\":\"duval banner\",\"caption\":\"\",\"link\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"actionOnClick\":\"no-action\",\"newTab\":false,\"imageAlignment\":\"center\",\"captionAlignment\":\"center\",\"columnPercentage\":100,\"isResized\":false,\"resizeMode\":\"actual-size\",\"showCaption\":true,\"isDecorative\":false,\"naturalWidth\":null,\"naturalHeight\":null,\"preferredWidth\":1440,\"preferredHeight\":700}}]}],\"name\":\"Full Width\",\"type\":\"LAYOUT_NODE_FULL_WIDTH_COLUMN\"},{\"id\":\"8049e099-6995-40b5-a610-cfdb0f4baea7\",\"properties\":{\"customClasses\":[],\"anchorTag\":\"\",\"margin\":{\"top\":10,\"left\":10,\"right\":10,\"value\":10,\"bottom\":10,\"linked\":true},\"padding\":{\"top\":0,\"left\":0,\"right\":0,\"value\":0,\"bottom\":0,\"linked\":true},\"borderRadius\":{\"value\":0},\"backgroundColor\":{\"value\":\"\",\"toggle\":false},\"backgroundImage\":{\"image\":null,\"toggle\":false}},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[]},{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"d0a082d9-fe36-44ae-98ec-ae4e3cf33011\",\"name\":\"Heading\",\"type\":\"CONTENT_NODE_HEADING\",\"content\":{\"html\":\"<h1>School Board Members</h1>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},{\"id\":\"36eaf8d1-d40e-41a5-b063-57a83441ad21\",\"name\":\"Card\",\"type\":\"CONTENT_NODE_CARD\",\"content\":{\"heading\":{\"id\":\"cardTitle_36eaf8d1-d40e-41a5-b063-57a83441ad21\",\"name\":\"Heading\",\"type\":\"CONTENT_NODE_HEADING\",\"content\":{\"html\":\"<h3>Anthony Ricardo</h3>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"text\":{\"id\":\"cardContent_36eaf8d1-d40e-41a5-b063-57a83441ad21\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">Board Member</span></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">District 1</span></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"mailto:RicardoA@duvalschools.org\\\">Email Anthony Ricardo</a></p><p style=\\\"text-align: left\\\"><a target=\\\"_self\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"tel:9043902371\\\">904-927-1700</a></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"image\":{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989971/6edb8acb-344d-4581-9810-9361f188ba7d.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3989971/6edb8acb-344d-4581-9810-9361f188ba7d.jpeg\",\"assetId\":3989971,\"altText\":\"Anthony Ricardo\"},\"properties\":{\"isDecorative\":false,\"naturalWidth\":3044,\"naturalHeight\":3044,\"focalPointPosition\":{\"x\":50,\"y\":50}}}},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"design\":\"box-shadow\",\"showImage\":true,\"showHeadline\":true,\"imagePosition\":\"left\",\"wrapText\":false,\"textCursor\":0,\"headlineCursor\":0}},{\"id\":\"93f44fc3-6e86-4aef-b9a0-60319f07bb2a\",\"name\":\"Accordion\",\"type\":\"CONTENT_NODE_ACCORDION\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"iconStyle\":\"caret\",\"allowMultipleOpenPanels\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"33b36e8f-4ad5-42f5-8786-23ae4ca40d13\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"About\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"b2d5d24a-dd2a-43cd-82eb-b81039b256d4\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p><span style=\\\"font-size: 16px\\\">Anthony “Tony” Ricardo has been a resident of Jacksonville’s Northside since 1960. He is a former educator, a father of three, a grandfather of eight, and the proprietor of Ricardo Designs, a commercial art business he established in 1992. His innovative and distinctive creations in the signage industry have been showcased in esteemed trade publications and have earned him numerous international accolades. Interestingly, many of Tony’s meticulously hand-painted school mascots adorn gymnasiums across Florida and Georgia.<br></span><br><span style=\\\"font-size: 16px\\\">Upon graduating from Bishop Kenny High School, Tony obtained a Bachelor of Arts in Art Education. He taught at various public and private institutions, spanning from elementary to secondary levels, ultimately settling at Andrew Jackson High School where he taught Drawing, Painting, Photography, Cinematography, and also coached tennis, soccer, and baseball until 1992.</span><br><span style=\\\"font-size: 16px\\\"><br>All three of his children completed their education at First Coast High School, and for over 35 years, he has been actively engaged in the local community and a dedicated member of First Coast Christian Center. Tony’s extensive business background and teaching experience provide him with a profound insight into the prevailing challenges in public education. His conservative values have instilled in him a fervent desire to address these issues. His deep-rooted affection for Jacksonville, his beloved hometown, propels him to seek opportunities to serve the community and contribute to providing students with the exceptional education they deserve, while also striving to enhance the working environment for educators. Endorsed by Gov. DeSantis, Tony Ricardo is a representative of Oceanway, North Arlington, and Fort Caroline schools.</span></p><p></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}}]}],\"parentAccordionId\":\"93f44fc3-6e86-4aef-b9a0-60319f07bb2a\"},{\"id\":\"93006c79-7246-4695-8799-92110a8fb7c3\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"List of Schools\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"cbf5ae2e-f235-496c-bc22-3f46cdabbe45\",\"name\":\"Table\",\"type\":\"CONTENT_NODE_TABLE\",\"content\":{\"html\":\"<table style=\\\"width: 100%; min-width: 100px\\\"><colgroup><col style=\\\"min-width: 100px\\\"></colgroup><tbody><tr><th colspan=\\\"1\\\" rowspan=\\\"1\\\" scope=\\\"col\\\"><p>School Name</p></th></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/arlingtonelementary\\\">Arlington Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/ahe\\\">Arlington Heights Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/arlingtonmiddle\\\">Arlington Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/fce\\\">Fort Caroline Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/fcm\\\">Fort Caroline Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener norefer