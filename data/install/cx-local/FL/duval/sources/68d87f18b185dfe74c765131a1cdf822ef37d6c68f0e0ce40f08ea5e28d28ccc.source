-item-text":2423},{"text":2424},"This 12th grader and student-athlete is able to succeed with the support he needs.",{},{"media-title":2427,"media-all-button":2429},{"text":2428},"The Duval Schools Difference",{"href":2305,"text":2430,"target":2105},"All Videos",{"media-text":2432},{"text":2433},"As an A-rated school district, we have made extraordinary progress in student achievement with an unwavering focus on learning.",{},{"icon":2436,"loop":2437,"image":2480,"input":2481,"textarea":2482,"rich_textarea":2483},{},{"gallery-text-wrapper":2438},[2439,2448,2456,2464,2472],{"input":2440,"textarea":2445},{"gallery-title":2441,"gallery-button":2443},{"text":2442},"Duval Delivers: A Florida A-Rated School District",{"href":2279,"text":2444,"target":1533},"Enroll Today",{"gallery-textarea":2446},{"text":2447},"Preparing students for college and life success, now with the state’s highest rating.",{"input":2449,"textarea":2453},{"gallery-title":2450,"gallery-button":2452},{"text":2451},"An Individualized Learning Experience.",{"href":2279,"text":2444,"target":1533},{"gallery-textarea":2454},{"text":2455},"Serving students of different learning abilities, styles, and languages.",{"input":2457,"textarea":2461},{"gallery-title":2458,"gallery-button":2460},{"text":2459},"A Focus on Real-World, Career Readiness.",{"href":2279,"text":2444,"target":1533},{"gallery-textarea":2462},{"text":2463},"Providing enriching and hands-on experiences to prepare students for their futures.",{"input":2465,"textarea":2469},{"gallery-title":2466,"gallery-button":2468},{"text":2467},"Learning Beyond the Classroom.",{"href":2279,"text":2444,"target":1533},{"gallery-textarea":2470},{"text":2471},"Enriching the academic experience through extracurricular activities, off-site learning, and community partnerships.",{"input":2473,"textarea":2477},{"gallery-title":2474,"gallery-button":2476},{"text":2475},"Guiding Students Toward Greatness.",{"href":2279,"text":2444,"target":1533},{"gallery-textarea":2478},{"text":2479},"Inspiring every student and preparing them for success in college or a career, and life.",{},{},{},{},{"icon":2485,"loop":2486,"image":2487,"input":2493,"textarea":2494,"rich_textarea":2495},{},{},{"custom-banner":2488},{"url":2489,"href":2490,"text":2491,"target":1533,"alt_text":2492,"ai_generated_alt_text":12},"https://cmsv2-assets.apptegy.net/uploads/23734/file/6391086/5727f627-1d6a-486c-9813-a1962624be35.png","https://www.duvalschools.org/o/dcps/page/vote","Voters to Decide Funding for \"A\" Rated Duval School District","An image displays text \"For Teachers, For Students, For Duval\" with a smiling woman and child.",{},{},{},{"icon":2497,"loop":2498,"image":2531,"input":2532,"textarea":2536,"rich_textarea":2539},{},{"stats-loop":2499,"about-images":2512},[2500,2506],{"input":2501},{"stats-text":2502,"stats-number":2504},{"text":2503},"Pre-Kindergarten Programs",{"text":2505},"46",{"input":2507},{"stats-text":2508,"stats-number":2510},{"text":2509},"Purple Star Schools of Distinction",{"text":2511},"32",[2513,2522],{"image":2514,"input":2518},{"about-us-image":2515},{"url":2516,"alt_text":2517,"ai_generated_alt_text":12},"https://cmsv2-assets.apptegy.net/uploads/23734/file/6357403/45596195-a4f2-4da8-b85e-9bd8eab0ff87.png","A smiling boy in a blue hoodie holds a colorful kite. Behind him is a room with a blue wall, wooden cabinets, and an open space.",{"image-link":2519},{"href":2520,"text":2521,"target":1533},"/o/dcps/page/vpk","Pre-Kindergarten",{"image":2523,"input":2527},{"about-us-image":2524},{"url":2525,"alt_text":2526,"ai_generated_alt_text":12},"https://cmsv2-assets.apptegy.net/uploads/23734/file/6354641/7103e725-fc29-450c-be0a-4ab9d57cada4.png","Adult man in flight suit, boy in yellow jersey with number 18, woman in blue shirt, posing in front of balloons and silver backdrop.",{"image-link":2528},{"href":2529,"text":2530,"target":1533},"https://duvalcountypsfl.sites.thrillshare.com/o/dcps/page/military-families","Military Support",{},{"about-us-title":2533,"about-us-button":2535},{"text":2534},"More Reasons",{"href":2279,"text":2444,"target":1533},{"about-us-text":2537},{"text":2538},"Need more reasons to enroll? See how we serve all students and families.",{},{"icon":2541,"loop":2542,"image":2602,"input":2603,"textarea":2604,"rich_textarea":2605},{},{"slides-loop":2543},[2544,2552,2562,2572,2582,2592],{"image":2545,"input":2549},{"slide-image":2546},{"url":2547,"alt_text":2548},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172259/bddc680c-6477-452d-97c4-42356b70c045.jpeg","Girl writing on paper",{"slide-title":2550,"slide-button":2551},{"text":1462},{"href":2279,"text":2444,"target":1533},{"image":2553,"input":2557},{"slide-image":2554},{"url":2555,"alt_text":2556},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172272/5df96bad-91f6-419e-ad05-851866fe3614.jpeg","Student working with medical equipment",{"slide-title":2558,"slide-button":2560},{"text":2559},"Cada Estudiante. Cada Dia.",{"href":2279,"text":2561,"target":2105},"Inscríbete Hoy",{"image":2563,"input":2567},{"slide-image":2564},{"url":2565,"alt_text":2566},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172278/d24debef-bdd9-4225-8bd3-334c0230e53a.jpeg","Student working on computer",{"slide-title":2568,"slide-button":2570},{"text":2569},"Cada Aluno. Diariamente.",{"href":2279,"text":2571,"target":1533},"Inscreva-se hoje",{"image":2573,"input":2577},{"slide-image":2574},{"url":2575,"alt_text":2576},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172369/2422f836-2bc1-449a-bd98-c57915950f98.jpeg","Student working with other student in a computer",{"slide-title":2578,"slide-button":2580},{"text":2579},"كل طالب. كل يوم",{"href":2279,"text":2581,"target":1533},"سجل اليوم",{"image":2583,"input":2587},{"slide-image":2584},{"url":2585,"alt_text":2586},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172371/034f76af-1eac-4b74-b793-5b8beb05f48b.jpeg","Elementary Student writing in paper",{"slide-title":2588,"slide-button":2590},{"text":2589},"هر دانش آموز هر روز",{"href":2279,"text":2591,"target":1533},"امروز ثبت نام کنید",{"image":2593,"input":2597},{"slide-image":2594},{"url":2595,"alt_text":2596},"https://cmsv2-assets.apptegy.net/uploads/23734/file/4172373/6405af1d-ce15-47ff-a718-21db67996237.jpeg","Student speaking",{"slide-title":2598,"slide-button":2600},{"text":2599},"Каждый студент. Каждый день.",{"href":2279,"text":2601,"target":1533},"Зарегистрируйтесь сегодня",{},{},{},{},{"icon":2607,"loop":2608,"image":2609,"input":2613,"textarea":2619,"rich_textarea":2622},{},{},{"left-image":2610},{"url":2611,"alt_text":2612,"ai_generated_alt_text":12},"https://cmsv2-assets.apptegy.net/uploads/23734/file/6349305/20ffd36d-5c74-45e6-ace8-1e77a131d430.png","Woman with braided hair helps three young students with school work at a table in a classroom.",{"right-content-title":2614,"right-content-button":2616},{"text":2615},"Join our Team!",{"href":2617,"text":2618,"target":1533},"/page/careers","View Careers",{"right-content-text":2620},{"text":2621},"Become one of 11,000 dedicated professionals who make a difference in the lives of children every day. Whether it’s as a teacher, bookkeeper, counselor, maintenance worker, or one of dozens of other roles, Team Duval employees work together to ensure children achieve academic excellence and are prepared to succeed in life, college, and their careers.",{},{"links_color":2624,"school_name":80,"customHeader":12,"primary_color":2628,"alert_bg_color":2632,"school_tag_line":1462,"secondary_color":2640,"alert_link_color":2650,"alert_text_color":2661,"cms_heading_color":2665,"organization_type":2679,"alert_lightbox_overlay":2680,"page_builder_theme_color":2684},{"a":1043,"hex":1044,"hsl":2625,"hsv":2626,"hex8":1050,"rgba":2627,"source":1106,"fixedColor":1057},{"a":1043,"h":1046,"l":1047,"s":1043},{"a":1043,"h":1046,"s":1043,"v":1049},{"a":1043,"b":1052,"g":1053,"r":1054},{"a":1043,"hex":1044,"hsl":2629,"hsv":2630,"hex8":1050,"rgba":2631,"source