"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/wae\\\">Woodland Acres Elementary</a></p></td></tr></tbody></table>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"alternatingColors\":true}}]}],\"parentAccordionId\":\"93f44fc3-6e86-4aef-b9a0-60319f07bb2a\"},{\"id\":\"a89d2406-1125-4049-9944-185825725b41\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"Photo Gallery\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"8d17801e-da3a-4773-93ac-96609a8fe423\",\"name\":\"Gallery\",\"type\":\"CONTENT_NODE_GALLERY\",\"content\":{\"images\":[{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708852/9e96343a-138e-4a6e-9453-9cf139c60412.jpeg\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708852/9e96343a-138e-4a6e-9453-9cf139c60412.jpeg\",\"assetId\":4708852,\"altText\":\"Board Member Ricardo and two Ladies\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":0,\"naturalHeight\":0,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708926/780726ac-e486-494a-a4b1-8401e493923a.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708926/780726ac-e486-494a-a4b1-8401e493923a.png\",\"assetId\":4708926,\"altText\":\"Board Member Ricardo and two Ladies\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":4284,\"naturalHeight\":4284,\"focalPointPosition\":{\"x\":50,\"y\":50}}},{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708967/b302c5b5-64cf-47d3-aef4-15277ea0a5bf.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/4708967/b302c5b5-64cf-47d3-aef4-15277ea0a5bf.png\",\"assetId\":4708967,\"altText\":\"Board Member Ricardo and two Ladies\",\"caption\":\"\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"isDecorative\":false,\"naturalWidth\":2627,\"naturalHeight\":2627,\"focalPointPosition\":{\"x\":50,\"y\":50}}}]},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"columnsCount\":2,\"isLightbox\":false,\"showCaptions\":false,\"captionsAlignment\":\"center\"}}]}],\"parentAccordionId\":\"93f44fc3-6e86-4aef-b9a0-60319f07bb2a\"}]}]},{\"id\":\"323ee41a-2e59-4ef7-843a-e5ab91309402\",\"name\":\"Card\",\"type\":\"CONTENT_NODE_CARD\",\"content\":{\"heading\":{\"id\":\"cardTitle_323ee41a-2e59-4ef7-843a-e5ab91309402\",\"name\":\"Heading\",\"type\":\"CONTENT_NODE_HEADING\",\"content\":{\"html\":\"<h3><span>April A. Carney</span></h3>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"text\":{\"id\":\"cardContent_323ee41a-2e59-4ef7-843a-e5ab91309402\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">Vice Chair</span></p><p style=\\\"text-align: left\\\"><span style=\\\"font-size: 16px\\\">District 2</span></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"mailto:CarneyA1@duvalschools.org\\\">Email April A. Carney</a></p><p style=\\\"text-align: left\\\"><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"tel:+19043902386\\\">904-390-2386</a></p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}},\"image\":{\"name\":\"Image\",\"type\":\"CONTENT_NODE_IMAGE\",\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3403857/9fe24411-7bb8-4b8e-8bca-13b0ddd7b0bb.png\",\"content\":{\"assetUrl\":\"https://cmsv2-assets.apptegy.net/uploads/23734/file/3403857/9fe24411-7bb8-4b8e-8bca-13b0ddd7b0bb.png\",\"assetId\":3403857,\"altText\":\" April A. Carney\"},\"properties\":{\"isDecorative\":false,\"naturalWidth\":450,\"naturalHeight\":450,\"focalPointPosition\":{\"x\":50,\"y\":50}}}},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"design\":\"box-shadow\",\"showImage\":true,\"showHeadline\":true,\"imagePosition\":\"left\",\"wrapText\":false,\"textCursor\":0,\"headlineCursor\":0}},{\"id\":\"5ecd72c4-9019-495a-866b-9ae770efc844\",\"name\":\"Accordion\",\"type\":\"CONTENT_NODE_ACCORDION\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"iconStyle\":\"caret\",\"allowMultipleOpenPanels\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"c10d8b5f-b103-49b3-a2a6-0372a21b3695\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"About\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"7d313038-9efe-4c6b-b5b8-c4be606ff8df\",\"name\":\"Text\",\"type\":\"CONTENT_NODE_TEXT\",\"content\":{\"html\":\"<p>April Carney came to Jacksonville in 2000 from New York City after leaving a career on Wall Street working for Smith Barney and CIBC Oppenheimer for almost six years. After moves to Atlanta and Denver for her husband Drew’s career, they decided to come back home to Jacksonville in 2016. April attended West Virginia University after high school and later transferred to Florida State College of Jacksonville’s Interior Design Program. Since 2013, she owns and operates the Interior Design Firm, Re-Dew Interiors which specializes in residential interiors, new construction, and renovations.</p><p>As a fierce advocate for her own children’s education, she is a firm supporter of parental rights, school safety and discipline, fiscal transparency, and educational freedom. She believes all children deserve a quality education tailored to their individual needs to reach their true potential.</p><p>April currently represents DCPS as Board Trustee for the FSBA Florida Palm, and also acts as the alternate for the FSBA legislative committee for DCPS. She is one of the founding members and current Board Vice President for The Florida Coalition of Conservative School Board Members.</p><p>April is a wife of over 20 years, and mother of two wonderful girls and two rescue dogs. She enjoys spending time at the beach, hiking, traveling, regularly attending her church, and spending time in the gym.&nbsp;</p><p>April currently represents District 2, which covers the Beaches and Intracoastal West area of Jacksonville.</p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}}]}],\"parentAccordionId\":\"5ecd72c4-9019-495a-866b-9ae770efc844\"},{\"id\":\"44953236-3685-4ba5-b81f-72d823b88a6d\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"List of Schools\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"c9b2b3d1-be4d-4de0-915d-1b57f390a146\",\"name\":\"Table\",\"type\":\"CONTENT_NODE_TABLE\",\"content\":{\"html\":\"<table style=\\\"width: 100%; min-width: 100px\\\"><colgroup><col style=\\\"min-width: 100px\\\"></colgroup><tbody><tr><th colspan=\\\"1\\\" rowspan=\\\"1\\\" scope=\\\"col\\\"><p><span style=\\\"font-size: 16px\\\"><strong>School Names</strong></span></p></th></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/abesspark\\\">Abess Park Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/alimacani\\\">Alimacani Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://www.duvalschools.org/o/aaes\\\"><span style=\\\"font-size: 16px\\\">Anchor Academy</span></a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/abe\\\">Atlantic Beach Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/jaa\\\">J. Allen Axson Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/cce\\\">Chets Creek Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/fhs\\\">Duncan U. Fletcher High</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/fms\\\">Duncan U. Fletcher Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/jbe\\\">Jacksonville Beach Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/kms\\\">Kernan Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/kernantrail\\\">Kernan Trail Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/landmark\\\">Landmark Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/msec\\\">Marine Science Education Center</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/mayport\\\">Mayport Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/mayportmiddle\\\">Mayport Middle</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/nbe\\\">Neptune Beach Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/spe\\\">Sabal Palm Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/sanpablo\\\">San Pablo Elementary</a></p></td></tr><tr><td colspan=\\\"1\\\" rowspan=\\\"1\\\"><p><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://dcps.duvalschools.org/seabreeze\\\">Seabreeze Elementary</a></p></td></tr></tbody></table>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"theme\":\"dark\",\"alternatingColors\":true}}]}],\"parentAccordionId\":\"5ecd72c4-9019-495a-866b-9ae770efc844\"},{\"id\":\"34a3d88f-d3f8-415b-a34b-99271da8f260\",\"name\":\"Accordion Panel\",\"type\":\"CONTENT_NODE_PANEL\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"text\":\"Photo Gallery\",\"panelExpanded\":true},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"e43cdd9a-1f41-44e1-bc4f-6631f264fe7a\",\"name\":\"Gallery\",\"type\":\"CONTENT_NODE_GALLERY\",\"content\":{\"images\":[{\"name\":\"Image\",\"type