nfig: {\\n  //         speed: 400,\\n  //         spaceBetween: 16,\\n  //         simulateTouch: true,\\n  //         slidesPerView: 1,\\n  //         navigation: {\\n  //           nextEl: '.lf-swiper-button-next',\\n  //           prevEl: '.lf-swiper-button-prev',\\n  //         },\\n  //         breakpoints: {\\n  //           680: {\\n  //             slidesPerView: 2,\\n  //           },\\n  //           980: {\\n  //             slidesPerView: 3,\\n  //           },\\n  //           1230: {\\n  //             slidesPerView: 4,\\n  //           }\\n  //         },\\n  //       },\\n  //     };\\n  //   if (document.body.classList.contains('duval-county-public-schools')) {\\n  //       const liveFeedConfig = ConfigDefaults.mergeWithLiveFeedDefaults(liveFeedApiConfigOverrides);\\n  //       new LiveFeedHTMLBuilder(liveFeedConfig);\\n  //   }\\n  // });\",\"css_code\":\"#custom-html-7033c632-810d-40ad-96b2-a3375b2fd5d0 .custom-section {\\n  display: block !important;\\n}\\n\",\"html_code\":\"<div class=\\\"live-feed-section custom-section\\\" id=\\\"section-live-feed\\\">\\n    <div class=\\\"see-all-container see-all-top\\\">\\n        <div class=\\\"header header-slot-container\\\">\\n            <h2>What’s Happening</h2>\\n\\n          <div class=\\\"flex items-center gap-24\\\">\\n                      <div class=\\\"lf-swiper-button-prev swiper-button-prev\\\" tabindex=\\\"-1\\\" role=\\\"button\\\" aria-label=\\\"Previous slide\\\">\\n                        <img src=\\\"https://cmsv2-shared-assets.apptegy.net/Schools/Duval-County-Public-Schools-4876/Images/home/slider-left-arrow.svg\\\" arial-label=\\\"slide-left\\\" loading=\\\"lazy\\\">\\n                      </div>\\n                      <div class=\\\"lf-swiper-button-next swiper-button-next\\\" tabindex=\\\"-1\\\" role=\\\"button\\\" aria-label=\\\"Next slide\\\">\\n                        <img src=\\\"https://cmsv2-shared-assets.apptegy.net/Schools/Duval-County-Public-Schools-4876/Images/home/slide