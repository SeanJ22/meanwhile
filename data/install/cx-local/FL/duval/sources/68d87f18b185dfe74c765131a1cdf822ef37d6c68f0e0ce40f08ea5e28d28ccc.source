code":1237,"html_code":1238,"scss_code":1239,"container_id":1240},"document.addEventListener('appLoaded', () => {\n\n  const moveGalleryText = (callback) => {\n    document.querySelectorAll('.gallery-text-wrapper > div').forEach(slide => slide.classList.add('swiper-slide'));\n\n    const galleryTextArrows = document.querySelector('.gallery-text-arrows');\n\n    const g2VideoWrapper = document.querySelector('#g2 .video-wrapper');\n\n    if (galleryTextArrows && g2VideoWrapper) {\n      g2VideoWrapper.appendChild(galleryTextArrows);\n    }\n\n    callback();\n  };\n\n  const galleryTextSlider = () => {\n    setTimeout(() => {\n      new Swiper('#cms-gallery .gallery-text', {\n        speed: 400,\n        simulateTouch: false,\n        slidesPerView: 1,\n        rewind: true,\n        autoHeight: true,\n        loop: true,\n        spaceBetween: 25,\n        autoplay: {\n          delay: 7500,\n          disableOnInteraction: true,\n        },\n        pagination: {\n          el: '.gallery-pagination',\n          clickable: true,\n        },\n        navigation: {\n          nextEl: '.gallery-swiper-button-next',\n          prevEl: '.gallery-swiper-button-prev',\n        },\n      });\n  }, 500);\n    \n  };\n\n  moveGalleryText(galleryTextSlider);\n\n\n}); ","#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d {\n  /* styling for CMS */\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section:has(.link-actions) {\n  padding: 20px;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d label.only-in-cms {\n  font-size: 16px;\n  font-weight: 600;\n  margin-top: 15px;\n  margin-bottom: 10px;\n  display: block;\n  letter-spacing: 0.03em;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d label.only-in-cms:nth-child(2) {\n  margin-top: 0;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section:has(.link-actions) .hide-on-cms {\n  display: none !important;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section:not(:has(.link-actions)) .only-in-cms {\n  display: none !important;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-image-wrapper img.image-container-image {\n  display: block;\n  width: auto;\n  height: auto;\n  object-fit: contain;\n  min-height: 150px;\n  min-width: 150px;\n  max-height: 250px;\n  border: 1px solid #eee;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-image-wrapper {\n  height: auto;\n  margin-bottom: 10px;\n  display: inline-block;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper.blank-icon {\n  display: inline-block;\n  width: auto;\n  min-width: 75px;\n  min-height: 75px;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper .raw-svg,\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper {\n  display: inline-block;\n  width: auto;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper svg {\n  height: 75px;\n  width: 75px;\n  object-fit: contain;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-icon-wrapper .raw-svg {\n  border: 1px solid #eee;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-textarea-wrapper textarea,\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-section .homepage-input-wrapper input {\n  border: 1px solid #ddd;\n  padding: 5px;\n  margin-bottom: 10px;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-component:has(.link-button) {\n  padding-left: 20px;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-component .link-actions-container.link-actions-container-link {\n  left: 0;\n  visibility: visible;\n}\n#custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d .custom-component-loop-wrapper > div {\n  padding: 10px;\n  box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);\n  margin-bottom: 20px;\n}\n","\u003Cdiv class=\"custom-section gallery-text-arrows\">\n  \u003Cdiv class=\"gallery-text swiper\">\n    \u003Ccms-loop class=\"gallery-text-wrapper swiper-wrapper\" name=\"gallery-text-wrapper\">\n      \u003Clabel class=\"only-in-cms\">Add gallery title:\u003C/label>\n      \u003Cdiv class=\"title\">        \n        \u003Ccms-input name=\"gallery-title\">\u003C/cms-input>\n      \u003C/div>\n      \u003Clabel class=\"only-in-cms\">Add gallery text:\u003C/label>\n      \u003Cdiv class=\"description\">\n        \u003Cp>\n          \u003Ccms-textarea name=\"gallery-textarea\">\u003C/cms-textarea>\n        \u003C/p>\n      \u003C/div>\n      \u003Clabel class=\"only-in-cms\">Add gallery button:\u003C/label>\n      \u003Cdiv class=\"button square light\">\u003Ccms-input name=\"gallery-button\" link>\u003C/cms-input>\u003C/div>\n    \u003C/cms-loop>\n  \u003C/div>\n  \u003Cdiv class=\"gallery-arrows-buttons flex items-center gap-24 hide-on-cms\">\n    \u003Cdiv class=\"gallery-swiper-button-prev swiper-button-prev\" tabindex=\"-1\" role=\"button\" aria-label=\"Previous slide\">\n      \u003Cspan>Previous slide\u003C/span>\n    \u003C/div>\n    \u003Cdiv class=\"gallery-pagination\">\u003C/div>\n    \u003Cdiv class=\"gallery-swiper-button-next swiper-button-next\" tabindex=\"-1\" role=\"button\" aria-label=\"Next slide\">\n      \u003Cspan>Next slide\u003C/span>\n    \u003C/div>\n  \u003C/div>\n\u003C/div>","/* styling for CMS */ \n.custom-section:has(.link-actions) {\n    padding: 20px;\n}\nlabel.only-in-cms {\n    font-size: 16px;\n    font-weight: 600;\n    margin-top: 15px;\n    margin-bottom: 10px;\n    display: block;\n    letter-spacing: 0.03em;;\n}\nlabel.only-in-cms:nth-child(2) {\n    margin-top: 0;\n}\n.custom-section:has(.link-actions) .hide-on-cms {\n    display: none !important;\n}\n.custom-section:not(:has(.link-actions)) .only-in-cms {\n    display: none !important;\n}\n.custom-section .homepage-image-wrapper img.image-container-image {\n    display: block;\n    width: auto;\n    height: auto;\n    object-fit: contain; \n    min-height: 150px;\n    min-width: 150px;\n    max-height: 250px;\n    border: 1px solid #eee;\n}\n.custom-section .homepage-image-wrapper {\n    height: auto;\n    margin-bottom: 10px;\n    display: inline-block;\n}\n.custom-section .homepage-icon-wrapper.blank-icon {\n    display: inline-block;\n    width: auto;\n    min-width: 75px;\n    min-height: 75px;\n}\n.custom-section .homepage-icon-wrapper .raw-svg,\n.custom-section .homepage-icon-wrapper {\n    display: inline-block;\n    width: auto;\n}\n.custom-section .homepage-icon-wrapper svg {\n    height: 75px;\n    width: 75px;\n    object-fit: contain;\n}\n.custom-section .homepage-icon-wrapper .raw-svg {\n    border: 1px solid #eee;\n}\n.custom-section .homepage-textarea-wrapper textarea,\n.custom-section .homepage-input-wrapper input {\n    border: 1px solid #ddd;\n    padding: 5px;\n    margin-bottom: 10px;\n}\n.custom-component:has(.link-button) {\n    padding-left: 20px;\n}\n.custom-component .link-actions-container.link-actions-container-link {\n    left: 0;\n    visibility: visible;\n}\n.custom-component-loop-wrapper > div {\n    padding: 10px;\n    box-shadow: 0 0 15px rgba(0,0,0,0.5);\n    margin-bottom: 20px;\n}","custom-component-bffa2dd2-e2f8-44f4-808a-a4904673ee1d",{"type":1218,"color":1242},{"hex":1076},{"id":1244,"type":1210,"components":1245,"decorativeBackground":1253},"528e141d-8b08-433c-9d27-6e6d82dc4ca5",[1246],{"name":1234,"options":1247},{"global":7,"js_code":1248,"css_code":1249,"html_code":1250,"scss_code":1251,"container_id":1252},"document.addEventListener('appLoaded', () => {\n  const buttonDivs = document.querySelectorAll('.button-group > div');\n  buttonDivs.forEach((div, index) => {\n    if (index \u003C buttonDivs.length - 1) {\n      div.insertAdjacentHTML('afterend', '\u003Cdiv class=\"line\">\u003C/div>');\n    }\n  });\n});\n","#custom-component-8fe7f0cb-4956-4c2d-a