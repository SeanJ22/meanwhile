ticle-btn\">Read more\u003C/span>\u003C/div>\n                \u003C/div>\n            \u003C/a>\n        \u003C/cms-media> \n    \u003C/div>\n  \u003Cdiv class=\"button square outline mt-16 w-full laptop:hidden\">\n      \u003Cspan>\u003Ca href=\"{{section_page_url}}\">View More\u003C/a>\u003C/span>\n    \u003C/div>\n\u003C/div>",".custom-section {\n  display: block !important;\n}","media-custom-html-f9cfec41-d6f5-4807-b8df-83d5bc5c1de4",{"type":1218,"color":1315},{"hex":1076},{"id":1317,"type":1210,"components":1318,"decorativeBackground":1326},"31770eb3-330d-49cc-8388-4ddae6132e71",[1319],{"name":1234,"options":1320},{"global":7,"js_code":1321,"css_code":1322,"html_code":1323,"scss_code":1324,"container_id":1325},"const videoStoriesLightbox = GLightbox({ \n  selector: '.video-link a',\n  autoplayVideos: true,\n  width: '90vw',\n  height: '90vh'\n});\n\ndocument.addEventListener('appLoaded', () => {\n  document.querySelectorAll('.video-stories .video-stories-slides > div').forEach(slide => slide.classList.add('swiper-slide'));\n\n  new Swiper('.video-stories', {\n    speed: 400,\n      spaceBetween: 16,\n      simulateTouch: true,\n      slidesPerView: 1,\n      centeredSlides: true,\n      rewind: true,\n     initialSlide: 2,\n      // loop: true,\n      // autoplay: {\n      //   delay: 4500,\n      //   disableOnInteraction: false,\n      // },\n      navigation: {\n        nextEl: '.stories-swiper-button-next',\n        prevEl: '.stories-swiper-button-prev',\n      },\n      breakpoints: {\n        680: {\n          slidesPerView: 2,\n        },\n        980: {\n          slidesPerView: 3,\n        },\n      },\n  });\n});\n","#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 {\n  /* styling for CMS */\n  /* can be with display: none in edit template code to be hidden as default */\n}\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 .custom-section {\n  display: block !important;\n}\n#custom-component-2041d2ec-996b-45e5-83c1-614cd31683e4 .custom-se