  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    color: #000;
    background-color: #fff;
  }

  .sr-only-focusable:active, .sr-only-focusable:focus {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
  }

  .skip-nav {
    position: absolute;
    top: 7px;
    left: 7px;
    z-index: 9999;
    font-size: 12px;
    font-weight: bold;
    color: #027abb;
    padding: 0 10px;
  }

  .skip-nav.sr-only-focusable:active,
  .skip-nav.sr-only-focusable:focus {
