        detectChanges();
    }

    function OnTabNameChanged() {
        detectChanges();
    }

    function detectChanges() {
        var unsavedChanges = $('.unsaved-changes-row input[type=hidden]');
        if (unsavedChanges.length > 0) {
            unsavedChanges.val('True');
        }
    }
</script>
</div><div class="ptl_portlet_vertical"><div class="ptl_top_portlet" style="display:none;"></div><div id="ctl00_ContentPlaceHolder1_ctl56_divContent"><h2 style="margin-top: 50px;">Frequently Asked Questions</h2></div>
</div><div class="ptl_portlet_vertical"><div class="ptl_top_portlet" style="display:none;"></div>
<style type="text/css">
    .disabledIco {
        color: lightgrey;
    }
</style>
<div id="tabPortlet_212616" data-clientId="ctl00_ContentPlaceHolder1_ctl59" class="PO-wrapper PO-tabAccordion">
    
    
    <div id="ctl00_ContentPlaceHolder1_ctl59_upPanel">
	
            <div id="ctl00_ContentPlaceHolder1_ctl59_divTabs" role="region" style="width:100%;" class="TA-accordionMode" portlet="accordion" aria-label="Accordion Portlet">
                
            </div>
        
</div>
    
    <label for="ctl00_ContentPlaceHolder1_ctl59_divTabEdit" aria-hidden="true"  Style="display: none">tab visible</label>
    <input name="ctl00$ContentPlaceHolder1$ctl59$divTabEdit" type="text" value="True" id="ctl00_ContentPlaceHolder1_ctl59_divTabEdit" class="divTabEdit" style="display: none" />
    
</div>

<script type="text/javascript">
    
	$(document).ready(function () {
		var logConsole = function (str) {
			console.log(str);
		};
		if ($('#tabPortlet_212616 .divTabEdit').val() == "True") {
			var isModern = ('True');
			if (isModern.toLowerCase() == "true") {
				var tabObj = $('#tabPortlet_212616 ');
				var tabM = $('#ctl00_ContentPlaceHolder1_ctl59_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_0","title":"What is the process to determine how much money each employee will receive? ","content":"<p>Under Florida's Public Employees Relations Act (PERA), school boards must bargain in good faith with certified unions (like the teacher's union or support personnel unions) for any new revenue, such as that generated from a voter-approved tax referendum, if it is intended to affect staff pay or benefits.</p>\n<p>Even if the referendum states that funds will be used for salaries, implementation will still require bargaining regarding the amounts (varies in many instances based upon years of service or position), distribution method, eligibility, and structure (e.g., flat supplement, percentage raise, performance-based bonus).</p>\n<p>Negotiations would seek to address:</p>\n<ul>\n    <li>Whether all employees get the same amount or if it is tiered</li>\n    <li>Whether the funds go into base salary or are a recurring supplement</li>\n    <li>Timelines for disbursements</li>\n</ul>\n<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_1","title":"Why are salaries a priority?","content":"<p>Polk County ranks near the bottom in Florida in per-student funding, making it difficult to compete with other districts for teachers, bus drivers, paraprofessionals and other essential staff.<br>\nCompetitive wages are necessary to:</p>\n<ul>\n    <li>Reduce vacancies</li>\n    <li>Reduce turnover</li>\n    <li>Ensure students have qualified, stable educators and support personnel</li>\n</ul>\n<p>Nearby districts with millage supplements (Hillsborough, Pinellas, Orange, Sarasota, Palm Beach, Broward, Miami-Dade, and others) pay significantly more and recruit directly from Polk.</p>\n<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_2","title":"Is this referendum permanent?","content":"<p>No. The referendum is for a four-year term as allowed by Florida law. Voters will decide whether to extend or discontinue it when the term expires.</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_3","title":"Will this proposal result in additional district positions?","content":"<ul>\n    <li>No, this proposal will not result in additional district positions. </li>\n    <li>Funds will be directed toward program support, as well as school-based and school-support roles — not expanding central office roles.</li>\n    <li>The emphasis is retention and recruitment in schools and direct program support for students.</li>\n</ul>\n<p><strong>What does PCPS staffing look like?</strong></p>\n<p><strong>&nbsp;</strong><img src=\"/UserFiles/Servers/Server_3007318/Image/Community/Referendum/PCPSStaffing.jpg\" alt=\"Chart Depicting number of employees in various categories.  District administrators are 1.1 percent of the total\" style=\"font-size: 10pt; max-width: 600px;\"></p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_4","title":"Will this be a transparent process and how will it be overseen?","content":"<p>Yes. The referendum includes a legally-required, independent Citizens’ Oversight Committee.</p>\n<p>The Community Finance Review Committee provides an independent, community-based perspective on the district’s financial practices. This committee reviews budget allocations, financial reports and funding priorities to ensure transparency, fiscal responsibility, and alignment with the district’s strategic goals. Recommendations are presented to the Superintendent and, as appropriate, shared with the School Board.</p>\n<ul>\n    <li>The committee shall meet minimally once each quarter.</li>\n    <li>As an outcome the committee shall produce a summary of their quarterly review of expenditures and explanation as to any areas in need of further review or revision. </li>\n    <li>The report shall be presented jointly by the committee chair and Chief Academic Officer at the next School Board meeting following the committee's review.</li>\n    <li>Additionally, the summary will be posted online to the district website dedicated to committees for public review.&nbsp;</li>\n    <li>This ensures transparency, accountability and fiscal responsibility.</li>\n</ul>\n<p>The committee consists of:</p>\n<ul>\n    <li>14 members of the community assigned by the Board</li>\n    <li>PCPS staff including:\n    <ul>\n        <li>Superintendent/designee</li>\n        <li>Chief of Staff</li>\n        <li>Chief Financial Officer</li>\n    </ul>\n    </li>\n</ul>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_5","title":"How much would this proposal cost the average property owner?","content":"<ul>\n    <li>1.0 mill equals $1 per $1,000 of taxable property value after homestead exemptions.</li>\n    <li>Average market value of a home in Polk County is $284,419.&nbsp; Assuming the standard $25,000 homestead exemption, the average taxable value becomes $259,419.</li>\n</ul>\n<p>Example:</p>\n<p>$284,419 - $25,000 Homestead Exemption = $259,419 Taxable Value</p>\n<p>$259,419 / $1,000 = $259.42 per year (about $21.62 per month)</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_6","title":"What happens if the referendum does not pass?","content":"<p>We will continue to lose teachers and school staff to surrounding districts with higher pay and better support.</p>\n<p>This would impact:</p>\n<ul>\n    <li>Class sizes and staffing consistency</li>\n    <li>Academic and extracurricular opportunities</li>\n    <li>Ability to safely operate schools and buses</li>\n    <li>Programs like art, band, early learning and career training</li>\n</ul>\n<p>The cost of <em>not</em> investing is paid by students.</p>\n<p>If the referendum fails:</p>\n<ul>\n    <li>PCPS will remain one of the lowest-funded major districts in Florida</li>\n    <li>Recruiting and retaining qualified staff will become increasingly difficult</li>\n    <li>Program reductions may be necessary to balance the budget</li>\n    <li>Aging arts equipment cannot be replaced at the needed pace</li>\n    <li>Safety, early childhood supports and workforce programs may face cuts or limits</li>\n</ul>\n<p>The district would have no alternative local mechanism to address these needs.</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_7","title":"Polk County is a growing community, so why can’t the district use impact fees to pay staff more?","content":"<div style=\"max-width: 90%; width: 480px; min-height: 270px; margin: auto;\">\n<iframe width=\"100%\" height=\"270\" frameborder=\"0\" allowfullscreen=\"\" src=\"https://www.youtube.com/embed/gj_kMw3urqc?si=9MLsQuVntx4IW-r\"></iframe>\n</div>\n<p>With the proposed allocation of funds, the school district can build the classrooms and facilities needed for new students who will move into the District.</p>\n<p>Impact Fees Can Be Used For:</p>\n<ul>\n    <li>New schools</li>\n    <li>Classroom additions</li>\n    <li>Land purchases</li>\n    <li>Portable replacements</li>\n    <li>Buses or capital equipment with a long lifespan</li>\n</ul>\n<p>Impact Fees Cannot Pay For:</p>\n<ul>\n    <li>Salaries</li>\n    <li>Employee raises</li>\n    <li>Benefits</li>\n    <li>Any recurring operational cost</li>\n</ul>\n<p>This limitation exists because impact fees consist of:</p>\n<ul>\n    <li>One-time revenue</li>\n    <li>Tied to the construction boom cycle</li>\n    <li>Not guaranteed year to year</li>\n</ul>\n<p>Employee salaries are recurring, permanent, and cumulative. As a result, using impact fees for salaries would be like paying your monthly rent with your birthday money — it works for a month, then you’re broke.</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_8","title":"Does the district have too many administrative positions? If so, could those positions be cut and the funding be used for raises?","content":"<div style=\"max-width: 90%; width: 480px; min-height: 270px; margin: auto;\">\n<iframe width=\"100%\" height=\"270\" frameborder=\"0\" allowfullscreen=\"\" src=\"https://www.youtube.com/embed/7i-2YYpwC8E?si=C_RaWETFZH1uTDpG\"></iframe>\n</div>\n<p>Florida’s Educational Funding Accountability Act (EFAA) publishes each district’s administrative expenditures per UFTE (student).</p>\n<ul>\n    <li>FY 2023–24 (latest): Polk spent $515.02 per student from the General Fund on administration — the <strong>lowest in Florida</strong> among reporting districts in that year’s state summary.**</li>\n    <li>For context, here are some neighboring districts:\n    <ul>\n        <li>Hillsborough $746.24</li>\n        <li>Orange $688.41</li>\n        <li>Pasco $657.27</li>\n        <li>Osceola $539.38</li>\n        <li>Lake $842.09</li>\n        <li>Pinellas $813.58<br>\n        <a href=\"https://www.fldoe.org/core/fileparse.php/7507/urlt/StateCumulativeEFAA2324.pdf\" title=\"Link to EDUCATIONAL FUNDING ACCOUNTABILITY ACT SUMMARY OF ADMINISTRATIVE EXPENDITURES FY 2023-24\">Florida Department of Education</a></li>\n    </ul>\n    </li>\n    <li>FY 2022–23 (prior year): Polk spent $476.09 per student — again the lowest statewide that year’s summary shows. <a href=\"https://www.fldoe.org/core/fileparse.php/7507/urlt/StateCumulativeEFAA2223.pdf\" title=\"Link to EDUCATIONAL FUNDING ACCOUNTABILITY ACT SUMMARY OF ADMINISTRATIVE EXPENDITURES FY 2022-23\">Florida Department of Education</a></li>\n</ul>\n<p><strong>So… is the district office “bloated”?</strong></p>\n<p>Polk is the opposite of bloated: it’s operating with the lowest administrative cost per student in Florida in back-to-back years. That undercuts the claim that trimming the “bloated central office” would unlock big dollars.<br>\n&nbsp;<a href=\"https://www.fldoe.org/core/fileparse.php/7507/urlt/StateCumulativeEFAA2324.pdf\" title=\"Link to EDUCATIONAL FUNDING ACCOUNTABILITY ACT SUMMARY OF ADMINISTRATIVE EXPENDITURES FY 2023-24 \">Florida Department of Education</a></p>\n<p>&nbsp;</p>\n<p><strong>Why cutting admin positions won't result in meaningful raises …</strong></p>\n<ul>\n    <li>Scale: Even eliminating several positions doesn’t move the needle across 10,000 employees; raises are recurring, districtwide costs.</li>\n    <li>Function &amp; compliance: “Administration” includes legally required work (finance, HR, payroll, compliance, curriculum oversight, ESE, risk, procurement). Gutting these creates operational and legal exposure without generating sustainable raise dollars.</li>\n    <li>Right funding source: Sustainable raises require recurring revenue (state increases, millage, or reallocation within operations), not one-off trims.</li>\n</ul>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_9","title":"The taxpayers already approved a ½ cent sales tax for Polk County Public Schools. Why can’t these funds be used to increase salaries?","content":"<p>The School Capital Outlay Surtax (the local sales tax for schools) is governed by § 212.055(6), Florida Statutes.</p>\n<p>The statute states that funds “shall be expended only on capital outlay projects” and related costs — things like:</p>\n<ul>\n    <li>Construction, renovation, or improvement of educational facilities</li>\n    <li>Purchase of land or buses</li>\n    <li>Lease-purchase of equipment</li>\n    <li>Payment of debt service on capital bonds</li>\n</ul>\n<p>The same statute explicitly bars using it for operations — i.e., salaries, benefits, or program expenses.</p>\n<p>Because the restriction is in state law, not local ordinance, voters can’t “redirect” those funds through a local vote. Only the Florida Legislature could amend § 212.055(6) to broaden its use.</p>\n<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_10","title":"How much does Polk County Public Schools lag in funding in comparison?","content":"<div style=\"max-width: 90%; width: 480px; min-height: 270px; margin: auto;\">\n<iframe width=\"100%\" height=\"270\" frameborder=\"0\" allowfullscreen=\"\" src=\"https://www.youtube.com/embed/UE_4jDi2cpU?si=tx_F7J2jECxayvbT\"></iframe>\n</div>\n<p>In 2024-25, Polk County&nbsp;received about $281 less per student than the state average ($8,987.67 – $8,706.75 ≈ $280.92) and less than nearby large districts like Orange and Hillsborough. Keep in mind, PCPS faces&nbsp;many of the same cost pressures — growth, staffing shortages, and increasing student needs.</p>\n<p>2025–26 (approved conference numbers) show the same pattern:</p>\n<ul>\n    <li>Statewide average: $9,130.41 per student</li>\n    <li>Polk: $8,839.64 per student</li>\n</ul>\n<p>The gap grows slightly to about $291 per student ($9,130.41 – $8,839.64 ≈ $290.77)</p>\n<p><strong>Bottom of the pack on funding</strong></p>\n<ul>\n    <li>Polk County Public Schools currently ranks 53rd out of 67 Florida districts in per-student funding, despite steady increases in our own per-pupil dollars.</li>\n    <li>Nearby large districts like Orange and Hillsborough receive more per-student funding than Polk, even though we’re facing many of the same cost pressures — growth, staffing shortages, and increasing student needs.</li>\n    <li>Despite being in the bottom handful of districts for per-pupil funding, Polk has improved its academic performance and district grade. That’s a credit to our staff, but it’s not sustainable to do \"more with less\" forever.</li>\n    <li>When we talk about millage, referendums, or reallocations, we’re not chasing luxury items. We’re trying to close a structural funding gap so Polk students have access to the same opportunities as students in better-funded districts.    </li>\n</ul>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl59_divTabs_11","title":"How does Polk’s average teacher salary compare to other districts?","content":"<div style=\"max-width: 90%; width: 480px; min-height: 270px; margin: auto;\">\n<iframe width=\"100%\" height=\"270\" frameborder=\"0\" allowfullscreen=\"\" src=\"https://www.youtube.com/embed/y3HrpUkaibY?si=oGprO8V9-P35rO85\"></iframe>\n</div>\n<style>\n    table {\n    border-collapse: collapse;\n    width: 100%;\n    }\n    td, th {\n    border: 1px solid #ddd;\n    padding: 6px;\n    }\n    tr:nth-child(even){background-color: #f2f2f2;}\n    tr:hover {background-color: #ddd;}\n    th {\n    padding-top: 10px;\n    padding-bottom: 10px;\n    text-align: left;\n    background-color: #000;\n    color: white;\n    }\n</style>\n<div style=\"width: 500px; max-width: 90%; float: left; margin-top: 20px; margin-right: 50px; overflow-x: auto;\">\n<h3>Big 7 Districts</h3>\n<table>\n    <tbody>\n        <tr>\n            <th><span style=\"font-size: 13px;\">District Name</span></th>\n            <th style=\"text-align: center;\"><span style=\"font-size: 13px;\">24-25 Starting</span></th>\n            <th style=\"text-align: center;\"><span style=\"font-size: 13px;\">Average Salary</span></th>\n            <th style=\"text-align: center;\"><span style=\"font-size: 13px;\">Ops Millage</span></th>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Broward</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">51,402</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">58,813</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2022)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Dade (Miami-Dade)</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">50,050</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">57,395</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2022)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Duval</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">48,700</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">56,364</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2022)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Hillsborough</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">48,000</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">59,163</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2024)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Orange</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">49,475</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">59,309</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2022)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Palm Beach</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">53,000</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">61,847</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2022)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Polk</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">47,500</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">51,613</span></td>\n            <td></td>\n        </tr>\n    </tbody>\n</table>\n</div>\n<div style=\"width: 500px; max-width: 90%; float: left; margin-top: 20px; left; overflow-x: auto;\">\n<h3>Bordering Districts</h3>\n<table>\n    <tbody>\n        <tr>\n            <th style=\"text-align: left;\"><span style=\"font-size: 13px;\">District Name</span></th>\n            <th style=\"text-align: center;\"><span style=\"font-size: 13px;\">24-25 Starting</span></th>\n            <th style=\"text-align: center;\"><span style=\"font-size: 13px;\">Average Salary</span></th>\n            <th style=\"text-align: center;\"><span style=\"font-size: 13px;\">Ops Millage</span></th>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Hardee</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">48,987</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">51,995</span></td>\n            <td></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Highlands</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">50,050</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">56,163</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2024)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Hillsborough</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">48,000</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">59,163</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2024)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Lake</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">49,500</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">52,215</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">0.75 (2022)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Manatee</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">49,702</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">55,486</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2024)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Orange</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">49,475</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">59,309</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2022)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Osceola</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">49,000</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">53,119</span></td>\n            <td></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Pasco</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">47,500</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">50,759</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">1.00 (2022)</span></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Polk</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">47,500</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">51,613</span></td>\n            <td></td>\n        </tr>\n        <tr>\n            <td><span style=\"font-size: 13px;\">Sumter</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">55,137</span></td>\n            <td style=\"text-align: center;\"><span style=\"font-size: 13px;\">61,131</span></td>\n            <td></td>\n        </tr>\n    </tbody>\n</table>\n</div>","active":false,"disabled":false}],// required,
						propPaneId: 'paneId', // optional - pass in default value for demo purposes
						propTitle: 'title', // optional - pass in default value for demo purposes
						propActive: 'active', // optional - pass in default value for demo purposes
						propDisabled: 'disabled', // optional - pass in default value for demo purposes
						propContent: 'content', // optional - pass in default value for demo purposes
						tabMode: tabM,
						scrollToTabEdge: false, // optional - pass in default value for demo purposes
						disableScrollArrowsOnFullyScrolled: false // optional- pass in default value for demo purposes
					}).on('ready.scrtabs', function () {
						$('#' + this.id + ' .tab-pane').attr('tabindex', 0);
					});
				};

				activate();

            }
        }
	});

    function OnClientLoad(editor) {
        editor.attachEventHandler('onkeydown', function () { detectChanges(); });  
    }

    function OnCommandExecuted(editor) {
        detectChanges();
    }

    function OnTabNameChanged() {
        detectChanges();
    }

    function detectChanges() {
        var unsavedChanges = $('.unsaved-changes-row input[type=hidden]');
        if (unsavedChanges.length > 0) {
            unsavedChanges.val('True');
        }
    }
</script>
</div><div class="ptl_portlet_vertical"><div class="ptl_top_portlet" style="display:none;"></div><div id="ctl00_ContentPlaceHolder1_ctl62_divContent"><div style="width: 100%; margin: auto; text-align: center;">
