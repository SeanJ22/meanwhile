				var tabM = $('#ctl00_ContentPlaceHolder1_ctl41_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl41_divTabs_0","title":"June 23, 2026 - Notice of Public Hearing or Meeting","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public meeting or hearing to which all persons are invited.&nbsp;</p>\n<p style=\"text-align: center;\"><strong>Attendance Boundary Committee Meeting</strong></p>\n<p>Date/Time: June 23, 2026 at 5:30 P.M.&nbsp;</p>\n<p>Location: Jim Miles Professional Development Center<br>\n4270 Wallace Rd<br>\nLakeland, FL 33812&nbsp;</p>\n<p>Assistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.&nbsp;<br>\n&nbsp;<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.&nbsp;<br>\n&nbsp;<br>\nFor further information about this public meeting, please contact Facilities &amp; Operations for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620 ext. 886.&nbsp;<br>\n&nbsp;<br>\n<br>\nDated: May 13, 2026<br>\n<br>\nBy: Justin Sharpless, Board Chair&nbsp;<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl41_divTabs_1","title":"June 9, 2026 - Notice of Public Hearing or Meeting","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose: June 9, 2026, 12:30 P.M. Work Session&nbsp;<br>\nJune 9, 2026, 5:00 P.M. Board Meeting<br>\n<br>\nLocation: School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830</p>\n<p>Assistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; May 13, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl41_divTabs_2","title":"June 9, 2026 - Notice of Public Hearing","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public hearing or meeting to which all persons are invited.</p>\n<p>Date/Time/Purpose: June 9, 2026, to begin no earlier than 5:00 P.M.</p>\n<p style=\"text-align: center;\">The public hearing is for the following policy updates:</p>\n<p>Bylaw 143.1 Residence Areas<br>\nBylaw 169.1 Public Participation at Board Meetings<br>\nPolicy 1211 Whistleblower Protection<br>\nPolicy 2266 Title IX Sexual Harassment Complaint and Investigation Procedures<br>\nPolicy 2421 Career and Technical Education<br>\nPolicy 2450 Adult and Community Education<br>\nPolicy 3120.04 Employment of Substitute, Limited Employment Agreement, and Part-Time Instructional Staff<br>\nPolicy 3211 Whistleblower Protection<br>\nPolicy 4120 Employment of Support Staff<br>\nPolicy 4211 Whistleblower Protection<br>\nPolicy 5330.01 Self-Administered Medication<br>\nPolicy 5460 Graduation Requirements<br>\nPolicy 5780 Student/Parent Rights<br>\nPolicy 8405 School Safety and Security<br>\nPolicy 8420 Emergency Management, Emergency Preparedness and Emergency Response Agencies<br>\nPolicy 8470 Registered Sexual Predators/ Sex Offender<br>\n&nbsp;Bylaw 0147 Compensation<br>\nBylaw 0149.3 Board-Staff Communication<br>\nPolicy 1243 Professional Meetings<br>\nPolicy 2370.02 Magnet and Choice Programs/Schools<br>\nPolicy 3129 Conflict of Interest<br>\nPolicy 3243 Professional Meetings<br>\nPolicy 5830 Student Fundraising<br>\nPolicy 6325 Procurement – Federal Grants/Funds<br>\nPolicy 6605 Crowdfunding<br>\nPolicy 6608 School Support Organizations – Accountability and Oversight of Fundraiser and Crowdfunding Disbursements<br>\nPolicy 6610 School Internal Funds<br>\nPolicy 7230 Gifts to the School District<br>\nPolicy 7540.02 Web Content, Apps, and Services<br>\nPolicy 8330 Student Records<br>\nPolicy 8600 Transportation<br>\nPolicy 8600.04 Bus Operator Qualifications, Certifications, Discipline, and Termination<br>\nPolicy 9700 Relations with Special Interest Groups<br>\n<br>\nLocation: School Board Auditorium, 1915 South Floral Avenue, Bartow, FL 33830</p>\n<p>Assistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.</p>\n<p>For further information about this meeting, please contact Chad Davis, Staff Attorney, Office of Superintendent of the School Board of Polk County, Florida P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.</p>\n<p>Dated: May 7, 2026&nbsp;</p>\n<p>By: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl41_divTabs_3","title":"June 9, 2026 - Notice of Public Hearing","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited to comment.<br>\n<br>\nDate/Time/Purpose: June 9, 2026 to begin no earlier than 5:00 P.M.<br>\n<br>\nPublic Hearing to adopt the following revisions to Code of Student Conduct:</p>\n<ul>\n    <li>Page iii - Table of Contents - Added Section 4.12 Disruption/Interference with Drills, Searches, or Critical Incidence</li>\n    <li>Page 10 - Section E Student Identification Badges – Updated text to add: A.&nbsp; &nbsp; GRADES 6-12, will be provided to secondary students to ensure safety and security of students and staff. Students must always wear the ID card around the neck area when on school grounds. Students must have ID Cards daily for the purpose to use media center, cafeteria, busing, and extracurricular activities.&nbsp;</li>\n    <li>Page 17 – Technology Use – Deleted, Technology Use: See Technology Policies (pages xv-xx)</li>\n    <li>Page 20 – Section: 3.02 - Progressive Discipline – Updated Text: It shall be at the discretion of the principal or designee to determine the level of discipline to be applied in each situation.&nbsp;</li>\n    <li>Page 33- Section 4.12 - Added new section - A student who disrupts, circumvents, or acts insubordinate to direct instructions at any process of a school or bus safety drill, random search or critical incident is guilty of unacceptable behavior punishable as follows:&nbsp;\n    <ul>\n        <li>4. In-School Suspension&nbsp;</li>\n        <li>5. Out-of-School or Bus Suspension – Short-Term&nbsp;</li>\n        <li>6. Out-of-School or Bus Suspension – Long-Term&nbsp;</li>\n        <li>7. Alternative Education Program.</li>\n    </ul>\n    </li>\n    <li>Page 42 – Section 5.10 - B. Use, Possession, or Purchase - If the offense constitutes a felony, the principal shall assign the student to an Alternative Education Program. (deleted language)</li>\n    <li>Page 46 – Section 5.24 – Leaving Campus Without Permission – Delete Text, NOTE: Progressive discipline must be followed for violations in this section.</li>\n    <li>Page 52 - Section 5.35 - Simple Battery - LEVELS - Add Expulsion to Levels.</li>\n    <li>Page 58 - Glossary - Add additional term/code definitions to the glossary:<br>\n    <ul>\n        <li>Aggravated Battery (BAT) - Level I - (intentional great bodily harm) A battery where the attacker intentionally or knowingly causes more serious injury as defined in Rule 6A-1.0017(8)(g), such as: great bodily harm, permanent disability, or permanent disfigurement; uses a deadly weapon; or, where the attacker knew or should have known the victim was pregnant.</li>\n        <br>\n        <li>Bullying (BUL) - Level IV - (intimidating behaviors that are repeated, intentional, and involve a power imbalance) Systematically and chronically inflicting physical hurt or psychological distress on one or more students or employees. Bullying includes instances of cyberbullying, as defined in Section 1006.147(3)(b), F.S. Bullying may include, but is not limited to, repetitive instances of teasing, social exclusion, threats, intimidation, stalking, physical violence, theft, harassment, public or private humiliation, or destruction of property. If the physical harm or psychological distress is not the result of systematic or chronic behavior, evaluate for Harassment.&nbsp;</li>\n        <br>\n        <li>Fighting (FIT) - Level III - (mutual combat, mutual altercation) When two or more persons mutually participate in use of force or physical violence that requires either physical intervention or results in injury requiring first aid or medical attention.&nbsp; &nbsp;&nbsp;</li>\n        <br>\n        <li>Harassment (HAR) - Level IV - Any threatening, insulting, or dehumanizing gesture, use of data or computer software, or written, verbal, or physical conduct that places a student or school employee in reasonable fear of harm to his or her person or damage to his or her property, has the effect of substantially interfering with a student’s educational performance, opportunities, or benefits, or has the effect of substantially disrupting the orderly operation of a school including any course of conduct directed at a specific person that causes substantial emotional distress in such a person and serves no legitimate purpose. Instances of Harassment that are chronic or repeated in nature should be evaluated for Bullying or Bullying-related.&nbsp;</li>\n        <br>\n        <li>Simple Battery (PHA) - Level II - An actual and intentional touching or striking of another person against his or her will, or the intentional causing of bodily harm to an individual.&nbsp;</li>\n        <br>\n        <li>Threat/Intimidation (TRE) - Level III - (instilling fear in others) An incident where there was no physical contact between the offender and victim, but the victim reasonably believed that physical harm could have occurred based on verbal or nonverbal communication by the offender. This includes nonverbal threats and verbal threats of physical harm which are made in person, electronically or through any other means.</li>\n    </ul>\n    </li>\n</ul>\n<p>Location:<span style=\"white-space:pre\">\t</span>School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830<br>\n<span style=\"white-space: pre; white-space: normal;\">\t</span><br>\nAssistance:<span style=\"white-space:pre\">\t</span>If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:<span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact Brett Butler, Senior Director of Discipline Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-668-3045.<br>\n<br>\nDated:&nbsp; May 7, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl41_divTabs_4","title":"June 9, 2026 - Notice Of Proposed Rule Development Workshop","content":"<p style=\"text-align: center;\"><strong>NOTICE OF PROPOSED RULE DEVELOPMENT WORKSHOP<br>\nSCHOOL BOARD POLICY</strong></p>\n<p>The School Board of Polk County, Florida (“<strong>Board</strong>”) will hold a public workshop on the following revised Board policies <strong>Policy 5722</strong> on <strong>June 9, 2026</strong> at the Polk County Public Schools Administrative Offices, located at 1915 South Floral Avenue, Bartow, FL 33830. The proposed changes to the above referenced Board policies will be published on the Polk County Public Schools (“<strong>PCPS</strong>”) website as part of the meeting agenda seven days prior to the meeting. Meeting agendas can be accessed at:</p>\n<p style=\"text-align: center;\"><a href=\"https://www.polkschoolsfl.com/about/meetings\" title=\"Link to the Polk County Schools Meeting webpage\">https://www.polkschoolsfl.com/about/meetings</a></p>\n<p>The proposed changes may be requested prior to the meeting agenda publication by emailing the Public Records Office at <a href=\"mailto:teresa.griffin@polk-fl.net\" class=\"ApplyClass\">teresa.griffin@polk-fl.net</a>. Copies may be obtained at the Polk County Public Schools Administrative Offices between the hours of 8:00 a.m. and 4:00 p.m. in the Public Records Office.<br>\n<br>\nThe revised Board policies will be placed on the Board’s agenda for a public hearing during the <strong>July 28, 2026</strong> meeting at the Polk County Public Schools Administrative Offices, located at 1915 South Floral Avenue, Bartow, FL 33830.<br>\n<br>\nWritten comments may be submitted within 21 days of the date of this notice to Legal Services, 1915 South Floral Avenue, Bartow, FL 33830. Substantially affected persons may, within 14 days of the date of this notice, file an objection to this rulemaking with the Board. The objection shall specify the portions of the proposed rules to which the person objects and the specific reasons for the objections.&nbsp;</p>\n<p style=\"text-align: center;\"><strong>Policy 5722 School-Sponsored Publications and Productions</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>New policy to provide regulations for school-sponsored student media.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space:pre\">\t</span>New language provides regulations for school-sponsored student media.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 1001.43(3)©</p>\n<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl41_divTabs_5","title":"June 5, 2026 - Public Notice","content":"<p style=\"text-align: center;\"><strong>SCHOOL BOARD OF POLK COUNTY, FLORIDA<br>\nPublic Notice</strong></p>\n<p>NOTICE IS HEREBY GIVEN that THE SCHOOL BOARD OF POLK COUNTY, FLORIDA has settled the following claims brought by:</p>\n<ul>\n    <li>Sheryn Kenyon</li>\n    <li>Ebony Cason, et al.</li>\n    <li>Michael Charcon</li>\n    <li>Nathan Charles</li>\n    <li>Rachel Coleman</li>\n</ul>\n<p>These claims settled for an amount exceeding $5,000.00, with proceeds paid by the Florida School Boards Insurance Trust on behalf of the Polk County School Board.&nbsp;&nbsp;<br>\n<br>\n&nbsp;<br>\nDated:<span style=\"white-space:pre\">\t</span>June 5, 2026&nbsp;<br>\nBy: Justin Sharpless, Board Chair<br>\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <span style=\"white-space:pre\">\t\t\t</span>Attest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl41_divTabs_6","title":"June 2, 2026 - Notice of Public Hearing or Meeting","content":"<p>Notice is hereby given that the School Board of Polk County, Florida will hold a public meeting to which all persons are invited.</p>\n<p style=\"text-align: center;\">Sales Tax Oversight Committee Meeting</p>\n<p>Date/Time:&nbsp;June 2nd, 2026, at 5:00 P.M.<br>\n<br>\nDiscussion: Half Penny Sales Tax Oversight<br>\n<br>\nLocation:&nbsp;Polk County School District<br>\nFacilities and Operations Building “C”<br>\n1915 South Floral Ave., Bartow, FL 33830<br>\n<span style=\"white-space: pre; white-space: normal;\">\t</span><br>\nAssistance: If you require any type of accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at 863-534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given with accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing.&nbsp; Those making an appeal need to preserve a verbatim record of the proceedings at their own expense, usually with a court reporter.&nbsp; The record must include the essential testimony and evidence required for any such appeal.&nbsp;&nbsp;<br>\n<br>\nFor further information about this public meeting, please contact Joshua McLemore, Director, Facilities Planning for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620, ext. 489.<br>\n<br>\nDated:&nbsp; May 18, 2026<br>\n<br>\n<br>\n<span style=\"white-space: normal;\"><span style=\"white-space:pre\">\t\t\t\t\t\t</span>By:&nbsp; &nbsp; &nbsp; Justin Sharpless, Board Chair</span><br>\n<span style=\"white-space: normal;\"><span style=\"white-space:pre\">\t\t\t\t\t\t</span>Attest:&nbsp; Frederick R. Heid, Secretary</span></p>\n<br>","active":false,"disabled":false}],// required,
