				var tabM = $('#ctl00_ContentPlaceHolder1_ctl29_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_0","title":"October 29, 2026 - Joint Summit Meeting with Polk County Board of County Commissioners","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public meeting or hearing to which all persons are invited.</p>\n<p style=\"text-align: center;\"><strong>Joint Summit Meeting with Polk County Board of County Commissioners</strong></p>\n<p>Date/Time: October 29, 2026 at 9:00 A.M.&nbsp;<br>\n<br>\nLocation: Lake Myrtle Sports Complex<br>\n2701 Lake Myrtle Park Rd<br>\nAuburndale, FL 33823</p>\n<p>Assistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.&nbsp;<br>\n&nbsp;<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.&nbsp;<br>\n&nbsp;<br>\nFor further information about this public meeting, please contact Facilities &amp; Operations for the School Board of Polk County, at 863-534-0620 ext. 886.&nbsp;<br>\n&nbsp;<br>\n<br>\nDated: October 21, 2026<br>\n<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_1","title":"October 27, 2026 - Notice of Proposed Rule Development Workshop","content":"<p style=\"text-align: center;\"><strong>NOTICE OF PROPOSED RULE DEVELOPMENT WORKSHOP<br>\nSCHOOL BOARD POLICY</strong></p>\n<p>The School Board of Polk County, Florida (<strong>“Board”</strong>) will hold a public workshop on the following revised Board policies <strong>Bylaw 0122.1, Bylaw 0124, Bylaw 0147.1, Bylaw 0149, Bylaw, 0149.1, Bylaw 0149.3, Bylaw 0168, Policy 2215, Policy 2280, Policy 2370.01, Policy 2421, Policy 2431, Policy 2431.01, Policy 2450, Policy 2460, Policy 3120.03, Policy 3120.08, Policy 4120.03, Policy 4120.08, Policy 5223, Policy 5330.01, Policy 5335, Policy 5410.01, Policy 5430, Policy 5514, Policy 5780, Policy 6152 and Policy 8810,</strong> on <strong>October 27, 2026</strong> at the Polk County Public Schools Administrative Offices, located at 1915 South Floral Avenue, Bartow, FL 33830. The proposed changes to the above referenced Board policies will be published on the Polk County Public Schools (<strong>“PCPS”</strong>) website as part of the meeting agenda seven days prior to the meeting. Meeting agendas can be accessed at:</p>\n<p style=\"text-align: center;\"><a href=\"https://www.polkschoolsfl.com/about/meetings\" title=\"Link to PCPS Board Meeting Dates and Information\">https://www.polkschoolsfl.com/about/meetings</a></p>\n<p>The proposed changes may be requested prior to the meeting agenda publication by emailing the Public Records Office at <a href=\"mailto:teresa.griffin@polk-fl.net\" class=\"ApplyClass\">teresa.griffin@polk-fl.net</a>. Copies may be obtained at the Polk County Public Schools Administrative Offices between the hours of 8:00 a.m. and 4:00 p.m. in the Public Records Office.<br>\n<br>\nThe revised Board policies will be placed on the Board’s agenda for a public hearing during the <strong>December 8, 2026</strong> meeting at the Polk County Public Schools Administrative Offices, located at 1915 South Floral Avenue, Bartow, FL 33830.<br>\n<br>\nWritten comments may be submitted within 21 days of the date of this notice to Legal Services, 1915 South Floral Avenue, Bartow, FL 33830. Substantially affected persons may, within 14 days of the date of this notice, file an objection to this rulemaking with the Board. The objection shall specify the portions of the proposed rules to which the person objects and the specific reasons for the objections.&nbsp;</p>\n<p style=\"text-align: center;\"><strong>Bylaw 0122.1 Member Powers</strong></p>\n<p><strong>&nbsp;</strong><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.&nbsp;<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1001.366</p>\n<p style=\"text-align: center;\"><strong>Bylaw 0124 Standards of Ethical Conduct</strong></p>\n<p><strong>&nbsp;</strong>Purpose and Effect:<span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 112.312, F.S. 112.313, F.S. 112.3131, F.S. 112.3142, F.S. 112.3148, F.S. 112.3149, F.S. 112.317, F.S. 1001.42(6), F.S. 1001.421, F.S. 1012.23, F.A.C. 6A-10.081 F.S. 112.3135, F.S. 112.3142, F.S. 112.3148, F.S. 112.3149, F.S. 112.317, F.S. 1001.42(6), F.S. 1001.421, F.S. 1012.23, F.A.C. 6A-10.081</p>\n<p style=\"text-align: center;\"><strong>Bylaw 0147.1 Travel and Expenses</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 112.061, F.S. 1001.39, F.S. 1011.051, F.A.C. 6A-1.056, 2 C.F.R. 200.474</p>\n<p style=\"text-align: center;\"><strong>Bylaw 0149 Access to Records</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1001.366</p>\n<p style=\"text-align: center;\"><strong>Bylaw 0149.1 Public Expression of Members</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1001.366</p>\n<p style=\"text-align: center;\"><strong>Bylaw 0149.3 Board-Staff Communications</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1001.366</p>\n<p style=\"text-align: center;\"><strong>Bylaw 0168 Minutes</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1001.42</p>\n<p style=\"text-align: center;\"><strong>Policy 2215 Program of Instruction</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1001.51, F.S. 1003.42, F.S. 1003.4205, F.S. 1003.44, F.S. 1003.48, F.S. 1007.2616, F.A.C. 61-1.094124</p>\n<p style=\"text-align: center;\"><strong>Policy 2280 Physical Education</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1003.4282, F.S. 1003.453, F.S. 1003.455</p>\n<p style=\"text-align: center;\"><strong>Policy 2370.01 Virtual Instruction</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1000.04, F.S. 1001.20, F.S. 1001.42(23), F.S. 1002.20, F.S. 1002.321, F.S. 1002.37, F.S. 1002.45, F.S. 1002.455, F.S. 1003.02, F.S. 1003.321, F.S. 1003.428, F.S. 1003.498, F.S. 1003.499, F.S. 1006.29, F.S. 1007.27, F.S. 1011.62, F.A.C. 6A-6.0981</p>\n<p style=\"text-align: center;\"><strong>Policy 2421 Career and Technical Education</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 445.004, F.S. 445.006, F.S. 446 et seq., F.S. 450.081, F.S. 1000.05, F.S. 1001.42, F.S. 1003.01, F.S. 1003.41, F.S. 1003.4156, F.S. 1003.4203, F.S. 1003.4282, F.S. 1003.491, F.S. 1003.492, F.S. 1003.493, F.S. 1003.4935, F.S. 1004.91, F.S. 1004.92, F.S. 1004.933, F.S. 1007.271, F.S. 1009.21, F.S. 1009.22, F.S. 1009.26, F.S. 1009.536, F.S. 1009.711, F.S. 1011.62, F.S. 1011.80, F.S. 1011.803, F.A.C. 6A-1.0014, F.A.C. 6A-1.09442, F.A.C. 6A-6.0200, F.A.C. 6A-6.0576, F.A.C. 6A-10.0244, F.A.C. 6A-10.0381, 29 U.SC. 201, 29 U.S.C. 202, 29 U.S.C. 203, 29 U.S.C. 204, 29 U.S.C. 206, 29 U.S.C. 207, 29 U.S.C. 209, 29 U.S.C. 210, 29 U.S.C. 211, 29 U.S.C. 212, 29 U.S.C. 213, 29 U.S.C. 214, 29 U.S.C. 215, 29 U.S.C. 216, 29 U.S.C. 216b, 29 U.S.C. 217, 29 U.S.C. 218, 29 U.S.C. 218b, 29 U.S.C. 218c, 29 U.S.C. 219</p>\n<p style=\"text-align: center;\"><strong>Policy 2431 Interscholastic and Intrascholastic Athletics</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1002.20, F.S. 1006.15, F.S. 1006.165, F.S. 1006.195, F.S. 1006.20</p>\n<p style=\"text-align: center;\"><strong>Policy 2431.01 Participation by Transfer Students</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>Handbook and Bylaws of the Florida High School Athletic Association, F.S. 1002.20, F.S. 1006.15, F.S. 1006.20</p>\n<p style=\"text-align: center;\"><strong>Policy 2450 Adult and Community Education</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1003.435, F.S. 1004.93, F.S. 1004.94, The Veterans Benefits and Transition Act - 2018 (38 USC Sections 3679, 3698(c)(1)(C), P.L. 115-407, Sections 103-104), F.A.C. 6A-1.0014, F.A.C. 6A-10.0381, F.A.C. 6A-6.014</p>\n<p style=\"text-align: center;\"><strong>Policy 2460 Exceptional Student Education</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1001.41, F.S. 1001.42, F.S. 1002.20, F.S. 1003.01(3), F.S. 1003.4156, F.S. 1003.4282, F.S. 1003.5715, F.S. 1003.57, F.S. 1003.572, F.S. 1008.212, F.S. 1008.22, F.S. 1008.24, 20 U.S.C. 1401 et seq., 20 U.S.C. 1400 et seq., Definitions, ESE Policies and Procedures, and ESE Administrators, F.A.C. 6A-6.03411, 34 C.F.R. Part 300, Surrogate Parents, F.A.C. 6A-6.0333, Provision of Free Appropriate Public Education (FAPE) and Development of Individual Educational Plans for Students with Disabilities, F.A.C. 6A-6.03028, Procedural Safeguards for Exceptional Students Who Are Gifted, F.A.C. 6A-6.03313, Procedural Safeguards and Due Process Procedures for Parents and Students with Disabilities, F.A.C. 6A-6.03311, Florida Alternate Assessment Requirements, F.A.C. 6A-1.09430, F.A.C. 6A-1.09963, Statewide Assessment for Students with Disabilities, F.A.C. 6A-1.0943</p>\n<p style=\"text-align: center;\"><strong>Policies 3120.03 and 4120.03 Athletic Coaches</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1012.55, F.S. 1012.55(2), F.A.C. 6A-4.004, F.A.C. 6A-4.0282, F.S. 1012.55, F.S. 1012.55(2), F.A.C. 6A-4.004, F.A.C. 6A-4.0282</p>\n<p style=\"text-align: center;\"><strong>Policies 3120.0 and 4120.08 Part-Time Extra-Curricular Personnel</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.A.C. 6A-1.0502(11), F.S. 1012.01, 1012.55(2), F.S. 1006.165, F.S. 1006.20&nbsp;</p>\n<p style=\"text-align: center;\"><strong>Policy 5223 Absences for Religious Instruction</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1003.21, F.A.C. 6A-1.09514</p>\n<p style=\"text-align: center;\"><strong>Policy 5330.01 Epinephrine, Anaphylaxis, and Self-Administered Medication</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 985.04, F.S. 1002.20, F.S. 1002.221</p>\n<p style=\"text-align: center;\"><strong>Policy 5335 Care of Students with Chronic Health Conditions</strong>&nbsp;</p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 381.88</p>\n<p style=\"text-align: center;\"><strong>Policy 5410.01 Promotion, Acceleration, Placement and Retention</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1002.3105, F.S. 1003.02, F.S. 1003.4156, F.S. 1008.22, F.S. 1008.25, F.A.C. 6A-1.09422, F.A.C. 6A-1.094221, F.A.C. 6A-1.094222, F.A.C. 6A-6.053, F.A.C. 6A-6.0533, F.S. 1002.411, F.S. 1003.485, F.S. 1008.366</p>\n<p style=\"text-align: center;\"><strong>Policy 5430 Class Rank</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1003.437</p>\n<p style=\"text-align: center;\"><strong>Policy 5514 Use of Personal Transportation</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. Chapter 316, F.S. 1001.43</p>\n<p style=\"text-align: center;\"><strong>Policy 5780 Student/Parent Rights</strong></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 39.201, F.S. 381.0056, F.S. 394.463, F.S. 435.04(2), F.S. 1000.05, F.S. 1002.20, F.S. 1002.22, F.S. 1002.385, F.S. 1002.39, F.S. 1002.394, F.S. 1002.395, F.S. 1002.40, F.S. 1002.41, F.S. 1002.411, F.S. 1002.43, F.S. 1003.01(13), F.S. 1003.02, F.S. 1003.21, F.S. 1003.22, F.S. 1003.3101, F.S. 1003.32, F.S. 1003.42, F.S. 1003.44, F.S. 1003.4505, F.S. 1003.47, F.S. 1003.52, F.S. 1003.53, F.S. 1003.55, F.S. 1003.56, F.S. 1003.57, F.S. 1003.58, F.S. 1006.062(7), F.S. 1006.07, F.S. 1006.09, F.S. 1006.13, F.S. 1006.15, F.S. 1006.20, F.S. 1006.21, F.S. 1006.22, F.S. 1006.23, F.S. 1006.28, F.S. 1006.40, F.S. 1007.271, F.S. 1008.22, F.S. 1008.25, F.S. 1008.386, F.S. 1012.42, F.S. 1012.797, F.S. Chapter 1014, F.A.C. 6A-6.053, F.A.C. 6A-6.0533</p>\n<p style=\"text-align: center;\"><span style=\"font-size: 10pt;\"><strong>Policy 6152 Student Fees, Fines, and Charges</strong></span></p>\n<p><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1001.41, F.S. 1001.43, F.S. 1006.28, F.S. 1006.40</p>\n<p style=\"text-align: center;\"><strong>Policy 8810 The American Flag, the Flag of the State of Florida, and the Official Motto of the State of Florida</strong></p>\n<p><strong>Purpose and Effect:&nbsp;</strong>Proposed revisions to comply with revised statutes and rules.</p>\n<p><strong>Summary:</strong><span style=\"white-space: pre;\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 1000.06, F.S. 1001.41, F.S. 1003.44, U.S. Public Law No. 623, as amended by U.S. Public Law No. 829</p>\n<div><br style=\"font-size: 13.3333px;\">\n</div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_2","title":"October 27, 2026 - Notice of Public Hearing or Meeting ","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose:<span style=\"white-space:pre\">\t</span>October 13, 2026, 9:00 A.M. Work Session&nbsp;<br>\nOctober 27, 2026, 12:30 P.M. Work Session&nbsp;<br>\nOctober 27, 2026, 5:00 P.M. Board Meeting<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\">School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830</span></p>\n<p>Assistance:<span style=\"white-space:pre\">\t</span>If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:<span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; September 14, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_3","title":"October 20, 2026 - Notice of Public Hearing or Meeting","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public meeting or hearing to which all persons are invited.&nbsp;</p>\n<p style=\"text-align: center;\"><strong>Attendance Boundary Committee Meeting</strong></p>\n<p>Date/Time: <span style=\"white-space:pre\">\t</span>October 20, 2026 at 5:30 P.M.&nbsp;<br>\n<br>\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>\nLocation:&nbsp;&nbsp;<span style=\"white-space:pre\">\t</span>Jim Miles Professional Development Center<br>\n4270 Wallace Rd<br>\nLakeland, FL 33812&nbsp;</p>\n<p>Assistance: <span style=\"white-space:pre\">\t</span>If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.&nbsp;<br>\n&nbsp;<br>\nAppeal Notice: <span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.&nbsp;<br>\n&nbsp;<br>\n<br>\nFor further information about this public meeting, please contact Facilities &amp; Operations for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620 ext. 886.&nbsp;<br>\n&nbsp;<br>\n<br>\nDated: October 5, 2026<br>\n<br>\nBy: Justin Sharpless, Board Chair&nbsp;<br>\nAttest: Frederick R. Heid, Secretary&nbsp;<br>\n&nbsp;</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_4","title":"October 13, 2026 - Public Notice ","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida has scheduled an Attorney-Client Session during a regularly scheduled School Board Work Session.&nbsp; The Attorney-Client Session is held pursuant to Florida Statue 286.011.</p>\n<p style=\"text-align: center;\"><strong>Attorney-Client Session</strong></p>\n<p>Date/Time/Purpose:<span style=\"white-space:pre\">\t</span>October 13, 2026 at 9:00 A.M.&nbsp; – Attorney-Client Session<br>\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>\nLocation:&nbsp;<span style=\"white-space: normal;\">Superintendent’s Large Conference Room</span><br>\nPolk County Public Schools District Office<br>\n1915 S. Floral Avenue<br>\nBartow, FL 33830<br>\n<br>\nThe School Board Members: Justin Sharpless, Sara Beth Wyatt, Kate Wallace, Kay Fields, Lisa Miller, William Allen, Travis Keyes; the Superintendent Frederick R. Heid; the attorneys: James Greene, W.A. “Drew” Crawford, and a court reporter will attend the Attorney-Client Session.&nbsp;<br>\n<br>\nDated: October 6, 2026<br>\n<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_5","title":"October 13, 2026 - Notice of Public Hearing or Meeting","content":"NOTICE IS HEREBY GIVEN THAT THE SCHOOL BOARD OF POLK COUNTY FLORIDA, announces a special meeting to which all persons are invited.<br>\n<br>\nDate/Time/Purpose:<span style=\"white-space:pre\">\t</span>October 13, 2026, 12:00 P.M. – Special Board Meeting<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\">School Board Auditorium&nbsp;</span><br>\n1915 S. Floral Ave.<br>\nBartow, FL&nbsp; 33830<br>\n<br>\nAssistance: If you require any type of accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; October 9, 2026<br>\n<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_6","title":"October 13, 2026 - Notice of Public Hearing or Meeting ","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose:<span style=\"white-space:pre\">\t</span>October 13, 2026, 9:00 A.M. Work Session&nbsp;<br>\nOctober 27, 2026, 12:30 P.M. Work Session&nbsp;<br>\nOctober 27, 2026, 5:00 P.M. Board Meeting<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\"><span style=\"white-space:pre\">\t</span>School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830</span></p>\n<p>Assistance:<span style=\"white-space:pre\">\t</span>If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:<span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; September 14, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_7","title":"October 6, 2026 - Quarterly Audit and Finance Committee Meeting","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing for the purpose of conducting regular business.</p>\n<p style=\"text-align: center;\">Quarterly Audit and Finance Committee Meeting</p>\n<p>Date/Time:<span style=\"white-space:pre\">\t\t</span>October 6, 2026 at 9:00 A.M.<br>\n<br>\nLocation:&nbsp; <span style=\"white-space:pre\">\t\t</span>Finance Conference Room - District Office<br>\n1915 South Floral Avenue Bartow, FL&nbsp; 33830<br>\n<br>\nAssistance:<span style=\"white-space:pre\">\t</span>If you require any type of accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at 863-534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:<span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing.&nbsp; Those making an appeal need to preserve a verbatim record of the proceedings at their own expense, usually with a court reporter.&nbsp; The record must include the essential testimony and evidence required for any such appeal.&nbsp;&nbsp;<br>\n<br>\nPlease contact Carol Matthews, Senior Director of Audit Services, with any questions or if there is any additional information needed at carol.matthews@polk-fl.net<br>\n<br>\nDated:&nbsp; September 28, 2026<br>\n<span style=\"white-space: pre; white-space: normal;\">\t\t\t\t\t\t</span><br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl29_divTabs_8","title":"October 2, 2026 - Notice of Public Meeting or Hearing Special Meeting / Retreat","content":"<p style=\"text-align: center;\">NOTICE IS HEREBY GIVEN THAT THE SCHOOL BOARD OF POLK COUNTY, FLORIDA, announces a special meeting to which all persons are invited.</p>\n<p>Date/Time/Purpose:<span style=\"white-space:pre\">\t</span>October 2, 2026, 9:00 A.M. Special Meeting/Retreat<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\"><span style=\"white-space:pre\">\t</span>Jim Miles Professional Development Center</span><br>\n4270 Wallace Road&nbsp;<br>\nLakeland, FL&nbsp; 33812-6344<br>\n<br>\nAssistance:<span style=\"white-space:pre\">\t</span>If you require any type of accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:<span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; September 14, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false}],// required,
