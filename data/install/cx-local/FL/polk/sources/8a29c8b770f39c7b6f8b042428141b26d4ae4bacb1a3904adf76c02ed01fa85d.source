<script type="text/javascript">
    
	$(document).ready(function () {
		var logConsole = function (str) {
			console.log(str);
		};
		if ($('#tabPortlet_230287 .divTabEdit').val() == "True") {
			var isModern = ('True');
			if (isModern.toLowerCase() == "true") {
				var tabObj = $('#tabPortlet_230287 ');
				var tabM = $('#ctl00_ContentPlaceHolder1_ctl23_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl23_divTabs_0","title":"December 8, 2026 - Notice of Public Hearing","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public hearing or meeting to which all persons are invited.</p>\n<p>Date/Time/Purpose:&nbsp; <span style=\"white-space:pre\">\t</span>December 8, 2026, to begin no earlier than 5:00 P.M.<br>\n<span style=\"white-space: normal;\"><span style=\"white-space:pre\">\t\t\t</span>The public hearing is for the following policy updates:</span></p>\n<p>Bylaw 143.1 Residence Areas<br>\nBylaw 169.1 Public Participation at Board Meetings<br>\nPolicy 1211 Whistleblower Protection<br>\nPolicy 2266 Title IX Sexual Harassment Complaint and Investigation Procedures<br>\nPolicy 2421 Career and Technical Education<br>\nPolicy 2450 Adult and Community Education<br>\nPolicy 3120.04 Employment of Substitute, Limited Employment Agreement, and Part-Time Instructional Staff<br>\nPolicy 3211 Whistleblower Protection<br>\nPolicy 4120 Employment of Support Staff<br>\nPolicy 4211 Whistleblower Protection<br>\nPolicy 5330.01 Self-Administered Medication<br>\nPolicy 5460 Graduation Requirements<br>\nPolicy 5780 Student/Parent Rights<br>\nPolicy 8405 School Safety and Security<br>\nPolicy 8420 Emergency Management, Emergency Preparedness and Emergency Response Agencies<br>\nPolicy 8470 Registered Sexual Predators/ Sex Offender<br>\nBylaw 0147 Compensation<br>\nBylaw 0149.3 Board-Staff Communication<br>\nPolicy 1243 Professional Meetings<br>\nPolicy 2370.02 Magnet and Choice Programs/Schools<br>\nPolicy 3129 Conflict of Interest<br>\nPolicy 3243 Professional Meetings<br>\nPolicy 5830 Student Fundraising<br>\nPolicy 6325 Procurement – Federal Grants/Funds<br>\nPolicy 6605 Crowdfunding<br>\nPolicy 6608 School Support Organizations – Accountability and Oversight of Fundraiser and Crowdfunding Disbursements<br>\nPolicy 6610 School Internal Funds<br>\nPolicy 7230 Gifts to the School District<br>\nPolicy 7540.02 Web Content, Apps, and Services<br>\nPolicy 8330 Student Records<br>\nPolicy 8600 Transportation<br>\nPolicy 8600.04 Bus Operator Qualifications, Certifications, Discipline, and Termination<br>\nPolicy 9700 Relations with Special Interest Groups<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\"><span style=\"white-space:pre\">\t</span>School Board Auditorium, 1915 South Floral Avenue, Bartow, FL 33830</span></p>\n<p>Assistance:<span style=\"white-space:pre\">\t</span>If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:<span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.</p>\n<p>For further information about this meeting, please contact Adam Patton, Staff Attorney, Office of Superintendent of the School Board of Polk County, Florida P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.</p>\n<p>Dated: October 28, 2026&nbsp;</p>\n<p>By: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl23_divTabs_1","title":"December 8, 2026 - Notice of Public Hearing or Meeting","content":"NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose:<span style=\"white-space:pre\">\t</span>December 8, 2026 12:30 P.M. Work Session<br>\nDecember 8, 2026 5:00 P.M. Board Meeting<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\">School Board Auditorium&nbsp;</span><br>\n1915 S. Floral Avenue<br>\nBartow, FL 33830<br>\n<br>\nAssistance:&nbsp;If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:&nbsp;Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; October 28, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary<br>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl23_divTabs_2","title":"December 8, 2026 - Notice of Public Hearing","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public hearing or meeting to which all persons are invited.<br>\n<br>\nDate/Time/Purpose:&nbsp;<span style=\"white-space: normal;\"><span style=\"white-space:pre\">\t</span>December 8, 2026, to begin no earlier than 5:01 P.M.</span><br>\n<br>\nPublic hearing for the Student Progression Plan 2026 – 2027<br>\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br>\nLocation:&nbsp;<span style=\"white-space: normal;\">School Board Auditorium</span><br>\n1915 South Floral Avenue<br>\nBartow, FL 33830<br>\n<br>\nAssistance:&nbsp;If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\n<br>\nFor further information about this meeting, please contact Ann Everett, Senior Director of Acceleration and Innovation, School Board of Polk County, Florida P.O. Box 391, Bartow, Florida 33831 at 863-534-0631.</p>\n<p>Dated:&nbsp; October 28, 2026</p>\n<p>By: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false}],// required,
						propPaneId: 'paneId', // optional - pass in default value for demo purposes
