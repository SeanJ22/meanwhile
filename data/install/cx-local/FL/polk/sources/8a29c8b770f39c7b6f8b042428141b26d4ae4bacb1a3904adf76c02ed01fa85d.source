</script><!-- For Absence Report --><script>
// Check if there's an h1 with the text 'Report An Absence'
if (document.querySelector('h1').textContent.trim() === 'Report An Absence') {
    // Find the text input with the specified ID
    var textInput = document.getElementById('ctl00_ContentPlaceHolder1_ctl07_ctl47_field_domain_link_map');
    
    // Check if the text input exists
    if (textInput) {
        // Create a new textarea element
        var textarea = document.createElement('textarea');
        
        // Copy attributes from the text input to the textarea
        textarea.setAttribute('name', textInput.getAttribute('name'));
        textarea.setAttribute('id', textInput.getAttribute('id'));
        textarea.setAttribute('rows', '20'); // You can adjust the number of rows as needed
        textarea.setAttribute('style', 'width: 100%'); // Set width to 100%
        
        // Copy the value from the text input to the textarea
        textarea.value = textInput.value;
        
        // Replace the text input with the textarea
        textInput.parentNode.replaceChild(textarea, textInput);
    }
}
</script><script scr="/UserFiles/Servers/Server_3007318/Templates/mobiletopdisable.js"></script><script>
$(document).ready(function () {
$.multifieldportlet({
  portletName: "Banner-Slider",
  itemHTML: bannerHTML
});
function bannerHTML(struct) {
  return (
   '<div style="position: relative;max-width:100%; overflow:hidden;"><img style="width: 100%;" src="' + struct.image + '"></img></div>'
   );
}


});
</script><!--<script src="http://localhost:8888/news.js"></script>--><script>
document.addEventListener("DOMContentLoaded", function () {

    const el = document.querySelector('.newsTitle');
    if (el) {
        el.style.visibility = "hidden";
    }

    function fixTitle() {
        const title = document.querySelector('.newsTitle');
        if (!title) return;

        const text = title.textContent.trim();

        if (
            text === "Polk County School Board Welcomes New Member" ||
            text === "PCPS Welcomes New Member"
        ) {
            title.textContent = "PCSB Welcomes New Member";
        }

        title.style.visibility = "visible";
    }

    setTimeout(fixTitle, 1000);
});

</script><script>
$(document).ready(function () {
    var links = $('.footer-quick-links-col li').get();

    links.sort(function (a, b) {
        return $(a).text().trim().localeCompare($(b).text().trim());
    });

    var half = Math.ceil(links.length / 2);

    $('.footer-quick-links-col').eq(0).empty().append(links.slice(0, half));
    $('.footer-quick-links-col').eq(1).empty().append(links.slice(half));
});
</script>

