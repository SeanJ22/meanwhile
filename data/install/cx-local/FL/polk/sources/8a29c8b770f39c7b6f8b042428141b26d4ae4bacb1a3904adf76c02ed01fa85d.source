				var tabM = $('#ctl00_ContentPlaceHolder1_ctl44_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl44_divTabs_0","title":"May 26, 2026  - Notice of Special Meeting ","content":"NOTICE IS HEREBY GIVEN that members of the School Board of Polk County will participate in a site visit to which all persons are invited. <br>\n<br>\nDate/Time/Purpose: May 26, 2026 at 10:30 A.M.<br>\nMore than one Polk County School Board member will be in attendance to participate in a site visit of the former State Farm Regional Head quarters office. The purpose of the visit is to assess the viability of the building’s use for future District use. No Action will be taken at this scheduled meeting.                              <br>\n<br>\nLocation: 7401 Cypress Garden Blvd, Winter Haven, FL 33884<br>\n<br>\nAssistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771. <br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal. <br>\n<br>\nFor further information about this special meeting, please contact Joshua McLemore, Director of Planning, School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0500 x489.  <br>\n<br>\nDated:  May 7, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl44_divTabs_1","title":"May 12, 2026  - Notice of Public Hearing or Meeting","content":"<span style=\"color: rgb(0, 0, 0);\">NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public meeting or hearing to which all persons are invited. <br>\n<br>\nAttendance Boundary Committee Meeting<br>\n<br>\nDate/Time: May 12, 2026 at 5:30 P.M. <br>\n<br>\nLocation: School Board District Office <br>\nFacilities &amp; Operations Conference Room <br>\nBuilding C<br>\n1909 South Floral Avenue <br>\nBartow, FL  33830 <br>\n<br>\nAssistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771. <br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal. <br>\n<br>\nFor further information about this public meeting, please contact <strong>Facilities &amp; Operations</strong> for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620 ext. 886. <br>\n<br>\nDated: April 8, 2026<br>\n<br>\nBy: Justin Sharpless, Board Chair <br>\nAttest: Frederick R. Heid, Secretary <br>\n</span><br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl44_divTabs_2","title":"May 5, 2026 - Notice Of Proposed Rule Development Workshop","content":"<p style=\"text-align: center;\"><span style=\"font-size: 13.3333px;\"><strong>NOTICE OF PROPOSED RULE DEVELOPMENT WORKSHOP</strong></span><strong><br>\n<span style=\"font-size: 13.3333px;\">SCHOOL BOARD POLICY</span></strong></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">The School Board of Polk County, Florida (“Board”) will hold a public workshop on the following revised Board policies Bylaw 0147, Bylaw 0149.3, Policy 1243, Policy 2261.02, Policy 2370, Policy 3129, Policy 3243, Policy 5830, Policy 6325, Policy 6605, Policy 6608, Policy 6610, Policy 7230, Policy 7540.02, Policy 8330, Policy 8600, Policy 8600.04, Policy 9211, Policy 9215, and Policy 9700, on May 5, 2026 at the Polk County Public Schools Administrative Offices, located at 1915 South Floral Avenue, Bartow, FL 33830. The proposed changes to the above referenced Board policies will be published on the Polk County Public Schools (“PCPS”) website as part of the meeting agenda seven days prior to the meeting. Meeting agendas can be accessed at:</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><a href=\"https://www.polkschoolsfl.com/about/meetings\" title=\"Link to the Meeting webpage\"></a></span></p>\n<p style=\"text-align: center;\"><span style=\"font-size: 13.3333px;\"><a href=\"https://www.polkschoolsfl.com/about/meetings\" title=\"Link to the Meeting webpage\">https://www.polkschoolsfl.com/about/meetings</a></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">The proposed changes may be requested prior to the meeting agenda publication by emailing the Public Records Office at teresa.griffin@polk-fl.net. Copies may be obtained at the Polk County Public Schools Administrative Offices between the hours of 8:00 a.m. and 4:00 p.m. in the Public Records Office.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><br>\n<span style=\"font-size: 13.3333px;\">The revised Board policies will be placed on the Board’s agenda for a public hearing during the June 9, 2026 meeting at the Polk County Public Schools Administrative Offices, located at 1915 South Floral Avenue, Bartow, FL 33830.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><br>\n<span style=\"font-size: 13.3333px;\">Written comments may be submitted within 21 days of the date of this notice to Legal Services, 1915 South Floral Avenue, Bartow, FL 33830. Substantially affected persons may, within 14 days of the date of this notice, file an objection to this rulemaking with the Board. The objection shall specify the portions of the proposed rules to which the person objects and the specific reasons for the objections.&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span></p>\n<p style=\"text-align: center;\"><span style=\"font-size: 13.3333px;\"><strong>Bylaw 0147 Compensation</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><strong>Purpose and Effect:</strong><span style=\"white-space: pre;\">\t</span>Proposed revisions include modifications to various definitions.</p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.&nbsp;</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 1001.395</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: center;\"><span style=\"font-size: 13.3333px;\"><strong>Bylaw 0149.3 Board-Staff Communications&nbsp;</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with current practice.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content edits.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><br>\n<span style=\"font-size: 13.3333px;\"><strong>Policies 1243/3243 Professional Meetings</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 1003.413, 1012.985, 1012.98</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><strong><span style=\"font-size: 13.3333px;\">Policy 2261.02 Title I – Parents’ Right to Know</span></strong></p>\n<p style=\"text-align: left;\"><strong><span style=\"font-size: 13.3333px;\">&nbsp;</span></strong><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span></p>\n<p style=\"text-align: left;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>20 U.S.C. 6311, Elementary and Secondary Education Act of 1965, 34 C.F.R. Part 200 et seq.</p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>Policy 2370&nbsp; Magnet and Choice Programs and Schools</strong></span><br>\n<span style=\"font-size: 13.3333px;\"></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Specific Authority:<span style=\"white-space:pre\">\t</span>F.S. 1001.32(2), 1001.41(6), 1001.42(4),(a), 1001.43(3),(8), 1002.31seq.</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Policy 3129 Conflict of Interest</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\"> </span>Proposed revisions to comply with revised statutes and rules.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span></p>\n<p style=\"text-align: left;\"><strong></strong><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 112.312, F.S. 112.313, F.S. 1006.32, 2 C.F.R. 200.112, 2 C.F.R. 200.113, 2 C.F.R. 200.318</p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Policy 5830 Student Fund-Raising</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:&nbsp;</strong>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<br>\n<span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 1001.41, F.S. 1001.42, F.S. 1001.43, F.S. 1010.01, F.S. 1010.20, F.S. 1011.07, F.A.C. 5P-1.003, Responsibilities for the School Food Service Program, F.A.C. 6A-1.001, District Financial Records, F.A.C. 6A-1.087, School Board Responsible for Internal Funds, F.A.C. 6A-1.091, Purchases from Internal Funds, 7 C.F.R. Part 210, 7 C.F.R. Part 220, 42 U.S.C. 1779, Chapter 8, Financial and Program Cost Accounting and Property for Florida Schools, 2014</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Policy 6325 Procurement – Federal Grants/Funds</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Summary:&nbsp;</strong>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<span style=\"font-size: 13.3333px;\"></span></p>\n<p style=\"text-align: left;\"><strong>Specific Authority:</strong><span style=\"white-space: pre;\">\t</span>F.S. 287.057, Appendix II to Part 200, 2 C.F.R. 200.520, 2 C.F.R. 200.334 - 200.336, 2 C.F.R. 200.317, 2 C.F.R. 200.318, 2 C.F.R. 200.319, 2 C.F.R. 200.320, 2 C.F.R. 200.321, 2 C.F.R. 200.322, 2 C.F.R. 200.323, 2 C.F.R. 200.324, 2 C.F.R. 200.325, 2 C.F.R. 200.326, 2 C.F.R. 3485.220, 7 C.F.R. 210.21</p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Policy 6605 Crowdfunding</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to add additional monitoring requirements.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Summary:&nbsp;</strong>Revisions to existing language includes content, formatting, and terminology edits.</span><br>\n<span style=\"font-size: 13.3333px;\"></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>Policy 6608 School Support Organizations – Accountability and Oversight of Fundraiser and Crowdfunding Disbursements</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>New policy to provide accountability for fundraising and crowdfunding.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>New language provides accountability for fundraising and crowdfunding.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Policy 6610 School Internal Funds</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Summary:&nbsp;</strong>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<br>\n<span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 1001.43, F.S. 1010.02, F.S. 1010.20, F.S. 1011.07, F.S. 1011.18, F.A.C. 6A-1.001, F.A.C. 6A-1.014, Financial and Program Cost Accounting and Reporting for Florida Schools, as revised</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Policy 7230 Gifts to the School District</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:&nbsp;</strong>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<br>\n<span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 112.312, F.S. 1001.32, F.S. 1001.41, F.S. 1001.42, F.S. 1001.43</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Policy 7540.02 Web Content, Apps, and Services</strong></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:&nbsp;</strong>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span></p>\n<p style=\"text-align: left;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 104.31(1)(a), F.S. 110.233(2), F.S. 110.233(4), F.S. 112.313(6), F.S. 1001.32(2), F.S. 1001.42, H.R. 4577, P.L. 106-554, Children's Internet Protection Act of 2000, People Against Tax Revenue Mismanagement v. County of Leon, 583 So. 2d 1373 (Fla. 1991); Commission on Ethics:&nbsp; In Re:&nbsp; Patty Lynch, Case No. 2068EC (1994)</p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>Policy 8330 Student Records</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:<span style=\"white-space:pre\">\t</span></strong>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<span style=\"font-size: 13.3333px;\"></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. Chapter 1119, F.S. 1001.41, F.S. 1001.52, F.S. 1002.22, F.S. 1002.221, F.S. 1002.222, F.S. 1003.25, F.A.C. 6A-1.0955, 20 U.S.C. Section 1232f through 1232i (FERPA), 20 U.S.C. 7908, 26 U.S.C. 152, 20 U.S.C. 1400 et seq., Individuals with Disabilities Act, Privacy Rights of Parents and Students - P.L. 90-247, 2021 Solomon Amendment: Subtitle C- General Service Authorities and Correction of Military Records SEC. 521</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><br>\n<span style=\"font-size: 13.3333px;\"><strong>Policy 8600 Transportation</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 316.173, F.S. 316.183(3), F.S. 316.217(1)(b), F.S. 1006.21, F.S. 1006.22, F.S. 1006.23, F.S. 1011.68, F.S. 1012.45, F.A.C. Chapter 6A-3</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"></span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>Policy 8600.04 Bus Operator Qualifications, Certifications, Discipline, and Termination</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 316.305, F.S. 316.306, F.S. 1012.45, F.S. 1012.465, F.S. Chapter 316, F.S. Chapter 1006, F.A.C. 6A-3.0121, F.A.C. 6A-3.0141, F.A.C. 6A-3.0171, 49 C.F.R. Part 40, 49 C.F.R. Part 382, 49 C.F.R. Part 391</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Policy 9211 Guidelines for Internal and External Support Organizations</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>7 C.F.R. 210.11, 42 U.S.C. 1779, F.S. 1001.41, F.S. 1001.42, F.S. 1001.43, F.S. 1010.01, F.S. 1010.20, F.S. 1011.07, F.A.C. 5P-1.003, Responsibilities for the School Food Service Program, F.A.C. 6A-1.001, District Financial Records, F.A.C. 6A-1.087, School Board Responsible for Internal Funds, F.A.C. 6A-1.091, Purchases from Internal Funds, Chapter 8, Financial and Program Cost Accounting and Property for Florida Schools, 2014</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><strong><span style=\"font-size: 13.3333px;\">Policy 9215 Direct Support Organizations</span><br>\n</strong>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Specific Autho</strong>rity:<span style=\"white-space:pre\">\t</span>F.S. 11.45(8), 119.07(1), 1001.453, F.A.C. 6A-1.0013, F.S. 1001.41, F.S. 1001.42, F.S. 1001.4, F.S. 1010.01, F.S. 1010.20, F.S. 1011.07, F.A.C. 6A-1.001, I.R.C. 170(f)(8), I.R.C. 170(f)(12), Title VI, Civil Rights Act of 1964, Title IX, Education Amendments of 1972, Section 504, Rehabilitation Act of 1973, Americans with Disabilities Act</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">&nbsp;</span><span style=\"font-size: 13.3333px;\"><strong>Policy 9700 Relations with Special Interest Groups</strong></span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Purpose and Effect:</strong><span style=\"white-space:pre\">\t</span>Proposed revisions to comply with revised statutes and rules.</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><span style=\"font-size: 13.3333px;\"><strong>Summary:</strong><span style=\"white-space:pre\">\t</span>Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\"><strong>&nbsp;</strong></span><span style=\"font-size: 13.3333px;\"><strong>Specific Authority:</strong><span style=\"white-space:pre\">\t</span>F.S. 1013.10</span><br>\n<span style=\"font-size: 13.3333px;\"><br>\n</span><br>\n<span style=\"font-size: 13.3333px;\">By: Justine Sharpless, Board Chair</span></p>\n<p style=\"text-align: left;\"><span style=\"font-size: 13.3333px;\">Attest: Frederick R. Heid, Secretary</span></p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl44_divTabs_3","title":"May 5, 2026 - Notice of Public Hearing or Meeting","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose:\tMay 5, 2026, 12:30 P.M. Work Session <br>\nMay 5, 2026, 5:00 P.M. Board Meeting<br>\n<br>\nLocation:&nbsp;School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830</p>\n<p>Assistance:\tIf you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:\tNotice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:  April 21, 2026</p>\n<p>By: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<br>","active":false,"disabled":false}],// required,
						propPaneId: 'paneId', // optional - pass in default value for demo purposes
						propTitle: 'title', // optional - pass in default value for demo purposes
						propActive: 'active', // optional - pass in default value for demo purposes
						propDisabled: 'disabled', // optional - pass in default value for demo purposes
						propContent: 'content', // optional - pass in default value for demo purposes
						tabMode: tabM,
						scrollToTabEdge: false, // optional - pass in default value for demo purposes
						disableScrollArrowsOnFullyScrolled: false // optional- pass in default value for demo purposes
					}).on('ready.scrtabs', function () {
						$('#' + this.id + ' .tab-pane').attr('tabindex', 0);
					});
				};

				activate();

            }
        }
	});

    function OnClientLoad(editor) {
        editor.attachEventHandler('onkeydown', function () { detectChanges(); });  
    }

    function OnCommandExecuted(editor) {
        detectChanges();
    }

    function OnTabNameChanged() {
        detectChanges();
    }

    function detectChanges() {
        var unsavedChanges = $('.unsaved-changes-row input[type=hidden]');
        if (unsavedChanges.length > 0) {
            unsavedChanges.val('True');
        }
    }
</script>
