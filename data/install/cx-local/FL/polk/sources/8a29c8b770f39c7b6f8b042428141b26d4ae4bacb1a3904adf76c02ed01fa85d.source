	$(document).ready(function () {
		var logConsole = function (str) {
			console.log(str);
		};
		if ($('#tabPortlet_222376 .divTabEdit').val() == "True") {
			var isModern = ('True');
			if (isModern.toLowerCase() == "true") {
				var tabObj = $('#tabPortlet_222376 ');
				var tabM = $('#ctl00_ContentPlaceHolder1_ctl38_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl38_divTabs_0","title":"July 29, 2026 - Notice of Special Meeting","content":"<p>NOTICE IS HEREBY GIVEN that members of the School Board of Polk County will participate in a site visit to which all persons are invited.&nbsp;<br>\n<br>\nDate/Time/Purpose: <span style=\"white-space:pre\">\t</span>July 29, 2026 at 2:00 P.M.<br>\nAugust 5, 2026 at 2:00 P.M.</p>\n<p>More than one Polk County School Board member will be in attendance to participate in a site visit of the former State Farm Regional Head quarters office. The purpose of the visit is to assess the viability of the building’s use for future District use. No Action will be taken at this scheduled meeting.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p>\n<p>Location: <span style=\"white-space:pre\">\t</span>7401 Cypress Garden Blvd, Winter Haven, FL 33884</p>\n<p>Assistance: <span style=\"white-space:pre\">\t</span>If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.&nbsp;</p>\n<p>Appeal Notice: <span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.&nbsp;<br>\n<br>\nFor further information about this special meeting, please contact Joshua McLemore, Director of Planning, School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0500 x489.&nbsp;&nbsp;<br>\n<br>\nDated:&nbsp; July 22, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary<br>\n<span style=\"white-space: normal; white-space:pre\">\t&nbsp;</span></p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl38_divTabs_1","title":"July 28, 2026 - Notice of Grievance Hearing","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida, announces a grievance hearing to which all persons are invited.</p>\n<p>Date/Time/Purpose:&nbsp;<span style=\"white-space: normal;\">July 28, 2026 - 11:00 A.M.</span><br>\n<br>\nTo hear the following Step III Grievance filed by the Polk Education Association:<br>\n<br>\nPolk Education Association Step III Grievance&nbsp;<br>\nPolk Education Association<br>\nAll newly hired teachers for the 2025-2026 School Year<br>\nGrievance # 03132026<br>\n<br>\nPEA Statement of Grievance:<br>\n&nbsp;<br>\nThe Employer has engaged in ongoing breach of the Teacher Collective Bargaining Agreement by incorrectly withholding a year of experience or more from New Hires on the Teacher Performance Salary Schedule Initial Placement Matrix. Teachers hired or re-hired prior to February 25, 2026, but on or after July 1, 2024, should have been credited with all years of experience gained prior to July 1, 2025.<br>\n&nbsp;<br>\nPEA Relief Sought:<br>\n&nbsp;<br>\nAll employees covered under the Teacher Collective Bargaining Agreement hired or re-hired between July 1, 2025 and February 24, 2026 will be correctly placed according to the Teacher Performance Salary Schedule Initial Placement Matrix under which they were hired based upon verified teaching experience provided the teaching experience is verified in writing within 90 days of the date of hire.<br>\n<br>\nLocation: School Board Auditorium, 1915 Floral Avenue, Bartow, FL 33830</p>\n<p>Assistance:&nbsp;If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this Grievance Hearing, please contact Karen Fleming, Senior Coordinator, Labor Relations, Labor and Employee Relations for the School Board of Polk County, Florida, at P.O. Box 391 Bartow, FL&nbsp; 33831 or 863-534-0781.</p>\n<p>Dated:&nbsp; July 15, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl38_divTabs_2","title":"July 28, 2026 - Notice of Public Hearing","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public hearing or meeting to which all persons are invited.</p>\n<p>Date/Time/Purpose:&nbsp; <span style=\"white-space:pre\">\t</span>July 28, 2026, to begin no earlier than 5:00 P.M.<br>\n<span style=\"white-space: normal; white-space:pre\"></span></p>\n<p style=\"text-align: center;\"><span style=\"white-space: normal;\"><span style=\"white-space:pre\">&nbsp;</span>The public hearing is for the following policy updates:</span></p>\n<p>Bylaw 0147 Compensation<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\">School Board Auditorium, 1915 South Floral Avenue, Bartow, FL 33830</span></p>\n<p>Assistance:&nbsp;If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.</p>\n<p>For further information about this meeting, please contact <strong>Chad Davis</strong>, Staff Attorney, Office of Superintendent of the School Board of Polk County, Florida P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.</p>\n<p>Dated: June 15, 2026&nbsp;<br>\nBy: Justin Sharpless, Board Chair<br>\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <span style=\"white-space:pre\">\t\t\t</span>Attest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl38_divTabs_3","title":"July 28, 2026 - Notice of Public Hearing or Meeting","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose: July 28, 2026, 12:30 P.M. Work Session<br>\nJuly 28, 2026, 5:00 P.M. Board Meeting<br>\n<br>\nLocation: School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830</p>\n<p>Assistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; June 15, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl38_divTabs_4","title":"July 21, 2026 - Notice of Public Hearing or Meeting","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public meeting or hearing to which all persons are invited.&nbsp;</p>\n<p style=\"text-align: center;\"><strong>Attendance Boundary Committee Meeting</strong></p>\n<p>Date/Time: July 21, 2026 at 5:30 P.M.&nbsp;<br>\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>\nLocation: Jim Miles Professional Development Center<br>\n4270 Wallace Rd<br>\nLakeland, FL 33812&nbsp;</p>\n<p>Assistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.&nbsp;<br>\n&nbsp;<br>\nAppeal Notice:&nbsp;Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.&nbsp;<br>\n&nbsp;<br>\nFor further information about this public meeting, please contact <strong>Facilities &amp; Operations</strong> for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620 ext. 886.&nbsp;<br>\n&nbsp;<br>\n<br>\nDated: June 25, 2026<br>\n<br>\nBy: Justin Sharpless, Board Chair&nbsp;<br>\nAttest: Frederick R. Heid, Secretary&nbsp;<br>\n&nbsp;</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl38_divTabs_5","title":"July 13, 2026 - Notice of Public Hearing or Meeting","content":"<p style=\"text-align: center;\">NOTICE IS HEREBY GIVEN THAT THE SCHOOL BOARD OF POLK COUNTY, FLORIDA, announces a special meeting to which all persons are invited.</p>\n<p>Date/Time/Purpose: July 13, 2026, 3:00 P.M. - Board Meeting<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\">Jim Miles Professional Development Center</span><br>\n4270 Wallace Road&nbsp;<br>\nLakeland, FL&nbsp; 33812-6344<br>\n<br>\nAssistance:&nbsp;If you require any type of accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; June 25, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl38_divTabs_6","title":"July 13, 2026 - Notice of Public Meeting or Hearing Special Meeting / Retreat","content":"<p style=\"text-align: center;\">NOTICE IS HEREBY GIVEN THAT THE SCHOOL BOARD OF POLK COUNTY, FLORIDA, announces a special meeting to which all persons are invited.</p>\n<p>Date/Time/Purpose: July 13, 2026, 9:00 A.M. Special Meeting/Retreat<br>\n<br>\nLocation: Jim Miles Professional Development Center<br>\n4270 Wallace Road&nbsp;<br>\nLakeland, FL&nbsp; 33812-6344<br>\n<br>\nAssistance: If you require any type of accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; June 15, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl38_divTabs_7","title":"July 7, 2026 - Notice of Public Hearing or Meeting","content":"<p>Notice is hereby given that the School Board of Polk County, Florida will hold a public meeting or hearing for the purpose of conducting regular business.</p>\n<p style=\"text-align: center;\"><strong>Quarterly Audit and Finance Committee Meeting</strong></p>\n<p>Date/Time:&nbsp;July 7, 2026 at 9:00 A.M.<br>\n<br>\nLocation: Finance Conference Room - District Office<br>\n1915 South Floral Avenue Bartow, FL&nbsp; 33830<br>\n<br>\nAssistance:&nbsp;If you require any type of accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at 863-534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice: Notice is given with accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing.&nbsp; Those making an appeal need to preserve a verbatim record of the proceedings at their own expense, usually with a court reporter.&nbsp; The record must include the essential testimony and evidence required for any such appeal.&nbsp;&nbsp;<br>\n<br>\nPlease contact Carol Matthews, Senior Director of Audit Services, with any questions or if there is any additional information needed at <a href=\"mailto:carol.matthews@polk-fl.net\" class=\"ApplyClass\">carol.matthews@polk-fl.net</a><br>\n<br>\nDated:&nbsp; June 25, 2026<br>\n<span style=\"white-space: pre; white-space: normal;\">\t\t\t\t\t\t</span><br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false}],// required,
