<script type="text/javascript">
    
	$(document).ready(function () {
		var logConsole = function (str) {
			console.log(str);
		};
		if ($('#tabPortlet_214317 .divTabEdit').val() == "True") {
			var isModern = ('True');
			if (isModern.toLowerCase() == "true") {
				var tabObj = $('#tabPortlet_214317 ');
				var tabM = $('#ctl00_ContentPlaceHolder1_ctl53_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl53_divTabs_0","title":"February 24, 2026 - Notice Of Proposed Rule Development Workshop School Board Policy","content":"<span style=\"color: rgb(0, 0, 0);\">The School Board of Polk County, Florida (“Board”) will hold a public workshop on the following revised Board policies Bylaw 0147.1, Policy 1124, Policy 3124, Policy 4124, and Policy 5223, on February 24, 2026 at the Polk County Public Schools Administrative Offices, located at 1915 South Floral Avenue, Bartow, FL 33830. The proposed changes to the above referenced Board policies will be published on the Polk County Public Schools (“PCPS”) website as part of the meeting agenda seven days prior to the meeting. Meeting agendas can be accessed at:<br>\n<br>\n<a href=\"https://www.polkschoolsfl.com/about/meetings\" title=\"Link\">https://www.polkschoolsfl.com/about/meetings</a><br>\n<br>\nThe proposed changes may be requested prior to the meeting agenda publication by emailing the Public Records Office at publicrecords@polkschoolsfl.incidentiq.com. Copies may be obtained at the Polk County Public Schools Administrative Offices between the hours of 8:00 a.m. and 4:00 p.m. in the Public Records Office.<br>\n<br>\nThe revised Board policies will be placed on the Board’s agenda for a public hearing during the April 28, 2026 meeting at the Polk County Public Schools Administrative Offices, located at 1915 South Floral Avenue, Bartow, FL 33830.<br>\n<br>\nWritten comments may be submitted within 21 days of the date of this notice to Legal Services, 1915 South Floral Avenue, Bartow, FL 33830. Substantially affected persons may, within 14 days of the date of this notice, file an objection to this rulemaking with the Board. The objection shall specify the portions of the proposed rules to which the person objects and the specific reasons for the objections. <br>\n<strong><br>\nBylaw 0147.1 Travel and Expenses</strong><br>\n<strong><br>\nPurpose and Effect: </strong>Proposed revisions include modifications to various definitions.<br>\n<br>\n<strong>Summary:</strong> Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language. <br>\n<strong><br>\nSpecific Authority</strong>: F.S. 112.061, F.S. 1001.39, F.S. 1011.051, F.A.C. 6A-1.056, 2 C.F.R. 200.474<br>\n<br>\n<strong>Policies 1124/ 3124/ 4124 Drug-Free Workplace</strong><br>\n<br>\n<strong>Purpose and Effect: </strong>Proposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong> Revisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority: </strong>F.S. 440.101, F.S. 440.102, F.A.C. Chapter 59A-24, Drug-Free Workplace Standards<br>\n<br>\n<strong><br>\nPolicy 5223 Absences for Religious Instruction</strong><br>\n<br>\n<strong>Purpose and Effect</strong>:\tProposed revisions to comply with revised statutes and rules.<br>\n<br>\n<strong>Summary:</strong>\tRevisions to existing language includes content, formatting, and terminology edits consistent with statutory language.<br>\n<br>\n<strong>Specific Authority:\t</strong>F.S. 1003.21, F.A.C. 6A-1.09514<br>\n</span><br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl53_divTabs_1","title":"February 10, 2026 - Notice of Public Hearing or Meeting","content":"NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public meeting or hearing to which all persons are invited. <br>\n<br>\n<strong>Attendance Boundary Committee Meeting</strong><br>\n<br>\nDate/Time: \tFebruary 10, 2026 at 5:30 P.M. <br>\n<br>\nLocation: School Board District Office <br>\nFacilities &amp; Operations Conference Room <br>\nBuilding C<br>\n1909 South Floral Avenue <br>\nBartow, FL  33830 <br>\n<br>\nAssistance: \tIf you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771. <br>\n<br>\nAppeal Notice: \tNotice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal. <br>\n<br>\nFor further information about this public meeting, please contact <strong>Facilities &amp; Operations</strong> for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620 ext. 886. <br>\n<br>\nDated: January 21, 2026<br>\nBy: Justin Sharpless, Board Chair <br>\nAttest: Frederick R. Heid, Secretary <br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl53_divTabs_2","title":"February 10, 2026 - Notice of Grievance Hearing","content":"NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida, announces a grievance hearing to which all persons are invited.<br>\n<br>\nDate/Time/Purpose: February 10, 2026 - 9:00 A.M.<br>\n<br>\nTo hear the following Step III Grievance filed by the Polk Education Association:<br>\nPolk Education Association Step III Grievance <br>\nSabina Taylor, Teacher <br>\nGrievance # 0962025<br>\n<br>\nLocation: School Board Auditorium, 1915 Floral Avenue, Bartow, FL 33830<br>\n<br>\nAssistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:\tNotice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this Grievance Hearing, please contact Karen Fleming, Senior Coordinator, Labor Relations, Labor and Employee Relations for the School Board of Polk County, Florida, at P.O. Box 391 Bartow, FL  33831 or 863-534-0781.<br>\nDated:  January 27, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl53_divTabs_3","title":"February 10, 2026  & February 24, 2026 - Notice of Public Hearing or Meeting","content":"<br>\nNOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose:<br>\nFebruary 10, 2026, 10:00 A.M. Work Session <br>\nFebruary 24, 2026, 12:30 P.M. Work Session<br>\nFebruary 24, 2026, 5:00 P.M. Board Meeting<br>\n<br>\nLocation: School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830<br>\n<br>\nAssistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:\tNotice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:  January 20, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl53_divTabs_4","title":"February 6, 2026 - Notice of Public Hearing or Meeting","content":"NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose: February 6, 2026, at 9:00 am for a CFAA Meeting<br>\n<br>\nLocation: District Office, Superintendent’s Office, 1915 S. Floral Avenue, Bartow, FL 33830<br>\n<br>\nAssistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:\tNotice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:  January 27, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary<br>","active":false,"disabled":false}],// required,
