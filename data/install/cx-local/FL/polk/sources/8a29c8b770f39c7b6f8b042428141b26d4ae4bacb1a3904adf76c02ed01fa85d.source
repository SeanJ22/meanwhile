				var tabM = $('#ctl00_ContentPlaceHolder1_ctl35_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl35_divTabs_0","title":"August 27, 2026 - Public Notice","content":"<p>NOTICE IS HEREBY GIVEN that THE SCHOOL BOARD OF POLK COUNTY, FLORIDA has settled the following claims brought by:</p>\n<ul>\n    <li>Marta Irene</li>\n    <li>Ladonya Austin</li>\n    <li>Debra Jones</li>\n</ul>\n<p>These claims settled for an amount exceeding $5,000.00, with proceeds paid by the Florida School Boards Insurance Trust on behalf of the Polk County School Board.&nbsp;&nbsp;<br>\n<br>\nDated:<span style=\"white-space:pre\">\t</span>August 27, 2026&nbsp;<br>\nBy: Justin Sharpless, Board Chair<br>\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <span style=\"white-space:pre\">\t\t\t</span>Attest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl35_divTabs_1","title":"August 25, 2026 - Notice of Public Hearing or Meeting","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose:<span style=\"white-space:pre\">\t</span>August 25, 2026, 12:30 P.M. Work Session&nbsp;<br>\nAugust 25, 2026, 5:00 P.M. Board Meeting<br>\nSeptember 8, 2026 12:30 P.M. Work Session<br>\nSeptember 8, 2026 5:00 P.M. Board Meeting<br>\nSeptember 22, 2026 9:00 A.M. Work Session<br>\n<br>\nLocation:&nbsp;<span style=\"white-space: normal;\"><span style=\"white-space:pre\">\t</span>School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830</span></p>\n<p>Assistance:<span style=\"white-space:pre\">\t</span>If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:<span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:&nbsp; August 7, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<div></div>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl35_divTabs_2","title":"August 18, 2026  - Notice of Public Hearing or Meeting","content":"NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public meeting or hearing to which all persons are invited. <br>\n<br>\nAttendance Boundary Committee Meeting<br>\n<br>\nDate/Time: August 18, 2026 at 5:30 P.M. <br>\n<br>\nLocation: Jim Miles Professional Development Center, 4270 Wallace Rd, Lakeland, FL 33812 <br>\n<br>\nAssistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771. <br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal. <br>\n<br>\nFor further information about this public meeting, please contact Facilities &amp; Operations for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620 ext. 886. <br>\n<br>\nDated: July 22, 2026<br>\nBy: Justin Sharpless, Board Chair <br>\nAttest: Frederick R. Heid, Secretary <br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl35_divTabs_3","title":"August 5, 2026 - Notice of Special Meeting ","content":"<p>NOTICE IS HEREBY GIVEN that members of the School Board of Polk County will participate in a site visit to which all persons are invited.&nbsp;<br>\n<br>\nDate/Time/Purpose: <span style=\"white-space:pre\">\t</span>July 29, 2026 at 2:00 P.M.<br>\nAugust 5, 2026 at 2:00 P.M.</p>\n<p>More than one Polk County School Board member will be in attendance to participate in a site visit of the former State Farm Regional Head quarters office. The purpose of the visit is to assess the viability of the building’s use for future District use. No Action will be taken at this scheduled meeting.&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p>\n<p>Location: <span style=\"white-space:pre\">\t</span>7401 Cypress Garden Blvd, Winter Haven, FL 33884</p>\n<p>Assistance: <span style=\"white-space:pre\">\t</span>If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.&nbsp; If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.&nbsp;</p>\n<p>Appeal Notice: <span style=\"white-space:pre\">\t</span>Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.&nbsp;<br>\n<br>\nFor further information about this special meeting, please contact Joshua McLemore, Director of Planning, School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0500 x489.&nbsp;&nbsp;<br>\n<br>\nDated:&nbsp; July 22, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary<br>\n<span style=\"white-space: normal; white-space:pre\">\t&nbsp;</span></p>\n<div></div>","active":false,"disabled":false}],// required,
