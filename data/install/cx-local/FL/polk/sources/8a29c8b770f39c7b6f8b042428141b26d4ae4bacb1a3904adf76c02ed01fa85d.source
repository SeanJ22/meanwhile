			if (isModern.toLowerCase() == "true") {
				var tabObj = $('#tabPortlet_215254 ');
				var tabM = $('#ctl00_ContentPlaceHolder1_ctl50_divTabs').attr('portlet') == 'tab';

				function activate() {
					$(tabObj).scrollingTabs({
						tabs: [{"paneId":"ctl00_ContentPlaceHolder1_ctl50_divTabs_0","title":"March 24, 2026 - Finance Corporation Meeting - Resolution 11","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida, has scheduled a special meeting of the Finance Corporation to which all persons are invited. <br>\n<br>\nDate/Time: \tMarch 24, 2026 to begin no earlier than 5:01 P.M. <br>\n<br>\nPurpose: \tDiscuss and adopt Resolution No. 2025/2026-11<br>\n<br>\nA RESOLUTION OF THE SCHOOL BOARD OF POLK COUNTY, FLORIDA, APPROVING THE FORM OF AND AUTHORIZING THE EXECUTION AND DELIVERY OF LEASE SCHEDULE NO. 2026 TO A MASTER LEASE-PURCHASE AGREEMENT RELATING TO THE LEASE-PURCHASE OF CERTAIN LAND, EQUIPMENT AND BUILDINGS CONSTITUTING EDUCATIONAL FACILITIES; APPROVING THE FORM AND AUTHORIZING THE EXECUTION AND DELIVERY OF A SERIES 2026 SUPPLEMENTAL TRUST AGREEMENT PURSUANT TO WHICH THE TRUSTEE WILL EXECUTE, AUTHENTICATE AND DELIVER NOT TO EXCEED $305,000,000 IN AGGREGATE PRINCIPAL AMOUNT OF CERTIFICATES OF PARTICIPATION, SERIES 2026 EVIDENCING FRACTIONAL UNDIVIDED INTERESTS OF THE OWNERS THEREOF IN BASIC RENT PAYMENTS TO BE MADE UNDER SUCH MASTER LEASE-PURCHASE AGREEMENT IN CONNECTION WITH THE FINANCING OF CERTAIN CERTIFICATES OF PARTICIPATION; APPROVING U.S. BANK TRUST COMPANY, NATIONAL ASSOCIATION, AS SUCCESSOR TRUSTEE; AUTHORIZING THE CHAIR AND THE SUPERINTENDENT OF SCHOOLS TO AWARD THE SALE OF THE SERIES 2026 CERTIFICATES TO THE UNDERWRITERS WITHIN THE PARAMETERS SET FORTH HEREIN; APPROVING THE FORM OF AND AUTHORIZING THE EXECUTION AND DELIVERY OF A CERTIFICATE PURCHASE CONTRACT RELATING TO THE NEGOTIATED SALE OF SUCH CERTIFICATES OF PARTICIPATION UPON SUCH AWARD; APPROVING THE FORM OF A PRELIMINARY OFFERING STATEMENT AND AUTHORIZING THE EXECUTION AND DELIVERY OF A FINAL OFFERING STATEMENT WITH RESPECT TO SUCH CERTIFICATES OF PARTICIPATION; APPROVING THE FORM AND AUTHORIZING THE EXECUTION AND DELIVERY OF A DISCLOSURE DISSEMINATION AGENT AGREEMENT;\nAPPROVING THE FORM AND AUTHORIZING THE EXECUTION OF A GROUND LEASE AGREEMENT; APPROVING THE FORM AND AUTHORIZING THE EXECUTION OF A MEMORANDUM OF GROUND LEASE; APPROVING THE FORM OF AND AUTHORIZING THE EXECUTION AND DELIVERY OF A THIRD AMENDMENT TO MASTER LEASE-PURCHASE AGREEMENT; APPROVING THE FORM OF AND AUTHORIZING THE EXECUTION AND DELIVERY OF A THIRD AMENDMENT TO MASTER TRUST AGREEMENT; AND APPROVING THE FORM AND AUTHORIZING THE EXECUTION OF AN ASSIGNMENT OF GROUND LEASE; DELEGATING AUTHORITY TO DETERMINE WHETHER TO UTILIZE MUNICIPAL BOND INSURANCE FOR 2 ALL OR A PORTION OF SUCH CERTIFICATES; PROVIDING CERTAIN OTHER AUTHORIZATIONS AND DETAILS, AND PROVIDING AN EFFECTIVE DATE.<br>\n<br>\nLocation: \t\tSchool Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830</p>\n<p>Assistance:\tIf you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.</p>\n<p>Appeal Notice:\tNotice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.</p>\n<p>For further information about this public meeting, please contact Heather Jenkins, Associate Superintendent Chief Financial Officers, School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-457-4704. <br>\n<br>\nDated:\tMarch 11, 2026</p>\n<p>By: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl50_divTabs_1","title":"March 24, 2026 - Finance Corporation Meeting - Resolution 10","content":"<p>NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida, has scheduled a special meeting of the Finance Corporation to which all persons are invited. <br>\n<br>\nDate/Time: \tMarch 24, 2026 to begin no earlier than 5:01 P.M. <br>\n<br>\nPurpose: \tDiscuss and adopt Resolution No. 2025/2026-10<br>\n<br>\nA RESOLUTION AUTHORIZING THE CORPORATION TO ENTER INTO (I) A LEASE SCHEDULE NO. 2026, IN CONNECTION WITH THE ISSUANCE ON BEHALF OF THE SCHOOL BOARD OF POLK COUNTY, FLORIDA, OF NOT TO EXCEED $305,000,000 CERTIFICATES OF PARTICIPATION\n(SCHOOL BOARD OF POLK COUNTY, FLORIDA, MASTER LEASE PROGRAM), SERIES 2026, FOR THE PURPOSE OF FINANCING ALL OR A\nPORTION OF CERTAIN EDUCATIONAL FACILITIES BEING LEASEPURCHASED BY THE SCHOOL BOARD AND A THIRD AMENDMENT TO\nMASTER LEASE, (II) A SERIES 2026 SUPPLEMENTAL TRUST AGREEMENT AND A THIRD AMENDMENT TO MASTER TRUST\nAGREEMENT, (III) A CERTIFICATE PURCHASE CONTRACT, (IV) A\nGROUND LEASE AGREEMENT, (V) A MEMORANDUM OF GROUND\nLEASE, (VI) AN ASSIGNMENT OF GROUND LEASE AND RELATED\nDOCUMENTS; APPROVING THE DRAFTS OF THE OTHER RELATED\nFINANCING DOCUMENTS; APPROVING THE NEGOTIATED SALE OF\nTHE CERTIFICATES TO THE UNDERWRITERS; AUTHORIZING THE\nPURCHASE OF A MUNICIPAL BOND INSURANCE POLICY; AND\nAPPROVING OTHER MATTERS IN CONNECTION THEREWITH.</p>\n<p>Location: \t\tSchool Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830</p>\n<p>Assistance:\tIf you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.</p>\n<p>Appeal Notice:\tNotice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.</p>\n<p>For further information about this public meeting, please contact Heather Jenkins, Associate Superintendent Chief Financial Officers, School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-457-4704. <br>\n<br>\nDated:\tMarch 11, 2026</p>\n<p>By: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary</p>\n<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl50_divTabs_2","title":"March 10, 2026 & March 24, 2026 - Notice of Public Hearing or Meeting","content":"NOTICE IS HEREBY GIVEN that the School Board of Polk County, Florida will hold a public meeting or hearing to which all persons are invited for the purpose of conducting regular business.<br>\n<br>\nDate/Time/Purpose: March 10, 2026, 9:00 A.M. Work Session <br>\nMarch 24, 2026, 12:30 P.M. Work Session<br>\nMarch 24, 2026, 5:00 P.M. Board Meeting<br>\n<br>\nLocation: School Board Auditorium, 1915 S. Floral Avenue, Bartow, FL 33830<br>\n<br>\nAssistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:\tNotice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal.<br>\n<br>\nFor further information about this meeting, please contact the Superintendent’s Office of the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0521.<br>\n<br>\nDated:  February 11, 2026<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest: Frederick R. Heid, Secretary<br>\n<br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl50_divTabs_3","title":"March 10, 2026 - Notice of Public Hearing or Meeting","content":"<span style=\"color: rgb(0, 0, 0);\">Notice is hereby given that the School Board of Polk County, Florida will hold a public meeting to which all persons are invited.<br>\n<br>\n<strong>Sales Tax Oversight Committee Meeting</strong><br>\n<br>\nDate/Time: March 10th, 2026, at 5:00 P.M.<br>\n<br>\nDiscussion: Half Penny Sales Tax Oversight<br>\n<br>\nLocation: Polk County School District<br>\nFacilities and Operations Building “C”<br>\n1915 South Floral Ave., Bartow, FL 33830<br>\n<br>\nAssistance: If you require any type of accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at 863-534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771.<br>\n<br>\nAppeal Notice:\tNotice is given with accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing.  Those making an appeal need to preserve a verbatim record of the proceedings at their own expense, usually with a court reporter.  The record must include the essential testimony and evidence required for any such appeal.  <br>\n<br>\nFor further information about this public meeting, please contact <strong>Joshua McLemore</strong>, Director, Facilities Planning for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620, ext. 489.<br>\n<br>\nDated:  February 26, 2026<br>\n<br>\nBy: Justin Sharpless, Board Chair<br>\nAttest:  Frederick R. Heid, Secretary</span><br>","active":false,"disabled":false},{"paneId":"ctl00_ContentPlaceHolder1_ctl50_divTabs_4","title":"March 3, 2026 - Notice of Public Hearing or Meeting ","content":"<span style=\"color: rgb(0, 0, 0);\">NOTICE IS HEREBY GIVEN that the School Board of Polk County will hold a public meeting or hearing to which all persons are invited. <br>\n<br>\nAttendance Boundary Committee Meeting<br>\n<br>\nDate/Time: March 3, 2026 at 5:30 P.M. <br>\n<br>\nLocation: School Board District Office <br>\nFacilities &amp; Operations Conference Room <br>\nBuilding C<br>\n1909 South Floral Avenue <br>\nBartow, FL  33830 <br>\n<br>\nAssistance: If you require any type of an accommodation because of a disability to participate in the public meeting or hearing, please call the Office of Compliance and ADA at (863) 534-0513.  If you are deaf or hard of hearing, please contact us by calling the Florida Relay Service at 1-800-955-8771. <br>\n<br>\nAppeal Notice: Notice is given in accordance with § 286.0105, Florida Statutes, that a record is required to appeal any decision the School Board makes at a public meeting or hearing. Those making an appeal need to preserve a verbatim record of the proceeding at their own expense, usually with a court reporter. The record must include the essential testimony and evidence required for any such appeal. <br>\n<br>\nFor further information about this public meeting, please contact Facilities &amp; Operations for the School Board of Polk County, Florida, P.O. Box 391, Bartow, Florida 33831, at 863-534-0620 ext. 886. <br>\n<br>\n<br>\nDated: February 24, 2026<br>\nBy: Justin Sharpless, Board Chair <br>\nAttest: Frederick R. Heid, Secretary <br>\n</span><br>","active":false,"disabled":false}],// required,
						propPaneId: 'paneId', // optional - pass in default value for demo purposes
