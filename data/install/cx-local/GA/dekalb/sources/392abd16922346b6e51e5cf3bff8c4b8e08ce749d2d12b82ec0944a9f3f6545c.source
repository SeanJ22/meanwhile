</div> 

</button>`; 

 

function addToBody(htmlContent) { 

  const temp = document.createElement('div'); 

  temp.innerHTML = htmlContent.replace(/>\s+</g, '><').trim(); 

  while (temp.firstChild) { 

    document.body.appendChild(temp.firstChild); 

  } 

} 

 

addToBody(customHtml); 

