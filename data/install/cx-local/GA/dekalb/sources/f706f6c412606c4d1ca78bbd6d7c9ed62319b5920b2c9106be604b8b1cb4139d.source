<script>
customHtml = `<iframe title="Polimorphic Chat" aria-label="Polimorphic Chat" frameborder="0" id="chatFrame" tabindex="-1" allow="geolocation" src="https://app.polimorphic.com/organizations/dekalb_county_ga.tucker/chat?windowClose=true" style="
    position: fixed;
    bottom: 90px;
    right: 90px;
    z-index: 10000000;
    border-radius: 8px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
    height: 0;
    width: 0;
    background: #ffffff;
"></iframe>
<div id="greetingText" style="color: #181B24; font-family: 'Montserrat', sans-serif; position: fixed; bottom: 130px; right: 20px; z-index: 1000000; border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 24px; visibility: visible; background: #FFFFFF; border: 2px solid #181B24; padding: 10px; cursor: pointer;" onclick="this.style.visibility='hidden';document.getElementById('chatButton').click()">
    How can I help you today?
</div>
<button onclick="const frame = document.getElementById('chatFrame');
const chatButton = document.getElementById('chatButton');
const chatIcon = document.getElementById('chatIcon');
const closeIcon = document.getElementById('closeIcon');
const greetingText = document.getElementById('greetingText');
var isMobile = window.matchMedia('(max-width: 768px)').matches;
if (chatButton.getAttribute('active') === 'false') {
  chatButton.setAttribute('active', 'true');
  frame.setAttribute('data-open', 'true');
  frame.removeAttribute('tabindex');
  frame.contentWindow.postMessage({ type: 'poli-chat-open' }, '*');
  if (isMobile) {
    frame.style.height = '100vh';
    frame.style.width = '100vw';
    frame.style.top = '0';
    frame.style.bottom = '';
    frame.style.right = '0';
    frame.style.left = '0';
    frame.style.borderRadius = '0';
    frame.style.boxShadow = 'none';
    chatButton.style.display = 'none';
  } else {
    frame.style.height = 'min(-100px + 100vh, 780px)';
    frame.style.width = 'min(100vw - 40px, 581px)';
    chatIcon.style.display = 'none';
    closeIcon.style.display = 'flex';
  }
  frame.focus();
  if (greetingText) {
    greetingText.style.visibility = 'hidden';
  }
} else {
  chatButton.setAttribute('active', 'false');
  frame.removeAttribute('data-open');
  frame.setAttribute('tabindex', '-1');
  frame.style.height = '0';
  frame.style.width = '0';
  frame.style.top = '';
  frame.style.bottom = '130px';
  frame.style.right = '20px';
  frame.style.left = '';
  frame.style.borderRadius = '8px';
  frame.style.boxShadow = '';
  chatIcon.style.display = 'flex';
  closeIcon.style.display = 'none';
  if (isMobile) {
    chatButton.style.display = 'flex';
  }
}" id="chatButton" class="poli-chat-embed-element" active="false" style="position: fixed; bottom: 60px; right: 20px;; z-index: 2147483647; background-color: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform 0.2s; transform: scale(1); pointer-events: auto; opacity: 1;" onmouseover="this.style.transform='scale(1.15)'" onmouseout="this.style.transform='scale(1)'" aria-label="Toggle chat">
    <div  id="chatIcon"  style="color: #181B24;
  background: #FFFFFF;
  border: 2px solid #181B24;
  min-width: 56px; width: 56px; height: 56px; min-height: 56px; border-radius: 50%;
  box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 12px;
  display: flex; justify-content: center; align-items: center;
  "><svg style="width: 24px; height: 24px; fill: #181B24; opacity: 1;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path fill="currentColor" d="M12 2C6.477 2 2 6.477 2 12c0 1.82.487 3.53 1.338 5L2 22l5-1.338C8.47 21.513 10.18 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.657 0-3.224-.393-4.615-1.088L4.5 19.5l.588-2.885C4.393 15.224 4 13.657 4 12c0-4.418 3.582-8 8-8s8 3.582 8 8-3.582 8-8 8z"></path>
      </svg></div>
      <div id="closeIcon" style="color: #181B24;
  background: #FFFFFF;
  border: 2px solid #181B24;
  min-width: 56px; width: 56px; height: 56px; min-height: 56px; border-radius: 50%;
  box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 12px;
  display: flex; justify-content: center; align-items: center;
   border-color: #181B24; display: none;">
      <svg style="width: 24px; height: 24px; fill: #181B24;  opacity: 1;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
      </svg>
      </div>
    </button>`
  function addToBody(htmlContent) {
    const temp = document.createElement('div');
    temp.innerHTML = htmlContent;
    const target = document.querySelector('main') || document.body;
    while (temp.firstChild) {
      target.appendChild(temp.firstChild);
    }
  }
  window.addEventListener("load", function () {
  addToBody(customHtml);
});
  //addToBody(customHtml);
  function applyMobileLayout(mobile) {
    var btn = document.getElementById('chatButton');
    var icn = document.getElementById('chatIcon');
    var gt = document.getElementById('greetingText');
    if (btn) btn.style.bottom = mobile ? '10px' : '20px';
    if (icn) {
      if (!icn.dataset.origW) { icn.dataset.origW = icn.style.width; icn.dataset.origH = icn.style.height; icn.dataset.origMinW = icn.style.minWidth; icn.dataset.origMinH = icn.style.minHeight; }
      icn.style.minWidth = mobile ? '40px' : icn.dataset.origMinW;
      icn.style.width = mobile ? '40px' : icn.dataset.origW;
      icn.style.height = mobile ? '40px' : icn.dataset.origH;
      icn.style.minHeight = mobile ? '40px' : icn.dataset.origMinH;
      var svgs = icn.querySelectorAll('svg');
      for (var i = 0; i < svgs.length; i++) {
        if (!svgs[i].style.width.includes('%')) {
          if (!svgs[i].dataset.origW) { svgs[i].dataset.origW = svgs[i].style.width; svgs[i].dataset.origH = svgs[i].style.height; }
          svgs[i].style.width = mobile ? '20px' : svgs[i].dataset.origW;
          svgs[i].style.height = mobile ? '20px' : svgs[i].dataset.origH;
        }
      }
    }
    if (gt) gt.style.bottom = mobile ? '60px' : '';
  }
  var mql = window.matchMedia('(max-width: 768px)');
  if (mql.matches) applyMobileLayout(true);
  mql.addEventListener('change', function(e) {
    applyMobileLayout(e.matches);
    var frame = document.getElementById('chatFrame');
    var chatBtn = document.getElementById('chatButton');
    var chatIcn = document.getElementById('chatIcon');
    var closeIcn = document.getElementById('closeIcon');
    if (chatBtn && chatBtn.getAttribute('active') === 'true') {
      if (e.matches) {
        frame.style.height = '100vh'; frame.style.width = '100vw';
        frame.style.top = '0'; frame.style.bottom = ''; frame.style.right = '0'; frame.style.left = '0';
        frame.style.borderRadius = '0'; frame.style.boxShadow = 'none';
        chatBtn.style.display = 'none';
        chatIcn.style.display = 'flex'; closeIcn.style.display = 'none';
      } else {
        frame.style.height = 'min(-100px + 100vh, 780px)';
        frame.style.width = 'min(100vw - 40px, 581px)';
        frame.style.top = '';
        frame.style.bottom = '90px';
        frame.style.right = '20px';
        frame.style.left = '';
        frame.style.borderRadius = '8px';
        frame.style.boxShadow = '';
        chatBtn.style.display = 'flex';
        chatIcn.style.display = 'none'; closeIcn.style.display = 'flex';
      }
    }
  });
  window.addEventListener('message', function(event) {
    if (event.data && event.data.type === 'poli-chat-close') {
      var btn = document.getElementById('chatButton');
      if (btn && btn.getAttribute('active') === 'true') {
        btn.click();
      }
    }
  });
</script>


