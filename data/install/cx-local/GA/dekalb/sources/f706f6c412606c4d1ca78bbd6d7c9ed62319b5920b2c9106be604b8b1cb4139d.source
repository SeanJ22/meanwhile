	$(document).ready(function() {
    $("#input_6_9, #input_6_6, #input_6_3_3, #input_6_3_6").keypress(function(e) {
        const key = e.key;

        if (this.id === "input_6_6") {
            // Allow letters, numbers, special characters, and spaces for #input_6_6
            if (!/^[a-zA-Z0-9!@#$%^&*(),.?":{}|<>_+\-\s]$/.test(key)) {
                e.preventDefault();
            }
        } else if (this.id === "input_6_9") {
            // Allow letters, numbers, special characters, and spaces for #input_6_9
            if (!/^[a-zA-Z0-9!@#$%^&*(),.?":{}|<>_+\-\s]$/.test(key)) {
                e.preventDefault();
            }
        } else {
            // Allow letters, numbers, and special characters (excluding spaces) for other fields
            if (!/^[a-zA-Z0-9!@#$%^&*(),.?":{}|<>_+\-]$/.test(key)) {
                e.preventDefault();
            }
        }
    });
});

$(document).ready(function () {
    $("#input_6_6").keydown(function (e) {
        // Check if Shift+Enter is pressed
        if (e.key === "Enter") {
            // Allow Shift+Enter to create a new line
            const cursorPos = this.selectionStart;
            const textBefore = this.value.substring(0, cursorPos);
            const textAfter = this.value.substring(cursorPos);

            // Insert a newline character at the cursor position
            this.value = textBefore + "\n" + textAfter;
            this.selectionStart = this.selectionEnd = cursorPos + 1;

            // Prevent the default action of Enter
            e.preventDefault();
        } else if (e.key === "Enter") {
            // Prevent normal Enter key behavior (if needed)
            e.preventDefault();
        }
    });
});




