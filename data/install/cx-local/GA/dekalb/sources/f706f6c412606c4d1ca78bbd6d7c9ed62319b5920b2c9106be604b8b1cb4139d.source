<script>
	(function($, window) {
		var adjustAnchor = function() {

			var $anchor = $(':target'),
				fixedElementHeight = 150;

			if ($anchor.length > 0) {

				$('html, body')
					.stop()
					.animate({
						scrollTop: $anchor.offset().top - fixedElementHeight
					}, 200);

			}

		};

		$(window).on('hashchange load', function() {
			adjustAnchor();
		});

	})(jQuery, window);
</script>
<script>
	$(document).ready(function() {
		//$("button.fc-next-button").wrapInner("<strong>Next Month</strong>");
		$("<strong>Next Month</strong>").insertBefore(".fc-next-button");
		$("<strong>Last Month</strong>").insertAfter(".fc-prev-button");
		$('.simple_list_col a').on('click', function(event) {
        var targetId = $(this).attr('href');

       
        if (targetId.startsWith('#') && $(targetId).length) {
            event.preventDefault();

            var fixedElementHeight = 150;

            $('html, body').stop().animate({
                scrollTop: $(targetId).offset().top - fixedElementHeight
            }, 200); 
        }
    });
	});
</script>

<script>
	// Number inputs without a maxlength attribute report maxLength as -1.
	// Comparing against that sliced off the last digit, so time fields could not be filled in.
	$(document).on('input', 'input[type="number"]', function() {
		var maxLength = parseInt(this.getAttribute('maxlength'), 10);
		if (maxLength > 0 && this.value.length > maxLength) {
			this.value = this.value.slice(0, maxLength);
		}
	});
</script>

