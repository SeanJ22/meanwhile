<script>
$(document).ready(function() {
    $("#input_6_4_1, #input_6_4_2, #input_6_4_3").keypress(function(e) {
        // Get the key pressed
        const key = e.key;

        // Allow letters (a-z, A-Z), numbers (0-9), and all special characters including +, -, and _
        if (!/^[a-zA-Z0-9!@#$%^&*(),.?":{}|<>_+\-\s]$/.test(key)) {
            e.preventDefault();
        }
    });

	
	const headings = document.querySelectorAll("h1, h2, h3, h4, h5, h6");
	let lastLevel = 0;
	headings.forEach((heading) => {
	const currentLevel = parseInt(heading.tagName.substring(1));

	if (lastLevel && currentLevel > lastLevel + 1) {
		// Insert missing levels
		for (let i = lastLevel + 1; i < currentLevel; i++) {
		const hiddenHeading = document.createElement("h" + i);
		hiddenHeading.textContent = "Section heading"; // Replace with meaningful text
		hiddenHeading.classList.add("sr-only"); // Use sr-only class
		heading.parentNode.insertBefore(hiddenHeading, heading);
		}
	}

	lastLevel = currentLevel;
	});

});


function makeIframesAccessible(context = document) {

    context.querySelectorAll("iframe").forEach(function (iframe, index) {

        // Add title if missing
        if (
            !iframe.hasAttribute("title") ||
            iframe.getAttribute("title").trim() === ""
        ) {
            iframe.setAttribute(
                "title",
                `Embedded content ${index + 1}`
            );
        }

        // Add aria-label if missing
        if (
            !iframe.hasAttribute("aria-label") ||
            iframe.getAttribute("aria-label").trim() === ""
        ) {
            iframe.setAttribute(
                "aria-label",
                iframe.getAttribute("title")
            );
        }

    });
}

// Initial page load
document.addEventListener("DOMContentLoaded", function () {
    makeIframesAccessible();
});

// Dynamic / AJAX / lazy-loaded iframes
const iframeObserver = new MutationObserver(function (mutations) {

    mutations.forEach(function (mutation) {

        mutation.addedNodes.forEach(function (node) {

            if (node.nodeType !== 1) return;

            // Direct iframe
            if (node.tagName === "IFRAME") {
                makeIframesAccessible(node.parentNode || document);
            }

            // Nested iframes inside added content
            if (node.querySelectorAll) {
                makeIframesAccessible(node);
            }

        });

    });

});

iframeObserver.observe(document.body, {
    childList: true,
    subtree: true
});




/* ==========================================
   MAIN WRAPPER 1
========================================== */

document.addEventListener("DOMContentLoaded", function () {

  /*
  ==========================================
  1. FIX DATEPICKER BUTTON ACCESSIBLE NAME
  ==========================================
  */

  document.querySelectorAll('.tribe-events-c-top-bar__datepicker-button')
    .forEach((btn) => {

      let visibleText = btn.textContent.trim();

      if (visibleText) {
        btn.setAttribute("aria-label", visibleText);
        btn.setAttribute("title", visibleText);
      } else {
        btn.setAttribute("aria-label", "Open datepicker");
      }

    });


  /*
  ==========================================
  2. FIX EMPTY LINKS (SAFE VERSION)
  ==========================================
  */

  document.querySelectorAll("a").forEach((link) => {

    let text = link.textContent.trim();

	if (link.classList.contains("advgb-image-overlay")) return;

    // ✅ If visible text exists → DO NOTHING
    if (text) return;

    let imgAlt = link.querySelector("img")?.getAttribute("alt")?.trim();

    // Only for icon/image-only links
    let label = imgAlt || "Read more";

    if (!link.getAttribute("aria-label")) {
      link.setAttribute("aria-label", label);
    }

  });


  /*
  ==========================================
  3. FIX ADD EVENT CALENDAR BUTTONS
  ==========================================
  */

  document.querySelectorAll(".addeventatc.addtocal")
    .forEach((el) => {

      el.removeAttribute("role");
      el.removeAttribute("aria-expanded");

      el.setAttribute("tabindex", "0");

      if (!el.getAttribute("aria-label")) {
        el.setAttribute("aria-label", "Add event to calendar");
      }

      el.querySelectorAll(
        'a, button, input, select, textarea, [tabindex]'
      ).forEach((child) => {

        if (child !== el) {
          child.setAttribute("tabindex", "-1");
        }

      });

    });


  /*
  ==========================================
  4. FIX BUTTONS WITHOUT ACCESSIBLE TEXT
  ==========================================
  */

  document.querySelectorAll("button").forEach((btn) => {

    let text = btn.textContent.trim();

    if (!text) return;

    let aria = btn.getAttribute("aria-label");

    if (!aria || !aria.includes(text)) {
      btn.setAttribute("aria-label", text);
    }

  });


  /*
  ==========================================
  5. FIX TINYMCE TOOLBAR BUTTONS
  (discernible text + interactive controls nested inside each other)
  ==========================================
  */

  function fixTinyMCEToolbar(root) {

    (root || document).querySelectorAll(".mce-widget.mce-btn").forEach((wrapper) => {

      let innerBtn = wrapper.querySelector('button[role="presentation"]');

      if (!innerBtn) return;

      let label = wrapper.getAttribute("aria-label");

      if (!label) {
        let icon = innerBtn.querySelector('i[class*="mce-i-"]');
        let iconClass = icon
          ? [...icon.classList].find((c) => c.indexOf("mce-i-") === 0)
          : null;

        label = iconClass
          ? iconClass.replace("mce-i-", "").replace(/[-_]/g, " ")
          : "Toolbar option";
      }

      // Demote the wrapper so it is no longer a second, nested
      // interactive control - the real <button> below carries focus
      // and the accessible name.
      wrapper.removeAttribute("role");
      wrapper.removeAttribute("tabindex");
      wrapper.removeAttribute("aria-pressed");
      wrapper.removeAttribute("aria-label");
      wrapper.removeAttribute("aria-haspopup");

      innerBtn.removeAttribute("role");
      innerBtn.removeAttribute("tabindex");
      innerBtn.setAttribute("aria-label", label);

    });

  }

  fixTinyMCEToolbar();

  const tinymceObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      mutation.addedNodes.forEach((node) => {
        if (node.nodeType !== 1) return;
        if (node.matches && node.matches(".mce-widget.mce-btn")) {
          fixTinyMCEToolbar(node.parentNode || document);
        } else if (node.querySelectorAll) {
          fixTinyMCEToolbar(node);
        }
      });
    });
  });

  tinymceObserver.observe(document.body, {
    childList: true,
    subtree: true
  });


  /*
  ==========================================
  6. OBSERVER FOR DYNAMIC CONTENT (SAFE)
  ==========================================
  */

  function fixDynamicLinks() {

    document.querySelectorAll("a").forEach((link) => {

      let aria = link.getAttribute("aria-label");
      let text = link.textContent.trim();

	  if (link.classList.contains("advgb-image-overlay")) return;


      if (!aria && !text) {
        let imgAlt = link.querySelector("img")?.getAttribute("alt")?.trim();
        if (imgAlt) {
          link.setAttribute("aria-label", imgAlt);
        } else {
          link.setAttribute("aria-label", "Read more");
        }
      }

    });

  }

  const observer = new MutationObserver(() => {
    fixDynamicLinks();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

});


/* ==========================================
   MAIN WRAPPER 2
========================================== */

document.addEventListener("DOMContentLoaded", function () {

  document.querySelectorAll("a[aria-label], button[aria-label]")
    .forEach(el => {

      let visibleText = el.innerText
        .replace(/\s+/g, " ")
        .trim();

      if (!visibleText) return;

      let aria = (el.getAttribute("aria-label") || "")
        .replace(/\s+/g, " ")
        .trim();

      // only set if missing
      if (!aria) {
        el.setAttribute("aria-label", visibleText);
        return;
      }

      // log mismatch only (no overwrite)
      if (!aria.toLowerCase().includes(visibleText.toLowerCase())) {
        console.warn("Accessibility mismatch:", el, {
          visibleText,
          aria
        });
      }

    });

});


/* ==========================================
   MAIN WRAPPER 3
========================================== */

document.addEventListener("DOMContentLoaded", function () {

  document.querySelectorAll(".navbar-brand").forEach(el => {

    let visibleText = el.innerText
      .replace(/\s+/g, " ")
      .trim();

    if (visibleText) {
      el.setAttribute("aria-label", visibleText);
      el.setAttribute("title", visibleText);
    }

    let img = el.querySelector("img");

    if (img) {
      img.setAttribute("alt", "");
      img.setAttribute("aria-hidden", "true");
    }

  });

});


