            fill: #fff;
        }

        .cls-4, .cls-6 {
            stroke-miterlimit: 6.9;
        }

        .cls-6 {
            fill: #2e2e76;
            stroke-width: .61px;
        }

        .cls-6, .cls-7 {
            fill-rule: evenodd;
            stroke: #fff;
        }

