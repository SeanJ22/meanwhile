        <style type="text/css">
            body { background: #f1f1f1; }
            
            a { color: #00566b; }
            a:hover { color: #003744; }
            
            .candidate-img {
                max-width: 300px;
                width: 100%;
                height: auto;
            }

            .group-heading {
                text-transform: uppercase;
                padding-bottom: 5px;
            }

            .party-heading {
                /* color: #749fb7; */
                color: #ffffff;
            }

            .contest {
                margin-top: 10px;
                margin-bottom: 25px;
            }
            
            .header-container {
                border-top: 9px solid #3a5289;
                background: #fff url(https://voterguide.hawaii.gov/wp-content/themes/hawaii-elections/assets/images/background.jpg) no-repeat top left;
                border-bottom: 3px solid #eee;
            }

            .header-container .logo {
                padding: 1rem;
                border-top: 9px solid #c73834;
                margin-top: -9px;
            }

            .header-container .tagline {
                color: #79482a;
                font-size: 0.875em;
                text-shadow: 0 1px 0 rgba(255,255,255,.9);
            }

            .header-container h2.title {
                font-size: 1em;
                color: #00566b;
                font-weight: 700;
            }

            .header-container h2.title a {
                color: #00566b;
                font-weight: 700;
                text-decoration: none;
            }

            .header-container .navbar .btn-primary {
                background-color: #3a5289;
                border-color: #3a5289;
            }

            .header-container .navbar .btn-primary:hover {
                background-color: #233050;
                border-color: #233050;
            }

            #navbarSupportedContent ul.navbar-nav {
                border-top: 1px solid #ccc;
            }

            .waves-container {
                background: url(https://voterguide.hawaii.gov/wp-content/themes/hawaii-elections/assets/images/background-waves.jpg) no-repeat top center;
                background-size: cover;
            }

            .waves-container .btn-info {
                background-color: #c73834;
                border-color: #c73834;
            }

            .waves-container .btn-info:hover {
                background-color: #932926;
                border-color: #932926;
            }

            .contest-group .group-heading { color: #0172c2; }

            .contest-group .accordion h6 { font-weight: bold; }
            
            .accordion-button {
                display: inline-block !important;
                padding-right: 2.25em !important;
            }

            .accordion-button:after {
                position: absolute;
                top: 40%;
                right: 1em;
            }

            @media (min-width: 768px) {
                .header-container .logo { padding: 2rem; }
                .header-container .tagline { font-size: 1em; }
                .header-container h2.title { font-size: 1.5rem; }
                .accordion-button {
                    display: flex !important;
                    padding: var(--bs-accordion-btn-padding-y) var(--bs-accordion-btn-padding-x) !important;
                }

                .accordion-button:after { position: static; }
            }

            @media (min-width: 992px) {
                .header-container { border-bottom: 0; }
                .header-container h2.title { font-size: 2rem; }
                #navbarSupportedContent ul.navbar-nav { border-top: 0; }
            }
        </style>
    </head>
