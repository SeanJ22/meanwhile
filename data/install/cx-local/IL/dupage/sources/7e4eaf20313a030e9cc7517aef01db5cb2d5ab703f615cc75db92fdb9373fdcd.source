<div id="hs_cos_wrapper_module_1666036531357" class="hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module" style="" data-hs-cos-general-type="widget" data-hs-cos-type="module">
	<div id="" class="atmc-accordion-03  sr-invisible fadeInBottom ">
		<button type="button" class="atmc-h4 atmc-accordion-03_trigger">
			
			
			<span class="accordion_heading" id="module_1666036531357">
			  <span class="heading_text">Biography</span>
        
      </span>
			
			<span class="atmc-accordion-03_icon atmc-icon-gray"><svg version="1.0" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 448 512" aria-hidden="true"><g id="chevron-up19_layer"><path d="M240.971 130.524l194.343 194.343c9.373 9.373 9.373 24.569 0 33.941l-22.667 22.667c-9.357 9.357-24.522 9.375-33.901.04L224 227.495 69.255 381.516c-9.379 9.335-24.544 9.317-33.901-.04l-22.667-22.667c-9.373-9.373-9.373-24.569 0-33.941L207.03 130.525c9.372-9.373 24.568-9.373 33.941-.001z" /></g></svg></span>
		</button>
		<div class="atmc-accordion-03_answer" aria-labelledby="module_1666036531357" style="display:none;"><form method="post" action="https://www.dupageforest.org/About_Us/Board_of_Commissioners/Commissioners/Commissioner_Marsha_Murphy_%E2%80%94_District_1.aspx">
<div id="shadow">
<div id="siteWrapper">
<div id="mainWrapper">
<div id="mainWrapperInner">
<div id="contentWrapper">
<div id="content">
<div id="contentMain">
<div id="ctl00_contentAreaPlaceHolder_contentMainInner">
<div id="ctl00_contentAreaPlaceHolder_ContentBlock1">
<div id="ContentAreaWrapper" xmlns:cms="urn:Ektron.Cms.Controls">
<div id="shadow">
<div id="siteWrapper">
<div id="mainWrapper">
<div id="mainWrapperInner">
