	</header>
	<div class="widgetBody  cpGrid cpGrid1 ">
		<div class="row  wide">
					<div class="col col1 first last">
						<ol class="pageStyles semanticList">

<li class="InfoAdvanced widgetItem fr-view">
	<h3 style="margin:0px; line-height:1;"><strong>Upcoming Election</strong><br><div style="margin-left:20px;line-height:125%;"><a href="/4138">November 3, 2026 - General Election</a></div><input type="hidden" name="hfElecDate" id="hfElecDate" value="11/3/2026"></h3>
</li>						</ol>
					</div>
		</div>
	</div>
	<div class="widgetFooter">

	</div>

	</section>



<script type="text/javascript">
	//Render slideshow if info advacned items contain one.
	$(document).ready(function (e) {
