	});
</script>
</div>

	</div> <!-- inner column -->

	</div> <!-- inner row -->

			</div><!-- outer column --><!----><div class="outer col col8 last" style="" data-widgetcontainerid="059e13d0-2965-4723-9edc-56c86c621d5c">				
	<div class="row nest first last wide">
	
	<div class="inner col col8 first last id98f4d096-1ea7-4e27-b3d8-a32aad3a465b" style="" data-widgetcontainerid="98f4d096-1ea7-4e27-b3d8-a32aad3a465b">	
<div class="widget editor pageStyles narrow" id="divEditor31a8174c-a635-42c2-913b-37a12a2ae553" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <table class="telerik-reTable-2" style="width: 100%; text-align: center;"><thead><tr class="telerik-reTableHeaderRow-2" width="30%"><th class="subhead2" style="text-align: center;"><strong><span style="color: rgb(255, 255, 255);">Voting Options</span></strong></th></tr></thead><tbody><tr class="telerik-reTableOddRow-2" width="30%"><td class="telerik-reTableEvenCol-2 " style="background-color: rgb(245, 245, 245);"><h3 class="subhead2">Vote by Mail</h3><ul><li><a href="/DocumentCenter/View/86530/USPS-Election-Announcement" target="_blank" class="docaccess-activated" data-docaccess-source-url="https://www.lakecountyil.gov/DocumentCenter/View/86530/USPS-Election-Announcement" data-url-hash="ed395dbd5c3fde6343eae323f8a41429ac57ecdd3fafa61f2130bd1df54c8caf" data-url-status="disabled">USPS Vote by Mail Guidance</a></li><li>We encourage any voter to vote by mail and avoid lines during early voting or on Election Day. Feel safe in the comfort of your own home and vote from there.</li><li><a class="Hyperlink" href="/351/Voter-Power-for-Registered-Voters" target="_self">Request a ballot or track your request</a></li><li><a aria-label="Receive notifications about your ballot request Opens in new window" class="Hyperlink" href="https://lakecountyil.ballottrax.net/voter/" target="_blank">Receive notifications about your ballot request</a></li><li><a class="Hyperlink docaccess-activated" href="/DocumentCenter/View/36233/" data-docaccess-source-url="https://www.lakecountyil.gov/DocumentCenter/View/36233/" data-url-hash="3da440fe01519293bc9563d9b85d17cb21152a86f0872c12a975d4f6725203af" data-url-status="disabled">County-wide Drop Box locations</a></li></ul><h3 class="subhead2">Early Voting at the Lake County Clerk&apos;s Office</h3><ul><li>Sept 24 to Oct 16, 2026</li><li>Weekdays from 9 AM to 5 PM</li><li>18 N. County St., Waukegan</li><li><a class="Hyperlink" href="/5175/Early-Voting-Site-Wait-Times">Early Voting Wait Times</a></li></ul><h3 class="subhead2">Early Voting County-wide</h3><ul><li>Oct 19 to Nov 2, 2026</li><li><a class="Hyperlink docaccess-activated" href="/DocumentCenter/View/13400" data-docaccess-source-url="https://www.lakecountyil.gov/DocumentCenter/View/13400" data-url-hash="6d6a96ec11afbc52d7d38cf059cbd06ea67591b615c83aa663dc7431a4184d4f" data-url-status="disabled">Early voting sites</a> throughout Lake County</li><li>Evening and weekend hours available</li><li><a class="Hyperlink" href="https://maps.lakecountyil.gov/EarlyVotingSites/" target="_self">Early Voting site locator</a></li><li style="display:none;"><a class="Hyperlink" href="/5175/Early-Voting-Site-Wait-Times">Early Voting Wait Times</a></li><li style="display:none;"><a class="Hyperlink" href="/5239/Unofficial-Early-Voting-Turnout">Unofficial Election Turnout</a></li></ul><h3 class="subhead2">Election Day</h3><ul><li>Nov 3, 2026</li><li>Polls are open 6 AM to 7 PM</li><li>Vote at any voting site in Lake County. <a class="Hyperlink" href="/351/Voter-Power-for-Registered-Voters" target="_self">Check Voter Power</a> for the preferred site for your address</li><li><a aria-label="Election Day voting site locator Opens in new window" class="Hyperlink" href="https://maps.lakecountyil.gov/electiondaypollingplaces/" target="_blank">Election Day voting site locator</a></li><li><a class="Hyperlink docaccess-activated" href="/DocumentCenter/View/13749" target="_self" data-docaccess-source-url="https://www.lakecountyil.gov/DocumentCenter/View/13749" data-url-hash="9dfc1c6901518dd65b7a556c57e995678076db6510d194777aa5ec8d00a5ee8a" data-url-status="disabled">Voting Sites throughout Lake County</a></li><li style="display:none;"><a class="Hyperlink" href="/5207/Election-Day-Polling-Site-Wait-Times">Election Day Polling Site Wait Times</a></li></ul><p><span class="subhead2"><a class="Hyperlink" href="/4329/Hospitalized-or-Nursing-Home-Voter" target="_self">Hospitalized or Nursing Home Voter</a></span><br><br><span class="subhead2"><a class="Hyperlink" href="/4331/MilitaryOverseas-Voter" target="_self">Military/Overseas Voter</a></span><br><br><span class="subhead2"><a class="Hyperlink docaccess-activated" href="/DocumentCenter/View/786/Pollwatcher-Guide-PDF" target="_self" data-docaccess-source-url="https://www.lakecountyil.gov/DocumentCenter/View/786/Pollwatcher-Guide-PDF" data-url-hash="archived" data-url-status="archived">Pollwatcher Guide</a></span><br>Lake County Clerk&apos;s brochure describing the qualifications and responsibilities of a pollwatcher.</p></td></tr></tbody></table>
    </div>

