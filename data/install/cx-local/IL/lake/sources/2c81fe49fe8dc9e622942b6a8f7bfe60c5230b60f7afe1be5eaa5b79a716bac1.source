	<div class="row nest last wide">
	
	<div class="inner col col8 first last id9da27657-d3aa-4606-b4be-ef5b38400426" style="" data-widgetcontainerid="9da27657-d3aa-4606-b4be-ef5b38400426">	
 
	<div data-widget-id='15984e6a-210d-41b9-8573-6313511cbde8' data-moduleName="customHtml" id='widgetCustomHtml15984e6a-210d-41b9-8573-6313511cbde8' class="widget widgetCustomHtml skin63 narrow" >
	<div class="widgetBody pageStyles" id="widgetBody15984e6a-210d-41b9-8573-6313511cbde8">
		<div id="customHtml15984e6a-210d-41b9-8573-6313511cbde8"><div><iframe style="display:block;" title="Page Viewer" frameborder="0" width="100%" height="200" src="https://apps03.lakecountyil.gov/countyclerk/elections/voterpower/sampleballot.aspx"></iframe></div></div>
