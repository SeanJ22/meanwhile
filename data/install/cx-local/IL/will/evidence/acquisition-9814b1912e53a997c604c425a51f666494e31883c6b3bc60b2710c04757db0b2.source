v> 
<script>
(function () {
'use strict';
const header    = document.getElementById('fwr-header');
const drawer    = document.getElementById('fwr-mobile-drawer');
const hamburger = document.getElementById('fwr-hamburger');
const spacer    = document.getElementById('fwr-header-spacer');
const dateEl    = document.getElementById('fwr-today-date');
if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-US', {
weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
});
function measureAndPosition() {
const h     = header.getBoundingClientRect().height;
const top   = parseInt(getComputedStyle(header).top) || 0;
const total = top + h;
spacer.style.height    = total + 'px';
drawer.style.top       = total + 'px';
drawer.style.maxHeight = (window.innerHeight - total) + 'px';
}
measureAndPosition();
window.addEventListener('resize', measureAndPosition);
window.addEventListener('scroll', () => {
header.classList.toggle('scrolled', window.scrollY > 10);
}, { passive: true });
hamburger.addEventListener('click', () => {
const isOpen = drawer.classList.toggle('open');
header.classList.toggle('mob-open', isOpen);
hamburger.setAttribute('aria-expanded', String(isOpen));
document.body.style.overflow = isOpen ? 'hidden' : '';
});
function closeDrawer() {
drawer.classList.remove('open');
header.classList.remove('mob-open');
hamburger.setAttribute('aria-expanded', 'false');
document.body.style.overflow = '';
}
drawer.addEventListener('click', e => { if (e.target.tagName === 'A') closeDrawer(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
document.addEventListener('click', e => {
if (!header.contains(e.target) && !drawer.contains(e.target)) closeDrawer();
});
})();
</script>
</div> </div> </div> </div> </div> </div> </div> </header> <div id="fl-main-content" class="fl-page-content" itemprop="mainContentOfPage" role="main"> <div class="fl-builder-content fl-builder-content-6753 fl-builder-global-templates-locked" data-post-id="6753"><div class="fl-row fl-row-fixed-width fl-row-bg-none fl-node-p6gcvu9xosnd fl-row-default-height fl-row-align-center" data-node="p6gcvu9xosnd"> <div class="fl-row-content-wrap"> <div class="fl-row-content fl-row-fixed-width fl-node-content"> <div class="fl-col-group fl-node-85u310avjs7l" data-node="85u310avjs7l"> <div class="fl-col fl-node-jpd3gsmt2y8a fl-col-bg-color" data-node="jpd3gsmt2y8a"> <div class="fl-col-content fl-node-content"><div class="fl-module fl-module-widget fl-node-vy2bsa0x1j89" data-node="vy2bsa0x1j89"> <div class="fl-module-content fl-node-content"> <div class="fl-widget"> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class="fl-row fl-row-fixed-width fl-row-bg-none fl-node-sela5qt0miun fl-row-default-height fl-row-align-center" data-node="sela5qt0miun"> <div class="fl-row-content-wrap"> <div class="fl-row-content fl-row-fixed-width fl-node-content"> <div class="fl-col-group fl-node-8u6ngdwxorv3" data-node="8u6ngdwxorv3"> <div class="fl-col fl-node-07htalyzgp8e fl-col-bg-color" data-node="07htalyzgp8e"> <div class="fl-col-content fl-node-content"><div class="fl-module fl-module-widget fl-node-8l9f14dkmnbs" data-node="8l9f14dkmnbs"> <div class="fl-module-content fl-node-content"> <div class="fl-widget"> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class="fl-row fl-row-fixed-width fl-row-bg-none fl-node-5i0c1tdxgylk fl-row-default-height fl-row-align-center" data-node="5i0c1tdxgylk"> <div class="fl-row-content-wrap"> <div class="fl-row-content fl-row-fixed-width fl-node-content"> <div class="fl-col-group fl-node-4yca25g3pwsb" data-node="4yca25g3pwsb"> <div class="fl-col fl-node-8px3emfzq071 fl-col-bg-color" data-node="8px3emfzq071"> <div class="fl-col-content fl-node-content"><div class="fl-module fl-module-heading fl-node-f6mdsokw02y7" data-node="f6mdsokw02y7"> <div class="fl-module-content fl-node-content"> <h2 class="fl-heading"> <span class="fl-heading-text">Will County Specimen Ballot 2026</span> </h2> </div> </div> <div class="fl-module fl-module-pp-image fl-node-2mkazdjbxoew" data-node="2mkazdjbxoew"> <div class="fl-module-content fl-node-content"> <div class="pp-photo-container"> <div class="pp-photo pp-photo-align-center pp-photo-align-responsive-default" itemscope itemtype="http://schema.org/ImageObject"> <div class="pp-photo-content"> <div class="pp-photo-content-inner"> <img loading="lazy" decoding="async" class="pp-photo-img wp-image-6756 size-full" src="https://fwrnews.com/wp-content/uploads/Legal-Notice-Logo.2.jpeg" alt="Legal notice icon" itemprop="image" height="576" width="1000" srcset="https://fwrnews.com/wp-content/uploads/Legal-Notice-Logo.2.jpeg 1000w, https://fwrnews.com/wp-content/uploads/Legal-Notice-Logo.2-300x173.jpeg 300w, https://fwrnews.com/wp-content/uploads/Legal-Notice-Logo.2-768x442.jpeg 768w" sizes="(max-width: 1000px) 100vw, 1000px" title="Legal notice icon" /> <div class="pp-overlay-bg"></div> </div> </div> </div> </div> </div> </div> <div class="fl-module fl-module-fl-post-content fl-node-xc218ghiou09" data-node="xc218ghiou09"> <div class="fl-module-content fl-node-content"> <p>NOTICE IS HEREBY GIVEN of the names of office, candidates and public questions on the November 3, 2026 General Election ballots.</p> <p>FOR UNITED STATES SENATOR<br /> (Vote for one)<br /> Don Tracy (Republican)<br /> Juliana Stratton (Democratic)<br /> Whitfield Harrington Jr (American Center Party)</p> <p>FOR GOVERNOR AND LIEUTENANT GOVERNOR<br /> (Vote for one)<br /> Darren Bailey / Aaron B. Del Mar (Republican)<br /> JB Pritzker / Christian Mitchell (Democratic)<br /> Collin Corbett / Carolyn Schofield (Independent)<br /> Write-In</p> <p>FOR ATTORNEY GENERAL<br /> (Vote for one)<br /> Robert W. Fioretti (Republican)<br /> Kwame Raoul (Democratic)</p> <p>FOR SECRETARY OF STATE<br /> (Vote for one)<br /> Diane M. Harris (Republican)<br /> Alexi Giannoulias (Democratic)</p> <p>FOR COMPTROLLER<br /> (Vote for one)<br /> Bryan Drew (Republican)<br /> Margaret Croke (Democratic)<br /> Write-In</p> <p>FOR TREASURER<br /> (Vote for one)<br /> Max Solomon (Republican)<br /> Michael W. Frerichs (Democratic)<br /> Write-In</p> <p>FOR REPRESENTATIVE IN CONGRESS<br /> 1st CONGRESSIONAL DISTRICT<br /> (Vote for one)<br /> Christian Maxwell (Republican)<br /> Jonathan L. Jackson (Democratic)</p> <p>FOR REPRESENTATIVE IN CONGRESS<br /> 2nd CONGRESSIONAL DISTRICT<br /> (Vote for one)<br /> Michael Scott Noack (Republican)<br /> Donna Miller (Democratic)</p> <p>FOR REPRESENTATIVE IN CONGRESS<br /> 11th CONGRESSIONAL DISTRICT<br /> (Vote for one)<br /> Jeff Walter (Republican)<br /> Bill Foster (Democratic)</p> <p>FOR REPRESENTATIVE IN CONGRESS<br /> 14th CONGRESSIONAL DISTRICT<br /> (Vote for one)<br /> James T. “Jim” Marter (Republican)<br /> Lauren Underwood (Democratic)</p> <p>FOR STATE SENATOR 14th LEGISLATIVE DISTRICT<br /> Brian Skala (Republican)<br /> Emil Jones, III (Democratic)</p> <p>FOR STATE SENATOR 15th LEGISLATIVE DISTRICT<br /> No Candidate (Republican)<br /> Napoleon B. Harris III (Democratic)</p> <p>FOR STATE SENATOR 17th LEGISLATIVE DISTRICT<br /> (Vote for one)<br /> Frederick L. Walls (Republican)<br /> Elgie R. Sims, Jr. (Democratic)</p> <p>FOR STATE SENATOR 21st LEGISLATIVE DISTRICT<br /> Julie Berkowicz (Republican)<br /> Laura Ellman (Democratic)</p> <p>FOR STATE SENATOR 38th LEGISLATIVE DISTRICT<br /> Sue Rezin (Republican)<br /> Ernie R. Marcelain (Democratic)</p> <p>FOR STATE SENATOR 41st LEGISLATIVE DISTRICT<br /> (Vote for one)<br /> John Curran (Republican)<br /> No Candidate (Democratic)<br /> FOR STATE SENATOR 42nd LEGISLATIVE DISTRICT<br /> (Vote for one)<br /> Edgardo “Eddie” Perez (Republican)<br /> Jared Ploger (Democratic)</p> <p>FOR STATE SENATOR 53rd LEGISLATIVE DISTRICT<br /> (Vote for one)<br /> Chris Balkema (Republican)<br /> No Candidate (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 27th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> No Candidate (Republican)<br /> Justin Q. Slaughter (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 29th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> No Candidate (Republican)<br /> Thaddeus Jones (Democratic)<br /> Write-In</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 34th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> No Candidate (Republican)<br /> Cleopatra “Cleo” Cowley (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 37th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Patrick Sheehan (Republican)<br /> No Candidate (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 38th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> No Candidate (Republican)<br /> Debbie Meyers-Martin (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 41st REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Ajay Gupta (Republican)<br /> Janet Yang Rohr (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 75th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Jed Davis (Republican)<br /> Caroline McCree (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 79th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Jackie Haas (Republican)<br /> No Candidate (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 80th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Adam M. Beaty (Republican)<br /> Anthony DeLuca (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 82nd REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Nicole La Ha (Republican)<br /> No Candidate (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 84th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Brian Scopa (Republican)<br /> Saba Haider (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 85th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Chris Metcalfe (Republican)<br /> Dagmara “Dee” Avelar (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 86th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> No Candidate (Republican)<br /> Lawrence “Larry” M. Walsh, Jr. (Democratic)<br /> FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 97th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Gabby Shanahan (Republican)<br /> Jessica Dixon Heitman (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 98th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Nona Parker (Republican)<br /> Natalie A. Manley (Democratic)</p> <p>FOR REPRESENTATIVE IN THE GENERAL<br /> ASSEMBLY 106th REPRESENTATIVE DISTRICT<br /> (Vote for one)<br /> Jason R. Bunting (Republican)<br /> No Candidate (Democratic)</p> <p>FOR EAST JOLIET SANITARY DISTRICT TRUSTEE<br /> (Vote for one)<br /> Samantha Mitchell</p> <p>FOR LOCKPORT HEIGHTS SANITARY DISTRICT TRUSTEE<br /> (Vote for not more than two)<br /> No Candidate</p> <p>FOR WILL COUNTY CLERK<br /> (Vote for one)<br /> Annette Parker (Republican)<br /> Michelle Stiff (Democratic)</p> <p>FOR COUNTY SHERIFF<br /> (Vote for one)<br /> James “Jim” Reilly (Republican)<br /> Patick Jones (Democratic)</p> <p>FOR COUNTY TREASURER<br /> (Vote for one)<br /> Carmen Maurella III (Republican)<br /> Tim Brophy (Democratic)</p> <p>FOR WILL COUNTY REGIONAL<br /> SUPERINTENDENT OF SCHOOLS<br /> (Vote for one)<br /> Elizabeth Caparelli-Ruff (Republican)<br /> Theresa Rouse (Democratic)</p> <p>FOR REGIONAL SUPERINTGENDENT OF SCHOOLS<br /> (DuPage County)<br /> (Vote for one)<br /> Amber M. Quirk (Republican)<br /> Rebecca Gamboa (Democratic)</p> <p>FOR REGIONAL SUPERINTGENDENT OF SCHOOLS<br /> (GRUNDY and KENDALL COUNTIES)<br /> (Vote for one)<br /> Meghan Martin (Republican)<br /> No Candidate (Democratic)</p> <p>FOR REGIONAL SUPERINTENDENT OF SCHOOLS<br /> (IROQUOIS AND KANKAKEE COUNTIES)<br /> (Vote for one)<br /> Patricia High (Republican)<br /> No Candidate (Democratic)</p> <p>FOR COUNTY BOARD MEMBER DISTRICT 1<br /> (Vote for not more than two)<br /> Debbie Militello (Republican)<br /> Katie Deane-Schlottman (Republican)<br /> Joe Van Duyne (Democratic)<br /> No Candidate (Democratic)</p> <p>FOR COUNTY BOARD MEMBER DISTRICT 2<br /> (Vote for not more than two)<br /> Frankie Pretzel (Republican)<br /> Judy Ogalla (Republican)<br /> Bob Howard (Democratic)<br /> No Candidate (Democratic)</p> <p>FOR COUNTY BOARD MEMBER DISTRICT 3<br /> (Vote for not more than two)<br /> Daniel Butler (Republican)<br /> No Candidate (Republican)<br /> Sherry Newquist (Democratic)<br /> Marc McKirdie (Democratic)</p> <p>FOR COUNTY BOARD MEMBER DISTRICT 4<br /> (Vote for not more than two)<br /> James M. Richmond (Republican)<br /> Stephen J. Balich (Republican)<br /> Sheri Boniecki-Cooling (Democratic)<br /> William Pratt (Democratic)<br /> FOR COUNTY BOARD MEMBER DISTRICT 5<br /> (Vote for not more than two)<br /> David G. Oxley (Republican)<br /> James “JJ” Balonek (Republican)<br /> Sherry Williams (Democratic)<br /> Karen Johnson (Democratic)</p> <p>FOR COUNTY BOARD MEMBER DISTRICT 8<br /> (Vote for not more than two)<br /> Mark V. Revis (Republican)<br /> No Candidate (Republican)<br /> Mica Freeman (Democratic)<br /> Michael Crowner (Democratic)</p> <p>FOR COUNTY BOARD MEMBER DISTRICT 9<br /> (Vote for not more than two)<br /> Raquel M. Mitchell (Republican)<br /> No Candidate (Republican)<br /> Destinee Ortiz (Democratic)<br /> Alex Zapien (Democratic)</p> <p>FOR COUNTY BOARD MEMBER DISTRICT 11<br /> (Vote for not more than two)<br /> Steven Smith (Republican)<br /> No Candidate (Republican)<br /> Sheldon L. Watts (Democratic)<br /> Jacqueline L Traynere (Democratic)</p> <p>FOR JUDGE OF THE APPELLATE<br /> COURT THIRD JUDICIAL DISTRICT<br /> (To fill the vacancy of the Hon. Mary W. McDade)<br /> (Vote for one)<br /> Jason A. Helland (Republican)<br /> Margaret “Peggy” O’Connell (Democratic)</p> <p>FOR JUDGE OF THE CIRCUIT COURT<br /> TWELFTH JUDICIAL CIRCUIT 1st SUBCIRCUIT<br /> (To fill the vacancy of the Hon. David M. Carlson)<br /> (Vote for one)<br /> JohnPaul Ivec (Republican)<br /> Amy Christiansen (Democratic)</p> <p>FOR JUDGE OF THE CIRCUIT COURT<br /> TWELFTH JUDICIAL CIRCUIT 3rd SUBCIRCUIT<br /> (To fill the vacancy of the Hon. John C. Anderson)<br /> (Vote for one)<br /> No Candidate (Republican)<br /> Sonni Choi Williams (Democratic)</p> <p>FOR JUDGE OF THE CIRCUIT COURT<br /> TWELFTH JUDICIAL CIRCUIT 5th SUBCIRCUIT<br /> (To fill the vacancy of the Hon. Barbara N. Petrungaro)<br /> (Vote for one)<br /> Erin O’Brien (Republican)<br /> No Candidate (Democratic)</p> <p>BALLOT FOR JUDICIAL CANDIDATES<br /> SEEKING RETENTION IN OFFICE<br /> &#8220;Vote on the Proposition with respect to all or any of the Judges listed on this ballot. No Judge listed is running against any other Judge. The sole question is whether each Judge shall be retained in his or her present office.&#8221;</p> <p>SHALL Amy M. Bertani-Tomczak be retained in office as JUDGE OF THE CIRCUIT COURT TWELFTH<br /> JUDICIAL CIRCUIT?</p> <p>SHALL Sarah Jones be retained in office as JUDGE OF THE CIRCUIT COURT TWELFTH JUDICIAL CIRCUIT?</p> <p>SHALL Daniel L. Kennedy be retained in office as JUDGE OF THE CIRCUIT COURT TWELFTH JUDICIAL<br /> CIRCUIT?</p> <p>SHALL Daniel D. Rippy be retained in office as JUDGE OF THE CIRCUIT COURT TWELFTH JUDICIAL<br /> CIRCUIT?</p> <p>PROPOSITIONS</p> <p>CITY OF AURORA REFERENDUM<br /> (DuPage, Kane, Kendall &amp; Will Counties)<br /> AURORA MAYOR RECALL PROCEDURE<br /> Shall the City of Aurora adopt the following electoral system immediately upon passage of this binding referendum: the Mayor may be recalled and removed by a majority vote at a recall election that may be triggered by the filing of a recall petition signed by a number of Aurora electors equal to 20% of the total votes cast for all candidates for mayor in the immediately preceding mayoral election; and upon the certification of a valid recall petition, the question “Shall (name of Mayor) be recalled and removed from the Office of Mayor of the City of Aurora” shall be placed on the ballot at the immediately succeeding regularly-scheduled election to be held in the City of Aurora; and that in the event the Mayor is recalled and removed, the City Council shall fill the vacancy in the office of Mayor within 30 days from the date of the recall election, which appointment shall be for the remainder of the term, except that if more than 13 months remain in the term, the City Council shall set a date for a special election to be held within 9 months of the recall election at which time the voters of the City of Aurora shall elect a Mayor to serve the remaining term in office?</p> <p>CRETE TOWNSHIP REFERENDUM<br /> PROPOSED REFERENDUM QUESTION<br /> Shall the State of Illinois enact a law to require a person to present a valid government-issued photo identification card or passport establishing proof of their United States citizenship before allowing that person to vote in any Illinois election?</p> <p>DuPAGE TOWNSHIP REFERENDUM<br /> RIGHT TO BOYCOTT<br /> Shall individuals and businesses be allowed to boycott and divest from the State of Israel.</p> <p>FRANKFORT TOWNSHIP REFERENDUM<br /> SHALL THE STATE OF ILLINOIS ADOPT A LAW TO REQUIRE PROOF OF CITIZENSHIP TO VOTE<br /> Shall the State of Illinois enact a law to require a person to present a valid government¬-issued photo identification card or passport establishing proof of their United States citizenship before allowing that person to vote in any Illinois election?</p> <p>GREEN GARDEN TOWNSHIP REFERENDUM<br /> SHALL THE STATE OF ILLINOIS ADOPT A LAW<br /> TO REQUIRE PROOF OF CITIZENSHIP TO VOTE<br /> Do you think the State of Illinois should have a voter ID law?</p> <p>JOLIET TOWNSHIP REFERENDA<br /> INDEPENDENT CITIZENS COMMISSION FOR REDISTRICTING<br /> Should the State of Illinois adopt an independent citizens commission for the federal and state redistricting process?</p> <p>DATA CENTER CONSTRUCTION<br /> Should the Joliet City Council approve construction of AI data centers?</p> <p>RICHLAND SCHOOL DISTRICT No. 88A REFERENDUM<br /> PROPOSITION TO INCREASE THE LIMITING RATE<br /> Shall the limiting rate under the Property Tax Extension Limitation Law for Richland School District Number 88A, Will County, Illinois, be increased by an additional amount equal to 0.3900% above the limiting rate for levy year 2025 for school purposes, and be equal to 2.7833% of the equalized assessed value of the taxable property therein for levy year 2026?<br /> (1) The approximate amount of taxes extendable at the most recently extended limiting rate is $10,891,203 and the approximate amount of taxes extendable if the proposition is approved is $12,665,978.<br /> (2) For the 2026 levy year the approximate amount of the additional tax extendable against property containing a single family residence and having a fair market value at the time of the referendum of $100,000 is estimated to be $130.00.<br /> (3) If the proposition is approved, the aggregate extension for 2026 will be determined by the limiting rate set forth in the proposition, rather than the otherwise applicable limiting rate calculated under the provisions of the Property Tax Extension Limitation Law (commonly known as the Property Tax Cap Law).</p> <p>TROY COMMUNITY CONSOLIDATED SCHOOL DISTRICT No. 30-C REFERENDUM<br /> PROPOSITION TO INCREASE THE LIMITING RATE<br /> Shall the limiting rate under the Property Tax Extension Limitation Law for Troy Community Consolidated School District Number 30-C, Will County, Illinois, be increased by an additional amount equal to 0.4500% above the limiting rate for levy year 2025 for the purpose of providing educational programming and instruction, operating, maintaining, constructing and improving school buildings and facilities and constructing school safety and security improvements and for other school purposes, and be equal to 3.6241% of the equalized assessed value of the taxable property therein for levy year 2026?<br /> (1) The approximate amount of taxes extendable at the most recently extended limiting rate is $57,422,051, and the approximate amount of taxes extendable if the proposition is approved is $65,562,917.<br /> (2) For the 2026 levy year the approximate amount of the additional tax extendable against property containing a single family residence and having a fair market value at the time of the referendum of $100,000 is estimated to be $150.<br /> (3) If the proposition is approved, the aggregate extension for 2026 will be determined by the limiting rate set forth in the proposition, rather than the otherwise applicable limiting rate calculated under the provisions of the Property Tax Extension Limitation Law (commonly known as the Property Tax Cap Law).</p> <p>OSWEGO COMMUNITY UNIT SCHOOL DISTRICT No. 308 REFERENDUM (Kane, Kendall &amp; Will Counties)<br /> PROPOSITION TO ISSUE $317,000,000 SCHOOL BUILDING BONDS<br /> Shall the Board of Education of Oswego Community Unit School District Number 308, Kendall, Kane and Will Counties, Illinois, alter, repair and equip existing school buildings and improve the sites thereof, including installation of secure entryways, access controls, intrusion detection systems, and enhanced cameras; infrastructure repairs to roofing, mechanical, plumbing, and HVAC systems; science lab improvements; expansions to shared cafeteria/gym spaces; and improvements to provide enhanced energy efficiency; and issue bonds of said School District to the amount of $317,000,000 for the purpose of paying the costs thereof?</p> <p>BRAIDWOOD FIRE PROTECTION DISTRICT REFERENDUM<br /> (Grundy &amp; Will Counties)<br /> PROPOSITION TO INCREASE THE LIMITING RATE OF THE BRAIDWOOD FIRE PROTECTION DISTRICT<br /> Shall the limiting rate under the Property Tax Extension Limitation Law for the Braidwood Fire Protection District, Will and Grundy Counties, Illinois, be increased by an additional amount equal to .32% above the limiting rate for levy year 2025 and be equal to 0.6893% of the equalized assessed value of the taxable property therein for levy year 2026?<br /> (1) The approximate amount of taxes extendable at the most recent extended limiting rate is $2,819,468, and the approximate amount of taxes extendable if the proposition is approved is $5,262,549.<br /> (2) For the 2026 levy year the approximate amount of the additional tax extendable against property containing a single-family residence<br /> and having a fair market value at the time of referendum of $100,000 is estimated to be $106.67.<br /> (3) If the proposition is approved, the aggregate extension for 2026 will be determined by the limiting rate set forth in the proposition, rather than the otherwise applicable limiting rate calculated under the provisions of the Property Tax Extension Limitation Law (commonly known as the Property Tax Cap Law).</p> <p>FRANKFORT FIRE PROTECTION DISTRICT REFERENDUM<br /> (Cook &amp; Will Counties)<br /> PROPOSITION TO INCREASE THE LIMITING RATE OF THE FRANKFORT FIRE PROTECTION DISTRICT<br /> Shall the limiting rate under the Property Tax Extension Limitation Law for the Frankfort Fire Protection District, Will and Cook Counties, Illinois, be increased by an additional amount equal to 0.325% above the limiting rate for levy year 2025 and be equal to 1.0481% of the equalized assessed value of the taxable property therein for levy year 2026?<br /> (1) The approximate amount of taxes extendable at the most recent extended limiting rate is $15,558,572, and the approximate amount of taxes extendable if the proposition is approved is $22,551,430.<br /> (2) For the 2026 levy year the approximate amount of the additional tax extendable against property containing a single-family residence and having a fair market value at the time of referendum of $100,000 is estimated to be $108.33 in Will County and $98.48 in Cook County.<br /> (3) If the proposition is approved, the aggregate extension for 2026 will be determined by the limiting rate set forth in the proposition, rather than the otherwise applicable limiting rate calculated under the provisions of the Property Tax Extension Limitation Law (commonly known as the Property Tax Cap Law).</p> <p>DATED AT JOLIET, ILLINOIS<br /> October 1, 2026<br /> Published October 8, 2026</p> </div> </div> </div> </div> <div class="fl-col fl-node-62w97ixzmclj fl-col-bg-color fl-col-small" data-node="62w97ixzmclj"> <div class="fl-col-content fl-node-content"><div class="fl-module fl-module-pp-search-form fl-node-k4bh5vgq13fd" data-node="k4bh5vgq13fd"> <div class="fl-module-content fl-node-content"> <div class="pp-search-form-wrap pp-search-form--style-classic pp-search-form--button-type-icon"> <form class="pp-search-form" role="search" action="https://fwrnews.com" method="get" aria-label="Search form"> <div class="pp-search-form__container"> <label class="pp-screen-reader-text" for="pp-search-form__input-k4bh5vgq13fd"> Search </label> <input id="pp-search-form__input-k4bh5vgq13fd" placeholder="Search" class="pp-search-form__input" type="search" name="s" title="Search" value=""> <input type="hidden" name="post_types" value="post,classified,legal_notice" /> <button class="pp-search-form__submit" type="submit"> <i class="fa fa-search" aria-hidden="true"></i> <span class="pp-screen-reader-text">Search</span> </button> </div> </form> </div> </div> </div> <div class="fl-module fl-module-pp-heading fl-node-pn280kx5jfst" data-node="pn280kx5jfst"> <div class="fl-module-content fl-node-content"> <div class="pp-heading-content"> <div class="pp-heading pp-center"> <h2 class="heading-title"> <span class="title-text pp-primary-title">Events</span> </h2> </div> <div class="pp-sub-heading"> <div id="MECCopyCode" class="mec-calenda