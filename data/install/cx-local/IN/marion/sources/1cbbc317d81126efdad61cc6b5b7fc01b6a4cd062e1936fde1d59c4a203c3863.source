	<div class="page-content">
				<div data-elementor-type="wp-page" data-elementor-id="3069" class="elementor elementor-3069" data-elementor-post-type="page">
				<div class="elementor-element elementor-element-3c87860 e-flex e-con-boxed e-con e-parent" data-id="3c87860" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-79b165e e-flex e-con-boxed e-con e-child" data-id="79b165e" data-element_type="container" data-e-type="container">
					<div class="e-con-inner">
				<div class="elementor-element elementor-element-3da890c elementor-widget elementor-widget-heading" data-id="3da890c" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h1 class="elementor-heading-title elementor-size-default">Sample Ballot</h1>				</div>
					</div>
				</div>
					</div>
				</div>
		<div class="elementor-element elementor-element-f178e1e ad-template ad-template--main-heading-text ad-scope mceb-main-heading-text-template e-flex e-con-boxed e-con e-parent" data-id="f178e1e" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-e466a09 e-con-full mceb-main-heading-text-rule e-flex e-con e-child" data-id="e466a09" data-element_type="container" data-e-type="container">
		<div class="elementor-element elementor-element-f624b66 e-con-full mceb-main-heading-text-rule-navy e-flex e-con e-child" data-id="f624b66" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				</div>
		<div class="elementor-element elementor-element-671c1cf e-con-full mceb-main-heading-text-rule-red e-flex e-con e-child" data-id="671c1cf" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				</div>
				</div>
				<div class="elementor-element elementor-element-c6b0ad1 elementor-widget elementor-widget-heading" data-id="c6b0ad1" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h1 class="elementor-heading-title elementor-size-default">What is On Your Ballot This Election</h1>				</div>
				<div class="elementor-element elementor-element-f4f0dd6 elementor-widget elementor-widget-heading" data-id="f4f0dd6" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">See What Contests Exist in Marion County</h2>				</div>
				<div class="elementor-element elementor-element-bf941e7 elementor-widget elementor-widget-text-editor" data-id="bf941e7" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<h6><span style="font-weight: normal;"><span style="font-size: 18px;">The precinct in which you are registered to vote determines what contests, candidates, and public questions appear on your ballot each election cycle.</span></span></h6><h6><span style="font-weight: normal;"><span style="font-size: 18px;"><br></span>Using the Sample Ballot Tool below, enter your Marion County, Indiana address to see what will appear on your ballot. You can use the populated filter to search for specific offices, or generate a downloadable PDF of the ballot specific to your precinct.</span></h6>								</div>
					</div>
				</div>
		<div class="elementor-element elementor-element-98e47fa e-flex e-con-boxed e-con e-parent" data-id="98e47fa" data-element_type="container" data-e-type="container">
					<div class="e-con-inner">
				<div class="elementor-element elementor-element-1fbf1af elementor-widget elementor-widget-html" data-id="1fbf1af" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
					<iframe class="office-holder" src="https://gis.indy.gov/portal/apps/instant/nearby/index.html?appid=4107c24aea9c4d1ca0eed77c0f507369" width="100%" height="100%" frameborder="0" style="border:0" allowfullscreen>iFrames are not supported on this page.</iframe>				</div>
					</div>
				</div>
		<div class="elementor-element elementor-element-59a1ae1 ad-template ad-template--two-column-list ad-scope mceb-two-column-list-template e-flex e-con-boxed e-con e-parent" data-id="59a1ae1" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-8497592 e-con-full mceb-main-heading-text-rule e-flex e-con e-child" data-id="8497592" data-element_type="container" data-e-type="container">
		<div class="elementor-element elementor-element-1b6ff07 e-con-full mceb-main-heading-text-rule-navy e-flex e-con e-child" data-id="1b6ff07" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				</div>
		<div class="elementor-element elementor-element-c800012 e-con-full mceb-main-heading-text-rule-red e-flex e-con e-child" data-id="c800012" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				</div>
				</div>
				<div class="elementor-element elementor-element-e2406db elementor-widget elementor-widget-heading" data-id="e2406db" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h1 class="elementor-heading-title elementor-size-default">Get Ready for the Election</h1>				</div>
				<div class="elementor-element elementor-element-c1b1a87 elementor-widget elementor-widget-heading" data-id="c1b1a87" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">Know What Will Be on Your Ballot</h2>				</div>
				<div class="elementor-element elementor-element-8ba15e6 elementor-widget elementor-widget-text-editor" data-id="8ba15e6" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p>Make a plan prior to Election Day, to know what will appear on the ballot for your specific precinct. Using the tool above to identify your voting districts, candidates for office, and public questions appearing on your ballot for the 2026 General Election.</p>								</div>
		<div class="elementor-element elementor-element-44d756b e-con-full mceb-two-column-list-inner e-grid e-con e-child" data-id="44d756b" data-element_type="container" data-e-type="container">
		<div class="elementor-element elementor-element-67d93e1 e-con-full mceb-two-column-list-image-box e-flex e-con e-child" data-id="67d93e1" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-0190ac0 elementor-widget elementor-widget-image" data-id="0190ac0" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
															<img fetchpriority="high" decoding="async" width="1254" height="1254" src="/wp-content/uploads/2026/09/ballot-icon.png" class="attachment-full size-full wp-image-2874" alt="" srcset="/wp-content/uploads/2026/09/ballot-icon.png 1254w, /wp-content/uploads/2026/09/ballot-icon-300x300.png 300w, /wp-content/uploads/2026/09/ballot-icon-1024x1024.png 1024w, /wp-content/uploads/2026/09/ballot-icon-150x150.png 150w, /wp-content/uploads/2026/09/ballot-icon-768x768.png 768w" sizes="(max-width: 1254px) 100vw, 1254px" />															</div>
				<div class="elementor-element elementor-element-8d313b4 elementor-widget elementor-widget-heading" data-id="8d313b4" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">BALLOT</h2>				</div>
				</div>
		<div class="elementor-element elementor-element-917cd45 e-con-full mceb-two-column-list-content e-flex e-con e-child" data-id="917cd45" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-631e369 elementor-widget elementor-widget-text-editor" data-id="631e369" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p>Your sample ballot shows the offices, candidates and public questions you may vote on in the next election. Preview your ballot as part of your voting plan this election. </p>								</div>
				</div>
				</div>
		<div class="elementor-element elementor-element-7be18e2 e-con-full mceb-two-column-list-inner e-grid e-con e-child" data-id="7be18e2" data-element_type="container" data-e-type="container">
		<div class="elementor-element elementor-element-601377a e-con-full mceb-two-column-list-image-box e-flex e-con e-child" data-id="601377a" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-0da4946 elementor-widget elementor-widget-image" data-id="0da4946" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
															<img decoding="async" width="1254" height="1254" src="/wp-content/uploads/2026/09/districts-icon.png" class="attachment-full size-full wp-image-2873" alt="" srcset="/wp-content/uploads/2026/09/districts-icon.png 1254w, /wp-content/uploads/2026/09/districts-icon-300x300.png 300w, /wp-content/uploads/2026/09/districts-icon-1024x1024.png 1024w, /wp-content/uploads/2026/09/districts-icon-150x150.png 150w, /wp-content/uploads/2026/09/districts-icon-768x768.png 768w" sizes="(max-width: 1254px) 100vw, 1254px" />															</div>
				<div class="elementor-element elementor-element-c0d4d0b elementor-widget elementor-widget-heading" data-id="c0d4d0b" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">DISTRICTS</h2>				</div>
				</div>
		<div class="elementor-element elementor-element-fb54a6d e-con-full mceb-two-column-list-content e-flex e-con e-child" data-id="fb54a6d" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-d704f02 elementor-widget elementor-widget-text-editor" data-id="d704f02" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p>Your Marion County voter registration address determines which local, state and federal districts you vote on. Because district boundaries can be determined by township lines, city borders, or even neighborhood streets, your district may not be the same as a voter around the corner. To find a collection of maps for all voting districts in the county, <a href="https://www.indy.gov/activity/election-district-maps" target="_blank" rel="noopener">click here.</a> </p>								</div>
				</div>
				</div>
		<div class="elementor-element elementor-element-80d9e21 e-con-full mceb-two-column-list-inner e-grid e-con e-child" data-id="80d9e21" data-element_type="container" data-e-type="container">
		<div class="elementor-element elementor-element-bc42ac6 e-con-full mceb-two-column-list-image-box e-flex e-con e-child" data-id="bc42ac6" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-374851d elementor-widget elementor-widget-image" data-id="374851d" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
															<img decoding="async" width="1254" height="1254" src="/wp-content/uploads/2026/09/officials-icon.png" class="attachment-full size-full wp-image-2872" alt="" srcset="/wp-content/uploads/2026/09/officials-icon.png 1254w, /wp-content/uploads/2026/09/officials-icon-300x300.png 300w, /wp-content/uploads/2026/09/officials-icon-1024x1024.png 1024w, /wp-content/uploads/2026/09/officials-icon-150x150.png 150w, /wp-content/uploads/2026/09/officials-icon-768x768.png 768w" sizes="(max-width: 1254px) 100vw, 1254px" />															</div>
				<div class="elementor-element elementor-element-c6c21b2 elementor-widget elementor-widget-heading" data-id="c6c21b2" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">OFFICIALS</h2>				</div>
				</div>
		<div class="elementor-element elementor-element-788893d e-con-full mceb-two-column-list-content e-flex e-con e-child" data-id="788893d" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-0c73f42 elementor-widget elementor-widget-text-editor" data-id="0c73f42" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p>Using the <b><a href="https://vote.indy.gov/office-holder/">Office Holder Tool</a></b>, you can review a list of your current representatives at all levels of government.  The Office Holder Tool lists office and contact information, where available for each elected official. </p>								</div>
				</div>
				</div>
					</div>
				</div>
				</div>
			</div>

</main>

