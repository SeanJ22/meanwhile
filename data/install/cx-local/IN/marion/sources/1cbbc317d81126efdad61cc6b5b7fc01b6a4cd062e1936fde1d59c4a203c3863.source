								05							</div>
							<div class="mceb-sticky-info__detail">
								<span>Monday, October 5, 2026</span>
								Voter Registration Deadline							</div>
						</div>
											<div class="mceb-sticky-info__date-item">
							<div class="mceb-sticky-info__date">
								<span>OCT</span>
								06							</div>
							<div class="mceb-sticky-info__detail">
								<span>Tuesday, October 6, 2026</span>
								In-Person Early Voting Begins at City-County Building							</div>
						</div>
											<div class="mceb-sticky-info__date-item">
							<div class="mceb-sticky-info__date">
								<span>OCT</span>
								22							</div>
							<div class="mceb-sticky-info__detail">
								<span>Thursday, October 22, 2026</span>
								Deadline to request an absentee ballot							</div>
						</div>
											<div class="mceb-sticky-info__date-item">
							<div class="mceb-sticky-info__date">
								<span>OCT</span>
								24							</div>
							<div class="mceb-sticky-info__detail">
								<span>Saturday, October 24, 2026</span>
								Satellite Site Voting Begins							</div>
						</div>
											<div class="mceb-sticky-info__date-item">
							<div class="mceb-sticky-info__date">
								<span>NOV</span>
								01							</div>
							<div class="mceb-sticky-info__detail">
								<span>Sunday, November 1, 2026</span>
								Satellite Site Voting Ends							</div>
						</div>
											<div class="mceb-sticky-info__date-item">
							<div class="mceb-sticky-info__date">
								<span>NOV</span>
								02							</div>
							<div class="mceb-sticky-info__detail">
								<span>Monday, November 2, 2026</span>
								Early Voting at the City-County Building Ends at Noon							</div>
						</div>
											<div class="mceb-sticky-info__date-item">
							<div class="mceb-sticky-info__date">
								<span>NOV</span>
								03							</div>
							<div class="mceb-sticky-info__detail">
								<span>Tuesday, November 3, 2026</span>
								General Election Day							</div>
