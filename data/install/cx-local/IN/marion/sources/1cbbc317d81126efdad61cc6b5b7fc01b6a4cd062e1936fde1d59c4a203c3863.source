		</section>
		<script>
		(function() {
			var drawer = document.getElementById("mceb-sticky-info-1");
			var mobilePanel = document.getElementById("mceb-sticky-info-1-mobile");
			if (!drawer) return;
			var toggle = drawer.querySelector('[data-sticky-floating-info-toggle]');
			var label = drawer.querySelector('[data-sticky-floating-info-toggle-text]');
			if (!toggle) return;
			var fallbackInitialTop = parseInt(getComputedStyle(drawer).getPropertyValue('--mceb-sticky-info-top'), 10) || 400;
			var initialTop = fallbackInitialTop;
			var heroLinksGap = 20;
			var stickyTriggerGap = 50;
			var stickyCloseDistance = 50;
			var stickyStartScrollY = null;
			var hasStickyAutoClosed = false;
			var autoCloseDelay = 7000;
			var autoCloseTimer = null;
			var hasInteracted = false;
			var ticking = false;
			var heightTransitionTimer = null;
			var heightTransitionFrame = null;
			var closedPreferenceCookie = 'mceb_sticky_info_closed';

			function getCookie(name) {
				var prefix = name + '=';
				var cookies = document.cookie ? document.cookie.split(';') : [];

				for (var index = 0; index < cookies.length; index++) {
					var cookie = cookies[index].trim();
					if (cookie.indexOf(prefix) === 0) {
						return decodeURIComponent(cookie.substring(prefix.length));
					}
				}

				return '';
			}

			function setClosedPreference(isClosed) {
				var attributes = '; path=/; SameSite=Lax';
				if (window.location.protocol === 'https:') {
					attributes += '; Secure';
				}

				if (isClosed) {
					document.cookie = closedPreferenceCookie + '=1; max-age=2592000' + attributes;
					return;
				}

				document.cookie = closedPreferenceCookie + '=; max-age=0' + attributes;
			}

			function updateToggleState(isClosed) {
				toggle.setAttribute('aria-expanded', isClosed ? 'false' : 'true');
				if (label) label.textContent = isClosed ? 'Open election dates' : 'Close election dates';
			}

			if (drawer.parentElement !== document.body) {
				document.body.appendChild(drawer);
			}
			if (mobilePanel && mobilePanel.parentElement !== document.body) {
				document.body.appendChild(mobilePanel);
			}

			if ('1' === getCookie(closedPreferenceCookie)) {
				drawer.classList.add('is-closed');
				updateToggleState(true);
			}

			function getHeaderBottom() {
				var header = document.querySelector('.elementor-location-header, .mceb-header-template, #site-header, header');
				if (header) {
					return Math.max(0, Math.round(header.getBoundingClientRect().bottom));
				}

				var adminBar = document.getElementById('wpadminbar');
				return adminBar ? Math.max(0, Math.round(adminBar.getBoundingClientRect().bottom)) : 0;
			}

			function updateInitialTop() {
				var heroLinks = document.querySelector('.mceb-home-hero-links');
				var nextTop = fallbackInitialTop;

				if (heroLinks) {
					var heroLinksRect = heroLinks.getBoundingClientRect();
					nextTop = Math.max(fallbackInitialTop, Math.round(heroLinksRect.bottom + window.scrollY + heroLinksGap));
				}

				if (nextTop !== initialTop) {
					initialTop = nextTop;
					drawer.style.setProperty('--mceb-sticky-info-top', initialTop + 'px');
				}
			}

			function updateStickyPosition() {
				updateInitialTop();
				var stuckTop = getHeaderBottom() + stickyTriggerGap;
				var shouldStick = window.scrollY >= Math.max(0, initialTop - stuckTop);
				var isStuck = drawer.classList.contains('is-stuck');

				if (shouldStick && !isStuck) {
					stickyStartScrollY = window.scrollY;
				} else if (!shouldStick) {
					stickyStartScrollY = null;
					hasStickyAutoClosed = false;
				}

				drawer.classList.toggle('is-stuck', shouldStick);
				drawer.style.setProperty('--mceb-sticky-info-stuck-top', stuckTop + 'px');

				if (
					shouldStick &&
					!hasStickyAutoClosed &&
					stickyStartScrollY !== null &&
					window.scrollY >= stickyStartScrollY + stickyCloseDistance &&
					!drawer.classList.contains('is-closed')
				) {
					setClosed(true);
					hasStickyAutoClosed = true;
				}
			}

			function requestStickyUpdate() {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(function() {
					updateStickyPosition();
					ticking = false;
				});
			}

			function clearHeightTransition() {
				if (heightTransitionFrame) {
					window.cancelAnimationFrame(heightTransitionFrame);
					heightTransitionFrame = null;
				}

				if (heightTransitionTimer) {
					window.clearTimeout(heightTransitionTimer);
					heightTransitionTimer = null;
				}

				drawer.style.height = '';
			}

			function setClosed(isClosed) {
				if (drawer.classList.contains('is-closed') === isClosed) return;

				clearHeightTransition();

				// Measure both states synchronously so the browser never paints an auto-height intermediate state.
				var startHeight = Math.ceil(drawer.getBoundingClientRect().height);
				drawer.classList.add('is-measuring');
				drawer.classList.toggle('is-closed', isClosed);
				drawer.style.height = 'auto';
				var endHeight = Math.ceil(drawer.getBoundingClientRect().height);
				drawer.classList.toggle('is-closed', !isClosed);
				drawer.style.height = startHeight + 'px';
				drawer.classList.remove('is-measuring');
				void drawer.offsetHeight;

				heightTransitionFrame = window.requestAnimationFrame(function() {
					drawer.classList.toggle('is-closed', isClosed);
					drawer.style.height = endHeight + 'px';
					heightTransitionFrame = null;
				});

				heightTransitionTimer = window.setTimeout(clearHeightTransition, 380);
				updateToggleState(isClosed);
			}

			function cancelAutoClose() {
				hasInteracted = true;
				if (autoCloseTimer) {
					window.clearTimeout(autoCloseTimer);
					autoCloseTimer = null;
				}
			}

			function autoCloseIfIdle() {
				if (!hasInteracted && !drawer.classList.contains('is-closed')) {
					setClosed(true);
				}
			}

			if (!drawer.classList.contains('is-closed')) {
				autoCloseTimer = window.setTimeout(autoCloseIfIdle, autoCloseDelay);
			}

			toggle.addEventListener('click', function() {
				cancelAutoClose();
				var isClosed = !drawer.classList.contains('is-closed');
				setClosed(isClosed);
				setClosedPreference(isClosed);
			});
			drawer.addEventListener('pointerenter', cancelAutoClose);
			drawer.addEventListener('focusin', cancelAutoClose);
			drawer.addEventListener('keydown', cancelAutoClose);
			window.addEventListener('scroll', requestStickyUpdate, { passive: true });
			window.addEventListener('resize', requestStickyUpdate);
			window.addEventListener('load', requestStickyUpdate);
			updateStickyPosition();
		})();
		</script>
						</div>
