+= 'Contact information not available';\nhtml += '<\/td>';\nhtml += '<\/tr>';\n}\n\nhtml += '<\/tbody><\/table>';\nhtml += '<\/div>';\n\nreturn {\ntype: 'text',\ntext: html\n};","returnType":"dictionary"}}],"expressionInfos":[{"name":"expr0","title":"OfficeName","expression":"var parts = Split($feature.election_key, \"-\")\nreturn parts[0]","returnType":"string"},{"name":"expr1","title":"PartyColor","expression":"return When(\n    $feature.party == \"Democratic\", \"#005095\",\n    $feature.party == \"Republican\", \"#B22234\",\n    $feature.party == \"Non-Partisan\", \"#515660\",\n    \"#091325\"\n)","returnType":"string"},{"name":"expr2","title":"IncumbentBadge","expression":"if ($feature.incumbent == \"Yes\") {\n    return \"<span style='background:#EEBE05;color:#14284B;padding:2px 8px;border-radius:4px;font-size:12px;margin-left:6px'>INCUMBENT<\/span>\"\n}\nreturn \"\"","returnType":"string"}],"fieldInfos":[{"fieldName":"objectid","format":{"digitSeparator":false,"places":0},"isEditable":false,"label":"OBJECTID","visible":true},{"fieldName":"election_key","isEditable":true,"label":"election_key","visible":true},{"fieldName":"electiondate","isEditable":true,"label":"electiondate","visible":true},{"fieldName":"electiontype","isEditable":true,"label":"electiontype","visible":true},{"fieldName":"electioncycle","isEditable":true,"label":"electioncycle","visible":true},{"fieldName":"filingdeadline","isEditable":true,"label":"filingdeadline","visible":true},{"fieldName":"regdate","isEditable":true,"label":"regdate","visible":true},{"fieldName":"electionstatus","isEditable":true,"label":"ElectionStatus","visible":true},{"fieldName":"seatlabel","isEditable":true,"label":"seatlabel","visible":true},{"fieldName":"districtname","isEditable":true,"label":"districtname","visible":true},{"fieldName":"name","isEditable":true,"label":"name","visible":true},{"fieldName":"party","isEditable":true,"label":"party","visible":true},{"fieldName":"incumbent","isEditable":true,"label":"i