fo":{"title":"New expression","expression":"var partyColor = When(\n$feature.party == \"Democratic\", \"#005095\",\n$feature.party == \"Republican\", \"#B22234\",\n$feature.party == \"Non-Partisan\", \"#515660\",\n\"#091325\"\n);\n\nvar incumbentBadge = \"\";\nif ($feature.incumbent == \"Yes\") {\nincumbentBadge = \"<span style='background:#EEBE05;color:#14284B;padding:2px 8px;border-radius:4px;font-size:12px;margin-left:6px'>INCUMBENT<\/span>\";\n}\n\nvar html = '<div style=\"font-family:Karla, Arial, sans-serif;max-width:320px;\">';\n\nhtml += '<div style=\"padding:4px 0 12px;\">';\nhtml += '<span style=\"color:#14284B;font-size:16px;\"><strong>' + $feature.name + '<\/strong><\/span>';\nhtml += ' <span style=\"color:#A0A5AD;font-size:16px;\"><strong>|<\/strong><\/span> ';\nhtml += '<span style=\"color:' + partyColor + ';font-size:16px;\"><strong>' + $feature.party + '<\/strong><\/span>';\nhtml += incumbentBadge;\nhtml += '<\/div>';\n\nhtml += '<table style=\"border-collapse:collapse;color:#505660;font-size:13px;width:100%;\">';\nhtml += '<tbody>';\n\nhtml += '<tr>';\nhtml += '<td style=\"padding:4px 12px 4px 0;width:40%;\"><strong>Election Cycle:<\/strong><\/td>';\nhtml += '<td style=\"padding:4px 0;\">' + $feature.electioncycle + '<\/td>';\nhtml += '<\/tr>';\n\nif (!IsEmpty($feature.phone)) {\nhtml += '<tr>';\nhtml += '<td style=\"padding:4px 12px 4px 0;\"><strong>Phone:<\/strong><\/td>';\nhtml += '<td style=\"padding:4px 0;\">';\nhtml += '<a href=\"tel:' + $feature.phone + '\" style=\"color:#1F5A94;text-decoration:none;\">' + $feature.phone + '<\/a>';\nhtml += '<\/td>';\nhtml += '<\/tr>';\n}\n\nif (!IsEmpty($feature.email)) {\nhtml += '<tr>';\nhtml += '<td style=\"padding:4px 12px 4px 0;\"><strong>Email:<\/strong><\/td>';\nhtml += '<td style=\"padding:4px 0;\">';\nhtml += '<a href=\"mailto:' + $feature.email + '\" style=\"color:#1F5A94;text-decoration:none;\">' + $feature.email + '<\/a>';\nhtml += '<\/td>';\nhtml += '<\/tr>';\n}\n\nif (!IsEmpty($feature.website)) {\nhtml += '<tr>';\nhtml += '<td style=\"padding:4px 12px 4px 0;\"><strong>Website:<\/strong><\/td>';\nhtml += '<td style=\"padding:4px 0;\">';\nhtml += '<a href=\"' + $feature.website + '\" target=\"_blank\" style=\"color:#1F5A94;text-decoration:none;\">';\nhtml += $feature.website;\nhtml += '<\/a>';\nhtml += '<\/td>';\nhtml += '<\/tr>';\n}\n\nif (IsEmpty($feature.phone) && IsEmpty($feature.email) && IsEmpty($feature.website)) {\nhtml += '<tr>';\nhtml += '<td colspan=\"2\" style=\"padding:8px 0 2px;color:#7A7F87;font-size:12px;font-style:italic;\">';\nhtml += 'Contact information not available';\nhtml += '<\/td>';\nhtml += '<\/tr>';\n}\n\nhtml += '<\/tbody><\/table>';\nhtml += '<\/div>';\n\nreturn {\ntype: 'text',\ntext: html\n};","returnType":"dictionary"}}],"expressionInfos":[{"name":"expr0","title":"OfficeName","expression":"var parts = Split($feature.election_key, \"-\")\nreturn parts[0]","returnType":"string"},{"name":"expr1","title":"PartyColor","expression":"return When(\n    $feature.party == \"Democratic\", \"#005095\",\n    $feature.party == \"Republican\", \"#B22234\",\n    $feature.party == \"Non-Partisan\", \"#515660\",\n    \"#091325\"\n)","returnType":"string"},{"name":"expr2","title":"IncumbentBadge","expression":"if ($feature.incumbent == \"Yes\") {\n    return \"<span style='background:#EEBE05;color:#14284B;padding:2px 8px;border-radius:4px;font-size:12px;margin-left:6px'>INCUMBENT<\/span>\"\n}\nreturn \"\"","returnType":"string"}],"fieldInfos":[{"fieldName":"objectid","format":{"digitSeparator":false,"places":0},"isEditable":false,"label":"OBJECTID","visible":true},{"fieldName":"election_key","isEditable":true,"label":"election_key","visible":true},{"fieldName":"electiondate","isEditable":true,"label":"electiondate","visible":true},{"fieldName":"electiontype","isEditable":true,"label":"electiontype","visible":true},{"fieldName":"electioncycle","isEditable":true,"label":"electioncycle","visible":true},{"fieldName":"filingdeadline","isEditable":t