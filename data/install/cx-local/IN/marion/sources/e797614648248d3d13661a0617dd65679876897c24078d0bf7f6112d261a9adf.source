:"#006D9E","text":"#FFFFFF"}}},"uploads":["https://gis.indy.gov/portal/sharing/rest/content/items/4107c24aea9c4d1ca0eed77c0f507369/resources/media/instantAppsConfigPanel_1788362343995_Star-Logo.png"],"keyboardShortcutsPosition":{"position":"top-left","index":5},"mapZoomPosition":{"position":"top-left","index":3},"homePosition":{"position":"top-left","index":4},"compassWidgetPosition":{"position":"top-left","index":6},"locateWidgetPosition":{"position":"top-left","index":0},"bookmarksPosition":{"position":"top-right","index":2},"sharePosition":{"position":"top-left","index":1},"languageSwitcherPosition":{"position":"top-right","index":1},"legendPosition":{"position":"top-right","index":3},"legend":false,"introductionContent":"<div style=\"color:#262262; font-family:Karla,Arial,sans-serif; padding:20px 18px;\"><div style=\"padding:2px 0 16px; text-align:center;\"><div style=\"color:#262262; font-size:20px;\"><strong>Marion County — What's On My Ballot</strong></div><div style=\"color:#7A7F87; font-size:13px; margin-top:6px;\">Find candidates for your address</div></div><div style=\"border-top:1px solid #A0A5AD; margin-bottom:18px; padding-top:16px;\"><div style=\"color:#505660; font-size:14px;\">Enter your address or click your precinct on the map to see the candidates on your ballot.</div></div><div style=\"margin-bottom:18px;\"><div style=\"font-size:15px; margin-bottom:10px;\"><strong>How to use</strong></div><div style=\"color:#505660; font-size:13px;\"><div style=\"margin-bottom:8px;\"><strong>1.</strong> Enter an address or click your precinct on the map.</div><div style=\"margin-bottom:8px;\"><strong>2.</strong> If searching by address, select it from the results.</div><div style=\"margin-bottom:8px;\"><strong>3.</strong> Review the candidates associated with your location.</div><div style=\"margin-bottom:8px;\"><strong>4.</strong> Click a candidate to view additional information.</div><div><strong>5.</strong> Click \"Clear Selection\" to search a different address or location.</div></div></div><div style=\"background:#F5F6F7; border-left:4px solid #ED1C24; margin-bottom:18px; padding:12px 14px;\"><div style=\"color:#262262; font-size:14px; margin-bottom:5px;\"><strong>Good to know</strong></div><div style=\"color:#505660; font-size:12px;\">This tool helps you identify candidates associated with your address. It is <strong>not a sample ballot</strong>.</div></div><div style=\"border-top:1px solid #A0A5AD; margin-bottom:16px; padding-top:14px;\"><div style=\"font-size:15px; margin-bottom:8px;\"><strong>Related resources</strong></div><div style=\"font-size:13px;\"><a style=\"color:#006D9E; text-decoration:none;\" href=\"https://vote.indy.gov/\"><strong>Return to vote.indy.gov</strong>&nbsp;</a>&nbsp;&nbsp;&nbsp;<br><a style=\"color:#006D9E; text-decoration:none;\" href=\"https://indianavoters.in.gov/\" target=\"_blank\"><strong>Check your voter registration</strong>&nbsp;</a>&nbsp;&nbsp;&nbsp;<br><a style=\"color:#006D9E; text-decoration:none;\" href=\"https://vote.indy.gov/office-holder/\"><strong>See your current elected officials</strong>&nbsp;</a></div></div><div style=\"border-top:1px solid #A0A5AD; color:#7A7F87; font-size:11px; padding-top:12px;\"><strong>Disclaimer:</strong> Information provided through this tool is for informational purposes and may change as election information is updated. For official voter registration and election information, visit IndianaVoters.IN.gov.</div></div>","showIntroduction":true,"keyboardShortcuts":false,"mapPinLabel":true,"applyLayerEffects":true,"showPopupsOnZoom":false,"enableSearchScale":true,"scalebar":true,"locateWidget":true,"basemapToggle":true,"basemapSelector":"16b1106462c842e28408861fdf72dcf5","layerList":false,"share":true,"screenshot":true,"screenshotPosition":{"position":"top-left","index":2},"introductionTitle":"","precision":0.01,"showNonResultPopups":false,"collapseIndividualResults":true,"includeDistance":false,"shareSelected":true,"exportToPDF":true,"exportCSV":