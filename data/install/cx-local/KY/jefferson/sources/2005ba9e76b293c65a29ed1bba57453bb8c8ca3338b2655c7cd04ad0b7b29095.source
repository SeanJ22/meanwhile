    return path === "" ? "/" : path;
  }

  function toPath(url) {
    if (/^https?:\/\//i.test(url)) {
      var a = document.createElement("a");
      a.href = url;
      return normalizePath(a.pathname);
    }
    return normalizePath(url);
  }

  function matches(pattern, currentPath) {
    var target = toPath(pattern);

    if (target.indexOf("*") === -1) {
      return target === currentPath;
    }

    var regex = new RegExp(
      "^" + target.replace(/[.+?^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*") + "$"
    );
    return regex.test(currentPath);
  }

  // Scripts from the fragment parser are inert, so rebuild each one as a live
