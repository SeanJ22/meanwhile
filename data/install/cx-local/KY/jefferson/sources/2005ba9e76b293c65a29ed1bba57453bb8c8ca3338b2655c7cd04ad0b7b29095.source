    }

    return el;
  }

  function alreadyInjected(el) {
    if (!el.src) {
      return false;
    }

    var duplicate = false;

    $("script[src]").each(function () {
      if (this.src === el.src && this.getAttribute("data-signup-id") === el.getAttribute("data-signup-id")) {
