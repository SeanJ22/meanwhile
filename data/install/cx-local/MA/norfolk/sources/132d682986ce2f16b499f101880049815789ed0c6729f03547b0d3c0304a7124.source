    function RelatedDocumentsCallback(widgetID, response)
    {
        if (window.ContentCollectionInstance.IsWorkingCopy) {
        	$('#widgetRelDoc' + widgetID).replaceWith(response);            
            contentUpdated();
            attachRelatedDocumentsHandlers();            
        }
