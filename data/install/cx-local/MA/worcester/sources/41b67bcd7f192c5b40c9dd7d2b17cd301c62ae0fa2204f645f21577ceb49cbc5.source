	<div class="inner col col24 first last idb3c1c06d-fb46-4405-8ea5-50c98b3e2638" style="" data-widgetcontainerid="b3c1c06d-fb46-4405-8ea5-50c98b3e2638">	
<div class="widget editor pageStyles narrow" id="divEditor48e83fe9-74ca-4737-be96-ddd4a9cac01d" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <p><a href="/DocumentCenter/View/21674/Specimen-Ballot-State-Election-November-3-2026" target="_blank" rel="noopener">Specimen Ballot State Election November 3, 2026</a></p><p><strong>2026 State Election Candidates:</strong> <a href="https://www.sec.state.ma.us/divisions/elections/research-and-statistics/2026-state-election-candidates.htm">https://www.sec.state.ma.us/divisions/elections/research-and-statistics/2026-state-election-candidates.htm</a></p><p><a href="/DocumentCenter/View/21642/Warrant-Nov-3-2026-State-Election">Warrant State Election November 3, 2026</a></p><p id="isPasted"><span style="text-decoration: underline;"><span style="font-size: 24px;"><strong>Early Voting State Election &ndash; Town Hall, 100 Maple Ave.</strong></span></span></p><p><strong>&nbsp;</strong></p><table border="0" cellpadding="0" cellspacing="0" width="0"><colgroup><col style="width: 11.9425%;"><col style="width: 18.3328%;"><col style="width: 24.0262%;"><col style="width: 13.0542%;"><col style="width: 15.5448%;"><col style="width: 17.0994%;"></colgroup><tbody><tr><td valign="top"><p><strong>Oct. 17</strong></p></td><td valign="top"><p><strong>Saturday</strong></p></td><td valign="top"><p><strong>9am-1pm</strong></p></td><td valign="top"><p><strong>Oct 24</strong></p></td><td valign="top"><p><strong>Saturday</strong></p></td><td valign="top"><p><strong>12pm-4pm</strong></p></td></tr><tr><td valign="top"><p><strong>Oct. 18</strong></p></td><td valign="top"><p><strong>Sunday</strong></p></td><td valign="top"><p><strong>9am-1pm</strong></p></td><td valign="top"><p><strong>Oct 25</strong></p></td><td valign="top"><p><strong>Sunday</strong></p></td><td valign="top"><p><strong>9am-1pm</strong></p></td></tr><tr><td valign="top"><p><strong>Oct 19</strong></p></td><td valign="top"><p><strong>Monday</strong></p></td><td valign="top"><p><strong>8am-4:30pm</strong></p></td><td valign="top"><p><strong>Oct 26</strong></p></td><td valign="top"><p><strong>Monday</strong></p></td><td valign="top"><p><strong>&nbsp;8am-4:30pm</strong></p></td></tr><tr><td valign="top"><p><strong>Oct 20</strong></p></td><td valign="top"><p><strong>Tuesday</strong></p></td><td valign="top"><p><strong>8am-6:30pm</strong></p></td><td valign="top"><p><strong>Oct. 27</strong></p></td><td valign="top"><p><strong>Tuesday</strong></p></td><td valign="top"><p><strong>&nbsp;8am-6:30pm</strong></p></td></tr><tr><td valign="top"><p><strong>Oct 21</strong></p></td><td valign="top"><p><strong>Wednesday</strong></p></td><td valign="top"><p><strong>8am-4:30pm</strong></p></td><td valign="top"><p><strong>Oct. 28</strong></p></td><td valign="top"><p><strong>Wednesday</strong></p></td><td valign="top"><p><strong>8am-4:30pm</strong></p></td></tr><tr><td valign="top"><p><strong>Oct 22</strong></p></td><td valign="top"><p><strong>Thursday</strong></p></td><td valign="top"><p><strong>8am-4:30pm</strong></p></td><td valign="top"><p><strong>Oct. 29</strong></p></td><td valign="top"><p><strong>Thursday</strong></p></td><td valign="top"><p><strong>8am-4:30pm</strong></p></td></tr><tr><td valign="top"><p><strong>Oct 23</strong></p></td><td valign="top"><p><strong>Friday</strong></p></td><td valign="top"><p><strong>8am-Noon</strong></p></td><td valign="top"><p><strong>Oct. 30</strong></p></td><td valign="top"><p><strong>Friday</strong></p></td><td valign="top"><p><strong>8am-Noon</strong></p></td></tr></tbody></table><p>&nbsp;</p><p style="margin-left: 300px;"><span style="text-decoration: underline;"><strong><span style="font-size: 18px;">Deadlines to:</span></strong></span></p><table border="1" cellpadding="0" cellspacing="0"><tbody><tr><td valign="top"><p>Register to Vote</p></td><td valign="top"><p>5pm on October 24</p></td></tr><tr><td valign="top"><p>Apply for a Vote By Mail/Absentee Ballot, UOCAVA Ballot&nbsp;</p></td><td valign="top"><p>Received by Town Clerk&rsquo;s Office by 5pm on Tuesday, October 27</p></td></tr><tr><td valign="top"><p>Hand Delivered Ballots/Ballot Drop Box</p></td><td valign="top"><p>Received by Town Clerk&rsquo;s Office by 8pm on Tuesday, November 3</p></td></tr><tr><td valign="top"><p>Domestic Ballots <strong><span style="text-decoration: underline;">Postmarked November 3</span></strong></p></td><td valign="top"><p>Received by Town Clerk&rsquo;s Office by 5pm Friday, November 6</p></td></tr><tr><td valign="top"><p>Overseas Ballots <strong><span style="text-decoration: underline;">Postmarked November 3</span></strong></p></td><td valign="top"><p>Received by Town Clerk&rsquo;s Office by 5pm Friday, November 13</p></td></tr><tr><td valign="top"><p>Vote by Absentee Ballot at Town Clerk&rsquo;s Office</p></td><td valign="top"><p>Noon on Monday, November 2</p></td></tr></tbody></table><p><strong><span style="font-size: 14px;"> </span></strong><strong><span style="font-size: 14px;">Ballots can <span style="text-decoration: underline;">only</span> be returned to Town Clerk&rsquo;s Office. Ballots <span style="text-decoration: underline;">can not</span> be accepted at polling locations.</span></strong></p><div data-containerid="37d4c8b1-7da0-4847-9d7d-cf18d9928a73" style="box-sizing: border-box; margin: -1em; color: rgb(96, 96, 96); font-family: Poppins; font-size: 15.2px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><div style="box-sizing: border-box; position: relative; z-index: 1;"><div data-widgetcontainerid="caa707d9-ef72-4ee3-a6c6-33e5361f37c1" style="box-sizing: border-box; margin: 0px; position: relative; z-index: 1; float: left; clear: none; padding: 0px; width: 749.969px; height: auto;"><div style="box-sizing: border-box; position: relative; z-index: 1;"><div data-widgetcontainerid="06c12ed1-d0b4-4fc1-858f-781386017ecd" style="box-sizing: border-box; margin: 0px; position: relative; z-index: 1; float: left; clear: none; padding: 1em; width: 749.969px; height: 1235px;"><div data-elementqueryclasses='{"wide-narrow":"min-width:25em"}' style="box-sizing: border-box; position: relative; z-index: 1; text-align: left; overflow-wrap: break-word;"><div style="box-sizing: border-box; overflow-wrap: break-word; cursor: auto !important;"><h1 id="isPasted" style="box-sizing: border-box; font-size: 1.4em; font-style: normal; font-weight: bold; color: rgb(96, 96, 96); font-family: Poppins; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 24px; font-family: inherit; vertical-align: baseline; outline: 0px; color: rgb(0, 0, 0);">TUESDAY NOV. 3, 2026 - POLLS ARE OPEN 7 AM TO 8PM</span><strong style="box-sizing: border-box; font-weight: 700;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 24px; font-family: inherit; vertical-align: baseline; outline: 0px;"> </span></strong></h1><p style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none;"><strong style="box-sizing: border-box; font-weight: 700;">Click&nbsp;</strong><a href="https://shrewsburyma.gov/349/Election-Voter-Information" style="box-sizing: border-box; color: rgb(22, 127, 171); text-decoration: underline;"><strong style="box-sizing: border-box; font-weight: 700;">HERE</strong></a><strong style="box-sizing: border-box; font-weight: 700;">&nbsp;for polling locations and election and voter information</strong></p><p style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none;"><br></p><p id="isPasted" style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none; color: rgb(96, 96, 96); font-family: Poppins; font-size: 15.2px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-align: center;"><strong style="box-sizing: border-box; font-weight: 700;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 19px; font-family: Cambria, serif; vertical-align: baseline; outline: 0px;"> </span></strong><strong style="box-sizing: border-box; font-weight: 700;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15.2px; font-family: inherit; vertical-align: baseline; outline: 0px; text-decoration: underline;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 19px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;">Voter Registration Deadline</span></span></strong></p><p style="box-sizing: border-box; margin: 0in 0in 0.0001pt; border: 0px none; color: rgb(96, 96, 96); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; font-size: 15px; font-family: Calibri, sans-serif; text-align: center;"><br style="box-sizing: border-box;"></p><p style="box-sizing: border-box; margin: 0in 0in 0.0001pt; border: 0px none; color: rgb(96, 96, 96); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; font-size: 15px; font-family: Calibri, sans-serif; text-align: center;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;"><strong style="box-sizing: border-box; font-weight: 700;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 16px; font-family: inherit; vertical-align: baseline; outline: 0px;">The last day to register to vote is Saturday, October 24 at 5pm.</span></strong></span></p><p style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none; color: rgb(96, 96, 96); font-family: Poppins; font-size: 15.2px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-align: center;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15.2px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;">More information about registering to vote can be found<a href="https://shrewsburyma.gov/349/Election-Voter-Information" style="box-sizing: border-box; color: rgb(22, 127, 171); text-decoration: underline;">&nbsp;HERE.</a><br style="box-sizing: border-box;"></span></p><p style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none; color: rgb(96, 96, 96); font-family: Poppins; font-size: 15.2px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15.2px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;">&nbsp;You can find more information on who qualifies for an absentee ballot <a href="https://www.sec.state.ma.us/ele/eleabsentee/absidx.htm" style="box-sizing: border-box; color: rgb(22, 127, 171); text-decoration: underline;">HERE</a>. &nbsp;The last day to request an Absentee ballot by mail is Tuesday, October 29 at 5PM. &nbsp;The last day to apply for Absentee Ballot in person is Monday, November 4 at Noon at the Town Clerk&apos;s Office.</span></p><p style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none; color: rgb(96, 96, 96); font-family: Poppins; font-size: 15.2px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15.2px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;">More information about registering to vote can be found<a href="https://shrewsburyma.gov/349/Election-Voter-Information" style="box-sizing: border-box; color: rgb(22, 127, 171); text-decoration: underline;">&nbsp;HERE.</a></span></p><p style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none; color: rgb(96, 96, 96); font-family: Poppins; font-size: 15.2px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15.2px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;"><strong style="box-sizing: border-box; font-weight: 700;">Not sure of your precinct? Find your precinct and polling location at:</strong> <a href="https://www.sec.state.ma.us/wheredoivotema/bal/myelectioninfo.aspx" style="box-sizing: border-box; color: rgb(22, 127, 171); text-decoration: underline;">https://www.sec.state.ma.us/wheredoivotema/bal/myelectioninfo.aspx</a></span></p><p style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none; color: rgb(96, 96, 96); font-family: Poppins; font-size: 15.2px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15.2px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;"><strong style="box-sizing: border-box; font-weight: 700;">Specimen Ballots:</strong></span></p><p style="box-sizing: border-box; margin-top: 0px; margin-bottom: 1.4em; border: 0px none; color: rgb(96, 96, 96); font-family: Poppins; font-size: 15.2px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;"><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15.2px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;"><strong style="box-sizing: border-box; font-weight: 700;">2026 Ballot Question Guide:&nbsp;</strong></span><span style="box-sizing: border-box; margin: 0px; padding: 0px; border: 0px; font-weight: inherit; font-style: inherit; font-size: 15.2px; font-family: Arial, Helvetica, sans-serif; vertical-align: baseline; outline: 0px;"><a href="https://ma.omniballot.us/sites/25/vg/app/vig/voter-guide/info" target="_blank" rel="noopener"><strong style="box