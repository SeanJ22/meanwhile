	<div class="inner col col24 first last id5ff82da1-da06-4373-b689-45287678b162" style="" data-widgetcontainerid="5ff82da1-da06-4373-b689-45287678b162">	



	<section class="widget widgetRelatedDocuments skin57 narrow" id="widgetRelDoc05db9798-2b7f-4533-ad93-474023d59b96" data-widgetid="05db9798-2b7f-4533-ad93-474023d59b96" data-sections="[{&quot;Title&quot;:&quot;ELECTION RESULTS&quot;,&quot;DocumentIDs&quot;:&quot;1560,1947,4254,4311,4360,4371,4483,4604,4888,5637,5918,5987,&quot;,&quot;FolderIds&quot;:&quot;,&quot;,&quot;SortedDocumentIds&quot;:&quot;5987,5918,5637,4888,4604,4483,4371,4360,4311,4254,&quot;},{&quot;Title&quot;:&quot;How Do I Run For An Elected Office In Town?&quot;,&quot;DocumentIDs&quot;:&quot;5641,5999,&quot;,&quot;FolderIds&quot;:&quot;,&quot;,&quot;SortedDocumentIds&quot;:&quot;5999,5641,&quot;},{&quot;Title&quot;:&quot;How Do I Run For Dem./Rep. Town Committee?&quot;,&quot;DocumentIDs&quot;:&quot;4312,&quot;,&quot;FolderIds&quot;:&quot;,&quot;,&quot;SortedDocumentIds&quot;:&quot;4312,&quot;}]" data-columncount="1" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}' data-elementquerymatch='matchMultiColumn' data-elementqueryunmatch='unmatchMultiColumn' aria-label="Related Documents">
			<div id="divRelatedDocuments_05db9798-2b7f-4533-ad93-474023d59b96" class="relatedDocuments">
		<div class="widgetBody cpGrid cpGrid1">
			
<div class="row narrow sortableWidgetTitle">
        <div class="relatedDocumentsSection selfClear" data-documentids="1560,1947,4254,4311,4360,4371,4483,4604,4888,5637,5918,5987," data-folderids="," data-sorteddocumentids="5987,5918,5637,4888,4604,4483,4371,4360,4311,4254,">
                    <h3 class="widgetTitle" style="clear:left;">ELECTION RESULTS</h3>

	<div class=" first last">
		<ol class="semanticList bullets" style="min-height:8px;">
					<li class="widgetItem" data-documentid="5987"><a target="_blank" href="/DocumentCenter/View/5987/DCRSD-Special-Election---September-2026-PDF" class="fileType pdf" aria-label="DCRSD Special Election - September 2026 (PDF) pdf file">DCRSD Special Election - September 2026 (PDF)</a>
					</li>
