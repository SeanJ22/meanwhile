x","type":"STRING","name":"Xmax"},{"jimuName":"Ymin","alias":"Ymin","type":"STRING","name":"Ymin"},{"jimuName":"Ymax","alias":"Ymax","type":"STRING","name":"Ymax"},{"jimuName":"ExInfo","alias":"ExtraInfo","type":"STRING","name":"ExInfo"},{"jimuName":"Ref_ID","alias":"Ref_ID","type":"STRING","name":"Ref_ID"}],"displayFields":[{"jimuName":"default_address","alias":"Default Address","type":"STRING","name":"default_address"}],"defaultAddressFieldName":"default_address"}],"isAutoSelectFirstResult":false},"id":"widget_268","useUtilities":[{"utilityId":"utility_4"}],"outputDataSources":["widget_268_output_config_default_geocode_utility_4_0"],"useDataSources":[]},"widget_281":{"uri":"widgets/layout/row/","version":"1.18.0","label":"Row 2","config":{"space":10,"style":{"padding":{"number":[10],"unit":"px"}}},"id":"widget_281","layouts":{"DEFAULT":{"LARGE":"layout_164"}}},"widget_283":{"uri":"widgets/common/text/","version":"1.18.0","label":"Text 29","config":{"text":"<p style=\"text-align: center;\"><span style=\"font-size: 50px; color: var(--org-header-color);\">Baltimore County Council - Councilmanic Redistricting</span></p>","style":{"wrap":true}},"id":"widget_283"},"widget_377":{"uri":"widgets/layout/grid/","version":"1.18.0","label":"Grid","config":{},"id":"widget_377","layouts":{"DEFAULT":{"LARGE":"layout_229"}},"style":{"borderRadius":null,"border":{"color":"var(--light-300)","type":"solid","width":"2px"},"background":{"color":"var(--org-header-bg)","fillType":"fill","image":{"url":""}}}},"widget_378":{"uri":"widgets/layout/row/","version":"1.18.0","label":"About this application","config":{"space":10,"style":{"padding":{"number":[10],"unit":"px"}}},"id":"widget_378","layouts":{"DEFAULT":{"LARGE":"layout_230"}},"style":{"background":{"color":"var(--org-header-bg)","fillType":"fill","image":{"url":"https://bcgis.baltimorecountymd.gov/myneighborhoodfiles/courthouse.jpg","originalUrl":"https://bcgis.baltimorecountymd.gov/myneighborhoodfiles/courthouse.jpg","fileName":"courthouse.jpg","originalName":"courthouse.jpg","imgSourceType":"BY_URL"}}}},"widget_379":{"uri":"widgets/common/text/","version":"1.18.0","label":"Text 30","config":{"text":"<p style=\"text-align: center;\"><span style=\"font-size: 50px; color: var(--org-header-color);\">About this Application</span></p>","style":{"wrap":true,"color":"var(--org-header-color)"}},"id":"widget_379"},"widget_382":{"uri":"widgets/common/text/","version":"1.18.0","label":"Interactive Application","config":{"text":"<p style=\"text-align: center;\"><strong style=\"font-size: 24px; color: var(--light);\">Council Expansion and Redistricting</strong></p><p style=\"text-align: left;\"><span style=\"color: var(--org-header-color); font-size: 20px;\">On July 1, 2024 the County Council enacted </span><strong style=\"color: var(--org-header-color); font-size: 20px;\">Bill 47-24</strong><span style=\"color: var(--org-header-color); font-size: 20px;\"> which amended the Baltimore County Charter to increase the number of Council districts and Council members from seven to nine starting with the 2026 election. On November 5, 2024, the voters of Baltimor</span><span style=\"color: var(--org-header-color); font-size: 20px; background-color: rgba(0, 0, 0, 0);\">e County approved the Charter amendments enacted in Bill 47-24. Bill 47-24 specifically amended Charter Section 206 to state “revisions of council districts … may only occur: before October 1, 2025.</span><span style=\"color: var(--org-header-color); font-size: 20px; background-color: rgba(0, 0, 0, 0); font-family: &quot;Avenir Next&quot;;\">” More information regarding the Council expansion and Councilmanic redistricting process may be found </span><u style=\"color: var(--org-header-color); font-size: 20px; background-color: rgba(0, 0, 0, 0); font-family: &quot;Avenir Next&quot;;\"><a href=\"https://countycouncil.baltimorecountymd.gov/redistricting/\" target=\"_blank\" data-uniqueid=\"60c16dea_a3cf_0ad1_915f_5ac693565f5e\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncil.baltimorecountymd.gov%2Fredistricting%2F%20%22%2C%22expression%22%3Anull%7D\">here</a></u><span style=\"color: var(--org-header-color); font-size: 20px; background-color: rgba(0, 0, 0, 0); font-family: &quot;Avenir Next&quot;;\">.</span></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: center;\"><strong style=\"font-size: 24px; color: var(--light);\">2025 Redistricting Commission </strong></p><p style=\"text-align: center;\"><span style=\"font-size: 20px; font-family: &quot;Avenir Next&quot;; color: var(--light);\">Charter Section 207 requires that the Council establish a redistricting commission to recommend legislation to revise the Councilmanic districts. Accordingly, the Council formed the 2025 Redistricting Commission in December, 2024. The Commission submitted its final report and recommendations to the County Council on June 17, 2025. More information regarding the 2025 Redistricting Commission may be found </span><u style=\"font-size: 20px; font-family: &quot;Avenir Next&quot;; color: var(--light);\"><a href=\"https://countycouncil.baltimorecountymd.gov/redistricting/2025-redistricting-commission/\" target=\"_blank\" data-uniqueid=\"34c10eca_9444_d01b_f129_8f1007187511\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncil.baltimorecountymd.gov%2Fredistricting%2F2025-redistricting-commission%2F%20%20%22%2C%22expression%22%3Anull%7D\">here</a></u><span style=\"font-size: 20px; font-family: &quot;Avenir Next&quot;; color: var(--light);\">. </span></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong style=\"color: var(--light); font-size: 24px;\">Interactive Application</strong></p><p><span style=\"color: var(--light); font-size: 20px;\">Please utilize the tabs at the top of the application to navigate through map iterations. Note that as more maps are released to the public, this application will reflect those changes.</span></p><p><br></p><p><span style=\"color: var(--light); font-size: 20px;\">﻿On each map tab, utilize the 'About', 'Map Layers', and 'Legend' tabs to interact with the map. </span></p><p><br></p><p><span style=\"color: var(--light); font-size: 20px;\">The 'Add Data' function will allow a user to bring in datasets from Baltimore County's Open Data Portal. When data is selected with the plus sign, it will be added to a list to add. Click the 4-circle icon, and click 'Add to Map'.</span></p><p><br></p><p style=\"text-align: left;\"><span style=\"color: var(--light); font-size: 20px;\">The 'Search' function will allow a user to search for an address within Baltimore County.</span></p>","style":{"wrap":true}},"id":"widget_382","style":{"background":{"color":"var(--org-header-bg)","fillType":"fill","image":{"url":""}}}},"widget_383":{"uri":"widgets/common/text/","version":"1.18.0","label":"2025 Redistricting Commission","config":{"text":"<p style=\"text-align: center;\"><strong style=\"font-size: 24px; color: var(--light);\"> Bill 55-25</strong><span style=\"font-size: 20px; color: var(--light); background-color: rgba(0, 0, 0, 0);\">﻿</span></p><p><span style=\"font-size: 20px; color: var(--light);\">On August 4, 2025, the County Council introduced </span><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.pdf\" target=\"_blank\" data-uniqueid=\"a0fc46ba_2a98_af89_a14f_ced6f6040be2\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.pdf%20%22%2C%22expression%22%3Anull%7D\" style=\"font-size: 20px; color: var(--light);\">Bill 55-25</a><span style=\"font-size: 20px; color: var(--light);\"> which revises the councilmanic districts into nine districts for the 2026 election. The bill describes the boundaries of each district by precinct or census blocks within a precinct. </span></p><p><br></p><p><span style=\"font-size: 20px; color: var(--org-header-color); font-family: &quot;Avenir Next&quot;, serif;\">The County Council held three public hearings on redistricting. The first on July 8, 2025 prior to the introduction of Bill 55-25, the second at the Council’s Work Session on August 26, 2025, and the third at the Council’s Work Session on September 9, 2025. In addition, members of the public testified on Bill 55-25 after the Council’s Legislative Sessions in July, August, and September, 2025. </span></p><p><br></p><p><span style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;, serif; font-size: 20px;\">The County Council approved an amended version of </span><strong style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;, serif; font-size: 20px;\"><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills 2025/b05525.pdf\" target=\"_blank\" data-uniqueid=\"e0febf42_87eb_0dc0_5ffc_019aded97e58\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%202025%2Fb05525.pdf%22%2C%22expression%22%3Anull%7D\">Bill 55-25</a></u></strong><span style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;, serif; font-size: 20px;\"> at the Legislative Session on September 15, 2025 by a vote of 5-2. This application shows the final amended version of the map. </span></p><p><span style=\"color: var(--light); font-size: 20px;\">Bill 55-25 has two exhibits: </span><strong style=\"color: var(--light); font-size: 20px;\"><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.exhibit%20A.pdf\" target=\"_blank\" data-uniqueid=\"def247b3_809a_5504_1be4_5a2026bbd9cb\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.exhibit%2520A.pdf%20%22%2C%22expression%22%3Anull%7D\">Exhibit A</a></u> </strong><span style=\"color: var(--light); font-size: 20px;\">– the Proposed Map of nine Council districts; and </span><strong style=\"color: var(--light); font-size: 20px;\"><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.exhibit%20B.pdf\" target=\"_blank\" data-uniqueid=\"48eae15d_e9dc_4e85_e3fd_3bff54ef5bd9\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.exhibit%2520B.pdf%20%22%2C%22expression%22%3Anull%7D\">Exhibit B</a></u></strong><span style=\"color: var(--light); font-size: 20px;\"> – the Population and Demographic S</span><span style=\"color: var(--org-header-color); font-size: 20px; font-family: &quot;Avenir Next&quot;;\">ummary for the proposed map. </span></p><p><br></p><p><span style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;; font-size: 20px;\">Data on Bill 55-25, including the initial version introduced on August 4 and all amendments, is available in downloadable formats on Baltimore County's Open data portal </span><strong style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;; font-size: 20px;\"><u><a href=\"https://opendata.baltimorecountymd.gov/search?q=bill%2055-25\" target=\"_blank\" data-uniqueid=\"736dd92a_8a98_176b_5e24_c3106e49eec6\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fopendata.baltimorecountymd.gov%2Fsearch%3Fq%3Dbill%252055-25%22%2C%22expression%22%3Anull%7D\">here</a></u></strong><span style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;; font-size: 20px;\">. </span><span style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;, serif; font-size: 20px;\">For more information on amendments, please contact the County Council via e-mail at </span><strong style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;, serif; font-size: 20px;\"><u><a href=\"mailto:countycouncil@baltimorecountymd.gov\" target=\"_self\" data-uniqueid=\"\" data-dsid=\"\" data-link=\"null\">countycouncil@baltimorecountymd.gov</a></u></strong><span style=\"color: var(--org-header-color); font-family: &quot;Avenir Next&quot;, serif; font-size: 20px;\">.&nbsp;</span></p><p><br></p><p><span style=\"font-size: 20px; font-family: &quot;Avenir Next&quot;, serif; color: var(--org-header-color);\">The Councilmanic district boundaries approved in Bill 55-25 will be effective for the 2026 and 2030 County Council elections. For constituent issues, the current seven-district boundaries remain effective until the members elected from the 2026 election are sworn in. </span></p><p><br></p><p style=\"text-align: center;\"><strong style=\"color: var(--light); font-size: 24px;\">Council Hearing Recording</strong></p><p style=\"text-align: center;\"><span style=\"background-color: rgba(0, 0, 0, 0); color: var(--light); font-size: 20px;\">Click on the date to access the corresponding council hearing recording:</span></p><p style=\"text-align: center;\"><strong style=\"font-size: 20px; color: var(--light); background-color: rgba(0, 0, 0, 0);\"><u><a href=\"https://www.youtube.com/watch?v=h9P2jj-R7jo\" target=\"_blank\" data-uniqueid=\"49e1c7f4_4126_7527_a18f_a1a151c7571d\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3Dh9P2jj-R7jo%20%22%2C%22expression%22%3Anull%7D\">July 8, 2025</a></u></strong></p><p style=\"text-align: center;\"><strong style=\"font-size: 20px; color: var(--light); background-color: rgba(0, 0, 0, 0);\"><u><a href=\"https://www.youtube.com/watch?v=gp1VtkVJ-fA\" target=\"_blank\" data-uniqueid=\"c8d2a0d4_009d_1ca7_5fcd_adf17b846be2\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3Dgp1VtkVJ-fA%20%22%2C%22expression%22%3Anull%7D\">August 4, 2025</a></u></strong></p><p style=\"text-align: center;\"><strong style=\"font-size: 20px; color: var(--light); background-color: rgba(0, 0, 0, 0);\"><u><a href=\"https://www.youtube.com/watch?v=BhJ0-fUhkho\" target=\"_blank\" data-uniqueid=\"2dbccd24_8919_2090_207f_6c884b547782\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3DBhJ0-fUhkho%22%2C%22expression%22%3Anull%7D\">August 26, 2025</a></u></strong></p><p style=\"text-align: center;\"><strong style=\"font-size: 20px; color: var(--light); background-color: rgba(0, 0, 0, 0);\"><u><a href=\"https://www.youtube.com/watch?v=-TMh5CyQWFs\" target=\"_blank\" data-uniqueid=\"73659f7f_faf2_9906_ae04_b30b0c0b88a6\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3D-TMh5CyQWFs%20%22%2C%22expression%22%3Anull%7D\">September 2, 2025</a></u></strong></p><p style=\"text-align: center;\"><strong style=\"font-size: 20px; color: var(--light); background-color: rgba(0, 0, 0, 0);\"><u><a href=\"https://www.youtube.com/watch?v=84CRTCM4Z5M\" target=\"_blank\" data-uniqueid=\"ca846168_bcf8_ff51_2441_60982ed2abd5\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3D84CRTCM4Z5M%20%22%2C%22expression%22%3Anull%7D\">September 9, 2025</a></u></strong></p><p style=\"text-align: center;\"><strong style=\"font-size: 20px; color: var(--light); background-color: rgba(0, 0, 0, 0);\"><u><a href=\"https://www.youtube.com/watch?v=gz3kJwEXr9A\" target=\"_blank\" data-uniqueid=\"9ebc7dd0_23d1_2e79_db80_3a64c36057cf\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fwww.youtube.com%2Fwatch%3Fv%3Dgz3kJwEXr9A%20%22%2C%22expression%22%3Anull%7D\">September 15, 2025</a></u></strong></p>","style":{"wrap":true}},"id":"widget_383","style":{"background":{"color":"var(--org-header-bg)","fillType":"fill","image":{"url":""}}}},"widget_392":{"uri":"widgets/arcgis/arcgis-map/","version":"1.18.0","label":"Bill 55-25","config":{"toolConfig":{"canZoom":true,"canHome":true,"canSearch":false,"canNavigation":true,"canBaseMap":true,"canSelect":true,"canSelectState":true,"canLayers":false,"canScaleBar":true},"isUseCustomMapState":false,"initialMapState":null,"initialMapDataSourceID":"dataSource_8","layoutIndex":1,"scaleRange":null},"id":"widget_392","layouts":{"MapFixedLayout":{"LARGE":"layout_235"}},"useDataSources":[{"dataSourceId":"dataSource_3","mainDataSourceId":"dataSource_3"},{"dataSourceId":"dataSource_8","mainDataSourceId":"dataSource_8"}],"enableDataAction":false},"widget_393":{"uri":"widgets/common/controller/","version":"1.18.0","label":"Widget Controller","config":{"behavior":{"onlyOpenOne":true,"openStarts":[],"displayType":"STACK","vertical":false,"size":{}},"appearance":{"space":0,"advanced":false,"card":{"showLabel":false,"labelGrowth":10,"avatar":{"type":"primary","size":"default","shape":"circle"}}}},"id":"widget_393","layouts":{"controller":{"LARGE":"layout_236"}}},"widget_394":{"uri":"widgets/common/search/","version":"1.18.0","offPanel":true,"label":"Search","config":{"searchResultView":"Result_Panel","arrangementStyle":"Style1","searchResultStyle":"Classic","maxSuggestions":1,"recentSearchesMaxNumber":6,"resultMaxNumber":1,"enableFiltering":false,"sourceType":"MapCentric","dataSourceConfigWithMapCentric":{"widget_392-dataSource_3":null,"widget_392-dataSource_7":null},"datasourceConfig":[],"isAutoSelectFirstResult":true},"id":"widget_394","useUtilities":[],"useMapWidgetIds":["widget_392"]},"widget_395":{"uri":"widgets/common/add-data/","version":"1.18.0","label":"Add Data","config":{"itemCategoriesInfo":[{"type":"MY_CONTENT","customLabel":"","enabled":false,"id":"MY_CONTENT"},{"type":"MY_GROUP","customLabel":"","enabled":false,"id":"MY_GROUP"},{"type":"MY_ORGANIZATION","customLabel":"Baltimore County Open Data","enabled":false,"id":"MY_ORGANIZATION"},{"type":"PUBLIC","customLabel":"","enabled":false,"id":"PUBLIC"},{"type":"LIVING_ATLAS","customLabel":"","enabled":false,"id":"LIVING_ATLAS"},{"type":"CURATED","customLabel":"Baltimore County Open Data","enabled":true,"curatedFilter":"group:a6e5c206c5b9439aa95faeadd41e2a61","id":"CURATED_1"}],"disableRenaming":true,"placeholderText":"There is currently no added data. Click the button below to add data. Once added to list, click the 4-circle icon to add it to the map."},"id":"widget_395","dataActions":{"dataStatistics":{"enabled":false}}},"widget_396":{"uri":"widgets/arcgis/swipe/","version":"1.18.0","label":"Swipe","config":{"swipeStyle":"SIMPLE_HORIZONTAL","swipeMode":"SWIPE_BETWEEN_WEBMAPS_OR_WEBSCENES","mapUseDataSourcesOrderList":[],"styleConfig":{"defaultActivation":true,"detailsVisibility":false},"swipeMapViewList":{},"scrollMapViewList":{}},"id":"widget_396","useMapWidgetIds":["widget_392"],"offPanel":true},"widget_397":{"uri":"widgets/arcgis/legend/","version":"1.18.0","label":"Legend","config":{"showBaseMap":false,"cardStyle":false,"style":{"useCustom":true},"respectLayerDefinitionExp":false},"id":"widget_397","useMapWidgetIds":["widget_392"]},"widget_398":{"uri":"widgets/arcgis/map-layers/","version":"1.18.0","label":"Map Layers","config":{"useMapWidget":true,"customizeLayerOptions":{"widget_392-dataSource_1":{"isEnabled":true,"hiddenJimuLayerViewIds":[]}},"setVisibility":true,"information":true},"id":"widget_398","useMapWidgetIds":["widget_392"],"enableDataAction":false},"widget_399":{"uri":"widgets/common/text/","version":"1.18.0","label":"About","config":{"text":"<p style=\"text-align: center;\"><strong>About </strong></p><p style=\"text-align: center;\">On August 4, 2025, the County Council introduced <strong><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.pdf\" target=\"_blank\" data-uniqueid=\"ad01208d_b9e2_8083_5f41_41ff24c0d5be\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.pdf%22%2C%22expression%22%3Anull%7D\">Bill 55-25</a></u></strong> which revises and reconstitutes the councilmanic districts into nine districts for the 2026 election. Bill 55-25 has two exhibits: <strong><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.exhibit%20A.pdf\" target=\"_blank\" data-uniqueid=\"32e720fd_b0bb_ca46_e4a0_9b26b93db36b\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.exhibit%2520A.pdf%22%2C%22expression%22%3Anull%7D\">Exhibit A</a></u> </strong>– the Proposed Map of nine Council districts; and <strong><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.exhibit%20B.pdf\" target=\"_blank\" data-uniqueid=\"66aa1519_12bb_f0e0_83a1_025535b42077\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.exhibit%2520B.pdf%20%22%2C%22expression%22%3Anull%7D\">Exhibit B</a></u></strong> – the Population and Demographic Summary for the proposed map.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">The County Council will hold two public hearings where members of the public may provide input on Bill 55-25 and the map.&nbsp;The first will be at the Council’s Work Session on August 28, 2025 at 4:00 p.m. and the second will be at the Council’s Work Session on September 9, 2025 at 4:00 p.m. The Council’s final adoption of Bill 55-25 is currently scheduled during the Legislative Session on September 15, 2025 at 6:00 p.m.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">In addition to, or in lieu of, providing verbal testimony, the public may submit written testimony to the County Council at any time via e-mail at <a href=\"mailto:countycouncil@baltimorecountymd.gov\" target=\"_self\" data-uniqueid=\"\" data-dsid=\"\" data-link=\"null\">countycouncil@baltimorecountymd.gov</a></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">This data is available in downloadable formats on Baltimore County's Open Data portal <strong style=\"color: var(--primary);\"><u><a href=\"https://opendata.baltimorecountymd.gov/datasets/afc6305fb55a4ec3b5250c613874a79f/\" target=\"_blank\" data-uniqueid=\"6bbd9668_1e58_5b9d_4022_0f5a1b72cc59\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fopendata.baltimorecountymd.gov%2Fdatasets%2Fafc6305fb55a4ec3b5250c613874a79f%2F%22%2C%22expression%22%3Anull%7D\">here</a>.</u></strong></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong>Note </strong></p><p style=\"text-align: center;\">When using the 'SWIPE' widget, the right map represents the current 2022 councilmanic districts. The left map represents the Bill 55-25 districts.</p>","style":{"verticalAlign":"start","wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_399"},"widget_416":{"uri":"widgets/arcgis/arcgis-map/","version":"1.18.0","label":"Proposed Amendment - Patoka/Ertel","config":{"toolConfig":{"canZoom":true,"canHome":true,"canSearch":false,"canNavigation":true,"canBaseMap":true,"canSelect":true,"canSelectState":true,"canLayers":false,"canScaleBar":true},"isUseCustomMapState":false,"initialMapState":null,"initialMapDataSourceID":"dataSource_9","layoutIndex":1,"scaleRange":null},"id":"widget_416","layouts":{"MapFixedLayout":{"LARGE":"layout_244"}},"useDataSources":[{"dataSourceId":"dataSource_8","mainDataSourceId":"dataSource_8"},{"dataSourceId":"dataSource_9","mainDataSourceId":"dataSource_9"}],"enableDataAction":false},"widget_417":{"uri":"widgets/common/controller/","version":"1.18.0","label":"Widget Controller","config":{"behavior":{"onlyOpenOne":true,"openStarts":[],"displayType":"STACK","vertical":false,"size":{}},"appearance":{"space":0,"advanced":false,"card":{"showLabel":false,"labelGrowth":10,"avatar":{"type":"primary","size":"default","shape":"circle"}}}},"id":"widget_417","layouts":{"controller":{"LARGE":"layout_245"}}},"widget_418":{"uri":"widgets/common/search/","version":"1.18.0","offPanel":true,"label":"Search","config":{"searchResultView":"Result_Panel","arrangementStyle":"Style1","searchResultStyle":"Classic","maxSuggestions":1,"recentSearchesMaxNumber":6,"resultMaxNumber":1,"enableFiltering":false,"sourceType":"MapCentric","dataSourceConfigWithMapCentric":{"widget_416-dataSource_8":null,"widget_416-dataSource_9":null},"datasourceConfig":[],"isAutoSelectFirstResult":true},"id":"widget_418","useUtilities":[],"useMapWidgetIds":["widget_416"]},"widget_419":{"uri":"widgets/common/add-data/","version":"1.18.0","label":"Add Data","config":{"itemCategoriesInfo":[{"type":"MY_CONTENT","customLabel":"","enabled":false,"id":"MY_CONTENT"},{"type":"MY_GROUP","customLabel":"","enabled":false,"id":"MY_GROUP"},{"type":"MY_ORGANIZATION","customLabel":"Baltimore County Open Data","enabled":false,"id":"MY_ORGANIZATION"},{"type":"PUBLIC","customLabel":"","enabled":false,"id":"PUBLIC"},{"type":"LIVING_ATLAS","customLabel":"","enabled":false,"id":"LIVING_ATLAS"},{"type":"CURATED","customLabel":"Baltimore County Open Data","enabled":true,"curatedFilter":"group:a6e5c206c5b9439aa95faeadd41e2a61","id":"CURATED_1"}],"disableRenaming":true,"placeholderText":"There is currently no added data. Click the button below to add data. Once added to list, click the 4-circle icon to add it to the map."},"id":"widget_419","dataActions":{"dataStatistics":{"enabled":false}}},"widget_420":{"uri":"widgets/arcgis/swipe/","version":"1.18.0","label":"Swipe","config":{"swipeStyle":"SIMPLE_HORIZONTAL","swipeMode":"SWIPE_BETWEEN_WEBMAPS_OR_WEBSCENES","mapUseDataSourcesOrderList":["dataSource_8","dataSource_9"],"styleConfig":{"defaultActivation":false,"detailsVisibility":false},"swipeMapViewList":{},"scrollMapViewList":{}},"id":"widget_420","useMapWidgetIds":["widget_416"],"offPanel":true},"widget_421":{"uri":"widgets/arcgis/legend/","version":"1.18.0","label":"Legend","config":{"showBaseMap":false,"cardStyle":false,"style":{"useCustom":true},"respectLayerDefinitionExp":false},"id":"widget_421","useMapWidgetIds":["widget_416"]},"widget_422":{"uri":"widgets/arcgis/map-layers/","version":"1.18.0","label":"Map Layers","config":{"useMapWidget":true,"customizeLayerOptions":{"widget_416-dataSource_1":{"isEnabled":true,"hiddenJimuLayerViewIds":[]}},"setVisibility":true,"information":true},"id":"widget_422","useMapWidgetIds":["widget_416"],"enableDataAction":false},"widget_423":{"uri":"widgets/common/text/","version":"1.18.0","label":"About","config":{"text":"<p style=\"text-align: center;\"><strong>About </strong></p><p style=\"text-align: center;\">On August 4, 2025, the County Council introduced Bill 55-25 which revises and reconstitutes the councilmanic districts into nine districts for the 2026 election. Bill 55-25 has two exhibits: Exhibit A<strong><a href=\"https://bc-gis.maps.arcgis.com/sharing/rest/content/items/d21c08be86d24801b1d0b10b1f3ebee1/data\" target=\"_blank\" data-uniqueid=\"e4ea3243_20e9_b77e_d29a_c7f9ae33b2dd\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fbc-gis.maps.arcgis.com%2Fsharing%2Frest%2Fcontent%2Fitems%2Fd21c08be86d24801b1d0b10b1f3ebee1%2Fdata%22%2C%22expression%22%3Anull%7D\"> </a></strong>– the Proposed Map of nine Council districts; and Exhibit B – the Population and Demographic Summary for the proposed map.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">On September 9, 2025, Councilmembers Izzy Patoka and Mike Ertel proposed an amendment to Bill 55-25. The proposed amendment would modify the text of Bill 55-25 as well as <strong><u><a href=\"https://bc-gis.maps.arcgis.com/sharing/rest/content/items/84b3138b8b6f4f0888f2327ed79b8f83/data\" target=\"_blank\" data-uniqueid=\"986c7977_ff97_ed45_542c_66de73f3a65a\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fbc-gis.maps.arcgis.com%2Fsharing%2Frest%2Fcontent%2Fitems%2F84b3138b8b6f4f0888f2327ed79b8f83%2Fdata%22%2C%22expression%22%3Anull%7D\">Exhibit A</a></u></strong> and <strong><u><a href=\"https://bc-gis.maps.arcgis.com/sharing/rest/content/items/99bd76ccf5e84dd89ce47d782edaa96d/data\" target=\"_blank\" data-uniqueid=\"4ba60d25_eb82_3aef_30d3_125a465c1f9d\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fbc-gis.maps.arcgis.com%2Fsharing%2Frest%2Fcontent%2Fitems%2F99bd76ccf5e84dd89ce47d782edaa96d%2Fdata%22%2C%22expression%22%3Anull%7D\">Exhibit B</a></u></strong>.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">The County Council will hold two public hearings where members of the public may provide input on Bill 55-25 and the map.&nbsp;The first will be at the Council’s Work Session on August 28, 2025 at 4:00 p.m. and the second will be at the Council’s Work Session on September 9, 2025 at 4:00 p.m. The Council’s final adoption of Bill 55-25 is currently scheduled during the Legislative Session on September 15, 2025 at 6:00 p.m.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">In addition to, or in lieu of, providing verbal testimony, the public may submit written testimony to the County Council at any time via e-mail at <a href=\"mailto:countycouncil@baltimorecountymd.gov\" target=\"_self\" data-uniqueid=\"\" data-dsid=\"\" data-link=\"null\">countycouncil@baltimorecountymd.gov</a></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">This data is available in downloadable formats on Baltimore County's Open Data portal <strong style=\"color: var(--primary);\"><u><a href=\"https://opendata.baltimorecountymd.gov/datasets/1b4ed4b2e003400fba5675770bf091a9/explore?location=39.438203%2C-76.591645%2C11.00\" target=\"_blank\" data-uniqueid=\"78fbc50d_bdd0_29d0_9cee_9c74ae95c68c\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fopendata.baltimorecountymd.gov%2Fdatasets%2F1b4ed4b2e003400fba5675770bf091a9%2Fexplore%3Flocation%3D39.438203%252C-76.591645%252C11.00%22%2C%22expression%22%3Anull%7D\">here</a>.</u></strong></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong>Note </strong></p><p style=\"text-align: center;\">When using the 'SWIPE' widget, the right map represents the Bill 55-25 districts. The left map represents the 9/9/25 Proposed Amendment districts.</p>","style":{"verticalAlign":"start","wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_423"},"widget_432":{"uri":"widgets/arcgis/arcgis-map/","version":"1.18.0","label":"Proposed Amendment - Jones","config":{"toolConfig":{"canZoom":true,"canHome":true,"canSearch":false,"canNavigation":true,"canBaseMap":true,"canSelect":true,"canSelectState":true,"canLayers":false,"canScaleBar":true},"isUseCustomMapState":false,"initialMapState":null,"initialMapDataSourceID":"dataSource_11","layoutIndex":1,"scaleRange":null},"id":"widget_432","layouts":{"MapFixedLayout":{"LARGE":"layout_250"}},"useDataSources":[{"dataSourceId":"dataSource_10","mainDataSourceId":"dataSource_10"},{"dataSourceId":"dataSource_11","mainDataSourceId":"dataSource_11"}],"enableDataAction":false},"widget_433":{"uri":"widgets/common/controller/","version":"1.18.0","label":"Widget Controller","config":{"behavior":{"onlyOpenOne":true,"openStarts":[],"displayType":"STACK","vertical":false,"size":{}},"appearance":{"space":0,"advanced":false,"card":{"showLabel":false,"labelGrowth":10,"avatar":{"type":"primary","size":"default","shape":"circle"}}}},"id":"widget_433","layouts":{"controller":{"LARGE":"layout_251"}}},"widget_434":{"uri":"widgets/common/search/","version":"1.18.0","offPanel":true,"label":"Search","config":{"searchResultView":"Result_Panel","arrangementStyle":"Style1","searchResultStyle":"Classic","maxSuggestions":1,"recentSearchesMaxNumber":6,"resultMaxNumber":1,"enableFiltering":false,"sourceType":"MapCentric","dataSourceConfigWithMapCentric":{"widget_432-dataSource_10":null,"widget_432-dataSource_9":null},"datasourceConfig":[],"isAutoSelectFirstResult":true},"id":"widget_434","useUtilities":[],"useMapWidgetIds":["widget_432"]},"widget_435":{"uri":"widgets/common/add-data/","version":"1.18.0","label":"Add Data","config":{"itemCategoriesInfo":[{"type":"MY_CONTENT","customLabel":"","enabled":false,"id":"MY_CONTENT"},{"type":"MY_GROUP","customLabel":"","enabled":false,"id":"MY_GROUP"},{"type":"MY_ORGANIZATION","customLabel":"Baltimore County Open Data","enabled":false,"id":"MY_ORGANIZATION"},{"type":"PUBLIC","customLabel":"","enabled":false,"id":"PUBLIC"},{"type":"LIVING_ATLAS","customLabel":"","enabled":false,"id":"LIVING_ATLAS"},{"type":"CURATED","customLabel":"Baltimore County Open Data","enabled":true,"curatedFilter":"group:a6e5c206c5b9439aa95faeadd41e2a61","id":"CURATED_1"}],"disableRenaming":true,"placeholderText":"There is currently no added data. Click the button below to add data. Once added to list, click the 4-circle icon to add it to the map."},"id":"widget_435","dataActions":{"dataStatistics":{"enabled":false}}},"widget_436":{"uri":"widgets/arcgis/swipe/","version":"1.18.0","label":"Swipe","config":{"swipeStyle":"SIMPLE_HORIZONTAL","swipeMode":"SWIPE_BETWEEN_WEBMAPS_OR_WEBSCENES","mapUseDataSourcesOrderList":[],"styleConfig":{"defaultActivation":false,"detailsVisibility":false},"swipeMapViewList":{},"scrollMapViewList":{}},"id":"widget_436","useMapWidgetIds":["widget_432"],"offPanel":true},"widget_437":{"uri":"widgets/arcgis/legend/","version":"1.18.0","label":"Legend","config":{"showBaseMap":false,"cardStyle":false,"style":{"useCustom":true},"respectLayerDefinitionExp":false},"id":"widget_437","useMapWidgetIds":["widget_432"]},"widget_438":{"uri":"widgets/arcgis/map-layers/","version":"1.18.0","label":"Map Layers","config":{"useMapWidget":true,"customizeLayerOptions":{"widget_432-dataSource_1":{"isEnabled":true,"hiddenJimuLayerViewIds":[]}},"setVisibility":true,"information":true},"id":"widget_438","useMapWidgetIds":["widget_432"],"enableDataAction":false},"widget_439":{"uri":"widgets/common/text/","version":"1.18.0","label":"About","config":{"text":"<p style=\"text-align: center;\"><strong>About </strong></p><p style=\"text-align: center;\">On August 4, 2025, the County Council introduced Bill 55-25 which revises and reconstitutes the councilmanic districts into nine districts for the 2026 election. Bill 55-25 has two exhibits: Exhibit A<strong><a href=\"https://bc-gis.maps.arcgis.com/sharing/rest/content/items/d21c08be86d24801b1d0b10b1f3ebee1/data\" target=\"_blank\" data-uniqueid=\"e4ea3243_20e9_b77e_d29a_c7f9ae33b2dd\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fbc-gis.maps.arcgis.com%2Fsharing%2Frest%2Fcontent%2Fitems%2Fd21c08be86d24801b1d0b10b1f3ebee1%2Fdata%22%2C%22expression%22%3Anull%7D\"> </a></strong>– the Proposed Map of nine Council districts; and Exhibit B – the Population and Demographic Summary for the proposed map.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">On September 12, 2025, Councilman Jones proposed an amendment to Bill 55-25. The proposed amendment would modify the text of Bill 55-25 as well as <strong><u><a href=\"https://bc-gis.maps.arcgis.com/sharing/rest/content/items/e058ac8fe6bb4d61a561d031c8e7c52f/data\" target=\"_blank\" data-uniqueid=\"f0c91d73_0d3e_2522_fac6_aa9c36bc28c3\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fbc-gis.maps.arcgis.com%2Fsharing%2Frest%2Fcontent%2Fitems%2Fe058ac8fe6bb4d61a561d031c8e7c52f%2Fdata%22%2C%22expression%22%3Anull%7D\">Exhibit A</a></u></strong> and <strong><u><a href=\"https://bc-gis.maps.arcgis.com/sharing/rest/content/items/668a68ce06424c8187cd24932a286322/data\" target=\"_blank\" data-uniqueid=\"b031e0f4_003f_0daf_d25a_84f4fed307be\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fbc-gis.maps.arcgis.com%2Fsharing%2Frest%2Fcontent%2Fitems%2F668a68ce06424c8187cd24932a286322%2Fdata%22%2C%22expression%22%3Anull%7D\">Exhibit B</a></u></strong>.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">The County Council will hold two public hearings where members of the public may provide input on Bill 55-25 and the map.&nbsp;The first will be at the Council’s Work Session on August 28, 2025 at 4:00 p.m. and the second will be at the Council’s Work Session on September 9, 2025 at 4:00 p.m. The Council’s final adoption of Bill 55-25 is currently scheduled during the Legislative Session on September 15, 2025 at 6:00 p.m.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">In addition to, or in lieu of, providing verbal testimony, the public may submit written testimony to the County Council at any time via e-mail at <a href=\"mailto:countycouncil@baltimorecountymd.gov\" target=\"_self\" data-uniqueid=\"\" data-dsid=\"\" data-link=\"null\">countycouncil@baltimorecountymd.gov</a></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">This data is available in downloadable formats on Baltimore County's Open Data portal <strong style=\"color: var(--primary);\"><u><a href=\"https://opendata.baltimorecountymd.gov/datasets/f0ee9bd575014d1eb78310110853c24d/explore?location=39.438203%2C-76.591645%2C10.54\" target=\"_blank\" data-uniqueid=\"42c6c660_6566_4fe0_c95c_365534148a73\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fopendata.baltimorecountymd.gov%2Fdatasets%2Ff0ee9bd575014d1eb78310110853c24d%2Fexplore%3Flocation%3D39.438203%252C-76.591645%252C10.54%22%2C%22expression%22%3Anull%7D\">here</a>.</u></strong></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong>Note </strong></p><p style=\"text-align: center;\">When using the 'SWIPE' widget, the right map represents the Bill 55-25 districts. The left map represents the Proposed Amendment - Jones districts.</p>","style":{"verticalAlign":"start","wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_439"},"widget_440":{"uri":"widgets/arcgis/arcgis-map/","version":"1.18.0","label":"Bill 55-25, As Amended","config":{"toolConfig":{"canZoom":true,"canHome":true,"canSearch":false,"canNavigation":true,"canBaseMap":true,"canSelect":true,"canSelectState":true,"canLayers":false,"canScaleBar":true},"isUseCustomMapState":false,"initialMapState":null,"initialMapDataSourceID":"dataSource_12","layoutIndex":1,"scaleRange":null},"id":"widget_440","layouts":{"MapFixedLayout":{"LARGE":"layout_253"}},"useDataSources":[{"dataSourceId":"dataSource_3","mainDataSourceId":"dataSource_3"},{"dataSourceId":"dataSource_12","mainDataSourceId":"dataSource_12"}],"enableDataAction":false},"widget_441":{"uri":"widgets/common/controller/","version":"1.18.0","label":"Widget Controller","config":{"behavior":{"onlyOpenOne":true,"openStarts":[],"displayType":"STACK","vertical":false,"size":{}},"appearance":{"space":0,"advanced":false,"card":{"showLabel":false,"labelGrowth":10,"avatar":{"type":"primary","size":"default","shape":"circle"}}}},"id":"widget_441","layouts":{"controller":{"LARGE":"layout_254"}}},"widget_442":{"uri":"widgets/common/search/","version":"1.18.0","offPanel":true,"label":"Search","config":{"searchResultView":"Result_Panel","arrangementStyle":"Style1","searchResultStyle":"Classic","maxSuggestions":1,"recentSearchesMaxNumber":6,"resultMaxNumber":1,"enableFiltering":false,"sourceType":"MapCentric","dataSourceConfigWithMapCentric":{"widget_440-dataSource_8":null,"widget_440-dataSource_3":null},"datasourceConfig":[],"isAutoSelectFirstResult":true},"id":"widget_442","useUtilities":[],"useMapWidgetIds":["widget_440"]},"widget_443":{"uri":"widgets/common/add-data/","version":"1.18.0","label":"Add Data","config":{"itemCategoriesInfo":[{"type":"MY_CONTENT","customLabel":"","enabled":false,"id":"MY_CONTENT"},{"type":"MY_GROUP","customLabel":"","enabled":false,"id":"MY_GROUP"},{"type":"MY_ORGANIZATION","customLabel":"Baltimore County Open Data","enabled":false,"id":"MY_ORGANIZATION"},{"type":"PUBLIC","customLabel":"","enabled":false,"id":"PUBLIC"},{"type":"LIVING_ATLAS","customLabel":"","enabled":false,"id":"LIVING_ATLAS"},{"type":"CURATED","customLabel":"Baltimore County Open Data","enabled":true,"curatedFilter":"group:a6e5c206c5b9439aa95faeadd41e2a61","id":"CURATED_1"}],"disableRenaming":true,"placeholderText":"There is currently no added data. Click the button below to add data. Once added to list, click the 4-circle icon to add it to the map."},"id":"widget_443","dataActions":{"dataStatistics":{"enabled":false}}},"widget_444":{"uri":"widgets/arcgis/swipe/","version":"1.18.0","label":"Swipe","config":{"swipeStyle":"SIMPLE_HORIZONTAL","swipeMode":"SWIPE_BETWEEN_WEBMAPS_OR_WEBSCENES","mapUseDataSourcesOrderList":[],"styleConfig":{"defaultActivation":false,"detailsVisibility":false},"swipeMapViewList":{},"scrollMapViewList":{}},"id":"widget_444","useMapWidgetIds":["widget_440"],"offPanel":true},"widget_445":{"uri":"widgets/arcgis/legend/","version":"1.18.0","label":"Legend","config":{"showBaseMap":false,"cardStyle":false,"style":{"useCustom":true},"respectLayerDefinitionExp":false},"id":"widget_445","useMapWidgetIds":["widget_440"]},"widget_446":{"uri":"widgets/arcgis/map-layers/","version":"1.18.0","label":"Map Layers","config":{"useMapWidget":true,"customizeLayerOptions":{"widget_440-dataSource_1":{"isEnabled":true,"hiddenJimuLayerViewIds":[]}},"setVisibility":true,"information":true},"id":"widget_446","useMapWidgetIds":["widget_440"],"enableDataAction":false},"widget_447":{"uri":"widgets/common/text/","version":"1.18.0","label":"About","config":{"text":"<p style=\"text-align: center;\"><strong>About </strong></p><p style=\"text-align: center;\">On August 4, 2025, the County Council introduced Bill 55-25 which revises the councilmanic districts into nine districts for the 2026 election.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">The County Council held three public hearings on redistricting. The first on July 8, 2025 prior to the introduction of Bill 55-25, the second at the Council's Work Session on August 26, 2025, and the third at the Council's Work Session on September 9, 2025. In addition, members of the public testified on Bill 55-25 after the Council's Legislative Sessions in July, August, and September, 2025.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">The County Council approved an amended version of <strong><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.pdf \" target=\"_blank\" data-uniqueid=\"034b4b0c_ad39_0b1c_99ed_df8eb231c692\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.pdf%20%22%2C%22expression%22%3Anull%7D\">Bill 55-25</a></u></strong> at the Legislative Session on September 15, 2025 by a vote of 5-2. This applications shows the final amended version of the map. </p><p style=\"text-align: center;\">Bill 55-25 has two exhibits: <strong><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.exhibit%20A.pdf \" target=\"_blank\" data-uniqueid=\"aed9d0b5_a6ac_1bcd_1f1e_3a62aaea33fb\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.exhibit%2520A.pdf%20%22%2C%22expression%22%3Anull%7D\">Exhibit A</a></u></strong> - the Proposed Map of nine Council districts; and <strong><u><a href=\"https://countycouncilweb.s3.amazonaws.com/Bills%202025/b05525.exhibit%20B.pdf \" target=\"_blank\" data-uniqueid=\"700e3d7d_8872_2259_bf52_316fec6d05f5\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2FBills%25202025%2Fb05525.exhibit%2520B.pdf%20%22%2C%22expression%22%3Anull%7D\">Exhibit B</a></u></strong> - the Population and Demographic Summary for the proposed map.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">For more information on amendments, please contact the County Council via e-mail at <a href=\"mailto:countycouncil@baltimorecountymd.gov\" target=\"_self\" data-uniqueid=\"\" data-dsid=\"\" data-link=\"null\">countycouncil@baltimorecountymd.gov</a></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">The Councilmanic district boundaries approved in Bill 55-25 will be effective for the 2026 and 2030 County Council elections. For constituent issues, the current seven - district boundaries remain effective until the members elected from the 2026 election are sworn in.</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\">This data is available in downloadable formats on Baltimore County's Open Data portal <strong style=\"color: var(--primary);\"><u><a href=\"https://opendata.baltimorecountymd.gov/datasets/12d02d20d447459ca1fa807e880bd9dc_0/explore?location=39.438203%2C-76.591645%2C11.00\" target=\"_blank\" data-uniqueid=\"20aa2a6d_31ac_fbac_b217_73b0cce5d6d1\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%2C%22value%22%3A%22https%3A%2F%2Fopendata.baltimorecountymd.gov%2Fdatasets%2F12d02d20d447459ca1fa807e880bd9dc_0%2Fexplore%3Flocation%3D39.438203%252C-76.591645%252C11.00%22%2C%22expression%22%3Anull%7D\">here</a>.</u></strong></p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong>Note </strong></p><p style=\"text-align: center;\">When using the 'SWIPE' widget, the right map represents the current 2022 councilmanic districts. The left map represents the Bill 55-25 districts.</p>","style":{"verticalAlign":"start","wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_447"}},"widgetsManifest":{},"views":{"view_2":{"id":"view_2","label":"View 2","layout":{"LARGE":"layout_6"},"backgroundPosition":"fill","backgroundColor":"var(--org-header-bg)","backgroundIMage":{}},"view_3":{"id":"view_3","label":"View 3","layout":{"LARGE":"layout_227"}}},"sections":{"section_2":{"id":"section_2","label":"Header 2","views":["view_2"],"arrowsNav":{"visible":false}},"section_3":{"id":"section_3","label":"Section","views":["view_3"],"style":{"borderRadius":null,"border":{"color":"var(--light-300)","type":"solid","width":"2px"}}}},"dialogs":{"dialog_1":{"id":"dialog_1","mode":"FIXED","sizeMode":{"LARGE":{"widthMode":"CUSTOM","heightMode":"CUSTOM","width":"824px","height":"599px","position":"MIDDLE_CENTER"}},"interactionType":"BUTTON_BLOCK","interactionStyles":{"text":"","textSize":"13px","buttonText":"","buttonTextSize":"16px"},"confirmBeforeClose":true,"alwaysShowConfirmation":false,"dialogBackground":{"color":"var(--light)","fillType":"fill","image":{"url":""}},"overlayColor":"var(--dark-900)","layout":{"LARGE":"layout_2"},"index":0,"isSplash":true,"label":"Disclaimer","blockPage":true}},"dataSources":{"dataSource_1":{"id":"dataSource_1","type":"WEB_MAP","sourceLabel":"Baltimore County Basemap","itemId":"0f7f9ae0c7324eedbf44724f34907278","portalUrl":"https://BC-GIS.maps.arcgis.com"},"dataSource_2":{"id":"dataSource_2","type":"WEB_MAP","sourceLabel":"Baltimore County Basemap","itemId":"4c5efaffaf044812b84ce64be252e370","portalUrl":"https://BC-GIS.maps.arcgis.com"},"dataSource_3":{"id":"dataSource_3","type":"WEB_MAP","sourceLabel":"2022 Councilmanic Map - Redistricting ExB","itemId":"9d71195bd3484f118a08b56772ecc37a","portalUrl":"https://BC-GIS.maps.arcgis.com"},"dataSource_4":{"id":"dataSource_4","type":"WEB_MAP","sourceLabel":"2025 Commission Iteration 1 - Redistricting ExB","itemId":"7b3157989da64f23b49db03f2197cd50","portalUrl":"https://BC-GIS.maps.arcgis.com"},"widget_265_output_config_default_geocode_utility_4_0":{"id":"widget_265_output_config_default_geocode_utility_4_0","type":"FEATURE_LAYER","label":"Composite Locator","originDataSources":[],"isOutputFromWidget":true,"isDataInDataSourceInstance":false,"schema":{"label":"Composite Locator","idField":"objectid","fields":{"default_address":{"jimuName":"default_address","alias":"Default Address","type":"STRING","name":"default_address","esriType":"esriFieldTypeString"},"objectid":{"jimuName":"objectid","alias":"OBJECTID","type":"NUMBER","name":"objectid","esriType":"esriFieldTypeOID"},"Address":{"jimuName":"Address","alias":"Address or Place","type":"STRING","name":"Address"},"Address2":{"jimuName":"Address2","alias":"Address2","type":"STRING","name":"Address2"},"Address3":{"jimuName":"Address3","alias":"Address3","type":"STRING","name":"Address3"},"Neighborhood":{"jimuName":"Neighborhood","alias":"Neighborhood","type":"STRING","name":"Neighborhood"},"City":{"jimuNam