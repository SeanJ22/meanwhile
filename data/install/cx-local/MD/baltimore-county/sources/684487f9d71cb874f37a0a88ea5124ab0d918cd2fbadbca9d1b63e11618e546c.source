dget_9-dataSource_1":{"isEnabled":true,"hiddenJimuLayerViewIds":[]}},"setVisibility":true,"information":true},"id":"widget_172","useMapWidgetIds":["widget_9"],"enableDataAction":false},"widget_174":{"uri":"widgets/common/text/","version":"1.18.0","label":"About","config":{"text":"<p style=\"text-align: center;\"><strong>About </strong></p><p style=\"text-align: center;\">On March 24, 2022, the County Council enacted <span style=\"background-color: white; color: black;\">this Revised Redistricting Plan and map with the passage of&nbsp;</span><a href=\"https://countycouncilweb.s3.amazonaws.com/bills/Bills%202022/b02222.pdf\" target=\"_blank\" data-uniqueid=\"891bb8f1_70e3_b876_137b_efdf1f348d36\" data-dsid=\"\" data-link=\"%7B%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2Fbills%2FBills%25202022%2Fb02222.pdf%22%2C%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%7D\" style=\"background-color: white; color: rgb(0, 34, 128);\">Bill 22-22</a><span style=\"background-color: white; color: black;\">&nbsp;(</span><a href=\"https://countycouncilweb.s3.amazonaws.com/bills/Bills%202022/b02222.exhibit%20A.pdf\" target=\"_blank\" data-uniqueid=\"22b5ea20_6351_b792_ea9b_11347e38e8db\" data-dsid=\"\" data-link=\"%7B%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2Fbills%2FBills%25202022%2Fb02222.exhibit%2520A.pdf%22%2C%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%7D\" style=\"background-color: white; color: rgb(0, 34, 128);\">Ex. A</a><span style=\"background-color: white; color: black;\">&nbsp;and&nbsp;</span><a href=\"https://countycouncilweb.s3.amazonaws.com/bills/Bills%202022/b02222.exhibit%20B.pdf\" target=\"_blank\" data-uniqueid=\"4312a5b4_b4d7_2b9c_0145_25d4dcf886b4\" data-dsid=\"\" data-link=\"%7B%22value%22%3A%22https%3A%2F%2Fcountycouncilweb.s3.amazonaws.com%2Fbills%2FBills%25202022%2Fb02222.exhibit%2520B.pdf%22%2C%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%7D\" style=\"background-color: white; color: rgb(0, 34, 128);\">Ex. B</a><span style=\"background-color: white; color: black;\">). The Council enacted the plan in Bill 22-22 upon its approval by the District Court following a Voting Rights Act lawsuit and subsequent injunction issued by the Court enjoining the Council’s 2021 Redistricting Plan. More information on the 2021 Redistricting Process, the subsequent VRA lawsuit, and the Revised Plan may be found </span><strong style=\"background-color: white; color: var(--primary);\"><a href=\"https://countycouncil.baltimorecountymd.gov/redistricting/redistricting-commission/\" target=\"_blank\" data-uniqueid=\"0e2487c7_bc3c_7a06_a8ae_cdc23858a6b6\" data-dsid=\"\" data-link=\"%7B%22value%22%3A%22https%3A%2F%2Fcountycouncil.baltimorecountymd.gov%2Fredistricting%2Fredistricting-commission%2F%22%2C%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_blank%22%7D\">here</a></strong><span style=\"background-color: white; color: black;\">. </span></p><p><br></p><p style=\"text-align: justify;\"><strong>﻿</strong></p>","style":{"verticalAlign":"start","wrap":true}},"id":"widget_174"},"widget_175":{"uri":"widgets/layout/row/","version":"1.18.0","label":"Row","config":{"space":10,"style":{"padding":{"number":[10],"unit":"px"}}},"id":"widget_175","layouts":{"DEFAULT":{"LARGE":"layout_107"}}},"widget_263":{"uri":"widgets/common/controller/","version":"1.18.0","label":"Widget Controller","config":{"behavior":{"onlyOpenOne":true,"openStarts":[],"displayType":"STACK","vertical":false,"size":{},"arrangement":"floating"},"appearance":{"space":0,"advanced":false,"card":{"showLabel":false,"labelGrowth":10,"avatar":{"type":"primary","size":"default","shape":"circle"}}}},"id":"widget_263","layouts":{"controller":{"LARGE":"layout_158"}}},"widget_264":{"uri":"widgets/common/add-data/","version":"1.18.0","label":"Add Data","config":{"disableRenaming":true,"disableAddByFile":true,"placeholderText":"There is currently no added data. Click the button below to a