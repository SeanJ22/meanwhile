<input id="hfPageTitle" name="hfPageTitle" type="hidden" value="What's on the ballot?">

    <h1 class="ccd-page-heading">What's on the ballot?</h1>

<div class="container">

    <div class="row">
        <div class="col-md-7 col-sm-9 col-xs-12 responsive-padding searchSubHeading">
            This page will show you a sample ballot for <strong><i>any precinct</i></strong> in the State for the upcoming election.
            You can view <strong><i>your own</i></strong> sample ballot by checking the <a href="/Voter/Index">voter information section of this website</a>.
            <br><br>
        </div>
    </div>

    <br><br>
    <form id="publicBallot-Form" action="" class="mb-3" novalidate="novalidate">
        <div class="row">
            <div class="col-md-6 col-sm-9 col-xs-12 responsive-padding">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">View ballot by county, jurisdiction and precinct</h2>
                    </div>
                    <div class="card-body">
                        <p>Required fields are marked with an asterisk <abbr class="req" title="required">*</abbr>.</p>

                        <div class="form-group">
                            <label class="control-label text-uppercase text-transform-none required-label not-bold" for="Elections">Election </label>
                            <span class="sr-only">,,Required,,</span>
                            <select class="form-control text-uppercase text-transform-none one-rem bold valid" data-val="true" data-val-number="The field ElectionID must be a number." data-val-range="&lt;span role='alert'&gt;Please select a valid election.&lt;/span&gt;" data-val-range-max="1000" data-val-range-min="1" data-val-required="&lt;span role='alert'&gt;Please select a county.&lt;/span&gt;" id="Elections" name="ElectionID" required="required"><option value="">Select</option>
<option value="707">State General - November 3, 2026</option>
<option value="706">State Primary - August 4, 2026</option>
</select>
                            <span role="alert">
                                <span class="field-validation-valid" data-valmsg-for="ElectionID" data-valmsg-replace="true"></span>
                                <span class="field-validation-valid" data-valmsg-for="Elections" data-valmsg-replace="true"></span>
                            </span>
                        </div>
                        <div class="form-group">
                            <label class="control-label text-uppercase text-transform-none required-label not-bold" for="Counties">County </label>
                            <span class="sr-only">,,Required,,</span>
                            <select class="form-control text-uppercase text-transform-none one-rem bold valid" data-val="true" data-val-number="The field CountyID must be a number." data-val-range="&lt;span role='alert'&gt;Please select a valid county.&lt;/span&gt;" data-val-range-max="83" data-val-range-min="1" data-val-required="&lt;span role='alert'&gt;Please select a county.&lt;/span&gt;" id="Counties" name="CountyID" required="required">
</select>
                            <span role="alert">
                                <span class="field-validation-valid" data-valmsg-for="CountyID" data-valmsg-replace="true"></span>
                                <span class="field-validation-valid" data-valmsg-for="Counties" data-valmsg-replace="true"></span>
                            </span>
                        </div>
                        <div class="form-group">
                            <label class="control-label text-uppercase text-transform-none required-label not-bold" for="Jurisdictions">Jurisdiction </label>
                            <span class="sr-only">,,Required,,</span>
                            <select class="form-control text-uppercase text-transform-none one-rem bold valid" data-val="true" data-val-number="The field JurisdictionID must be a number." data-val-range="&lt;span role='alert'&gt;Please select a valid jurisdiction.&lt;/span&gt;" data-val-range-max="2500" data-val-range-min="0" data-val-required="&lt;span role='alert'&gt;Please select a jurisdiction.&lt;/span&gt;" id="Jurisdictions" name="JurisdictionID" required="required">
</select>
                            <span role="alert">
                                <span class="field-validation-valid" data-valmsg-for="JurisdictionID" data-valmsg-replace="true"></span>
                                <span class="field-validation-valid" data-valmsg-for="Jurisdictions" data-valmsg-replace="true"></span>
                            </span>
                        </div>
                        <div class="form-group">
                            <label class="control-label text-uppercase text-transform-none required-label not-bold" for="WardPrecincts">Precinct </label>
                            <span class="sr-only">,,Required,,</span>
                            <select class="form-control text-uppercase text-transform-none one-rem bold valid" data-val="true" data-val-maxlength="The field WardPrecinct must be a string or array type with a maximum length of '6'." data-val-maxlength-max="6" data-val-required="&lt;span role='alert'&gt;Please select a precinct.&lt;/span&gt;" id="WardPrecincts" name="WardPrecinct" required="required">
</select>
                            <span role="alert">
                                <span class="field-validation-valid" data-valmsg-for="WardPrecinct" data-valmsg-replace="true"></span>
                                <span class="field-validation-valid" data-valmsg-for="WardPrecincts" data-valmsg-replace="true"></span>
                            </span>
                        </div>

                        <div class="row mt-5">
                            <div class="col-12 pt-md-0 text-right">
                                <button id="btnClear" type="button" role="button" class="btn btn-back">Clear</button>
                                &nbsp;&nbsp;&nbsp;
                                <button id="btnGenerateBallot" type="submit" role="button" class="btn btn-primary" disabled="">View the ballot</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
