            <div class="field field--name-field-body field--type-text-long field--label-hidden text-long"><h3>Macomb County School Districts</h3><ul><li><a href="https://www.mcgi.state.mi.us/mgdl/pdfmaps/CountySchools/SD_BYCO_esize_MACOMB%20COUNTY.pdf" title="2022&nbsp;Precinct Map (opens in new tab)" data-entity-type="external" target="_blank" rel="noopener noreferrer" class="extlink">Macomb County School District Map</a></li></ul><hr><h3>2025 maps</h3><ul><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-2025-Voting-Precincts.pdf" title="2022&nbsp;Precinct Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2025 Voting Precinct Map</a></li></ul><hr><h3>2024 maps</h3><ul><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-2024-Voting-Precincts.pdf" title="2022&nbsp;Precinct Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2024 Voting Precinct Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-2024-BOC-and-precinct.pdf" title="2022&nbsp;County Commissioner Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2024 County Commissioner District&nbsp;Map</a></li><li><a href="https://gis.macombgov.org/portal1/apps/instant/lookup/index.html?appid=99e90e8aaa1948a7815856091d8ca458" target="_blank" rel="noopener noreferrer" class="extlink" title="(opens in new tab)">2024 County Commissioner Interactive Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-2024-Michigan-House-Districts.pdf" target="_blank" rel="noopener noreferrer" class="extlink" title="(opens in new tab)">2024 State Representative District Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-2024-Michigan-Senate-Districts.pdf" target="_blank" rel="noopener noreferrer" class="extlink" title="(opens in new tab)">2024 State Senate District Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-2024-Congressional-Districts.pdf" target="_blank" rel="noopener noreferrer" class="extlink" title="(opens in new tab)">2024 Congressional District Map</a></li></ul><hr><h3>2022 maps</h3><ul><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-voting-precincts-2022.pdf" title="2022&nbsp;Precinct Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2022 Voting Precinct Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-boc-districts-2022.pdf" title="2022&nbsp;County Commissioner Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2022 County Commissioner District&nbsp;Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-state-house-districts-2022.pdf" title="2022&nbsp;Michigan State Representatives District Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2022&nbsp;Michigan State Representatives District Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-state-senate-districts-2022.pdf" title="2022&nbsp;Michigan State Senate District Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2022&nbsp;Michigan State Senate District Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/elect-map-congressional-districts-2022.pdf" title="2022&nbsp;United States Congressional District Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2022&nbsp;United States Congressional District Map</a></li></ul><hr><h3>2018 maps</h3><ul><li><a href="https://macombgovdocs.org/clerk/pdfs/RO_2018_BoardOfCommissionersDistricts.pdf" title="2018&nbsp;Macomb County Commissioners Districts Maps (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2018 Macomb County Commissioners Districts Maps</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/RO_2018_VotingPrecinct.pdf" title="2018&nbsp;Voting Precinct Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2018 Voting Precinct Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/RO_2018_MichiganHouseDistricts.pdf" title="2018&nbsp;Michigan State Representatives District Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2018 Michigan State Representatives District Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/RO_2018_StateSenateDistricts.pdf" title="2018&nbsp;Michigan State Senate District Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2018 Michigan State Senate District Map</a></li><li><a href="https://macombgovdocs.org/clerk/pdfs/RO_2018_USCongressionalDistricts.pdf" title="2018&nbsp;United States Congressional District Map (opens in new tab)" target="_blank" rel="noopener noreferrer" class="extlink">2018 United States Congressional District Map</a></li></ul></div>
