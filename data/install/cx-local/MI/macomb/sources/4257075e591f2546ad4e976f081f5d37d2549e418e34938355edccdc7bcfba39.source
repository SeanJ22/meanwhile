                <span><a href = "/Laws/MCL?objectName=mcl-600-518">Next Section <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#0264F7" class="bi bi-caret-right-fill" viewBox="0 0 16 16" alt="" title=""><path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"/></svg></a></span>
