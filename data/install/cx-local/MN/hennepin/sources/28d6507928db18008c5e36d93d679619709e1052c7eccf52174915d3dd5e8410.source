                    <div id="ctl00_ContentPlaceHolder1_panOfficeLevel" onkeypress="javascript:return WebForm_FireDefaultButton(event, &#39;ctl00_ContentPlaceHolder1_btnSearchByOfficeLevel&#39;)">
	
                        <tr align="center">
                            <td valign="top">
