                        <tr>
                            <td valign="top" width="758px">
                                <!--- This javascript is for the web service call -->

                                <script type="text/javascript">
                                    function ResetOfficeTitlesDDL() {
                                        var officesDDL = $find("ctl00_ContentPlaceHolder1_radOfficeTitle")
                                        officesDDL.clearItems();
                                        officesDDL.clearSelection();
                                    }

                                    function ResetOfficeTitlesDDLFromDDL(sender, eventArgs) {
                                        ResetOfficeTitlesDDL();
                                    }

                                    function GetSelectedItem(sender, eventArgs) {
                                        var context = eventArgs.get_context();

                                        //Office Type DDL
                                        var officeLevelCombo = $find("ctl00_ContentPlaceHolder1_ddlOfficeLevel");
                                        var officeLevelId = officeLevelCombo.get_value();
                                        var filter = "ElectedOfficeLevel=" + officeLevelId;

                                        //Political Parties DDL
                                        var partyCombo = $find("ctl00_ContentPlaceHolder1_ddlPoliticalParty");
                                        if (partyCombo != null) {
                                            filter = filter + ";PartyId=" + partyCombo.get_value();
                                        } else {
                                            filter = filter + ";PartyId=0";
                                        }

                                        //Federal Offices
                                        var showFederal = document.getElementById('ctl00_ContentPlaceHolder1_chkFederalOffices');
                                        if (showFederal != null) {
                                            if (showFederal.checked) {
                                                filter = filter + ";ShowFederal=1";
                                            } else {
                                                filter = filter + ";ShowFederal=0";
                                            }
                                        } else {
                                            filter = filter + ";ShowFederal=0";
                                        }
                                        //Senate Offices
                                        var showSenate = document.getElementById('ctl00_ContentPlaceHolder1_chkStateSenatorialOffices');
                                        if (showSenate != null) {
                                            if (showSenate.checked) {
                                                filter = filter + ";ShowSenate=1";
                                            } else {
                                                filter = filter + ";ShowSenate=0";
                                            }
                                        } else {
                                            filter = filter + ";ShowSenate=0";
                                        }
                                        //Representative Offices
                                        var showRep = document.getElementById('ctl00_ContentPlaceHolder1_chkStateRepresentativeOffices');
                                        if (showRep != null) {
                                            if (showRep.checked) {
                                                filter = filter + ";ShowRep=1";
                                            } else {
                                                filter = filter + ";ShowRep=0";
                                            }
                                        } else {
                                            filter = filter + ";ShowRep=0";
                                        }
                                        //Judicial Offices
                                        var showJudicial = document.getElementById('ctl00_ContentPlaceHolder1_chkJudicialOffices');
                                        if (showJudicial != null) {
                                            if (showJudicial.checked) {
                                                filter = filter + ";ShowJudicial=1";
                                            } else {
                                                filter = filter + ";ShowJudicial=0";
                                            }
                                        } else {
                                            filter = filter + ";ShowJudicial=0";
                                        }
                                        //Executive Offices
                                        var showExecutive = document.getElementById('ctl00_ContentPlaceHolder1_chkExecutiveOffices');
                                        if (showExecutive != null) {
                                            if (showExecutive.checked) {
                                                filter = filter + ";ShowExecutive=1";
                                            } else {
                                                filter = filter + ";ShowExecutive=0";
                                            }
                                        } else {
                                            filter = filter + ";ShowExecutive=0";
                                        }

                                        //Counties DDL
                                        var countiesCombo = $find("ctl00_ContentPlaceHolder1_ddlCounties");
                                        if (countiesCombo != null) {
                                            filter = filter + ";CountyId=" + countiesCombo.get_value();
                                        } else {
                                            filter = filter + ";CountyId=0";
                                        }

                                        //Municipalities DDL
                                        var muniCombo = $find("ctl00_ContentPlaceHolder1_ddlMunicipalities");
                                        if (muniCombo != null) {
                                            filter = filter + ";MunicipalityId=" + muniCombo.get_value();
                                        } else {
                                            filter = filter + ";MunicipalityId=0";
                                        }

                                        //School Districts DDL
                                        var sdCombo = $find("ctl00_ContentPlaceHolder1_ddlSchoolDistricts");
                                        if (sdCombo != null) {
                                            filter = filter + ";SchoolDistrictId=" + sdCombo.get_value();
                                        } else {
                                            filter = filter + ";SchoolDistrictId=0";
                                        }

                                        //Hospital Districts DDL
                                        var hdCombo = $find("ctl00_ContentPlaceHolder1_ddlHospitalDistricts");
                                        if (hdCombo != null) {
                                            filter = filter + ";HospitalDistrictId=" + hdCombo.get_value();
                                        } else {
                                            filter = filter + ";HospitalDistrictId=0";
                                        }

                                        context["FilterString"] = filter;
                                    }
                                </script>

