{
  "westernDefinition": {
    "sourceUrl": "https://revisor.mo.gov/main/OneSection.aspx?section=477.070",
    "sourceOrg": "Missouri Legislature, Revisor of Statutes",
    "collectedAt": "2026-11-03T09:37:09.340438+00:00",
    "verifiedAt": "2026-11-03T10:01:59.951870+00:00",
    "quote": "The jurisdiction of the western district of the court of appeals shall be coextensive with all the counties in the state except those embraced in the jurisdiction of the eastern and the southern districts of the court of appeals."
  },
  "easternExclusion": {
    "sourceUrl": "https://revisor.mo.gov/main/OneSection.aspx?section=477.050",
    "sourceOrg": "Missouri Legislature, Revisor of Statutes",
    "collectedAt": "2026-11-03T09:39:22.282006+00:00",
    "verifiedAt": "2026-11-03T10:01:59.951870+00:00",
    "quote": "The jurisdiction of the eastern district of the court of appeals shall be coextensive with the counties of Monroe, Shelby, Knox, Scotland, Clark, Lewis, Marion, Ralls, Pike, Lincoln, Montgomery, Warren, St. Charles, St. Louis, Jefferson, Ste. Genevieve, Perry, Cape Girardeau, Madison, St. Francois, Washington, Franklin, Audrain, Gasconade, Osage and the city of St. Louis."
  },
  "southernExclusion": {
    "sourceUrl": "https://revisor.mo.gov/main/OneSection.aspx?section=477.060",
    "sourceOrg": "Missouri Legislature, Revisor of Statutes",
    "collectedAt": "2026-11-03T09:39:22.282667+00:00",
    "verifiedAt": "2026-11-03T10:01:59.951870+00:00",
    "quote": "The jurisdiction of the southern district of the court of appeals shall be coextensive with the counties of Barry, Barton, Butler, Camden, Cedar, Carter, Christian, Dade, Dallas, Douglas, Greene, Howell, Hickory, Jasper, Laclede, Lawrence, McDonald, Newton, Ozark, Oregon, Polk, Pulaski, Phelps, Ripley, St. Clair, Shannon, Stone, Texas, Taney, Webster, Wright, Dent, Crawford, Maries, Reynolds, Iron, Wayne, Bollinger, Scott, Stoddard, Dunklin, Pemiscot, New Madrid and Mississippi."
  },
