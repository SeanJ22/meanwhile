<script>
tailwind.config = {
	theme: {
		extend: {
			colors: {
				navy: { DEFAULT: '#0d1f3c', mid: '#1a3260', dark: '#0a1828' },
				gold: { DEFAULT: '#c9a84c', light: '#e8c97a' },
				cream: '#f5f0e8',
				'brand-red': '#b5272d',
				'brand-red-dark': '#8e1f24',
				'brand-border': '#d6cfc0',
				'brand-text': { DEFAULT: '#2a2a2a', light: '#5c5c5c' },
			},
			fontFamily: {
				display: ['"Playfair Display"', 'serif'],
