}
</script>
<style type="text/tailwindcss">
	@layer base {
		html {
			font-size: 105%;
		}
		body {
			font-family: 'DM Sans', sans-serif;
		}
	}
	@layer base {
		/* Visible keyboard focus ring for all interactive elements (WCAG 2.4.7).
		   Uses :focus-visible so mouse clicks don't trigger the ring. */
		a:focus-visible,
		button:focus-visible,
		input:focus-visible,
		select:focus-visible,
		textarea:focus-visible,
		summary:focus-visible,
		[tabindex]:not([tabindex="-1"]):focus-visible {
			outline: 2px solid #c9a84c;
			outline-offset: 2px;
			border-radius: 2px;
		}
	}
	@layer components {
		/* Highlight the nav link whenever the nav-item column is hovered or
		   any descendant is focused. :focus-within means keyboard users tabbing
		   to the top-level link (or into the dropdown) see the same affordance
		   as mouse users hovering the column. */
		.nav-item:hover > a,
		.nav-item:focus-within > a {
			@apply bg-navy text-white;
		}
		/* Show the mega dropdown on nav-item hover OR keyboard focus inside it */
		.nav-item:hover > .mega-dropdown,
		.nav-item:focus-within > .mega-dropdown {
			display: block;
		}
	}
</style>
</head>
<body class="home blog wp-custom-logo wp-theme-kceb-theme bg-cream text-brand-text font-sans overflow-x-hidden">

<a href="#main-content" class="absolute -top-12 left-0 bg-gold text-navy px-4 py-2 text-sm font-bold z-[999] focus:top-0 transition-all">
	Skip to main content</a>

<!-- TOP BAR -->
<div class="bg-navy text-white/75 text-xs tracking-wider py-1.5">
	<div class="flex flex-col items-center justify-between gap-1 px-6 mx-auto max-w-container sm:flex-row">
		<span class="hidden sm:inline">
			4407 Dr. Martin Luther King Jr. Blvd, Kansas City, MO 64130			&nbsp;|&nbsp;
			<a href="tel:8168424820" class="no-underline text-gold-light hover:underline">
				(816) 842-4820			</a>
		</span>
		<span class="flex gap-2 text-[0.7rem]">
							<a href="https://kceb.org/accessibility/" class="no-underline text-gold-light hover:underline">Accessibility</a>
				<span class="text-white/70" aria-hidden="true">|</span>
				<a href="https://kceb.org/board/contact/" class="no-underline text-gold-light hover:underline">Contact Us</a>
				<span class="text-white/70" aria-hidden="true">|</span>
				<a href="https://kceb.org/missionstatement/" class="no-underline text-gold-light hover:underline">Mission Statement</a>
						</span>
	</div>
</div>

<!-- HEADER -->
<header class="bg-white border-b-[3px] border-gold sticky top-0 z-[100] shadow-[0_2px_20px_rgba(0,0,0,0.08)] overflow-visible">
	<div class="flex items-center h-20 gap-6 px-6 mx-auto max-w-container">

		<!-- LOGO -->
		<a href="https://kceb.org/" class="flex items-center gap-3.5 no-underline flex-shrink-0">
			<div class="relative z-[101] flex-shrink-0">
				<img src="https://kceb.org/wp/wp-content/uploads/2026/04/logo-button-1.png" alt="KCEB Logo" width="120" height="120" class="w-[120px] h-[120px] block -mb-[20px]">
			</div>
			<div class="hidden leading-tight sm:block">
				<div class="text-lg font-bold tracking-tight font-display text-navy">
					Kansas City Election Board				</div>
				<div class="text-[0.7rem] text-brand-text-light tracking-widest uppercase">
					Serving the Voters of Kansas City within Jackson County				</div>
			</div>
		</a>

		<!-- DESKTOP NAVIGATION -->
		<nav class="hidden lg:flex items-stretch self-stretch ml-auto gap-0.5" role="navigation" aria-label="Main navigation">
			<div class="nav-item group flex items-center"><a href="https://kceb.org/voters/status/" class="flex items-center h-full px-3.5 text-[0.82rem] font-medium text-navy no-underline rounded whitespace-nowrap tracking-tight transition-colors">Voting</a><div class="mega-dropdown hidden absolute left-0 right-0 top-full bg-white border-t-[3px] border-t-gold shadow-lg z-[200]"><div class="max-w-container mx-auto px-6 py-6"><a href="https://kceb.org/voters/status/" class="block font-display text-base font-bold text-navy no-underline mb-4 pb-2 border-b-2 border-gold hover:text-brand-red transition-colors">Voting &rarr;</a><div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-1"><a href="https://kceb.org/voters/register/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Register to Vote</a><a href="https://kceb.org/voters/status/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Voter Status</a><a href="https://kceb.org/voters/name-change/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Update Voter Registration</a><a href="https://kceb.org/voters/military/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Military &#038; Overseas Voters</a><a href="https://kceb.org/voters/no-excuse-voting/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">No-Excuse Voting (Early Voting)</a><a href="https://kceb.org/voters/rights/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Voter Rights</a><a href="https://kceb.org/voters/forms/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Flyers and Forms</a><a href="https://kceb.org/voters/plan/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Making a Plan to Vote</a></div></div></div></div><div class="nav-item group flex items-center"><a href="https://kceb.org/elections/ballot/" class="flex items-center h-full px-3.5 text-[0.82rem] font-medium text-navy no-underline rounded whitespace-nowrap tracking-tight transition-colors">Elections</a><div class="mega-dropdown hidden absolute left-0 right-0 top-full bg-white border-t-[3px] border-t-gold shadow-lg z-[200]"><div class="max-w-container mx-auto px-6 py-6"><a href="https://kceb.org/elections/ballot/" class="block font-display text-base font-bold text-navy no-underline mb-4 pb-2 border-b-2 border-gold hover:text-brand-red transition-colors">Elections &rarr;</a><div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-1"><a href="https://kceb.org/elections/ballot/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Sample Ballot</a><a href="https://kceb.org/elections/poll-locations/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Poll Locations</a><a href="https://kceb.org/elections/equipment/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Election Equipment</a><a href="https://kceb.org/elections/current-election/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Election Night Results</a><a href="https://kceb.org/elections/workers/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Poll Workers</a><a href="https://kceb.org/elections/adoptapoll/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Adopt-A-Poll</a><a href="https://kceb.org/elections/laws/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Laws and Regulations</a><a href="https://kceb.org/elections/election-results/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Past Election Results</a></div></div></div></div><div class="nav-item group flex items-center"><a href="https://kceb.org/absentee/" class="flex items-center h-full px-3.5 text-[0.82rem] font-medium text-navy no-underline rounded whitespace-nowrap tracking-tight transition-colors">Absentee Voting</a><div class="mega-dropdown hidden absolute left-0 right-0 top-full bg-white border-t-[3px] border-t-gold shadow-lg z-[200]"><div class="max-w-container mx-auto px-6 py-6"><a href="https://kceb.org/absentee/" class="block font-display text-base font-bold text-navy no-underline mb-4 pb-2 border-b-2 border-gold hover:text-brand-red transition-colors">Absentee Voting &rarr;</a><div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-1"><a href="https://kceb.org/absentee/requirements/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Requirements</a><a href="https://kceb.org/absentee/hours/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">No-Excuse Voting (Early Voting)</a><a href="https://kceb.org/absentee/absentee-status/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Check Ballot Status</a><a href="https://kceb.org/absentee/permanent/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Permanent Disabilty</a></div></div></div></div><div class="nav-item group flex items-center"><a href="https://kceb.org/candidates/" class="flex items-center h-full px-3.5 text-[0.82rem] font-medium text-navy no-underline rounded whitespace-nowrap tracking-tight transition-colors">Candidates</a><div class="mega-dropdown hidden absolute left-0 right-0 top-full bg-white border-t-[3px] border-t-gold shadow-lg z-[200]"><div class="max-w-container mx-auto px-6 py-6"><a href="https://kceb.org/candidates/" class="block font-display text-base font-bold text-navy no-underline mb-4 pb-2 border-b-2 border-gold hover:text-brand-red transition-colors">Candidates &rarr;</a><div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-1"><a href="https://kceb.org/candidates/finance/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Campaign Finance &#038; Ethics</a><a href="https://kceb.org/candidates/write-in/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Write-In Candidates</a><a href="https://kceb.org/candidates/forms/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Forms / Applications</a><a href="https://kceb.org/elections/petitions/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Petitions</a></div></div></div></div><div class="nav-item group flex items-center"><a href="https://kceb.org/board/" class="flex items-center h-full px-3.5 text-[0.82rem] font-medium text-navy no-underline rounded whitespace-nowrap tracking-tight transition-colors">Staff &#038; Services</a><div class="mega-dropdown hidden absolute left-0 right-0 top-full bg-white border-t-[3px] border-t-gold shadow-lg z-[200]"><div class="max-w-container mx-auto px-6 py-6"><a href="https://kceb.org/board/" class="block font-display text-base font-bold text-navy no-underline mb-4 pb-2 border-b-2 border-gold hover:text-brand-red transition-colors">Staff &#038; Services &rarr;</a><div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-1"><a href="https://kceb.org/newsroom/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">News Releases</a><a href="https://kceb.org/board/commisioners/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Board of Commissioners</a><a href="https://kceb.org/board/meetings/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Board Meetings</a><a href="https://kceb.org/board/outreach/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Voter Outreach &#038; Education</a><a href="https://kceb.org/board/registrars/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Want to Register Voters?</a><a href="https://kceb.org/board/conduct-election/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Need to Conduct an Election?</a><a href="https://kceb.org/board/maps/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Purchase Voter Data / Maps</a><a href="https://kceb.org/board/careers/" class="block py-1.5 text-[0.8rem] text-brand-text no-underline transition-colors hover:text-navy hover:underline">Job Openings</a></div></div></div></div>		</nav>

