<script id="cornerstone-custom-js" type="text/javascript">
jQuery(document).ready(function($) {
    // Fix for Voter ID Lookup Widget Month Dropdown
    if ($('#jceb_voter_id_lookup_widget_birth_month').length) {
        $('#jceb_voter_id_lookup_widget_birth_month').attr('aria-label', 'Birth Month');
    }

    // Fix for Voter ID Lookup Widget Day Dropdown
    if ($('#jceb_voter_id_lookup_widget_birth_day').length) {
        $('#jceb_voter_id_lookup_widget_birth_day').attr('aria-label', 'Birth Day');
    }

    // Fix for Voter ID Lookup Widget Year Dropdown
    if ($('#jceb_voter_id_lookup_widget_birth_year').length) {
        $('#jceb_voter_id_lookup_widget_birth_year').attr('aria-label', 'Birth Year');
    }

    // Fix for Provisional Results Search PIN Number Box
    if ($('#jceb_provisional_results_search_widget_pin_number').length) {
        $('#jceb_provisional_results_search_widget_pin_number').attr('aria-label', 'PIN Number');
    }
  
  
      $('.x-accordion').attr('role', 'tablist');
  $('.widget h4.h-widget').each(function(){
    var text = $(this).html();
    $(this).replaceWith('<p class="h-widget h3-style">' + text + '</p>');
});
 // Add ARIA attributes to all menu items with submenus
  $('.menu-item-has-children > a').attr({
    'aria-haspopup': 'true',
    'aria-expanded': 'false',
    'href': '#' // make sure parent links are focusable
  });

  // Hide all submenus initially
  $('.sub-menu').hide();

  // Toggle submenu on click
  $('.menu-item-has-children > a').click(function(e) {
    e.preventDefault(); // prevent jumping

    var $parent = $(this).parent();
    var $submenu = $parent.children('.sub-menu');

    // Toggle the submenu
    if ($submenu.is(':visible')) {
      $submenu.slideUp(200);
      $(this).attr('aria-expanded', 'false');
    } else {
      $submenu.slideDown(200);
      $(this).attr('aria-expanded', 'true');
    }
  });

  // Keyboard navigation for parent links
  $('.menu-item-has-children > a').keydown(function(e) {
    var $submenu = $(this).siblings('.sub-menu');

    switch(e.key) {
      case "ArrowDown":
        e.preventDefault();
        $submenu.show();
        $(this).attr('aria-expanded', 'true');
        $submenu.find('a:first').focus();
        break;

      case "ArrowUp":
        e.preventDefault();
        $submenu.show();
        $(this).attr('aria-expanded', 'true');
        $submenu.find('a:last').focus();
        break;

      case "Escape":
        e.preventDefault();
        $submenu.slideUp(200);
        $(this).attr('aria-expanded', 'false');
        $(this).focus();
        break;
    }
  });

  // Close submenu when tabbing out
  $('.sub-menu a').last().keydown(function(e) {
    if(e.key === "Tab" && !e.shiftKey) {
      $(this).closest('.sub-menu').slideUp(200);
      $(this).closest('.menu-item-has-children').children('a').attr('aria-expanded', 'false');
    }
  });
  
if ($('#s').length) {
    $('#s').attr('type', 'search');

    if ($('label[for="s"]').length > 1) {
        $('label[for="s"]:not(:first)').remove();
    }
}
  setTimeout(function () {
    $('textarea.g-recaptcha-response').attr({
        'aria-label': 'reCAPTCHA verification',
        'aria-hidden': 'true'
    });
}, 1000);
   
});
</script>

</body>
</html>
