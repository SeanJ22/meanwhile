                </table>

                <button onclick="jceb_provisional_results_search()" name="jceb_provisional_results_search" id="jceb_provisional_results_search_widget_submit">Submit</button>            </div>
        </div>


<script type="text/javascript">

function jceb_provisional_results_search() {

    var pin_number = document.getElementById('jceb_provisional_results_search_widget_pin_number').value;

    if ( pin_number != null && pin_number.length > 0 ) {
        jQuery.ajax({
                type: "post", url: 'https://jcebmo.org/wp-admin/admin-ajax.php',
                data: { action: 'jceb_provisional_results_search_ajax_submit', pin_number : pin_number, _ajax_nonce: '<?php echo $nonce; ?>' },
                // fadeIn loading just when button is clicked
                beforeSend: function() {jQuery('#jceb_provisional_results_search_widget_result').fadeOut('fast');},
                // if data is retrieved, store it in html
                success: function(html) {
                    // fadeIn the html inside jceb_provisional_results_search_widget_result div
                    jQuery('#jceb_provisional_results_search_widget_result').html(html);
                    //animation
                    jQuery('#jceb_provisional_results_search_widget_result').fadeIn("fast");
                }
        }); //close jQuery.ajax(
    } else {
        alert('Please enter valid data!');
    }
}

</script>
