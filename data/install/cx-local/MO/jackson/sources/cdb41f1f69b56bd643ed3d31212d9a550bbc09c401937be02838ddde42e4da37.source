<script type="text/javascript">

function jceb_voter_id_lookup() {

    var first_name = document.getElementById('jceb_voter_id_lookup_widget_first_name').value;
    var last_name = document.getElementById('jceb_voter_id_lookup_widget_last_name').value;

    var birth_month_el = document.getElementById('jceb_voter_id_lookup_widget_birth_month')
    var birth_month = birth_month_el.options[birth_month_el.selectedIndex].value;

    var birth_day_el = document.getElementById('jceb_voter_id_lookup_widget_birth_day')
    var birth_day = birth_day_el.options[birth_day_el.selectedIndex].value;

    var birth_year_el = document.getElementById('jceb_voter_id_lookup_widget_birth_year')
    var birth_year = birth_year_el.options[birth_year_el.selectedIndex].value;

    if ( first_name != null && first_name.length > 0 && last_name != null && last_name.length > 0 ) {
        jQuery.ajax({
                type: "post", url: 'https://jcebmo.org/wp-admin/admin-ajax.php',
                data: { action: 'jceb_voter_id_lookup_ajax_submit', first_name: first_name, last_name: last_name, birth_month: birth_month, birth_day: birth_day, birth_year: birth_year, _ajax_nonce: '439705a43e' },
                // fadeIn loading just when button is clicked
                beforeSend: function() {jQuery('#jceb_voter_id_lookup_widget_result').fadeOut('fast');},
                // if data is retrieved, store it in html
                success: function(html) {
                    // fadeIn the html inside jceb_voter_id_lookup_widget_result div
                    jQuery('#jceb_voter_id_lookup_widget_result').html(html);
                    //animation
                    jQuery('#jceb_voter_id_lookup_widget_result').fadeIn("fast");
                }
        }); //close jQuery.ajax(
    } else {
        alert('Please enter valid data!');
    }
}

</script>
</div><div id="jceb-provisional-results-search-widget-12" class="widget jceb_provisional_results_search_widget">        <style type="text/css">

