  $('#search-button').on('click', function(e) {
    if($('#search-input-container').hasClass('hdn')) {
      e.preventDefault();
      $('#search-input-container').removeClass('hdn')
      return false;
    }
  });
  
  $('#hide-search-input-container').on('click', function(e) {
    e.preventDefault();
    $('#search-input-container').addClass('hdn')
    return false;
  });
  

  </script>

  


<script>
$('#carouselSpots').on('slide.bs.carousel', function (e) {
	console.log("Slide action");
	
	var $e = $(e.relatedTarget);
	var idx = $e.index();
	var itemsPerSlide = 4;
	var totalItems = $('#carouselSpots .carousel-spots').length;
	
	if (idx >= totalItems-(itemsPerSlide-1)) {
		var it = itemsPerSlide - (totalItems - idx);
		for (var i=0; i<it; i++) {
			// append slides to end
			if (e.direction=="right") {
				$('#carouselSpots .carousel-spots').eq(i).appendTo('.inner-spots');
			}
			else {
				$('#carouselSpots .carousel-spots').eq(0).appendTo('.inner-spots');
			}
		}
	}
	
});
</script><!-- InstanceEndEditable -->

