    <script>
        $(document).ready(function () {
            // Function to filter .websites-list and hide/show columns
            function filterList() {
                var searchTerm = $("#search-input").val().toLowerCase().trim();
                var totalVisibleItems = 0;

                $(".voting-list").each(function () {
                    var hasVisibleItems = false;
                    $(this).find("li").each(function () {
                        var listItemText = $(this).text().toLowerCase().trim();
                        if (listItemText.includes(searchTerm)) {
                            $(this).show();
                            hasVisibleItems = true;
                            totalVisibleItems++;
                        } else {
                            $(this).hide();
                        }
                    });

                    if (!hasVisibleItems) {
                        $(this).closest(".col-md-6").hide();  // Hide the entire column
                    } else {
                        $(this).closest(".col-md-6").show();  // Show the entire column
                    }
                });

                if (totalVisibleItems === 0) {
                    $("#no-results-message").show();
                } else {
                    $("#no-results-message").hide();
                }
            }

            // Show/Hide clear button based on input
            $("#search-input").on("input", function () {
                if ($(this).val().trim() !== "") {
                    $("#clear-filter").show();
                } else {
                    $("#clear-filter").hide();
                }
                filterList();
            });

            // Clear filter function
            $("#clear-filter, #reset-filter").on("click", function () {
                $("#search-input").val('');  // Clear the input field
                $(".websites-list li").show();  // Show all list items
                $(".col-md-6").show();  // Show all columns
                $("img").show();  // Show all header images
                $("p").show();  // Show all paragraphs (for notices, etc.)
                $("#no-results-message").hide();  // Hide the no results message
                $("#clear-filter").hide();  // Hide the clear button
            });
        });
    </script>



    
    <script type="text/javascript" charset="utf-8">
        $(document).ready(function () {
            $('.labelholder').labelholder();
            $.getScript('/_Assets/js/social.js');
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.bcc-lang-more').length) {
                    $('.bcc-lang-more details[open]').removeAttr('open');
                }
            });

            function syncMenuTop() {
                var bar = $('#main-menu-container');
                if (!bar.length) {
                    return;
                }
                document.documentElement.style.setProperty('--bcc-menu-top', bar.outerHeight() + 'px');
            }

            function syncLangBar() {
                var atTop = $(window).scrollTop() < 8;
                $('#main-menu-container').toggleClass('bcc-scrolled', !atTop);
                if (!atTop) {
                    $('.bcc-lang-more details[open]').removeAttr('open');
                }
                syncMenuTop();
            }

            function setHeaderOffset() {
                var bar = $('#main-menu-container');
                if (!bar.length) {
                    return;
                }
                var h = 0;
                bar.children(':visible').each(function () {
                    h += $(this).outerHeight(true);
                });
                var gap = window.matchMedia('(max-width: 767px)').matches ? 28 : 72;
                document.documentElement.style.setProperty('--bcc-header-offset', (h + gap) + 'px');
                syncMenuTop();
            }

            syncLangBar();
            setHeaderOffset();
            $(window).on('load', setHeaderOffset);
            setTimeout(setHeaderOffset, 350);
            $(window).on('scroll', syncLangBar);
            $(window).on('bccHeaderSync', setHeaderOffset);
            $(document).ajaxComplete(function (event, xhr, settings) {
                if (settings && settings.url && settings.url.indexOf('GetTickerData') !== -1) {
                    setHeaderOffset();
                }
            });
        });
    </script>
</body>
</html>