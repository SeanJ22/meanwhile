        </div>
    <script type="text/javascript">
        (function () {
            if (window.bccLangBound) {
                return;
            }
            window.bccLangBound = true;
            var publicOrigin = "https://www.bergencountyclerk.gov";

            function onProxy() {
                return (window.location.hostname || "").indexOf(".translate.goog") !== -1;
            }

            function strippedSearch() {
                var raw = window.location.search || "";
                if (raw.charAt(0) === "?") {
                    raw = raw.substring(1);
                }
                if (!raw) {
                    return "";
                }
                var parts = raw.split("&");
                var kept = [];
                for (var i = 0; i < parts.length; i++) {
                    var part = parts[i];
                    if (!part) {
                        continue;
                    }
                    var key = part.split("=")[0].toLowerCase();
                    if (key.indexOf("_x_tr_") === 0) {
                        continue;
                    }
                    kept.push(part);
                }
                return kept.length ? "?" + kept.join("&") : "";
            }

            function markCurrent() {
                if (!onProxy()) {
                    return;
                }
                var match = window.location.search.match(/[?&]_x_tr_tl=([^&]+)/i);
                var tl = match ? decodeURIComponent(match[1]).toLowerCase() : "";
                var code = "en";
                if (tl.indexOf("es") === 0) {
                    code = "es";
                } else if (tl.indexOf("ko") === 0) {
                    code = "ko";
                }
                var links = document.querySelectorAll(".bcc-lang a[data-bcc-lang]");
                for (var i = 0; i < links.length; i++) {
                    if (links[i].getAttribute("data-bcc-lang") === code) {
                        links[i].setAttribute("aria-current", "true");
                    } else {
                        links[i].removeAttribute("aria-current");
                    }
                }
            }

            document.addEventListener("click", function (e) {
                var link = e.target || e.srcElement;
                while (link && link.tagName !== "A") {
                    link = link.parentNode;
                }
                if (!link || !link.getAttribute || !onProxy()) {
                    return;
                }
                var code = link.getAttribute("data-bcc-lang");
                if (!code) {
                    return;
                }
                var path = window.location.pathname || "/";
                var search = strippedSearch();
                var next;
                if (code === "en") {
                    next = publicOrigin + path + search;
                } else {
                    next = "https://www-bergencountyclerk-gov.translate.goog" + path + (search ? search + "&" : "?") + "_x_tr_sl=en&_x_tr_hl=en&_x_tr_pto=wapp&_x_tr_tl=" + code;
                }
                if (e.preventDefault) {
                    e.preventDefault();
                }
                window.top.location.href = next;
                return false;
            }, false);

            markCurrent();
        })();
    </script>
