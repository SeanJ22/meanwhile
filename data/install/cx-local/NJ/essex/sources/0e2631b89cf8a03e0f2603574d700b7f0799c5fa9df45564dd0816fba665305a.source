<script src="/js/jQuery.loadScroll.js"></script>
<script>
  $("#newsletter-btn-1").click(function() {
    var form = $("#newsletter-form");
    // if (form.valid() == true) {

    $('#newsletter-btn-1').html("Wait..");
    var FrmData = $("#newsletter-form").serialize();
    $.ajax({

      type: 'post',
      url: 'ajax_action.php',
      async: false,
      data: {
        FrmData: FrmData,
        action: 'Newsletter',
      },
      success: (function(script_response) {
        $('#newsletter-btn-1').html('submit');

        var data = $.parseJSON(script_response);
        if (data['success'] == 'true') {

          $('#newsletter_msg').html(data['message']);


          setTimeout(function() {
            $('input').val("");
            //window.location.href = "thank-you.php"; 
          }, 500);


        } else {
          $('#newsletter_msg').html(data['message']);
        }
      })
    });
    //}			 
  });
</script>

