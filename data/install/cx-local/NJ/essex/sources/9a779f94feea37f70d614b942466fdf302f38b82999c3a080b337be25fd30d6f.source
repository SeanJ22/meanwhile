                        <div class="col-md-4 ftr-contact footer-contact-col">

    <div class="footer-block footer-contact">
        <h3 id="contact" class="footer-block-title">Contact Us</h3>

        <section class="contact-form form-group" ng-controller="contactController" ng-init="recaptchaKey='6LfkwB0TAAAAAAbxNC2zzL2qHG8ksesC_YRTsYFh'">
            <form ng-submit="processForm()">

                <div id="messages" ng-show="message" class="contact-hdr"><span ng-bind="message"></span></div>

                <div class="labelholder" data-label="(e.g. Alan Guth)">
                    <input type="text" ng-model="contact.Contact_Name" class="form-control cf-nm" placeholder="Name" required />
                </div>
                <div class="labelholder" data-label="(e.g. email@address.com)">
                    <input type="email" ng-model="contact.Contact_Email" class="form-control cf-eml" placeholder="Email Address" required />
                </div>
                <div class="labelholder" data-label="(e.g. (555) 555-1234)">
                    <input type="tel" ng-model="contact.Contact_Phone" class="form-control phoneNumber" placeholder="Phone Number" required />
                </div>
                <div class="labelholder" data-label="(e.g. To whom it may concern...)">
                    <textarea ng-model="contact.Contact_Message" class="form-control cf-msg" rows="1" id="msg" placeholder="Message" required></textarea>
                </div>
                <div class="contact-ftr">
                    <span>
                        <em class="rf">Note:</em> All Fields Required
                    </span>
                </div>
                <div class="footer-recaptcha">
                    <div class="footer-recaptcha-inner">
                        <div vc-recaptcha size="'compact'" theme="'light'" key=recaptchaKey></div>
                    </div>
                </div>
                <div class="footer-submit">
                    <button type="submit" class="btn btn-default btn-lg">Submit</button>
                </div>

            </form>
        </section>
    </div>

</div>

                        <div class="col-md-4 footer-offices-col">
                            <div class="footer-block footer-offices" aria-label="Our Offices">
    <h3 class="footer-block-title">Our Offices</h3>
    <div class="contact-info-block">
        <div class="footer-map-wrap">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d898.7917049877616!2d-74.18049448530422!3d40.7364411150525!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c253893fd3e1ef%3A0xe46038866f3b0788!2s495%20Dr%20Martin%20Luther%20King%20Jr%20Blvd%2C%20Newark%2C%20NJ%2007103!5e0!3m2!1sen!2sus!4v1631123456977!5m2!1sen!2sus" frameborder="0" allowfullscreen="" loading="lazy" title="Map: Essex County Clerk office location"></iframe>
        </div>
        <div class="footer-address">
