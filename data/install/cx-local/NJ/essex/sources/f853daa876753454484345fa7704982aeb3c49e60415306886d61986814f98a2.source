document.addEventListener('DOMContentLoaded', () => {
  var $ = window.jQuery;
  if (!$ || !$('body').hasClass('fsLiveMode') || $('[data-hero]').length) return;

  var $hero = $('.hero').eq(0),
      $after = $('.fsHeader .fsBanner').first();
  if (!$hero.length || !$after.length || $hero.closest('.fsHeader').length) return;

  $hero.attr('data-hero', true);
  $('body').addClass('has-hero');
  $hero.insertAfter($after);

  $hero.find('video').each(function () {
    this.load();
    if (this.autoplay) this.play().catch(function () {});
  });

  if (window.FS && FS.util && FS.util.updateDynamicImages) FS.util.updateDynamicImages($hero);
  $('body').addClass('hero-loaded');

  if (window.CUSTOMSTYLES) CUSTOMSTYLES.stickyHeader();
  $(window).trigger('resize');
});
</script>


