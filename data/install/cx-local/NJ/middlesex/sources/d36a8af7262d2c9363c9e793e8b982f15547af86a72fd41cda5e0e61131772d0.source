vLink" target="_self" HREF="/about_us/board_of_education/minutes__approved/" title="Minutes: Approved">Minutes: Approved</a></div><div class="sitenavl1 navWrp&#xA;            "><a class="navLink" target="_self" HREF="/about_us/board_of_education/minutes__archived/" title="Minutes: Archived">Minutes: Archived</a></div><div class="sitenavl1 navWrp&#xA;            "><a class="navLink" target="_self" HREF="/about_us/board_of_education/minutes__closed_session/" title="Minutes: Closed Session">Minutes: Closed Session</a></div><div class="sitenavl1 navWrp&#xA;            "><a class="navLink" target="_self" HREF="/about_us/board_of_education/school_board_elections/" title="School Board Elections">School Board Elections</a></div></div></div>
