	<style type="text/css">
		body.has-sidebar #content {
			width: calc(100% - 25% - 0px);
		}
		.hide, .hideOnWebsite, .hidden{
			display: none;
		}

		.fusion-header-wrapper {z-index:900;}
		.su-slider {margin:0px !important;padding:0px;}
		.mfp-title{display:none !important;}

		@media (min-width: 678px) {
		.fusion-mobile-logo-1x, .fusion-mobile-logo-2x{
			display: none !important;
		}
		.fusion-logo-1x.fusion-standard-logo{
			display: inline-block !important;
		}
		}

	</style>	
