<!--script open and highlight the current active link-->
<script type="text/javascript">
  jQuery(function($) {
    //set active
    var currentLocation = window.location.href;

    //2018-2-22
    //Chi Huynh
    //blog | single post nav*******************************************************************************
    $("#dcit-blog-nav a").each(function(index, value) {
      var thisLocation = $(this).attr("href");
      if (currentLocation == thisLocation) {
        $(this).parent('div').addClass("active");
      }
    });
    // for single post page
    // find the date and set appropriate link in the nav
    var found = $(".fusion-meta-info-wrapper span").filter(function(index, span) {
      if (!$(span).hasClass('vcard') && !$(span).hasClass('updated') && !$(span).hasClass('fusion-inline-sep') && !$(span).hasClass('fn')) {
        return span;
      }
    });
    if (found.length > 0) {
      var singlePostDate = $(found[0]).text();
      if (singlePostDate.trim() != "") {
        var date = singlePostDate.split(" ");
        var month = date[0];
        var year = date[2];
        var date = month + " " + year;

        $("#dcit-blog-nav a").each(function(index, value) {
          if ($(this).text().indexOf(date) > -1) {
            $(this).parent('div').addClass("active");
          }
        });
      }
    }
    //************************************************************************************************
    //main nav
    $(".dcit-department-widget-title").each(function(index, value) {
      var thisLocation = $(this).attr("href");
      if (currentLocation == thisLocation) {

        //1.) add active class
        //for top level title
        $(this).closest(".panel-title").addClass("active");
        //for link inside table
        if ($(this).closest("td").hasClass("noChild")) {
          $(this).closest("td").addClass("active");
        }

        //2.) open collapse
        $(this).parents(".panel").each(function(i, e) {
          $(this).find("span").eq(0).html("-");
        });
        $(this).parents(".panel-collapse").addClass("in");
        // $(this).closest(".panel-collapse").addClass("in");

        //3.) open child collapse if this is a top-level link
        var firstCollapse = $(this).closest(".panel").find(".panel-collapse");
        if (firstCollapse.length > 0) {
          $(firstCollapse[0]).addClass("in");
        }
      }
    });

    $(".dcit-department-widget-collapse-a").click(function() {
      var btn = $(this);
      var i = btn.find("span").eq(0);

      if (i.html() == "+") {
        i.html("-");
      } else if (i.html() == "-") {
        i.html("+");
      }
    });
  });
</script>
