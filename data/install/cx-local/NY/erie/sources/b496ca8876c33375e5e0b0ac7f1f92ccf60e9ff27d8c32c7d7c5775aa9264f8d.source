eInSelection":null,"isWriteIn":true,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-94b1-08df1596c050","nativeId":"Cheektowaga Proposition_:12","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":17,"relativeOrder":12,"type":3,"title":[{"languageID":"en","text":"Town of Cheektowaga 2026 Term Limits proposal / Propuesta de límites de mandato de 2026 del municipio de Cheektowaga"},{"languageID":"1","text":"Town of Cheektowaga 2026 Term Limits proposal / Propuesta de límites de mandato de 2026 del municipio de Cheektowaga"}],"uniqueTitle":[{"languageID":"en","text":"Cheektowaga Proposition"},{"languageID":"1","text":"Cheektowaga Proposition"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Shall the Town of Cheektowaga establish Term Limits for the office of Supervisor, Town Clerk, Superintendent of Highways, and Councilmember limited to 12 years, or three (3) terms, excluding uncompleted terms of office? / ¿Debería el municipio de Cheektowaga establecer límites de mandato para los cargos de Supervisor, Secretario Municipal, Superintendente de Carreteras y Concejal, limitándolos a 12 años o tres (3) mandatos, excluyendo los mandatos no completados?\r\n\r\nA YES vote would establish term limits for Supervisor, Town Clerk, Superintendent of Highways, and Councilmembers in the Town. / Un voto a favor (SÍ) establecería límites de mandato para los cargos de Supervisor, Secretario Municipal, Superintendente de Carreteras y Concejal en el municipio.\r\nA NO vote would not alter or impose such term restrictions on these offices in the Town. / Un voto en contra (NO) no alteraría ni impondría dichas restricciones de mandato a estos cargos en el municipio.\r\n\r\n"},{"languageID":"1","text":"Shall the Town of Cheektowaga establish Term Limits for the office of Supervisor, Town Clerk, Superintendent of Highways, and Councilmember limited to 12 years, or three (3) terms, excluding uncompleted terms of office? / ¿Debería el municipio de Cheektowaga establecer límites de mandato para los cargos de Supervisor, Secretario Municipal, Superintendente de Carreteras y Concejal, limitándolos a 12 años o tres (3) mandatos, excluyendo los mandatos no completados?\r\n\r\nA YES vote would establish term limits for Supervisor, Town Clerk, Superintendent of Highways, and Councilmembers in the Town. / Un voto a favor (SÍ) establecería límites de mandato para los cargos de Supervisor, Secretario Municipal, Superintendente de Carreteras y Concejal en el municipio.\r\nA NO vote would not alter or impose such term restrictions on these offices in the Town. / Un voto en contra (NO) no alteraría ni impondría dichas restricciones de mandato a estos cargos en el municipio.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en","text":"Write-In"},{"languageID":"1","text":"Escribe"}],"noCandidateText":[],"voteForMax":1,"maxRank":null,"html":[],"active":true,"selectionsRemaining":1,"writeIns":0,"pageNumber":1,"sideNumber":1,"columnNumber":0,"ballotItemHeader":null,"printableBallotOptions":[{"id":"01000000-ed5e-3013-222b-08df159721da","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"d