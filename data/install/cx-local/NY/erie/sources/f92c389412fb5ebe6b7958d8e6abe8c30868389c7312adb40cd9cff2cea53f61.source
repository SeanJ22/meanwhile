":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-5657-08df1596c0ad","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-9ca1-08df1596c059","nativeId":"Prop 8 Buffalo_:18","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":25,"relativeOrder":18,"type":3,"title":[{"languageID":"en","text":"City of Buffalo Charter Amendment on Budget Adoption Procedures"},{"languageID":"1","text":"Enmienda a la Carta Constitucional de la Ciudad de Buffalo sobre los\r\nprocedimientos de aprobación del presupuesto"}],"uniqueTitle":[{"languageID":"en","text":"Prop 8 Buffalo"},{"languageID":"1","text":"Prop 8 Buffalo"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Amends Charter to give additional powers to the Comptroller to recommend revenue and expenditure estimates in the Mayor’s proposed annual budget and for Common Council to implement those recommendations. / Modifica la Carta Orgánica para otorgar al Contralor facultades adicionales para recomendar estimaciones de ingresos y gastos en el presupuesto anual propuesto por el Alcalde, y para que el Concejo Municipal implemente dichas recomendaciones.\r\n\r\nA “YES” vote would add these powers. / Un voto a favor (“SÍ”) añadiría estas facultades.\r\n\r\nA “NO” vote would leave the current powers unchanged. / Un voto en contra (“NO”) mantendría sin cambios las facultades actuales.\r\n\r\n"},{"languageID":"1","text":"Amends Charter to give additional powers to the Comptroller to recommend revenue and expenditure estimates in the Mayor’s proposed annual budget and for Common Council to implement those recommendations. / Modifica la Carta Orgánica para otorgar al Contralor facultades adicionales para recomendar estimaciones de ingresos y gastos en el presupuesto anual propuesto por el Alcalde, y para que el Concejo Municipal implemente dichas recomendaciones.\r\n\r\nA “YES” vote would add these powers. / Un voto a favor (“SÍ”) añadiría estas facultades.\r\n\r\nA “NO” vote would leave the current powers unchanged. / Un voto en contra (“NO”) mantendría sin cambios las facultades actuales.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en","text":"Write-In"},{"languageID":"1","text":"Escribe"}],"noCandidateText":[],"voteForMax":1,"maxRank":null,"html":[],"active":true,"selectionsRemaining":1,"writeIns":0,"pageNumber":1,"sideNumber":2,"columnNumber":0,"ballotItemHeader":null,"printableBallotOptions":[{"id":"01000000-ed5e-3013-dd8a-08df1596c0ad","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"