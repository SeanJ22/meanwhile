eID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":true,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-b6ea-08df1596c057","nativeId":"Prop 1 Buffalo_:11","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":18,"relativeOrder":11,"type":3,"title":[{"languageID":"en","text":"City of Buffalo Charter Amendment regarding Acting Public Officials"},{"languageID":"1","text":"Enmienda a la Carta Orgánica de la Ciudad de Buffalo relativa a los funcionarios públicos interinos"}],"uniqueTitle":[{"languageID":"en","text":"Prop 1 Buffalo"},{"languageID":"1","text":"Prop 1 Buffalo"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Amends City Charter clarifying that any reference to the Mayor, Comptroller, Councilmember, Council President or Council president pro tempore includes any person holding such office in an acting capacity. / Modifica la Carta Constitucional de la Ciudad para aclarar que cualquier referencia al Alcalde, Contralor, Concejal, Presidente del Concejo o Presidente pro tempore del Concejo incluye a cualquier persona que ocupe dicho cargo de manera interina.\r\n\r\nA “YES” Vote will add a section to the City Charter clarifying that officials in an acting capacity have all of the powers of the permanent office. / Un voto a favor (\"SÍ\") añadirá una sección a la Carta Constitucional de la Ciudad aclarando que los funcionarios que ocupan un cargo de manera interina poseen todas las facultades del cargo permanente.\r\n\r\nA “NO” vote will leave the City Charter unchanged. / Un voto en contra (\"NO\") dejará la Carta Constitucional de la Ciudad sin cambios.\r\n\r\n"},{"languageID":"1","text":"Amends City Charter clarifying that any reference to the Mayor, Comptroller, Councilmember, Council President or Council president pro tempore includes any person holding such office in an acting capacity. / Modifica la Carta Constitucional de la Ciudad para aclarar que cualquier referencia al Alcalde, Contralor, Concejal, Presidente del Concejo o Presidente pro tempore del Concejo incluye a cualquier persona que ocupe dicho cargo de manera interina.\r\n\r\nA “YES” Vote will add a section to the City Charter clarifying that officials in an acting capacity have all of the powers of the permanent office. / Un voto a favor (\"SÍ\") añadirá una sección a la Carta Constitucional de la Ciudad aclarando que los funcionarios que ocupan un cargo de manera interina poseen todas las facultades del cargo permanente.\r\n\r\nA “NO” vote will leave the City Charter unchanged. / Un voto en contra (\"NO\") dejará la Carta Constitucional de la Ciudad sin cambios.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en","text":"Write-In"},{"languageID":"1","text":"Escribe"}],"noCandidateText":[],"voteForMax":1,"maxRank":null,"html":[],"active":true,"selectionsRemaining":1,"writeIns":0,"pageNumber":1,"sideNumber":1,"columnNumber":0,"ballotItemHeader":null,"printableBallotOptions":[{"id":"01000000-ed5e-3013-133a-08df1596c0a7","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-4648-08df1596c0a7","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotOptions":[{"id":"01000000-ed5e-3013-133a-08df1596c0a7","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-4648-08df1596c0a7","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-5aa5-08df1596c058","nativeId":"Prop 2 Buffalo_:12","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":19,"relativeOrder":12,"type":3,"title":[{"languageID":"en","text":"City of Buffalo Charter Amendment to require Charter Revision Commissions Every Ten Years"},{"languageID":"1","text":"Enmienda a la Carta Orgánica de la Ciudad de Búfalo para exigir comisiones de revisión de la Carta Orgánica cada diez años"}],"uniqueTitle":[{"languageID":"en","text":"Prop 2 Buffalo"},{"languageID":"1","text":"Prop 2 Buffalo"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Amends the City of Buffalo Charter to require the establishment of a Charter Revision Commission at least once every ten years. / Modifica la Carta Constitucional de la Ciudad de Buffalo para exigir la creación de una Comisión de Revisión de la Carta Constitucional al menos una vez cada diez años.\r\n\r\nA \"YES\" vote will mandate a City of Buffalo Charter Revision Commission at least every ten years. / Un voto a favor (\"SÍ\") obligará a establecer una Comisión de Revisión de la Carta Constitucional de la Ciudad de Buffalo al menos cada diez años.\r\n\r\nA \"NO\" vote will not mandate a Charter Revision Commission every ten years. / Un voto en contra (\"NO\") no obligará a establecer una Comisión de Revisión de la Carta Constitucional cada diez años.\r\n\r\n"},{"languageID":"1","text":"Amends the City of Buffalo Charter to require the establishment of a Charter Revision Commission at least once every ten years. / Modifica la Carta Constitucional de la Ciudad de Buffalo para exigir la creación de una Comisión de Revisión de la Carta Constitucional al menos una vez cada diez años.\r\n\r\nA \"YES\" vote will mandate a City of Buffalo Charter Revision Commission at least every ten years. / Un voto a favor (\"SÍ\") obligará a establecer una Comisión de Revisión de la Carta Constitucional de la Ciudad de Buffalo al menos cada diez años.\r\n\r\nA \"NO\" vote will not mandate a Charter Revision Commission every ten years. / Un voto en contra (\"NO\") no obligará a establecer una Comisión de Revisión de la Carta Constitucional cada diez años.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en","text":"Write-In"},{"languageID":"1","text":"Escribe"}],"noCandidateText":[],"voteForMax":1,"maxRank":null,"html":[],"active":true,"selectionsRemaining":1,"writeIns":0,"pageNumber":1,"sideNumber":1,"columnNumber":0,"ballotItemHeader":null,"printableBallotOptions":[{"id":"01000000-ed5e-3013-7264-08df1596c0a9","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-a977-08df1596c0a9","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotOptions":[{"id":"01000000-ed5e-3013-7264-08df1596c0a9","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-a977-08df1596c0a9","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-8fd9-08df1596c058","nativeId":"Prop 3 Buffalo_:13","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":20,"relativeOrder":13,"type":3,"title":[{"languageID":"en","text":"City of Buffalo Charter Amendment empowering Council to fill vacancy if Council President becomes Acting Mayor "},{"languageID":"1","text":"Enmienda a la Carta Orgánica de la Ciudad de Buffalo que faculta al Concejo para cubrir una vacante si el presidente del Concejo asume el cargo de alcalde interino."}],"uniqueTitle":[{"languageID":"en","text":"Prop 3 Buffalo"},{"languageID":"1","text":"Prop 3 Buffalo"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Amends City Charter to empower the Common Council to temporarily fill the district seat of the Common Council President if that person becomes Acting Mayor. / Modifica la Carta Constitutiva de la Ciudad para facultar al Concejo Municipal a cubrir temporalmente el escaño distrital del Presidente del Concejo Municipal si dicha persona asume el cargo de Alcalde Interino.\r\n\r\nA “YES” vote will allow the Common Council to temporarily fill the district seat of a Common Council President who becomes Acting Mayor. / Un voto a favor (\"SÍ\") permitirá al Concejo Municipal cubrir temporalmente el escaño distrital del Presidente del Concejo Municipal que asuma el cargo de Alcalde Interino.\r\n\r\nA “NO” vote will leave the district seat of a Common Council President who becomes Acting Mayor vacant. / Un voto en contra (\"NO\") dejará vacante el escaño distrital del Presidente del Concejo Municipal que asuma el cargo de Alcalde Interino.\r\n\r\n"},{"languageID":"1","text":"Amends City Charter to empower the Common Council to temporarily fill the district seat of the Common Council President if that person becomes Acting Mayor. / Modifica la Carta Constitutiva de la Ciudad para facultar al Concejo Municipal a cubrir temporalmente el escaño distrital del Presidente del Concejo Municipal si dicha persona asume el cargo de Alcalde Interino.\r\n\r\nA “YES” vote will allow the Common Council to temporarily fill the district seat of a Common Council President who becomes Acting Mayor. / Un voto a favor (\"SÍ\") permitirá al Concejo Municipal cubrir temporalmente el escaño distrital del Presidente del Concejo Municipal que asuma el cargo de Alcalde Interino.\r\n\r\nA “NO” vote will leave the district seat of a Common Council President who becomes Acting Mayor vacant. / Un voto en contra (\"NO\") dejará vacante el escaño distrital del Presidente del Concejo Municipal que asuma el cargo de Alcalde Interino.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en","text":"Write-In"},{"languageID":"1","text":"Escribe"}],"noCandidateText":[],"voteForMax":1,"maxRank":null,"html":[],"active":true,"selectionsRemaining":1,"writeIns":0,"pageNumber":1,"sideNumber":2,"columnNumber":0,"ballotItemHeader":null,"printableBallotOptions":[{"id":"01000000-ed5e-3013-312c-08df1596c0aa","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-685d-08df1596c0aa","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotOptions":[{"id":"01000000-ed5e-3013-312c-08df1596c0aa","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-685d-08df1596c0aa","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-c3eb-08df1596c058","nativeId":"Prop 4 Buffalo_:14","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":21,"relativeOrder":14,"type":3,"title":[{"languageID":"en","text":"City of Buffalo Charter Amendment to Limit Holdover Terms and to Review Inactive Boards"},{"languageID":"1","text":"Enmienda a la Carta Orgánica de la Ciudad de Búfalo para limitar los mandatos\r\nen prórroga y revisar las juntas inactivas"}],"uniqueTitle":[{"languageID":"en","text":"Prop 4 Buffalo"},{"languageID":"1","text":"Prop 4 Buffalo"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Amends the City Charter to limit members of City boards from serving past the expiration of their terms and requires the Common Council to review boards that have been inactive. / Modifica la Carta Constitucional de la Ciudad para limitar la permanencia de los miembros de las juntas municipales más allá del vencimiento de sus mandatos y exige al Concejo Municipal que revise aquellas juntas que hayan permanecido inactivas.\r\n\r\nA “YES” vote will limit members of City boards from serving more than sixty days after their terms expire and will require the Common Council to review the status of inactive City Boards. / Un voto a favor (\"SÍ\") limitará la permanencia de los miembros de las juntas municipales a un máximo de sesenta días tras el vencimiento de sus mandatos y exigirá al Concejo Municipal revisar la situación de las juntas inactivas.\r\n\r\nA “NO” vote will maintain the current situation where members of many city boards serve long after the expiration or their terms and dormant City boards remain in existence for years after they are no longer active. / Un voto en contra (\"NO\") mantendrá la situación actual, en la que los miembros de muchas juntas municipales continúan en sus cargos mucho después de que sus mandatos hayan expirado y las juntas inactivas permanecen vigentes durante años tras haber cesado su actividad.\r\n\r\n"},{"languageID":"1","text":"Amends the City Charter to limit members of City boards from serving past the expiration of their terms and requires the Common Council to review boards that have been inactive. / Modifica la Carta Constitucional de la Ciudad para limitar la permanencia de los miembros de las juntas municipales más allá del vencimiento de sus mandatos y exige al Concejo Municipal que revise aquellas juntas que hayan permanecido inactivas.\r\n\r\nA “YES” vote will limit members of City boards from serving more than sixty days after their terms expire and will require the Common Council to review the status of inactive City Boards. / Un voto a favor (\"SÍ\") limitará la permanencia de los miembros de las juntas municipales a un máximo de sesenta días tras el vencimiento de sus mandatos y exigirá al Concejo Municipal revisar la situación de las juntas inactivas.\r\n\r\nA “NO” vote will maintain the current situation where members of many city boards serve long after the expiration or their terms and dormant City boards remain in existence for years after they are no longer active. / Un voto en contra (\"NO\") mantendrá la situación actual, en la que los miembros de muchas juntas municipales continúan en sus cargos mucho después de que sus mandatos hayan expirado y las juntas inactivas permanecen vigentes durante años tras haber cesado su actividad.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en","text":"Write-In"},{"languageID":"1","text":"Escribe"}],"noCandidateText":[],"voteForMax":1,"maxRank":null,"html":[],"active":true,"selectionsRemaining":1,"writeIns":0,"pageNumber":1,"sideNumber":2,"columnNumber":0,"ballotItemHeader":null,"printableBallotOptions":[{"id":"01000000-ed5e-3013-f19e-08df1596c0aa","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-24e7-08df1596c0ab","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotOptions":[{"id":"01000000-ed5e-3013-f19e-08df1596c0aa","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-24e7-08df1596c0ab","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-faaa-08df1596c058","nativeId":"Prop 5 Buffalo_:15","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":22,"relativeOrder":15,"type":3,"title":[{"languageID":"en","text":"City of Buffalo Charter Amendment regarding Mayoral Succession"},{"languageID":"1","text":"Enmienda a la Carta Orgánica de la Ciudad de Buffalo relativa a la sucesión en la alcaldía"}],"uniqueTitle":[{"languageID":"en","text":"Prop 5 Buffalo"},{"languageID":"1","text":"Prop 5 Buffalo"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Amends the Charter clarifying that in the event the office of Mayor becomes vacant, the Common Council President becomes Acting Mayor. / Modifica la Carta Constitutiva para aclarar que, en caso de quedar vacante el cargo de alcalde, el presidente del Concejo Municipal asumirá el cargo de alcalde interino.\r\n\r\nA “YES” Vote will amend section 4-5 of the City Charter to clarify that if the office of Mayor becomes vacant the Common Council President becomes Acting Mayor. / Un voto a favor (\"SÍ\") modificará la sección 4-5 de la Carta Constitutiva de la ciudad para aclarar que, si el cargo de alcalde queda vacante, el presidente del Concejo Municipal asumirá el cargo de alcalde interino.\r\n\r\nA “NO” vote will leave the City Charter unchanged. / Un voto en contra (\"NO\") dejará la Carta Constitutiva de la ciudad sin cambios.\r\n\r\n"},{"languageID":"1","text":"Amends the Charter clarifying that in the event the office of Mayor becomes vacant, the Common Council President becomes Acting Mayor. / Modifica la Carta Constitutiva para aclarar que, en caso de quedar vacante el cargo de alcalde, el presidente del Concejo Municipal asumirá el cargo de alcalde interino.\r\n\r\nA “YES” Vote will amend section 4-5 of the City Charter to clarify that if the office of Mayor becomes vacant the Common Council President becomes Acting Mayor. / Un voto a favor (\"SÍ\") modificará la sección 4-5 de la Carta Constitutiva de la ciudad para aclarar que, si el cargo de alcalde queda vacante, el presidente del Concejo Municipal asumirá el cargo de alcalde interino.\r\n\r\nA “NO” vote will leave the City Charter unchanged. / Un voto en contra (\"NO\") dejará la Carta Constitutiva de la ciudad sin cambios.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en","text":"Write-In"},{"languageID":"1","text":"Escribe"}],"noCandidateText":[],"voteForMax":1,"maxRank":null,"html":[],"active":true,"selectionsRemaining":1,"writeIns":0,"pageNumber":1,"sideNumber":2,"columnNumber":0,"ballotItemHeader":null,"printableBallotOptions":[{"id":"01000000-ed5e-3013-acd9-08df1596c0ab","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-e5f6-08df1596c0ab","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotOptions":[{"id":"01000000-ed5e-3013-acd9-08df1596c0ab","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-e5f6-08df1596c0ab","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-33e5-08df1596c059","nativeId":"Prop 6 Buffalo_:16","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":23,"relativeOrder":16,"type":3,"title":[{"languageID":"en","text":"City of Buffalo Charter Amendment to require public website about City boards and board training"},{"languageID":"1","text":"Enmienda a la Carta Orgánica de la Ciudad de Búfalo para exigir un sitio web público sobre las juntas municipales y la capacitación de sus miembros"}],"uniqueTitle":[{"languageID":"en","text":"Prop 6 Buffalo"},{"languageID":"1","text":"Prop 6 Buffalo"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Amends City Charter to require a website providing information about City boards, including an application to fill vacancies, and requires training and orientation for new board members. / Modifica la Carta Constitucional de la Ciudad para exigir la creación de un sitio web que proporcione información sobre las juntas municipales, incluyendo una solicitud para cubrir vacantes, y para requerir capacitación y orientación para los nuevos miembros de dichas juntas.\r\n\r\nA “YES” vote will mandate that the city establish such a website and training. / Un voto a favor (\"SÍ\") obligará a la ciudad a establecer dicho sitio web y programa de capacitación.\r\n\r\nA “NO” vote will not mandate such a website and training. / Un voto en contra (\"NO\") no obligará a establecer dicho sitio web ni el programa de capacitación.\r\n\r\n"},{"languageID":"1","text":"Amends City Charter to require a website providing information about City boards, including an application to fill vacancies, and requires training and orientation for new board members. / Modifica la Carta Constitucional de la Ciudad para exigir la creación de un sitio web que proporcione información sobre las juntas municipales, incluyendo una solicitud para cubrir vacantes, y para requerir capacitación y orientación para los nuevos miembros de dichas juntas.\r\n\r\nA “YES” vote will mandate that the city establish such a website and training. / Un voto a favor (\"SÍ\") obligará a la ciudad a establecer dicho sitio web y programa de capacitación.\r\n\r\nA “NO” vote will not mandate such a website and training. / Un voto en contra (\"NO\") no obligará a establecer dicho sitio web ni el programa de capacitación.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en","text":"Write-In"},{"languageID":"1","text":"Escribe"}],"noCandidateText":[],"voteForMax":1,"maxRank":null,"html":[],"active":true,"selectionsRemaining":1,"writeIns":0,"pageNumber":1,"sideNumber":2,"columnNumber":0,"ballotItemHeader":null,"printableBallotOptions":[{"id":"01000000-ed5e-3013-6817-08df1596c0ac","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-9d11-08df1596c0ac","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotOptions":[{"id":"01000000-ed5e-3013-6817-08df1596c0ac","nativeId":"Yes1","order":1,"relativeOrder":1,"type":1,"title":[{"languageID":"en","text":"Yes"},{"languageID":"1","text":"Yes"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0},{"id":"01000000-ed5e-3013-9d11-08df1596c0ac","nativeId":"No2","order":2,"relativeOrder":2,"type":1,"title":[{"languageID":"en","text":"No"},{"languageID":"1","text":"No"}],"uniqueTitle":[],"subTitle":[{"languageID":"en","text":""},{"languageID":"1","text":""}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyAbbreviation":[{"languageID":"en","text":"NON"},{"languageID":"1","text":"NON"}],"partyOrder":1,"partyIsNPDefault":true,"displayParty":false,"selected":false,"writeInSelection":null,"isWriteIn":false,"selectedRank":0}],"ballotStyles":null,"proofingStatus":null,"proofingComments":null,"proofingCompletedBy":null,"proofingCompletedAt":"","undervoteWarningEnabled":true,"overvoteWarningEnabled":false,"overvotePreventionEnabled":true},{"id":"01000000-ed5e-3013-6779-08df1596c059","nativeId":"Prop 7 Buffalo_:17","electionId":"01000000-7cf4-7592-b5cd-08df1596b8de","order":24,"relativeOrder":17,"type":3,"title":[{"languageID":"en","text":"City of Buffalo Charter Amendment for creation of temporary task forces"},{"languageID":"1","text":"Enmienda a la Carta Orgánica de la Ciudad de Búfalo para la creación de\r\ngrupos de trabajo temporales"}],"uniqueTitle":[{"languageID":"en","text":"Prop 7 Buffalo"},{"languageID":"1","text":"Prop 7 Buffalo"}],"subTitle":[],"instructions":[],"referendum":[{"languageID":"en","text":"Amends Buffalo City Charter to empower the Mayor and the Common Council to appoint temporary task forces for terms not exceeding two years. / Modifica la Carta Constitucional de la Ciudad de Buffalo para facultar al Alcalde y al Concejo Municipal a designar grupos de trabajo temporales por períodos que no excedan los dos años.\r\n\r\nA “YES” vote will give these powers to the Mayor and Common Council. / Un voto a favor (“SÍ”) otorgará estas facultades al Alcalde y al Concejo Municipal.\r\n\r\nA “NO” vote will not give them this power. / Un voto en contra (“NO”) no les otorgará dicha facultad.\r\n\r\n"},{"languageID":"1","text":"Amends Buffalo City Charter to empower the Mayor and the Common Council to appoint temporary task forces for terms not exceeding two years. / Modifica la Carta Constitucional de la Ciudad de Buffalo para facultar al Alcalde y al Concejo Municipal a designar grupos de trabajo temporales por períodos que no excedan los dos años.\r\n\r\nA “YES” vote will give these powers to the Mayor and Common Council. / Un voto a favor (“SÍ”) otorgará estas facultades al Alcalde y al Concejo Municipal.\r\n\r\nA “NO” vote will not give them this power. / Un voto en contra (“NO”) no les otorgará dicha facultad.\r\n\r\n"}],"text1":[],"text2":[],"partyId":"dfcefc00-19ee-4714-b888-54329cc86274","partyName":[{"languageID":"en","text":"NONPARTISAN"},{"languageID":"1","text":"NONPARTISAN"}],"partyOrder":1,"partyIsNPDefault":true,"writeInText":[{"languageID":"en",