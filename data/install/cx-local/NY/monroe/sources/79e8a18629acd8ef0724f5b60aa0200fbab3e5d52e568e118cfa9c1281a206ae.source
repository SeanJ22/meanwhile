<div class="tbox tbox-c-blue tbox-c-red tbox-s-border">
<h3 class="tbox-title tc">GENERAL ELECTION 2026</h3>

<div class="tbox-txt">
<div class="rcols rcols2">
<div class="rcol rcol1">
<div style="text-align:center">
<div style="text-align:center">
<div style="text-align:center"><strong>GENERAL ELECTION&nbsp;EARLY VOTING</strong></div>

<div style="text-align:center">
<div style="text-align:center"><span class="txt-red"><span class="txt-green"><strong>October 24 - November 1, 2026</strong></span></span></div>

<div style="text-align:center"><strong><a data-link="out" href="https://www.monroecounty.gov/elections-earlyvoting">Click here for Early Voting Times &amp; Locations</a></strong></div>
</div>
</div>
</div>
</div>

<div class="rcol rcol2">
<div style="text-align:center"><strong>GENERAL&nbsp;ELECTION DAY</strong></div>

<div style="text-align:center">
<div style="text-align:center"><span class="txt-red"><span class="txt-green"><strong>November 3, 2026</strong></span></span></div>

<div style="text-align:center"><strong>Polls open 6am - 9pm</strong></div>
</div>
</div>
</div>

<div style="text-align:center">
<hr />
<p><strong><a data-link-ext="pdf" href="/files/boe/GE26%20EV%20Day%209%20Voter%20Turnout%20Report%202026-11-1.pdf">Early Voting Day 9 Voter Turnout Report - General Election 2026</a></strong></p>

<hr />
<p><a data-link-ext="pdf" href="/files/boe/GE26%20Candidates%20List%20Certification%20(10-6-26).pdf">November General Election - Certification of Candidates</a></p>

<p><a data-link-ext="pdf" href="/files/boe/26-11-03%20%20Notice%20to%20Candidates%20and%20Party%20Chairs%20GE26%20Notice.pdf">Notice to Candidates and Party Chairs - General Election 2026 </a></p>

