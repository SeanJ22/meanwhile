<style>
.jp-accordion-search-clear {
    color: #999;
    cursor: pointer;
    transition: color 0.15s ease-in-out;
}
.jp-accordion-search-clear:hover {
    color: #333;
}
</style>

<script>
(function() {
    'use strict';

    function initAccordion() {
        const wrapper = document.getElementById("wrap_js-2");
        if (!wrapper) return;

        const accEl = wrapper.querySelector('[uk-accordion]') || wrapper.querySelector('.uk-accordion') || document.getElementById("js-2");
        if (!accEl) return;

        const uniqueId = "js-2";
        const rememberTab = false;
        const rememberMode = "local";
        const enableUrl = false;
        const scrollToUrl = false;
        const scrollToOnLoad = false;
        const scrollOffset = -100;
        const scrollOffsetUrl = -100;
        const scrollDuration = "smooth";
        const scrollDurationUrl = "smooth";
        const serverActiveTab = "";
        const searchAutoOpen = true;

        function getDirectItems() {
            return Array.from(accEl.children).filter(function(el) {
                return el.classList.contains('el-item');
            });
        }

        let activeSetFromHash = false;

        // 1. URL Hash Deep Linking
        const rawHash = (window.location.hash || '').replace('#', '');
        const cleanHash = rawHash.replace(/[^a-zA-Z0-9_\-]/g, '');
        if (cleanHash) {
            const target = accEl.querySelector('.jp_' + CSS.escape(cleanHash));
            if (target) {
                const targetId = target.id;
                const itemIndexStr = targetId.replace(uniqueId + '_', '');
                const itemIndex = parseInt(itemIndexStr, 10);
                if (!isNaN(itemIndex)) {
                    if (window.UIkit && UIkit.accordion) {
                        UIkit.accordion(accEl).toggle(itemIndex, true);
                    }
                    activeSetFromHash = true;

                    if (scrollToUrl) {
                        setTimeout(function() {
                            const rect = target.getBoundingClientRect();
                            window.scrollTo({
                                top: window.pageYOffset + rect.top + (scrollOffsetUrl),
                                left: 0,
                                behavior: scrollDurationUrl
                            });
                        }, 400);
                    }
                }
            }
        }

        // 2. State Persistence (if hash not matched)
        if (!activeSetFromHash && rememberTab) {
            let savedActive = null;
            if (rememberMode === 'local') {
                try { savedActive = localStorage.getItem('jp_acc_' + uniqueId); } catch(e) {}
            } else if (rememberMode === 'session') {
                try { savedActive = sessionStorage.getItem('jp_acc_' + uniqueId); } catch(e) {}
            } else if (rememberMode === 'server') {
                savedActive = serverActiveTab;
            }

            if (savedActive) {
                const cleanActive = savedActive.replace(uniqueId + '_', '');
                const activeIdx = parseInt(cleanActive, 10);
                if (!isNaN(activeIdx) && window.UIkit && UIkit.accordion) {
                    UIkit.accordion(accEl).toggle(activeIdx, true);
                }
            }
        }

        // 3. Scroll to Accordion on Load (if not handled by Hash)
        if (!activeSetFromHash && scrollToOnLoad) {
            setTimeout(function() {
                const rect = accEl.getBoundingClientRect();
                window.scrollTo({
                    top: window.pageYOffset + rect.top + (scrollOffset),
                    left: 0,
                    behavior: scrollDuration
                });
            }, 400);
        }

        // 4. Listen for tab open events to persist state and update URL
        if (window.UIkit && UIkit.util) {
            UIkit.util.on(accEl, 'shown', function (ev) {
                let activeItem = null;
                const items = getDirectItems();
                items.forEach(function (item) {
                    if (item.classList.contains('uk-open')) {
                        activeItem = item;
                    }
                });

                if (activeItem) {
                    const activeId = activeItem.id;
                    const linkEl = activeItem.querySelector('a.uk-accordion-title');

                    // Update URL if enabled
                    if (enableUrl && linkEl && linkEl.href && linkEl.href !== '#' && !linkEl.href.endsWith('#')) {
                        window.history.replaceState(null, '', linkEl.href);
                    }

                    // Persist state
                    if (rememberTab && activeId) {
                        if (rememberMode === 'local') {
                            try { localStorage.setItem('jp_acc_' + uniqueId, activeId); } catch(e) {}
                        } else if (rememberMode === 'session') {
                            try { sessionStorage.setItem('jp_acc_' + uniqueId, activeId); } catch(e) {}
                        } else if (rememberMode === 'server') {
                            const token = (typeof Joomla !== 'undefined' && Joomla.getOptions) ? Joomla.getOptions('csrf.token', '') : '';
                            const xhr = new XMLHttpRequest();
                            xhr.open('POST', 'https://www.westchesterlegislatorsny.gov/index.php?task=jp_accordion_save&id=' + encodeURIComponent(uniqueId) + '&active=' + encodeURIComponent(activeId), true);
                            xhr.setRequestHeader('Content-type', 'application/x-www-form-urlencoded');
                            xhr.send(token ? token + '=1' : '');
                        }
                    }
                }
            });
        }

        // 5. Expand All / Collapse All functionality
        function expandAll() {
            const acc = (window.UIkit && UIkit.accordion) ? UIkit.accordion(accEl) : null;
            const items = getDirectItems();

            if (acc) {
                acc.multiple = true;
                items.forEach(function (item) {
                    if (!item.classList.contains(acc.clsOpen || 'uk-open')) {
                        acc.toggle(item, false);
                    }
                });
            }

            // Direct DOM sync ensures all items are visibly expanded and accessible
            items.forEach(function (item) {
                item.classList.add('uk-open');
                const titleLink = item.querySelector('.uk-accordion-title');
                if (titleLink) {
                    titleLink.setAttribute('aria-expanded', 'true');
                }
                const content = item.querySelector('.uk-accordion-content');
                if (content) {
                    content.hidden = false;
                    content.style.display = '';
                }
            });
        }

        function collapseAll() {
            const acc = (window.UIkit && UIkit.accordion) ? UIkit.accordion(accEl) : null;
            const items = getDirectItems();

            if (acc) {
                acc.collapsible = true;
                items.forEach(function (item) {
                    if (item.classList.contains(acc.clsOpen || 'uk-open')) {
                        acc.toggle(item, false);
                    }
                });
            }

            // Direct DOM sync ensures all items are closed
            items.forEach(function (item) {
                item.classList.remove('uk-open');
                const titleLink = item.querySelector('.uk-accordion-title');
                if (titleLink) {
                    titleLink.setAttribute('aria-expanded', 'false');
                }
                const content = item.querySelector('.uk-accordion-content');
                if (content) {
                    content.hidden = true;
                }
            });
        }

        const expBtn = wrapper.querySelector('.jp-acc-expand-all');
        const colBtn = wrapper.querySelector('.jp-acc-collapse-all');
        if (expBtn) {
            expBtn.addEventListener('click', function (e) {
                e.preventDefault();
                expandAll();
            });
        }
        if (colBtn) {
            colBtn.addEventListener('click', function (e) {
                e.preventDefault();
                collapseAll();
            });
        }

        // 6. Live Search Filter & Clear Button
        const searchInput = wrapper.querySelector('.jp-accordion-search');
        const clearBtn = wrapper.querySelector('.jp-accordion-search-clear');

        function applySearch(q) {
            const acc = (window.UIkit && UIkit.accordion) ? UIkit.accordion(accEl) : null;
            const items = getDirectItems();

            if (clearBtn) {
                clearBtn.style.display = q ? '' : 'none';
            }

            if (q) {
                if (acc && searchAutoOpen) {
                    acc.multiple = true;
                }
                items.forEach(function (item) {
                    const titleEl = item.querySelector('.uk-accordion-title');
                    const contentEl = item.querySelector('.uk-accordion-content');
                    const titleText = titleEl ? titleEl.textContent.toLowerCase() : '';
                    const contentText = contentEl ? contentEl.textContent.toLowerCase() : '';
                    const match = titleText.includes(q) || contentText.includes(q);

                    if (match) {
                        item.style.display = '';
                        if (searchAutoOpen) {
                            item.classList.add('uk-open');
                            if (contentEl) {
                                contentEl.hidden = false;
                                contentEl.style.display = '';
                            }
                            if (titleEl) {
                                titleEl.setAttribute('aria-expanded', 'true');
                            }
                        } else {
                            item.classList.remove('uk-open');
                            if (contentEl) {
                                contentEl.hidden = true;
                            }
                            if (titleEl) {
                                titleEl.setAttribute('aria-expanded', 'false');
                            }
                        }
                    } else {
                        item.style.display = 'none';
                        item.classList.remove('uk-open');
                        if (contentEl) {
                            contentEl.hidden = true;
                        }
                        if (titleEl) {
                            titleEl.setAttribute('aria-expanded', 'false');
                        }
                    }
                });
            } else {
                // Reset all items when search is cleared
                items.forEach(function (item) {
                    item.style.display = '';
                    item.classList.remove('uk-open');
                    const contentEl = item.querySelector('.uk-accordion-content');
                    if (contentEl) {
                        contentEl.hidden = true;
                    }
                    const titleEl = item.querySelector('.uk-accordion-title');
                    if (titleEl) {
                        titleEl.setAttribute('aria-expanded', 'false');
                    }
                });
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                applySearch(this.value.trim().toLowerCase());
            });

            searchInput.addEventListener('search', function () {
                applySearch(this.value.trim().toLowerCase());
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', function (e) {
                e.preventDefault();
                if (searchInput) {
                    searchInput.value = '';
                    applySearch('');
                    searchInput.focus();
                }
            });
        }
    }

    // Initialize immediately if DOM is already ready (e.g. YOOtheme Customizer builder preview), or on DOMContentLoaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAccordion);
    } else {
        initAccordion();
    }
})();
</script>
                
            
        
    
</div>
    
