      "scopedCoverageNotes": [
        {
          "text": "Current official Franklin County general candidate list revalidates11 held local office/term fields and all13 ordinary candidates: county auditor, county commissioner, two Tenth Appellate District seats and seven Common Pleas seats. No new local office or person is minted. This is official-list coverage; actual government-hosted sample acquisition for all11 fields remains pending.",
          "scope": {
            "kind": "DIVISIONS",
            "ids": [
              "ocd-division/country:us/state:oh/county:franklin"
            ]
          }
        },
        {
          "text": "No municipal, school, township or special-district candidate office appears in the current linked general-election candidate list. Other sample styles have not been independently compared for late changes; no reader absence is inferred from this inventory.",
          "scope": {
            "kind": "DIVISIONS",
            "ids": [
              "ocd-division/country:us/state:oh/county:franklin"
            ]
          }
        },
        {
          "text": "The official county source and Ohio Revised Code confirm the Tenth Appellate District consists solely of Franklin County, so existing held county keys represent the exact full electorate. All held candidate core fields, office IDs and vote limits remain unchanged.",
          "scope": {
            "kind": "DIVISIONS",
            "ids": [
              "ocd-division/country:us/state:oh/county:franklin"
            ]
          }
        },
        {
          "text": "No listed local ordinary candidate has a Write-In Yes flag in the current official list. Statewide/legislative declared-write-in rows are outside this local packet. Blank write-in cells are not people. Existing statewide, legislative and measure records/explanations remain unchanged.",
          "scope": {
            "kind": "DIVISIONS",
            "ids": [
              "ocd-division/country:us/state:oh/county:franklin"
            ]
          }
        }
