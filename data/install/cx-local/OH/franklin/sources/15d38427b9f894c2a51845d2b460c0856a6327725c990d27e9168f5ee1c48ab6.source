background: rgb(170,0,0);
background: -moz-linear-gradient(top, rgba(170,0,0,1) 0%, rgba(170,19,19,1) 25%, rgba(170,19,19,1) 75%, rgba(156,7,7,1) 100% ); /* FF3.6-15 */
background: -webkit-linear-gradient(top, rgba(170,0,0,1) 0%, rgba(170,19,19,1) 25%, rgba(170,19,19,1) 75%, rgba(156,7,7,1) 100%); /* Chrome10-25,Safari5.1-6 */
background: linear-gradient(to bottom, rgba(170,0,0,1) 0%, rgba(170,19,19,1) 25%, rgba(170,19,19,1) 75%, rgba(156,7,7,1) 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#aa0000', endColorstr='#9c0707',GradientType=0 ); /* IE6-9 */
}

.portal-footer-link {
