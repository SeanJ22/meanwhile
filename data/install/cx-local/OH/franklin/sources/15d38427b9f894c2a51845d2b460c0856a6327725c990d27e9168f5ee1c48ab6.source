</section>
<div id="securityModal" class="modal fade" role="dialog">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title" style="text-align: left; color: black;">Acknowledgement</h4>
			</div>
			<div class="modal-body" style="display: flex; color: black !important; margin-bottom: 0;">
