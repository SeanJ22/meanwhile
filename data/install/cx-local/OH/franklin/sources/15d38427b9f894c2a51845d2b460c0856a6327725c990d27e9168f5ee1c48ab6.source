    <style>
        html {
            /* Smoother scrolling for iOS phones */
            -webkit-overflow-scrolling: touch;
        }

        .wrapper {
            min-height: 100%;
            margin: 0 auto -30px;
        }

        .portal-header-content {
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
          align-items: center;
          height: 100%;
          margin: auto;
        }

        .portal-header-sub {
            color: #FFFFFF;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #102842; /* Old browsers */
        }

        .portal-tagline {
            color: #FFFFFF;
            text-transform: uppercase;
            margin: 0;
            padding: 10px;
            font-size: 18px;
        }


        .portal-footer-tagline {
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
            color: #FFFFFF;
            text-align: center;
            font-size: 12px;
        }

        @media screen and (max-width: 600px) {
          .portal-footer-tagline {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
            display: inline-block;
          }
        }

        .portal-logo {
            width: 220px; 
            min-width: 150px; 
            height: auto;
        }
        @media only screen and (max-width: 768px) {


            .portal-header-buttons {
                display: none !important;
            }

            .portal-header-buttons-mobile {
                display: inline-block !important;
            }
        }

        .portal-header-buttons, #btnSkipContent {
            margin-right: 5px;
            margin-bottom: 2px;
            text-transform: uppercase;
            text-align: right;
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
        }

        #btnSkipContent, #btnSkipContent ~ span {
                opacity: 0;
        }

        #btnSkipContent:focus, #btnSkipContent:focus ~ span {
                opacity: 1;
        }

        #skipToMainContent{
            cursor:default;
        }

        .portal-header-buttons-mobile {
            display: none;
            margin-right: 10px;
        }

        /* Bootstrap dropdown styling */
        a.dropdown-toggle:focus, a.dropdown-toggle:hover {
            color: #23527c;
            outline: 5px auto !important;
            text-decoration: none !important;
        }

        .dropdown-item {
            display: block;
            width: 100%;
            padding: .25rem 1.5rem;
            clear: both;
            font-weight: 400;
            color: #212529;
            text-align: inherit;
            white-space: nowrap;
            background-color: transparent;
            border: 0;
        }


        .container-sidebar {
            display: inline-block;
            border-right: 1px solid #DDD;
        }

        .container-content {
            display: inline-block;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

            .container-content > .container-body {
                height: calc(100% - 30px);
                overflow-y: auto;
            }

        .textBoxInput {
            border-radius: 5px;
            background-color: white;
        }

        input[type="text"]:disabled {
            cursor: not-allowed;
        }

        .portal-footer {
          height: 30px;
        }

        @media (max-width: 767px) {
          .portal-footer {
            height: 35px;
          }
        }

        @media (max-width: 575px) {
          .portal-footer {
            height: 40px;
          }
        }

        .data {
            font-size: 18px;
        }

        .data-header {
            font-size: 14px;
            margin-bottom: 0px;
            color: #757575;
        }


        .details-cell {
            width: 100%;
            margin: 0px auto;
            margin-top: 10px;
            padding: 0 20px 10px 20px;
            background-color: white;
            border: 1px solid #e6e6e6;
            border-left-width: 5px;
            border-left-style: solid;
            border-radius: 5px;
            color: #2779B0;
        }

            .details-cell h4 {
                margin-bottom: 10px;
                margin-top: 10px;
                margin-left: 0px;
                color: #2779B0;
                font-size: 19px;
                font-family: "Open Sans", 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .details-cell h3 {
                margin-bottom: 10px;
                margin-top: 10px;
                margin-left: 0px;
                color: #2779B0;
                font-size: 16px;
                font-family: "Open Sans", 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

        .vertical-space-out {
            margin: 10px 0;
        }

        .expand-cell:hover {
            cursor: pointer;
        }

        .content-details-cell {
            margin-top: 10px;
        }
                
        hr.style-six {
            width: 100%;
            border: 0;
            height: 0;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            margin-top: 2px;
            margin-bottom: 4px;
        }

        /* Bootstrap overrides */
        .tooltip {
            font-family: inherit;
        }

            .tooltip .tooltip-inner {
                padding: 10px;
                font-size: 14px;
            }

        /* DevExpress overrides */
        .dxeTextBox_Moderno .dxeEditArea_Moderno,
        .dxeEditArea_Moderno.dxeEditAreaSys,
        .dxeButtonEdit_Moderno {
            background-color: white;
        }

        /* Child page styling */
        .container-page-body {
            width: 90%;
            max-width: 800px;
            margin: 0px auto;
        }

        .container-messages {
            text-align: left;
            margin: 10px auto;
            width: 100%;
        }

            .container-messages > div {
                margin: 10px 0;
            }

        .container-captcha {
            text-align: center;
            margin-bottom: 10px;
        }

            .container-captcha > .g-recaptcha {
                display: inline-block;
                margin: 0 auto;
                width: 304px;
            }


        /* Temp application override */
        .info-header .fa {
            opacity: 1 !important;
            position: absolute !important;
            top: 50% !important;
            left: 0 !important;
            font-size: 88px !important;
            margin-left: -25px !important;
            margin-top: -45px !important;
        }

        .info-header.grey {
            border: 1px solid #e8e8e8;
            background-color: #f6f6f6;
        }

            .info-header.grey .fa {
                color: #efefef;
            }

        .info-header .info-header-msg {
            position: relative;
            margin-left: 50px;
        }

        .info-header span {
            opacity: 1;
        }

        a {
            color: #0070d1;
        }

        .search-btn, .clear-btn {
            padding-left: 15px;
            padding-right: 15px;
            min-width: unset !important;
        }

        .search-btn {
            color: #fff;
            background-color: #2779b0
        }

        .error {
            border: 1px solid #FF0101 !important;
        }

        .recaptcha-instr {
            margin: 0 auto;
            width: 304px;
            display: flex;
        }

            .recaptcha-instr > h5 {
                font-weight: 600;
            }
