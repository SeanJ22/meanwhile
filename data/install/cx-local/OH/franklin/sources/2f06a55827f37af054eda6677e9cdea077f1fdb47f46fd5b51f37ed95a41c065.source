</div>

<script type="text/javascript">
	(function() {
		let $containerBody = $('.container-body');
		let $wrapper = $('div.wrapper');
		let $footer = $('.portal-footer');
		
		$containerBody.css('height', 'calc(100% - 50px)');
		$wrapper.css('margin', '0 auto -50px');
		$footer.css('min-height', '30px');
