<style>
	/* Header Addon */
	.usa-banner {
		padding-left: 0 !important;
		padding-right: 0 !important;
		padding-bottom: 3px;
	}

	.usa-banner p {
		display: inline-block;
		word-wrap: normal;
		color: white;
		line-height: 1;
		padding: 3.75px 3.75px 3.75px;
		font-size: 1.2em;
		margin: 0px;
	}

	.usa-banner-flag a {
		display: inline-block;
		color: white;
		text-decoration: underline;
		line-height: 1;
		padding: 3.75px 3.75px 3.75px;
		font-size: 1.2em;
	}

		.usa-banner-flag a:hover, .usa-banner-flag a:focus {
			background: white;
			color: #004677;
		}

	.usa-banner-icons {
		display: inline-flex;
		font-size: 14px;
		text-align: left;
	}

		.usa-banner-icons img {
			height: 3.5rem;
			width: 3.5rem;
			filter: brightness(0.1);
			margin-right: 20px;
		}

	.usa-banner-flag {
		font-size: 10px;
		padding-left: 0 !important;
		padding-right: 0 !important;
		margin-left: 0 !important;
		margin-right: 0 !important;
	}

		.usa-banner-icons img {
			height: 3.5rem;
			width: 3.5rem;
			filter: brightness(0.1);
		}

	.usaAccordion {
		display: none;
	}
 
        #skipToMainContent {
          display: none;
        }

	@media only screen and (min-width: 600px) {
		.usa-banner > p, .usa-banner-flag > p > a {
			font-size: 1em;
		}
	}
</style>
<section class="gov-banner" style="margin: 0px; padding: 0px" role="banner">
	<div class="row usa-banner-flag" style="display: flex; flex-direction: row; align-items: center;">
		<img src="../Common/images/ohio-flag.png" alt="Ohio Flag" style="margin-left: auto; margin-right: 5px; height: 30px; width: 40px;" />
		<p style="margin-right: auto; margin-bottom: 0; font-size: 12px;">An official government website. <a id="usaAccordionlink" href="#" aria-expanded="false">Here's how you know</a></p>
	</div>
</section>
<div id="securityModal" class="modal fade" role="dialog">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title" style="text-align: left; color: black;">Acknowledgement</h4>
			</div>
			<div class="modal-body" style="display: flex; color: black !important; margin-bottom: 0;">
				<div class="col-xs-12">
					<div class="row usaAccordion" style="display: flex; flex-direction: column;">
						<div class="col-xs-12">
							<div class="usa-banner-icons"><img src="../Common/images/icon-https.png" alt="SSL" /><p><strong>The site is secure.</strong><br />The <strong>https://</strong> ensures you're connecting to the official website and any information you provide is encrypted and cannot be seen by anyone else.</p>
				            </div>
				        </div>
				        <div class="col-xs-12">
				            <div class="usa-banner-icons"><img src="../Common/images/icon-dot-gov.png" alt="Dot gov" /><p><strong>The .gov means it's official</strong><br />Many state and federal websites end in .gov, a domain only used by government entities in the U.S.</p></div></div></div></div>
			</div>
			<div class="modal-footer">
				<div style="margin-left: auto;">
					<button type="button" class="clear-btn" data-dismiss="modal"><span>Okay</span></button>
				</div>
			</div>
		</div>
	</div>
</div>

<div style="display: none;">
