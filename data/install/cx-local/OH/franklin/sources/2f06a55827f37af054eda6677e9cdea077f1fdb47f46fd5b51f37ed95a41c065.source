    <style>
        html {
            /* Smoother scrolling for iOS phones */
            -webkit-overflow-scrolling: touch;
        }

        .wrapper {
            min-height: 100%;
            margin: 0 auto -30px;
        }

        .portal-header-content {
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
          align-items: center;
          height: 100%;
          margin: auto;
        }

        .portal-header-sub {
            color: #FFFFFF;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #102842; /* Old browsers */
        }

        .portal-tagline {
            color: #FFFFFF;
            text-transform: uppercase;
            margin: 0;
            padding: 10px;
            font-size: 18px;
        }


        .portal-footer-tagline {
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
            color: #FFFFFF;
            text-align: center;
            font-size: 12px;
        }

        @media screen and (max-width: 600px) {
          .portal-footer-tagline {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
            display: inline-block;
          }
        }

        .portal-logo {
            width: 220px; 
            min-width: 150px; 
            height: auto;
        }
        @media only screen and (max-width: 768px) {


            .portal-header-buttons {
                display: none !important;
            }

            .portal-header-buttons-mobile {
                display: inline-block !important;
            }
        }

        .portal-header-buttons, #btnSkipContent {
            margin-right: 5px;
            margin-bottom: 2px;
            text-transform: uppercase;
            text-align: right;
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
        }

        #btnSkipContent, #btnSkipContent ~ span {
                opacity: 0;
        }

        #btnSkipContent:focus, #btnSkipContent:focus ~ span {
                opacity: 1;
        }

        #skipToMainContent{
            cursor:default;
        }

        .portal-header-buttons-mobile {
            display: none;
            margin-right: 10px;
        }

        /* Bootstrap dropdown styling */
        a.dropdown-toggle:focus, a.dropdown-toggle:hover {
            color: #23527c;
            outline: 5px auto !important;
            text-decoration: none !important;
        }

        .dropdown-item {
            display: block;
            width: 100%;
            padding: .25rem 1.5rem;
            clear: both;
            font-weight: 400;
            color: #212529;
            text-align: inherit;
            white-space: nowrap;
            background-color: transparent;
            border: 0;
        }


        .container-sidebar {
            display: inline-block;
            border-right: 1px solid #DDD;
        }

        .container-content {
            display: inline-block;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

            .container-content > .container-body {
                height: calc(100% - 30px);
                overflow-y: auto;
            }

        .textBoxInput {
            border-radius: 5px;
            background-color: white;
        }

        input[type="text"]:disabled {
            cursor: not-allowed;
        }

        .portal-footer {
          height: 30px;
        }

        @media (max-width: 767px) {
          .portal-footer {
            height: 35px;
          }
        }

        @media (max-width: 575px) {
          .portal-footer {
            height: 40px;
          }
        }

        .data {
            font-size: 18px;
        }

        .data-header {
            font-size: 14px;
            margin-bottom: 0px;
            color: #757575;
        }


        .details-cell {
            width: 100%;
            margin: 0px auto;
            margin-top: 10px;
            padding: 0 20px 10px 20px;
            background-color: white;
            border: 1px solid #e6e6e6;
            border-left-width: 5px;
            border-left-style: solid;
            border-radius: 5px;
            color: #2779B0;
        }

            .details-cell h4 {
                margin-bottom: 10px;
                margin-top: 10px;
                margin-left: 0px;
                color: #2779B0;
                font-size: 19px;
                font-family: "Open Sans", 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .details-cell h3 {
                margin-bottom: 10px;
                margin-top: 10px;
                margin-left: 0px;
                color: #2779B0;
                font-size: 16px;
                font-family: "Open Sans", 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

        .vertical-space-out {
            margin: 10px 0;
        }

        .expand-cell:hover {
            cursor: pointer;
        }

        .content-details-cell {
            margin-top: 10px;
        }
                
        hr.style-six {
            width: 100%;
            border: 0;
            height: 0;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            margin-top: 2px;
            margin-bottom: 4px;
        }

        /* Bootstrap overrides */
        .tooltip {
            font-family: inherit;
        }

            .tooltip .tooltip-inner {
                padding: 10px;
                font-size: 14px;
            }

        /* DevExpress overrides */
        .dxeTextBox_Moderno .dxeEditArea_Moderno,
        .dxeEditArea_Moderno.dxeEditAreaSys,
        .dxeButtonEdit_Moderno {
            background-color: white;
        }

        /* Child page styling */
        .container-page-body {
            width: 90%;
            max-width: 800px;
            margin: 0px auto;
        }

        .container-messages {
            text-align: left;
            margin: 10px auto;
            width: 100%;
        }

            .container-messages > div {
                margin: 10px 0;
            }

        .container-captcha {
            text-align: center;
            margin-bottom: 10px;
        }

            .container-captcha > .g-recaptcha {
                display: inline-block;
                margin: 0 auto;
                width: 304px;
            }


        /* Temp application override */
        .info-header .fa {
            opacity: 1 !important;
            position: absolute !important;
            top: 50% !important;
            left: 0 !important;
            font-size: 88px !important;
            margin-left: -25px !important;
            margin-top: -45px !important;
        }

        .info-header.grey {
            border: 1px solid #e8e8e8;
            background-color: #f6f6f6;
        }

            .info-header.grey .fa {
                color: #efefef;
            }

        .info-header .info-header-msg {
            position: relative;
            margin-left: 50px;
        }

        .info-header span {
            opacity: 1;
        }

        a {
            color: #0070d1;
        }

        .search-btn, .clear-btn {
            padding-left: 15px;
            padding-right: 15px;
            min-width: unset !important;
        }

        .search-btn {
            color: #fff;
            background-color: #2779b0
        }

        .error {
            border: 1px solid #FF0101 !important;
        }

        .recaptcha-instr {
            margin: 0 auto;
            width: 304px;
            display: flex;
        }

            .recaptcha-instr > h5 {
                font-weight: 600;
            }
    </style>

    <script>

        $(document).ready(function () {
            $('.portal-footer-link').attr('aria-label', 'Back to main page')
            $('#btnSkipContent').attr('tabindex', '0')
            $('#btnHome').attr('tabindex', '0')
            $('#btnElections').attr('tabindex', '0')
        });

        var logOutModal;
        $(function () {
            $('.container-content').height(GetItemHeight($('.container-content').position().top - 30));
            logOutModal = confirmActionModal($('#logOutModal'));

            $('.data-header').each(function () {
                this.innerHTML = this.innerHTML.replace('*', '<b style="color: #c82613">*</b>');
            });

            $('.dropdown-submenu > a').on("click", function (e) {
                $(this).next('ul').toggle();
                e.stopPropagation();
                e.preventDefault();
            });
        });
        


        (function ($) {
            $.each(['show', 'hide'], function (i, ev) {
                var el = $.fn[ev];
                $.fn[ev] = function () {
                    this.trigger(ev);
                    return el.apply(this, arguments);
                };
            });
        })(jQuery);

        function confirmLogout(s, e) {
            logOutModal.setTitle("Are you sure you want to logout?");
            logOutModal.setLabel('');
            logOutModal.confirmFn = function () {
                btnConfirmLogout.DoClick();
            }
            logOutModal.show();
            e.processOnServer = false;
        }

        function ShowLoadingPanel() {
            ASPxCustomLoadingPanel.Show();
        }

        function HideLoadingPanel() {
            ASPxCustomLoadingPanel.Hide();
        }

        function cbLanguage_ValueChanged(s, e) {
            var url = window.location.href;
            if (url.indexOf("?") > 0) {
                url = url.substring(0, url.indexOf("?"));
            }
            url += "?Language=" + s.GetValue();
            window.location.replace(url);
        }

        function capitalizeDriversLicNo(s, e) {
            s.SetText(s.GetText().toUpperCase()); 
        }
    </script>

    

	<script src='../Common/scripts/ValidationScripts.js'></script>
	<script src='https://www.google.com/recaptcha/api.js?hl=en' async defer></script>
    <script type ="text/javascript">
        $(document).ready(function () {
            $('input[id*=deBirthYear]').attr('aria-required', 'true')
            $('input[id*=txtResHouseNo]').attr('aria-required', 'true')
            $('input[id*=txtVoterFirstName]').attr('aria-required', 'true');
            $('input[id*=txtVoterLastName]').attr('aria-required', 'true');
            $('input[id*=deDateOfBirth]').attr('aria-required', 'true');
            $("#skipToMainContent").focus(function () {
                $("#VoterRegPortalMaster_ASPxCBPanelMain_txtVoterFirstName_I").focus();
            });


            $('input[id*=txtVoterFirstName]').attr('aria-label', 'First Name')
            $('input[id*=txtVoterMiddleName]').attr('aria-label', 'Middle Name')
            $('input[id*=txtVoterLastName]').attr('aria-label', 'Last Name')
            $('input[id*=deDateOfBirth]').attr('aria-label', 'Date of Birth')
            $('input[id*=deBirthYear]').attr('aria-label', 'Birth Year')
            $('input[id*=txtResHouseNo]').attr('aria-label', 'House Number')      


            $('[id$=clearAndSearchbtnDiv]').hide();

            let enableCaptcha = hdnCaptchaEnable.Get("ElectionLinkEnableCaptcha");
            if (!enableCaptcha) {
                $(".recaptcha-instr").remove()
                $(".g-recaptcha").remove()
            }
        });
    </script>

	<script>
		function btnLookupVoter_Click(s, e) {
			e.processOnServer = false;
			if (verifyForm() == false) {
			} else {
				cASPxCBPanelMain.PerformCallback();
                grecaptcha.reset();
			}
		}

		function scrollFormTo(position) {
			$('.container-slider').animate({
				scrollTop: ($('.container-slider').scrollTop() + position - $('.portal-header').height() - 30)
			});
		}

		function reLoadasterisk() {
			$('.data-header').each(function () {
				this.innerHTML = this.innerHTML.replace('*', '<b style="color: #FF0101">*</b>');
			});
		}

        $(function () {
			/* Removes error popover when clicked */
			$('body').on('click touchstart', function (e) {
				$("div.popover").each(function () {
					let errPop = $(e.target).closest('.popover');
					errPop.prevAll('*:first').popover('hide');
				});
            });

			$('[id$=clearAndSearchbtnDiv]').hide();
			$('.dxeEditArea_Moderno').attr('aria-required', 'true');
            $('.dxeTextBox_Moderno').attr('role', 'presentation');
            $('.dxeRoot_Moderno').attr('role', 'presentation');
        });

		function initErrorPopover(sender, errorMsg) {
			var $ele = $(sender.GetMainElement());
			$ele.data('toggle', 'popover');
			$ele.data('trigger', 'manual');
			$ele.data('placement', 'bottom');
			$ele.data('html', true);

			let popoverContent = '<i class="fas fa-exclamation-circle" style="color: #ffa736;"></i> ' + errorMsg;

			$ele.data('content', popoverContent);
		}

		function clearInputError(s, e) {
			var $mainEle = $(s.GetMainElement());
			if (s.GetValue() != '' && s.GetValue() != null && $mainEle.hasClass('error')) {
				$mainEle.removeClass('error');
				$mainEle.popover('hide');
				$('.info-header.red.container').hide();
			}
		}

		function shouldVerifyControl(control, step) {
			if (typeof control !== 'undefined' && control.GetVisible()) {
				if (typeof step === 'undefined') {
					return true;
				} else {
					if (control.cp_StepName === step) {
						return true;
					}
				}
			}
			return false;
		}

		function verifyControl(control, doScroll) {
			var isGood = true;
			var errorMsg = '';
			if (typeof control !== 'undefined') {
				if (control.cp_Required) {
					if (control.GetValue() === null) {
						$(control.GetMainElement()).addClass('error');
						if (doScroll) {
							scrollFormTo($(control.GetMainElement()).offset().top);
						}
						isGood = false;
					} else {
						var requiredOption = control.cp_RequiredOption;
						if (typeof requiredOption !== 'undefined' && control.GetValue() !== requiredOption) {
							isGood = false;
							if (typeof control.cp_RequiredOptionError !== 'undefined') {
								errorMsg += control.cp_RequiredOptionError;
							}
						} else {
							$(control.GetMainElement()).removeClass('error');
						}
					}
				}
			}

			return {
				isGood: isGood,
				errorMsg: errorMsg
			}
		}

		function verifyForm() {
			var isGood = true;

            if (typeof cbResCounty !== 'undefined' && shouldVerifyControl(cbResCounty)) {
				result = verifyControl(cbResCounty, isGood);
				isGood = isGood && result.isGood;
			}

            if (typeof txtVoterFirstName !== 'undefined' && shouldVerifyControl(txtVoterFirstName)) {
				if (txtVoterFirstName.GetText() === '' || !ValidationManager.isNameValid(txtVoterFirstName.GetText())) {
					$(txtVoterFirstName.GetMainElement()).addClass('error');
					scrollFormTo($(txtVoterFirstName.GetMainElement()).offset().top);
					isGood = false;
				} else {
					$(txtVoterFirstName.GetMainElement()).removeClass('error');
				}
            }

            if (typeof txtVoterMiddleName !== 'undefined' && shouldVerifyControl(txtVoterMiddleName)) {
                result = verifyControl(txtVoterMiddleName, isGood);
                isGood = isGood && result.isGood;

                // Additional verification
                if (result.isGood) {
                    if (txtVoterMiddleName.cp_Required || txtVoterMiddleName.GetValue() !== null) {
                        if (!ValidationManager.isNameValid(txtVoterMiddleName.GetText())) {
                            $(txtVoterMiddleName.GetMainElement()).addClass('error');
                            if (isGood) {
                                scrollFormTo($(txtVoterMiddleName.GetMainElement()).offset().top);
                            }
                            isGood = false;
                        } else {
                            $(txtVoterMiddleName.GetMainElement()).removeClass('error');
                        }
                    }
                }
            }

            if (typeof txtVoterLastName !== 'undefined' && shouldVerifyControl(txtVoterLastName)) {
				if (txtVoterLastName.GetText() === '' || !ValidationManager.isNameValid(txtVoterLastName.GetText())) {
					$(txtVoterLastName.GetMainElement()).addClass('error');
					scrollFormTo($(txtVoterLastName.GetMainElement()).offset().top);
					isGood = false;
				} else {
					$(txtVoterLastName.GetMainElement()).removeClass('error');
				}
            }

            if (typeof txtResHouseNo !== 'undefined' && shouldVerifyControl(txtResHouseNo)) {
                result = verifyControl(txtResHouseNo, isGood);
                isGood = isGood && result.isGood;

                // Additional verification
                if (result.isGood) {
                    if (txtResHouseNo.cp_Required || txtResHouseNo.GetValue() !== null) {
                        if (!ValidationManager.isGeneralFieldValid(txtResHouseNo.GetText())) {
                            $(txtResHouseNo.GetMainElement()).addClass('error');
                            if (isGood) {
                                scrollFormTo($(txtResHouseNo.GetMainElement()).offset().top);
                            }
                            isGood = false;
                        } else {
                            $(txtResHouseNo.GetMainElement()).removeClass('error');
                        }
                    }
                }
            }

            if (typeof cbVoterSearchSuffix !== 'undefined' && shouldVerifyControl(cbVoterSearchSuffix)) {
                result = verifyControl(cbVoterSearchSuffix, isGood);
                isGood = isGood && result.isGood;
            }

            if (typeof deDateOfBirth !== 'undefined' && shouldVerifyControl(deDateOfBirth)) {
                if (deDateOfBirth.GetText() === '' || !ValidationManager.isDOBValid(deDateOfBirth.GetText()) || !ValidationManager.isDOBRangeValid(deDateOfBirth.GetText())) {
                    $(deDateOfBirth.GetMainElement()).addClass('error').popover('show');
                    scrollFormTo($(deDateOfBirth.GetMainElement()).offset().top);
					isGood = false;
				} else {
                    $(deDateOfBirth.GetMainElement()).removeClass('error');
				}
            }

            if (typeof deBirthYear !== 'undefined' && shouldVerifyControl(deBirthYear)) {
				if (deBirthYear.GetText() === '') {
					$(deBirthYear.GetMainElement()).addClass('error').popover('show');
					scrollFormTo($(deBirthYear.GetMainElement()).offset().top);
					isGood = false;
				} else {
					$(deBirthYear.GetMainElement()).removeClass('error');
				}
			}

			return isGood;

		}

		function cASPxCBPanelMain_BeginCallback(s, e) {
			ShowLoadingPanel();
		}

        function cASPxCBPanelMain_EndCallback(s, e) {
            reLoadasterisk();
            if (typeof cASPxCBPanelMain.cp_status !== 'undefiend') {
                if (cASPxCBPanelMain.cp_status == 'Success') {
                    $('#searchbtnDiv').hide();

                    if (typeof cASPxCBPanelMain.cp_voterSearchCount !== 'undefiend') {

                        if (cASPxCBPanelMain.cp_voterSearchCount > 1) {
                            $('[id$=clearAndSearchbtnDiv]').show();
                            $('[id$=divRecaptcha]').hide();
                        } else if (cASPxCBPanelMain.cp_voterSearchCount == 1 && typeof btnClearAndSearchAgain !== 'undefined') {
                            btnClearAndSearchAgain.DoClick();
                        } 
                    }
                } else {
                    if (typeof cASPxCBPanelMain.cp_voterSearchCount !== 'undefiend' && cASPxCBPanelMain.cp_voterSearchCount == 0) {
                        $('[id$=divRecaptcha]').hide();
                        $('[id$=clearAndSearchbtnDiv]').show();
                    }
                }
            }

            HideLoadingPanel();
            delete s.cp_status;
            delete s.cp_voterSearchCount;
        }

        function btnClearAndSearchAgain_Click(s, e) {
            e.processOnServer = false;
            if (typeof txtVoterFirstName !== 'undefined') {
                txtVoterFirstName.SetText('');
            }
            if (typeof txtVoterMiddleName !== 'undefined') {
                txtVoterMiddleName.SetText('');
            }
            if (typeof txtResHouseNo !== 'undefined') {
                txtResHouseNo.SetText('');
            }
            if (typeof cbVoterSearchSuffix !== 'undefined') {
                cbVoterSearchSuffix.SetSelectedIndex(-1); 
                cbVoterSearchSuffix.SetValue(null); 
            }
            if (typeof txtVoterLastName !== 'undefined') {
                txtVoterLastName.SetText('');
            }
            if (typeof deDateOfBirth !== 'undefined') {             
                deDateOfBirth.SetDate(null);
            }
            if (typeof deBirthYear !== 'undefined') {             
                deBirthYear.SetDate(null);
            }
           
            $('#searchbtnDiv').show();
            $('[id$=votersContainer]').hide();
            $('[id$=clearAndSearchbtnDiv]').hide();
            $('[id$=divRecaptcha]').show();
        }

        function ValidateDOB(s, e) {
            var showPopover = false;

            if (!$(s.GetMainElement()).is(":hidden") && e.value === null) {
                e.isValid = false;
            } else if (s.globalName === 'deDateOfBirth' && !ValidationManager.isDOBValid(s.GetText())) {
                showPopover = true;
                e.isValid = false;

                if (s.cp_ErrorPopoverMsg)
                    initErrorPopover(s, s.cp_ErrorPopoverMsg);
            } else if (s.globalName === 'deDateOfBirth' && !ValidationManager.isDOBRangeValid(s.GetText())) {
                showPopover = true;
                e.isValid = false;

                if (s.cp_DateRangeErrorMsg)
                    initErrorPopover(s, s.cp_DateRangeErrorMsg);
            }

            if (!e.isValid) {
                $(s.GetMainElement()).addClass('error');
            } else {
                clearInputError(s, e);
            }

            if (showPopover) {
                $(s.GetMainElement()).popover('show');
            }
        }


    </script>

    <style>
		.gvDetailClass {
			border-right: none;
			border-left: none;
		}

		div.g-recaptcha {
			margin: 0 auto;
			width: 304px;
		}

		.rowClass {
			border: none;
			border-bottom: none;
			border-top: none;
			border-collapse: collapse !important;
		}

		.dxgvTable_Moderno {
			border-collapse: collapse !important;
		}

		.smFont {
			font-size: 12px;
		}

		.rowClass.dxgv:nth-child(2n+1) {
			padding-bottom: 10px;
			padding-top: 10px;
			border-bottom: 1px solid rgba(0, 0, 0, 0.1) !important;
		}

		.dxgvDataRow_MetropolisBlue .rowClass:last-child td.dxgv {
			border-bottom: 0px solid #d1d1d1 !important;
		}


		.div.dxbButtonSys {
			vertical-align: top !important;
		}

		.dxgvTable_MetropolisBlue {
			border-collapse: collapse !important;
			border-top-width: 1px;
			border-bottom-width: 1px;
		}

		.dxgvTable_Moderno {
			border-collapse: collapse !important;
			margin-top: 5px;
		}


		.textBoxInput {
			transition: border-color ease-in-out .15s, box-shadow ease-in-out .15s;
