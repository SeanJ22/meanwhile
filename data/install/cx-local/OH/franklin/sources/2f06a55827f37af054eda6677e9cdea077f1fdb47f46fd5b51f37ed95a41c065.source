        <link rel="stylesheet" href='https://electionlink.franklincountyohio.gov/Portals/Common/Styles/fontawesome/all.min.css' />
        <link rel="stylesheet" href='https://electionlink.franklincountyohio.gov/Portals/Common/styles/bootstrap.min.css' />
        <link rel="stylesheet" href='https://electionlink.franklincountyohio.gov/Portals/Common/styles/confirm-popup.css' />
        <link rel="stylesheet" href='https://electionlink.franklincountyohio.gov/Portals/Common/styles/ApplicationStyles.min.css' />
        <link rel="stylesheet" href='https://electionlink.franklincountyohio.gov/Portals/Common/styles/confirm-action-modal.min.css' />
        <link rel="stylesheet" href="//fonts.googleapis.com/css?family=Open+Sans:400,600,700" />

        <script type="text/javascript" src='../Common/scripts/moment-2.30.1.min.js'></script>
        <script type="text/javascript" src='../Common/scripts/jquery-3.6.0.min.js'></script>
