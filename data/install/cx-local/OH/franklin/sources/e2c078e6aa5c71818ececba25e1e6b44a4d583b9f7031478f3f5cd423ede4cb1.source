    <style>
        html {
            /* Smoother scrolling for iOS phones */
            -webkit-overflow-scrolling: touch;
        }

        .wrapper {
            min-height: 100%;
            margin: 0 auto -30px;
        }

        .portal-header-content {
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
          align-items: center;
          height: 100%;
          margin: auto;
        }

        .portal-header-sub {
            color: #FFFFFF;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #102842; /* Old browsers */
        }

        .portal-tagline {
            color: #FFFFFF;
            text-transform: uppercase;
            margin: 0;
            padding: 10px;
            font-size: 18px;
        }


        .portal-footer-tagline {
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
            color: #FFFFFF;
            text-align: center;
            font-size: 12px;
        }

        @media screen and (max-width: 600px) {
          .portal-footer-tagline {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
            display: inline-block;
          }
        }

        .portal-logo {
            width: 220px; 
            min-width: 150px; 
            height: auto;
        }
        @media only screen and (max-width: 768px) {


            .portal-header-buttons {
                display: none !important;
            }

            .portal-header-buttons-mobile {
                display: inline-block !important;
            }
        }

        .portal-header-buttons, #btnSkipContent {
            margin-right: 5px;
            margin-bottom: 2px;
            text-transform: uppercase;
            text-align: right;
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
        }

        #btnSkipContent, #btnSkipContent ~ span {
                opacity: 0;
        }

        #btnSkipContent:focus, #btnSkipContent:focus ~ span {
                opacity: 1;
        }

        #skipToMainContent{
            cursor:default;
        }

        .portal-header-buttons-mobile {
            display: none;
            margin-right: 10px;
        }

        /* Bootstrap dropdown styling */
        a.dropdown-toggle:focus, a.dropdown-toggle:hover {
            color: #23527c;
            outline: 5px auto !important;
            text-decoration: none !important;
        }

        .dropdown-item {
            display: block;
            width: 100%;
            padding: .25rem 1.5rem;
            clear: both;
            font-weight: 400;
            color: #212529;
            text-align: inherit;
            white-space: nowrap;
            background-color: transparent;
            border: 0;
        }


        .container-sidebar {
            display: inline-block;
            border-right: 1px solid #DDD;
        }

        .container-content {
            display: inline-block;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

            .container-content > .container-body {
                height: calc(100% - 30px);
                overflow-y: auto;
            }

        .textBoxInput {
            border-radius: 5px;
            background-color: white;
        }

        input[type="text"]:disabled {
            cursor: not-allowed;
        }

        .portal-footer {
          height: 30px;
        }

        @media (max-width: 767px) {
          .portal-footer {
            height: 35px;
          }
        }

        @media (max-width: 575px) {
          .portal-footer {
            height: 40px;
          }
        }

        .data {
            font-size: 18px;
        }

        .data-header {
            font-size: 14px;
            margin-bottom: 0px;
            color: #757575;
        }


        .details-cell {
            width: 100%;
            margin: 0px auto;
            margin-top: 10px;
            padding: 0 20px 10px 20px;
            background-color: white;
            border: 1px solid #e6e6e6;
            border-left-width: 5px;
            border-left-style: solid;
            border-radius: 5px;
            color: #2779B0;
        }

            .details-cell h4 {
                margin-bottom: 10px;
                margin-top: 10px;
                margin-left: 0px;
                color: #2779B0;
                font-size: 19px;
                font-family: "Open Sans", 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .details-cell h3 {
                margin-bottom: 10px;
                margin-top: 10px;
                margin-left: 0px;
                color: #2779B0;
                font-size: 16px;
                font-family: "Open Sans", 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

        .vertical-space-out {
            margin: 10px 0;
        }

        .expand-cell:hover {
            cursor: pointer;
        }

        .content-details-cell {
            margin-top: 10px;
        }
                
        hr.style-six {
            width: 100%;
            border: 0;
            height: 0;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            margin-top: 2px;
            margin-bottom: 4px;
        }

        /* Bootstrap overrides */
        .tooltip {
            font-family: inherit;
        }

            .tooltip .tooltip-inner {
                padding: 10px;
                font-size: 14px;
            }

        /* DevExpress overrides */
        .dxeTextBox_Moderno .dxeEditArea_Moderno,
        .dxeEditArea_Moderno.dxeEditAreaSys,
        .dxeButtonEdit_Moderno {
            background-color: white;
        }

        /* Child page styling */
        .container-page-body {
            width: 90%;
            max-width: 800px;
            margin: 0px auto;
        }

        .container-messages {
            text-align: left;
            margin: 10px auto;
            width: 100%;
        }

            .container-messages > div {
                margin: 10px 0;
            }

        .container-captcha {
            text-align: center;
            margin-bottom: 10px;
        }

            .container-captcha > .g-recaptcha {
                display: inline-block;
                margin: 0 auto;
                width: 304px;
            }


        /* Temp application override */
        .info-header .fa {
            opacity: 1 !important;
            position: absolute !important;
            top: 50% !important;
            left: 0 !important;
            font-size: 88px !important;
            margin-left: -25px !important;
            margin-top: -45px !important;
        }

        .info-header.grey {
            border: 1px solid #e8e8e8;
            background-color: #f6f6f6;
        }

            .info-header.grey .fa {
                color: #efefef;
            }

        .info-header .info-header-msg {
            position: relative;
            margin-left: 50px;
        }

        .info-header span {
            opacity: 1;
        }

        a {
            color: #0070d1;
        }

        .search-btn, .clear-btn {
            padding-left: 15px;
            padding-right: 15px;
            min-width: unset !important;
        }

        .search-btn {
            color: #fff;
            background-color: #2779b0
        }

        .error {
            border: 1px solid #FF0101 !important;
        }

        .recaptcha-instr {
            margin: 0 auto;
            width: 304px;
            display: flex;
        }

            .recaptcha-instr > h5 {
                font-weight: 600;
            }
    </style>

    <script>

        $(document).ready(function () {
            $('.portal-footer-link').attr('aria-label', 'Back to main page')
            $('#btnSkipContent').attr('tabindex', '0')
            $('#btnHome').attr('tabindex', '0')
            $('#btnElections').attr('tabindex', '0')
        });

        var logOutModal;
        $(function () {
            $('.container-content').height(GetItemHeight($('.container-content').position().top - 30));
            logOutModal = confirmActionModal($('#logOutModal'));

            $('.data-header').each(function () {
                this.innerHTML = this.innerHTML.replace('*', '<b style="color: #c82613">*</b>');
            });

            $('.dropdown-submenu > a').on("click", function (e) {
                $(this).next('ul').toggle();
                e.stopPropagation();
                e.preventDefault();
            });
        });
        


        (function ($) {
            $.each(['show', 'hide'], function (i, ev) {
                var el = $.fn[ev];
                $.fn[ev] = function () {
                    this.trigger(ev);
                    return el.apply(this, arguments);
                };
            });
        })(jQuery);

        function confirmLogout(s, e) {
            logOutModal.setTitle("Are you sure you want to logout?");
            logOutModal.setLabel('');
            logOutModal.confirmFn = function () {
                btnConfirmLogout.DoClick();
            }
            logOutModal.show();
            e.processOnServer = false;
        }

        function ShowLoadingPanel() {
            ASPxCustomLoadingPanel.Show();
        }

        function HideLoadingPanel() {
            ASPxCustomLoadingPanel.Hide();
        }

        function cbLanguage_ValueChanged(s, e) {
            var url = window.location.href;
            if (url.indexOf("?") > 0) {
                url = url.substring(0, url.indexOf("?"));
            }
            url += "?Language=" + s.GetValue();
            window.location.replace(url);
        }

        function capitalizeDriversLicNo(s, e) {
            s.SetText(s.GetText().toUpperCase()); 
        }
    </script>

    
    <script type="text/javascript" src='https://maps.googleapis.com/maps/api/js?v=3&key=AIzaSyATXv-ivGE3HXlJR8o55cCxawSAm-XYRbE'></script>
    <script type="text/javascript" src='../Common/scripts/google-map-marker-animation.js'></script>
    <script src='../Common/scripts/ValidationScripts.js?v=1'></script>
    <script src='https://www.google.com/recaptcha/api.js?hl=en' async defer></script>

    <script type ="text/javascript">
        $(document).ready(function () {
            $("#skipToMainContent").focus(function () {
                $("#VoterRegPortalMaster_ASPxCBPanelMain_infoHeaderText").focus();
            });

            let enableCaptcha = hdnCaptchaEnable.Get("ElectionLinkEnableCaptcha");
            if (!enableCaptcha) {
                $(".recaptcha-instr").remove()
                $(".g-recaptcha").remove()
            }

        });
    </script>


    <script>
        $(function () {
            $('.container-slider').height(GetItemHeight($('.container-slider').position().top) - 55);
            $('input[id*=txtResHouseNo]').attr('aria-required', 'true');
            $('input[id*=cbResStreetName]').attr('aria-required', 'true');
            $('input[id*=cbResCity]').attr('aria-required', 'true');
            $('input[id*=cbResState]').attr('aria-required', 'true');
            $('input[id*=txtResZip]').attr('aria-required', 'true');
            $('input[id*=cbResCounty]').attr('aria-required', 'true');
            $('input[id*=txtResHouseNo]').attr('aria-label', 'House Number');
            $('input[id*=cbResStreetName]').attr('aria-label', 'Street Name');
            $('input[id*=cbResUnitType]').attr('aria-label', 'Unit Type');
            $('input[id*=txtResUnitNo]').attr('aria-label', 'Unit Number');
            $('input[id*=cbResCity]').attr('aria-label', 'City');
            $('input[id*=cbResState]').attr('aria-label', 'State');
            $('input[id*=txtResZip]').attr('aria-label', 'Zip Code');
            $('input[id*=cbResCounty]').attr('aria-label', 'County');
            $('.dxeTextBox_Moderno').attr('role', 'presentation');
            $('.dxeButtonEdit_Moderno').attr('role', 'presentation');
            $('#VoterRegPortalMaster_ASPxCBPanelMain_infoHeaderText').attr("tabindex", "0")
            turnOffAutoComplete();
        });

        function clearInputError(s, e) {
            var $mainEle = $(s.GetMainElement());
            if (s.GetValue() != '' && s.GetValue() != null) {
                $mainEle.closest('.error').removeClass('error');
                $mainEle.popover('hide');
            }
        }

        function txtResHouseNo_ValueChanged(s, e) {
            getHouseNoFilterResults(s.GetText());
        }

        function getHouseNoFilterResults(houseNo) {
            pnlResStreetName.PerformCallback(houseNo);
        }

        function pnlResStreetName_EndCallback(s, e) {
            cbResStreetName.Focus();
        }

        function cbResStreetName_ValueChanged(s, e) {
            cbResStreetName.gridView.GetRowValues(cbResStreetName.gridView.focusedRowIndex, "CityDesc;ZipCode;CountyDesc", GetSelectedStreetFieldValuesCallback)
        }

        function GetSelectedStreetFieldValuesCallback(values) {
            var streetID = cbResStreetName.GetValue();
            var city = values[0];
            var zip = values[1];
            var county = values[2];
            if (streetID !== null && streetID !== '') {
                cbResCity.SetText(city);
                txtResZip.SetText(zip);
                cbResCounty.SetText(county);
            } else {
                cbResCity.SetText('');
                txtResZip.SetText('');
                cbResCounty.SetText('');
            }
        }

        // Combo box implementation
        //function cbResStreetName_ValueChanged(s, e) {
        //    var streetID = s.GetValue();
        //    if (streetID !== '') {
        //        var data = hdnStreetCityZip.Get(streetID).split('|');
        //        var city = data[0];
        //        var zip = data[1];
        //        var county = data[2];

        //        cbResCity.SetText(city);
        //        txtResZip.SetText(zip);
        //        cbResCounty.SetText(county);
        //    } else {
        //        cbResCity.SetText('');
        //        txtResZip.SetText('');
        //        cbResCounty.SetText('');
        //    }
        //}

        function initErrorPopover(sender, errorMsg) {
            var $ele = $(sender.GetMainElement());
            $ele.data('toggle', 'popover');
            $ele.data('trigger', 'manual')
            $ele.data('placement', 'bottom');
            $ele.data('html', true);

            let popoverContent = '<i class="fas fa-exclamation-circle" style="color: #ffa736;"></i> ' + errorMsg;

            $ele.data('content', popoverContent);
        }

        function btnSearch_Click(s, e) {
            e.processOnServer = false;
            if (verifyForm() == false) {
            } else {
                cASPxCBPanelMain.PerformCallback();
                grecaptcha.reset();
            }
        }

        function verifyForm() {
            var isGood = true;

            if (shouldVerifyControl(txtResHouseNo)) {
                result = verifyControl(txtResHouseNo, isGood);
                isGood = isGood && result.isGood;

                // Additional verification
                if (result.isGood) {
                    if (txtResHouseNo.cp_Required || txtResHouseNo.GetValue() !== null) {
                        if (!ValidationManager.isGeneralFieldValid(txtResHouseNo.GetText())) {
                            $(txtResHouseNo.GetMainElement()).addClass('error');
                            if (isGood) {
                                scrollFormTo($(txtResHouseNo.GetMainElement()).offset().top);
                            }
                            isGood = false;
                        } else {
                            $(txtResHouseNo.GetMainElement()).removeClass('error');
                        }
                    }
                }
            }

            if (shouldVerifyControl(cbResStreetName)) {
                result = verifyControl(cbResStreetName, isGood);
                isGood = isGood && result.isGood;
            }

            if (shouldVerifyControl(cbResUnitType)) {
                result = verifyControl(cbResUnitType, isGood);
                isGood = isGood && result.isGood;
            }

            if (shouldVerifyControl(txtResUnitNo)) {
                result = verifyControl(txtResUnitNo, isGood);
                isGood = isGood && result.isGood;

                // Additional verification
                if (result.isGood) {
                    if (txtResUnitNo.cp_Required || txtResUnitNo.GetValue() !== null) {
                        if (!ValidationManager.isGeneralFieldValid(txtResUnitNo.GetText())) {
                            $(txtResUnitNo.GetMainElement()).addClass('error');
                            if (isGood) {
                                scrollFormTo($(txtResUnitNo.GetMainElement()).offset().top);
                            }
                            isGood = false;
                        } else {
                            $(txtResUnitNo.GetMainElement()).removeClass('error');
                        }
                    }
                }
            }

            if (shouldVerifyControl(cbResCity)) {
                result = verifyControl(cbResCity, isGood);
                isGood = isGood && result.isGood;

                // Additional verification
                if (result.isGood) {
                    if (cbResCity.cp_Required || cbResCity.GetValue() !== null) {
                        if (!ValidationManager.isGeneralFieldValid(cbResCity.GetText())) {
                            $(cbResCity.GetMainElement()).addClass('error');
                            if (isGood) {
                                scrollFormTo($(cbResCity.GetMainElement()).offset().top);
                            }
                            isGood = false;
                        } else {
                            $(cbResCity.GetMainElement()).removeClass('error');
                        }
                    }
                }
            }

            if (shouldVerifyControl(cbResState)) {
                result = verifyControl(cbResState, isGood);
                isGood = isGood && result.isGood;
            }

            if (shouldVerifyControl(txtResZip)) {
                result = verifyControl(txtResZip, isGood);
                isGood = isGood && result.isGood;

                // Additional verification
                if (result.isGood) {
                    if (txtResZip.cp_Required || txtResZip.GetValue() !== null) {
                        if (!ValidationManager.isZipCodeValid(txtResZip.GetText())) {
                            $(txtResZip.GetMainElement()).addClass('error');
                            if (isGood) {
                                scrollFormTo($(txtResZip.GetMainElement()).offset().top);
                            }
                            isGood = false;
                        } else {
                            $(txtResZip.GetMainElement()).removeClass('error');
                        }
                    }
                }
            }

            if (shouldVerifyControl(cbResCounty)) {
                result = verifyControl(cbResCounty, isGood);
                isGood = isGood && result.isGood;

                if (result.isGood) {
                    if (cbResCounty.cp_Required || cbResCounty.GetValue() !== null) {
                        if (!ValidationManager.isGeneralFieldValid(cbResCounty.GetText())) {
                            $(cbResCounty.GetMainElement()).addClass('error');
                            if (isGood) {
                                scrollFormTo($(cbResCounty.GetMainElement()).offset().top);
                            }
                            isGood = false;
                        } else {
                            $(cbResCounty.GetMainElement()).removeClass('error');
                        }
                    }
                }
            }

            return isGood;

        }

        function shouldVerifyControl(control, step) {
            if (!control.clientVisible) {
                return false;
            }

            if (typeof control !== 'undefined' && control.GetVisible()) {
                if (typeof step === 'undefined') {
                    return true;
                } else {
                    if (control.cp_StepName === step) {
                        return true;
                    }
                }
            }

            return false;
        }

        function verifyControl(control, doScroll) {
            var isGood = true;
            var errorMsg = '';
            if (typeof control !== 'undefined') {
                if (control.cp_Required) {
                    if (control.GetValue() === null) {
                        $(control.GetMainElement()).addClass('error');
                        if (doScroll) {
                            scrollFormTo($(control.GetMainElement()).offset().top);
                        }
                        isGood = false;
                    } else {
                        var requiredOption = control.cp_RequiredOption;
                        if (typeof requiredOption !== 'undefined' && control.GetValue() !== requiredOption) {
                            isGood = false;
                            if (typeof control.cp_RequiredOptionError !== 'undefined') {
                                errorMsg += control.cp_RequiredOptionError;
                            }
                        } else {
                            $(control.GetMainElement()).removeClass('error');
                        }
                    }
                }
            }

            return {
                isGood: isGood,
                errorMsg: errorMsg
            }
        }

        function scrollFormTo(position) {
            $('.container-slider').animate({
                scrollTop: ($('.container-slider').scrollTop() + position - $('.portal-header').height() - 30)
            });
        }

        function ASPxCBPanelMain_EndCallback() {
            // since the captcha has to be outside the callback panel
            // hide after callback finishes
            if ($('[id$="pollingLocationsContainer"]').css('display') != undefined) {
                $('.g-recaptcha').hide();
                btnSearch.SetClientVisible(false);
            }

            HideLoadingPanel();
        }

        function turnOffAutoComplete() {
            
            $('.autocomplete-off input[type="text"]').attr('autocomplete', 'off');
            $('.autocomplete-off input[type="text"]').focus(function () {
                $(this).attr('autocomplete', 'nope');
            });
        }

    </script>

    <style>
        .container-slider {
            max-width: 780px;
            margin: 0px auto;
            padding: 0 15px;
        }

        div.g-recaptcha {
            margin: 0 auto;
            width: 304px;
        }

        hr {
            margin: 5px 0px;
        }

        p.data {
            margin: 0px;
        }

        .rowClass.dxgv {
            padding: 0px !important;
        }

        .details-cell h4 {
            font-family: "Open Sans", 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .item-headers {
            display: flex;
            align-items: center;
            flex-wrap: wrap
        }

        .street-data-row {
            padding: 5px;
        }

    </style>
<style id="portalTheme" type="text/css">.portal-header { position: relative; background-color: #e8e6e6; border-bottom: 0px solid #666666; color: #a00 !important } .portal-sidebar { background-color: #333333; color: #FFFFFF !important; border-right: 1px solid #535353 } .portal-sidebar ul li { border-bottom: 1px solid #535353 } .portal-sidebar > .css-menu > ul > li.has-sub > ul > li:not(:last-child) { border: 1px solid #535353 } .portal-sidebar > .css-menu > ul > li.has-sub.open > a { border: 1px solid #535353 } .portal-sidebar a { background-color: #333333; color: #FFFFFF !important; } .portal-sidebar > .css-menu ul > li.has-sub > a:before, .portal-sidebar > .css-menu ul > li.has-sub > a:after { background-color: #FFFFFF !important; } .portal-sidebar a:hover { background-color: #333333; color: #2980b9 !important; } .portal-sidebar .fa { color: #2980b9 }.portal-sidebar ul.submenu { background-color: #545454 !important } .portal-sidebar ul.submenu a { background-color: #545454 !important } .portal-footer { background-color: #00253f; border-top: 6px solid #00253f } .portal-body { background-color: #FFFFFF; color: #333333 } .fabButton { background-color: #FFFFFF; color: #333333 } .details-cell { border-left-color: #a00; } .portal-header-content {
	background-image: url(https://electionlink.franklincountyohio.gov/Portals/ElectionLink/images/header-background.jpg);
	background-repeat: no-repeat;
	background-size: cover;
	background-color: #e6e6e6;
    min-height: 180px;
    padding-top: 50px;
 
    background-position: 0% 35%;
}

#linkLogo {
    padding-left:88px;
}
.portal-header-sub {
background: rgb(170,0,0);
background: -moz-linear-gradient(top, rgba(170,0,0,1) 0%, rgba(170,19,19,1) 25%, rgba(170,19,19,1) 75%, rgba(156,7,7,1) 100% ); /* FF3.6-15 */
