<script type="text/javascript">
      jQuery(document).ready(function() {
		if($("#accordion7687 .accordion_group a.active").data("filter")){
			$("#accordion7687 .accordion >"+ $("#accordion7687 .accordion_group a.active").data("filter")).show();
		}else{
			$("#accordion7687 .accordion_group a").eq(0).addClass("active");
			$("#accordion7687 .accordion > .accordion-item").show();
		}
		$("#accordion7687 .accordion_group a").on("click",function(){
			$(this).addClass("active").siblings().removeClass("active");
			$("#accordion7687 .accordion >"+ $(this).data("filter")).slideDown();
			$("#accordion7687 .accordion > .accordion-item").not($(this).data("filter")).slideUp();
		})
		$("#accordion7687 .accordion").each(function () {
			var e=$(this);	  
				e.jqueryAccordion({
					  interval: 200,
					  fadeContent: true,
					  open: false,
					  defaultOpenIndex:1
				});
			e.OpenAccordion();
		});
		
		
		
      });
</script> 

 
