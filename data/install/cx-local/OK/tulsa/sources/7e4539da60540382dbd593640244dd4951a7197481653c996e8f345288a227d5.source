         navPages.push({groupNumber, currentGroup});
        }
     
        for(var i = 1; i < NewsPostList.length; i++) // i starts at 1 since the first NewsPost is already added
        {
            if(i % 25 != 0)
            {
                currentGroup.push(NewsPostList[i]);
                continue;
            }
            navPages.push({groupNumber, currentGroup});
            
            // increment group and clear list
            groupNumber++;
            currentGroup = [];
        }
        pages = navPages;
    }
    
    // pagination controls
    
    function renderPagination() {
        var paginationControls = document.getElementById("paginationControls");
        var prevControls =
            '<li class="page-item disabled"><a class="page-link" onclick="prevPage()" href="#" id="btnPrev">Previous</a></li>';
        var nextControls = 
            '<li class="page-item"><a class="page-link" onclick="nextPage()" href="#" id="btnNext">Next</a></li>';
        
        var pageControls = "";
        for(var i = 1; i <= pages.length; i++)
        {
            pageControls += 
                '<li id="pageControl' + i + '" class="page-item"><a class="page-link" href="#" onclick="changePage(' + i + ')">' + i + '</a></li>';
        }
        
        paginationControls.innerHTML = prevControls + pageControls + nextControls;
    }

    function renderContent(pageNum) {
        var contentBody = document.getElementById("contentBody");
        var page = pages[pageNum - 1];

        contentBody.innerHTML = '';

        if (page && page.currentGroup && page.currentGroup[0]) {
            for(var i = 0; i < page.currentGroup.length; i++) {
                var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
                var d = new Date(page.currentGroup[i].date);
                var date = months[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear();
                  contentBody.innerHTML +=
                    '<tr class="d-flex"><td class="col-8">' + '<a href="' + page.currentGroup[i].url + '"target="_blank">' + page.currentGroup[i].name + '</a>' + '</td><td class="col-2">' + page.currentGroup[i].folderName  + '</td>' + '<td class="col-2">' + date  + '</td></tr>';
            }
        }
        
    }
    
    // pagination events
    
    var currentPage = 1;
    
    function prevPage() {
        if (currentPage > 1)
            changePage(currentPage - 1);
    }
    
    function nextPage() {
        if (currentPage < pages.length)
            changePage(currentPage + 1);
    }
    
    var btnNext = document.getElementById("btnNext");
    var btnPrev = document.getElementById("btnPrev");
    
    function changePage(num) {

        var prevPageControl = document.getElementById("pageControl" + currentPage);
        if (prevPageControl) {
            prevPageControl.classList.remove("active");            
        }
        
        var currentPageControl = document.getElementById("pageControl" + num);
        if (prevPageControl) {
            currentPageControl.classList.add("active");
        }
        
        currentPage = num;
        btnNext = document.getElementById("btnNext");
        btnPrev = document.getElementById("btnPrev");
        
        if (currentPage === 1)
            btnPrev.parentElement.classList.add("disabled");
        if (currentPage > 1)
            btnPrev.parentElement.classList.remove("disabled");
        if (currentPage < pages.length)
            btnNext.parentElement.classList.remove("disabled");
        if (currentPage >= pages.length) 
            btnNext.parentElement.classList.add("disabled");

        renderContent(currentPage);

    }
    
    function filterResults(str) {
        
        
        NewsPostList.filter(function(search) {
            return search === str;
        })

        renderPaginationControls();
    }
    
