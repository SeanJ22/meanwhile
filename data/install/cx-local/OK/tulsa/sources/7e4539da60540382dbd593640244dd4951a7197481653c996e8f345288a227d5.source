<style>
    #selectNewsPostCategory {
        width: 100%;
        padding: .375rem .75rem;
        font-size: 1rem;
        line-height: 1.5;
        color: #495057;
        background-color: #fff;
        background-clip: padding-box;
        border: 1px solid #ced4da;
    }
    
    #selectNewsPostCategory:focus {
         border-color: #80bdff;
         outline: 0;
         box-shadow: 0 0 0 0.2rem rgb(0 123 255 / 25%);
    }
    
    .btn.btn-theme {
        color: #fff;
        background-color: #007b85;
        border-color: #00676f;
    }
    
    .btn.btn-theme:hover {
        color: #fff;
        background-color: #00656d;
        border-color: #005d65;
    }
    
    .btn.btn-theme-alt {
        color: #00656d;
        background-color: #ececec;
        border-color: #00676f;
    }
    
    .btn.btn-theme-alt:hover {
        color: #fff;
        background-color: #ababab;
        border-color: #696969;
    }
    
    .page-item.active .page-link {
        z-index: 3;
        color: #fff;
        background-color: #007b85;
        border-color: #00676f;
    }
    
    .page-link, .page-link:hover {
        color: #007b85;
    }
</style>

<div class="container">
    <div class="card mt-1 mb-4" style="border: 1px solid rgba(0,0,0,.125)">
        <div class="card-header">Election Board News Posts</div>
        <div class="card-body">
            <label class="text-muted">Filters</label>
            <form>
                <div class="form-group">
                   <select name="selectCategory" form="carform2" id="selectNewsPostCategory"  onchange="applyFilters()">
                        <option selected="selected" value="">All News Posts</option>
                    </select>
                </div>

                <div class="form-row mb-4">
    
            </form>
            
            <table class="table table-striped table-bordered">
                <thead>
                <tr class="d-flex">
                    <th class="col-8" scope="col">News Post</th>
                    <th class="col-2" scope="col">Year</th>
                    <th class="col-2" scope="col">Date</th>
                </tr>
                </thead>
                <tbody id="contentBody">
                </tbody>
            </table>


            <nav aria-label="NewsPost Pagination">
                <ul class="pagination" id="paginationControls"></ul>
            </nav>

        </div>
    </div>
</div>

<script>
    /**
     * filtering controls
     */
    var folderList = ["2020","2021","2022","2023","2024","2025","2026"];

    // NewsPosts select
    function createNewsPostCategorySelect() {
        var NewsPostSelect = document.getElementById('selectNewsPostCategory');
        // NewsPostSelect.innerHTML = '<option selected>All News Posts</option>'
        for(var i = 0; i < folderList.length; i++) {
            var folder = folderList[i];
            NewsPostSelect.innerHTML += '<option value="' + folder + '">' + folder + '</option';
        }
         
    }
    
