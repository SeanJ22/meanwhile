B Landscape","format":"pdf","layoutOptions":{"titleText":"ArcGIS Web Map","legend":false,"scalebarUnit":"Miles","legendLayers":[],"customTextElements":[],"elementOverrides":{"North Arrow":{"name":"North Arrow","type":"CIMMarkerNorthArrow","visible":true}}},"layoutTemplate":"Tabloid ANSI B Landscape","mapFrameSize":[16,7.76],"mapFrameUnit":"INCH","hasAuthorText":true,"hasCopyrightText":true,"hasLegend":true,"hasTitleText":true,"customTextElementEnableList":[],"enableNorthArrow":true,"enableLegend":true,"enableAuthor":true,"enableCopyright":true,"enableScalebarUnit":true},{"label":"Tabloid ANSI B Portrait","layout":"Tabloid ANSI B Portrait","format":"pdf","layoutOptions":{"titleText":"ArcGIS Web Map","legend":false,"scalebarUnit":"Miles","legendLayers":[],"customTextElements":[],"elementOverrides":{"North Arrow":{"name":"North Arrow","type":"CIMMarkerNorthArrow","visible":true}}},"layoutTemplate":"Tabloid ANSI B Portrait","mapFrameSize":[10,13.61],"mapFrameUnit":"INCH","hasAuthorText":true,"hasCopyrightText":false,"hasLegend":true,"hasTitleText":true,"customTextElementEnableList":[],"enableNorthArrow":true,"enableLegend":true,"enableAuthor":true,"enableCopyright":false,"enableScalebarUnit":true},{"label":"MAP_ONLY","layout":"MAP_ONLY","format":"pdf","layoutTemplate":"MAP_ONLY","enableScalebarUnit":true}],"supportCustomLayout":false,"supportReport":false,"supportCustomReport":false},"id":"widget_33","style":{"border":{"color":"var(--light-800)","type":"solid","width":"1px"}},"useMapWidgetIds":["widget_6"],"useUtilities":[{"utilityId":"utility_3"}]},"widget_55":{"uri":"widgets/common/navigator/","version":"1.18.0","label":"Views Navigation","config":{"data":{"type":"AUTO","section":"section_1","views":[]},"display":{"type":"nav","navStyle":"pills","standard":{"gap":"0px","scrollable":true,"showIcon":false,"showText":true,"iconPosition":"start","textAlign":"center"},"vertical":false,"advanced":false}},"id":"widget_55"},"widget_56":{"uri":"widgets/common/text/","version":"1.18.0","label":"English splash","config":{"text":"<p class=\"ql-indent-1\" style=\"text-align: left;\"><br></p><p style=\"text-align: center;\"><strong style=\"font-size: 27px; color: var(--dark);\">Multnomah County Voter Precincts Map</strong></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><strong style=\"font-size: 15px; font-family: &quot;Avenir Next&quot;; color: rgb(51, 51, 51);\">﻿Summary:</strong><strong style=\"font-size: 15px; font-family: &quot;Avenir Next&quot;;\"> </strong></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 15px;\">This map shows the voter precincts of Multnomah County, as well as jurisdictional boundaries that are </span></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 15px;\">relevant to county residents.</span></p><p style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><strong style=\"font-size: 15px;\">How to use: </strong></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 15px;\">To find your address, use the search bar by clicking the magnifying glass widget on the left side of the map. </span></p><p style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><img src=\"data:image/png;base64,\" alt=\"\"></p><p style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 15px;\">When you type your address, the map will zoom to your location. </span></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 15px;\">Click on the map next to the location of your residence in the same precinct split to view information on the various districts you live in.</span></p><p style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 11.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXeoqE64l0RTELHRmWbpqtRYT4f3vb0C1ADnP-SgoD-U0e0WZG-AxsIQu8n_r7U0edBhlVjXT6QdZFDkx84tLYgPWn0BDD8BiyZOGzCoKeXPU8vsqllZ-0OlnQ3EZqZM8dxwOPOf?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"314\" width=\"392\"></span></p><p style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 15px;\">To zoom in or out on the map, use your mouse to scroll or select the + and - buttons on the bottom right of</span></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 15px;\">the map. The home icon will reset the map to the original extent.</span></p><p style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><img src=\"data:image/png;base64,\" alt=\"\"></p><p style=\"text-align: left;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left;\"><span style=\"font-size: 15px;\">If you want to export a pdf version of this map, select the \"Print\" icon at the top right of the screen.</span></p><p class=\"ql-indent-1\" style=\"text-align: left; line-height: 1.38;\"><span style=\"font-size: 11.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXecwPrGIehKAGN51ZR255S7Cv4rlYnjV6g4yOGP9ukJpYJsCUojslFuyf12R3VbkdGLrsuLqv5e9dIIgocCdbDstaXOkizibzqyn91Nh9mX64CUbmQ__U87HVEPDDM0KYgwZUr4ig?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"66\" width=\"181\"></span></p><p style=\"text-align: left; line-height: 1.38;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left; line-height: 1.38;\"><span style=\"font-size: 11.5pt; font-family: &quot;Avenir Next&quot;; color: rgb(0, 0, 0); background-color: transparent;\">These instructions can also be found in the “Instructions” button at the top right of the screen.</span></p><p class=\"ql-indent-1\" style=\"text-align: left; line-height: 1.38;\"><span style=\"font-size: 11.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXfx2gbfs8RUhJsQapNh_p_uw50eGOzQEx86Sj3SoSGT-eA6d9wCiq50qcV_mpVjt3fbCPIOlk7Jblr6yuZfKgpvaxUpwhZnuuEGsFq3dYftCFXPZIH3ZITsq65ZFXNW44n0ADJHhg?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"65\" width=\"181\"></span></p><p style=\"text-align: left; line-height: 1.38;\"><br></p><p class=\"ql-indent-1\" style=\"text-align: left; line-height: 1.38;\"><span style=\"font-size: 11.5pt; font-family: &quot;Avenir Next&quot;; color: rgb(0, 0, 0); background-color: transparent;\">Information about the app and contact information can be found in the “Information” button at the top</span></p><p class=\"ql-indent-1\" style=\"text-align: left; line-height: 1.38;\"><span style=\"font-size: 11.5pt; font-family: &quot;Avenir Next&quot;; color: rgb(0, 0, 0); background-color: transparent;\">right of the screen.</span></p><p class=\"ql-indent-1\" style=\"text-align: left; line-height: 1.38;\"><span style=\"font-size: 11.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXd6ELeliN17tx3PVdL1GCMlcK0m6dIL4Dfq_P8iM--kI6DWtpasfGfbygJh55XH54xVTWFvyNLpf5aMGOTuCGFrHqSm0Y19CW4VBfpN8G-LAJXWCzkMgMOXxfWXtMoJr7JFJbzQ-A?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"65\" width=\"181\"></span></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><strong style=\"font-size: 11px;\">Access and Use Constraints:</strong><span style=\"font-size: 11px;\"> </span></p><p style=\"text-align: left;\"><span style=\"font-size: 11px; font-family: inherit;\">DISCLAIMER: This map is for reference use only. Data provided are derived from multiple sources with varying levels of responsibility for the accuracy or completeness of the data shown hereon.</span></p>","style":{"wrap":true}},"id":"widget_56","style":{"background":{"color":"var(--light-100)","fillType":"fill"}}},"widget_57":{"uri":"widgets/common/text/","version":"1.18.0","label":"Spanish splash text","config":{"text":"<p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5; text-align: center;\"><strong style=\"font-size: 24px; font-family: &quot;Avenir Next&quot;; color: rgb(0, 0, 0); background-color: transparent;\">Mapa de localidades electorales del condado de Multnomah</strong></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><strong style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Resumen:</strong></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Este mapa indica las localidades electorales en el condado de Multnomah, así como los límites de autoridad relevantes para residentes del condado.</span></p><p style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><strong style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Aprenda más del mapa:</strong></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Para encontrar su distrito electoral, utilice la barra de búsqueda haciendo clic en la lupa en la parte superior a</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">la izquierda del mapa.</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><img src=\"data:image/png;base64,\" alt=\"\"></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Al escribir su dirección, el mapa indicará su ubicación.</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Ahora haga clic en cualquier parte del mapa junto a su dirección para encontrar información para encontrar información de los diferentes distritos en los que vive.&nbsp;</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXeoqE64l0RTELHRmWbpqtRYT4f3vb0C1ADnP-SgoD-U0e0WZG-AxsIQu8n_r7U0edBhlVjXT6QdZFDkx84tLYgPWn0BDD8BiyZOGzCoKeXPU8vsqllZ-0OlnQ3EZqZM8dxwOPOf?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"314\" width=\"392\"></span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Para extender o reducir la vista del mapa, utilice el </span><em style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">mouse</em><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\"> de su computadora o puede utilizar los signos + y - en la parte inferior derecha. Si hace clic en el botón de la ‘casita’, regresará al inicio y el mapa a su tamaño original.</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><img src=\"data:image/png;base64,\" alt=\"\"></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Si desea imprimir el mapa en versión PDF, seleccione el botón de la impresora en la parte superior derecha</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">de su pantalla.</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXecwPrGIehKAGN51ZR255S7Cv4rlYnjV6g4yOGP9ukJpYJsCUojslFuyf12R3VbkdGLrsuLqv5e9dIIgocCdbDstaXOkizibzqyn91Nh9mX64CUbmQ__U87HVEPDDM0KYgwZUr4ig?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"66\" width=\"181\"></span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Estas instrucciones también se encuentran en el botón de las tres líneas horizontales en la parte superior derecha, junto al botón de la impresora.</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"font-size: 11.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXfx2gbfs8RUhJsQapNh_p_uw50eGOzQEx86Sj3SoSGT-eA6d9wCiq50qcV_mpVjt3fbCPIOlk7Jblr6yuZfKgpvaxUpwhZnuuEGsFq3dYftCFXPZIH3ZITsq65ZFXNW44n0ADJHhg?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"65\" width=\"181\"></span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><br></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Puede encontrar información sobre la aplicación y los datos de contacto en el botón con la letra ‘i’ en</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">la esquina superior derecha.</span></p><p class=\"ql-indent-1\" style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">﻿</span><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXd6ELeliN17tx3PVdL1GCMlcK0m6dIL4Dfq_P8iM--kI6DWtpasfGfbygJh55XH54xVTWFvyNLpf5aMGOTuCGFrHqSm0Y19CW4VBfpN8G-LAJXWCzkMgMOXxfWXtMoJr7JFJbzQ-A?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"65\" width=\"181\"></span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 12pt;\">﻿</span></p><p style=\"line-height: 1.5;\"><strong style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 11px;\">Restricciones de uso y acceso:</strong></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 11px;\">Advertencia: Este mapa es sólo para fines de referencia. Los datos proporcionados provienen de diversas fuentes, con distintos niveles de responsabilidad en cuanto a la exactitud o integridad de los datos que se muestran aquí.</span></p>","style":{"wrap":true}},"id":"widget_57","style":{"background":{"color":"var(--light-100)","fillType":"fill"}}},"widget_59":{"uri":"widgets/common/image/","version":"1.18.0","label":"Multnomah County logo","config":{"functionConfig":{"altText":"Multnomah County logo","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_53/1744915223919.png","originalUrl":"${appResourceUrl}/images/widget_53/1744915223919.png","fileName":"1744915223919.png","originalName":"Logo_No_Text.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1744915223919","isUseCompress":false,"originalWidth":1250,"originalHeight":900},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null,"altTextExpression":null},"styleConfig":{}},"id":"widget_59"},"widget_68":{"uri":"widgets/layout/fixed/","version":"1.18.0","icon":{"svg":"${appResourceUrl}/images/icon_picker_in_setting/1745945869913.png","properties":{"filename":"1745945869913.png","originalName":"text-bullet-list-icon-2048x1472-dnnm1d4q.png","path":"${appResourceUrl}/images/icon_picker_in_setting/1745945869913.png","isUploaded":true,"inlineSvg":false}},"label":"Instructions","config":null,"id":"widget_68","layouts":{"DEFAULT":{"LARGE":"layout_44"}}},"widget_69":{"uri":"widgets/common/navigator/","version":"1.18.0","label":"Language switcher","config":{"data":{"type":"AUTO","section":"section_4","views":[]},"display":{"type":"nav","navStyle":"pills","standard":{"gap":"0px","scrollable":true,"showIcon":false,"showText":true,"iconPosition":"start","textAlign":"center"},"vertical":false,"advanced":false}},"id":"widget_69"},"widget_70":{"uri":"widgets/common/text/","version":"1.18.0","label":"English Instructions","config":{"text":"<p style=\"text-align: left;\"><strong style=\"color: var(--dark); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">﻿Summary: </strong></p><p style=\"text-align: left;\"><span style=\"font-size: 15px;\">This map shows the voter precincts of Multnomah County, as well as jurisdictional boundaries that are relevant to county residents.</span></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><strong style=\"font-size: 15px;\">How to use: </strong></p><p style=\"text-align: left;\"><span style=\"font-size: 15px;\">To find your address, use the search bar by clicking the magnifying glass widget on the left side of the map. </span></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><img src=\"data:image/png;base64,\" alt=\"\"></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><span style=\"font-size: 15px;\">When you type your address, the map will zoom to your location. </span></p><p style=\"text-align: left;\"><span style=\"font-size: 15px;\">Click on the map next to the location of your residence in the same precinct split to view information on the various districts you live in.</span></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXeoqE64l0RTELHRmWbpqtRYT4f3vb0C1ADnP-SgoD-U0e0WZG-AxsIQu8n_r7U0edBhlVjXT6QdZFDkx84tLYgPWn0BDD8BiyZOGzCoKeXPU8vsqllZ-0OlnQ3EZqZM8dxwOPOf?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"314\" width=\"332\" style=\"width: 96.99%;\"></span></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><span style=\"font-size: 15px;\">To zoom in or out on the map, use your mouse to scroll or select the + and - buttons on the bottom right of the map. The home icon will reset the map to the original extent.</span></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><img src=\"data:image/png;base64,\" alt=\"\"></p><p style=\"text-align: left;\"><br></p><p style=\"text-align: left;\"><span style=\"font-size: 15px;\">If you want to export a pdf version of this map, select the \"Print\" icon at the top right of the screen.</span></p><p style=\"line-height: 1.38; text-align: left;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXecwPrGIehKAGN51ZR255S7Cv4rlYnjV6g4yOGP9ukJpYJsCUojslFuyf12R3VbkdGLrsuLqv5e9dIIgocCdbDstaXOkizibzqyn91Nh9mX64CUbmQ__U87HVEPDDM0KYgwZUr4ig?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"66\" width=\"181\"></span></p><p style=\"line-height: 1.38; text-align: left;\"><br></p><p style=\"line-height: 1.38; text-align: left;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 11.5pt;\">These instructions can also be found in the “Instructions” button at the top right of the screen.</span></p><p style=\"line-height: 1.38; text-align: left;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXfx2gbfs8RUhJsQapNh_p_uw50eGOzQEx86Sj3SoSGT-eA6d9wCiq50qcV_mpVjt3fbCPIOlk7Jblr6yuZfKgpvaxUpwhZnuuEGsFq3dYftCFXPZIH3ZITsq65ZFXNW44n0ADJHhg?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"65\" width=\"181\"></span></p><p style=\"line-height: 1.38; text-align: left;\"><br></p><p style=\"line-height: 1.38; text-align: left;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 11.5pt;\">Information about the app and contact information can be found in the “Information” button at the top right of the screen.</span></p><p style=\"line-height: 1.38; text-align: left;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXd6ELeliN17tx3PVdL1GCMlcK0m6dIL4Dfq_P8iM--kI6DWtpasfGfbygJh55XH54xVTWFvyNLpf5aMGOTuCGFrHqSm0Y19CW4VBfpN8G-LAJXWCzkMgMOXxfWXtMoJr7JFJbzQ-A?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"65\" width=\"181\"></span></p><p style=\"text-align: left;\"><br></p>","style":{"wrap":true}},"id":"widget_70"},"widget_71":{"uri":"widgets/common/text/","version":"1.18.0","label":"Spanish instructions","config":{"text":"<p style=\"line-height: 1.5;\"><strong style=\"background-color: transparent; color: var(--dark); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Resumen</strong><strong style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">:</strong></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: var(--dark); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Este mapa indica las localidades electorales en el condado de Multnomah, así como los límites de autoridad relevantes para residentes del condado.</span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><strong style=\"background-color: transparent; color: var(--dark); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Aprenda más del mapa:</strong></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: var(--dark); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Para encontrar su distrito electoral, utilice la barra de búsqueda haciendo clic en la lupa en la parte superior a la izquierda del mapa.</span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><img src=\"data:image/png;base64,\" alt=\"\"></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Al escribir su dirección, el mapa indicará su ubicación.</span></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Ahora haga clic en cualquier parte del mapa junto a su dirección para encontrar información para encontrar información de los diferentes distritos en los que vive.&nbsp;</span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXeoqE64l0RTELHRmWbpqtRYT4f3vb0C1ADnP-SgoD-U0e0WZG-AxsIQu8n_r7U0edBhlVjXT6QdZFDkx84tLYgPWn0BDD8BiyZOGzCoKeXPU8vsqllZ-0OlnQ3EZqZM8dxwOPOf?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"314\" width=\"392\"></span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Para extender o reducir la vista del mapa, utilice el </span><em style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">mouse</em><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\"> de su computadora o puede utilizar los signos + y - en la parte inferior derecha. Si hace clic en el botón de la ‘casita’, regresará al inicio y el mapa a su tamaño original.</span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><img src=\"data:image/png;base64,\" alt=\"\"></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Si desea imprimir el mapa en versión PDF, seleccione el botón de la impresora en la parte superior derecha</span></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">de su pantalla.</span></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXecwPrGIehKAGN51ZR255S7Cv4rlYnjV6g4yOGP9ukJpYJsCUojslFuyf12R3VbkdGLrsuLqv5e9dIIgocCdbDstaXOkizibzqyn91Nh9mX64CUbmQ__U87HVEPDDM0KYgwZUr4ig?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"66\" width=\"181\"></span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Estas instrucciones también se encuentran en el botón de las tres líneas horizontales en la parte superior derecha, junto al botón de la impresora.</span></p><p style=\"line-height: 1.5;\"><span style=\"font-size: 11.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); background-color: transparent;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXfx2gbfs8RUhJsQapNh_p_uw50eGOzQEx86Sj3SoSGT-eA6d9wCiq50qcV_mpVjt3fbCPIOlk7Jblr6yuZfKgpvaxUpwhZnuuEGsFq3dYftCFXPZIH3ZITsq65ZFXNW44n0ADJHhg?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"65\" width=\"181\"></span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">Puede encontrar información sobre la aplicación y los datos de contacto en el botón con la letra ‘i’ en la esquina superior derecha.</span></p><p style=\"line-height: 1.5;\"><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: &quot;Avenir Next&quot;; font-size: 15px;\">﻿</span><span style=\"background-color: transparent; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 11.5pt;\"><img src=\"https://lh7-rt.googleusercontent.com/docsz/AD_4nXd6ELeliN17tx3PVdL1GCMlcK0m6dIL4Dfq_P8iM--kI6DWtpasfGfbygJh55XH54xVTWFvyNLpf5aMGOTuCGFrHqSm0Y19CW4VBfpN8G-LAJXWCzkMgMOXxfWXtMoJr7JFJbzQ-A?key=yXil_qbk1ISOtJjKXPbxgJqb\" alt=\"\" height=\"65\" width=\"181\"></span></p><p style=\"line-height: 1.5;\"><br></p><p style=\"line-height: 1.5;\"><br></p>","style":{"wrap":true}},"id":"widget_71"}},"exbVersion":"1.18.0","mainSizeMode":"LARGE","theme":"themes/ink/","forBuilderAttributes":{"lockLayout":false,"viewPortSize":{"LARGE":{"width":1920,"height":1080}}},"template":"foldable","widgetsManifest":{},"views":{"view_1":{"id":"view_1","label":"English","layout":{"LARGE":"layout_36"}},"view_2":{"id":"view_2","label":"Español","layout":{"LARGE":"layout_37"}},"view_7":{"id":"view_7","label":"English ","layout":{"LARGE":"layout_45"}},"view_8":{"id":"view_8","label":"Español ","layout":{"LARGE":"layout_46"}}},"sections":{"section_1":{"id":"section_1","label":"Section","views":["view_1","view_2"]},"section_4":{"id":"section_4","label":"Instructions section","views":["view_7","view_8"]}},"dialogs":{"dialog_1":{"id":"dialog_1","mode":"ANCHORED","sizeMode":{"LARGE":{"position":null,"width":"480px","height":"460px"}},"dialogBackground":{"color":"var(--light)","fillType":"fill","image":{"url":""}},"overlayColor":null,"layout":{"LARGE":"layout_32"},"index":0,"isSplash":false,"label":"Print","interactionType":null,"interactionStyles":null,"confirmBeforeClose":true,"alwaysShowConfirmation":false},"dialog_2":{"id":"dialog_2","mode":"FIXED","blockPage":true,"sizeMode":{"LARGE":{"widthMode":"CUSTOM","heightMode":"CUSTOM","width":"813px","height":"775px","position":"MIDDLE_CENTER"}},"interactionType":"BUTTON_INLINE","interactionStyles":{"text":"Don't show this again. No volver a mostrar.","textSize":"14px","buttonText":"","buttonTextSize":"16px"},"confirmBeforeClose":false,"alwaysShowConfirmation":true,"dialogBackground":{"color":"var(--light)","fillType":"fill","image":{"url":""}},"overlayColor":"var(--ref-palette-neutral-1200)","layout":{"LARGE":"layout_35"},"index":0,"isSplash":true,"border":{"type":"solid","color":"var(--dark-500)","width":"2px"},"label":"Splash info","closeWhenClickOverlay":false}},"dataSources":{"fa8c8e38deaf46ff8da9cc0c21ed998b":{"type":"WEB_MAP","itemI