nt-size: 15px;\"> </span></p><p><span style=\"font-size: inherit; font-family: inherit;\">DISCLAIMER: This map is for reference use only. Data provided are derived from multiple sources with varying levels of responsibility for the accuracy or completeness of the data shown hereon.</span></p>","style":{"verticalAlign":"start","wrap":true}},"id":"widget_32"},"widget_33":{"uri":"widgets/common/print/","version":"1.17.0","icon":{"svg":"https://experience.arcgis.com/experience/../cdn/2467/widgets/common/print/icon.svg","properties":{"filename":"Print","originalName":null,"path":null,"color":"var(--dark)","size":16,"inlineSvg":true}},"label":"Print","config":{"printServiceType":"CUSTOMIZE","printTemplateType":"CUSTOMIZE","modeType":"CLASSIC","commonSetting":{"scalePreserved":false,"layoutOptions":{"titleText":"ArcGIS Web Map"},"outScale":36978595.474472,"exportOptions":{"dpi":96},"printExtentType":"CURRENT MAP EXTENT","forceFeatureAttributes":false,"wkid":102100,"wkidLabel":"WGS_1984_Web_Mercator_Auxiliary_Sphere","enableTitle":true,"enableMapPrintExtents":true,"enableOutputSpatialReference":false,"enableQuality":true,"enableFeatureAttribution":true},"previewBackgroundColor":"rgba(0,216,237,1)","enablePreview":true,"previewOutLine":{"color":"#000","size":"4px"},"hasInitBorder":true,"printCustomTemplate":[{"scalePreserved":false,"outScale":36978595.474472,"layoutOptions":{"titleText":"ArcGIS Web Map","legend":false,"scalebarUnit":"Miles","legendLayers":[],"customTextElements":[],"elementOverrides":{"North Arrow":{"name":"North Arrow","type":"CIMMarkerNorthArrow","visible":true}}},"exportOptions":{"dpi":96},"printExtentType":"CURRENT MAP EXTENT","attributionVisible":false,"forceFeatureAttributes":true,"wkid":102100,"wkidLabel":"WGS_1984_Web_Mercator_Auxiliary_Sphere","enableTitle":true,"legendEnabled":true,"enableMapPrintExtents":true,"enableOutputSpatialReference":true,"enableQuality":true,"enableFeatureAttribution":true,"enableMapSize":true,"overrideCommonSetting":false,