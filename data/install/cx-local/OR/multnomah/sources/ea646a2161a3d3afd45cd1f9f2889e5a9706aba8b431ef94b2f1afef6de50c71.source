<style>.bg{opacity: 0; transition: opacity 1s; -webkit-transition: opacity 1s;} .bg-loaded{opacity: 1;}</style><script>
 (function ($) {
     $(document).ready(function () {

         $('.header-nav li.header-search>a').click(function (e) {
             e.preventDefault();
             if ($(this).hasClass('search-active')) {
                 $('.header-search li.header-search-form').css('width', '0');
                 setTimeout(function () {
                     $('.header-nav li.header-search>a').removeClass('search-active');
                 }, 650);
             } else {
                 $(this).addClass('search-active');
                 $('.header-search li.header-search-form').css('width', $('.header-main .header-nav.nav-right').innerWidth() - 50);
             }
         });

         function news_grid_height() {
             var maxTitleHeight = 45;
             $('.news-grid.slider .box .blog-post-inner').removeAttr("style");

             $('.news-grid.slider .box').each(function () {
                 var titleHeight = $(this).find('.blog-post-inner').height();
                 if (titleHeight > maxTitleHeight) {
                     maxTitleHeight = titleHeight;
                 }
             });

             $('.news-grid.slider .box .blog-post-inner').css('min-height', (maxTitleHeight + 15) + 'px');
         }
         news_grid_height();
         $(window).on("resize", news_grid_height);

         function events_grid_height() {
             var maxDetailsHeight = 45;
             $('.events-grid-vertical.slider article .event-details').removeAttr("style");

             $('.events-grid-vertical.slider article').each(function () {
                 var DetailsHeight = $(this).find('.event-details').height();
                 if (DetailsHeight > maxDetailsHeight) {
                     maxDetailsHeight = DetailsHeight;
                 }
             });

             $('.events-grid-vertical.slider article .event-details').css('min-height', (maxDetailsHeight + 60) + 'px');
         }
         events_grid_height();
         $(window).on("resize", events_grid_height);

         $('#header .has-dropdown a').on('focus', function () {
             $('.has-dropdown').removeClass('current-dropdown')
             $(this).parents('.has-dropdown').addClass('current-dropdown');
         });
     });
 })(jQuery);</script><link rel="icon" href="https://www.crpud.net/wp-content/uploads/fav-1.png" sizes="32x32" />
