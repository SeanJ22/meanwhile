<h2>Candidates</h2>
<div class="oc-wysiwyg-container-panel-content">
<p><a name="candidates" id="candidates"></a></p>
<div><strong>2026 General Election</strong></div>
<ul>
    <li><a href="/files/assets/county/v/4/government/elections/documents/unofficial_general_election_candidate_list_08272026.xlsx" target="_blank" title="Unofficial General Election candidate list" class="document ext-xlsx"><i aria-hidden="true"></i>Unofficial Candidates List<span class="file-info">(XLSX,&nbsp;12KB)</span></a></li>
    <li><a href="/files/assets/county/v/4/government/elections/documents/ballot-questions-november-2026-general-election-8-19-2026.pdf" target="_blank" title="Ballot questions for 2026 General Election" class="document ext-pdf"><i aria-hidden="true"></i>Ballot Questions<span class="file-info">(PDF,&nbsp;88KB)</span></a></li>
</ul>
<div><strong>2026 Primary Election</strong></div>
