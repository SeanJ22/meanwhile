				<h3 class="modal-title">Changes</h3>
			</div>
			<div class="modal-body" id="modal-slide" style="background-color: #E6E6E6;" ng-bind-html="html">
				
			</div>
		</div>
	</div>
</div>
<script>
function changesLinkFunction(e)
{
	e.preventDefault;///NOT DONE
	$('#changes-modal').modal('show');
};
</script>


