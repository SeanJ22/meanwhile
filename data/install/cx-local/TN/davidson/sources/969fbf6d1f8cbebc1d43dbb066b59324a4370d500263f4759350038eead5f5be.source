    ga('send', 'pageview');
</script>
<script>
    $(function(){
        setupApp();
		
		var placeHolderSupport = ('placeholder' in document.createElement('input'));

		/*IF PLACEHOLDER IS NOT SUPPORTED...*/
		if(!placeHolderSupport) {
		
			/*GET THE ID OF EACH FORM ELEMENT*/
			voterFirstName      = $('#voterFirstName');
			voterLastName      = $('#voterLastName');
			voterZip1        = $('#voterZip1');
			voterStreetAddress   = $('#voterStreetAddress');
			voterZip2     = $('#voterZip2');
			
			/*DEFINE DEFAULT VALUES FOR EACH INPUT FIELD*/
			voterFirstNameval    = voterFirstName.attr('placeholder');
			voterLastNameval   = voterLastName.attr('placeholder');
			voterZip1val     = voterZip1.attr('placeholder');
			voterStreetAddressval = voterStreetAddress.attr('placeholder');
			voterZip2val = voterZip2.attr('placeholder');
		
			/*ASSOCIATE THE DEFAULT VALUES TO THE FORM INPUT FIELDS*/
			voterFirstName.val(voterFirstNameval);
			voterLastName.val(voterLastNameval);
			voterZip1.val(voterZip1val);
			voterStreetAddress.val(voterStreetAddressval);
			voterZip2.val(voterZip2val);
		
			/*CYCLE THROUGH EACH INPUT FIELD TO...*/
			$.each([
			{selector: voterFirstName,   mvalue: voterFirstNameval},
			{selector: voterLastName,  mvalue: voterLastNameval},
			{selector: voterZip1,    mvalue: voterZip1val},
			{selector: voterStreetAddress, mvalue: voterStreetAddressval},
			{selector: voterZip2,    mvalue: voterZip2val}
			],function(i, obj) {
		
			  /*...SHOW OR HIDE DEFAULT VALUES*/
				obj.selector.focus(function() {
					if(this.value == obj.mvalue) { this.value = ''; };
				}).blur(function() {    
					if(!this.value) { this.value = obj.mvalue;};
				});
			});
		}
    });
</script>
<script>
/* we need this only on touch devices */
if (Modernizr.touch) {
   
$("input").blur(function() {
    $("[data-role=footer]").show();
});

$("input").focus(function() {
    $("[data-role=footer]").hide();
});
}
</script>
