<style type="text/css">#cms-header .logo {
  height: 110px !important;
}

#g4 div.slide div.text div.description div p a {
  color: white;
  text-decoration: none;
}

#programs-v2 {
  background-image: linear-gradient(white, LightGray) !important;
}

#SL1 {
  background-image: linear-gradient(white, LightGray) !important;
}

#footer-f1 .footer-column-main {
  max-width: 30%;
  padding-right: 0px !important;
}

#page-wrapper nav ul li:nth-child(1),
#page-wrapper nav ul li:nth-child(2)::before {
  display: none;
}

#page-wrapper nav ul li:nth-child(2) {
  padding-left: 0;
}
</style>
