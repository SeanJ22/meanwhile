d":8,"name":1294,"slug":1295,"in_menu":7,"status":1128,"password_protected":8,"ai_generated":7,"flags":1296,"shared_layouts":1297,"breadcrumbs":1298,"content":1300,"metadata":8,"secOrgId":22,"langCode":-1},1142314,"Board of Commissioners","board-of-commissioners",{"new_renderer_enabled":12},[],[1299],{"name":1294,"slug":1295,"type":1135,"url":8},{"structure":1301,"assets":1437},{"id":1302,"name":1303,"type":1304,"properties":1305,"nodes":1308},"root","Root","BASE_COLUMN",{"backgroundColor":1306,"backgroundImage":1307},{"toggle":7,"value":79},{"toggle":7,"image":8},[1309,1340],{"id":1310,"properties":1311,"nodes":1318,"name":1338,"type":1339},"316f2be5-eb95-45f3-b91c-0ecff7b42e27",{"customClasses":1312,"anchorTag":79,"borderRadius":1313,"backgroundColor":1314,"backgroundImage":1315,"margin":1316,"padding":1317},[],{"value":138},{"toggle":7,"value":79},{"toggle":7,"image":8},{"linked":12,"value":228,"top":228,"bottom":228,"left":228,"right":228},{"linked":12,"value":138,"top":138,"bottom":138,"left":138,"right":138},[1319],{"name":1320,"type":1304,"nodes":1321},"Base Column",[1322,1330],{"id":1323,"name":1324,"type":1325,"content":1326,"properties":1328},"4a7e4013-16d7-461f-b90f-53659bae19d0","Heading","CONTENT_NODE_HEADING",{"html":1327},"\u003Ch1>Board of Commissioners\u003C/h1>",{"anchorTag":79,"customClasses":1329},[],{"id":1331,"name":1332,"type":1333,"content":1334,"properties":1336},"e46283dd-6b05-4c2e-bd09-5141199dbc56","Text","CONTENT_NODE_TEXT",{"html":1335},"\u003Cp>The Board of Commissioners is an administrative body charged with setting policy for the City of Forest Hills by enacting ordinances. The Board consists of three Commissioners, who are elected at large. Members serve in four-year, staggered terms. At the first regular meeting after each biennial election, the Board elects one of its members to serve a two-year term as Mayor and one member to serve as Vice Mayor.\u003C/p>\u003Cp>Meetings\u003C/p>\u003Cp style=\"text-align: start\">The Board of Commissioners meets at 5:00 pm on the third Thursday of each month.\u003C/p>",{"anchorTag":79,"customClasses":1337},[],"One Column","LAYOUT_NODE_SINGLE_COLUMN",{"id":1341,"properties":1342,"nodes":1349,"name":1435,"type":1436},"c8b152f6-1a50-4297-9cfd-4ffa4e9a3f30",{"customClasses":1343,"anchorTag":79,"borderRadius":1344,"backgroundColor":1345,"backgroundImage":1346,"margin":1347,"padding":1348},[],{"value":138},{"toggle":7,"value":79},{"toggle":7,"image":8},{"linked":12,"value":228,"top":228,"bottom":228,"left":228,"right":228},{"linked":12,"value":138,"top":138,"bottom":138,"left":138,"right":138},[1350,1382,1409],{"name":1320,"type":1304,"nodes":1351},[1352],{"id":1353,"name":1354,"type":1355,"content":1356,"properties":1379},"3fcf2528-afb3-4c8d-b4ac-8c945504e903","Card","CONTENT_NODE_CARD",{"heading":1357,"text":1363,"image":1369},{"id":1358,"name":1324,"type":1325,"content":1359,"properties":1361},"cardTitle_3fcf2528-afb3-4c8d-b4ac-8c945504e903",{"html":1360},"\u003Ch3>Lanson Hyde\u003C/h3>",{"anchorTag":79,"customClasses":1362},[],{"id":1364,"name":1332,"type":1333,"content":1365,"properties":1367},"cardContent_3fcf2528-afb3-4c8d-b4ac-8c945504e903",{"html":1366},"\u003Cp>\u003Cstrong>Position:&nbsp; \u003C/strong>Mayor\u003Cbr>\u003Cstrong>Phone Number:&nbsp; \u003C/strong>615-372-8677\u003C/p>\u003Cp>Lanson Hyde III joined the Board in 2011, was reelected in 2012 and named Vice Mayor in 2014. He was chosen Mayor in 2018. A City resident for over 20 years, he is CEO of Epix Healthcare. His term expires in 2028.\u003C/p>",{"anchorTag":79,"customClasses":1368},[],{"name":1370,"type":1371,"assetUrl":1372,"content":1373,"properties":1376},"Image","CONTENT_NODE_IMAGE","https://cmsv2-assets.apptegy.net/uploads/18981/file/2382916/2cf6ce78-8a7e-4316-9ecc-469c9a79c043.png",{"assetUrl":1372,"assetId":1374,"altText":1375},2382916,"Lanson Hyde",{"isDecorative":7,"naturalWidth":128,"naturalHeight":128,"focalPointPosition":1377},{"x":1378,"y":1378},50,{"anchorTag":79,"customClasses":1380,"design":1381,"showImage":12,"showHeadline":12,"imagePosition":589,"wrapText":12,"textCursor":138,"headlineCursor":138},[],"none",{"name":1320,"type":1304,"nodes":1383},[1384],{"id":1385,"name":1354,"type":1355,"content":1386,"properties":1407},"5dee734b-02a9-425c-b4cc-bbf831a98915",{"heading":1387,"text":1393,"image":1399},{"id":1388,"name":1324,"type":1325,"content":1389,"properties":1391},"cardTitle_5dee734b-02a9-425c-b4cc-bbf831a98915",{"html":1390},"\u003Ch3>Henry Trost\u003C/h3>",{"anchorTag":79,"customClasses":1392},[],{"id":1394,"name":1332,"type":1333,"content":1395,"properties":1397},"cardContent_5dee734b-02a9-425c-b4cc-bbf831a98915",{"html":1396},"\u003Cp>\u003Cstrong>Position:&nbsp; \u003C/strong>Vice Mayor\u003Cbr>\u003Cstrong>Phone Number:&nbsp; \u003C/strong>615-372-8677\u003C/p>\u003Cp>Henry A. Trost was elected Commissioner in 2014 and re-elected in 2018 where he was chosen as Vice Mayor. Trost is a commercial real estate advisor with Avison Young and has lived in Forest Hills since 2008. His term expires in 2026.\u003C/p>",{"anchorTag":79,"customClasses":1398},[],{"name":1370,"type":1371,"assetUrl":1400,"content":1401,"properties":1404},"https://cmsv2-assets.apptegy.net/uploads/18981/file/2382923/e8ba5b14-9dc1-442e-9258-c18adbaa8e06.png",{"assetUrl":1400,"assetId":1402,"altText":1403},2382923,"Henry Trost",{"isDecorative":7,"naturalWidth":1405,"naturalHeight":1405,"focalPointPosition":1406},323,{"x":1378,"y":1378},{"anchorTag":79,"customClasses":1408,"design":1381,"showImage":12,"showHeadline":12,"imagePosition":589,"wrapText":12,"textCursor":138,"headlineCursor":138},[],{"name":1320,"type":1304,"nodes":1410},[1411],{"id":1412,"name":1354,"type":1355,"content":1413,"properties":1433},"6775d3ef-b399-4b39-87d9-6086016e50ec",{"heading":1414,"text":1420,"image":1426},{"id":1415,"name":1324,"type":1325,"content":1416,"properties":1418},"cardTitle_6775d3ef-b399-4b39-87d9-6086016e50ec",{"html":1417},"\u003Ch3>James Gardner\u003C/h3>",{"anchor