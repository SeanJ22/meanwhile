ail Blast\",\"mailto\":false,\"icon_id\":266,\"ipAddress\":false,\"opens_in_new_tab\":true}],\"icons_active\":true}},\"gallery\":{\"slides\":[{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2355287/d2d0c0f4-a930-478d-96a6-a615639a3c7b.png\",\"index\":0,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2355287/px600_d2d0c0f4-a930-478d-96a6-a615639a3c7b.png\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2355287/px960_d2d0c0f4-a930-478d-96a6-a615639a3c7b.png\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2355287/px1280_d2d0c0f4-a930-478d-96a6-a615639a3c7b.png\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2355287/px1600_d2d0c0f4-a930-478d-96a6-a615639a3c7b.png\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2355287/px1920_d2d0c0f4-a930-478d-96a6-a615639a3c7b.png\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2355287/px2560_d2d0c0f4-a930-478d-96a6-a615639a3c7b.png\"},\"title\":\"<h1>Welcome to the City of Forest Hills!</h1>\",\"content\":\"<p>A sky view of our beautiful rolling hills at sunset.</p>\",\"alt_text\":\"Forest Hills\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2405831/48989b9a-2f7a-48f9-8732-ae5c936e8104.jpeg\",\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2405831/px600_48989b9a-2f7a-48f9-8732-ae5c936e8104.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2405831/px960_48989b9a-2f7a-48f9-8732-ae5c936e8104.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2405831/px1280_48989b9a-2f7a-48f9-8732-ae5c936e8104.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2405831/px1600_48989b9a-2f7a-48f9-8732-ae5c936e8104.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2405831/px1920_48989b9a-2f7a-48f9-8732-ae5c936e8104.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2405831/px2560_48989b9a-2f7a-48f9-8732-ae5c936e8104.jpeg\"},\"title\":\"<h1>Forest Hills</h1>\",\"content\":\"<p>Forest Hills is one of five satellite cities in Nashville Davidson County and is just minutes away from downtown Nashville.</p>\",\"alt_text\":\"Forest Hills\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2966234/ecf91930-8ebd-44ea-88c9-1332f6984fe4.jpeg\",\"index\":11,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2966234/px600_ecf91930-8ebd-44ea-88c9-1332f6984fe4.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2966234/px960_ecf91930-8ebd-44ea-88c9-1332f6984fe4.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2966234/px1280_ecf91930-8ebd-44ea-88c9-1332f6984fe4.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2966234/px1600_ecf91930-8ebd-44ea-88c9-1332f6984fe4.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2966234/px1920_ecf91930-8ebd-44ea-88c9-1332f6984fe4.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2966234/px2560_ecf91930-8ebd-44ea-88c9-1332f6984fe4.jpeg\"},\"title\":\"<h1>Guest Speaker Steve Ward</h1>\",\"content\":\"<p>Radnor Lake State Park 50th Anniversary</p>\",\"alt_text\":\"Steve Ward\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4922318/d3ed2613-cb19-48f8-a3e3-1106de5cfb1c.jpeg\",\"index\":2,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4922318/px600_d3ed2613-cb19-48f8-a3e3-1106de5cfb1c.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4922318/px960_d3ed2613-cb19-48f8-a3e3-1106de5cfb1c.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4922318/px1280_d3ed2613-cb19-48f8-a3e3-1106de5cfb1c.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4922318/px1600_d3ed2613-cb19-48f8-a3e3-1106de5cfb1c.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4922318/px1920_d3ed2613-cb19-48f8-a3e3-1106de5cfb1c.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4922318/px2560_d3ed2613-cb19-48f8-a3e3-1106de5cfb1c.jpeg\"},\"title\":\"<h1 style=\\\"text-align: left\\\">Brand New Percy Priest Elementary Ribbon Cutting Ceremony.</h1>\",\"content\":\"<p style=\\\"text-align: left\\\">The new school will replace the old school and service grades K-5 and hold up to 743 students. The new school is scheduled to open its doors in August 2025.</p>\",\"alt_text\":\"Percy Priest Elementary Ribbon Cutting Ceremony\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346867/62feef55-ce22-4066-b56c-b824809423ca.jpeg\",\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346867/px600_62feef55-ce22-4066-b56c-b824809423ca.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346867/px960_62feef55-ce22-4066-b56c-b824809423ca.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346867/px1280_62feef55-ce22-4066-b56c-b824809423ca.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346867/px1600_62feef55-ce22-4066-b56c-b824809423ca.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346867/px1920_62feef55-ce22-4066-b56c-b824809423ca.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346867/px2560_62feef55-ce22-4066-b56c-b824809423ca.jpeg\"},\"title\":\"<h1>Richland Country Club</h1>\",\"content\":\"<p><strong>Richland Country Club is a private, member-owned Club located in Forest Hills and was established in 1901.</strong></p>\",\"alt_text\":\"Richland Country Club\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2343883/1aeafc0a-2c52-423e-82b5-51b6b59d0f62.png\",\"index\":2,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2343883/px600_1aeafc0a-2c52-423e-82b5-51b6b59d0f62.png\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2343883/px960_1aeafc0a-2c52-423e-82b5-51b6b59d0f62.png\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2343883/px1280_1aeafc0a-2c52-423e-82b5-51b6b59d0f62.png\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2343883/px1600_1aeafc0a-2c52-423e-82b5-51b6b59d0f62.png\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2343883/px1920_1aeafc0a-2c52-423e-82b5-51b6b59d0f62.png\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2343883/px2560_1aeafc0a-2c52-423e-82b5-51b6b59d0f62.png\"},\"title\":\"<h1>Historic Stone Walls and Columns</h1>\",\"content\":\"<p>Forest Hills is known for its historical walls and columns throughout the city. This pier is customized with the City of Forest Hills Seal.</p>\",\"alt_text\":\"City of Forest Hills Marker\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3240238/5cf6f224-dea6-4345-a9dd-188f7ee2c680.png\",\"index\":6,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3240238/px600_5cf6f224-dea6-4345-a9dd-188f7ee2c680.png\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3240238/px960_5cf6f224-dea6-4345-a9dd-188f7ee2c680.png\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3240238/px1280_5cf6f224-dea6-4345-a9dd-188f7ee2c680.png\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3240238/px1600_5cf6f224-dea6-4345-a9dd-188f7ee2c680.png\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3240238/px1920_5cf6f224-dea6-4345-a9dd-188f7ee2c680.png\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3240238/px2560_5cf6f224-dea6-4345-a9dd-188f7ee2c680.png\"},\"title\":\"<h1>Forest Hills City Hall </h1>\",\"content\":\"<p>Our new city hall was designed by Allard Ward Architects and construction began in 2011.</p>\",\"alt_text\":\"Forest Hills City Hall\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385814/4fb47562-f079-4f5a-a78b-f6050a32ac53.jpeg\",\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385814/px600_4fb47562-f079-4f5a-a78b-f6050a32ac53.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385814/px960_4fb47562-f079-4f5a-a78b-f6050a32ac53.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385814/px1280_4fb47562-f079-4f5a-a78b-f6050a32ac53.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385814/px1600_4fb47562-f079-4f5a-a78b-f6050a32ac53.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385814/px1920_4fb47562-f079-4f5a-a78b-f6050a32ac53.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385814/px2560_4fb47562-f079-4f5a-a78b-f6050a32ac53.jpeg\"},\"title\":\"<h1>Radnor Lake</h1>\",\"content\":\"<p><span>Radnor Lake State Natural Area, also known as Radnor Lake State Park, is a popular state natural area and state park located on the eastern boundaries of Forest Hills.</span></p>\",\"alt_text\":\"Radnor Lake\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385894/efe4e736-2a65-40ec-84ce-6f0a018f252f.png\",\"index\":9,\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385894/px600_efe4e736-2a65-40ec-84ce-6f0a018f252f.png\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385894/px960_efe4e736-2a65-40ec-84ce-6f0a018f252f.png\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385894/px1280_efe4e736-2a65-40ec-84ce-6f0a018f252f.png\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385894/px1600_efe4e736-2a65-40ec-84ce-6f0a018f252f.png\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385894/px1920_efe4e736-2a65-40ec-84ce-6f0a018f252f.png\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2385894/px2560_efe4e736-2a65-40ec-84ce-6f0a018f252f.png\"},\"title\":\"<h1>Warner Park</h1>\",\"content\":\"<p><span>As one of the largest municipal natural area parks in the country, Warner Parks boasts amenities, historic and natural landmarks, and other features that make it a top outdoor destination in Tennessee which borders the western boundaries of Forest Hills.</span></p>\",\"alt_text\":\"Warner Park\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346914/509803bc-42df-44a0-8bc3-e394ae82d95e.jpeg\",\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346914/px600_509803bc-42df-44a0-8bc3-e394ae82d95e.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346914/px960_509803bc-42df-44a0-8bc3-e394ae82d95e.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346914/px1280_509803bc-42df-44a0-8bc3-e394ae82d95e.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346914/px1600_509803bc-42df-44a0-8bc3-e394ae82d95e.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346914/px1920_509803bc-42df-44a0-8bc3-e394ae82d95e.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346914/px2560_509803bc-42df-44a0-8bc3-e394ae82d95e.jpeg\"},\"title\":\"<h1>Otter Creek Bridge</h1>\",\"content\":\"<p>One of our beautiful stone bridges across Otter Creek into a private residential neighborhood.</p>\",\"alt_text\":\"Otter Creek Bridge\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346933/ac12c5ec-52b1-4e27-b2c2-5d9f58c9a2cd.jpeg\",\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346933/px600_ac12c5ec-52b1-4e27-b2c2-5d9f58c9a2cd.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346933/px960_ac12c5ec-52b1-4e27-b2c2-5d9f58c9a2cd.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346933/px1280_ac12c5ec-52b1-4e27-b2c2-5d9f58c9a2cd.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346933/px1600_ac12c5ec-52b1-4e27-b2c2-5d9f58c9a2cd.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346933/px1920_ac12c5ec-52b1-4e27-b2c2-5d9f58c9a2cd.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/2346933/px2560_ac12c5ec-52b1-4e27-b2c2-5d9f58c9a2cd.jpeg\"},\"title\":\"<h1>John C. Lovell Pathway</h1>\",\"content\":\"<p><span>The John C. Lovell Pathway opened in June 2005 and was named after the former Mayor John C. Lovell.</span></p>\",\"alt_text\":\"Pathway\"},{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3305467/a689ec6b-b3df-4eb9-be2b-cbefee987d9d.jpeg\",\"sizes\":{\"px600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3305467/px600_a689ec6b-b3df-4eb9-be2b-cbefee987d9d.jpeg\",\"px960\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3305467/px960_a689ec6b-b3df-4eb9-be2b-cbefee987d9d.jpeg\",\"small\":null,\"custom\":null,\"px1280\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3305467/px1280_a689ec6b-b3df-4eb9-be2b-cbefee987d9d.jpeg\",\"px1600\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3305467/px1600_a689ec6b-b3df-4eb9-be2b-cbefee987d9d.jpeg\",\"px1920\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3305467/px1920_a689ec6b-b3df-4eb9-be2b-cbefee987d9d.jpeg\",\"px2560\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/3305467/px2560_a689ec6b-b3df-4eb9-be2b-cbefee987d9d.jpeg\"},\"title\":\"<h1>City of Forest Hills </h1>\",\"content\":\"<p>2024 Patriotic Decor</p>\",\"alt_text\":\"City's Patriotic Decor\"}],\"widget\":{\"body\":\"\",\"link\":{\"href\":\"\",\"name\":\"\",\"target\":\"\"}}},\"parallax\":{\"565f2560-2405-464a-8cfd-6454ed9b8fd4_0\":{\"background_image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/5696795/25bdbaf6-7dbd-493c-bb51-54bffb979d85.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"city of forest hills\",\"asset_id\":5696795,\"cropped_width\":4268,\"cropped_height\":2835,\"ai_generated_alt_text\":false}}},\"programs\":{\"d0130248-7da2-4db0-af1a-4e2e2a575b4f_0\":{\"slider\":true,\"content\":[{\"link\":{\"url\":\"https://www.cityofforesthills.com/documents/departments-%26-services/public-works/21595566\",\"name\":\"City Street Paving \",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/6170330/0363a642-4b81-4a05-8459-2e2157dc4009.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"Paving\",\"asset_id\":6170330,\"cropped_width\":180,\"cropped_height\":180,\"ai_generated_alt_text\":false},\"title\":\"City Street Paving \",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">Click on the link above for the city's suggested paving schedule. Road schedules are subject to change according to the city engineer's recommendations.</p>\"},{\"link\":{\"url\":\"https://www.cityofforesthills.com/o/cfh/page/recycling-clean-out-day\",\"name\":\"2026 Fall Recycle & Clean Out Day\",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4989237/94b87024-947f-4ad0-adb7-722f599b90b9.png\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"Recycle Day\",\"asset_id\":4989237,\"cropped_width\":438,\"cropped_height\":438},\"title\":\"2026 Fall Recycle & Clean Out Day\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">Fall Recycle &amp; Clean Out Day coming up on Saturday Sept 19th from 8:30am - 12:30 pm.</p>\"},{\"link\":{\"url\":\"https://www.cityofforesthills.com/documents/tn-dept.-of-agriculture---div.-of-forestry-grant/24464476\",\"name\":\"Hillsboro Road Tree Planting Grant\",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/5591046/c30e1833-e569-4148-a059-e437a9b5b311.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"Cherry trees\",\"asset_id\":5591046,\"cropped_width\":671,\"cropped_height\":671},\"title\":\"Hillsboro Road Tree Planting Grant\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">The city was recently approved for a TN Dept. of Agriculture Grant to plant new Cherry Trees and Pansy Redbuds along Hillsboro Road corridor from Harding Place to OHB.</p>\"},{\"link\":{\"url\":\"https://www.cityofforesthills.com/documents/master-storm-water-projects/842148\",\"name\":\"City's Master Stormwater Plan\",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4676254/f874c52f-6315-41c8-b928-e874625b3f8f.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"Stormwater\",\"asset_id\":4676254,\"cropped_width\":390,\"cropped_height\":390},\"title\":\"City's Master Stormwater Plan\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">The city continues to move forward on our Master Stormwater Plan. Surveys &amp; designs have been completed, and construction is expected to be completed by the end of summer in 2026.</p>\"},{\"link\":{\"url\":\"https://www.cityofforesthills.com/page/public-safety\",\"name\":\"New Tyne Blvd Pathway\",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4676111/49d7470e-1d7c-450b-b721-f24ef1eab612.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"Tyne Blvd Pathway\",\"asset_id\":4676111,\"cropped_width\":784,\"cropped_height\":784},\"title\":\"New Tyne Blvd Pathway\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">Construction on the new Tyne Blvd Pathway from Hillsboro Rd to Robert E. Lee Drive is on track to start construction in 2027.</p>\"},{\"link\":{\"url\":\"https://thrillshare.com/s/documents-cfh/browse/842168#\",\"name\":\"Kingsbury & OHB Entrance Project\",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/5753110/188e73fc-51ca-4536-88cd-7426861ef4f8.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"Stone Columns\",\"asset_id\":5753110,\"cropped_width\":3024,\"cropped_height\":3024,\"ai_generated_alt_text\":false},\"title\":\"Kingsbury & OHB Entrance Project\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">The city is currently installing the last of the stone entrance columns to mimic others throughout the city at the entrance to Kingsbury Drive from OHB.</p>\"},{\"link\":{\"url\":\"https://core-docs.s3.us-east-1.amazonaws.com/documents/asset/uploaded_file/4226/CFH/5829947/Multi-Hazard_Mitigation_Plan_Survey.pdf\",\"name\":\"2025 Hazard Mitigation Plan Survey\",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4846464/3e864d8a-23e6-4dd8-9d54-70c2e40a6bfe.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"OEM\",\"asset_id\":4846464,\"cropped_width\":787,\"cropped_height\":787},\"title\":\"2025 Hazard Mitigation Plan Survey\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">The Nashville Office of Emergency Management (OEM) is excited to invite residents of Metro Nashville Davidson County to participate in the 2025 Hazard Mitigation Plan Survey.</p>\"},{\"link\":{\"url\":\"\",\"name\":\"City Patriotic Decor\"},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4676075/6ca7257c-4c24-4c34-acfc-7190fc24083b.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"Patriotic Decor\",\"asset_id\":4676075,\"cropped_width\":875,\"cropped_height\":875},\"title\":\"City Patriotic Decor\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">The new Patriotic Decor is on display throughout the city at each of our stone wall features. The decor will go up just before Memorial Day and remain up through Labor Day.</p>\"},{\"link\":{\"url\":\"https://www.cityofforesthills.com/article/2174172\",\"name\":\"Real ID Events\",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4676078/afbbda6f-8bcb-43b2-82fe-ccd9087f074c.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"Real ID\",\"asset_id\":4676078,\"cropped_width\":319,\"cropped_height\":319},\"title\":\"Real ID Events\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">The city has set up two separate Real ID Events with the Dept. of Homeland Security after the mandatory requirement went into effect. The dates will be June 13th &amp; Sept 4th, 2025.</p>\"},{\"link\":{\"url\":\"https://www.cityofforesthills.com/o/cfh/page/educationreligious\",\"name\":\"New Percy Priest Elementary  School\",\"opens_in_new_tab\":true},\"image\":{\"url\":\"https://cmsv2-assets.apptegy.net/uploads/18981/file/4676352/581c238b-bb94-45e9-b267-a945d98b8ab1.jpeg\",\"sizes\":{\"px600\":null,\"px960\":null,\"small\":null,\"custom\":null,\"px1280\":null,\"px1600\":null,\"px1920\":null,\"px2560\":null},\"alt_text\":\"PPE\",\"asset_id\":4676352,\"cropped_width\":548,\"cropped_height\":548},\"title\":\"New Percy Priest Elementary  School\",\"headline\":\"Add headline...\",\"description\":\"<p style=\\\"text-align: left\\\">Our new Percy Priest Elementary School will open Fall 2025! The old PPE is scheduled for demolition in the middle of June to prepare for the new playground and final site work.</p>\"}],\"see_all\":true,\"num_columns\":4,\"see_all_link\":{},\"read_more_link\":true,\"component_header\":\"City Of Forest HIlls \",\"details_on_hover\":true,\"component_header_description\":\"Events & Projects\"}},\"timeline\":{},\"athletics\":{},\"live_feed\":{\"b5858934-0fdd-4260-a5bf-82ed8d27992b_1\":{\"see_all_link\":{\"href\":\"/live-feed\",\"name\":\"See All Posts\",\"target\":\"_self\"},\"component_header\":\"Live Feed\",\"component_header_top\":\"Latest\"}},\"spotlights\":{},\"our_schools\":{\"content\":[]},\"floating_nav\":{\"shape\":\"rounded\",\"buttons\":[],\"is_fixed\":true},\"schools_menu\":{\"menu\":[[],[],[]]},\"sticky_footer\":{\"pill_button\":{\"link\":\"\",\"title\":\"register\",\"opens_in_new_tab\":false},\"icon_buttons\":[],\"hide_text_label\":\"hide\",\"show_text_label\":\"show\",\"show_pill_button\":true,\"show_social_icons\":true,\"social_media_icons\":[],\"show_only_on_homepage\":true},\"call_to_action\":{},\"custom_component\":{}},\"info\":{\"links_color\":{\"a\":1,\"hex\":\"#4D5A3E\",\"hsl\":{\"a\":1,\"h\":87.85714285714286,\"l\":0.2980392156862745,\"s\":0.18421052631578952},\"hsv\":{\"a\":1,\"h\":87.85714285714286,\"s\":0.31111111111111117,\"v\":0.35294117647058826},\"hex8\":\"#4D5A3EFF\",\"rgba\":{\"a\":1,\"b\":62,\"g\":90,\"r\":77},\"source\":\"hex\"},\"school_name\":\"City of Forest Hills \",\"customHeader\":true,\"primary_color\":{\"a\":1,\"hex\":\"#4D5A3E\",\"hsl\":{\"a\":1,\"h\":87.85714285714286,\"l\":0.2980392156862745,\"s\":0.1842105