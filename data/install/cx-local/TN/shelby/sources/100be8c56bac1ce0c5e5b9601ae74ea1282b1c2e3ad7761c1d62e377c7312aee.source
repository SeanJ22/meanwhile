		<article class="fsResource fsResourceTypeImage"><figure><picture><img alt="The board members stand in front of the GMSD Christmas float." data-aspect-ratio="0.4166666666666667" data-image-sizes="[{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_1/v1734924463/gmsdk12org/mj5ryogfwmaykyxt5jtb/FINALSITEInteriorHero11.png%22,%22width%22:256},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_2/v1734924463/gmsdk12org/mj5ryogfwmaykyxt5jtb/FINALSITEInteriorHero11.png%22,%22width%22:512},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_3/v1734924463/gmsdk12org/mj5ryogfwmaykyxt5jtb/FINALSITEInteriorHero11.png%22,%22width%22:800},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_4/v1734924463/gmsdk12org/mj5ryogfwmaykyxt5jtb/FINALSITEInteriorHero11.png%22,%22width%22:1200},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_5/v1734924463/gmsdk12org/mj5ryogfwmaykyxt5jtb/FINALSITEInteriorHero11.png%22,%22width%22:1600},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_6/v1734924463/gmsdk12org/mj5ryogfwmaykyxt5jtb/FINALSITEInteriorHero11.png%22,%22width%22:2200}]" data-permitted-user="true" data-resource-title="FINALSITEInteriorHero11.png" data-resource-uuid="1efd274d-7834-468b-a891-9ef6b39bb94c"></picture></figure></article>
	</div>


