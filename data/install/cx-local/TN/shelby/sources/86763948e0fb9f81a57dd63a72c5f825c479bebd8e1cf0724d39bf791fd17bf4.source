rency_info\":\"Supplement contains: Local legislation current through Ord. 2026-05, passed 5-26-26\",\"toc\":[{\"id\":46373,\"uuid\":\"2c33479d-b62a-4976-836a-92bf8ab7a8b7\",\"slug\":\"collierv_tn\",\"title\":\"Collierville, TN Code of Ordinances\",\"client_slug\":\"collierville\",\"sections\":[{\"id\":82241431,\"doc_id\":\"0-0-0-35353\",\"passthru_doc_id\":null,\"title\":\"COLLIERVILLE, TENNESSEE CODE OF ORDINANCES\",\"type\":\"section\",\"has_children\":false,\"has_section_children\":false},{\"id\":82241432,\"doc_id\":\"0-0-0-35357\",\"passthru_doc_id\":null,\"title\":\"TOWN OFFICIALS\",\"type\":\"section\",\"has_children\":false,\"has_section_children\":false},{\"id\":82241433,\"doc_id\":\"82241433\",\"passthru_doc_id\":\"0-0-0-35360\",\"title\":\"ADOPTING ORDINANCE\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82241437,\"doc_id\":\"0-0-0-35379\",\"passthru_doc_id\":null,\"title\":\"CHARTER\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82241484,\"doc_id\":\"0-0-0-35615\",\"passthru_doc_id\":null,\"title\":\"TITLE I: GENERAL PROVISIONS\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82241524,\"doc_id\":\"0-0-0-35705\",\"passthru_doc_id\":null,\"title\":\"TITLE III: ADMINISTRATION\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82241898,\"doc_id\":\"0-0-0-36708\",\"passthru_doc_id\":null,\"title\":\"TITLE V: PUBLIC SERVICES\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82242067,\"doc_id\":\"0-0-0-37482\",\"passthru_doc_id\":null,\"title\":\"TITLE VII: TRAFFIC CODE\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82242259,\"doc_id\":\"0-0-0-37961\",\"passthru_doc_id\":null,\"title\":\"TITLE IX: GENERAL REGULATIONS\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82242570,\"doc_id\":\"0-0-0-39088\",\"passthru_doc_id\":null,\"title\":\"TITLE XI: BUSINESS REGULATIONS\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82243147,\"doc_id\":\"0-0-0-41296\",\"passthru_doc_id\":null,\"title\":\"TITLE XIII: GENERAL OFFENSES\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82243214,\"doc_id\":\"0-0-0-41531\",\"passthru_doc_id\":null,\"title\":\"TITLE XV: LAND USAGE\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82243750,\"doc_id\":\"0-0-0-46713\",\"passthru_doc_id\":null,\"title\":\"TABLE OF SPECIAL ORDINANCES\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true},{\"id\":82243754,\"doc_id\":\"0-0-0-46718\",\"passthru_doc_id\":null,\"title\":\"PARALLEL REFERENCES\",\"type\":\"section\",\"has_children\":true,\"has_section_children\":true}],\"is_pdf\":false,\"is_ingesting\":false,\"is_publishing\":false,\"is_deleting\":false}]},\"currSection\":{\"id\":82241448,\"code_slug\":\"collierv_tn\",\"code_uuid\":\"2c33479d-b62a-4976-836a-92bf8ab7a8b7\",\"version_uuid\":\"327a6c8d-bd3b-468e-b05d-5094bfc3e360\",\"doc_id\":\"0-0-0-35457\",\"orig_doc_id\":\"0-0-0-35379\",\"orig_doc_idx\":4,\"orig_doc_title\":\"CHARTER\",\"orig_doc_toc_ct\":13,\"title\":\"ARTICLE IV BOARD OF MAYOR AND ALDERMEN\",\"styles\":\"\\/* CSS to match style mapping *\\/\\r\\n\\r\\n\\r\\n\\/* Level Styles *\\/\\r\\n.Title\\r\\n{\\r\\n\\tfont-family:\\t\\\"Arial\\\",sans-serif;\\r\\n\\tfont-style:\\tnormal;\\r\\n\\tfont-weight:\\tbold;\\r\\n\\tfont-size:\\t18pt;\\r\\n\\tcolor:\\t#FFFFFF;\\r\\n\\tbackground-color:\\t#0000A0;\\r\\n\\ttext-align:\\tcenter;\\r\\n\\tmargin-top:\\t27pt;\\r\\n\\tmargin-bottom:\\t9pt;\\r\\n\\tborder-left:\\t2pt solid #000080;\\r\\n\\tborder-top:\\t2pt solid #000080;\\r\\n\\tborder-right:\\t2pt solid #000080;\\r\\n\\tborder-bottom:\\t2pt solid #000080;\\r\\n\\tbackground-color:\\t#0000A0;\\r\\n}\\r\\n\\r\\n.Chapter\\r\\n{\\r\\n\\tfont-family:\\t\\\"Arial\\\",sans-serif;\\r\\n\\tfon