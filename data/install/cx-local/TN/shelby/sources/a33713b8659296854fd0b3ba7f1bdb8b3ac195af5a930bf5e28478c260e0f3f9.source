                    </style><h1 class="sr-only">CHAPTER 39: BOARDS AND COMMISSIONS</h1><div><style>/* CSS to match style mapping */


/* Level Styles */
.Title
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	bold;
	font-size:	18pt;
	color:	#FFFFFF;
	background-color:	#0000A0;
	text-align:	center;
	margin-top:	27pt;
	margin-bottom:	9pt;
	border-left:	2pt solid #000080;
	border-top:	2pt solid #000080;
	border-right:	2pt solid #000080;
	border-bottom:	2pt solid #000080;
	background-color:	#0000A0;
}

.Chapter
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	bold;
	font-size:	16pt;
	color:	#800000;
	text-align:	center;
	margin-top:	36pt;
	margin-bottom:	14pt;
	padding-bottom:	2pt;
	border-bottom:	3pt solid #800000;
}

.Subchapter
{
	font-family:	"Arial",sans-serif;
	font-style:	italic;
	font-weight:	bold;
	font-size:	14pt;
	color:	#800080;
	text-align:	center;
	margin-top:	29pt;
	margin-bottom:	9pt;
}

.Section
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	bold;
	font-size:	12pt;
	color:	#000080;
	text-align:	left;
	margin-top:	29pt;
	margin-bottom:	14pt;
}

.Normal-Level
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	normal;
	font-size:	12pt;
	text-align:	left;
	margin-bottom:	9pt;
}



/* Paragraph Styles */
.ChapAn
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	normal;
	font-size:	12pt;
	text-align:	left;
	margin-left:	108pt;
}

.ChapAn-center
{
	font-family:	"Arial",sans-serif;
	font-style:	italic;
	font-weight:	bold;
	font-size:	12pt;
	text-align:	center;
	margin-top:	9pt;
	margin-bottom:	9pt;
}

.Introduction
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	normal;
	font-size:	12pt;
	text-align:	center;
	margin-bottom:	9pt;
	margin-left:	36pt;
	margin-right:	36pt;
}

.Table-Header
{
	font-family:	"Arial",sans-serif;
	font-style:	italic;
	font-weight:	bold;
	font-size:	12pt;
	text-align:	left;
	margin-bottom:	9pt;
}

.Table-Header-small
{
	font-family:	"Arial",sans-serif;
	font-style:	italic;
	font-weight:	bold;
	font-size:	9pt;
	text-align:	left;
	margin-bottom:	9pt;
}

.Table-Notes
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	normal;
	font-size:	9pt;
	text-align:	left;
	margin-bottom:	9pt;
}

.Table-Text
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	normal;
	font-size:	8pt;
	text-align:	left;
	margin-bottom:	9pt;
}

.Table-Text-small
{
	font-family:	"Arial",sans-serif;
	font-style:	normal;
	font-weight:	normal;
	font-size:	9pt;
	text-align:	left;
	margin-bottom:	9pt;
}



/* Field Styles */
.Note
{
}

.Popup
{
