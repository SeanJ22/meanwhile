    max-width: 800px;
    margin: 0 auto;
}

.year-container {
    margin-bottom: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
}

.year-header {
    background-color: #f5f5f5;
    padding: 10px 15px;
    cursor: pointer;
    margin: 0;
    display: flex;
    align-items: center;
}

.year-header:hover {
    background-color: #e5e5e5;
}

.year-header.active {
    background-color: #e0e0e0;
}

.toggle-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #333;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    color: #fff;
    font-size: 16px;
}

.toggle-icon::before {
    content: '+';
}

.year-header.active .toggle-icon::before {
    content: '-';
}

.year-content {
    display: none;
    padding: 15px;
}

.release-item {
    margin-bottom: 20px;
}

.release-item:last-child {
    margin-bottom: 0;
}

.release-item h3 {
    margin-top: 0;
    color: #333;
}

.release-content {
    margin-bottom: 10px;
}

.release-date {
    font-size: 0.9em;
    color: #666;
    margin-top: 10px;
}

.release-separator {
    text-align: center;
    font-size: 24px;
    color: #ccc;
    margin: 20px 0;
}

.release-content a {
    color: #0066cc;
    text-decoration: none;
}

.release-content a:hover {
    text-decoration: underline;
}</style>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<style>
.homepage-posts {
    width: 100%;
    margin: 0 0;
}

.homepage-post-card {
    width: 100%;
    margin-bottom: 15px;
    padding: 20px;
    background-color: #ffffff;
    border-radius: 3px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.3);
    transition: all 0.3s ease;
}

.homepage-post-card:hover {
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    transform: translateY(-5px);
}

.homepage-post-card h2 {
    margin-top: 0;
    margin-bottom: 15px;
    color: #004a7f;
    font-size: 1.2em;
}

.homepage-post-card .post-excerpt {
    color: #444;
	font-weight: 600;
    margin-bottom: 15px;
}

.homepage-post-card .read-more {
	 margin-bottom: 15px;
}

.homepage-post-card .read-more a {
    color: #a10000;
    text-decoration: none;
    font-weight: bold;
}

.homepage-post-card .read-more a:hover {
    text-decoration: underline;
}

.homepage-post-card .post-categories {
    color: #999;
    font-size: 0.9em;
    margin-top: 15px;
}</style>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<style>
.cal-badge .cal-day {
    text-align: center;
    font-size: 24px;
    color: #0f314c;
}
.cal-badge .cal-month {
    background-color: #0f314c;
    color: #fff;
    text-align: center;
}
.cal-badge {
    border: 2px solid #0f314c;
    border-radius: 0 0 5px 5px;
    width: 50px !important;
    -webkit-box-shadow: 1px 1px 4px rgb(0 0 0 / 40%);
    box-shadow: 1px 1px 4px rgb(0 0 0 / 40%);
}
.content-area ul li {
    position: relative;
    list-style-type: none;
    padding-left: 2rem;
    margin-bottom: 0.5rem;
}

.col-md-1 {
    float: left;
}
.col-md-11{
    padding-left: 50px;
}
.wpsm_panel-body .row {
    clear: both;
    overflow: hidden;
    margin-bottom: 20px;
}

.elementor *, .elementor :after, .elementor :before {
    box-sizing: border-box;
}
*, :after, :before {
    box-sizing: inherit;
}</style>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<style>
.elementor-icon-list-items .elementor-icon-list-item {
  position: relative;
}

.elementor-icon-list-items .elementor-icon-list-icon {
  position: absolute;
  top: 6px;
  left: 0;
}

.elementor-icon-list-items .elementor-icon-list-text {
  margin-left: 27px;
}</style>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<style>
[type=button], [type=submit], button {
    display: inline-block;
    font-weight: 400;
    color: #000;
    text-align: center;
    white-space: nowrap;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    background-color: transparent;
    border: 1px solid #000;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    border-radius: 3px;
    -webkit-transition: all .3s;
    -o-transition: all .3s;
    transition: all .3s;
}
[type=button]:hover, [type=submit]:focus, [type=submit]:hover, button:focus, button:hover {
    color: #fff;
    background-color: #000;
    text-decoration: none;
}</style>
<!-- end Simple Custom CSS and JS -->
<script src="//collincad.org/wp-content/uploads/custom-css-js/9513.js?v=1677"></script>
<!-- start Simple Custom CSS and JS -->
<script>
jQuery(document).ready(function($) {
    $('#press-releases-accordion').on('click', '.year-header', function() {
        var $this = $(this);
        var $content = $this.next('.year-content');
        
        // Close all other containers
        $('.year-header').not($this).removeClass('active');
        $('.year-content').not($content).slideUp(300);
        
        // Toggle current container
        $this.toggleClass('active');
        $content.slideToggle(300);
    });

    // Open the most recent year by default
    $('#press-releases-accordion .year-container:first-child .year-header').addClass('active');
    $('#press-releases-accordion .year-container:first-child .year-content').show();
});</script>
<!-- end Simple Custom CSS and JS -->
