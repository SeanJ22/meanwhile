<script>
document.addEventListener('DOMContentLoaded', function() {
    const scrollLinks = document.querySelectorAll('.viewhourslink');
    
    scrollLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        
        const targetId = "scrolltoexthours";
        const targetElement = document.getElementById(targetId);
        
        if (targetElement) {
          window.scrollTo({
            top: targetElement.offsetTop - 300, // Adjust the offset as needed
            behavior: 'smooth'
          });
        }
      });
    });
  });</script>
<!-- end Simple Custom CSS and JS -->
