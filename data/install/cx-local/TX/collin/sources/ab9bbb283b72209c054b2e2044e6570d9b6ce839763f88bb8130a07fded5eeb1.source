			/*$element.find('.elementor-flip-box__button').css({
				'display' : 'grid',
    			'place-items' : 'center',
				'background' : 'rgba(255, 255, 255, 0)',
				'color' : 'white',
				'font-family': '"Poppins", Sans-serif',
                'font-weight' : '400',
				'font-size' : '14px',
				'height' : '100%',
				'width' : '100%',
				'line-height' : '1.6',
				'border-radius' : '0px',
				'opacity' : '1'
			})
			 .attr('target', target);  // Use the passed-in target string;*/
			$element.find('.elementor-widget-container').css({
				'box-shadow' : '0px 0px 10px 1px rgba(91.49999999999999, 91.49999999999999, 91.49999999999999, 0.7)'
			});


			$element.find('.elementor-widget-container').hover(
				function() {
					// Mouse enters: apply hover effect
					$(this).css({
						'box-shadow' : '0 2px 5px rgba(0,0,0,0.5)',
						'transform' : 'translateY(-5px)',
						'transition': 'all 0.3s ease'   // Smooth transition
					});
					//$element.find('.elementor-flip-box__back').css('opacity', '1');
				},
				function() {
					// Mouse leaves: revert back to original styles
					$(this).css({
						'box-shadow' : '0px 0px 10px 1px rgba(91.49999999999999, 91.49999999999999, 91.49999999999999, 0.7)',
						'transform': 'translateY(0px)'         // Reset scaling
					});
					//$element.find('.elementor-flip-box__back').css('opacity', '0');
