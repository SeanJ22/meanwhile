	//function applyFlipBoxStyles(id, target) {
    function applyFlipBoxStyles(id) {
		// Target the specific element using the data-id attribute
		var $element = $(`[data-id='${id}']`);

		if ($element.length) {
			// Apply the necessary styles for flip box back layer
			//$element.find('.elementor-flip-box__back').css('opacity', '0');

			// Apply styles to the button and set the target and href attributes
			//$element.find('.elementor-flip-box__back .elementor-flip-box__layer__inner').css({
				//'height' : '100%'
			//});
