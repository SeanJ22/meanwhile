    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="4" r="2"/><path d="M4 8l8 2 8-2M12 10v5m0 0-4 7m4-7 4 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  </button>
  <section id="aas-widget-panel" class="aas-widget__panel" role="dialog" aria-modal="true" aria-labelledby="aas-widget-title" hidden>
    <header class="aas-widget__header"><strong id="aas-widget-title">Accessibility Menu <small>(Ctrl+U)</small></strong><button type="button" class="aas-widget__close" aria-label="Close accessibility menu">×</button></header>
    <div class="aas-widget__body">
      <details class="aas-widget__languages"><summary><span aria-hidden="true">◎</span> <span data-aas-language-name>English (USA)</span></summary><p data-i18n="translationNotice">Selecting a language translates this page and menu with Google Cloud Translation. Page text is sent to that service; form entries are excluded.</p><label class="aas-widget__search"> <span data-i18n="search">Search language</span><input type="search" data-aas-language-search autocomplete="off"></label><div data-aas-languages></div><button type="button" data-aas-restore-language data-i18n="restore">Restore original page language</button><button type="button" data-aas-retry-translation data-i18n="retry">Retry translation</button></details>
      <details open class="aas-widget__profiles"><summary data-i18n="profiles">Accessibility Profiles</summary><div class="aas-widget__profile-grid" data-aas-profiles></div></details>
      <label class="aas-widget__size"><span data-i18n="oversized">Oversized Widget</span><input type="checkbox" data-aas-oversized role="switch"></label>
      <div class="aas-widget__controls" data-aas-controls></div>
      <div data-aas-reader hidden><p data-i18n="readerHelp">Reads visible page text aloud using your browser. Use a dedicated screen reader for complete navigation.</p><button type="button" data-aas-read data-i18n="read">Read page</button><button type="button" data-aas-stop data-i18n="stop">Stop reading</button></div>
      <div data-aas-structure hidden></div>
      <div data-aas-dictionary hidden><label><span data-i18n="word">English word</span><input data-aas-word maxlength="60" autocomplete="off"></label><button type="button" data-aas-define data-i18n="define">Look up</button><p data-aas-definition></p><small data-i18n="dictionaryHelp">Only the word you submit is sent to dictionaryapi.dev. English definitions require an internet connection.</small></div>
      <button type="button" class="aas-widget__reset" data-aas-reset><span aria-hidden="true">↻</span> <span data-i18n="reset">Reset All Accessibility Settings</span></button>
      <details class="aas-widget__placement"><summary data-i18n="move">Move / Hide Accessibility Widget</summary><label><span data-i18n="position">Position</span><select data-aas-position><option value="bottom-right" data-i18n="bottomRight">Bottom right</option><option value="bottom-left" data-i18n="bottomLeft">Bottom left</option><option value="top-right" data-i18n="topRight">Top right</option><option value="top-left" data-i18n="topLeft">Top left</option></select></label><button type="button" data-aas-hide data-i18n="hide">Hide widget (restore with Ctrl+U)</button></details>
      <details><summary data-i18n="about">About these controls</summary><p data-i18n="aboutText">Display preferences help you browse this site. They do not repair every accessibility issue. Read-aloud depends on available browser voices. Controls cannot change content inside other websites’ embedded frames.</p></details>
      <p class="aas-widget__status" role="status" aria-live="polite" data-aas-status></p>
    </div>
    <footer class="aas-widget__footer"><span data-i18n="preferences">Your preferences are saved on this browser.</span><strong>BIS <span>CONSULTANTS</span></strong></footer>
  </section>
</div>
			<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
