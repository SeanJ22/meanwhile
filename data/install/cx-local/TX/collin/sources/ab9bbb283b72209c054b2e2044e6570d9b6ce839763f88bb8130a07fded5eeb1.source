<style>
body {
	background: #fdfdfd linear-gradient(90deg, #fdfdfd, #fff) repeat-x;
	min-height: 100vh;
}
#airlock {
	background:#fff;
	min-height: 50vh;
}
.navbar.stick-top {
	background: rgba(249,249,249,.85);
}
::-webkit-input-placeholder { /* Chrome/Opera/Safari */
  /* color: #eee; */
  opacity: .85;
}
::-moz-placeholder { /* Firefox 19+ */
  /* color: #eee; */
  opacity: .85;
}
:-ms-input-placeholder { /* IE 10+ */
  /* color: #eee; */
  opacity: .85;
}
:-moz-placeholder { /* Firefox 18- */
  /* color: #eee; */
  opacity: .85;
}
img#logo {
	max-height: 25vh;
	width: auto;
	height: 10em;
	margin: auto;
}
textarea.form-control {
	height: 8em;
    min-height: 15vh;
    max-height: 75vh;
}
fieldset>fieldset {
	margin: inherit 2em;
}
.g-recaptcha>div {
	margin: auto;
}
.card.link, nav.navbar li.nav-item a.nav-link, progress {
    transition: .25s;
}

.card.link a:hover {
    text-decoration: none;
}
.card.link:hover {
	background: #efefef;
	cursor: pointer;
}
nav.navbar li.nav-item a.nav-link:not(.active):hover {
	background: #dedede;
}

nav.navbar li.nav-item a.nav-link.active, nav.navbar li.nav-item a.nav-link:hover {
    transform: scale(1.05,1.25);
}

.compressed-line {
	line-height: 1em;
}
label.required::after {
/*    font-weight: bold;
    content: " *";*/
	font-style: italic;
	content: " (required)";
	padding-left: .5em;
    color: #900;
	font-size: .8em;
}
tr.link {
	cursor: pointer;
}
div.ticket-message p {
	margin: 1em 0;
}
.requestpad {
    top: 2.5em;
}
/*.form-control {

}*/
input:focus, textarea:focus, select:focus {
	transition: .75s;
	transform: scale(1.0375);
}</style>
<!-- end Simple Custom CSS and JS -->
