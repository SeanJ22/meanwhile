<script nonce="JixJEIUkvF9BY5/T/5zSrw==">
    window.ccFooterModals = {"Copyright":{"title":"Copyright","html":"Copyright \u0026copy; \u003Ctime datetime=\u0022{{year}}\u0022\u003E{{year}}\u003C/time\u003E Collin County Texas \u0026middot; All Rights Reserved"},"Website Feedback":{"title":"Website Feedback","html":"\u003Cp\u003EIf you are looking for a specific Department or Official please visit our \u003Ca href=\u0022/Contact\u0022 data-sf-ec-immutable=\u0022\u0022\u003E\u003Cstrong\u003EContact Site\u003C/strong\u003E\u003C/a\u003E for the relevant Directories.\u003C/p\u003E\u003Cp\u003EFor inquiries into court or jury matters: \u003Ca href=\u0022/District-Clerk/jury-services\u0022 data-sf-ec-immutable=\u0022\u0022\u003E\u003Cstrong\u003EJury\r\n Duty\u003C/strong\u003E\u003C/a\u003E | \u003Ca href=\u0022/Courts/case-lookup-and-court-schedules\u0022 data-sf-ec-immutable=\u0022\u0022\u003E\u003Cstrong\u003ECourt\r\n Cases\u003C/strong\u003E\u003C/a\u003E\u003C/p\u003E\u003Cp\u003E\u0026nbsp;\u003C/p\u003E\u003Cdiv style=\u0022text-align:center;\u0022\u003E\u003Cp\u003EIf you find any broken links or features on the site, or if you are having difficulty with the site,\r\n        please continue:\u003C/p\u003E\u003Cdiv class=\u0022ccButton\u0022\u003E\u003Ca href=\u0022mailto:webfeedback@collincountytx.gov\u0022\u003ESubmit Feedback\u003C/a\u003E\u003C/div\u003E\u003Cp\u003EPlease Note: Solicitations will \u003Cstrong\u003ENOT\u003C/strong\u003E receive responses.\u003C/p\u003E\u003C/div\u003E"}};

    const norm = s => (s||'').replace(/\u00A0/g,' ').replace(/\s+/g,' ').trim().toLowerCase();

    document.addEventListener('click', function (e) {
      const a = e.target.closest('.js-footer-modal');
      if (!a) return;
      e.preventDefault();

      const keyRaw = a.getAttribute('data-modal-title') || a.textContent || '';
      const blk = window.ccFooterModals[keyRaw.trim()] || window.ccFooterModals[norm(keyRaw)];
      if (!blk) { console.warn('Footer modal block not found for:', keyRaw); return; }

      // TEMP: no automatic tags. Optional explicit override:
      const explicitTag = a.getAttribute('data-modal-tag'); // e.g., data-modal-tag="Website Feedback"
      const tags = explicitTag ? [explicitTag] : [];
      console.log('explicitTag =', explicitTag, ' blk.title =', blk?.title);

      new ccModal({
        title: blk.title || 'Info',
        body:  blk.html,
        tags: [explicitTag]
      });
    }, { passive:false });
</script>





