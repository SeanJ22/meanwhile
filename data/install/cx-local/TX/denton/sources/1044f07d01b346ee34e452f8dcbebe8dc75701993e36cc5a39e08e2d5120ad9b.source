tle:n,slug:l,path:V,isa_value:a,type:a,tag_type:a,external_uri:a,external_id:a,short_title:a},{spark_id:x,uuidv5:x,title:W,slug:X,path:Y,isa_value:a,type:a,tag_type:a,external_uri:a,external_id:a,short_title:a}],generated_tags:[],fn__legacy_type:C,article_type:a,fn__story_type:an,third_party_canonical_url:a,origination_station:"KDFW",original_post_canonical_url:a,word_count:1030,fn__additional_authors:[],shared_shows:[],vanity_urls:[],short_urls:[a],original_post:{original_post_id:a,original_post_uuidv5:a,original_post_share:a,original_external_post_type:a},urls:{url:ao,category:{slug:l,spark_id:O},slug:P,original_publisher:a,original_url:a,original_publish_date:a},id:Z,spark_id:Z,uuidv5:Z,fn__type:ap,last_modified_date:z,last_published_date:z,created_date:"2026-10-20T08:40:12-05:00",publication_date:aq,origination_modified_date:z,wp__origin:{source:t,site:s,environment:r,blog_id:j,post_id:1879524,post_type:"post",post_status:ar},post_status:ar,published:d,articleId:a,components:[{is:"fts-article-big-top",props:{featuredMedia:{url:"https:\u002F\u002Fimages.foxtv.com\u002Fstatic.fox4news.com\u002Fwww.fox4news.com\u002Fcontent\u002Fuploads\u002F2026\u002F02\u002F764\u002F432\u002Fdenton-where-to-vote.jpg?ve=1&tl=1",externalUrl:a,imageAlt:a,description:a,shortDescription:a,copyright:a,source:A,imgWidth:764,imgHeight:432}}},{is:"fts-article-summary",props:{title:"The Brief",alignment:A,group:[{content:{ordered:b,items:[{content:{title:"The Texas midterm election is on Tuesday, November 3, 2026."},content_type:f},{content:{title:"Polls in Dallas County will be open from 7 a.m. until 7 p.m."},content_type:f},{content:{title:"FOX 4 News will have live results available online and on TV after the polls close."},content_type:f}]},content_type:"list"}]}},{is:e,props:{text:"Tuesday is election day in Texas!"}},{is:e,props:{text:"Voting for the Nov. 3 General and Joint Election runs from 7 a.m. to 7 p.m."}},{is:e,props:{text:"Here&apos;s where to cast your ballot in Denton County, and other important things to know before you head to the polls.&#xA0;"}},{is:h,props:{level:i,content:"Where can I vote in Denton County?"}},{is:e,props:{text:"Denton County registered voters should vote at their specific precinct polling locations.&#xA0;"}},{is:e,props:{text:"To find a voting center that&apos;s near you, visit the&#xA0;\u003Ca href=\"https:\u002F\u002Fdentoncounty.maps.arcgis.com\u002Fapps\u002Finstant\u002Flookup\u002Findex.html?appid=f97faa23ea8f499683f20fe591642206\" target=\"_blank\" rel=\"noopener\"\u003EDenton County Voting Center Finder.\u003C\u002Fa\u003E All voting centers and their addresses are listed in the document below."}},{is:"fts-pdf",props:{url:"https:\u002F\u002Fstatic.fox4news.com\u002Fwww.fox4news.com\u002Fcontent\u002Fuploads\u002F2026\u002F10\u002F1126-unconsolidated-ed-locations-v2.pdf"}},{is:e,props:{text:"If you have questions about your ballot, voting locations, or anything else, ask your county election office.&#xA0;"}},{is:e,props:{text:"\u003Ca href=\"https:\u002F\u002Fwww.co.anderson.tx.us\u002Fpage\u002Fanderson.elections\" target=\"_blank\" rel=\"noopener\"\u003EAnderson County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.bosquecounty.gov\u002F194\u002FElections-Administrator\" target=\"_blank\" rel=\"noopener\"\u003EBosque County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.collincountytx.gov\u002Felections\u002F\" target=\"_blank\" rel=\"noopener\"\u003ECollin County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.co.cooke.tx.us\u002Fpage\u002Fcooke.elections\" target=\"_blank\" rel=\"noopener\"\u003ECooke County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.dallascountyvotes.org\u002F\" target=\"_blank\" rel=\"noopener\"\u003EDallas County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.deltacountytx.com\u002Felections\" target=\"_blank\" rel=\"noopener\"\u003EDelta County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.votedenton.com\u002F\" target=\"_blank\" rel=\"noopener\"\u003EDenton County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fco.ellis.tx.us\u002Findex.asp?nid=312\" target=\"_blank\" rel=\"noopener\"\u003EEllis County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.co.erath.tx.us\u002F186\u002FCurrent-Elections\" target=\"_blank\" rel=\"noopener\"\u003EErath County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.co.fannin.tx.us\u002Fdefault.aspx?Fannin_County\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003EFannin County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.co.freestone.tx.us\u002Fdefault.aspx?Freestone_County\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003EFreestone County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.henderson-county.com\u002Fdepartments\u002Felections-voter-registration\" target=\"_blank\" rel=\"noopener\"\u003EHenderson County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.co.hill.tx.us\u002Fpage\u002Fhill.Elections\" target=\"_blank\" rel=\"noopener\"\u003EHill County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fhoodcounty.texas.gov\u002Fdepartments\u002Felections_administration\u002Findex.php\" target=\"_blank\" rel=\"noopener\"\u003EHood County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.hopkinscountytx.org\u002Fdefault.aspx?Hopkins_County\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003EHopkins County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.huntcounty.net\u002Fpage\u002Fhunt.election\" target=\"_blank\" rel=\"noopener\"\u003EHunt County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.jackcounty.texas.gov\u002Felections-administrator\" target=\"_blank\" rel=\"noopener\"\u003EJack County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.johnsoncountytx.org\u002Fdepartments\u002Felections-office\" target=\"_blank\" rel=\"noopener\"\u003EJohnson County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.kaufmancounty.net\u002F237\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003EKaufman County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.lamarcountytx.gov\u002F1206\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003ELamar County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.co.navarro.tx.us\u002Fpage\u002Fnavarro.Elections\" target=\"_blank\" rel=\"noopener\"\u003ENavarro County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.co.palo-pinto.tx.us\u002Fpage\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003EPalo Pinto County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.parkercountytx.com\u002Findex.aspx?NID=118\" target=\"_blank\" rel=\"noopener\"\u003EParker County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.co.rains.tx.us\u002Fdefault.aspx?Rains_County\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003ERains County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.co.red-river.tx.us\u002Fpage\u002Fredriver.ElectionsCountyClerk\" target=\"_blank\" rel=\"noopener\"\u003ERed River County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.rockwallcountytexas.com\u002Findex.aspx?nid=232\" target=\"_blank\" rel=\"noopener\"\u003ERockwall County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.somervell.co\u002F160\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003ESomervell County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"http:\u002F\u002Fwww.tarrantcounty.com\u002Fen\u002Felections.html\" target=\"_blank\" rel=\"noopener\"\u003ETarrant County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.vanzandtcounty.org\u002Fpage\u002Fvanzandt.Elections\" target=\"_blank\" rel=\"noopener\"\u003EVan Zandt County\u003C\u002Fa\u003E&#xA0;|&#xA0;\u003Ca href=\"https:\u002F\u002Fco.wise.tx.us\u002F315\u002FElections\" target=\"_blank\" rel=\"noopener\"\u003EWise County\u003C\u002Fa\u003E"}},{is:e,props:{text:"If you have more questions about the voting process, you can find more information \u003Ca href=\"https:\u002F\u002Fwww.votetexas.gov\u002Ffaq\u002Findex.html\" target=\"_blank\" rel=\"noopener\"\u003Ehere\u003C\u002Fa\u003E.&#xA0;"}},{is:h,props:{level:i,content:"How long is the wait to vote in Denton County?"}},{is:e,props:{text:"Denton County does not post its wait times online."}},{is:h,props:{level:i,content:"What's on the ballot?"}},{is:e,props:{text:"The state&apos;s most high profile race involves \u003Ca href=\"https:\u002F\u002Fwww.kenpaxton.com\u002F\" target=\"_blank\" rel=\"noopener\"\u003EKen Paxton\u003C\u002Fa\u003E (R) and \u003Ca href=\"https:\u002F\u002Fjamestalarico.com\u002F\" target=\"_blank\" rel=\"noopener\"\u003EJames Talarico\u003C\u002Fa\u003E (D), who are vying for a spot in the U.S. Senate. Paxton, who has served as Texas Attorney General since 2014, unseated sitting Sen. John Cornyn in the Republican primary. Talarico, a former middle school teacher and Presbyterian seminarian, has served in the Texas House since 2018, and defeated U.S. Rep. Jasmine Crockett in the Democratic primary."}},{is:_,props:{items:[{content:{title:"\u003Ca href=\"https:\u002F\u002Fwww.dallascountyvotes.org\u002Fwp-content\u002Fuploads\u002F2026\u002F09\u002FFull-Sample-Ballot-Watermark-8.5x14-Legal_110326.pdf\" target=\"_blank\" rel=\"noopener\"\u003EDallas County sample ballots \u003C\u002Fa\u003E"},content_type:f},{content:{title:"\u003Ca href=\"https:\u002F\u002Fgisit.tarrantcounty.com\u002Ffindmyballot\" target=\"_blank\" rel=\"noopener\"\u003ETarrant County sample ballots\u003C\u002Fa\u003E"},content_type:f},{content:{title:"\u003Ca href=\"https:\u002F\u002Fwww.collincountytx.gov\u002Felections\u002Fsample-ballots?electionID=75\" target=\"_blank\" rel=\"noopener\"\u003ECollin County sample ballots\u003C\u002Fa\u003E"},content_type:f},{content:{title:"\u003Ca href=\"https:\u002F\u002Fwww.votedenton.gov\u002Fvoter-information\u002Fvoter-lookup\u002F#VoterEligibilitySearch\" target=\"_blank\" rel=\"noopener\"\u003EDenton County sample ballots\u003C\u002Fa\u003E"},content_type:f}]}},{is:e,props:{text:"The&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.fox4news.com\u002Felection\"\u003EFOX 4 Elections\u003C\u002Fa\u003E&#xA0;page also has breakdowns of some of the hot ticket items Texans are voting on during this election."}},{is:h,props:{level:i,content:"Am I registered to vote?"}},{is:e,props:{text:"The easiest way to check your voter registration status is to head to the \u003Ca href=\"https:\u002F\u002Fgoelect.txelections.civixapps.com\u002Fivis-mvp-ui\u002F#\u002Flogin\" target=\"_blank\" rel=\"noopener\"\u003ESecretary of State&apos;s\u003C\u002Fa\u003E website. The \u003Ca href=\"https:\u002F\u002Fgoelect.txelections.civixapps.com\u002Fivis-mvp-ui\u002F#\u002Flogin\" target=\"_blank\" rel=\"noopener\"\u003EAm I Registered\u003C\u002Fa\u003E portal on the website lets you submit your identifying information, like a Texas Driver&apos;s License number or details about your birth. You will find out instantly if you&apos;re registered to vote. The portal will also give your poll locations.&#xA0;"}},{is:"fts-related-article",props:{articleUrl:"https:\u002F\u002Ffox4news.com\u002Felection\u002F2026-midterm-election-key-races-north-texas-sample-ballots",title:"2026 Midterm Election: Key races in North Texas and sample ballots",dek:"Before you head to the polls for the Texas midterms, you can see your sample ballot to find out what you will be voting on.",newWindow:d,thumbnail:"https:\u002F\u002Fimages.foxtv.com\u002Fstatic.fox4news.com\u002Fwww.fox4news.com\u002Fcontent\u002Fuploads\u002F2020\u002F08\u002F932\u002F470\u002Fballot-GETTY.jpg?ve=1&tl=1",type:"related",placeholder:"https:\u002F\u002Fimages.foxtv.com\u002Fstatic.fox4news.com\u002Fwww.fox4news.com\u002Fcontent\u002Fuploads\u002F2020\u002F08\u002F0\u002F100\u002Fballot-GETTY.jpg?ve=1&tl=1"}},{is:h,props:{level:i,content:"When are polls open on election day?"}},{is:e,props:{text:"The polls in Denton County are open from 7 a.m. on the date of the election until 7 p.m. Anyone in line at the time the polls close will be allowed to cast their ballot.&#xA0;"}},{is:h,props:{level:i,content:"Do I need an ID to vote in Texas?"}},{is:e,props:{text:"In order to vote in person on election day, Texas voters will be asked to present an acceptable form of photo ID. Here is list of the acceptable forms of photo ID:"}},{is:_,props:{items:[{content:{title:"Texas Driver's License issued by the Texas Department of Public Safety (DPS)"},content_type:f},{content:{title:"Texas personal ID card issued by DPS"},content_type:f},{content:{title:"License to carry a handgun issued by DPS"},content_type:f},{content:{title:"Texas election ID card issued by DPS"},content_type:f},{content:{title:"United States passport (book or card)"},content_type:f},{content:{title:"United States military ID card with photo"},content_type:f},{content:{title:"US Certificate of Citizenship or Naturalization with photo"},content_type:f}]}},{is:e,props:{text:"Here is a list of the supporting forms of ID that can be presented if the voter does not possess an acceptable form of photo identification and cannot reasonably obtain one:&#xA0;"}},{is:_,props:{items:[{content:{title:"Copy or original of a government document that shows the voter’s name and address, including the voter’s voter registration certificate"},content_type:f},{content:{title:"Copy of or original current utility bill"},content_type:f},{content:{title:"Copy of or original bank statement"},content_type:f},{content:{title:"Copy of or original government check"},content_type:f},{content:{title:"Copy of or original paycheck"},content_type:f},{content:{title:"Copy of or original of (a) a certified domestic (from a U.S. state or territory) birth certificate or (b) a document confirming birth admissible in a court of law which establishes the voter’s identity (which may include a foreign birth document)"},content_type:f}]}},{is:e,props:{text:"For more information on acceptable forms of ID and what you can do if you do not have one,&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.dallascountyvotes.org\u002Fwp-content\u002Fuploads\u002F2026\u002F01\u002F2026-Acceptable-Forms-of-Photo-Identification-ENG.pdf\"\u003E\u003Cu\u003Eclick here.\u003C\u002Fu\u003E\u003C\u002Fa\u003E"}},{is:h,props:{level:i,content:"Can you vote with an expired ID?"}},{is:e,props:{text:"If you have a form of acceptable photo ID and are between the ages of 18 and 69, your ID must be current or expired for no more than 4 years to qualify to vote. For voters 70 and older, your photo ID can be expired for any length of time if the identification is otherwise okay."}},{is:h,props:{level:i,content:"\u003Cstrong\u003ECan I bring my sample ballot or notes?\u003C\u002Fstrong\u003E"}},{is:e,props:{text:"According to the&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.usa.gov\u002Fwho-you-can-vote-for\" target=\"_blank\" rel=\"noopener\"\u003EU.S. government\u003C\u002Fa\u003E, you can bring notes or a sample ballot with you to the polls. In \u003Ca href=\"https:\u002F\u002Fwww.votetexas.gov\u002Fvoting\u002Fallowed-at-the-polling-place.html\" target=\"_blank\" rel=\"noopener\"\u003ETexas\u003C\u002Fa\u003E, polling locations restrict cell phone use.&#xA0;"}},{is:h,props:{level:i,content:"Can I bring a gun?"}},{is:e,props:{text:"No. Only peace officers - on our off duty - can take a handgun into a polling location.&#xA0;"}},{is:h,props:{level:i,content:"\u003Cstrong\u003ECan I take my phone to vote?\u003C\u002Fstrong\u003E"}},{is:e,props:{text:"Yes, and no. You cannot use your cell phone, camera, tablet, laptop, sound recorder or any other kind of recording device in the room where voting is happening. You can use electronic devices outside the room, as long as you are not using them to record sound or images. No recording is allowed within 100 feet of a voting station."}},{is:h,props:{level:i,content:"\u003Cstrong\u003ECan I wear political clothing?\u003C\u002Fstrong\u003E"}},{is:e,props:{text:"No. No one is allowed to wear clothing or any similar items related to a candidate, measure, or political party, even if they are not on the ballot. This is enforceable within 100 feet of a polling station. You will be asked to remove or cover up the clothing before entering the building."}},{is:h,props:{level:i,content:"\u003Cstrong\u003ECan I bring my child?\u003C\u002Fstrong\u003E"}},{is:e,props:{text:"Yes, according to&#xA0;\u003Ca href=\"https:\u002F\u002Fstatutes.capitol.texas.gov\u002Fdocs\u002Fel\u002Fhtm\u002Fel.61.htm\" target=\"_blank\" rel=\"noopener\"\u003ETexas Election Code\u003C\u002Fa\u003E, a child under 18 years old can accompany a parent who is voting."}},{is:h,props:{level:i,content:"\u003Cstrong\u003EHow to report voting issues\u003C\u002Fstrong\u003E"}},{is:e,props:{text:"If you have problems or questions, you can call the Secretary of State&#x2019;s toll-free election hotline at 1-800-252-VOTE (8683) or email&#xA0;\u003Ca href=\"mailto:elections@sos.texas.gov\"\u003E\u003Cu\u003Eelections@sos.texas.gov\u003C\u002Fu\u003E\u003C\u002Fa\u003E.&#xA0;To file a formal complaint,&#xA0;\u003Ca href=\"https:\u002F\u002Fwww.sos.state.tx.us\u002Felections\u002Fforms\u002Fpol-sub\u002F25-4f.pdf\"\u003E\u003Cu\u003Edownload the complaint form here\u003C\u002Fu\u003E\u003C\u002Fa\u003E. It can be submitted by mail, fax, or email."}},{is:"fts-group-source",props:{title:"The Source",text:"\u003Cp\u003EInformation in this article comes from the Denton County Elections website and Texas Secretary of State's Office.\u003C\u002Fp\u003E"}}],title:g,canonical_url:ao,article_slug:P,vanity_slugs:[],presentation_type:C,fn__syndication_info:[],fn__stock_ticker_symbols:a,post_version:2097152,component_type:"news_article",content_type:"spark_post",fn__site_search:b,stocks:[],video_spark_ids:[],meta:{chartbeat:{title:g,viewID:"\u002Felection\u002Fdenton-county-voting-locations-wait-times-sample-ballots",section:l,authors:[K]},segment:{title:g,page_content_type:ap,page_content_type_of_story:an}},isAMP:b,isPreview:b,overlayType:C,header:{headline:g,authors:[{name:K,url:"https:\u002F\u002Ffox4news.com\u002Fperson\u002Fm\u002Fgrace-marocco"}],lastModifiedDate:z,publicationDate:aq,lastPublishedDate:z,primaryTag:{name:y,url:"\u002Ftag\u002Felections-2026"},category:{name:n,url:$},organizationName:al,organizationUrl:am,pill:a},headlines:{socialMedia:g,socialDescription:a,section:g,appleNews:g,FBIA:g,app:g,exportHeadline:g}}},showHPAnywhere:b},Auth:{isLoggedIn:c},Category:{fullCategory:{},currentPage:j,numPages:o,isFetching:b,category:c},Device:{device:{isSafari:b,isFirefox:d,isMobile:b,isFirefoxOrSafari:d,isFacebookInAppBrowser:b,isFacebookIOS:b,UA:"mozilla\u002F5.0 (windows nt 10.0; win64; x64; trendictionbot0.5.0; trendiction search; http:\u002F\u002Fwww.trendiction.de\u002Fbot; please let us know of any problems; web at trendiction.com) gecko\u002F20100101 firefox\u002F125.0",referrer:"https:\u002F\u002Fbit.ly\u002F3UBCIWC"}},DynamicContent:{contentType:a},Env:{playerConfig:{livestream:{accessKey:as,appKey:at,mcp:au,videoId:"adstNBnkMBmyv13W",token:"1Bc5FefozIZgh4xy2nfZMbEtTgGGb8GfBmk95ZLW88w~Mn4wfg",fallBackTitle:"Live from FOX",fallBackDescription:"Dallas"},adTagUrl:{VOD:"https:\u002F\u002Fpubads.g.doubleclick.net\u002Fgampad\u002Fads?iu=\u002F63790564\u002Fkdfw_fox4&description_url=[placeholder]&env=vp&impl=s&correlator=&tfcd=0&npa=0&gdfp_req=1&output=vast&sz=1001x1001&unviewed_position_start=1",livestream:"https:\u002F\u002Fpubads.g.doubleclick.net\u002Fgampad\u002Flive\u002Fads?iu=\u002F63790564\u002Fkdfw_fox4&description_url=[placeholder]&env=vp&impl=s&correlator=&tfcd=0&npa=0&gdfp_req=1&output=vast&sz=1001x1001&unviewed_position_start=1"},playerAnalytics:{primary_