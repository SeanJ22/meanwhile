=1, https://images.foxtv.com/static.fox4news.com/www.fox4news.com/content/uploads/2023/06/0/0/FOX_Local_Station_Website_Graphics_300x250-Skyline-LEARN_MORE-DALLAS.png?ve=1&amp;tl=1 2x" data-v-5380752d></picture></noscript></div></a></div></div></section> <div class="promo-separator" data-v-080279c0></div></div><section class="collection collection-trending" data-v-13185694><header class="heading" data-v-13185694><h3 class="title" data-v-13185694>Trending Now</h3></header> <div class="content article-list" data-v-13185694><article class="article story-1" data-v-13185694><!----> <div class="m"><a href="/news/att-2024-data-breach-settlement-payout-details"><div class="responsive-image__container" data-v-5380752d><div class="responsive-image__lazy-container" style="aspect-ratio:100 / 56;width:100%;max-width:100px;margin-left:auto;margin-right:auto;background-image:url('https://images.foxtv.com/static.fox4news.com/www.fox4news.com/content/uploads/2020/03/0/100/AT_AMP_T_1489025080464_2860412_ver1.0.gif?ve=1&amp;tl=1');" data-v-5380752d><img alt="Millions of AT&amp;T customers to receive payouts following approval of $177 million settlement" src="https://images.foxtv.com/static.fox4news.com/www.fox4news.com/content/uploads/2020/03/0/100/AT_AMP_T_1489025080464_2860412_ver1.0.gif?ve=1&amp;tl=1" width="100" height="56" loading="lazy" fetchpriority="auto" data-src="https://static.fox4news.com/www.fox4news.com/content/uploads/2020/03/AT_AMP_T_1489025080464_2860412_ver1.0.gif" data-srcset="https://static.fox4news.com/www.fox4news.com/content/uploads/2020/03/AT_AMP_T_1489025080464_2860412_ver1.0.gif" style="background:rgba(0,0,0,0);display:block;width:100%;height:100%;object-fit:cover;" data-v-5380752d></div> <noscript data-v-5380752d><picture class="responsive-image__picture" data-v-5380752d><source media="(min-width: 320px)" srcset="https://images.foxtv.com/static.fox4news.com/www.fox4news.com/content/uploads/2020/03/0/100/AT_AMP_T_1489025080464_2860412_ver1.0.gif?ve=1&amp;tl=1