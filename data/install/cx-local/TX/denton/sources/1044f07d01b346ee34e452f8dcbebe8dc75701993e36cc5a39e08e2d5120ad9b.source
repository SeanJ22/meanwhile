    }
    return hex.slice(0, 8) + '-' +
      hex.slice(8, 12) + '-' +
      hex.slice(12, 16) + '-' +
      hex.slice(16, 20) + '-' +
      hex.slice(20, 32)
  }

  function generate() {
    var cryptoObject = root.crypto
    var nativeRandomUuid = cryptoObject && cryptoObject.randomUUID
    if (
      typeof nativeRandomUuid === 'function' &&
      nativeRandomUuid[POLYFILL_MARKER] !== true
    ) {
      return nativeRandomUuid.call(cryptoObject)
    }

    var bytes = getByteArray()
    if (!fillSecureBytes(bytes)) {
      fillInsecureBytes(bytes)
    }

    // RFC 4122 / UUID v4 version and variant bits.
    bytes[6] = (bytes[6] & 0x0f) | 0x40
    bytes[8] = (bytes[8] & 0x3f) | 0x80
    return formatUuid(bytes)
  }

  if (!install) {
    return generate()
  }

  if (!root.crypto) {
    try {
      root.crypto = root.msCrypto || {}
    } catch (error) {
