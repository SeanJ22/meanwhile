  }
  return polyfill
})(window,{allowInsecureFallback:true},true);</script><script data-n-head="true" type="text/javascript" data-hid="pal-script" src="//imasdk.googleapis.com/pal/sdkloader/pal.js" async="true"></script><script data-n-head="true" type="text/javascript" src="https://foxkit.fox.com/sdk/profile/v2.15.0/profile.js" async="false" defer="true"></script><script data-n-head="true" src="https://c.amazon-adsystem.com/aax2/apstag.js" async="true" defer="true"></script><script data-n-head="true" src="https://www.googletagmanager.com/gtag/js?id=UA-3002563-5" async="true"></script><script data-n-head="true" src="/taboola/taboola.js" type="text/javascript" async="true" defer="true"></script><script src="https://scripts.webcontentassessor.com/scripts/da65a5280da0626cff9c89b3c0bdd667f7225a218ea3cbe703e5f68fb81ed9fa" data-hid="webcontentassessor-script"></script><script src="//static.foxtv.com/static/orion/scripts/core/ag.core.js" data-hid="orion-ag-core-script"></script><script src="//static.foxtv.com/static/isa/core.js" data-hid="isa-core-script"></script><script src="//static.foxtv.com/static/orion/scripts/station/default/loader.js" data-hid="orion-station-loader-script"></script><script src="https://widgets.media.weather.com/wxwidget.loader.js?cid=996314550" defer="" data-hid="weather-widget-loader-script"></script><script src="https://prod.player.fox.digitalvideoplatform.com/wpf/v3/3.5.1/wpf_player.js" crossorigin="anonymous" data-hid="fox-player-main-script"></script><script src="//static.foxtv.com/static/leap/loader.js" data-hid="leap-loader-script"></script><script data-n-head="true" >(function () {
