<script>
document.addEventListener("DOMContentLoaded", function() {

  function setupSearch(formId, inputId) {
    const form = document.getElementById(formId);
    const input = document.getElementById(inputId);
    
    if (!form || !input) return; // safety check
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const query = input.value.trim();
      if (!query) {
        return;
      }
      try {
        const baseUrl = "/search/";
        const searchUrl = `${baseUrl}?searchstax[query]=${encodeURIComponent(query)}`;
        window.location.href = searchUrl;
      } catch (err) {
        console.error("Search redirect failed:", err);
      }
    });
  }
  // Initialize both forms
  setupSearch("site-search-form", "site-search-input");
});
</script>
		
