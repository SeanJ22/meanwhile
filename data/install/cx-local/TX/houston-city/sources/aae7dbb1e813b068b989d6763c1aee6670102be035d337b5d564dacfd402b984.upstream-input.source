        {
          "contestId": "tx-cx-2026-leander-isd-proposition-a",
          "whatItDoes": "Ratifies the school district’s current-year property-tax rate of $1.1169 per $100 of property valuation. The official question identifies a tax increase and estimates maintenance-and-operations tax revenue will rise 3.72% ($12,066,324) from the preceding year.",
          "yesMeans": "Approve the stated property-tax rate.",
          "noMeans": "Do not ratify the proposed rate through this question.",
          "parts": [],
          "sourceUrl": "https://votetravis.gov/wp-content/uploads/G26-Bedsheet-Ballot-Corrected-Final2.pdf",
