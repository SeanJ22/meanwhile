          "sourceHashKind": "HELD_TEXT",
          "writtenAt": "2026-11-03T04:47:03.882450+00:00",
          "citation": "measure-source"
        },
        {
          "contestId": "tx-cx-2026-round-rock-isd-proposition-a",
          "whatItDoes": "Ratifies the school district’s current-year property-tax rate of $0.9484 per $100 of property valuation. The official question identifies a tax increase and estimates maintenance-and-operations tax revenue will rise 3.09% ($12,313,099) from the preceding year.",
          "yesMeans": "Approve the stated property-tax rate.",
          "noMeans": "Do not ratify the proposed rate through this question.",
          "parts": [],
          "sourceUrl": "https://votetravis.gov/wp-content/uploads/G26-Bedsheet-Ballot-Corrected-Final2.pdf",
          "sourceHash": "1c9c7082ec737b7a25f04809ab964de296fa84b7b02afbfaa9403808cb88ba64",
          "sourceHashKind": "HELD_TEXT",
          "writtenAt": "2026-11-03T04:47:03.882450+00:00",
          "citation": "measure-source"
        },
        {
          "contestId": "tx-cx-2026-manor-isd-proposition-a",
          "whatItDoes": "Authorizes $391.5 million in bonds for school facilities, including campus renovations and districtwide safety and security upgrades, and buses. It also authorizes property taxes sufficient to repay principal and interest; the official question labels this a property-tax increase.",
          "yesMeans": "Approve the bond issue and taxes for repayment.",
          "noMeans": "Do not authorize this bond issue through this question.",
          "parts": [],
          "sourceUrl": "https://votetravis.gov/wp-content/uploads/G26-Bedsheet-Ballot-Corrected-Final2.pdf",
          "sourceHash": "98ab414154d9028fef1f3c70ebf1ea5b41c90654d7e2e1edc751ad4731724b1d",
          "sourceHashKind": "HELD_TEXT",
          "writtenAt": "2026-11-03T04:47:03.882450+00:00",
          "citation": "measure-source"
        },
        {
          "contestId": "tx-cx-2026-manor-isd-proposition-b",
          "whatItDoes": "Authorizes $8.5 million in bonds for school technology improvements. It also authorizes property taxes sufficient to repay principal and interest; the official question labels this a property-tax increase.",
          "yesMeans": "Approve the bond issue and taxes for repayment.",
          "noMeans": "Do not authorize this bond issue through this question.",
