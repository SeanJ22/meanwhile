    jQuery(".bars").click(function(){
        $(".off-canvas-wrap").toggleClass("move-left");
        $(".right-off-canvas-menu").toggleClass('active');
        $("body").toggleClass("noscroll");
        $("html").toggleClass("noscroll");
        $(".exit-off-canvas").show();
    });
    jQuery(".exit-off-canvas").click(function(){
        $(".off-canvas-wrap").toggleClass("move-left");
        $(".right-off-canvas-menu").toggleClass('active');
        $("body").toggleClass("noscroll");
        $("html").toggleClass("noscroll");
        $(this).hide();
    });
jQuery("a[href^='#']").click(function(){var     r=jQuery(this).attr("href");jQuery(r).attr("tabindex",-1).on("blur focusout",function(){$(this).removeAttr("tabindex")}).focus()});var hasAccordions=jQuery(".accordion").length;hasAccordions||jQuery("#ensure-accessibility").remove();
