		(function () {
			function setupMenu() {
				const menuID = 'mainNavMenu';
				const menuType = MAIN_MENU;

				//setup menu manager properties for main menu
				if (!menuManager.mobileMainNav && true)
					menuManager.adjustMainItemsWidth('#' + menuID);
