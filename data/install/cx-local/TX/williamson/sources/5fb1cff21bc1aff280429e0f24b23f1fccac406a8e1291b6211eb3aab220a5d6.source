				</div>
					<ol class="tabbedWidgetNarrow cpTabs  accordion"  aria-hidden="False.ToString().ToLowerInvariant()" >
						<li class="" role="presentation">	<a href="#tab6b77653a-312c-4b71-b654-3e3eac8532e2_6" class="tabButton" id="tabBtnNarrow6b77653a-312c-4b71-b654-3e3eac8532e2_6" role="button" aria-controls="tab6b77653a-312c-4b71-b654-3e3eac8532e2_6" aria-expanded="false" ><span class="tabName editable" data-sequence="6" data-tabname="Courtroom Dress and conduct" contenteditable="false">Courtroom Dress and conduct</span></a>
</li>
					</ol>
				<div class="tabbedWidget cpTabPanel " style="display: none;" id="tab6b77653a-312c-4b71-b654-3e3eac8532e2_6" role="region" aria-labelledby="tabBtn6b77653a-312c-4b71-b654-3e3eac8532e2_6" >

<div class="widget editor pageStyles narrow" id="divEditor9951e584-fcfb-49fb-ad68-97696bf7755f" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <h3 class="subhead2" aria-level="2" id="isPasted" role="heading">Dress Guidelines</h3><p><em>Appropriate attire is mandatory for any appearance in court, whether as a participant, witness, or observer. &nbsp;As a general rule, you should think of the courtroom as a formal environment, and you should dress as you would if you were going to an important job interview. &nbsp;</em></p><ul><li>Men: &nbsp;long pants (if your pants have belt loops, wear a belt); shirt (tucked in); shoes with socks</li><li>Women: &nbsp;dress, skirt, or long pants; blouse, sweater; casual dress shirt; shoes</li></ul><p aria-hidden="true" tabindex="-1" aria-level="2">The following is not allowed:</p><table style="width: 100%;"><tbody><tr><td style="width: 33.3333%;">Shorts</td><td style="width: 33.3333%;">Hats (unless for religious purposes)</td><td style="width: 33.3333%;">Halter top, tube top</td></tr><tr><td style="width: 33.3333%;">T-shirt/muscle shirt</td><td style="width: 33.3333%;">See-through top</td><td style="width: 33.3333%;">Flip flops</td></tr><tr><td style="width: 33.3333%;">Clothing that exposes midriff or underwear</td><td style="width: 33.3333%;">Ripped/torn clothing</td><td style="width: 33.3333%;">Pants that fall below the waist</td></tr><tr><td style="width: 33.3333%;">Clothing that promotes illegal activity, violence</td><td style="width: 33.3333%;">Sunglasses</td><td style="width: 33.3333%;"><br></td></tr></tbody></table><p><br></p><h3 class="subhead2" aria-hidden="true" tabindex="-1" aria-level="2" role="heading">Decorum and Conduct</h3><ol><li style="box-sizing: border-box; margin-bottom: 0.35em; border: 0px none; font-style: normal; font-weight: 400;">Do not approach the bench without permission.</li><li>When given permission, stand in the area designated by the Bailiff.</li><li>Cell phones must be turned off or placed on silent and may not be used in the courtroom.</li><li>Food or drink is not allowed in the courtroom.</li><li>If you are waiting in the courtroom, please keep conversation to a minimum. &nbsp;If you disturb the court or participants, you may be asked to leave.</li></ol>
    </div>

<script type="text/javascript">
	$(document).ready(function (e) {		
	    renderSlideshowIfApplicable($('#divEditor' + '9951e584-fcfb-49fb-ad68-97696bf7755f'));
	});
</script>
</div>

				</div>
					</div>
	</div>
	<script type="text/javascript">

		//If responsive not enabled, execute this after a timeout
		if(!isResponsiveEnabled)
		{
			window.setTimeout(function(){
				var tabbedWidgetID = 'divTabbed6b77653a-312c-4b71-b654-3e3eac8532e2';
				typeof setTabbedWidgetsTabHeight === "function" && setTabbedWidgetsTabHeight(tabbedWidgetID);
			}, 1500);
		}

		function reinitCarousels() {
			if (window.carouselsToInit) {
				for (var i = 0; i < window.carouselsToInit.length; i++) {
					carouselsToInit[i]();
				}
			}
		}
		function sizeTabbedContent(element){
			if(window.Pages){
				if(window.Pages.onResizeHandlers){
					var setTabbedInterval = setInterval(function () {
						window.Pages.onResizeHandlers.forEach(function(car){car();});
					}, 25)


					setTimeout(function () {
						clearInterval(setTabbedInterval);
						if ($.cookie("enableLiveEdit") === "true") {
							setInterval(function () {
								window.Pages.onResizeHandlers.forEach(function(car){car();});
							}, 2000);
						}
					}, 2500);
					element.onclick="window.setTimeout(function(){reinitCarousels();},2);"
				}
			}
		}

		function adjustTab(e) {
			e.preventDefault();
			window.setTimeout(function(){
				reinitCarousels();
			}, 2);
			sizeTabbedContent(this);
		}

		var tabButtons = document.querySelectorAll("#divTabbed6b77653a-312c-4b71-b654-3e3eac8532e2 .tabButton");

		tabButtons.forEach(function (tabButton) {
			tabButton.addEventListener("click", adjustTab);
		});

	</script>



