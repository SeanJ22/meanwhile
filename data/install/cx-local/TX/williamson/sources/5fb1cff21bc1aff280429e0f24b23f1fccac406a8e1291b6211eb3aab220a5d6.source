	</div> <!-- inner row -->

			</div><!-- outer column --><!--		--></div> <!-- outer row -->
		<div class="row outer wide"><!--
--><div class="outer col col24 first last" style="" data-widgetcontainerid="143600eb-1cf1-4be6-a963-3957d3c1f447">				
	<div class="row nest first last wide">
	
	<div class="inner col col24 first last id065ea6c2-baa0-4b05-b5bb-2f784d1ad961" style="" data-widgetcontainerid="065ea6c2-baa0-4b05-b5bb-2f784d1ad961">	
<div class="widget editor pageStyles narrow" id="divEditorf7ef495f-acd3-4822-b1fa-a6c94ad0f3d2" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <h2 class="subhead1" id="Directory">Directory</h2><p style="text-align: left;"><em>Represented parties (parties with a lawyer) should <strong>not</strong> attempt to contact the Court, except through their attorney.</em></p><table style="width: 100%; height: 567px;"><tbody><tr><td style="width: 50.0000%;"><h3 aria-hidden="false" tabindex="-1" aria-level="2"><a href="https://www.wilcotx.gov/455/26th-District-Court">26th District Court</a><br>Judge Donna King</h3><p>The 26th District Court hears civil and criminal cases and presides over the Felony Mental Health Docket.</p></td><td style="width: 50.0000%;"><h3 aria-hidden="false" tabindex="-1" aria-level="2"><a href="https://www.wilcotx.gov/466/277th-District-Court">277th District Court</a><br>Judge Stacey Mathews</h3><p>The 277th District Court hears criminal and juvenile cases and presides over the Transformative Justice Program.</p></td></tr><tr><td style="width: 50.0000%;"><h3 aria-hidden="false" tabindex="-1" aria-level="2"><a href="https://www.wilcotx.gov/487/368th-District-Court">368th District Court</a><br>Judge Sarah Bruchmiller</h3><p>The 368th District Court hears civil and criminal cases and presides over the Felony DWI Court Program.</p></td><td style="width: 50.0000%;"><h3 aria-level="2"><a href="https://www.wilcotx.gov/500/395th-District-Court">395th District Court</a><br>Judge Ryan Larson</h3><p>The 395th District Court hears civil, child welfare (CPS), and family cases and presides over the Family Recovery Court (FRC) program.</p></td></tr><tr style="height: 75px;"><td style="width: 50.0000%;"><h3 aria-hidden="false" tabindex="-1" aria-level="2"><a href="https://www.wilcotx.gov/517/425th-District-Court">425th District Court</a><br>Judge Jason Bramow</h3><p>The 425th District Court hears civil, child welfare (CPS), and family cases.</p></td><td style="width: 50.0000%;"><h3 aria-hidden="false" tabindex="-1" aria-level="2"><a href="https://www.wilcotx.gov/537/480th-District-Court">480th District Court</a><br>Judge Terence M. Davis</h3>The 480th District Court hears civil, child welfare (CPS), and family cases.</td></tr><tr><td style="width: 50.0000%;"><h3 aria-hidden="false" tabindex="-1" aria-level="2"><a href="https://www.wilcotx.gov/1821/512th-District-Court" target="_blank" rel="noopener" aria-describedby="audioeye_new_window_message">512th District Court</a><br>Judge Sarah Moore</h3><p>The 512th District Court hears civil and criminal cases.</p><br></td><td style="width: 50.0000%;"><br></td></tr><tr><td style="width: 99.8519%;" colspan="2"><h3 aria-hidden="false" tabindex="-1"><a href="https://www.wilcotx.gov/1167/District-Court-Administration">District Court Administration</a><br>(DCA)</h3><p>DCA is an administrative office that provides operational, technical, and administrative support to the courts. Staff manage various programs on behalf of the District Court judiciary with the goal of ensuring efficient, effective access to justice in Williamson County.</p></td></tr></tbody></table><h2 class="subhead1" aria-hidden="false" tabindex="-1" aria-level="2">Visiting the District Courts</h2>
    </div>

