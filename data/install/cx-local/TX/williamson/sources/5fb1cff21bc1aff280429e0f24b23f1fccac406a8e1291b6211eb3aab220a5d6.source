						<li class="" role="presentation">	<a href="#tab6b77653a-312c-4b71-b654-3e3eac8532e2_5" class="tabButton" id="tabBtnNarrow6b77653a-312c-4b71-b654-3e3eac8532e2_5" role="button" aria-controls="tab6b77653a-312c-4b71-b654-3e3eac8532e2_5" aria-expanded="false" ><span class="tabName editable" data-sequence="5" data-tabname="Recording Devices" contenteditable="false">Recording Devices</span></a>
</li>
					</ol>
				<div class="tabbedWidget cpTabPanel " style="display: none;" id="tab6b77653a-312c-4b71-b654-3e3eac8532e2_5" role="region" aria-labelledby="tabBtn6b77653a-312c-4b71-b654-3e3eac8532e2_5" >

<div class="widget editor pageStyles narrow" id="divEditor5713190d-1d90-435c-aadf-aaa6d1f57cc7" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <p>Recording court proceedings is prohibited by law.</p>
    </div>

<script type="text/javascript">
	$(document).ready(function (e) {		
	    renderSlideshowIfApplicable($('#divEditor' + '5713190d-1d90-435c-aadf-aaa6d1f57cc7'));
	});
</script>
