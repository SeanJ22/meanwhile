	<div class="inner col col24 first last iddc3945e6-714c-4071-919c-15ffcb4ae43b" style="" data-widgetcontainerid="dc3945e6-714c-4071-919c-15ffcb4ae43b">	
<div class="widget editor pageStyles narrow" id="divEditor0353e7ae-3a93-4c28-8357-2a41c3e74052" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
