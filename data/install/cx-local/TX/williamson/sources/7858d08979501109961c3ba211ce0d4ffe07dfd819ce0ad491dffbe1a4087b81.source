=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://aptg.co/LtSVjq\\\" data-page-id=\\\"0\\\" data-org-id=\\\"27049\\\" data-document-id=\\\"24385799\\\" data-folder-id=\\\"0\\\"><strong>Board Meeting Recognitions</strong></a><br><a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://docs.google.com/forms/d/e/1FAIpQLSfrq3pez-PZowakavKm2P1V6elAFe3y86Z0U7U-XARkXI17oA/viewform?usp=sharing&amp;ouid=103570047344337909936\\\">Recognition Submission Form</a>, <a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://roundrockisd.smugmug.com/Board\\\">Recognition Photos</a></p><p><a target=\\\"_self\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://roundrockisdtx.sites.thrillshare.com/news?filter_id=551977\\\"><strong>Board Briefs</strong></a><br>News posts summarizing the highlights of Board Meetings</p>\"},\"properties\":{\"anchorTag\":\"\",\"customClasses\":[]}}]}],\"name\":\"Two Columns\",\"type\":\"LAYOUT_NODE_DOUBLE_COLUMN\"},{\"id\":\"c8b1af71-d880-4560-a4de-eadebdfd2b53\",\"name\":\"Separator\",\"type\":\"CONTENT_NODE_SEPARATOR\",\"properties\":{\"anchorTag\":\"\",\"customClasses\":[],\"color\":\"\",\"style\":\"solid\",\"width\":100,\"thickness\":\"3\"}},{\"id\":\"bd81144a-c174-422c-8407-2762e4f0f672\",\"properties\":{\"customClasses\":[],\"anchorTag\":\"\",\"margin\":{\"top\":10,\"left\":10,\"right\":10,\"value\":10,\"bottom\":10,\"linked\":true},\"padding\":{\"top\":0,\"left\":0,\"right\":0,\"value\":0,\"bottom\":0,\"linked\":true},\"borderRadius\":{\"value\":0},\"backgroundColor\":{\"value\":\"\",\"toggle\":false},\"backgroundImage\":{\"image\":null,\"toggle\":false}},\"nodes\":[{\"name\":\"Base Column\",\"type\":\"BASE_COLUMN\",\"nodes\":[{\"id\":\"d80a9122-be00-4232-b218-34c1dff172e2\",\"name\":\"Card\",\"type\":\"CONTENT_NODE_CARD\",\"content\":{\"heading\":{\"id\":\"cardTitle_d80a9122-be00-4232-b218-34c1dff172e2\",\"name\":\"Heading\",\"type\":\"CONTENT_NODE_HEADING\",\"con