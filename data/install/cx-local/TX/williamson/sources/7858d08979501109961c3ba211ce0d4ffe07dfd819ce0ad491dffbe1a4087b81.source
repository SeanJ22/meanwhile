00fa1f34776 .custom-section:not(:has(.link-actions)) .only-in-cms {\\n  display: none !important;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-image-wrapper img.image-container-image {\\n  display: block;\\n  width: auto;\\n  height: auto;\\n  object-fit: contain;\\n  min-height: 150px;\\n  min-width: 150px;\\n  max-height: 250px;\\n  border: 1px solid #eee;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-image-wrapper {\\n  height: auto;\\n  margin-bottom: 10px;\\n  display: inline-block;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper.blank-icon {\\n  display: inline-block;\\n  width: auto;\\n  min-width: 75px;\\n  min-height: 75px;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper .raw-svg,\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper {\\n  display: inline-block;\\n  width: auto;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper svg {\\n  height: 75px;\\n  width: 75px;\\n  object-fit: contain;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper .raw-svg {\\n  border: 1px solid #eee;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-textarea-wrapper textarea,\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-input-wrapper input {\\n  border: 1px solid #ddd;\\n  padding: 5px;\\n  margin-bottom: 10px;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-component:has(.link-button) {\\n  padding-left: 20px;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-component .link-actions-container.link-actions-container-link {\\n  left: 0;\\n  visibility: visible;\\n}\\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-component-loop-wrapper > div {\\n  padding: 10px;\\n  box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);\\n  margin-bottom: 20px;\\n}\\n\",\"html_code\":\"<div class=\\\"custom-section custom-programs-section-v10 style-bold\\\">\\n    <div class=\\\"see-all-container see-all-top\\\">\\n        <div class=\\\"header-slot-container\\\">\\n            <h2>\\n                <label class=\\\"only-in-cms\\\">Add top part subtitle:</label>\\n                <div class=\\\"header-top\\\"><cms-input name=\\\"header-top-v10\\\"></cms-input></div>\\n                <label class=\\\"only-in-cms\\\">Add section main title:</label>\\n                <div class=\\\"header-bottom\\\"><cms-input name=\\\"header-bottom-v10\\\"></cms-input></div>\\n            </h2>\\n            <label class=\\\"only-in-cms\\\">Add intro text:</label>\\n            <div class=\\\"intro\\\">\\n                <p><cms-textarea name=\\\"intro-v10\\\"></cms-textarea></p>\\n            </div>\\n        </div>\\n        <label class=\\\"only-in-cms\\\">Add section button text and link:</label>\\n        <span class=\\\"see-all-button-custom\\\">\\n            <cms-input name=\\\"see-all-button-custom-v10\\\" link></cms-input></span>\\n    </div>\\n    <div id=\\\"programs-slider-v10\\\" class=\\\"programs-container swiper\\\">\\n\\n        <cms-loop limit=\\\"12\\\" class=\\\"programs-wrapper swiper-wrapper\\\" name=\\\"programs-wrapper-v10\\\">\\n            <label class=\\\"only-in-cms\\\">Add program image:</label>\\n            <div class=\\\"image\\\">\\n                <cms-image name=\\\"program-image-v10\\\"></cms-image>\\n            </div>\\n            <div class=\\\"content\\\">\\n                <label class=\\\"only-in-cms\\\">Add program title:</label>\\n                <h3 class=\\\"title\\\"><cms-input name=\\\"program-title-v10\\\"></cms-input></h3>\\n                <div class=\\\"text\\\">\\n                  <label class=\\\"only-in-cms\\\">Add program description:</label>\\n                    \\n                    <p><cms-textarea name=\\\"program-text-v10\\\"></cms-textarea></p>\\n                </div>\\n                <div class=\\\"program-more-link\\\">\\n                  <label class=\\\"only-in-cms\\\">Add program button text and link:</label>\\n                    <cms-input name=\\\"program-link-v10\\\" link></cms-input>\\n                  </div>\\n              \\n            </div>\\n        </cms-loop>\\n      <div class=\\\"custom-swiper-pagination swiper-pagination-custom-programs-v10\\\"></div>\\n        <div class=\\\"arrows-buttons hide-on-cms\\\">\\n            <div class=\\\"programs-swiper-button-prev-v10 swiper-button-prev\\\" tabindex=\\\"-1\\\" role=\\\"button\\\"\\n                aria-label=\\\"Previous slide\\\">\\n                <span>Previous slide</span>\\n            </div>\\n            <div class=\\\"programs-swiper-button-next-v10 swiper-button-next\\\" tabindex=\\\"-1\\\" role=\\\"button\\\"\\n                aria-label=\\\"Next slide\\\">\\n                <span>Next slide</span>\\n            </div>\\n        </div>\\n    </div>\\n\\n    <div class=\\\"see-all-container see-all-bottom hide-on-cms\\\">\\n        <span class=\\\"see-all-button-custom\\\"><cms-input name=\\\"see-all-button-custom-v10\\\" link></cms-input></span>\\n    </div>\\n</div>\\n\\n \",\"scss_code\":\"/* styling for CMS */\\n.custom-section { display: block !important; } /* can be with display: none in edit template code to be hidden as default */\\n.custom-section:has(.link-actions) {\\n  padding: 20px;\\n}\\nlabel.only-in-cms {\\n  font-size: 16px;\\n  font-weight: 600;\\n  margin-top: 15px;\\n  margin-bottom: 10px;\\n  display: block;\\n  letter-spacing: 0.03em;;\\n}\\nlabel.only-in-cms:nth-child(2) {\\n  margin-top: 0;\\n}\\n.custom-section:has(.link-actions) .hide-on-cms {\\n  display: none !important;\\n}\\n.custom-section:not(:has(.link-actions)) .only-in-cms {\\n  display: none !important;\\n}\\n.custom-section .homepage-image-wrapper img.image-container-image {\\n  display: block;\\n  width: auto;\\n  height: auto;\\n  object-fit: contain; \\n  min-height: 150px;\\n  min-width: 150px;\\n  max-height: 250px;\\n  border: 1px solid #eee;\\n}\\n.custom-section .homepage-image-wrapper {\\n  height: auto;\\n  margin-bottom: 10px;\\n  display: inline-block;\\n}\\n.custom-section .homepage-icon-wrapper.blank-icon {\\n  display: inline-block;\\n  width: auto;\\n  min-width: 75px;\\n  min-height: 75px;\\n}\\n.custom-section .homepage-icon-wrapper .raw-svg,\\n.custom-section .homepage-icon-wrapper {\\n  display: inline-block;\\n  width: auto;\\n}\\n.custom-section .homepage-icon-wrapper svg {\\n  height: 75px;\\n  width: 75px;\\n  object-fit: contain;\\n}\\n.custom-section .homepage-icon-wrapper .raw-svg {\\n  border: 1px solid #eee;\\n}\\n.custom-section .homepage-textarea-wrapper textarea,\\n.custom-section .homepage-input-wrapper input {\\n  border: 1px solid #ddd;\\n  padding: 5px;\\n  margin-bottom: 10px;\\n}\\n.custom-component:has(.link-button) {\\n  padding-left: 20px;\\n}\\n.custom-component .link-actions-container.link-actions-container-link {\\n  left: 0;\\n  visibility: visible;\\n}\\n.custom-component-loop-wrapper > div {\\n  padding: 10px;\\n  box-shadow: 0 0 15px rgba(0,0,0,0.5);\\n  margin-bottom: 20px;\\n}\",\"container_id\":\"custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#3A3A3A\"}}},{\"id\":\"fb705b18-ba56-464d-86e8-8468abeee071\",\"type\":\"Fullwidth\",\"components\":[{\"name\":\"Custom Component\",\"options\":{\"global\":false,\"js_code\":\"\",\"css_code\":\"#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-area {\\n  padding-top: 2em;\\n  padding-bottom: 2em;\\n  text-align: center;\\n  max-width: 1000px;\\n  margin-left: auto;\\n  margin-right: auto;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-header {\\n  margin-top: 1em;\\n  margin-bottom: 1em;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-description {\\n  display: block;\\n  margin-top: 1.5em;\\n  margin-bottom: 1em;\\n  padding-left: 32px;\\n  padding-right: 32px;\\n  line-height: 1.4;\\n  font-size: 20px;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-description p {\\n  margin-bottom: 1em;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-button a {\\n  display: inline-block;\\n  margin-left: auto;\\n  margin-right: auto;\\n  text-decoration: none;\\n  padding: 1em 1.75em;\\n  background-color: var(--primary-color);\\n  margin-top: 1em;\\n  margin-bottom: 1em;\\n  color: #fff;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-button a:hover {\\n  opacity: 0.9;\\n}\\n@media only screen and (max-width: 1023px) {\\n  #custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-description {\\n    font-size: 18px;\\n  }\\n}\\n\",\"html_code\":\"<div class=\\\"content-area js-custom-component\\\" id=\\\"content-area\\\">\\n    <div class=\\\"content-text\\\">\\n        <h2> <cms-input name=\\\"content-header\\\" class=\\\"content-header\\\"></cms-input> </h2>\\n        <div class=\\\"plaintext\\\">\\n            <cms-richtextarea name=\\\"content-description\\\" class=\\\"content-description\\\"></cms-richtextarea>\\n        </div>\\n        <cms-input name=\\\"content-button\\\" class=\\\"content-button\\\" link></cms-input>\\n    </div>\\n</div> \",\"scss_code\":\"\\n.content-area {\\n    padding-top: 2em;\\n    padding-bottom: 2em;\\n    text-align: center;\\n    max-width: 1000px;\\n    margin-left: auto;\\n    margin-right: auto;\\n}\\n\\n.content-header {\\n    margin-top: 1em;\\n    margin-bottom: 1em;\\n}\\n\\n.content-description {\\n    display: block;\\n    margin-top: 1.5em;\\n    margin-bottom: 1em;\\n    padding-left: 32px;\\n    padding-right: 32px;\\n    line-height: 1.4;\\n    font-size: 20px;\\n    p {\\n        margin-bottom: 1em;\\n    }\\n}\\n\\n.content-button {\\n    a {\\n        display: inline-block;\\n        margin-left: auto;\\n        margin-right: auto;\\n        text-decoration: none;\\n        padding: 1em 1.75em;\\n        background-color: var(--primary-color);\\n        margin-top: 1em;\\n        margin-bottom: 1em;\\n        color: #fff;\\n        &:hover {\\n            opacity: 0.9;\\n        }\\n    }\\n}\\n\\n@media only screen and (max-width: 1023px) {\\n    .content-description {\\n        font-size: 18px;\\n    }\\n}\\n\",\"container_id\":\"custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#3A3A3A\"}}}],\"floating_nav\":{\"options\":{\"style\":\"light\",\"active\":false,\"version\":\"FN1\",\"button_one\":{\"bg_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"icon_and_text_color\":{\"hex\":\"#fff\"}},\"button_two\":{\"bg_color\":{\"hex\":\"#fff\"},\"icon_and_text_color\":{\"hex\":\"#333\"}},\"button_five\":{\"bg_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"icon_and_text_color\":{\"hex\":\"#fff\"}},\"button_four\":{\"bg_color\":{\"hex\":\"#fff\"},\"icon_and_text_color\":{\"hex\":\"#333\"}},\"button_three\":{\"bg_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"icon_and_text_color\":{\"hex\":\"#fff\"}},\"button_mobile\":{\"bg_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"icon_and_text_color\":{\"hex\":\"#fff\"}}}},\"sticky_footer\":{\"options\":{\"style\":\"light\",\"active\":false,\"version\":\"StickyFooterV1\",\"bg_color\":{\"hex\":\"#3A3A3A\",\"fixedColor\":\"secondary\"},\"icon_color\":{\"hex\":\"#333333\"},\"icon_text_color\":{\"hex\":\"#333333\"},\"separator_color\":{\"hex\":\"#333333\"},\"pill_button_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"hide_button_text_color\":{\"hex\":\"#FFFFFF\"},\"pill_button_text_color\":{\"hex\":\"#FFFFFF\"},\"hide_button_and_bar_color\":{\"hex\":\"#242021\"}}},\"template_code\":{\"js_code\":\"\",\"css_code\":\"#home #g2 .text .description a {\\n  border: 5px solid #CBAB72;\\n}\\n\\n/* -------------------------------------------- */\\n/* ----------- EVENTS START ----------- */\\n/* -------------------------------------------- */\\n@media only screen and (min-width: 1199px) {\\n  #home #events-e5 {\\n    margin-top: 2em;\\n    margin-bottom: 2em;\\n  }\\n\\n  #home #events-e5 .card-content:nth-child(n+6) {\\n    display: none;\\n  }\\n\\n  #home #events-e5 .nav {\\n    display: none;\\n  }\\n\\n  #home #events-e5 .events-wrapper {\\n    display: grid;\\n    width: 100%;\\n    grid-template-columns: repeat(5, 1fr);\\n    gap: 20px;\\n  }\\n\\n  #home #events-e5 .events-wrapper .events-card {\\n    min-width: unset;\\n    min-height: unset;\\n    padding: 20px;\\n  }\\n\\n  #home #events-e5 .events-date {\\n    border: none;\\n  }\\n\\n  #home #events-e5 .start-date,\\n  #home #events-e5 .end-date {\\n    display: flex;\\n    padding-left: 0;\\n    padding-right: 0;\\n    padding-top: 1em;\\n  }\\n\\n  #home #events-e5 .start-date .date-month,\\n  #home #events-e5 .start-date .date-day,\\n  #home #events-e5 .end-date .date-month,\\n  #home #events-e5 .end-date .date-day {\\n    font-size: 32px;\\n  }\\n\\n  #home #events-e5 .start-date .date-month {\\n    padding-left: 0;\\n  }\\n\\n  #home #events-e5 .events-card .events-title {\\n    border-top: 1px solid var(--text-color);\\n    padding-top: 1em;\\n    margin-top: 1em;\\n  }\\n}\\n\\n/* -------------------------------------------- */\\n/* ----------- EVENTS END ----------- */\\n/* -------------------------------------------- */\\n\\n/* small icons in cards component */\\n#page {\\n    .pb-card.image-sm-size {\\n        --image-size: 75px;\\n        --gap: 15px;\\n\\n        .card-container {\\n            display: flex;\\n            flex-direction: row;\\n            gap: var(--gap);\\n            flex-wrap: wrap;\\n        }\\n\\n        .card-image-container {\\n            --image-dimensions: var(--image-size);\\n        }\\n\\n        .card-content-container {\\n            width: calc(100% - var(--image-size) - var(--gap));\\n            box-sizing: border-box;\\n            flex: 1;\\n            min-width: 170px;\\n\\n            .card-heading {\\n                margin-bottom: 10px;\\n            }\\n        }\\n    }\\n}\\n/* end small icons in cards component */\\n#view-header .mobile-header {\\n    --hamburger-size: 40px;\\n\\n    .left-icon {\\n        left: 10px;\\n        transform: translateY(-50%);\\n\\n        .hamburger {\\n            width: var(--hamburger-size);\\n            height: var(--hamburger-size);\\n            display: block;\\n        }\\n    }\\n\\n    .logo {\\n        margin: 0; \\n        display: block;\\n        max-width: calc(100vw - 30px - (2 * var(--hamburger-size)));\\n        \\n\\n\\n        img {\\n            max-width: 100%;\\n            object-fit: contain;\\n        }\\n    }\\n}\\n@media only screen and (max-width: 500px) {\\n    #view-header .mobile-header {\\n        justify-content: flex-end;\\n\\n        .logo {\\n            max-width: calc(100vw - 30px - var(--hamburger-size));\\n            margin-right: 10px;\\n        }\\n    }\\n}\\n\\n\",\"style_codes\":[\"\",\"https://cmsv2-shared-assets.apptegy.net/Global/Components/Custom-Styles/helpers.css\",\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\",\"https://cmsv2-shared-assets.apptegy.net/Global/Components/Custom-Programs/custom-programs-v10.css\",\"https://cmsv2-shared-assets.apptegy.net/Schools/Round-Rock-ISD-27049/round-rock-isd-css.css\",\"https://cmsv2-shared-assets.apptegy.net/Global/Components/cms-page-plugins/customised-cms-page-layouts.css\"],\"script_codes\":[\"https://cmsv2-shared-assets.apptegy.net/Global/Components/Custom-Classes/helpers.js\",\"\",\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js\",\"https://cmsv2-shared-assets.apptegy.net/Global/Components/Custom-Programs/custom-programs-v10.js\",\"https://cmsv2-shared-assets.apptegy.net/Schools/Round-Rock-ISD-27049/round-rock-isd-js.js\",\"https://cmsv2-shared-assets.apptegy.net/Global/Components/cms-page-plugins/customised-cms-page-layouts.js\"]}},\"accentStyling\":true,\"accentType\":\"dot\",\"font\":\"Inter\",\"homepage\":{\"news\":{\"48bf4d88-55cf-4b02-b72c-b9b471be21b2_0\":{\"see_all_link\":{\"href\":\"/news\",\"name\":\"See All News\",\"target\":\"_self\"},\"component_header\":\"News\",\"component_header_top\":\"Latest\"}},\"about\":{},\"stats\":{},\"video\":{\"496bc051-ba6d-4e3b-91c9-96e44b4b30ef_0\":{\"videos\":[{\"url\":\"https://youtu.be/nh8B-KZb17w\",\"uuid\":\"496bc051-ba6d-4e3b-91c9-96e44b4b30ef_0\",\"title\":\"7th Annual Central Texas Teen & Kids Comic Con\",\"alt_text\":\"a student posing with a group of storm troopers\",\"position\":0,\"thumbnail\":\"https://vumbnail.com/nh8B-KZb17w_large.jpg\",\"description\":\"Superheros, Sci-fi enthusiasts, Anime characters and the like all merged onto Round Rock High school campus to celebrate everything they love about comics at the 7th Annual Central Texas Teen & Kids Comic Con.\"},{\"url\":\"https://youtu.be/AQiM8iSLqIQ?feature=shared\",\"uuid\":\"496bc051-ba6d-4e3b-91c9-96e44b4b30ef_0\",\"title\":\"Deep Wood Elementary garden comes to life\",\"alt_text\":\"Deep Wood Elementary garden comes to life\",\"position\":1,\"thumbnail\":\"https://vumbnail.com/AQiM8iSLqIQ_large.jpg\",\"description\":\"Did you know that Deep Wood Elementary School has a growing veggie garden?\\nCheck out our latest Classroom Closeup, where students learn, maintain, and help cultivate vegetables.\"},{\"url\":\"https://youtu.be/L39olsbcJUk?feature=shared\",\"uuid\":\"496bc051-ba6d-4e3b-91c9-96e44b4b30ef_0\",\"title\":\"Soccer books fill the shelves at Anderson Mill Elementary\",\"alt_text\":\"student reading\",\"position\":2,\"thumbnail\":\"https://vumbnail.com/L39olsbcJUk_large.jpg\",\"description\":\"Thanks to a grant from the Partners in Education Foundation Anderson Mill Elementary was able to purchase some much needed soccer books to help support thei