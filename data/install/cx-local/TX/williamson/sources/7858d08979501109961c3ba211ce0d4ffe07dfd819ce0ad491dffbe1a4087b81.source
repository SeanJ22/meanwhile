nent .link-actions-container.link-actions-container-link {\\n  left: 0;\\n  visibility: visible;\\n}\\n.custom-component-loop-wrapper > div {\\n  padding: 10px;\\n  box-shadow: 0 0 15px rgba(0,0,0,0.5);\\n  margin-bottom: 20px;\\n}\",\"container_id\":\"custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#3A3A3A\"}}},{\"id\":\"fb705b18-ba56-464d-86e8-8468abeee071\",\"type\":\"Fullwidth\",\"components\":[{\"name\":\"Custom Component\",\"options\":{\"global\":false,\"js_code\":\"\",\"css_code\":\"#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-area {\\n  padding-top: 2em;\\n  padding-bottom: 2em;\\n  text-align: center;\\n  max-width: 1000px;\\n  margin-left: auto;\\n  margin-right: auto;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-header {\\n  margin-top: 1em;\\n  margin-bottom: 1em;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-description {\\n  display: block;\\n  margin-top: 1.5em;\\n  margin-bottom: 1em;\\n  padding-left: 32px;\\n  padding-right: 32px;\\n  line-height: 1.4;\\n  font-size: 20px;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-description p {\\n  margin-bottom: 1em;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-button a {\\n  display: inline-block;\\n  margin-left: auto;\\n  margin-right: auto;\\n  text-decoration: none;\\n  padding: 1em 1.75em;\\n  background-color: var(--primary-color);\\n  margin-top: 1em;\\n  margin-bottom: 1em;\\n  color: #fff;\\n}\\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-button a:hover {\\n  opacity: 0.9;\\n}\\n@media only screen and (max-width: 1023px) {\\n  #custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-description {\\n    font-size: 18px;\\n  }\\n}\\n\",\"html_code\":\"<div class=\\\"content-area js-custom-component\\\" id=\\\"content-area\\\">\\n    <div class=\\\"content-text\\\">\\n        <h2> <cms-input name=\\\"content-header\\\" class=\\\"content-header\\\"></cms-input> </h2>\\n        <div class=\\\"plaintext\\\">\\n            <cms-richtextarea name=\\\"content-description\\\" class=\\\"content-description\\\"></cms-richtextarea>\\n        </div>\\n        <cms-input name=\\\"content-button\\\" class=\\\"content-button\\\" link></cms-input>\\n    </div>\\n</div> \",\"scss_code\":\"\\n.content-area {\\n    padding-top: 2em;\\n    padding-bottom: 2em;\\n    text-align: center;\\n    max-width: 1000px;\\n    margin-left: auto;\\n    margin-right: auto;\\n}\\n\\n.content-header {\\n    margin-top: 1em;\\n    margin-bottom: 1em;\\n}\\n\\n.content-description {\\n    display: block;\\n    margin-top: 1.5em;\\n    margin-bottom: 1em;\\n    padding-left: 32px;\\n    padding-right: 32px;\\n    line-height: 1.4;\\n    font-size: 20px;\\n    p {\\n        margin-bottom: 1em;\\n    }\\n}\\n\\n.content-button {\\n    a {\\n        display: inline-block;\\n        margin-left: auto;\\n        margin-right: auto;\\n        text-decoration: none;\\n        padding: 1em 1.75em;\\n        background-color: var(--primary-color);\\n        margin-top: 1em;\\n        margin-bottom: 1em;\\n        color: #fff;\\n        &:hover {\\n            opacity: 0.9;\\n        }\\n    }\\n}\\n\\n@media only screen and (max-width: 1023px) {\\n    .content-description {\\n        font-size: 18px;\\n    }\\n}\\n\",\"container_id\":\"custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190\"}}],\"decorativeBackground\":{\"type\":\"None\",\"color\":{\"hex\":\"#3A3A3A\"}}}],\"floating_nav\":{\"options\":{\"style\":\"light\",\"active\":false,\"version\":\"FN1\",\"button_one\":{\"bg_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"icon_and_text_color\":{\"hex\":\"#fff\"}},\"button_two\":{\"bg_color\":{\"hex\":\"#fff\"},\"icon_and_text_color\":{\"hex\":\"#333\"}},\"button_five\":{\"bg_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"icon_and_text_color\":{\"hex\":\"#fff\"}},\"button_four\":{\"bg_color\":{\"hex\":\"#fff\"},\"icon_and_text_color\":{\"hex\":\"#333\"}},\"button_three\":{\"bg_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"icon_and_text_color\":{\"hex\":\"#fff\"}},\"button_mobile\":{\"bg_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"icon_and_text_color\":{\"hex\":\"#fff\"}}}},\"sticky_footer\":{\"options\":{\"style\":\"light\",\"active\":false,\"version\":\"StickyFooterV1\",\"bg_color\":{\"hex\":\"#3A3A3A\",\"fixedColor\":\"secondary\"},\"icon_color\":{\"hex\":\"#333333\"},\"icon_text_color\":{\"hex\":\"#333333\"},\"separator_color\":{\"hex\":\"#333333\"},\"pill_button_color\":{\"hex\":\"#005F6B\",\"fixedColor\":\"primary\"},\"hide_button_text_color\":{\"hex\":\"#FFFFFF\"},\"pill_button_text_color\":{\"hex\":\"#FFFFFF\"},\"hide_button_and_bar_color\":{\"hex\":\"#242021\"}}},\"template_code\":{\"js_code\":\"\",\"css_code\":\"#home #g2 .text .description a {\\n  border: 5px solid #CBAB72;\\n}\\n\\n/* -------------------------------------------- */\\n/* ----------- EVENTS START ----------- */\\n/* -------------------------------------------- */\\n@media only screen and (min-width: 1199px) {\\n  #home #events-e5 {\\n    margin-top: 2em;\\n    margin-bottom: 2em;\\n  }\\n\\n  #home #events-e5 .card-content:nth-child(n+6) {\\n    display: none;\\n  }\\n\\n  #home #events-e5 .nav {\\n    display: none;\\n  }\\n\\n  #home #events-e5 .events-wrapper {\\n    display: grid;\\n    width: 100%;\\n    grid-template-columns: repeat(5, 1fr);\\n    gap: 20px;\\n  }\\n\\n  #home #events-e5 .events-wrapper .events-card {\\n    min-width: unset;\\n    min-height: unset;\\n    padding: 20px;\\n  }\\n\\n  #home #events-e5 .events-date {\\n    border: none;\\n  }\\n\\n  #home #events-e5 .start-date,\\n  #home #events-e5 .end-date {\\n    display: flex;\\n    padding-left: 0;\\n    padding-right: 0;\\n    padding-top: 1em;\\n  }\\n\\n  #home #events-e5 .start-date .date-month,\\n  #home #events-e5 .start-date .date-day,\\n  #home #events-e5 .end-date .date-month,\\n  #home #events-e5 .end-date .date-day {\\n    font-size: 32px;\\n  }\\n\\n  #home #events-e5 .start-date .date-month {\\n    padding-left: 0;\\n  }\\n\\n  #home #events-e5 .events-card .events-title {\\n    border-top: 1px solid var(--text-color);\\n    padding-top: 1em;\\n    margin-top: 1em;\\n  }\\n}\\n\\n/* -------------------------------------------- */\\n/* ----------- EVENTS END ----------- */\\n/* -------------------------------------------- */\\n\\n/* small icons in cards component */\\n#page {\\n    .pb-card.image-sm-size {\\n        --image-size: 75px;\\n        --gap: 15px;\\n\\n        .card-container {\\n            display: flex;\\n            flex-direction: row;\\n            gap: var(--gap);\\n            flex-wrap: wrap;\\n        }\\n\\n        .card-image-container {\\n            --image-dimensions: var(--image-size);\\n        }\\n\\n        .card-content-container {\\n            width: calc(100% - var(--image-size) - var(--gap));\\n            box-sizing: border-box;\\n            flex: 1;\\n            min-width: 170px;\\n\\n            .card-heading {\\n                margin-bottom: 10px;\\n            }\\n        }\\n    }\\n}\\n/* end small icons in cards component */\\n#view-header .mobile-header {\\n    --hamburger-size: 40px;\\n\\n    .left-icon {\\n        left: 10px;\\n        transform: translateY(-50%);\\n\\n        .hamburger {\\n            width: var(--hamburger-size);\\n            height: var(--hamburger-size);\\n            display: block;\\n        }\\n    }\\n\\n    .logo {\\n        margin: 0; \\n        display: block;\\n        max-width: calc(100vw - 30px - (2 * var(--hamburger-size)));\\n        \\n\\n\\n        img {\\n            max-width: 100%;\\n            object-fit: contain;\\n        }\\n    }\\n}\\n@media only screen and (max-width: 500px) {\\n    #view-header .mobile-header {\\n        justify-content: flex-end;\\n\\n        .logo {\\n            max-width: calc(100