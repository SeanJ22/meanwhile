uto;\n        text-decoration: none;\n        padding: 1em 1.75em;\n        background-color: var(--primary-color);\n        margin-top: 1em;\n        margin-bottom: 1em;\n        color: #fff;\n        &:hover {\n            opacity: 0.9;\n        }\n    }\n}\n\n@media only screen and (max-width: 1023px) {\n    .content-description {\n        font-size: 18px;\n    }\n}\n","custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190",{"type":681,"color":834},{"hex":485},{"options":836},{"style":837,"active":7,"version":838,"button_one":839,"button_two":842,"button_five":845,"button_four":848,"button_three":851,"button_mobile":854},"light","FN1",{"bg_color":840,"icon_and_text_color":841},{"hex":482,"fixedColor":483},{"hex":495},{"bg_color":843,"icon_and_text_color":844},{"hex":495},{"hex":503},{"bg_color":846,"icon_and_text_color":847},{"hex":482,"fixedColor":483},{"hex":495},{"bg_color":849,"icon_and_text_color":850},{"hex":495},{"hex":503},{"bg_color":852,"icon_and_text_color":853},{"hex":482,"fixedColor":483},{"hex":495},{"bg_color":855,"icon_and_text_color":856},{"hex":482,"fixedColor":483},{"hex":495},{"options":858},{"style":837,"active":7,"version":859,"bg_color":860,"icon_color":861,"icon_text_color":863,"separator_color":864,"pill_button_color":865,"hide_button_text_color":866,"pill_button_text_color":867,"hide_button_and_bar_color":868},"StickyFooterV1",{"hex":485,"fixedColor":493},{"hex":862},"#333333",{"hex":862},{"hex":862},{"hex":482,"fixedColor":483},{"hex":531},{"hex":531},{"hex":869},"#242021",{"js_code":85,"css_code":871,"style_codes":872,"script_codes":878},"#home #g2 .text .description a {\n  border: 5px solid #CBAB72;\n}\n\n/* -------------------------------------------- */\n/* ----------- EVENTS START ----------- */\n/* -------------------------------------------- */\n@media only screen and (min-width: 1199px) {\n  #home #events-e5 {\n    margin-top: 2em;\n    margin-bottom: 2em;\n  }\n\n  #home #events-e5 .card-content:nth-child(n+6) {\n    display: none;\n  }\n\n  #home #events-e5 .nav {\n    display: none;\n  }\n\n  #home #events-e5 .events-wrapper {\n    display: grid;\n    width: 100%;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 20px;\n  }\n\n  #home #events-e5 .events-wrapper .events-card {\n    min-width: unset;\n    min-height: unset;\n    padding: 20px;\n  }\n\n  #home #events-e5 .events-date {\n    border: none;\n  }\n\n  #home #events-e5 .start-date,\n  #home #events-e5 .end-date {\n    display: flex;\n    padding-left: 0;\n    padding-right: 0;\n    padding-top: 1em;\n  }\n\n  #home #events-e5 .start-date .date-month,\n  #home #events-e5 .start-date .date-day,\n  #home #events-e5 .end-date .date-month,\n  #home #events-e5 .end-date .date-day {\n    font-size: 32px;\n  }\n\n  #home #events-e5 .start-date .date-month {\n    padding-left: 0;\n  }\n\n  #home #events-e5 .events-card .events-title {\n    border-top: 1px solid var(--text-color);\n    padding-top: 1em;\n    margin-top: 1em;\n  }\n}\n\n/* -------------------------------------------- */\n/* ----------- EVENTS END ----------- */\n/* -------------------------------------------- */\n\n/* small icons in cards component */\n#page {\n    .pb-card.image-sm-size {\n        --image-size: 75px;\n        --gap: 15px;\n\n        .card-container {\n            display: flex;\n            flex-direction: row;\n            gap: var(--gap);\n            flex-wrap: wrap;\n        }\n\n        .card-image-container {\n            --image-dimensions: var(--image-size);\n        }\n\n        .card-content-container {\n            width: calc(100% - var(--image-size) - var(--gap));\n            box-sizing: border-box;\n            flex: 1;\n            min-width: 170px;\n\n            .card-heading {\n                margin-bottom: 10px;\n            }\n        }\n    }\n}\n/* end small icons in cards component */\n#view-header .mobile-header {\n    --hamburger-size: 40px;\n\n    .left-icon {\n        left: 10px;\n        transform: translateY(-50%);\n\n        .hamburger {\n            width: var(--hamburger-size);\n            height: var(--hamburger-size);\n            display: block;\n        }\n    }\n\n    .logo {\n        margin: 0; \n        display: block;\n        max-width: calc(100vw - 30px - (2 * var(--hamburger-size)));\n        \n\n\n        img {\n            max-width: 100%;\n            object-fit: contain;\n        }\n    }\n}\n@media only screen and (max-width: 500px) {\n    #view-header .mobile-header {\n        justify-content: flex-end;\n\n        .logo {\n            max-width: calc(100vw - 30px - var(--hamburger-size));\n            margin-right: 10px;\n        }\n    }\n}\n\n",[85,873,874,875,876,877],"https://cmsv2-shared-assets.apptegy.net/Global/Components/Custom-Styles/helpers.css","https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css","https://cmsv2-shared-assets.apptegy.net/Global/Components/Custom-Programs/custom-programs-v10.css","https://cmsv2-shared-assets.apptegy.net/Schools/Round-Rock-ISD-27049/round-rock-isd-css.css","https://cmsv2-shared-assets.apptegy.net/Global/Components/cms-page-plugins/customised-cms-page-layouts.css",[879,85,880,881,882,883],"https://cmsv2-shared-assets.apptegy.net/Global/Components/Custom-Classes/helpers.js","https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js","https://cmsv2-shared-assets.apptegy.net/Global/Components/Custom-Programs/custom-programs-v10.js","https://cmsv2-shared-assets.apptegy.net/Schools/Round-Rock-ISD-27049/round-rock-isd-js.js","https://cmsv2-shared-assets.apptegy.net/Global/Components/cms-page-plugins/customised-cms-page-layouts.js","dot",97601,593162,{"about":888,"globals":889,"header":899,"floating_nav":906,"footer":908,"sticky_footer":917,"menu":920,"live_feed":922,"news":931,"events":935,"programs":939,"athletics":941,"stats":945,"spotlights":946,"buttons":947,"our_schools":948,"alert_modal":949,"custom_html":950,"custom_component":951,"media_custom_code":952,"pagination":953,"video":963},{},{"skip_to_content":8