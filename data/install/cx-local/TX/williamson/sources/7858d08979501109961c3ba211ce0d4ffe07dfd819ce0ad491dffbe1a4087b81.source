<style type="text/css">@media (max-width:1023px){#h2 .header-container,#h2 [data-testid="small-utilities-bar"] .search{display:none!important}#h2 [data-testid="small-utilities-bar"] .utility-bar-items{justify-content:center}}@media (min-width:1024px){#h2 .mobile-header{display:none!important}}</style>
<style type="text/css">
.pb-card .card-container {
  width: auto !important;
}
</style>
<style type="text/css">#home #g2 .text .description a {
  border: 5px solid #CBAB72;
}

/* -------------------------------------------- */
/* ----------- EVENTS START ----------- */
/* -------------------------------------------- */
@media only screen and (min-width: 1199px) {
  #home #events-e5 {
    margin-top: 2em;
    margin-bottom: 2em;
  }

  #home #events-e5 .card-content:nth-child(n+6) {
    display: none;
  }

  #home #events-e5 .nav {
    display: none;
  }

  #home #events-e5 .events-wrapper {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }

  #home #events-e5 .events-wrapper .events-card {
    min-width: unset;
    min-height: unset;
    padding: 20px;
  }

  #home #events-e5 .events-date {
    border: none;
  }

  #home #events-e5 .start-date,
  #home #events-e5 .end-date {
    display: flex;
    padding-left: 0;
    padding-right: 0;
    padding-top: 1em;
  }

  #home #events-e5 .start-date .date-month,
  #home #events-e5 .start-date .date-day,
  #home #events-e5 .end-date .date-month,
  #home #events-e5 .end-date .date-day {
    font-size: 32px;
  }

  #home #events-e5 .start-date .date-month {
    padding-left: 0;
  }

  #home #events-e5 .events-card .events-title {
    border-top: 1px solid var(--text-color);
    padding-top: 1em;
    margin-top: 1em;
  }
}

/* -------------------------------------------- */
/* ----------- EVENTS END ----------- */
/* -------------------------------------------- */

/* small icons in cards component */
#page {
    .pb-card.image-sm-size {
        --image-size: 75px;
        --gap: 15px;

        .card-container {
            display: flex;
            flex-direction: row;
            gap: var(--gap);
            flex-wrap: wrap;
        }

        .card-image-container {
            --image-dimensions: var(--image-size);
        }

        .card-content-container {
            width: calc(100% - var(--image-size) - var(--gap));
            box-sizing: border-box;
            flex: 1;
            min-width: 170px;

            .card-heading {
                margin-bottom: 10px;
            }
        }
    }
}
/* end small icons in cards component */
#view-header .mobile-header {
    --hamburger-size: 40px;

    .left-icon {
        left: 10px;
        transform: translateY(-50%);

        .hamburger {
            width: var(--hamburger-size);
            height: var(--hamburger-size);
            display: block;
        }
    }

    .logo {
        margin: 0; 
        display: block;
        max-width: calc(100vw - 30px - (2 * var(--hamburger-size)));
        


        img {
            max-width: 100%;
            object-fit: contain;
        }
    }
}
@media only screen and (max-width: 500px) {
    #view-header .mobile-header {
        justify-content: flex-end;

        .logo {
            max-width: calc(100vw - 30px - var(--hamburger-size));
            margin-right: 10px;
        }
    }
}

</style>
