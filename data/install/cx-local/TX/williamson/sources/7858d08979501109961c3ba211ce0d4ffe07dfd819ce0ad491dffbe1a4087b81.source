600fa1f34776 .custom-section:not(:has(.link-actions)) .only-in-cms {\n  display: none !important;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-image-wrapper img.image-container-image {\n  display: block;\n  width: auto;\n  height: auto;\n  object-fit: contain;\n  min-height: 150px;\n  min-width: 150px;\n  max-height: 250px;\n  border: 1px solid #eee;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-image-wrapper {\n  height: auto;\n  margin-bottom: 10px;\n  display: inline-block;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper.blank-icon {\n  display: inline-block;\n  width: auto;\n  min-width: 75px;\n  min-height: 75px;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper .raw-svg,\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper {\n  display: inline-block;\n  width: auto;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper svg {\n  height: 75px;\n  width: 75px;\n  object-fit: contain;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-icon-wrapper .raw-svg {\n  border: 1px solid #eee;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-textarea-wrapper textarea,\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-section .homepage-input-wrapper input {\n  border: 1px solid #ddd;\n  padding: 5px;\n  margin-bottom: 10px;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-component:has(.link-button) {\n  padding-left: 20px;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-component .link-actions-container.link-actions-container-link {\n  left: 0;\n  visibility: visible;\n}\n#custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776 .custom-component-loop-wrapper > div {\n  padding: 10px;\n  box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);\n  margin-bottom: 20px;\n}\n","\u003Cdiv class=\"custom-section custom-programs-section-v10 style-bold\">\n    \u003Cdiv class=\"see-all-container see-all-top\">\n        \u003Cdiv class=\"header-slot-container\">\n            \u003Ch2>\n                \u003Clabel class=\"only-in-cms\">Add top part subtitle:\u003C/label>\n                \u003Cdiv class=\"header-top\">\u003Ccms-input name=\"header-top-v10\">\u003C/cms-input>\u003C/div>\n                \u003Clabel class=\"only-in-cms\">Add section main title:\u003C/label>\n                \u003Cdiv class=\"header-bottom\">\u003Ccms-input name=\"header-bottom-v10\">\u003C/cms-input>\u003C/div>\n            \u003C/h2>\n            \u003Clabel class=\"only-in-cms\">Add intro text:\u003C/label>\n            \u003Cdiv class=\"intro\">\n                \u003Cp>\u003Ccms-textarea name=\"intro-v10\">\u003C/cms-textarea>\u003C/p>\n            \u003C/div>\n        \u003C/div>\n        \u003Clabel class=\"only-in-cms\">Add section button text and link:\u003C/label>\n        \u003Cspan class=\"see-all-button-custom\">\n            \u003Ccms-input name=\"see-all-button-custom-v10\" link>\u003C/cms-input>\u003C/span>\n    \u003C/div>\n    \u003Cdiv id=\"programs-slider-v10\" class=\"programs-container swiper\">\n\n        \u003Ccms-loop limit=\"12\" class=\"programs-wrapper swiper-wrapper\" name=\"programs-wrapper-v10\">\n            \u003Clabel class=\"only-in-cms\">Add program image:\u003C/label>\n            \u003Cdiv class=\"image\">\n                \u003Ccms-image name=\"program-image-v10\">\u003C/cms-image>\n            \u003C/div>\n            \u003Cdiv class=\"content\">\n                \u003Clabel class=\"only-in-cms\">Add program title:\u003C/label>\n                \u003Ch3 class=\"title\">\u003Ccms-input name=\"program-title-v10\">\u003C/cms-input>\u003C/h3>\n                \u003Cdiv class=\"text\">\n                  \u003Clabel class=\"only-in-cms\">Add program description:\u003C/label>\n                    \n                    \u003Cp>\u003Ccms-textarea name=\"program-text-v10\">\u003C/cms-textarea>\u003C/p>\n                \u003C/div>\n                \u003Cdiv class=\"program-more-link\">\n                  \u003Clabel class=\"only-in-cms\">Add program button text and link:\u003C/label>\n                    \u003Ccms-input name=\"program-link-v10\" link>\u003C/cms-input>\n                  \u003C/div>\n              \n            \u003C/div>\n        \u003C/cms-loop>\n      \u003Cdiv class=\"custom-swiper-pagination swiper-pagination-custom-programs-v10\">\u003C/div>\n        \u003Cdiv class=\"arrows-buttons hide-on-cms\">\n            \u003Cdiv class=\"programs-swiper-button-prev-v10 swiper-button-prev\" tabindex=\"-1\" role=\"button\"\n                aria-label=\"Previous slide\">\n                \u003Cspan>Previous slide\u003C/span>\n            \u003C/div>\n            \u003Cdiv class=\"programs-swiper-button-next-v10 swiper-button-next\" tabindex=\"-1\" role=\"button\"\n                aria-label=\"Next slide\">\n                \u003Cspan>Next slide\u003C/span>\n            \u003C/div>\n        \u003C/div>\n    \u003C/div>\n\n    \u003Cdiv class=\"see-all-container see-all-bottom hide-on-cms\">\n        \u003Cspan class=\"see-all-button-custom\">\u003Ccms-input name=\"see-all-button-custom-v10\" link>\u003C/cms-input>\u003C/span>\n    \u003C/div>\n\u003C/div>\n\n ","/* styling for CMS */\n.custom-section { display: block !important; } /* can be with display: none in edit template code to be hidden as default */\n.custom-section:has(.link-actions) {\n  padding: 20px;\n}\nlabel.only-in-cms {\n  font-size: 16px;\n  font-weight: 600;\n  margin-top: 15px;\n  margin-bottom: 10px;\n  display: block;\n  letter-spacing: 0.03em;;\n}\nlabel.only-in-cms:nth-child(2) {\n  margin-top: 0;\n}\n.custom-section:has(.link-actions) .hide-on-cms {\n  display: none !important;\n}\n.custom-section:not(:has(.link-actions)) .only-in-cms {\n  display: none !important;\n}\n.custom-section .homepage-image-wrapper img.image-container-image {\n  display: block;\n  width: auto;\n  height: auto;\n  object-fit: contain; \n  min-height: 150px;\n  min-width: 150px;\n  max-height: 250px;\n  border: 1px solid #eee;\n}\n.custom-section .homepage-image-wrapper {\n  height: auto;\n  margin-bottom: 10px;\n  display: inline-block;\n}\n.custom-section .homepage-icon-wrapper.blank-icon {\n  display: inline-block;\n  width: auto;\n  min-width: 75px;\n  min-height: 75px;\n}\n.custom-section .homepage-icon-wrapper .raw-svg,\n.custom-section .homepage-icon-wrapper {\n  display: inline-block;\n  width: auto;\n}\n.custom-section .homepage-icon-wrapper svg {\n  height: 75px;\n  width: 75px;\n  object-fit: contain;\n}\n.custom-section .homepage-icon-wrapper .raw-svg {\n  border: 1px solid #eee;\n}\n.custom-section .homepage-textarea-wrapper textarea,\n.custom-section .homepage-input-wrapper input {\n  border: 1px solid #ddd;\n  padding: 5px;\n  margin-bottom: 10px;\n}\n.custom-component:has(.link-button) {\n  padding-left: 20px;\n}\n.custom-component .link-actions-container.link-actions-container-link {\n  left: 0;\n  visibility: visible;\n}\n.custom-component-loop-wrapper > div {\n  padding: 10px;\n  box-shadow: 0 0 15px rgba(0,0,0,0.5);\n  margin-bottom: 20px;\n}","custom-component-60fdaba4-9d35-49c9-951d-600fa1f34776",{"type":681,"color":823},{"hex":485},{"id":825,"type":632,"components":826,"decorativeBackground":833},"fb705b18-ba56-464d-86e8-8468abeee071",[827],{"name":816,"options":828},{"global":7,"js_code":85,"css_code":829,"html_code":830,"scss_code":831,"container_id":832},"#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-area {\n  padding-top: 2em;\n  padding-bottom: 2em;\n  text-align: center;\n  max-width: 1000px;\n  margin-left: auto;\n  margin-right: auto;\n}\n#custom-component-e749bcfb-4ff2-46d7-a914-8b8d66f1a190 .content-header {\n  margin-top: 1em;\n  margin-bottom: 1em;\n}\n#custom-component-e749bcfb-4ff2-46d