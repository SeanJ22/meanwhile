rich_textarea":1677},{},{"programs-wrapper-v10":1587},[1588,1602,1616,1628,1642,1655],{"image":1589,"input":1593,"textarea":1599},{"program-image-v10":1590},{"url":1591,"alt_text":1592},"https://cmsv2-assets.apptegy.net/uploads/27049/file/4431076/3fff76e8-0b0b-410a-a45c-fbef14e5386f.jpeg","student working on a car",{"program-link-v10":1594,"program-title-v10":1597},{"href":1595,"text":1596,"target":976},"https://www.roundrockisd.org/o/rrisd/page/career-and-technical","CTE",{"text":1598},"Career & Technical Education (CTE)",{"program-text-v10":1600},{"text":1601},"Round Rock ISD offers 28 CTE programs from agriculture to video production!",{"image":1603,"input":1607,"textarea":1613},{"program-image-v10":1604},{"url":1605,"alt_text":1606},"https://cmsv2-assets.apptegy.net/uploads/27049/file/4431192/b140c2bf-c878-45f2-88ac-615b73819083.jpeg","students reading in a rocking chair",{"program-link-v10":1608,"program-title-v10":1611},{"href":1609,"text":1610,"target":976},"/o/rrisd/page/pre-k","Pre-K",{"text":1612},"Prekindergarten",{"program-text-v10":1614},{"text":1615},"Round Rock ISD overs Pre-K programs for 3- and 4-year-old students",{"image":1617,"input":1621,"textarea":1625},{"program-image-v10":1618},{"url":1619,"alt_text":1620,"ai_generated_alt_text":7},"https://cmsv2-assets.apptegy.net/uploads/27049/file/6048154/40fd7a80-eb1f-4039-a559-0c2c9076a6b5.png","Virtual Academy student",{"program-link-v10":1622,"program-title-v10":1624},{"href":1623,"text":1574,"target":976},"https://www.roundrockisd.org/o/rrisd/page/virtual-academy",{"text":1574},{"program-text-v10":1626},{"text":1627},"A tuition-free hybrid or fully online high school experience for Texas students.",{"image":1629,"input":1633,"textarea":1639},{"program-image-v10":1630},{"url":1631,"alt_text":1632},"https://cmsv2-assets.apptegy.net/uploads/27049/file/4716433/575a2f48-6758-44b0-bf0e-7e1622172096.jpeg","Nursing students",{"program-link-v10":1634,"program-title-v10":1637},{"href":1635,"text":1636,"target":976},"/o/rrisd/page/ccmr","CCMR",{"text":1638},"College, Career, Military Readiness",{"program-text-v10":1640},{"text":1641},"CCMR helps students develop readiness skills and improve their chances for postsecondary success. After graduation, many CCMR students join the workforce, enlist in the Armed Forces or enroll in community college.",{"image":1643,"input":1647,"textarea":1652},{"program-image-v10":1644},{"url":1645,"alt_text":1646},"https://cmsv2-assets.apptegy.net/uploads/27049/file/4431124/553ae99a-1d73-4482-b017-31d2bcaca216.jpeg","student on the playground",{"program-link-v10":1648,"program-title-v10":1651},{"href":1649,"text":1650,"target":976},"/o/rrisd/page/bilingual-education","Bilingual Education",{"text":1650},{"program-text-v10":1653},{"text":1654},"The Round Rock ISD Bilingual Program is a full time Dual Language (DL) Immersion/Two-Way biliteracy program model.",{"image":1656,"input":1660,"textarea":1665},{"program-image-v10":1657},{"url":1658,"alt_text":1659},"https://cmsv2-assets.apptegy.net/uploads/27049/file/4431358/8e4e652a-afdf-4064-b735-b51aba5ee60c.png","students on laptops",{"program-link-v10":1661,"program-title-v10":1664},{"href":1662,"text":1663,"target":976},"/o/rrisd/page/advanced-academics","Advanced Academics",{"text":1663},{"program-text-v10":1666},{"text":1667},"Talented and Gifted, Advanced Placement, International Baccalaureate and more!",{},{"header-top-v10":1670,"header-bottom-v10":1672},{"text":1671},"Something for Everyone",{"text":1673},"Academic Highlights",{"intro-v10":1675},{"text":1676},"From our youngest learners to our graduates, we support students every step of the way.",{},{"icon":1679,"loop":1680,"image":1681,"input":1682,"textarea":1683,"rich_textarea":1684},{},{},{},{},{},{"content-description":1685},{"text":1686},"\u003Cp>\u003C/p>",{"links_color":1688,"school_name":84,"customHeader":12,"primary_color":1692,"alert_bg_color":1696,"school_tag_line":85,"secondary_color":1700,"alert_link_color":1704,"alert_text_colo