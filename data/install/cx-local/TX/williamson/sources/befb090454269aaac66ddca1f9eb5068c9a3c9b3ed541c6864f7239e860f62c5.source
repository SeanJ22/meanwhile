ot_1xyyz_1 builder-root builder-root comp-mtea05m12 comp-mtea05m12-container" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mtea05mb _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mtea05mb" data-motion-part="BG_LAYER comp-mtea05mb"></div><!--/$--></div><!--$--><div id="comp-mtea05u8" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtea05u8 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h5>County Facilities</h5></div><!--/$--><!--$--><div id="comp-mtea061n" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtea061n _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p><span>Overseeing the construction and maintenance of county buildings and vital supporting infrastructure.</span></p></div><!--/$--></div><!--/$--></div><!--/$--></div></div><!--/$--></section><!--/$--><!--$--><section id="comp-mteddn99" tabindex="-1" data-block-level-container="Section" class="ke5pl1 section comp-mteddn99 wixui-section fwXYgt" data-testid="section-container"><!--$--><div id="comp-mteddn9s" class="container _internalContainerRoot_1xyyz_1 builder-root theme-vars builder-root theme-vars comp-mteddn9s" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mteddn9u3 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mteddn9u3" data-motion-part="BG_LAYER comp-mteddn9u3"></div><!--/$--></div><div data-testid="internal-container-content" role="group" class="comp-mteddn9s-container max-width-container"><!--$--><!--/$--></div></div><!--/$--></section><!--/$--><!--$--><section id="comp-mthxf6ul" tabindex="-1" data-block-level-container="Section" class="ke5pl1 section comp-mthxf6ul wixui-section fwXYgt" data-testid="section-container"><!--$--><div id="comp-mthxf6wy" class="container _internalContainerRoot_1xyyz_1 builder-root theme-vars builder-root theme-vars comp-mthxf6wy" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mthxf6x01 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mthxf6x01" data-motion-part="BG_LAYER comp-mthxf6x01"></div><!--/$--></div><div data-testid="internal-container-content" role="group" class="comp-mthxf6wy-container max-width-container"><!--$--><div id="comp-mtiv52au" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv52au _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>CANDIDATE PLATFORM</p></div><!--/$--><!--$--><div id="comp-mtiv52hr" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv52hr _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h2>Protecting Williamson County</h2></div><!--/$--><!--$--><div id="comp-mtiv52o9" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv52o9 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>While the Commissioner’s Court oversees basic county functions, real leadership requires standing up for our community. Tish Flores is running with one clear goal: to protect our county from unchecked growth, wasted tax dollars, and industrial overreach.</p></div><!--/$--><!--$--><div id="comp-mtiv531w" class="_root_1w52m_1 _minHeightFix_1w52m_5 container builder-root builder-root comp-mtiv531w"><!--$--><div id="comp-mtiv53202" class="container _internalContainerRoot_1xyyz_1 builder-root builder-root comp-mtiv53202 comp-mtiv53202-container" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mtiv532c1 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mtiv532c1" data-motion-part="BG_LAYER comp-mtiv532c1"></div><!--/$--></div><!--$--><interact-element data-interact-key="au9pd/Containerau9pd/PAGE_SECTIONSau9pd/comp-mthxf6ul/comp-mthxf6wy/comp-mtiv531w/comp-mtiv53202/comp-mtiv5398"><div id="comp-mtiv5398" class="_root_1vtez_1 builder-root builder-root comp-mtiv5398 image" style="--original-aspect-ratio:1.3333333333333333"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-mtiv5398"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-mtiv5398"><wow-image id="img-comp-mtiv5398" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-mtiv5398&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;No Blank Checks for Data Centers.png&quot;,&quot;uri&quot;:&quot;356328_0855b5905dfd4e7abbc7e20958f757d0~mv2.png&quot;,&quot;height&quot;:1086,&quot;id&quot;:&quot;dataItem-mtixcsd7&quot;,&quot;alt&quot;:&quot;No Blank Checks for Data Centers.png&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;4uq-56&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:1448,&quot;url&quot;:&quot;https://static.wixstatic.com/media/356328_0855b5905dfd4e7abbc7e20958f757d0~mv2.png/v1/fill/w_1448,h_1086,al_c,q_90,enc_auto/356328_0855b5905dfd4e7abbc7e20958f757d0~mv2.png&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-mtiv5398" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img alt="No Blank Checks for Data Centers.png"/></picture></wow-image></div></div></div></interact-element><!--/$--><!--$--><div id="comp-mtiv53nf" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv53nf _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h3>01</h3></div><!--/$--><!--$--><div id="comp-mtiv53u2" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv53u2 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h4>No Blank Checks for Data Centers</h4></div><!--/$--><!--$--><div id="comp-mtiv540i" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv540i _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Protecting our local resources and neighborhood integrity by opposing taxpayer subsidies and halting unchecked, high-impact industrial data center projects in Precinct 4. We must prioritize residents over corporate expansion.</p></div><!--/$--></div><!--/$--></div><!--/$--><!--$--><div id="comp-mtiv5471" class="_root_1w52m_1 _minHeightFix_1w52m_5 container builder-root builder-root comp-mtiv5471"><!--$--><div id="comp-mtiv5474" class="container _internalContainerRoot_1xyyz_1 builder-root builder-root comp-mtiv5474 comp-mtiv5474-container" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mtiv547d1 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mtiv547d1" data-motion-part="BG_LAYER comp-mtiv547d1"></div><!--/$--></div><!--$--><interact-element data-interact-key="au9pd/Containerau9pd/PAGE_SECTIONSau9pd/comp-mthxf6ul/comp-mthxf6wy/comp-mtiv5471/comp-mtiv5474/comp-mtiv54fv"><div id="comp-mtiv54fv" class="_root_1vtez_1 builder-root builder-root comp-mtiv54fv image" style="--original-aspect-ratio:1"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-mtiv54fv"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-mtiv54fv"><wow-image id="img-comp-mtiv54fv" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-mtiv54fv&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;Protect Our Water &amp; Power.jpg&quot;,&quot;uri&quot;:&quot;356328_29520e10b1164c51a4ab165c20bb0e43~mv2.jpg&quot;,&quot;height&quot;:740,&quot;id&quot;:&quot;dataItem-mtixfm4t&quot;,&quot;alt&quot;:&quot;Protect Our Water &amp; Power.jpg&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;4uq-58&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:740,&quot;url&quot;:&quot;https://static.wixstatic.com/media/356328_29520e10b1164c51a4ab165c20bb0e43~mv2.jpg/v1/fill/w_740,h_740,al_c,q_85,enc_auto/356328_29520e10b1164c51a4ab165c20bb0e43~mv2.jpg&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-mtiv54fv" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img alt="Protect Our Water &amp; Power.jpg"/></picture></wow-image></div></div></div></interact-element><!--/$--><!--$--><div id="comp-mtiv54xn" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv54xn _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h3>02</h3></div><!--/$--><!--$--><div id="comp-mtiv556i" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv556i _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h4>Protect Our Water &amp; Power</h4></div><!--/$--><!--$--><div id="comp-mtiv55f0" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv55f0 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>We must safeguard our essential utilities and natural resources from heavy industrial demands to ensure reliable, affordable water and electricity for all residents. We will protect reservoirs and maintain local power infrastructure.</p></div><!--/$--></div><!--/$--></div><!--/$--><!--$--><div id="comp-mtiv55lz" class="_root_1w52m_1 _minHeightFix_1w52m_5 container builder-root builder-root comp-mtiv55lz"><!--$--><div id="comp-mtiv55m3" class="container _internalContainerRoot_1xyyz_1 builder-root builder-root comp-mtiv55m3 comp-mtiv55m3-container" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mtiv55mg _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mtiv55mg" data-motion-part="BG_LAYER comp-mtiv55mg"></div><!--/$--></div><!--$--><interact-element data-interact-key="au9pd/Containerau9pd/PAGE_SECTIONSau9pd/comp-mthxf6ul/comp-mthxf6wy/comp-mtiv55lz/comp-mtiv55m3/comp-mtiv55uv"><div id="comp-mtiv55uv" class="_root_1vtez_1 builder-root builder-root comp-mtiv55uv image" style="--original-aspect-ratio:1.6666666666666667"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-mtiv55uv"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-mtiv55uv"><wow-image id="img-comp-mtiv55uv" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-mtiv55uv&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;Stop Unnecessary Tax Break Subsidies.jpg&quot;,&quot;uri&quot;:&quot;356328_3784cd9d6e804e3d933dc57c3a6b2fa2~mv2.jpg&quot;,&quot;height&quot;:480,&quot;id&quot;:&quot;dataItem-mtixjqxp&quot;,&quot;alt&quot;:&quot;Stop Unnecessary Tax Break Subsidies.jpg&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;4uq-60&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:800,&quot;url&quot;:&quot;https://static.wixstatic.com/media/356328_3784cd9d6e804e3d933dc57c3a6b2fa2~mv2.jpg/v1/fill/w_800,h_480,al_c,q_85,enc_auto/356328_3784cd9d6e804e3d933dc57c3a6b2fa2~mv2.jpg&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-mtiv55uv" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img alt="Stop Unnecessary Tax Break Subsidies.jpg"/></picture></wow-image></div></div></div></interact-element><!--/$--><!--$--><div id="comp-mtiv56cj" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv56cj _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h3>03</h3></div><!--/$--><!--$--><div id="comp-mtiv56j6" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv56j6 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h4>Stop Unnecessary Tax Break Subsidies</h4></div><!--/$--><!--$--><div id="comp-mtiv56pi" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv56pi _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Budget balance sheet, fiscal report, or tax document Striving to end corporate handouts and wasteful incentives. Tish guarantees that every tax dollar is managed with open transparency and rigorous fiscal oversight.</p></div><!--/$--></div><!--/$--></div><!--/$--><!--$--><div id="comp-mtiv56x2" class="_root_1w52m_1 _minHeightFix_1w52m_5 container builder-root builder-root comp-mtiv56x2"><!--$--><div id="comp-mtiv56x43" class="container _internalContainerRoot_1xyyz_1 builder-root builder-root comp-mtiv56x43 comp-mtiv56x43-container" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mtiv56xc _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mtiv56xc" data-motion-part="BG_LAYER comp-mtiv56xc"></div><!--/$--></div><!--$--><interact-element data-interact-key="au9pd/Containerau9pd/PAGE_SECTIONSau9pd/comp-mthxf6ul/comp-mthxf6wy/comp-mtiv56x2/comp-mtiv56x43/comp-mtiv576d"><div id="comp-mtiv576d" class="_root_1vtez_1 builder-root builder-root comp-mtiv576d image" style="--original-aspect-ratio:1"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-mtiv576d"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-mtiv576d"><wow-image id="img-comp-mtiv576d" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-mtiv576d&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;Enforce Strict Local Controls.jpg&quot;,&quot;uri&quot;:&quot;356328_b5771e5a1d6b4a8ab5ab7dc06c1ac32a~mv2.jpg&quot;,&quot;height&quot;:740,&quot;id&quot;:&quot;dataItem-mtixkipv&quot;,&quot;alt&quot;:&quot;Enforce Strict Local Controls.jpg&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;4uq-62&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:740,&quot;url&quot;:&quot;https://static.wixstatic.com/media/356328_b5771e5a1d6b4a8ab5ab7dc06c1ac32a~mv2.jpg/v1/fill/w_740,h_740,al_c,q_85,enc_auto/356328_b5771e5a1d6b4a8ab5ab7dc06c1ac32a~mv2.jpg&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-mtiv576d" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img alt="Enforce Strict Local Controls.jpg"/></picture></wow-image></div></div></div></interact-element><!--/$--><!--$--><div id="comp-mtiv57od" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv57od _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h3>04</h3></div><!--/$--><!--$--><div id="comp-mtiv57wh" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv57wh _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h4> Enforce Strict Local Controls</h4></div><!--/$--><!--$--><div id="comp-mtiv584u" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv584u _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Empower Precinct 4 families by reclaiming local development control through dedicated oversight, intelligent zoning, and robust community standards that prioritize our residents over outside commercial interests.</p></div><!--/$--></div><!--/$--></div><!--/$--><!--$--><div id="comp-mtiv58cq" class="_root_1w52m_1 _minHeightFix_1w52m_5 container builder-root builder-root comp-mtiv58cq"><!--$--><div id="comp-mtiv58ct" class="container _internalContainerRoot_1xyyz_1 builder-root builder-root comp-mtiv58ct comp-mtiv58ct-container" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mtiv58d21 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mtiv58d21" data-motion-part="BG_LAYER comp-mtiv58d21"></div><!--/$--></div><!--$--><interact-element data-interact-key="au9pd/Containerau9pd/PAGE_SECTIONSau9pd/comp-mthxf6ul/comp-mthxf6wy/comp-mtiv58cq/comp-mtiv58ct/comp-mtiv58kc"><div id="comp-mtiv58kc" class="_root_1vtez_1 builder-root builder-root comp-mtiv58kc image" style="--original-aspect-ratio:1"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-mtiv58kc"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-mtiv58kc"><wow-image id="img-comp-mtiv58kc" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-mtiv58kc&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;ai-generated-IMAGE.jpg&quot;,&quot;uri&quot;:&quot;356328_c2f66aca521342f281b307ba635ded29~mv2.jpg&quot;,&quot;height&quot;:1024,&quot;id&quot;:&quot;dataItem-mtiv58kd1&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;oxz-1999&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:1024,&quot;url&quot;:&quot;https://static.wixstatic.com/media/356328_c2f66aca521342f281b307ba635ded29~mv2.jpg/v1/fill/w_1024,h_1024,al_c,q_85,enc_auto/356328_c2f66aca521342f281b307ba635ded29~mv2.jpg&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-mtiv58kc" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img role="presentation" alt=""/></picture></wow-image></div></div></div></interact-element><!--/$--><!--$--><div id="comp-mtiv5918" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv5918 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h3>05</h3></div><!--/$--><!--$--><div id="comp-mtiv597z" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv597z _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h4> Demand Public Transparency</h4></div><!--/$--><!--$--><div id="comp-mtiv59e8" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv59e8 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Restoring trust in the Commissioners Court by ensuring all county decisions remain open to public oversight and keeping every resident updated on the implications of each individual vote cast by leadership.</p></div><!--/$--></div><!--/$--></div><!--/$--><!--$--><div id="comp-mtiv59ko" class="_root_1w52m_1 _minHeightFix_1w52m_5 container builder-root builder-root comp-mtiv59ko"><!--$--><div id="comp-mtiv59kr" class="container _internalContainerRoot_1xyyz_1 builder-root builder-root comp-mtiv59kr comp-mtiv59kr-container" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mtiv59kz1 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mtiv59kz1" data-motion-part="BG_LAYER comp-mtiv59kz1"></div><!--/$--></div><!--$--><interact-element data-interact-key="au9pd/Containerau9pd/PAGE_SECTIONSau9pd/comp-mthxf6ul/comp-mthxf6wy/comp-mtiv59ko/comp-mtiv59kr/comp-mtiv59rx"><div id="comp-mtiv59rx" class="_root_1vtez_1 builder-root builder-root comp-mtiv59rx image" style="--original-aspect-ratio:1"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-mtiv59rx"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-mtiv59rx"><wow-image id="img-comp-mtiv59rx" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-mtiv59rx&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;Empowered Education &amp; Youth Development.jpg&quot;,&quot;uri&quot;:&quot;356328_587aac75c29e4d47a0be6744de4f3761~mv2.jpg&quot;,&quot;height&quot;:740,&quot;id&quot;:&quot;dataItem-mtixlzpq&quot;,&quot;alt&quot;:&quot;Empowered Education &amp; Youth Development.jpg&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;4uq-64&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:740,&quot;url&quot;:&quot;https://static.wixstatic.com/media/356328_587aac75c29e4d47a0be6744de4f3761~mv2.jpg/v1/fill/w_740,h_740,al_c,q_85,enc_auto/356328_587aac75c29e4d47a0be6744de4f3761~mv2.jpg&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-mtiv59rx" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img alt="Empowered Education &amp; Youth Development.jpg"/></picture></wow-image></div></div></div></interact-element><!--/$--><!--$--><div id="comp-mtiv5a6x" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv5a6x _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h3>06</h3></div><!--/$--><!--$--><div id="comp-mtiv5adm" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv5adm _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h4>Empowered Education &amp; Youth Development</h4></div><!--/$--><!--$--><div id="comp-mtiv5alg" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtiv5alg _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Drawing from her extensive background in bilingual education, Tish advocates for inclusive community growth, robust family support systems, and superior youth programming to benefit every neighborhood throughout Williamson County.</p></div><!--/$--></div><!--/$--></div><!--/$--></div></div><!--/$--></section><!--/$--><!--$--><section id="comp-mtea47co" tabindex="-1" data-block-level-container="Section" class="ke5pl1 section comp-mtea47co wixui-section fwXYgt" data-testid="section-container"><!--$--><div id="comp-mtea47d4" class="container _internalContainerRoot_1xyyz_1 builder-root theme-vars builder-root theme-vars comp-mtea47d4" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mtea47d6 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mtea47d6" data-motion-part="BG_LAYER comp-mtea47d6"></div><!--/$--></div><div data-testid="internal-container-content" role="group" class="comp-mtea47d4-container max-width-container"><!--$--><div id="comp-mteaad4y" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaad4y _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h2>01</h2></div><!--/$--><!--$--><div id="comp-mteaadni" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaadni _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h5>Check Your Voting Information</h5></div><!--/$--><!--$--><div class="wix-presets-wrapper w-d2ff230a-71c3-4e58-8742-d68f69a2de0b comp-mteaae6x-presets-wrapper"><div id="comp-mteaae6x" dir="ltr" class="builder-root builder-root comp-mteaae6x _root_1fluj_1 _fallbackDirection_uix1w_1 wixui-line line-wrapper"><div class="_line_1fluj_31 line"></div></div></div><!--/$--><!--$--><div id="comp-mteaaeqv" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaaeqv _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Please verify your registration and precinct status by utilizing the official Williamson County election resources to ensure you are ready to vote.</p></div><!--/$--><!--$--><div id="comp-muh0t7gx" class="_root_1vtez_1 builder-root builder-root comp-muh0t7gx image" style="--original-aspect-ratio:1.0296684118673647"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-muh0t7gx"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-muh0t7gx"><wow-image id="img-comp-muh0t7gx" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-muh0t7gx&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;uri&quot;:&quot;affb69_284b724f637e427c8be4cc5228805220~mv2.png&quot;,&quot;height&quot;:1200,&quot;id&quot;:&quot;dataItem-muh10d48&quot;,&quot;alt&quot;:&quot;Phone screenshot showing a Ballotpedia page listing candidates including Tish Flores as an Independent write-in&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;mvg-207&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;crop&quot;:{&quot;x&quot;:266,&quot;y&quot;:627,&quot;width&quot;:590,&quot;height&quot;:573},&quot;width&quot;:896,&quot;url&quot;:&quot;https://static.wixstatic.com/media/affb69_284b724f637e427c8be4cc5228805220~mv2.png/v1/crop/x_266,y_627,w_590,h_573/fill/w_590,h_573,al_c,q_85,enc_auto/affb69_284b724f637e427c8be4cc5228805220~mv2.png&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-muh0t7gx" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img alt="Phone screenshot showing a Ballotpedia page listing candidates including Tish Flores as an Independent write-in"/></picture></wow-image></div></div></div><!--/$--><!--$--><div id="comp-mteaab0l" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaab0l _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h2>How Does Write-In Voting Work?</h2></div><!--/$--><!--$--><div id="comp-mteaabj9" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaabj9 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Write-in voting allows voters to enter the name of a candidate who is running as a write-in candidate. It is essential for voters to always follow official election guidance to ensure their vote is counted properly.</p></div><!--/$--><!--$--><div id="comp-mteaaajg" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaaajg _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p><span>WRITE-IN VOTING</span></p></div><!--/$--><!--$--><div id="comp-mteaafr2" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaafr2 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h2>02</h2></div><!--/$--><!--$--><div id="comp-mteaagaa" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaagaa _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h5>Find Your Voting Location</h5></div><!--/$--><!--$--><div class="wix-presets-wrapper w-d2ff230a-71c3-4e58-8742-d68f69a2de0b comp-mteaagta-presets-wrapper"><div id="comp-mteaagta" dir="ltr" class="builder-root builder-root comp-mteaagta _root_1fluj_1 _fallbackDirection_uix1w_1 wixui-line line-wrapper"><div class="_line_1fluj_31 line"></div></div></div><!--/$--><!--$--><div id="comp-mteaahb6" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaahb6 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Consult official Williamson County election resources to confirm your specific polling site and to examine current ballot information.</p></div><!--/$--><!--$--><div id="comp-muh1e9ig" class="_root_1vtez_1 builder-root builder-root comp-muh1e9ig image" style="--original-aspect-ratio:0.75"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-muh1e9ig"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-muh1e9ig"><wow-image id="img-comp-muh1e9ig" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-muh1e9ig&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;Precinct 4 Candidate&quot;,&quot;uri&quot;:&quot;affb69_d2fb9988b4db428e80e7a29ca9d3aa79~mv2.jpg&quot;,&quot;height&quot;:2048,&quot;id&quot;:&quot;dataItem-muh41liz&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;mvg-1416&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:1536,&quot;url&quot;:&quot;https://static.wixstatic.com/media/affb69_d2fb9988b4db428e80e7a29ca9d3aa79~mv2.jpg/v1/fill/w_1536,h_2048,al_c,q_90,enc_auto/affb69_d2fb9988b4db428e80e7a29ca9d3aa79~mv2.jpg&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-muh1e9ig" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img role="presentation" alt=""/></picture></wow-image></div></div></div><!--/$--><!--$--><div id="comp-mteaaikh" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaaikh _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h2>03</h2></div><!--/$--><!--$--><div id="comp-mteaaj44" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaaj44 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h5>Follow the Write-In Instructions</h5></div><!--/$--><!--$--><div class="wix-presets-wrapper w-d2ff230a-71c3-4e58-8742-d68f69a2de0b comp-mteaajn3-presets-wrapper"><div id="comp-mteaajn3" dir="ltr" class="builder-root builder-root comp-mteaajn3 _root_1fluj_1 _fallbackDirection_uix1w_1 wixui-line line-wrapper"><div class="_line_1fluj_31 line"></div></div></div><!--/$--><!--$--><div id="comp-mteaak6n" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mteaak6n _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>To ensure your vote is valid, strictly follow the official instructions for write-in candidates. <span style="text-decoration:underline"><span style="font-weight:bold">Clearly print &#x27;Tish Flores&#x27; on the specific line for County Commissioner, Precinct 4, and be sure to mark the oval or box beside her name.</span></span></p></div><!--/$--></div></div><!--/$--></section><!--/$--><!--$--><section id="comp-mteba4hf" tabindex="-1" data-block-level-container="Section" class="ke5pl1 section comp-mteba4hf wixui-section fwXYgt" data-testid="section-container"><!--$--><div id="comp-mteba4hv" class="container _internalContainerRoot_1xyyz_1 builder-root theme-vars builder-root theme-vars comp-mteba4hv" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mteba4hw2 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mteba4hw2" data-motion-part="BG_LAYER comp-mteba4hw2"></div><!--/$--></div><div data-testid="internal-container-content" role="group" class="comp-mteba4hv-container max-width-container"><!--$--><div id="comp-mtebc8hb" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtebc8hb _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p><span>GET IN TOUCH</span></p></div><!--/$--><!--$--><div id="comp-mtebc8t4" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtebc8t4 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h2>Have a Question?</h2></div><!--/$--><!--$--><div id="comp-mtedyw6k" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtedyw6k _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>Whether it&#x27;s about the campaign, voting details, or issues facing Precinct 4, we&#x27;d love to hear from you. Send us a message and we&#x27;ll get back to you soon.</p></div><!--/$--><!--$--><div id="comp-mtebca58" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtebca58 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>PHONE</p></div><!--/$--><!--$--><div id="comp-mtebcah1" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtebcah1 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h5>512-365-0167</h5></div><!--/$--><!--$--><div id="comp-mtebcb55" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtebcb55 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>EMAIL</p></div><!--/$--><!--$--><div id="comp-mtebcbgq" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mtebcbgq _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h5><span style="text-decoration:underline"><a href="mailto:tishflores202@gmail.com" target="_self">tishflores202@gmail.com</a></span></h5></div><!--/$--><!--$--><div id="comp-mtebcbsd" class="QrIus  comp-mtebcbsd"><d