qep"></div><!--/$--></div><div data-testid="internal-container-content" role="group" class="comp-mte7vqac-container max-width-container"><!--$--><div id="comp-mte7vqat3" class="_root_1vtez_1 builder-root builder-root comp-mte7vqat3 image" style="--original-aspect-ratio:0.7780195865070729"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-mte7vqat3"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-mte7vqat3"><wow-image id="img-comp-mte7vqat3" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-mte7vqat3&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;unnamed (11).webp&quot;,&quot;uri&quot;:&quot;356328_7e8cf06f662a40a0ac94017c1e9b6944~mv2.webp&quot;,&quot;height&quot;:919,&quot;id&quot;:&quot;dataItem-mtecynvl&quot;,&quot;alt&quot;:&quot;unnamed (11).webp&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;41s-1021&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:715,&quot;url&quot;:&quot;https://static.wixstatic.com/media/356328_7e8cf06f662a40a0ac94017c1e9b6944~mv2.webp/v1/fill/w_715,h_919,al_c,q_85,enc_auto/356328_7e8cf06f662a40a0ac94017c1e9b6944~mv2.webp&quot;,&quot;displayMode&quot;:&quot;fill&quot;}}" data-motion-part="BG_IMG comp-mte7vqat3" data-is-responsive="true" class="_wowImage_1vtez_30"><picture><img alt="unnamed (11).webp"/></picture></wow-image></div></div></div><!--/$--><!--$--><div id="comp-mte7vqbj" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mte7vqbj _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h6>ABOUT TISH</h6></div><!--/$--><!--$--><div id="comp-mte7vqbt" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mte7vqbt _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><h2>Meet Tish Flores</h2></div><!--/$--><!--$--><div id="comp-mte7vqc83" class="_WRichTextNewSkin_vcky1_163 _supportTableDesign_vcky1_54 builder-root builder-root comp-mte7vqc83 _wrichtext_aqg9v_1 wrichtext wixui-rich-text" data-testid="richTextElement"><p>A Williamson County local for two decades, Tish Flores offers years of experience in regional administration and service. Now a write-in candidate for Commissioner of Precinct 4, she aims to give neighbors a renewed voice in their government. Tish lives in our community with her family and remains active in local civic life.</p>

<p> </p>

<p>As a Precinct 4 candidate, Tish is focused on understanding the responsibilities of the office and the needs of the community she hopes to represent.<br/>
 </p>

<p><span style="font-weight:bold">Tish Flores</span><br/>
Write-In Candidate for Williamson County Commissioner, Precinct 4</p></div><!--/$--></div></div><!--/$--></section><!--/$--><!--$--><section id="comp-mte9jrxe" tabindex="-1" data-block-level-container="Section" class="ke5pl1 section comp-mte9jrxe wixui-section fwXYgt" data-testid="section-container"><!--$--><div id="comp-mte9jry1" class="container _internalContainerRoot_1xyyz_1 builder-root theme-vars builder-root theme-vars comp-mte9jry1" data-testid="internal-container-root"><div class="_backgroundLayer_1xyyz_25" data-testid="internal-container-background-layer"><!--$--><div class="builder-root builder-root comp-mte9jry31 _background_x7ip3_1 _mask_x7ip3_35 background" id="comp-mte9jry31" data-motion-part="BG_LAYER comp-mte9jry31"></div><!--/$--></div><div data-testid="internal-container-content" role="group" class="comp-mte9jry1-container max-width-container"><!--$--><div id="comp-mthjbyol" class="_root_1vtez_1 builder-root builder-root comp-mthjbyol image" style="--original-aspect-ratio:1.4979757085020242"><div class="_image3_1vtez_5" data-motion-part="BG_LAYER comp-mthjbyol"><div class="_imageLayer_1vtez_20" data-motion-part="BG_MEDIA comp-mthjbyol"><wow-image id="img-comp-mthjbyol" data-image-info="{&quot;alignType&quot;:&quot;center&quot;,&quot;containerId&quot;:&quot;comp-mthjbyol&quot;,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;name&quot;:&quot;aerial-view-shanghai-overpass-night_1359-39.jpg&quot;,&quot;uri&quot;:&quot;356328_424737e901bd435d8aec976b1dbb0190~mv2.jpg&quot;,&quot;height&quot;:494,&quot;id&quot;:&quot;dataItem-mthjcqub&quot;,&quot;alt&quot;:&quot;aerial-view-shanghai-overpass-night_1359-39.jpg&quot;,&quot;type&quot;:&quot;Builder.Image&quot;,&quot;metaData&quot;:{&quot;isHidden&quot;:false,&quot;sig&quot;:&quot;49x-407&quot;,&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;isPreset&quot;:false},&quot;width&quot;:740,&quot;url&quot;:&quot;https://static.wixstatic.com/media/356328_424737e901bd435d8aec976b1dbb0190~mv2.jpg/v1