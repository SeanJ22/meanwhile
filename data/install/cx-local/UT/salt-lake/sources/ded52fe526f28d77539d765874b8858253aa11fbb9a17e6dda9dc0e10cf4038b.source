	.rzFaqBtn>i{width:25px;height:25px;background:#fff;text-align:center;border-radius:5px;border:1px solid #99F;padding-top:4%}
	.rzFaqBtn>i.fa-trash{color:#bb2727;border-color:#bb2727}
