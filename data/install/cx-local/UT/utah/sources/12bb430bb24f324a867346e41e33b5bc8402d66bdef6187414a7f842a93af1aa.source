,{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1-k3kamv9g3ct.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/1s7y4n5r-g015.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/2l9_62oc27qdd.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"data-tenant\":\"vote\",\"className\":\"$undefined\",\"children\":[\"$\",\"body\",null,{\"className\":\"@container flex min-h-screen flex-col\",\"children\":[[\"$\",\"$L4\",null,{\"tenant\":\"vote\",\"children\":[[\"$\",\"main\",null,{\"className\":\"min-h-screen grow\",\"children\":[\"$\",\"$L5\",null,{\"overrides\":{\"gray-hero\":\"gray-hero-opaque\"},\"children\":[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":\"$0:f:0:1:0:props:children:1:props:notFound:0:1:props:style\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":\"$0:f:0:1:0:props:children:1:props:notFound:0:1:props:children:props:children:1:props:style\",\"children\":404}],[\"$\",\"div\",null,{\"style\":\"$0:f:0:1:0:props:children:1:props:notFound:0:1:props:children:props:children:2:props:style\",\"children\":[\"$\",\"h2\",null,{\"style\":\"$0:f:0:1:0:props:children:1:props:notFound:0:1:props:children:props:children:2:props:children:props:style\",\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}],[\"$\",\"$L6\",null,{\"footerTitle\":\"Elections\",\"socials\":{\"facebook\":\"https://www.facebook.com/UtahCoElections/\"},\"contact\":{\"email\":\"elections@utahcounty.gov\",\"phone\":\"801-851-VOTE (8683)\",\"address\":\"100 East Center Street, Suite 3100, Provo, UT 84606\",\"mapUrl\":\"https://www.google.com/maps/search/?api=1\u0026query=100%20East%20Center%20Street%2C%20Suite%203100%2C%20Provo%2C%20UT%2084606\"},\"columns\":[{\"title\":\"Voting\",\"links\":[{\"name\":\"Results\",\"href\":\"/results\"},{\"name\":\"Information For Voters\",\"href\":\"/voter-information\"},{\"name\":\"Voting Locations\",\"href\":\"/voting-locations\"}]},{\"title\":\"Candidates\",\"links\":[{\"name\":\"List of Candidates\",\"href\":\"/list-of-candidates\"},{\"name\":\"Information For Candidates\",\"href\":\"/candidate-information\"},{\"name\":\"Financial Disclosures\",\"href\":\"/financial-disclosures\"},{\"name\":\"Conflict Of Interest Forms\",\"href\":\"/conflict-of-interest-forms\"}]},{\"title\":\"Resources\",\"links\":[{\"name\":\"Forms\",\"href\":\"/forms\"},{\"name\":\"Maps\",\"href\":\"/maps\"},{\"name\":\"Notices\",\"href\":\"/public-notices\"},{\"name\":\"Petitions\",\"href\":\"/petitions\"}]},{\"title\":\"Contact\",\"links\":[{\"name\":\"Contact\",\"href\":\"/contact\"},{\"name\":\"Calendar\",\"href\":\"/calendar\"},{\"name\":\"Volunteer\",\"href\":\"/volunteer\"}]}],\"logoSrc\":\"$undefined\",\"logoAlt\":\"$undefined\",\"siteDirectoryHref\":\"$undefined\"}]]}],[\"$\",\"$L7\",null,{\"src\":\"https://cdn.userway.org/widget.js\",\"data-account\":\"xmHsDOsjY7\",\"data-position\":\"5\",\"strategy\":\"afterInteractive\"}]]}]}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[null,\"$L8\"]}],{\"children\":[\"$L9\",{},null,false,null]},null,false,\"$a\"]},null,false,null]},null,false,\"$a\"],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"S\":false,\"h\":null,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"sIsnY08LyUQPbDhVZf1cI\"}\ne:I[94199,[\"/_next/static/chunks/29_p6zuja9uuj.js\"],\"OutletBoundary\"]\nf:\"$Sreact.suspense\"\n11:I[94199,[\"/_next/static/chunks/29_p6zuja9uuj.js\"],\"ViewportBoundary\"]\n13:I[94199,[\"/_next/static/chunks/29_p6zuja9uuj.js\"],\"MetadataBoundary\"]\n8:[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]\n9:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/05kpobrztuzf7.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$\",\"$f\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@10\"}]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L11\",null,{\"children\":\"$L12\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L13\",null,{\"children\":[\"$\",\"$f\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L14\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\na:C\nd:[\"$\",\"article\",null,{\"children\":\"$L15\"}]\n17:I[79869,[\"/_next/static/chunks/1s7y4n5r-g015.js\",\"/_next/static/chunks/2l9_62oc27qdd.js\",\"/_next/static/chunks/05kpobrztuzf7.js\"],\"default\"]\n18:I[82578,[\"/_next/static/chunks/1s7y4n5r-g015.js\",\"/_next/static/chunks/2l9_62oc27qdd.js\",\"/_next/static/chunks/05kpobrztuzf7.js\"],\"Breadcrumb\"]\n19:I[52268,[\"/_next/static/chunks/1s7y4n5r-g015.js\",\"/_next/static/chunks/2l9_62oc27qdd.js\",\"/_next/static/chunks/05kpobrztuzf7.js\"],\"\"]\n1a:I[47038,[\"/_next/static/chunks/1s7y4n5r-g015.js\",\"/_next/static/chunks/2l9_62oc27qdd.js\",\"/_next/static/chunks/05kpobrztuzf7.js\"],\"PublicNoticeArchive\"]\n12:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n1b:T831,Alys O’Brien is Utah County's Employee of the Month for September 2026.  Her work helps ensure that Utah County’s records are accurate, up to date, and useful to the people who rely on them. Since joining the Utah County Assessor’s Office in August 2023, she has brought real estate experience, a strong sense of responsibility, and a collaborative approach to her work.\n\nOne of Alys’s major responsibilities is coordinating building permits from 28 jurisdictions throughout the county. In 2025, she received and processed 10,827 permits. For each one, she identifies key information and routes it to the appropriate field appraiser. That work helps the Assessor’s Office track new construction, maintain an accurate tax roll, and account for growth across Utah County.\n\nAlys is also proactive about getting the information the office needs. If permits are missing or a city’s submissions are delayed, she follows up with city personnel and her supervisor to help make sure nothing is overlooked. She is currently working with a data analyst to explore using AI software to extract relevant information from permits more efficiently.\nHer attention to detail benefits colleagues across the county, too. A GIS Division employee who maintains address points used in the 911 system praised Alys for entering clean, accurate address information and keeping them informed about changes. When questions or errors come up, Alys is helpful and solutions-oriented, either resolving the issue herself or connecting the employee with someone who can.\n\nAlongside these responsibilities, Alys assists residents at the front counter and answers incoming calls. Colleagues describe her as pleasant, dependable, and easy to work with. She brings a sense of humor to the office, while staying focused when it’s time to get the work done.\n\nMuch of Alys’s contribution happens behind the scenes, but its impact is clear. Her diligence supports accurate records, responsive service, and the important work of the Assessor’s Office. Congratulations, Alys, and thank you for all you do for Utah County!1c:T66a,Board members may participate electronically, when necessary, with the anchor location designated as stated above.\nThe public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes per individual unless otherwise approved by the Board.\nYou may watch the meeting live on YouTube under the heading UTAH COUNTY GOVERNMENT or by going to the link: https://www.youtube.com/@UtahCountyGovernment/streams\n\nREGULAR AGENDA\n\n1.  APPROVAL OF THE MINUTES FOR THE DECEMBER 5, 2025 ADMINISTRATIVE CONTROL BOARD OF THE UTAH VALLEY ROAD SPECIAL SERVICE DISTRICT PUBLIC MEETING\n\t-Jolynn Clegg, Clerk\n\n2.  ADOPT A RESOLUTION APPROVING AND TENTATIVELY ADOPTING THE 2027 TENTATIVE BUDGET FOR THE GENERAL FUND AND OTHER BUDGETARY FUNDS OF THE UTAH VALLEY ROAD SPECIAL SERVICE DISTRICT, AND SET A DATE, TIME, AND LOCATION FOR A PUBLIC HEARING TO DISCUSS THE 2027 CALENDAR YEAR BUDGET FOR THE GENERAL FUND AND OTHER BUDGETARY FUNDS OF THE UTAH VALLEY ROAD SPECIAL SERVICE DISTRICT, FOR WEDNESDAY, NOVEMBER 18, 2026, AT 2:00 P.M. IN THE UTAH COUNTY ADMINISTRATION BUILDING, 100 EAST CENTER STREET, ROOM 1400, PROVO, UTAH\n\t-Aileen Conder, Commission\n\nPUBLIC COMMENTS\n\nNOTICE OF SPECIAL ACCOMMODATION DURING PUBLIC MEETINGS - In compliance with the Americans with Disabilities Act, individuals needing special accommodations (including auxiliary communicative aids and services) during this meeting should notify the Utah County Clerk's Office at 801-851-8113. Handicap parking is available as well as a level entrance to the building. Interpretation services are available with prior notice for the hearing disabled. \n1d:T656,Board members may participate electronically, when necessary, with the anchor location designated as stated above.\nYou may watch the meeting live on YouTube under the heading UTAH COUNTY GOVERNMENT or by going to the link: https://www.youtube.com/@UtahCountyGovernment/streams\nThe public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes per individual unless otherwise approved by the Board.\n\nREGULAR AGENDA\n\n1.  APPROVAL OF THE MINUTES FOR THE JULY 22, 2026 UTAH COUNTY COMMUNITY REINVESTMENT AGENCY PUBLIC MEETING\n\t-Jolynn Clegg, Clerk\n\n2.  ADOPT A RESOLUTION APPROVING AND TENTATIVELY ADOPTING THE 2027 TENTATIVE BUDGET FOR THE GENERAL FUND AND OTHER BUDGETARY FUNDS OF THE COMMUNITY REINVESTMENT AGENCY OF UTAH COUNTY, UTAH, AND SET A DATE, TIME, AND LOCATION FOR A PUBLIC HEARING TO DISCUSS THE 2027 CALENDAR YEAR BUDGET FOR THE GENERAL FUND AND OTHER BUDGETARY FUNDS OF THE COMMUNITY REINVESTMENT AGENCY OF UTAH COUNTY, UTAH, FOR WEDNESDAY, NOVEMBER 18, 2026, AT 2:00 P.M. IN THE UTAH COUNTY ADMINISTRATION BUILDING, 100 EAST CENTER STREET, ROOM 1400, PROVO, UTAH.\n\t-Aileen Conder, Commission\n\nPUBLIC COMMENTS\n\nNOTICE OF SPECIAL ACCOMMODATION DURING PUBLIC MEETINGS - In compliance with the Americans with Disabilities Act, individuals needing special accommodations (including auxiliary communicative aids and services) during this meeting should notify the Utah County Clerk's Office at 801-851-8113. Handicap parking is available as well as a level entrance to the building. Interpretation services are available with prior notice for the hearing disabled. \n1e:T1414,NOTICE OF PUBLIC HEARING AND BONDS TO BE ISSUED\n\nNOTICE IS HEREBY GIVEN pursuant to the provisions of the Local Government Bonding Act, Title 11, Chapter 14, Utah Code Annotated 1953, as amended (the “Act”), that on October 7, 2026, the Board of County Commissioners (the “Commission”) of Utah County, Utah (the “Issuer”), adopted a resolution (the “Resolution”) in which it authorized the issuance of the Issuer’s Sales Tax Revenue Bonds, Series 2026 (the “Series 2026 Bonds”) (to be issued in one or more series and with such other series or title designation(s) as may be determined by the Issuer), and called a public hearing to receive input from the public with respect to (a) the issuance of the Series 2026 Bonds and (b) any potential economic impact that the Series 2026 Project (defined below) financed with the proceeds of the Series 2026 Bonds may have on the private sector.\n\nTIME, PLACE AND LOCATION OF PUBLIC HEARING\nThe Issuer shall hold a public hearing on November 4, 2026, at the hour of 2:00 p.m. at 100 East Center Street, Room 1400, Provo, Utah.  The purpose of the hearing is to receive input from the public with respect to (a) the issuance of the Series 2026 Bonds and (b) any potential economic impact that the Series 2026 Project (defined below) to be financed with the proceeds of the Series 2026 Bonds may have on the private sector.  All members of the public are invited to attend and participate.\n\nPURPOSE FOR ISSUING THE SERIES 2026 BONDS\nThe Series 2026 Bonds will be issued for the purpose of (a) financing the construction of a new public works facility and related improvements (the “Series 2026 Project”), (b) funding any debt service reserve funds, as necessary, and (c) paying costs of issuance of the Series 2026 Bonds.\n\nPARAMETERS OF THE SERIES 2026 BONDS\nThe Issuer intends to issue the Series 2026 Bonds in the aggregate principal amount of not more than Thirty Million Dollars ($30,000,000), to mature in not more than twenty-one (21) years from their date or dates, to be sold at a price not less than ninety-eight percent (98%) of the total principal amount thereof and bearing interest at a rate or rates not to exceed six and one half percent (6.50%).  The Series 2026 Bonds are to be issued and sold by the Issuer pursuant to the Resolution, including as part of said Resolution, a General Indenture of Trust and a Supplemental Indenture of Trust (together, the “Indenture”) which were before the Commission in substantially final form at the time of the adoption of the Resolution and said Indenture is to be executed by the Issuer in such form and with such changes thereto as shall be approved by the Issuer; provided that the principal amount, interest rate or rates, maturity, and discount of the Series 2026 Bonds will not exceed the maximums set forth above.  The Issuer reserves the right to not issue the Series 2026 Bonds for any reason and at any time up to the issuance of the Series 2026 Bonds.\n\nSALES AND USE TAXES PROPOSED TO BE PLEDGED\nThe Issuer proposes to pledge all of the revenues produced by the sales and use taxes levied by the Issuer under the County Option Sales and Use Tax revenues received by the Issuer pursuant to Title 59, Chapter 12, Part 11, Utah Code Annotated 1953, as amended, for the Series 2026 Bonds and all or any portion of other sales or excise taxes legally available to be pledged to the Series 2026 Bonds (the “Revenues”).\n\nOUTSTANDING BONDS SECURED BY PLEDGED TAXES\nThe Issuer currently has $420,000 of bonds outstanding secured by the Revenues.\n\nOTHER OUTSTANDING BONDS OF THE ISSUER\nAdditional information regarding the Issuer’s outstanding bonds may be found in the Issuer’s financial report (the “Financial Report”) at:  http://secure.utah.gov/auditor-search/.  For additional information, including any information more recent than as of the date of the Financial Report, please contact the County Auditor at (801) 851-8110.\n\nTOTAL ESTIMATED COST OF BONDS\nBased on the Issuer’s current plan of finance and a current estimate of interest rates, the total principal and interest cost of the Series 2026 Bonds to be issued under the Act to finance the Series 2026 Project, if held until maturity, is $37,561,157.\n\nA copy of the Resolution and the Indenture are on file in the office of the Utah County Clerk, 100 East Center Street, Provo, Utah, where they may be examined during regular business hours from 8:00 a.m. to 5:00 p.m. Monday through Friday, for a period of at least thirty (30) days from and after the date of publication of this notice.\n\nNOTICE IS FURTHER GIVEN that a period of thirty (30) days from and after the date of the publication of this notice is provided by law during which any person in interest shall have the right to contest the legality of the Resolution, the Indenture (as it pertains to the Series 2026 Bonds), or the Series 2026 Bonds, or any provision made for the security and payment of the Series 2026 Bonds, and that after such time, no one shall have any cause of action to contest the regularity, formality, or legality thereof for any cause whatsoever.\n\n\n1f:T78c,UTAH COUNTY, Utah — A proposed ordinance in Utah County would create tight restrictions on any potential data-center development, aiming to protect ratepayers, water resources and the environment while preserving private property rights. The ordinance, still awaiting the Planning Commission’s recommendation, would require compliance with those development restrictions along with the holding of two public meetings and other steps before a data-center permit application could be filed. \n\nUtah County Commissioner Amelia Powers Gardner said data centers are not new to the county. Bluffdale’s NSA facility was among the first, and in the Eagle Mountain area, Meta has had a presence with an agreement in place for more than five years and QTS has operated there for some time. She noted that Utah County has been studying data-center projects for several years and has sought to learn from existing deployments elsewhere.\n\n“We want to make sure that any impact to infrastructure is paid for by the business,” said Gardner. “We want to make sure we’re not negatively affecting our citizens. And we want to protect the environment for future generations.”\n\nThe proposed ordinance would only apply for data centers proposed to be located in the unincorporated areas of Utah County and would require extensive plans for and consideration of potential impacts, including environmental, air quality, noise, ground water, and power and water consumption. The county has been examining what standards and protections should be mandated by county ordinance when a proposed data center seeks to come to the area, and the process has benefited from input from the public.  There are no current application requests for any proposed data centers in the unincorporated area of Utah County.  This ordinance is a way for Utah County to get in front of any applications with a clear policy that defines expectations on all sides.\n20:T470,PUBLIC NOTICE IS HEREBY GIVEN THAT THE \n\n**UTAH COUNTY CAREER SERVICE COUNCIL**\n\nWILL HOLD A PUBLIC MEETING\n\nIN THE THIRD-FLOOR CONFERENCE ROOM– SUITE 3800\n\nOF THE UTAH COUNTY ADMINISTRATION BUILDING\n\n100 East Center Street, Provo, Utah\n\n**September 24, 2026 – 5:30 P.M.**\n\n_(The order of this agenda is subject to change at the discretion of the Council.)_                                                      \n\n**AGENDA**\n\n1.  APPROVE RESOLUTION ESTABLISHING GUIDELINES AND OPERATING PROCEDURES FOR APPEAL HEARINGS\n2.  CONDUCT PRE-HEARING MEETING FOR DIANA JOHNSON APPEAL \n3.  APPROVE AND SET A DATE, TIME AND LOCATION FOR A CLOSED MEETING TO DISCUSS THE CHARACTER, PROFESSIONAL COMPETENCE, OR PHYSICAL OR MENTAL HEALTH OF AN INDIVIDUAL OR INDIVIDUALS FOR TODAY’S DATE, AT THIS LOCATION, AS NEEDED. \n\n_In compliance with the American Disabilities Act, individuals needing special accommodations (including auxiliary communicative aids and service) during this meeting should notify the Utah County Human Resources at (801) 851-8158 at least one day prior to the meeting._21:T66c,Sgt. Zac Robinson is Utah County's Employee of the Month for September 2026.  He is a leader, mentor, and brings strategic contributions to both the Utah County Search and Rescue (SAR) Team and the county’s aviation program.\n\nIn 2026, he took on the responsibility of training a group of 10 new members, investing hours of expertise to ensure they are well-prepared to excel in their roles. His commitment to fostering talent reflects a deep-rooted dedication to the team’s long-term success and continuity.\n\nBeyond training, Sgt. Robinson has been instrumental in guiding the aviation unit’s growth and future direction. Over the past several months, he has led the effort to research and evaluate aircraft options to ensure the Sheriff’s Office selects a platform that best meets the unit’s operational needs. This work required extensive analysis, coordination with industry professionals, and a thorough understanding of mission requirements. \n\nHe devoted countless hours to comparing performance data, safety features, cost considerations, and operational versatility, delivering clear, well-supported recommendations that will influence the future effectiveness of Utah County’s aviation operations.\n\nThe excellence in his work is underscored by the ongoing process of acquiring a DA62 MPP aircraft. This aircraft is expected to provide enhanced service and a greater sense of security to the citizens of Utah County, a goal aligned with Sgt. Robinson’s commitment to public safety and operational readiness.\n\nHis contributions and dedication make him a highly deserving candidate for recognition as Employee of the Month.22:T544,NOTICE OF VACANCIES ON THE SPRINGVILLE DRAINAGE DISTRICT BOARD OF TRUSTEES\n\nNotice is hereby provided this 16th day of September 2026, pursuant to Utah Code Section 17B-1-304 that three (3) vacancies currently exist on the Springville Drainage District Board of Trustees (the “Board”). To be qualified for consideration for the above-mentioned Board vacancies, the individuals (i) must be a registered voter at the location of the member’s residence, and (ii) a resident residing within the boundaries of the Springville Drainage District (the “District”) or an officer or employee of Utah County. The individuals interested in being considered for the vacant Board positions outlined above should send a letter expressing their interest, together with a brief description of their qualifications and eligibility for the Board positions to: boards@utahcounty.gov. All letters of interest in the vacant Board positions must be received by the Board of County Commissioners, Utah County, Utah, on or before 5:00 p.m. on Friday, October 30, 2026. The Board of County Commissioners, Utah County, Utah, will review and evaluate all individuals that qualify for consideration pursuant to the guidelines listed above and will appoint individuals to fill the vacancies by resolution.\n\n[VIEW NOTICE](/api/media/file/Notice_2026_724_8045506146.pdf)23:T7ab,Elections Director, Nicole Stevens was honored with the Pillar of Democracy Award at Utah’s Excellence in Elections Award Banquet.   \n   \nThe words on the certificate say it perfectly:   \n   \n“In recognition of her extraordinary mentorship, generosity, and swift support, and for her steadfast dedication to empowering neighboring election offices. By volunteering her time, sharing resources, and providing critical equipment during crises, she exemplifies the highest spirit of collaboration and public service in Utah elections.”   \n   \nElections are never the work of one person or one office. Behind every election are people sharing knowledge, answering calls, solving problems, loaning equipment, stepping in when another office needs help, and doing whatever it takes to serve voters.  Nicole has always believed that when another election office needs help, help is provided. County lines don’t change that.   \n   \nUtah County is proud that Nicole has been recognized for her mentorship, collaboration, and for supporting her fellow election officials. Those are values she works hard to live by on a daily basis. County Commissioner Amelia Powers Gardner wrote a letter recognizing Nicole (Nikki), sharing a story of a time in 2023, when she and her colleague Jenn offered their expertise and taught staff the essentials of administering an election. Scroll to the accompanying images to read the letter.\n\nShe often emphasizes that she can’t do it without her amazing team, whose hard work, support, and unwavering spirit form the backbone of this success.  \n   \n“I love this profession. I love the people I get to work alongside. And I’m incredibly proud of the work we do. I am honored to work under Lt. Governor Deidre Henderson and her amazing staff! They make Utah Elections possible.” - Nicole Stevens    \n   \nNicole Stevens, on behalf of everyone at Utah County, you epitomize the Pillar of Democracy. Congratulations!24:Tb97,UTAH COUNTY, Utah — Utah County will expand the UTA Connect on-demand ride-share program to address the last mile of public transit, linking FrontRunner stations and other hubs to homes, work and errands in a fast-growing region.\n\n“In the transit and transportation world, that is the distance from your main transit hub,” Utah County Commissioner Skyler Beltran said, explaining the term last mile. “How do we get people from those locations to their home or to the service that they are using or to their job, which is typically within a couple miles? And this connects them from the main hub to where they need to go?”\n\nThe expansion targets Eagle Mountain, Saratoga Springs, Lehi and a portion of American Fork, with the aim of easing congestion as the county’s population swells. Beltran described the plan as a proactive step to begin building ridership for UTA and public transit in a region where traffic and gridlock are persistent issues.\n\n“This on-demand service will allow you in Eagle Mountain, Saratoga, Lehi to go within six miles,” Beltran said, adding that there is no cap if you travel to the Lehi or American Fork FrontRunner stations, which links riders into the broader network.\n\nOfficials emphasize that UTA Connect is not intended to compete with private ride-hailing services. Beltran highlighted several differentiators: a network that keeps trips within the UTA system and a shared-ride model that pools riders headed in similar directions.\n\n“We do not want to compete with the private sector; there are key differences—the network connection within the UTA system and the shared ride,” he said.\n\nRiders will pay $2.50 per trip, with service available within two hours of a ride request. The fare allows trips from city centers to FrontRunner stations or across the network, and trips can be requested through the On Demand UTA app, which will indicate the driver’s arrival time and availability.\n\n“It is two dollars and fifty cents,” Beltran said, with a note that the app makes the service simple and intuitive to hail and track.\n\nThe move comes as Utah County anticipates continued rapid growth. Beltran noted that Eagle Mountain was the ninth-fastest growing city in the United States in 2025, and the expanded service area will reach about 180,000 people across Saratoga Springs, Lehi and Eagle Mountain, all while roughly $1.5 billion in road projects proceed concurrently.\n\nBeltran argued the shift could boost mobility for students, people with disabilities and the elderly, potentially reducing car trips and easing gridlock as the region expands. He cited examples of local families already benefiting from on-demand options and emphasized the broader economic and mobility advantages of the program.\n\nOfficials say the rollout aims to improve access to work, education and essential services while moving the county closer to managing growth in a way that keeps people connected and reduces congestion.25:T49a,NOTICE OF PUBLIC HEARING\n\nIn accordance with Utah Code Sections 17-36-23, 17-36-24, and 17-36-26, the Board of County Commissioners, Utah County, Utah will hold a public hearing on Wednesday, September 23, 2026 at 2:00 p.m. at the Utah County Administration Building, 100 East Center Street, Room 1400, Provo, Utah, to consider amending the budgets in the County's general fund and various other budgetary funds; to consider revisions to the County's estimates of revenues; to consider revising the budget appropriations of county departments; and/or to consider transferring unencumbered or unexpected appropriation balances from one department in a fund to another department in the same fund. After the public hearing the Board of County Commissioners, Utah County, Utah, may amend the 2026 County's general fund budget and the various other County budgetary funds, may revise the County's estimates of revenues, may revise the budget appropriations of county departments, and/or may transfer unencumbered or unexpended appropriation balances from one department in a fund to another department in the same fund.\n\n[VIEW NOTICE](/api/media/file/Notice_2026_702_2eb0a33ae1.pdf)26:T47f,PROVO, Utah — The Provo Airport opened a new snow-removal equipment building, a facility officials say will speed winter operations and help keep runways clear during storms.\n\n“We have over 3,000,000 square feet of concrete and asphalt that needs to be snow plowed on a daily basis in a snowstorm,” Commissioner Beltran said. “This building will house all this equipment and it’s an awesome feature here at the Provo Airport.” He added that the project fits into a broader growth plan for the airport, which is moving from four gates to ten to accommodate increasing passengers, aircraft and services.\n\nBeltran noted that July was “the best month ever” in the airport’s history, a trend he said continues with ongoing monthly records. He also highlighted the airport’s current reach: 16 nonstop destinations weekly with American Airlines, Allegiant and Breeze as partners, and he encouraged people to consider flying out of Provo. He said the airport’s proximity from car to gate—through security to the concourse—is smoother than at Salt Lake City International, calling the process a “very smooth, seamless” experience.27:T6cc,Heather Eskelson is Utah County's Employee of the Month for August 2026. A little something about Heather...She goes out of her way to help her co-workers and willingly takes on extra tasks without being asked. She is patient with court patrons and her colleagues, staying calm and collected even in challenging situations. She has a great sense of humor and very creative, and she is consistently present and productive—she gets her work done quickly and is dependable and kind, making her a fantastic co-worker.\n\nHeather is also an amazing UCEA board member. She is always willing to serve on the board and help where needed. UCEA cannot run without people who are willing to contribute to our activities, and Heather embodies that spirit.\n\nHeather was recently promoted within the justice court due to her commitment and dedication to the citizens of Utah and other states. She is truly amazing at what she does. \n\nKim Love – Heather’s supervisor stated “I often tell Heather that I wish we could multiply her, like in the movie Multiplicity, because she is such a valuable part of the Justice Court team. She works well with every team member, is always pleasant, and I don’t think I’ve ever heard her complain. We know that she will complete any task she’s asked to do accurately and in a timely manner. I love listening to her conversations with our patrons; she is always kind, patient, and explains information in a way that patrons can understand and act on. She has been working with our front counter team, and we are excited for her to start collaborating with our in-court team. I am confident she will continue to do a great job there. Heather is definitely deserving of recognition as Employee of the Month.”28:T961,UTAH COUNTY, Utah — As part of the ongoing America 250 celebration, Utah County is launching the \"250 Sleeping Mats\" community donation campaign, with a goal of providing 250 new sleeping mats for this year's Utah County Warming Center before it opens on November 1.\n\nThe campaign offers residents a simple way to make a meaningful difference for some of the community's most vulnerable neighbors. Community members can purchase a sleeping mat directly from Utah County’s Amazon Wish List, and it will be shipped straight to the facility for use during the upcoming warming center season.  https://bit.ly/4xBC0GP\n\nLast winter, the Utah County Warming Center provided thousands of safe overnight stays for individuals experiencing homelessness, offering shelter from dangerous winter temperatures while connecting guests with critical support services. Sleeping mats are an essential part of creating a safe, comfortable, and dignified environment for those seeking refuge.\n\n\"This donation campaign is a meaningful way for residents to help the community warming center and the people it serves,\" said Utah County Commission Chair Skyler Beltran. \"Our warming center program continues to improve each year as we make meaningful progress in reducing the number of community members experiencing homelessness. As we commemorate America's 250th anniversary, this is an opportunity for all of us to demonstrate the spirit of service and compassion that has long defined our nation and our community.\"\n\n\"Ensuring a safe and warm place for our most vulnerable community members is our top priority, and these sleeping mats are a tremendous help,\" said Heather Hogue, Program Manager for Mountainland Continuum of Care. \"Every donation directly supports individuals seeking shelter this winter and demonstrates the compassion that makes Utah County such a caring community.\"\n\nThe \"250 Sleeping Mats\" campaign reflects the spirit of America 250 by encouraging community members to give back through service. Organizers hope to collect all 250 mats before the warming center opens on November 1, ensuring every guest has a safe and comfortable place to sleep throughout the winter season.\n\nResidents are encouraged to donate early and share the campaign with family, friends, businesses, and community organizations to help reach the goal of 250 sleeping mats before the start of the warming center season.29:T78f,If you come across an animated video that looks like this...it’s click-bait.  It’s false.  Not true. It’s trying to trick you! \n\nHERE ARE THE FACTS \n\n• There is no federal law that grants property tax assessment caps based on age. Property taxes are governed by state and local governments, not the federal government. \n\n• Claims about a federal mandate, a \"universal master form,\" or special tax benefits based on the decade you were born are disinformation from sensationalized online videos designed to generate clicks. \n\n• No federal spending package has changed Utah's local property tax laws. \n\nPlease do not be misled into watching these videos or purchasing unrelated financial products based on these false claims. \n\nFOR UTAH PROPERTY OWNERS \n\n• Utah does NOT have a senior property tax freeze program that locks in your home's assessed value. \n\n• Utah DOES offer a property tax reduction program known as the Circuit Breaker program for qualifying homeowners. Information about this program is available through the Auditor's Office. \n\n• Homeowners can also verify that their property receives the Primary Residential Exemption, which exempts 45% of your home's fair market value from property taxes when the property is your primary residence, regardless of age or income. \n\nIMPORTANT REMINDER\n\nNew Utah legislation requires a Residential Exemption form to be filed with the Assessor's Office whenever there is a name change on a property. The form is available on our website. \n\nPlease be cautious about the information you share online and avoid providing personal information through \"unofficial\" forms or websites. If you have questions about your property's assessment, exemptions, or available tax relief programs, click this link: auditor.utahcounty.gov/tax-relief \n\nOur office is here to help. We encourage you to contact us directly so you can receive accurate, reliable information.2a:T52c,NOTICE OF VACANCY ON THE ALPINE COVE WATER SPECIAL SERVICE DISTRICT ADMINISTRATIVE CONTROL BOARD\n\nNotice is hereby provided this 22nd day of July 2026, pursuant to Utah Code Section 178-1-304, that one (I) vacancy currently exists on the Alpine Cove Water Special Service District Administrative Control Board (the \"Board\"). To be qualified for consideration for the above-mentioned Board vacancy, the individual must be a registered voter within the boundaries of the Alpine Cove Water Special Service District (the \"District\") or an officer or employee of Utah County.\n\n  \nThose individuals interested in being considered for the vacant Board position outlined above should send a letter expressing their interest, together with a brief description of their qualifications and eligibility for the Board position to: boards@utahcounty.gov. All letters of interest in the vacant Board position must be received by the Board of County Commissioners, Utah County, Utah, on or before 5:00 p.m. on August 28th, 2026. The Board of County Commissioners, Utah County, Utah, will review and evaluate all individuals that qualify for consideration pursuant to the guidelines listed above and will appoint an individual to fill the existing Board vacancy by resolution. \n\n[View Notice](/api/media/file/Notice_2026_572_0e0c64602e.pdf)2b:T4fb,NOTICE OF VACANCIES ON THE UTAH VALLEY ROAD SPECIAL SERVICE DISTRICT ADMINISTRATIVE CONTROL BOARD \n\n  \nNotice is hereby provided this 22nd day of July 2026, pursuant to Utah Code Section 178-1-304, that two (2) vacancies exist on the Utah Valley Road Special Service District Administrative Control Board. To qualify for consideration for the above-mentioned Board vacancies, individuals must be registered voters within the Utah Valley Road Special Service District, or an officer or employee of Utah County.  \n \n\nThose individuals interested in being considered for the vacant Board positions outlined above should send a letter expressing their interest, together with a brief description of their qualifications and eligibility for the Board position to: boards@utahcounty.gov. All letters of interest in the vacant Board positions must be received by the Board of County Commissioners, Utah County, Utah, on or before 5:00 p.m. on Friday, August 28, 2026. The Board of County Commissioners, Utah County, Utah, will review and evaluate all individuals that qualify for consideration pursuant to the guidelines listed above, and will appoint individuals to fill the existing Board vacancies by resolution. \n\n[View Notice](/api/media/file/Notice_2026_571_3ed00791eb.pdf)2c:T1403,**Utah County, Utah** — A drought-stricken Utah summer, a statewide fireworks ban, and a bold idea from local leaders have coalesced into Utah County’s inaugural America 250 Pioneer Day Celebration. The event, designed to honor both America’s founding and Utah’s pioneer heritage, will culminate in a fireworks display on Utah Lake on Pioneer Day.\n\n**When:** Friday, July 24, 10:00 p.m. - 10:30 p.m.\n\n**Where:** Utah Lake\n\n_**What to expect:**_\n\n*   The celebration marks 250 years since America’s founding and honors pioneers past and present—from Utah’s early settlers to today’s entrepreneurs, educators, farmers, first responders, and public servants.\n*   It’s a community-driven, countywide celebration born from a spirit of cooperation among state and local agencies, elected officials, first responders, county staff, businesses, sponsors, and residents.\n\n_**Origin of Utah County’s America 250 Pioneer Day Celebration:**_\n\nEvery tradition has an origin story. This one began during Utah’s driest summer in memory, when a statewide fireworks ban sought to protect lives and public lands. Yet the idea of celebrating resilience and community persisted.\n\n“Pioneer Day is about remembering the courage and determination of those who came before us while celebrating the incredible place we get to call home. This event will give families across Utah County a memorable way to celebrate together and enjoy a truly spectacular show.” said Lehi City Councilwoman Emily Lockhart, who helped spark the plan.\n\nCommissioner Skyler Beltran, Representative Stephanie Gricius and staff at the Utah Lake Authority joined Lockhart to reframe the moment. They envisioned a countywide celebration that would unite families from every corner of Utah County while honoring both our nation’s founding and Utah’s pioneer heritage.\n\n“This all came together very quickly and will be a great community event that brings people to Utah Lake. A big thank you to the many businesses that helped make this possible, as well as the tremendous collaboration between our city, county and state partners,” - Beltran said.\n\nWhat followed was an extraordinary collaboration. State and local agencies, elected officials, first responders, public safety personnel, county staff, businesses, sponsors, and countless citizens contributed time, expertise, and resources to make the celebration possible. The effort demonstrated that when a community rallies around a common purpose, remarkable things can happen.\n\nThe event honors the courage of the pioneers who settled Utah and the visionaries who founded the United States. It also recognizes today’s pioneers: entrepreneurs, educators, innovators, farmers, first responders, public servants, and families who continue to build thriving communities and expand opportunity for the next generation.\n\n“As we celebrate Pioneer Day and America’s 250th anniversary, Fireworks at Utah Lake gives us an opportunity to come together as one community and celebrate the history, freedom, and pioneering spirit that have shaped both our state and our nation. This is the first year of what we hope will become a beloved Utah County tradition for generations to come, a night when families and neighbors from across the county gather around Utah Lake and celebrate together,” said Utah House of Representatives Stephanie Gricius.\n\nThat phone call between the three leaders on July 6 did more than launch an event. It launched a tradition built on the belief that even when circumstances change, Americans respond the way they always have: by coming together, solving problems, and creating something worthy of passing on.\n\nBecause America’s story has never been defined by what stands in its way. It has always been defined by what its people build together.\n\n“We stand on the shoulders of pioneers. Their legacy is not only what they built, but the courage and grit they used to build. Our goal is to use that same pioneer spirit to create communities worthy of those who will one day stand on ours. Very beautiful.” said Nate Hutchinson Co Managing Partner of Utah City.\n\n_**Get more information:**_ [https://www.fireworksatutahlake.com](https://www.fireworksatutahlake.com/)\n\n_**Frequently Asked Questions:**_\n\n*   Can I watch from my boat? Yes. Boats are encouraged, but please follow all safety rules, including navigation lights, as it will be dark. The marinas will be charging their normal rates; check water levels before putting your boat in. The best location to watch from water is the western launch area near Saratoga Springs.\n*   Can I watch from my paddleboard? No. Current laws do not allow non-motorized vessels on the lake after dark.\n*   Best viewing from shore? The American Fork Marina is the primary spot, followed by Lindon Marina. Bring a blanket or chair and stay hydrated—it's going to be warm.\n*   On-water viewing? If you’re joining on the water, head to the western launch areas for optimal views.\n\n_**Who Made This Possible:**_\n\nThank you to our title sponsors, QTS and Utah City, for bringing the community together on Pioneer Day!2d:T4c9,PROVO, Utah — The US Youth Soccer National Championships have descended on Utah Valley, turning Epic Sports Park into the largest event the venue has ever hosted. Organizers say more than 4,000 players are competing across 287 teams, with the games played at Epic’s fields in Utah County over the next ten days. \n\nWe spoke with Abby Owens of Explore Utah Valley, who said the event has filled hotels across the region and brought a flood of visitors to local restaurants, shops and the Provo Airport, where welcome signage greets teams arriving for their stay. \n\n“It’s the biggest thing we’ve ever hosted,” Owens said. “It’s the largest event yet for Epic Sports Park.” \n\nThe championship’s growth is partly the product of pursuing bigger events and aiming high. It doesn’t get any bigger than going up against Disney.  Owens was part of a team that brought the championships from Orlando to Provo. \n\n“Just to see what we could do,” Owens recalled of the visit to Orlando, where she and others met with CEOs and event managers. The goal, she said, was to elevate Epic Sports Park to a level that could compete with Disney World, “if not better,” she noted with a wink about the lofty aim.2e:T4c7,Congratulations Diana Holley for being named June 2026 Employee of the Month!\n\nDiana has worked for the Recorder’s Office for 20+ years, starting in customer service and then moving into mapping, where she became the mapping supervisor about three years ago. She is friendly and helpful with a smile, yet can be no-nonsense when needed and will stand up for the people and ideals she believes in, demanding respect when the occasion warrants. \n\nService-oriented and committed to helping everyone be their best, she is quick to praise what’s done well and handles corrections with kindness, all while keeping the atmosphere light as a morale booster and the type of person you’d like to work for. \n\nShe also takes the time to listen to questions, guides colleagues to clear answers, goes above and beyond to explain procedures, ensures everyone understand when new procedures are released, and works hard to keep trainings current so everyone is on the same page to help our customers the most.\n\nCongratulations Diana!  Your commitment to the Recorders's Office and Utah County is evident in your unwavering public service, meticulous attention to accuracy, and steadfast support for residents and colleagues alike.2f:T4ca,PUBLIC NOTICE IS HEARBY GIVEN THAT THE UTAH COUNTY CRIMINAL JUSTICE COORDINATING COUNCIL WILL HOLD A PUBLIC MEETING AT 51 SOUTH UNIVERSITY AVE., PROVO, UTAH 84601 IN THE HISTORIC COURTHOUSE, 3rd FLOOR COMMISSION CONFERENCE ROOM \n\nFriday, June 26, 2026 – 12:00 p.m. \n\nMeeting Link \n\nWhen necessary, board members may participate electronically, with the anchor location as stated above. \n\nThe public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes per individual unless otherwise approved by the Board. \n\nAGENDA  \n1\\. Welcome  \n\\-Jeff Gray  \n2\\. Approve previous meeting minutes  \n3\\. Open and Public Meetings Act Training  \n\\-Ben Van Noy  \n4\\. Discuss status of pretrial services  \n5\\. Discuss Council goals and next projects  \n6\\. Next Meeting Date \u0026 Adjourn  \nPUBLIC COMMENTS\n\nIn compliance with the American with Disabilities Act, individuals needing special accommodations (including communicative aids and services) during this meeting should notify Jolynn Clegg at (801) 851-8113 at least three days prior to the meeting. Board members may participate electronically as needed, with the anchor location for the public meeting to be the same as listed above.30:T997,ENSURE YOUR VOTE IS COUNTED: TECHNICAL ERRORS THAT THREATEN YOUNG VOTERS\n\n  \nProvo, UT (June 8, 2026) – Utah County Clerk Aaron Davidson will host a free public Town Hall on Thursday, June 11 at 7:00 PM in the Utah County Commissioners Chambers to address a growing concern: a significant number of first‑time voter ballots are not being counted. With the June 23 primary election approaching and the voter registration deadline this Friday, Clerk Davidson is urging voters—especially young voters—to take simple steps now to ensure their ballots are counted.\n\nWhen a mail‑in ballot envelope is missing a signature or the signature does not match what is on file, the ballot is flagged for the signature‑cure process. Election officials then contact the voter to verify the signature. The system protects voters, but only works when voters respond quickly. Many do not see the notice or miss the deadline, resulting in valid ballots going uncounted.\n\nYoung voters are disproportionately affected. In the 2024 General Election, voters ages 18–25 accounted for 55.46% of all ballots that were challenged and not cured. Among voters ages 18–21, 13.46% of all ballots cast were challenged—roughly one in seven. These ballots are legitimate votes from eligible Utahns who participated but were blocked by a preventable issue.\n\n“Every eligible vote deserves to be counted,” said Clerk Davidson. “Young voters are showing up, but small technical issues are standing between them and having their voice heard. With the primary approaching, now is the time to act.”\n\n  \nThe June 11 Town Hall will explain how to check ballot status, how the curing process works, and what voters can do immediately to ensure their ballot is counted. The event is free, open to the public, and requires no registration. Voters ages 18–25 and their parents are especially encouraged to attend.\n\n  \nLocation: Utah County Commissioners Chambers, 100 East Center Street, Provo, Utah 84606. For those unable to attend in person, the Town Hall will also be livestreamed: Utah County Elections - YouTube.\n\n  \nThe Utah County Clerk’s Office administers elections for more than 371,000 registered voters and is committed to transparent, accessible, and accurate elections. For information on ballot status or curing, contact the Utah County Elections Division.\n\n[VIEW NOTICE](/api/media/file/Press_release_June_11th_Town_Hall_Utah_County_Clerk_1_48c45ad86f.pdf)31:T6c6,UTAH COUNTY, Utah — Utah County Commissioner Skyler Beltran helped kick off Community Action Services and Food Bank’s annual “Come to the Table Homeless Experience” this evening, an immersive program designed to help community members better understand the challenges faced by individuals experiencing homelessness.\n\n  \nThe event brings together service providers, service missionaries, community leaders, and members of the public to participate in a realistic simulation of navigating homelessness. Each participant is assigned a profile reflecting circumstances commonly experienced by individuals in the community and then spends the evening accessing services much like someone facing homelessness would.\n\n  \nParticipants visit local service providers, receive a sack dinner from the Food and Care Coalition, utilize public transportation, and navigate various support systems available throughout the community.\n\n  \nDuring his remarks, Commissioner Beltran highlighted the collaborative efforts between Utah County, the State of Utah, nonprofit organizations, faith-based groups, and community partners to connect individuals with the resources they need to improve their circumstances.\n\n  \n“Utah County is a compassionate community. Utah County is a service-oriented community, and Utah County is an effective community,” said Commissioner Beltran. “If you want to improve your situation and get better, we have the resources and people to help you get there.”\n\n  \nThe “Come to the Table Homeless Experience” aims to increase awareness and strengthen partnerships among those working to address homelessness while highlighting the extensive network of services available to individuals and families in need.32:T639,**A kitchen, a skill, a second chance** \n\nWalk into the Utah County Jail kitchen and you'll find something most people don't expect: hope. The jail feeds its inmates, its staff and its work teams, but it's more than just a place to cook meals. It's become a launchpad for inmates looking to turn their lives around. \n\nLast year, jail officials launched a food handler's permit program. The idea was simple but powerful: teach inmates real skills they can use when they get out. In the past two months alone, eight inmates have earned their food handler's permit...four last month, four the month before. \n\n\"If we can give them a leg up and help them go and apply for jobs, that's been helpful for some guys,\" said Deputy Sheriff Chris Nielson. \n\n**More Than Just Cooking** \n\nThe training goes deep. Inmates learn how to work in a commercial-grade food kitchen, master food safety protocols and understand equipment safety. But the real curriculum is about character. \n\n\"We work on teaching them work ethic, accountability, responsibility,\" Nielson explained. The goal isn't just to teach someone how to cook. It's to build confidence. It's to give them a taste of success.” \n\n**Dignity Changes Everything** \n\nThe philosophy here is straightforward: well-fed inmates and well-respected inmates are well-behaved inmates.  \"They're people, right? And they deserve to be treated with dignity and respect,\" Nielson emphasized.  The kitchen's menu proves it. The meals served in the café range from basic to surprisingly sophisticated. It's a far cry from the stereotype of prison food.33:T4d7,NOTICE OF VACANCY ON THE NORTH POINTE SOLID WASTE SPECIAL SERVICE DISTRICT CONTROL BOARD\n\n  \nNotice is hereby provided this 27th day of May 2026, pursuant to Utah Code Section 17B-1-304 that one (1) vacancy currently exist on the North Pointe Solid Waste Special Service District Control Board (the “Board”). To be qualified for consideration for the abovementioned Board vacancy, individuals must be a registered voter within the boundaries of the North Pointe Solid Waste Special Service District (the “District”).\n\n  \nThose individuals interested in being considered for the vacant Board position outlined above should send a letter expressing their interest, together with a brief description of their qualifications and eligibility for the Board position to: boards@utahcounty.gov. All letters of interest in the vacant board positions must be received by the Commission, on or before 5:00 p.m. on Friday, July 10th, 2026. The Board of County Commissioners, Utah County, Utah, will review and evaluate all individuals that qualify for consideration pursuant to the guidelines listed above and will appoint an individual to fill the existing vacancy by resolution.\n\n[VIEW NOTICE](/api/media/file/Notice_2026_406_ca46b26d80.pdf)34:T542,NOTICE OF VACANCY ON THE SOUTH UTAH VALLEY ANIMAL SERVICES SPECIAL SERVICE DISTRICT ADMINISTRATIVE CONTROL BOARD\n\n  \nNotice is hereby provided this 27th day of May 2026, pursuant to Utah Code Section 17B-1-304 that one (1) vacancy currently exist on the South Utah Valley Animal Services Special Service District Administrative Control Board (the “Board”). To be qualified for  \nconsideration for the above-mentioned Board vacancy, individuals must be a registered voter within the boundaries of the South Utah Valley Animal Services Special Service District (the “District”) or an officer or employee of Utah County.\n\n  \nThose individuals interested in being considered for the vacant Board position outlined above should send a letter expressing their interest, together with a brief description of their qualifications and eligibility for the Board position to: boards@utahcounty.gov. All letters of interest in the vacant board positions must be received by the Commission, on or before 5:00 p.m. on Friday, July 10th, 2026. The Board of County Commissioners, Utah County, Utah, will review and evaluate all individuals that qualify for consideration pursuant to the guidelines listed above and will appoint an individual to fill the existing Board vacancy by resolution.\n\n[VIEW NOTICE](/api/media/file/Notice_2026_407_0b0bc6b1ce.pdf)35:T691,Notice is given that a regular primary election will be held on Tuesday, June 23, 2026 to nominate party candidates for the parties and candidates for nonpartisan local school board positions listed on the regular primary election ballot.\n\nFor voters receiving a ballot by mail, ballots will be mailed beginning 21 calendar days before the election. The location of ballot drop boxes, the location and hours of polling places, including early voting polling places and hours, and qualifications of individuals who may vote in the election can be found at vote.utahcounty.gov/voting-locations and vote.utah.gov, by calling (801) 851-VOTE (8683), or at 100 E Center Street, Ste 3100, Provo, UT 84606. On the day of the election, the polls will open at 7 a.m. and continue open until 8 p.m. Attest: Aaron R. Davidson\n\nAccessible voting machines will be available at all polling locations for those that need assistance when voting. More information on options for voters with disabilities can be found at: https://vote.utahcounty.gov/voter-information. If you have any additional questions, contact our office at (801) 851-VOTE (8683) or elections@utahcounty.gov. \n\nA public demonstration will be held to test the voting devices and tabulation equipment being used for the noticed election. Anyone who would like to witness the testing is invited to attend, beginning at 10:00 a.m. on May 28, 2026 at the Utah County Ballot Center - 100 E Center Street ROOM LL700 Provo, Utah. The Polling Locations listed below will be open from 7:00 a.m. to 8:00 p.m. on Election Day for any voter to vote in person.\n\n[VIEW POLLING LOCATIONS](/api/media/file/Election_Notice_Primary_385f6cfe14.pdf)36:T722,NOTICE OF BALLOT DROP BOX LOCATIONS\n\nThe Utah County Clerk, as the election officer, hereby provides notice of the locations of designated ballot drop boxes for the upcoming Primary Election in Utah County to be held on Tuesday, June 23, 2026.\n\nA voter may utilize the following Utah County Elections Division resources to view or obtain a copy of all Utah County ballot drop box locations:\n\n1.Visiting the Utah County Elections Division’s website: https://vote.utahcounty.gov/voting-locations  \n2.Visiting the Utah County Elections Division in person during regular business hours at 100 East Center Street, Suite 3100, Provo, UT 84606  \n3.Sending a letter with your request to the Utah County Elections Division’s mailing address: 100 East Center Street, Suite 3100, Provo, UT 84606  \n4.Calling the Utah County Elections Division: (801) 851-VOTE(8683)  \n5.Emailing the Utah County Elections Division: [elections@utahcounty.gov](mailto:elections@utahcounty.gov)\n\n  \nMore information can be accessed on the Statewide Electronic Voter Information Website at https://vote.utah.gov.\n\nThe election officer will post on the Utah County Elections Division’s website, available at https://vote.utahcounty.gov, the location of each ballot drop box in Utah County, including any changes to the location of a ballot drop box and the location of additional drop boxes.\n\nA voter may call the Utah County Elections Office at (801) 851-VOTE(8683) to obtain information regarding the location of a ballot drop box.\n\n  \nAs required by law, this notice will be published at least 28 days before the day of the General Election, which will take place on Tuesday, June 23, 2026.\n\n  \nThis notice fulfills the requirements of Utah Code § 20A-5-403.5(2)-(4).\n\n[VIEW NOTICE](/api/media/file/Notice_of_Ballot_Drop_Box_Locations_3a026dd0ca.pdf)37:T6ed,NOTICE OF EARLY VOTING\n\nAll early voting for the June 23, 2026 Primary Election will take place at the Utah County Elections Office, located at 100 E Center Street Room 3100, Provo, UT 84606.\n\nEarly voting will take place each weekday beginning Monday, June 15, 2026 and ending Thursday, June 18, 2026, with an additional day the following week on Monday, June 22, 2026. Polls will be open between 8:00 AM and 5:00 PM each weekday.\n\nMore information about early voting in the 2026 Primary Election, may be obtained by any of  \nthe following means:\n\n1\\. Visiting the Utah County Elections Division’s website: https://vote.utahcounty.gov/voting-locations  \n2\\. Visiting the Statewide Electronic Voter Information Website: https://vote.utah.gov  \n3\\. Visiting the Utah County Elections Division in person during regular business hours at 100 East Center Street, Suite 3100, Provo, UT 84606  \n4\\. Sending a letter with your request to the Utah County Elections Division’s mailing address: 100 East Center Street, Suite 3100, Provo, UT 84606  \n5\\. Calling the Utah County Elections Division at (801) 851-VOTE(8683)  \n6\\. Emailing the Utah County Elections Division at [elections@utahcounty.gov](mailto:elections@utahcounty.gov)\n\nAs the election officer, the Utah County Clerk will post the early voting polling place, including any changes to the location of an early voting polling place and the location of additional early voting polling places, on https://vote.utahcounty.gov.\n\nAs required by law, this notice will be published at least 28 days before the day of the Primary Election, which will take place on Tuesday, June 23, 2026.\n\nThis notice fulfills the requirements of Utah Code § 20A-3a-604.\n\n[VIEW NOTICE](/api/media/file/Notice_of_Early_Voting_0c0664ba53.pdf)38:Tacb,**Saratoga Springs, Utah** — In a community where neighbors know each other by name, a pickleball court is becoming a lifeline for Utah County’s most vulnerable children. The Utah County Commissioners are hosting a Pickleball Tournament to raise funds for the Children’s Justice Center (CJC), a one-stop, multidisciplinary hub that provides forensic interviews, medical exams, counseling, legal advocacy, and community resources under one roof to support children and families navigating abuse and trauma.\n\nCJC serves nearly 1,000 new child abuse cases each year, and the center’s mission is clear: ensure comprehensive, trauma-informed care for every child who comes through its doors. This past year, the center faced a $50,000 reduction in federal funding that had been paying for therapy for child abuse victims. **The Pickleball Tournament is critical to replacing those funds** so children can continue to access essential therapy services. Funds raised will provide evidence-based, age-appropriate trauma-specific mental health treatment access for child abuse victims and their families.\n\nThis is more than a fundraiser; **it’s a community commitment to healing and resilience**. When children visit the center, caregivers and staff hear firsthand how meaningful compassionate care can be. A child recently shared, “I love how everyone does their best to talk to you and not just talk about one specific thing, it helps us feel more comfortable and feel safe to talk about everything….” a reminder of why these services matter. Another parent expressed gratitude for a guiding path forward: “Obviously we're a wreck. Having people who know how to deal with this and who can give us a path forward is tremendously helpful. I am so incredibly grateful this exists.”\n\n**What:** Pickleball Tournament\n\n**When:** Friday, May 1, 8:00 a.m.- 6 p.m.\n\n**Where:** The Picklr, 629 Saratoga Rd Building 2, Saratoga Springs, UT 84043\n\nEvery serve supports the [Children's Justice Center](https://cjc.utahcounty.gov/) Whether you’re a pro or a beginner, come make a difference. Enjoy friendly competition and help ensure a brighter future for children.  There will be an opportunity drawing, auction items, networking opportunities, and a lot of fun.\n\nRegister Now: [Utah County Commissioners Pickleball Tournament](https://www.zeffy.com/en-US/ticketing/utah-county-commissioners-pickleball-tournament)\n\n**About the Children’s Justice Center -** The CJC provides a multidisciplinary approach to addressing child abuse, offering forensic interviews, medical exams, counseling, legal advocacy, and community resources—all under one roof—to ensure comprehensive support for children and families navigating the complexities of abuse and trauma.39:T49d,Tricia Rogers, an invaluable member of the Public Works, is April’s Employee of the Month. Congratulations Tricia! In just over 1.5 years, she quickly learned systems and processes.  She owns her responsibilities and demonstrates professionalism and reliability for coworkers and the public.\n\nShe handles park reservations by phone with kindness, especially helping elderly residents navigate the system; an expert in Sportsites Parks Reservations program, she consistently goes the extra mile to resolve customer concerns and ensure their needs are met and is adept at resolving concerns, including Equestrian Park inquiries.\n\nShe supports the internal team and manages purchase orders for Fleet and Parks, keeping county accounts and P-Cards organized to keep operations running smoothly.  She is proactive and detail-oriented, she helped implement the new Event Permit program, collaborating with Information Systems and other departments.\n\nAbove all, Tricia brings positive energy, friendliness, and genuine care for others, contributing to a welcoming, dependable workplace.\n\nCongratulations Tricia Rogers!  Utah County Public Works – April 2026 Employee of the Month.3a:T979,**HABs Happen**\n\nProvo, Utah — The Utah Lake Authority is launching a new media initiative called “HABs Happen” to better educate the public about harmful algal blooms (HABs). The campaign aims to equip residents and visitors with clear information and practical tools to understand what HABs are and what they are not.\n\nUtah County Commissioner Skyler Beltran attended the media announcement and offered strong support for ongoing habitat and water quality work around Utah Lake.  “While algae is a natural part of lake ecosystems, it’s important to recognize the significant progress that has been made in recent years to mitigate it. In 2025, efforts to reduce phragmites and restore native vegetation achieved more progress than ever before. Those efforts are making a measurable difference and Utah Lake is now in its best condition in many years.”\n\n**What HABs are and why they matter**  \nHABs are a naturally occurring cyanobacteria found in every body of water in Utah and throughout the United States. Their appearance can range from green pea soup to globules that resemble grass clippings. While ingesting HABs can cause illness, serious health effects are rare. HABs can be toxic for dogs, which should avoid contact with contaminated water. The campaign emphasizes that HABs are not an emergency every year, but rather a predictable seasonal occurrence that can be anticipated and managed with information and preparation.\n\n**HABs Season – Know before you go**\n\n*   Harmful algae blooms happen every year and are predictable\n*   They are more likely to be at the end of summer when it’s hot\n*   They are mildly dangerous to humans but toxic to dogs\n\nCommissioner Beltran wants Utahns to be mindful, take precautions but have fun when going outdoors.  “Utah Lake remains safe for recreational use, and I hope to see residents and visitors out enjoying it this summer.”\n\nStarting in late July to early August, consistently hot temperatures create conditions for HABs to develop. While localized blooms can occur earlier in the year, the campaign encourages a “know-before-you-go” mindset—similar to precautions taken by skiers during avalanche season or hikers in the narrows. The public is encouraged to visit habs.utah.gov to see where HABs may be, and to avoid areas with blooms. The overarching message is simple: knowledge empowers safer, more enjoyable time on Utah’s waterways.3b:T51a,NOTICE OF VACANCIES ON THE NORTH UTAH VALLEY ANIMAL SERVICES SPECIAL SERVICE DISTRICT ADMINISTRATIVE CONTROL BOARD\n\nNotice is hereby provided this 10th day of December, pursuant to Utah Code Sections 7B-1-304 and 17D-1-303, that three (3) vacancies currently exist on the North Utah Valley Animal Services Special Service District Administrative Control Board (the “Board”). To be qualified for consideration for the above-mentioned Board vacancies, individuals must be a registered voter within the boundaries of the North Utah Valley Animal Services Special\nService District (the “District”).\n\nThose individuals interested in being considered for the vacant Board positions outlined above should send a letter expressing their interest, together with a brief description of their\nqualifications and eligibility for the Board position to: boards@utahcounty.gov All letters of interest in the vacant Board position must be received by the Board of County Commissioners,\nUtah County, Utah, on or before 5:00 p.m. on Friday, January 16, 2026. The Board of County Commissioners, Utah County, Utah, will review and evaluate all individuals that qualify for consideration pursuant to the guidelines listed above and will appoint individuals to fill the existing three (3) Board vacancies by resolution.\n15:[\"$L16\",[\"$\",\"div\",null,{\"className\":\"relative w-full\",\"children\":[[\"$\",\"$L17\",null,{\"navigationLinks\":[{\"id\":1,\"name\":\"Results\",\"type\":\"link\",\"href\":\"/results\"},{\"id\":2,\"name\":\"Voting\",\"type\":\"linkGroup\",\"sublinks\":[{\"id\":1,\"name\":\"Information For Voters\",\"href\":\"/voter-information\"},{\"id\":2,\"name\":\"Voting \u0026 Drop Box Locations\",\"href\":\"/voting-locations\"}]},{\"id\":3,\"name\":\"Candidates\",\"type\":\"linkGroup\",\"sublinks\":[{\"id\":1,\"name\":\"List of Candidates\",\"href\":\"/list-of-candidates\"},{\"id\":2,\"name\":\"Information For Candidates\",\"href\":\"/candidate-information\"},{\"id\":3,\"name\":\"Financial Disclosures\",\"href\":\"/financial-disclosures\"},{\"id\":4,\"name\":\"Conflict Of Interest Forms\",\"href\":\"/conflict-of-interest-forms\"}]},{\"id\":4,\"name\":\"Resources\",\"type\":\"linkGroup\",\"sublinks\":[{\"id\":1,\"name\":\"City Officials\",\"href\":\"/city-officials\"},{\"id\":2,\"name\":\"Forms\",\"href\":\"/forms\"},{\"id\":3,\"name\":\"Maps\",\"href\":\"/maps\"},{\"id\":4,\"name\":\"Notices\",\"href\":\"/public-notices\"},{\"id\":5,\"name\":\"Petitions\",\"href\":\"/petitions\"},{\"id\":6,\"name\":\"Volunteer\",\"href\":\"/volunteer\"},{\"id\":7,\"name\":\"Ballot Center Tours\",\"href\":\"/ballot-center-tours\"}]},{\"id\":5,\"name\":\"Calendar\",\"type\":\"link\",\"href\":\"/calendar\"},{\"id\":6,\"name\":\"Contact\",\"type\":\"link\",\"href\":\"/contact\"}],\"phone\":\"801-851-VOTE (8683)\",\"email\":\"elections@utahcounty.gov\",\"deptName\":\"Elections\",\"variant\":\"gray\"}],[\"$\",\"div\",null,{\"className\":\"@container bg-white @5xl:pt-28 pt-19.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative z-10 @5xl:pt-10 pt-5\",\"children\":[\"$\",\"$L18\",null,{\"entries\":[{\"label\":\"Home\",\"href\":\"/\"},{\"label\":\"Public Notices\",\"href\":\"/public-notices\"}]}]}],[\"$\",\"section\",null,{\"className\":\"w-full\",\"children\":[\"$\",\"div\",null,{\"className\":\"@container w-full\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full @5xl:max-w-256 @7xl:max-w-360 @min-[96rem]:max-w-400 px-4 @5xl:px-[5%] @7xl:px-20 @min-[96rem]:px-24 grid grid-cols-1 @5xl:pt-20 pt-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex w-full flex-col gap-5\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"break-words font-semibold font-serif @5xl:text-[60px] text-[48px] text-gray-700 @5xl:leading-15 leading-12\",\"children\":\"Public Notices\"}],false,[\"$\",\"div\",null,{\"className\":\"max-w-3xl content-flow\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Official notices from the Utah County Clerk's Office, including election notices, notices of public test, and post-election audit notices. Reminders also go out on\",\" \",[\"$\",\"$L19\",null,{\"href\":\"https://www.facebook.com/UtahCoElections/\",\"aria-label\":\"$undefined\",\"className\":\"font-semibold text-UC-blue-600 hover:underline rounded-sm focus-visible:underline focus-visible:outline-2 focus-visible:outline-UC-blue-600 focus-visible:outline-offset-2 active:text-UC-purple-500 @3xl:hover:underline\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Facebook\",false]}],\".\"]}]}]]}]}]}]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"w-full bg-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"@container w-full\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full @5xl:max-w-256 @7xl:max-w-360 @min-[96rem]:max-w-400 px-4 @5xl:px-[5%] @7xl:px-20 @min-[96rem]:px-24 @3xl:pb-16 pb-10 grid grid-cols-1 pt-8\",\"children\":[\"$\",\"$L1a\",null,{\"notices\":[{\"id\":682,\"headline\":\"November 4, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-11-02T23:02:30.000Z\",\"summary\":\"The public meeting will be held November 4, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1902)\\n\\n[Agenda](https://www.utahcounty.gov/api/media/file/main-commission-agenda-2026-11-04.pdf)\",\"utahCode\":null},{\"id\":681,\"headline\":\"Utah County Halloween 2026\",\"postedAt\":\"2026-10-30T19:00:00.000Z\",\"summary\":null,\"body\":\"Halloween at Utah County included lions, witches, pumpkins and super mario.  You had toy story, wicked and even cholera costumes.  So much fun and lots of creative costumes.  Happy Halloween!  \",\"utahCode\":null},{\"id\":680,\"headline\":\"November 3, 2026 at 1 pm -  Board of Commissioners of Utah County, UT Budget Work Session\",\"postedAt\":\"2026-10-30T15:30:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF COMMISSIONERS OF UTAH COUNTY, UTAH\\nWILL HOLD A BUDGET WORK SESSION\\nIN THE HISTORIC COUNTY COURTHOUSE\\n51 S UNIVERSITY AVE STE 319, PROVO, UT 84601\\nNovember 3, 2026 - 1:00 PM\\n\",\"body\":\"WORK SESSION\\n\\n1.  WORK SESSION REGARDING THE 2027 UTAH COUNTY BUDGET FOR THE GENERAL FUND AND OTHER BUDGETARY FUNDS OF UTAH COUNTY, UTAH.\\n\\t-Aileen Conder, Commission\\n\",\"utahCode\":null},{\"id\":679,\"headline\":\"November 3, 2026 at 10 am -  Board of Commissioners of Utah County, UT Budget Work Session\",\"postedAt\":\"2026-10-30T15:30:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF COMMISSIONERS OF UTAH COUNTY, UTAH\\nWILL HOLD A BUDGET WORK SESSION\\nIN THE HISTORIC COUNTY COURTHOUSE\\n51 S UNIVERSITY AVE STE 319, PROVO, UT 84601\\nNovember 3, 2026 - 10:00 AM\\n\",\"body\":\"WORK SESSION\\n\\n1.  WORK SESSION REGARDING THE 2027 UTAH COUNTY BUDGET FOR THE GENERAL FUND AND OTHER BUDGETARY FUNDS OF UTAH COUNTY, UTAH.\\n\\t-Aileen Conder, Commission\\n\",\"utahCode\":null},{\"id\":678,\"headline\":\"IRONMAN triathlon coming to Utah County in 2027 \",\"postedAt\":\"2026-10-27T22:00:00.000Z\",\"summary\":null,\"body\":\"Utah County - An IRONMAN triathlon is scheduled to come to Utah County on Aug. 21, 2027, bringing competitors and visitors to the valley for a course through the mountains and canyon.  It will begin with a swim in Deer Creek, continue with a bike ride through Provo Canyon and finish in Orem, Utah County Commissioner Skyler Beltran said.  \\n\\n“This is a big deal because we have made a deliberate effort to make this the sports premier capital,” Beltran said. He called IRONMAN one of the best-known triathlon brands in the country and internationally. \\n\\nThe event is expected to draw thousands of competitors, along with their families and friends. Visitors will have a chance to take in the area’s mountain scenery and experience local hospitality. \",\"utahCode\":null},{\"id\":677,\"headline\":\"November 18, 2026 Board of Trustees of Utah County Service Area No 9 Notice of Public Hearing\",\"postedAt\":\"2026-10-27T22:00:00.000Z\",\"summary\":\"Notice of Public Hearing\",\"body\":\"[View Notice](/api/media/file/notice-2026-840.pdf)\",\"utahCode\":null},{\"id\":674,\"headline\":\"November 18, 2026 Board of Trustees of Utah County Service Area No 8 Notice of Public Hearing\",\"postedAt\":\"2026-10-27T21:30:00.000Z\",\"summary\":\"Notice of Public Hearing\",\"body\":\"[View Notice](/api/media/file/Notice-2026-838-SA-No-8.pdf)\",\"utahCode\":null},{\"id\":673,\"headline\":\"November 18, 2026 Board of Trustees of Utah County Service Area No 7 Notice of Public Hearing\",\"postedAt\":\"2026-10-27T21:00:00.000Z\",\"summary\":\"Notice of Public Hearing\",\"body\":\"[View Notice](/api/media/file/Notice-2026-836-SA-No-7.pdf)\",\"utahCode\":null},{\"id\":672,\"headline\":\"November 18, 2026 Board of Trustees of Utah County Service Area No 6 Notice of Public Hearing\",\"postedAt\":\"2026-10-27T21:00:00.000Z\",\"summary\":\"Notice of Public Hearing\",\"body\":\"[View Notice](/api/media/file/Notice-2026-834-SA-No-6.pdf)\",\"utahCode\":null},{\"id\":670,\"headline\":\"November 18, 2026 Utah Valley Road Special Service District Notice of Public Hearing\",\"postedAt\":\"2026-10-27T21:00:00.000Z\",\"summary\":\"Notice of Public Hearing\",\"body\":\"[View Notice](/api/media/file/Notice-226-830UVRoadSSD-1.pdf)\",\"utahCode\":null},{\"id\":669,\"headline\":\"November 18, 2026 Municipal Building Authority of Utah County Notice of Public Hearing\",\"postedAt\":\"2026-10-27T21:00:00.000Z\",\"summary\":\"Notice of Public Hearing\",\"body\":\"[View Notice](/api/media/file/Notice-2026-842-MBA-1.pdf)\",\"utahCode\":null},{\"id\":667,\"headline\":\"November 18, 2026 Utah County Community Reinvestment Agency Notice of Public Hearing\",\"postedAt\":\"2026-10-27T20:00:00.000Z\",\"summary\":\"NOTICE OF PUBLIC HEARING In accordance with Utah Code Section 17C-1-601.5, the Community Reinvestment Agency of Utah County, Utah (the “Agency”) will hold a public hearing on November 18, 2026, at 2:00 p.m., in the Utah County Administration Building, 100 East Center Street, Room 1400, Provo, Utah, on the budget tentatively adopted for 2027 for the Community Reinvestment Agency of Utah County, Utah. After the public hearing, the Agency may make final adjustments to its budget and, by resolution, shall adopt its final budget for 2027, subject to later amendment.\",\"body\":\"[View Notice](/api/media/file/notice2026-832cra.pdf)\",\"utahCode\":null},{\"id\":666,\"headline\":\"Alys O’Brien October 2026 Employee of the Month\",\"postedAt\":\"2026-10-26T22:00:00.000Z\",\"summary\":null,\"body\":\"$1b\",\"utahCode\":null},{\"id\":665,\"headline\":\"October 29, 2026 Board of Commissioners of Utah County, UT Budget Work Session\",\"postedAt\":\"2026-10-23T22:00:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF COMMISSIONERS OF UTAH COUNTY, UTAH\\nWILL HOLD A BUDGET WORK SESSION\\nIN THE HISTORIC COUNTY COURTHOUSE\\n51 S UNIVERSITY AVE STE 319, PROVO, UT 84601\\nOctober 29, 2026 - 10:00 AM\\n\",\"body\":\"Board members may participate electronically, when necessary, with the anchor location designated as stated above.\",\"utahCode\":null},{\"id\":664,\"headline\":\"October 28, 2026 Board of Commissioners of Utah County, UT Budget Work Session\",\"postedAt\":\"2026-10-23T22:00:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF COMMISSIONERS OF UTAH COUNTY, UTAH\\nWILL HOLD A BUDGET WORK SESSION\\nIN THE HISTORIC COUNTY COURTHOUSE\\n51 S UNIVERSITY AVE STE 319, PROVO, UT 84601\\nOctober 28, 2026 - 10:00 AM\\n\",\"body\":\"Board members may participate electronically, when necessary, with the anchor location designated as stated above.\",\"utahCode\":null},{\"id\":663,\"headline\":\"October 27, 2026 Board of Commissioners of Utah County, UT Budget Work Session\",\"postedAt\":\"2026-10-23T22:00:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF COMMISSIONERS OF UTAH COUNTY, UTAH\\nWILL HOLD A BUDGET WORK SESSION\\nIN THE HISTORIC COUNTY COURTHOUSE\\n51 S UNIVERSITY AVE STE 319, PROVO, UT 84601\\nOctober 27, 2026 - 11:00 AM\\n\",\"body\":\"Board members may participate electronically, when necessary, with the anchor location designated as stated above.\",\"utahCode\":null},{\"id\":662,\"headline\":\"October 21, 2026 Board of Directors of the Municipal Building Authority of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-10-20T16:00:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF DIRECTORS OF THE MUNICIPAL BUILDING AUTHORITY OF UTAH COUNTY, UTAH\\nWILL HOLD A PUBLIC MEETING\\nIN THE COMMISSION CHAMBERS - ROOM 1400\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING\\n100 E CENTER ST, PROVO, UT 84606\\nOctober 21, 2026 - 2:00 PM\\n\",\"body\":\"You may watch the meeting live on YouTube under the heading UTAH COUNTY GOVERNMENT or by going to the link: https://www.youtube.com/@UtahCountyGovernment/streams\\nBoard members may participate electronically, when necessary, with the anchor location designated as stated above.\\nThe public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes per individual unless otherwise approved by the Board.\\n\",\"utahCode\":null},{\"id\":661,\"headline\":\"October 21, 2026 Board of Trustees of Utah County Service Area No. 9\",\"postedAt\":\"2026-10-20T16:00:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF TRUSTEES OF UTAH COUNTY SERVICE AREA NO. 9\\nWILL HOLD A PUBLIC MEETING\\nIN THE COMMISSION CHAMBERS - ROOM 1400\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING\\n100 E CENTER ST, PROVO, UT 84606\\nOctober 21, 2026 - 2:00 PM\\n\",\"body\":\"The public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes per individual unless otherwise approved by the Board.\\nBoard members may participate electronically, when necessary, with the anchor location designated as stated above.\\nYou may watch the meeting live on YouTube under the heading UTAH COUNTY GOVERNMENT or by going to the link: https://www.youtube.com/@UtahCountyGovernment/streams\\n\",\"utahCode\":null},{\"id\":660,\"headline\":\"October 22, 2025 Board of Trustees of Utah County Service Area No. 8\",\"postedAt\":\"2026-10-20T15:30:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF TRUSTEES OF UTAH COUNTY SERVICE AREA NO. 8\\nWILL HOLD A PUBLIC MEETING\\nIN THE COMMISSION CHAMBERS - ROOM 1400\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING\\n100 E CENTER ST, PROVO, UT 84606\\nOctober 21, 2026 - 2:00 PM\\n\",\"body\":\"The public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes per individual unless otherwise approved by the Board.\\nYou may watch the meeting live on YouTube under the heading UTAH COUNTY GOVERNMENT or by going to the link: https://www.youtube.com/@UtahCountyGovernment/streams\\nBoard members may participate electronically, when necessary, with the anchor location designated as stated above.\\n\",\"utahCode\":null},{\"id\":659,\"headline\":\"October 21, 2026 Board of Trustees of Utah County Service Area No. 7\",\"postedAt\":\"2026-10-20T15:30:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF TRUSTEES OF UTAH COUNTY SERVICE AREA NO. 7\\nWILL HOLD A PUBLIC MEETING\\nIN THE COMMISSION CHAMBERS - ROOM 1400\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING\\n100 E CENTER ST, PROVO, UT 84606\\nOctober 21, 2026 - 2:00 PM\\n\",\"body\":\"The public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes per individual unless otherwise approved by the Board.\\nYou may watch the meeting live on YouTube under the heading UTAH COUNTY GOVERNMENT or by going to the link: https://www.youtube.com/@UtahCountyGovernment/streams\\nBoard members may participate electronically, when necessary, with the anchor location designated as stated above.\\n\",\"utahCode\":null},{\"id\":658,\"headline\":\"October 21, 2026 Board of Trustees of Utah County Service Area No. 6\",\"postedAt\":\"2026-10-20T15:30:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\nBOARD OF TRUSTEES OF UTAH COUNTY SERVICE AREA NO. 6\\nWILL HOLD A PUBLIC MEETING\\nIN THE COMMISSION CHAMBERS - ROOM 1400\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING\\n100 E CENTER ST, PROVO, UT 84606\\nOctober 21, 2026 - 2:00 PM\\n\",\"body\":\"Board members may participate electronically, when necessary, with the anchor location designated as stated above.\\nThe public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes per individual unless otherwise approved by the Board.\\nYou may watch the meeting live on YouTube under the heading UTAH COUNTY GOVERNMENT or by going to the link: https://www.youtube.com/@UtahCountyGovernment/streams\\n\",\"utahCode\":null},{\"id\":657,\"headline\":\"October 21, 2026 Utah Valley Road Special Service District\",\"postedAt\":\"2026-10-20T15:30:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE UTAH VALLEY ROAD SPECIAL SERVICE DISTRICT\\nWILL HOLD A PUBLIC MEETINGIN THE COMMISSION CHAMBERS - ROOM 1400\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING 100 E CENTER ST, PROVO, UT 84606\\nOctober 21, 2026 - 2:00 PM\\n\",\"body\":\"$1c\",\"utahCode\":null},{\"id\":656,\"headline\":\"October 21, 2026 Utah County Community Reinvestment Agency Public Meeting\",\"postedAt\":\"2026-10-20T15:30:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE UTAH COUNTY COMMUNITY REINVESTMENT AGENCY\\nWILL HOLD A PUBLIC MEETING IN THE COMMISSION CHAMBERS - ROOM 1400\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING 100 E CENTER ST, PROVO, UT 84606\\nOctober 21, 2026 - 2:00 PM\\n\\n\",\"body\":\"$1d\",\"utahCode\":null},{\"id\":655,\"headline\":\"October 21, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-10-20T14:16:20.000Z\",\"summary\":\"The public meeting will be held October 21, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=2000)\\n\\n[Agenda](https://www.utahcounty.gov/api/media/file/main-boe-agenda-2026-10-21.pdf)\",\"utahCode\":null},{\"id\":654,\"headline\":\"Jed Webb Utah County's new County Administrator\",\"postedAt\":\"2026-10-19T23:30:00.000Z\",\"summary\":null,\"body\":\"The Utah County Commission is pleased to announce the appointment of Jed Webb as Utah County's new County Administrator!\\n\\nJed brings extensive experience in public administration, government relations and organizational leadership. His background includes serving as Chief of Staff to U.S. Congressman Randy Weber, Director of Government Affairs for Galveston County, Texas and most recently in a leadership role at Tetra Tech, a consulting firm specializing in disaster recovery and assisting local governments.\\n\\nAs one of the fastest growing counties in the nation, Utah County faces tremendous opportunities and challenges ahead. We are confident Jed's experience, leadership and commitment to public service will be valuable assets as we continue working to deliver efficient, effective government for our residents.\\n\",\"utahCode\":null},{\"id\":653,\"headline\":\"October 21, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-10-19T22:14:02.000Z\",\"summary\":\"The public meeting will be held October 21, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1741)\\n\\n[Agenda](https://www.utahcounty.gov/api/media/file/main-commission-agenda-2026-10-21.pdf)\",\"utahCode\":null},{\"id\":652,\"headline\":\"Union Bench Bike Park\",\"postedAt\":\"2026-10-15T20:00:00.000Z\",\"summary\":null,\"body\":\"MAPLETON, Utah — A new mountain bike park is coming to Harmony Ridge, with Union Bench Bike Park set to open in early spring through late spring 2027. City and county officials say the project aims to draw visitors from neighboring communities while offering a space for riders of all skill levels.\\n\\nLogan Miner, Mapleton’s Parks and Recreation Director, said the park is designed to be inclusive and progressive. “It’s very progressive in nature, so whether you’re a novice rider or very skilled and trying to hone your skills, there’s something for everybody here,” Miner said. He added that one of the park’s standout moments will be the views: “The aha moment is the views from up here.”\",\"utahCode\":null},{\"id\":651,\"headline\":\"Notice of Public Hearing and Bonds to be Issued - November 4, 2026\",\"postedAt\":\"2026-10-12T18:00:00.000Z\",\"summary\":\"$1e\",\"body\":null,\"utahCode\":null},{\"id\":650,\"headline\":\"IHC cancer center opens in Saratoga Springs, bringing care closer to Utah County residents\",\"postedAt\":\"2026-10-09T18:00:00.000Z\",\"summary\":null,\"body\":\"SARATOGA SPRINGS, Utah — Utah County Commissioner Skyler Beltran hailed the brand-new Intermountain Healthcare cancer center in Saratoga Springs as an “exciting day” for West Utah County. “It’s a big deal because it brings health care closer to residents of Utah County,” Beltran said, noting that communities such as Fairfield, Cedar Valley, Eagle Mountain, Saratoga and West Lehi would gain closer access. “This brings it right to their neighborhood. It’s an incredible opportunity to improve healthcare for Utah County.”\",\"utahCode\":null},{\"id\":649,\"headline\":\"Data Centers\",\"postedAt\":\"2026-10-07T18:00:00.000Z\",\"summary\":null,\"body\":\"$1f\",\"utahCode\":null},{\"id\":648,\"headline\":\"October 7, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-10-06T14:31:17.000Z\",\"summary\":\"The public meeting will be held October 7, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1999)\\n\\n[Agenda](https://www.utahcounty.gov/api/media/file/main-boe-agenda-2026-10-07.pdf)\",\"utahCode\":null},{\"id\":647,\"headline\":\"October 7, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-10-05T22:50:20.000Z\",\"summary\":\"The public meeting will be held October 7, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1901)\\n\\n[Agenda](https://www.utahcounty.gov/api/media/file/main-commission-agenda-2026-10-07.pdf)\",\"utahCode\":null},{\"id\":646,\"headline\":\"NOTICE OF BALLOT DROP BOX LOCATIONS\",\"postedAt\":\"2026-10-05T20:00:00.000Z\",\"summary\":\"The Utah County Clerk, as the election officer, hereby provides notice of the locations of designated ballot drop boxes for the upcoming General Election in Utah County to be held on Tuesday, November 3, 2026.\",\"body\":\"[VIEW NOTICE](/api/media/file/NoticeofBallotDropboxLocations11_3_2026.pdf)\",\"utahCode\":null},{\"id\":645,\"headline\":\"NOTICE OF EARLY VOTING\",\"postedAt\":\"2026-10-05T18:30:00.000Z\",\"summary\":\"All early voting for the November 3, 2026 General Election will take place at the Health and Justice Building, located at 151 S University Ave, Room 2500, Provo, UT 84606.\\n\\nEarly voting will take place beginning Monday, October 26, 2026 and ending Friday, October 30, 2026, with an additional day the following week on Monday, November 2, 2026. Polls will be open between 8:00 AM and 5:00 PM each day.\",\"body\":\"[View Notice](/api/media/file/NoticeofEarlyVoting11_3_2026.pdf)\",\"utahCode\":\"\"},{\"id\":643,\"headline\":\"Notice is given that a regular general election will be held on Tuesday, November 3, 2026 to elect candidates to the offices listed on the regular general election ballot.\",\"postedAt\":\"2026-10-02T22:30:00.000Z\",\"summary\":null,\"body\":\"[Public Election Notice](/api/media/file/Election%20Notice.pdf)\",\"utahCode\":null},{\"id\":644,\"headline\":\"UC Tax Tourism Advisory Board Meeting \",\"postedAt\":\"2026-10-02T17:00:00.000Z\",\"summary\":null,\"body\":\"View Agenda: https://www.utahcounty.gov/cms/uploads/October_TTAB_Agenda_37862cb479.pdf \",\"utahCode\":null},{\"id\":632,\"headline\":\"Notice of Vacancy - North Utah County Water Conservancy District\",\"postedAt\":\"2026-09-24T18:00:00.000Z\",\"summary\":null,\"body\":\"NOTICE OF VACANCY ON THE NORTH UTAH COUNTY WATER CONSERVANCY DISTRICT BOARD OF TRUSTEES \\n\\nNotice is hereby provided this 23rd day of September 2026, pursuant to Utah Code Sections I 7B-l-304 and I 7B-2a-l 005, that one (I) vacancy currently exist on the North Utah County Water Conservancy District Board of Trustees (the ·'Board\\\"), to fill one (I) expired term. Positions on the Board are for individuals who are representatives of a specific geographical area or interest. \\n\\n[VIEW NOTICE](/api/media/file/Notice_2026_743_d45a9b6791.pdf)\",\"utahCode\":null},{\"id\":616,\"headline\":\"Notice of Vacancy - North County Water Conservancy District Board of Trustees\",\"postedAt\":\"2026-09-24T15:15:00.000Z\",\"summary\":null,\"body\":\"NOTICE OF VACANCY ON THE NORTH UTAH COUNTY WATER CONSERVANCY DISTRICT BOARD OF TRUSTEES \\n\\n  \\nNotice is hereby provided this 23rd day of September 2026, pursuant to Utah Code Sections I 7B-l-304 and I 7B-2a-l 005, that one (I) vacancy currently exist on the North Utah County Water Conservancy District Board of Trustees (the ·'Board\\\"), to fill one (I) expired term. Positions on the Board are for individuals who are representatives of a specific geographical area or interest. \\n\\n[VIEW NOTICE](/api/media/file/Notice_2026_743_02294f7b25.pdf)\",\"utahCode\":null},{\"id\":641,\"headline\":\"September 24, 2026 Utah County Career Service Council Public Meeting\",\"postedAt\":\"2026-09-23T17:00:00.000Z\",\"summary\":null,\"body\":\"$20\",\"utahCode\":null},{\"id\":607,\"headline\":\"September 23, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-09-22T14:10:12.000Z\",\"summary\":\"The public meeting will be held September 23, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1998)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_09_23_aa7f5d61ae.pdf)\",\"utahCode\":null},{\"id\":638,\"headline\":\"September 23, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-09-21T21:41:49.000Z\",\"summary\":\"The public meeting will be held September 23, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1900)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_09_23_de49887208.pdf)\",\"utahCode\":null},{\"id\":640,\"headline\":\"Sgt. Zac Robinson September 2026 Employee of the Month\",\"postedAt\":\"2026-09-18T18:30:00.000Z\",\"summary\":null,\"body\":\"$21\",\"utahCode\":null},{\"id\":639,\"headline\":\"Notice of Vacancies on the Springville Drainage District Board of Trustees\",\"postedAt\":\"2026-09-18T15:45:00.000Z\",\"summary\":null,\"body\":\"$22\",\"utahCode\":null},{\"id\":636,\"headline\":\"Notice of Logic and Accuracy Testing - October 1, 2026\",\"postedAt\":\"2026-09-18T15:00:00.000Z\",\"summary\":null,\"body\":\"NOTICE OF LOGIC AND ACCURACY TESTING\\n\\n  \\nIn accordance with Utah Code § 20A-4-104(1), the Utah County Clerk will conduct a logic and accuracy test of automatic tabulating equipment prior to the General Election to be held on November 3rd, 2026, for Utah County’s federal, state, and county races. The logic and accuracy test is open to the public and will be held on Thursday, October 1, 2026, at 10:00 AM Mountain Time at the following location:  \\n \\n\\nUtah County Administration Building  \\nBallot Processing Center  \\n100 E Center Street, Room LL700  \\nProvo, UT 84606  \\n \\n\\n[VIEW NOTICE](/api/media/file/L_and_A_Public_Notice_1_7ff1550b8b.pdf)\",\"utahCode\":null},{\"id\":637,\"headline\":\"First Down Provo...a Resounding Success!\",\"postedAt\":\"2026-09-17T19:30:00.000Z\",\"summary\":null,\"body\":\"PROVO, Utah — First Down Provo was an event designed to turn a football game day experience into a multi-day “game weekend” as well as boost economic activity in downtown Provo.\\n\\nUtah County Commissioner Skyler Beltran said the gathering was meant to bring the community downtown and bring them together and cheer on the nationally ranked BYU Cougars, so Utah County along with Explore Utah Valley, Provo City, Downtown Provo, BYU Athletics and BYU Alumni Relations organized this event and it was a resounding success!\",\"utahCode\":null},{\"id\":633,\"headline\":\"Sample Ballot for the November 3, 2026 General Election\",\"postedAt\":\"2026-09-17T14:30:00.000Z\",\"summary\":null,\"body\":\"In accordance with Utah Code 20A-5-405(f)(iii): The following is the Amended 2026 General Sample Ballot. \\n\\n[VIEW AMENDED 2026 GENERAL SAMPLE BALLOT](/api/media/file/2026_General_Sample_Ballots_Corrected_2_e50150f2c0.PDF)\",\"utahCode\":null},{\"id\":635,\"headline\":\"On Demand Service Helps Keep Seniors Independent\",\"postedAt\":\"2026-09-16T17:30:00.000Z\",\"summary\":null,\"body\":\"The UTA On-Demand service offers seniors rides for $1.25 each way and more importantly, helping elderly residents stay more independent. \\n\\nVanetta Levao, has been using the service in Ogden for years and said the service lets her do more than “sit at home and watch TV.” There’s a lot of people that can use it, like her sister Faafofoga Suamataia whom she is showing how to use the service, now that it's in Utah County. “It’s helpful to us that are less independent.” She added that she and others can accomplish more with the rides, including trips to religious services and running errands.\",\"utahCode\":null},{\"id\":615,\"headline\":\"September 16, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-09-15T13:29:07.000Z\",\"summary\":\"The public meeting will be held September 16, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1997)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_09_16_9ad7d63dbc.pdf)\",\"utahCode\":null},{\"id\":606,\"headline\":\"September 16, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-09-14T21:55:15.000Z\",\"summary\":\"The public meeting will be held September 16, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1899)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_09_16_e393b01cf1.pdf)\",\"utahCode\":null},{\"id\":628,\"headline\":\"September 15, 2026 Board of Commissioners of Utah County, Utah Budget Work Session\",\"postedAt\":\"2026-09-14T14:30:00.000Z\",\"summary\":null,\"body\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE \\n\\n**BOARD OF COMMISSIONERS OF UTAH COUNTY, UTAH** WILL HOLD A BUDGET WORK SESSION\\n\\nAT THE RUTH THEATER 401 S PLEASANT GROVE BLVD, PLEASANT GROVE, UTAH 84062\\n\\n**September 15, 2026 - 10:00 AM**\\n\\n[**VIEW AGENDA**](/api/media/file/Work_Session_Agenda_2026_09_15_3f30817bc3.pdf)\",\"utahCode\":null},{\"id\":634,\"headline\":\"United Way Day of Caring \",\"postedAt\":\"2026-09-10T20:15:00.000Z\",\"summary\":null,\"body\":\"PROVO, Utah - Utah County Commissioners were a part of United Way Day of Caring, a countywide effort that mobilizes volunteers from local businesses to support libraries, schools and other community programs.\\n\\nUtah County Commissioner, Skyler Beltran, volunteered to flip pancakes at the morning kickoff.  He served volunteers who gathered to eat before heading out to service projects across the county. “We are serving breakfast for all the volunteers,” he said, noting that the hearty meal helps start a day of work in the community.\\n\\nBeltran said the event is designed to bring the community together and set a collaborative tone for the day. “It brings all the community together,” he said.\",\"utahCode\":null},{\"id\":630,\"headline\":\"First Down Provo to debut as new pregame event in downtown Provo\",\"postedAt\":\"2026-09-10T16:30:00.000Z\",\"summary\":null,\"body\":\"PROVO, Utah — A new pregame event called First Down Provo will debut Friday, September 11th 2026, bringing live music, food trucks, inflatable play areas and a charity canned food drive to downtown Provo ahead of BYU’s first Big 12 conference game of the season, Utah County Commissioner Skyler Beltran said.\\n\\nCenter Street will be closed from University to 100 East for the downtown event, with most activities taking place on the County Historic Courthouse campus. The lineup includes food trucks, a live band, BYU Store and concessions stands, and a canned food drive to benefit Community Action Services and Food Bank. The event, will also have in attendance, the Provo Fire Department to commemorate 9/11, Beltran said.\",\"utahCode\":null},{\"id\":631,\"headline\":\"Nicole Stevens Honored with the Pillar of Democracy Award\",\"postedAt\":\"2026-09-09T17:00:00.000Z\",\"summary\":null,\"body\":\"$23\",\"utahCode\":null},{\"id\":629,\"headline\":\"UTA On-Demand Service Solves Utah County’s Last Mile Issue\",\"postedAt\":\"2026-09-08T16:00:00.000Z\",\"summary\":null,\"body\":\"SARATOGA SPRINGS, Utah — The UTA on-demand ride-share service is helping Utah County residents bridge the last mile between FrontRunner and everyday destinations.\\n\\nThe service is designed to connect people from major transit hubs to homes, offices and shops in a growing region. A Utah County residents we talked to, described the concept as a flexible alternative to car travel, especially for those who rely on trains to reach Salt Lake City or who share a single vehicle.\\n\\n“I always like options on how I can get around,” AJ Averett said. “Being able to go to Salt Lake, it’s been nice to use the train, but coordinating between my wife and I because we only have one car is sometimes annoying. The micro transit service is pretty cool. I am big on whatever can get me from A to B. I’m a big fan of it.”\",\"utahCode\":null},{\"id\":627,\"headline\":\"Utah County expands UTA Connect to tackle last-mile transit\",\"postedAt\":\"2026-09-04T18:40:15.530Z\",\"summary\":null,\"body\":\"$24\",\"utahCode\":null},{\"id\":623,\"headline\":\"Amending the Annual Regular Meeting Schedule for the Board of County Commissioners of Utah County, Utah\",\"postedAt\":\"2026-09-04T15:45:00.000Z\",\"summary\":null,\"body\":\"RESOLUTION AMENDING THE ANNUAL REGULAR MEETING SCHEDULE FOR THE BOARD OF COUNTY COMMISSIONERS OF UTAH COUNTY, UTAH, FOR THE YEAR 2026\\n\\n[View Resolution and Meeting Schedule](/api/media/file/Resolution_2026_701_95fae7c1dd.pdf)\",\"utahCode\":null},{\"id\":614,\"headline\":\"Notice of Public Hearing - September 23, 2026\",\"postedAt\":\"2026-09-04T15:45:00.000Z\",\"summary\":null,\"body\":\"$25\",\"utahCode\":null},{\"id\":613,\"headline\":\"Huntsman Cancer Institute to open Vineyard campus, boosting cancer care across Utah County\",\"postedAt\":\"2026-09-03T18:30:00.000Z\",\"summary\":null,\"body\":\"VINEYARD, Utah — Huntsman Cancer Institute held a Cornerstone Celebration this week.  The Comprehensive Cancer Center campus in Vineyard, is expected to open in the fall of 2028. Located in one of the fastest-growing regions in the United States, this 272,000-square-foot facility will provide advanced cancer care closer to patients in Utah County and nearby communities, thereby significantly reducing the time required for treatment.\\n\\nBradley Cairns, chief executive officer of Huntsman Cancer Institute, opened the announcement by thanking partners and outlining the mission behind the project. “We are building the center in Vineyard for you and with you. We are grateful for our many partners such as the Utah County Commissioners, Utah County Mayors, and Utah County Health Department,” Cairns said.\",\"utahCode\":null},{\"id\":622,\"headline\":\"2026 General Election Candidate Certification\",\"postedAt\":\"2026-09-02T22:00:00.000Z\",\"summary\":null,\"body\":\"In accordance with Utah Code 20A-5a-210: The following candidates won their respective primary races held during the Primary Election or filed to run for an office not requiring a primary and are officially certified to appear on the General Election ballot on November 3, 2026.\\n\\n[VIEW 2026 GENERAL ELECTION CANDIDATE CERTIFICATION](/api/media/file/Utah_County_2026_General_Election_Candidate_Certification_4e705c1719.pdf)\",\"utahCode\":null},{\"id\":612,\"headline\":\"September 2, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-09-01T13:49:51.000Z\",\"summary\":\"The public meeting will be held September 2, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1996)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_09_02_16f6e62155.pdf)\",\"utahCode\":null},{\"id\":605,\"headline\":\"September 2, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-08-31T21:33:46.000Z\",\"summary\":\"The public meeting will be held September 2, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1898)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_09_02_ecaf786d69.pdf)\",\"utahCode\":null},{\"id\":23,\"headline\":\"UTA - Rideshare Program Off To A Great Start\",\"postedAt\":\"2026-08-27T22:45:00.000Z\",\"summary\":null,\"body\":\"Today Utah County celebrated the success of the UTA On-Demand Service with our two partners...Utah Transit Authority and UDOT.\\n\\nMore than 1000 people rode the service in the first 9 days! Amazing number that proves that public transit in Utah County is wanted and needed.\",\"utahCode\":null},{\"id\":621,\"headline\":\"August 28, 2026 Utah County Criminal Justice Coordinating Council\",\"postedAt\":\"2026-08-27T16:00:00.000Z\",\"summary\":null,\"body\":\"PUBLIC NOTICE IS HEARBY GIVEN THAT THE UTAH COUNTY CRIMINAL JUSTICE COORDINATING COUNCIL WILL HOLD A PUBLIC MEETING AT 51 SOUTH UNIVERSITY AVE., PROVO, UTAH 84601 IN THE HISTORIC COURTHOUSE, 3rd FLOOR COMMISSION CONFERENCE ROOM\\n\\nAugust 28, 2026 – 12:00 p.m.  \\n  \\nThe public may participate at the anchor location stated above. Public comments will be limited to two (2) minutes   \\nper individual unless otherwise approved by the Board.\\n\\n  \\nAGENDA  \\n1\\\\. Welcome  \\n\\\\-Jeff Gray  \\n2\\\\. Approve previous meeting minutes  \\n3\\\\. Discuss status of pretrial services  \\n4\\\\. Discuss Council goals and next projects  \\n5\\\\. Next Meeting Date \u0026 Adjourn  \\n \\n\\nPUBLIC COMMENTS\",\"utahCode\":null},{\"id\":611,\"headline\":\"Sleeping Mat Campaign Update\",\"postedAt\":\"2026-08-26T20:30:00.000Z\",\"summary\":null,\"body\":\"Our “250 Sleeping Mats” campaign got off to a great start!  Thanks to your generosity we collected 100 mats in 8 days!  Amazing!  Our goal is to provide 250 new sleeping mats for this year’s Utah County Warming Center before it opens on November 1.\",\"utahCode\":null},{\"id\":619,\"headline\":\"Utah County designates August as Breastfeeding Month\",\"postedAt\":\"2026-08-25T17:30:00.000Z\",\"summary\":null,\"body\":\"UTAH COUNTY, Utah — The Utah County Board of Commissioners designated August as Utah County Breastfeeding Month, continuing a designation the county has adopted each year for the past five years. The recognition highlights the important role breastfeeding plays in supporting the health of mothers and infants and encourages greater access to resources for families.\\n\\nThe American Academy of Pediatrics recommends exclusive breastfeeding for approximately the first six months of life, followed by continued breastfeeding alongside complementary foods. Breastfeeding provides nutrition tailored to infants, supports healthy growth and immune development, and can reduce the risk of certain illnesses. Mothers may also experience important health benefits, including improved postpartum recovery and reduced risk of some cancers.\",\"utahCode\":null},{\"id\":610,\"headline\":\"August 26, 2026 Utah County Capital Improvement Plan Committee Public Work Session\",\"postedAt\":\"2026-08-21T15:30:00.000Z\",\"summary\":null,\"body\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE UTAH COUNTY CAPITAL IMPROVEMENT PLAN COMMITTEE \\n\\nWILL HOLD A PUBLIC WORK SESSION IN SUITE 3600, AUDITOR CONFERENCE ROOM OF THE UTAH COUNTY ADMINISTRATION\\n\\nBUILDING 100 EAST CENTER STREET, PROVO, UTAH \\n\\nAugust 26, 2026 – 4:00 pm\\n\\nWORK SESSION AGENDA\\n\\n1\\\\.  DISCUSSION OF CAPITAL IMPROVEMENT PROJECTS FOR 2027-2029 AND THE 10-YEAR PLAN.\\n\\nIn compliance with the Americans with Disabilities Act, individuals needing special accommodations (including auxiliary communicative aids and services) during this meeting should notify the Utah County Clerk’s Office at (801) 851-8113 at least two days prior to the meeting.\",\"utahCode\":null},{\"id\":620,\"headline\":\"Provo Airport opens Snow-Removal Equipment Facility as part of Growth Plans\",\"postedAt\":\"2026-08-19T22:00:00.000Z\",\"summary\":null,\"body\":\"$26\",\"utahCode\":null},{\"id\":604,\"headline\":\"Community Development Block Grant Public Notice\",\"postedAt\":\"2026-08-18T21:15:00.000Z\",\"summary\":null,\"body\":\"[View Spring Lake Notice](/api/media/file/FONSI_NOI_RROF_for_Spring_Lake_with_Region_VIII_Contact_77a6d2fa03.pdf)\\n\\n[View The Refuge Notice](/api/media/file/FONSI_NOI_RROF_for_The_Refuge_with_Region_VIII_Contact_8e26b73568.pdf)\",\"utahCode\":null},{\"id\":618,\"headline\":\"250 Sleeping Mats Campaign\",\"postedAt\":\"2026-08-18T17:00:00.000Z\",\"summary\":null,\"body\":\"As part of our ongoing America 250 Celebration, we’re launching the “250 Sleeping Mats” community donation campaign, with a goal of providing 250 new sleeping mats for this year’s Utah County Warming Center before it opens on November 1.\",\"utahCode\":null},{\"id\":519,\"headline\":\"August 19, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-08-18T14:07:49.000Z\",\"summary\":\"The public meeting will be held August 19, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1995)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_08_19_16b03d9531.pdf)\",\"utahCode\":null},{\"id\":609,\"headline\":\"August 19, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-08-17T22:55:31.000Z\",\"summary\":\"The public meeting will be held August 19, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1897)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_08_19_8146ea1639.pdf)\",\"utahCode\":null},{\"id\":602,\"headline\":\"Notice of Vacancy - North Pointe Solid Waste Special Service District Control Board\",\"postedAt\":\"2026-08-17T21:00:00.000Z\",\"summary\":null,\"body\":\"Notice is hereby provided this 12th day of August 2026, pursuant to Utah Code Section 17B-1-304 that one (1) vacancy currently exist on the North Pointe Solid Waste Special Service District Control Board (the “Board”). To be qualified for consideration for the above-mentioned Board vacancy, individuals must be a registered voter within the boundaries of the North Pointe Solid Waste Special Service District (the \\\"District\\\").\\n\\n[VIEW NOTICE](/api/media/file/Notice_2026_634_6ac2c87051.pdf)\",\"utahCode\":null},{\"id\":617,\"headline\":\"Heather Eskelson August 2026 Employee of the Month\",\"postedAt\":\"2026-08-13T16:30:00.000Z\",\"summary\":null,\"body\":\"$27\",\"utahCode\":null},{\"id\":608,\"headline\":\"The June Sucker Recovery Program Keeps Water Flowing\",\"postedAt\":\"2026-08-11T16:30:00.000Z\",\"summary\":null,\"body\":\"WEST PROVO, Utah — Water continues to move through the Provo River Delta, despite drought conditions, a sign of decades of conservation work and multi-agency cooperation to support the recovery of the June Sucker fish and the broader health of Utah Lake.\\n\\nUtah County Commissioner Skyler Beltran and Russ Franklin of Central Utah Water spoke during a visit to Provo Delta Gateway Park to highlight the ongoing efforts that keep water moving through the river and into the delta.\\n\\nFranklin, who leads the charge at Central Utah Water, offered a look back at the June Sucker Recovery Program's history. Since it began in 2002, he said, agencies across the state and federal partners have worked to secure water for the fish so it can access the Provo River and the delta.\",\"utahCode\":null},{\"id\":518,\"headline\":\"August 12, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-08-11T14:02:31.000Z\",\"summary\":\"The public meeting will be held August 12, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1994)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_08_12_23b570a3ea.pdf)\",\"utahCode\":null},{\"id\":603,\"headline\":\"Utah County Launches \\\"250 Sleeping Mats\\\" Community Donation Drive in Honor of America 250\",\"postedAt\":\"2026-08-10T22:00:00.000Z\",\"summary\":null,\"body\":\"$28\",\"utahCode\":null},{\"id\":596,\"headline\":\"August 12, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-08-10T20:47:42.000Z\",\"summary\":\"The public meeting will be held August 12, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1896)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_08_12_c2df8ff342.pdf)\",\"utahCode\":null},{\"id\":601,\"headline\":\"Beware of Property Tax Disinformation Videos \",\"postedAt\":\"2026-08-04T22:30:00.000Z\",\"summary\":null,\"body\":\"$29\",\"utahCode\":null},{\"id\":516,\"headline\":\"UC Tax Tourism Advisory Board Meeting \",\"postedAt\":\"2026-07-31T17:30:00.000Z\",\"summary\":\"\\n\\n\",\"body\":\"[View Agenda](/api/media/file/August_TTAB_Agenda_ae35346a1a.pdf)\",\"utahCode\":null},{\"id\":504,\"headline\":\"Utah County Fair Day 1\",\"postedAt\":\"2026-07-30T17:00:00.000Z\",\"summary\":null,\"body\":\"The first day of the Utah County Fair is in the books. Fun night!  Free Rodeo, Open Class \u0026 4-H judging was awesome! Commissioners Beltran, Gordon \u0026 Powers Gardner selected their winners for the \\\"Commissioner's Choice\\\" award.  Later that night...they waved to the packed house before the rodeo got underway. \\n\\nTonight is Utah County Employee night and the Monster Trucks extravaganza takes center stage!  We'll see you there!\\n\\nThursday, July 30 · Fairgrounds open 2:00 PM to 10:00 PM\\n\\nFriday, July 31 · Fairgrounds open 12:00 PM to 10:00 PM\\n\\nSaturday, August 1 · Fairgrounds open 10:00 AM to 10:00 PM\",\"utahCode\":null},{\"id\":514,\"headline\":\"July 30, 2026 Board of Commissioners of Utah County, Utah Special Meeting\",\"postedAt\":\"2026-07-29T19:00:30.000Z\",\"summary\":\"Meeting will be held July 30, 2026 at 1:00 pm in the Utah County Administration Building, 51 S University Ave Ste 319, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=2341)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_07_30_5ed24f634b.pdf)\",\"utahCode\":null},{\"id\":595,\"headline\":\"July 30, 2026 Board of Commissioners of Utah County, Utah Special Commission Meeting\",\"postedAt\":\"2026-07-29T17:22:38.000Z\",\"summary\":\"Meeting will be held July 30, 2026 at 1:00 pm in the Utah County Administration Building, 51 S University Ave Ste 319, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=2341)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_07_30_a78f07a43d.pdf)\",\"utahCode\":null},{\"id\":600,\"headline\":\"The Uniformed and Overseas Citizens Absentee Voting Act (UOCAVA) Election Notice - July 24, 2026\",\"postedAt\":\"2026-07-23T18:45:00.000Z\",\"summary\":null,\"body\":\"The Uniformed and Overseas Citizens Absentee Voting Act (UOCAVA) Election Notice UCA 20A-16-502\\n\\nJuly 24, 2026\\n\\nOur records show you're eligible to vote under the Uniformed and Overseas Citizens Absentee Voting Act (UOCAVA). You can vote in the upcoming election either with the ballot sent to you or by using a federal write-in absentee ballot (FWAB).   \\nIf you don’t receive a ballot in time to vote, you may complete a FWAB. When using a federal write-in absentee ballot, fill out the Voter Information section completely and accurately. Write in the office and candidate name(s) for the races you choose to vote for in the appropriate sections. Other Resources: www.overseasvotefoundation.org/vote/VoterInformation.htm\\n\\n[VIEW NOTICE](/api/media/file/2026_UOCAVA_NOTICE_97a72cf636.pdf)\",\"utahCode\":null},{\"id\":599,\"headline\":\"Notice of Vacancy - Alpine Cove Water Special Service District Administrative Control Board\",\"postedAt\":\"2026-07-23T17:15:00.000Z\",\"summary\":null,\"body\":\"$2a\",\"utahCode\":null},{\"id\":598,\"headline\":\"Notice of Vacancies - Utah Valley Road Special Service District Administrative Control Board\",\"postedAt\":\"2026-07-23T17:00:00.000Z\",\"summary\":null,\"body\":\"$2b\",\"utahCode\":null},{\"id\":517,\"headline\":\"Fireworks over Utah Lake on Pioneer Day!\",\"postedAt\":\"2026-07-22T16:45:00.000Z\",\"summary\":null,\"body\":\"$2c\",\"utahCode\":null},{\"id\":503,\"headline\":\"July 22, 2026 Utah County Community Reinvestment Agency Public Meeting\",\"postedAt\":\"2026-07-21T17:30:00.000Z\",\"summary\":null,\"body\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE\\n\\n**UTAH COUNTY COMMUNITY REINVESTMENT AGENCY**\\n\\nWILL HOLD A PUBLIC MEETING\\n\\nIN THE COMMISSION CHAMBERS - ROOM 1400\\n\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING\\n\\n100 E CENTER ST, PROVO, UT 84606\\n\\n**July 22, 2026 - 2:00 PM**\\n\\n[**View Agenda**](/api/media/file/07_22_2026_CRA_Agenda_70bface440.pdf)\",\"utahCode\":null},{\"id\":435,\"headline\":\"July 22, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-07-20T21:16:41.000Z\",\"summary\":\"The public meeting will be held July 22, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1895)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_07_22_a04071102f.pdf)\",\"utahCode\":null},{\"id\":421,\"headline\":\"July 22, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-07-20T21:07:41.000Z\",\"summary\":\"The public meeting will be held July 22, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1993)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_07_22_11d79f5f21.pdf)\",\"utahCode\":null},{\"id\":594,\"headline\":\"Community Development Block Grant Public Notice\",\"postedAt\":\"2026-07-20T17:15:00.000Z\",\"summary\":null,\"body\":\"[View Notice](/api/media/file/Draft_update_AAP_PY_26_Public_Notice_f5578dde07.docx)\",\"utahCode\":null},{\"id\":597,\"headline\":\"Youth Soccer National Championship becomes economic driver for Utah County\",\"postedAt\":\"2026-07-20T16:30:00.000Z\",\"summary\":null,\"body\":\"$2d\",\"utahCode\":null},{\"id\":588,\"headline\":\"Notice of Proposed Tax Increases-Utah County Combined Notice\",\"postedAt\":\"2026-07-20T06:00:00.000Z\",\"summary\":null,\"body\":\"This is a notice of a tax increase being proposed by several taxing entities to increase property tax revenue within Utah County. All concerned citizens are invited to the public hearings for the purpose of hearing comments regarding the proposed tax increases and to explain the reasons for the proposed tax increase. Use the link below to see the full list of taxing entities considering increases, the amount of additional revenue the increase is intended to generate, and what the estimated tax increase will be on the average home and business.\\n\\n#### [**List of Taxing Entity Public Hearings**](/api/media/file/2026_T_in_T_Ad_Utah_Co_Combined_Proof_e023967a5f.pdf)\",\"utahCode\":null},{\"id\":515,\"headline\":\"Community Development Block Grant Public Notice\",\"postedAt\":\"2026-07-13T21:30:00.000Z\",\"summary\":\"Public Notice for request for release of funds\",\"body\":\"[View Notice](/api/media/file/Spring_Lake_FONSI_and_NOI_RROF_002_6be1fd2583.pdf)\",\"utahCode\":null},{\"id\":593,\"headline\":\"Employee of The Month July 2026\",\"postedAt\":\"2026-07-09T22:30:00.000Z\",\"summary\":null,\"body\":\"Deputy Carson, the School Resource Officer at Sage Canyon Middle School in Eagle Mountain, is a model of dedication and professionalism. She prioritizes student safety and well-being in every aspect of her daily duties, maintaining a visible presence and building strong relationships with students and staff. Her goal is to provide a safe learning environment where students feel supported.  She strives to be a positive role model and trusted resource beyond enforcement. \\n\\nDeputy Carson also shines in investigations, taking the time to ensure each case is thoroughly and fairly resolved. Her attention to detail, persistence, and commitment reflects the highest standards of law enforcement. She regularly assists fellow deputies, lending support across school incidents and patrol duties, underscoring exceptional teamwork and dependability. \\n\\nFor these reasons, Deputy Carson embodies outstanding professional conduct and is deserving of July’s Employee of the Month.   \\n\\nCongratulations Deputy Carson!\",\"utahCode\":null},{\"id\":502,\"headline\":\"2026 Freedom Festival Highlights!\",\"postedAt\":\"2026-07-08T17:30:00.000Z\",\"summary\":null,\"body\":\"The 2026 Freedom Festival and all the surrounding events have come to an end!  Below is a video highlighting all the awesome events we were a part of and a message from the Commissioners on what Independence Day means to Utah County, especially during this 250 year celebration.\",\"utahCode\":null},{\"id\":592,\"headline\":\"The 2026 America’s Freedom Festival Parade Draws More Than 350,000 Spectators\",\"postedAt\":\"2026-07-07T16:15:00.000Z\",\"summary\":null,\"body\":\"PROVO, Utah — The 2026 America’s Freedom Festival Parade drew more than 350,000 spectators on July 4, cementing its status as one of the largest Independence Day celebrations in the United States and in the Western United States, organizers said.\\n\\nThe highly anticipated parade featured more than 100 entries, historic floats and military displays, bringing massive crowds to University Avenue in downtown Provo. Die-hard attendees regularly camp out along the parade route the day before to secure premium viewing spots.\\n\\nThe festival generates more than $25.7 million in annual economic impact for the local economy, officials said, underscoring its role as an economic engine for the region. As the busiest week of the year for Provo and surrounding cities, the multi-day festival drives activity across tourism, hospitality and downtown commerce.\",\"utahCode\":null},{\"id\":416,\"headline\":\"July 8, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-07-07T14:00:16.000Z\",\"summary\":\"The public meeting will be held July 8, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1992)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_07_08_bbfda0d04c.pdf)\",\"utahCode\":null},{\"id\":355,\"headline\":\"July 8, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-07-06T20:06:24.000Z\",\"summary\":\"The public meeting will be held July 8, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1894)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_07_08_4651504b40.pdf)\",\"utahCode\":null},{\"id\":591,\"headline\":\"Freedom Balloon Festival lights up Provo skies\",\"postedAt\":\"2026-07-06T17:00:00.000Z\",\"summary\":null,\"body\":\"PROVO, Utah — The Freedom Balloon Festival, an annual Fourth of July tradition in Provo, drew more than 25 hot air balloons to Fox Field for three morning launches, a Friday night Balloon Glow and pilot competitions.\\n\\nResidents and visitors awoke before dawn to watch the balloons inflate and take off, with many saying the experience is a staple of local summer traditions. “I grew up here in Provo and this is a staple for a lot of families. You get up early before the sun comes up. Get down here, get a good spot and watch the balloons inflate and take off,” County Commissioner Amelia Powers Gardner said.\\n\\nThe festival featured three morning launches, a Friday night Balloon Glow and pilot competitions.\",\"utahCode\":null},{\"id\":21,\"headline\":\"Community Development Block Grant Public Notice\",\"postedAt\":\"2026-07-01T08:00:00.000Z\",\"summary\":\"\\n\",\"body\":\"[View Notice](/api/media/file/FONSI_RROF_for_The_Refuge_db8da71e0f.pdf)\",\"utahCode\":null},{\"id\":585,\"headline\":\"July 7, 2026 Board of County Canvassers of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-06-30T19:30:00.000Z\",\"summary\":null,\"body\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT\\n\\n**BOARD OF COUNTY CANVASSERS OF UTAH COUNTY, UTAH**\\n\\nWILL HOLD A PUBLIC MEETING IN THE\\n\\nUTAH COUNTY COMMISSION CHAMBERS – ROOM 1400\\n\\nOF THE UTAH COUNTY ADMINISTRATION BUILDING\\n\\n100 EAST CENTER STREET, PROVO, UTAH 84606\\n\\n**July 7, 2026– 2:00 pm**\\n\\n[View Agenda](/api/media/file/07_07_2026_Board_of_Canvassers_3dce518a20.pdf)\",\"utahCode\":null},{\"id\":550,\"headline\":\"July 1, 2026 - Post-Election Audit\",\"postedAt\":\"2026-06-29T18:30:00.000Z\",\"summary\":null,\"body\":\"Notice of Post-Election Audit  \\nIn accordance with Utah Code §§ 20A-4-104(1) and 20A-1-108(1), the Utah County Elections Division will conduct a post-election audit of the 2026 Primary Election on Wednesday July 1, 2026, at 10:00 am. Anyone desiring to witness or participate in the audit is invited to attend. The audit will be conducted at the following location:\\n\\n  \\nUtah County Administration Building  \\nBallot Processing Center  \\n100 E Center Street, Room LL700  \\nProvo, UT 84606\\n\\n[View Notice](/api/media/file/Notice_of_Post_Election_Audit_207b46b4a6.pdf)\",\"utahCode\":null},{\"id\":590,\"headline\":\"Employee of the Month June 2026\",\"postedAt\":\"2026-06-25T16:15:00.000Z\",\"summary\":null,\"body\":\"$2e\",\"utahCode\":null},{\"id\":589,\"headline\":\"June 26, 2026 Utah County Criminal Justice Coordinating Council Public Meeting\",\"postedAt\":\"2026-06-24T15:00:00.000Z\",\"summary\":null,\"body\":\"$2f\",\"utahCode\":null},{\"id\":538,\"headline\":\"Utah County wins Best Innovative Use of Technology Award\",\"postedAt\":\"2026-06-23T16:30:00.000Z\",\"summary\":null,\"body\":\"The state of Utah recognized Utah County as the winner of the Best Innovative Use of Technology Award for a project called AI-Driven Storm Drain Detection for Mosquito Abatement. It’s a very cool project that leveraged AI to identify storm drains. By using AI, Utah County nearly doubled the number of drains they previously knew about. \\n\\nWhat makes this win so exciting? It’s a bold leap from manual labor to smart technology in the fight against West Nile virus. West Nile prevention in urban Utah counties hinges on eliminating mosquito breeding sites from storm drains. But cataloging tens of thousands of drainage structures across sprawling municipalities has long been an overwhelming logistical challenge. This project flips the script by using artificial intelligence to automatically identify storm drains from high-resolution aerial imagery.\",\"utahCode\":null},{\"id\":521,\"headline\":\"June 24, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-06-23T14:10:20.000Z\",\"summary\":\"The public meeting will be held June 24, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1991)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_06_24_c3608d2f7f.pdf)\",\"utahCode\":null},{\"id\":513,\"headline\":\"June 24, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-06-22T22:14:04.000Z\",\"summary\":\"The public meeting will be held June 24, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1893)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_06_24_beb56b053c.pdf)\",\"utahCode\":null},{\"id\":499,\"headline\":\"Young Washington Advanced Screening for Utah County\",\"postedAt\":\"2026-06-17T21:30:00.000Z\",\"summary\":null,\"body\":\"Young Washington is coming to a theater near you on 4th of July weekend. Angel Studios provided Utah County with an advanced screening in celebration of the 250th anniversary of our nation. In the film, young George Washington faces war, betrayal, and impossible choices that will forge a leader.\\n\\nThis film explores the courage, sacrifice, and destiny that forged a legendary leader. With breathtaking cinematography, gripping drama, and historical intensity, this new film reveals the untold struggle that would change the fate of the world forever.  It was a great watch!\\n\\nSpecial thanks to the Orem Public Library for screening the film.\",\"utahCode\":null},{\"id\":559,\"headline\":\"Sample Ballot for the June 23, 2026 Primary Election\",\"postedAt\":\"2026-06-17T19:45:00.000Z\",\"summary\":null,\"body\":\"[VIEW BALLOT](/api/media/file/2026_Primary_NEW_Sample_Ballot_4b4ee98334.pdf)\",\"utahCode\":null},{\"id\":549,\"headline\":\"America 250 Freedom Festival Utah' Prayer Breakfast\",\"postedAt\":\"2026-06-16T20:00:00.000Z\",\"summary\":null,\"body\":\"The Freedom Festival’s Prayer Breakfast, held in Provo, Utah is a nondenominational gathering that unites community members, faith groups, and civic leaders in prayer for America and her leaders.  \\n\\nThe audience enjoyed inspiring remarks from keynote speaker, Utah Attorney General Derek Brown, uplifting music, and a chance to reflect on faith, unity, and the values that strengthen the United States of America.\",\"utahCode\":null},{\"id\":537,\"headline\":\"June 18, 2026 Utah County Capital Improvement Plan Committee Public Work Session\",\"postedAt\":\"2026-06-15T22:45:00.000Z\",\"summary\":null,\"body\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE \\n\\n**UTAH COUNTY CAPITAL IMPROVEMENT PLAN COMMITTEE**\\n\\nWILL HOLD A PUBLIC ONLINE ONLY WORK SESSION\\n\\nLINK: \\n\\n[**https://teams.microsoft.com/meet/294388031901732?p=rdMmfBs9fygd1IW0M7**](https://teams.microsoft.com/meet/294388031901732?p=rdMmfBs9fygd1IW0M7)\\n\\nON WEDNESDAY, JUNE 18, 2026 AT 8:30AM.\\n\\n**WORK SESSION AGENDA**\\n\\n**1.**         **REVIEW PROPOSED AMENDMENTS TO THE 2026-2028 CIP PLAN**\\n\\nIn compliance with the Americans with Disabilities Act, individuals needing special accommodations (including auxiliary communicative aids and services) during this meeting should notify the Utah County Clerk’s Office at (801) 851-8113. \\n\\n[VIEW AGENDA](/api/media/file/CIP_Public_Meeting_06_18_2026_77a19b9351.pdf)\",\"utahCode\":null},{\"id\":558,\"headline\":\"Community Development Block Grant Public Notice\",\"postedAt\":\"2026-06-15T17:45:00.000Z\",\"summary\":\"Community Development Block Grant Public Notice\",\"body\":\"[View Notice](/api/media/file/UTCO_CP_Public_Notice_for_July_2026_07a3d52638.docx)\",\"utahCode\":null},{\"id\":548,\"headline\":\"Utah County State Stage 1 Restrictions\",\"postedAt\":\"2026-06-12T17:45:00.000Z\",\"summary\":null,\"body\":\"Due to current and forecasted weather conditions coupled with the extremely dry vegetation conditions in Utah County, the State Forester, in consultation with the County Commission of the affected county, has determined that measures must be taken to prevent the ignition of forest and rangeland fires.  \\n\\n[View Notice](/api/media/file/2026_Utah_County_State_Stage_1_Restrictions_signed_202606101213326759_ec448ce40f.pdf)\",\"utahCode\":null},{\"id\":583,\"headline\":\"June 11, 2026  Free Public Town Hall Elections Meeting\",\"postedAt\":\"2026-06-09T20:15:00.000Z\",\"summary\":null,\"body\":\"$30\",\"utahCode\":null},{\"id\":536,\"headline\":\"The Chosen Boosts Local Economy \",\"postedAt\":\"2026-06-09T16:30:00.000Z\",\"summary\":null,\"body\":\"GOSHEN, Utah — The set of the television series The Chosen has become a focal point in Utah County, with a biblical village in Goshen built by the Church of Jesus Christ of Latter-day Saints and production crews turning the landscape into a stand-in for biblical-era scenes. \\n\\nOn the ground, the set is both impressive and welcoming due in part to an incredible production designer and art team.  Utah became central to the project when President and Executive Producer, Brad Pelo called Dallas Jenkins, the series creator. “I reached out and invited him to meet me in Utah and showed him not only the landscape, but we came here to Goshen. He said, ‘This is the place. This is where I would love to tell my stories.’ ” \\n\\nUtah emerged as the series’ second home, with production starting on season two, underscoring the state’s growing role in the show’s development and production.\",\"utahCode\":null},{\"id\":379,\"headline\":\"June 10, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-06-09T14:44:33.000Z\",\"summary\":\"The public meeting will be held June 10, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1990)\\n\\n[Agenda](/api/media/file/BOE_Agenda_2026_06_10_9ea40c80f2.pdf)\",\"utahCode\":null},{\"id\":353,\"headline\":\"June 10, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-06-08T20:09:29.000Z\",\"summary\":\"The public meeting will be held June 10, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1892)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_06_10_efbb43b6b1.pdf)\",\"utahCode\":null},{\"id\":584,\"headline\":\"Commissioner Beltran Participates in “Come to the Table Homeless Experience”\",\"postedAt\":\"2026-06-08T17:15:00.000Z\",\"summary\":null,\"body\":\"$31\",\"utahCode\":null},{\"id\":347,\"headline\":\"Planning Commission Meeting and Notice of Public Hearing June 16, 2026\",\"postedAt\":\"2026-06-05T18:45:00.000Z\",\"summary\":null,\"body\":\"The Utah County Planning Commission will hold a public hearing at its regular meeting on **June 16th, 2026, at 5:30 p.m. in Room 1400 of the Utah County Administration Building, 100 East Center Street, Provo, Utah**\\n\\n[VIEW AGENDA](/api/media/file/Agenda_2026_June_16_e0fad84ecf.pdf)\\n\\n[VIEW PUBLIC NOTICE](/api/media/file/Public_Hearing_6_16_26_7c15729d0e.pdf)\",\"utahCode\":null},{\"id\":582,\"headline\":\"Utah County Jail's Food Handler Permit Program Gives Inmates a Real Shot at Success \",\"postedAt\":\"2026-06-04T16:00:00.000Z\",\"summary\":null,\"body\":\"$32\",\"utahCode\":null},{\"id\":462,\"headline\":\"Notice of Vacancy - North Pointe Solid Waste Special Service District Control Board\",\"postedAt\":\"2026-06-01T16:00:00.000Z\",\"summary\":null,\"body\":\"$33\",\"utahCode\":null},{\"id\":567,\"headline\":\"Notice of Vacancy - South Utah Valley Animal Services Special Service District Administrative Control Board\",\"postedAt\":\"2026-06-01T15:45:00.000Z\",\"summary\":null,\"body\":\"$34\",\"utahCode\":null},{\"id\":361,\"headline\":\"\\\"I Voted\\\" 250 Sticker Contest Winners\",\"postedAt\":\"2026-05-27T22:45:00.000Z\",\"summary\":null,\"body\":\"Big congratulations to the three winners of our \\\"I Voted\\\" 250 Sticker Contest.  The winning entry is the official “I Voted” sticker for the November 2026 General Election! The contest was open to all Utah County students in grades 5–9.\\n\\n1st Place: Ezra Nguyen - $150 + design featured countywide \\n\\n2nd Place: McKenzie Stevens - $100 \\n\\n3rd Place: Eden Lynn Frisby - $50 \\n\\nTheir creativity stood out from the crowd, and they were recognized and rewarded at our recent commission meeting. \\n\\nThe winners were chosen by elected officials in Utah County and by city recorders. Thanks to everyone who participated and celebrated the power of voting!\",\"utahCode\":null},{\"id\":263,\"headline\":\"May 27, 2026 Utah County Community Reinvestment Agency Public Meeting\",\"postedAt\":\"2026-05-26T17:15:00.000Z\",\"summary\":null,\"body\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE **UTAH COUNTY COMMUNITY REINVESTMENT AGENCY** WILL HOLD A PUBLIC MEETING IN THE COMMISSION CHAMBERS - ROOM 1400 OF THE UTAH COUNTY ADMINISTRATION BUILDING 100 E CENTER ST, PROVO, UT 84606 **May 27, 2026 - 2:00 PM**\\n\\n[**View Agenda**](/api/media/file/05_27_2026_CRA_Meeting_Agenda_b9253d97cb.pdf)\",\"utahCode\":null},{\"id\":576,\"headline\":\"May 27, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-05-26T16:02:57.000Z\",\"summary\":\"The public meeting will be held May 27, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[Agenda with Documents](https://agenda.utahcounty.gov/agenda?id=1891)\\n\\n[Agenda](/api/media/file/Commission_Agenda_2026_05_27_14c10d6a23.pdf)\",\"utahCode\":null},{\"id\":566,\"headline\":\"Utah County Sheriff's Annual Awards\",\"postedAt\":\"2026-05-22T21:30:00.000Z\",\"summary\":null,\"body\":\"Utah County Sheriff's Department recently hosted its annual award ceremony, a carefully planned evening designed to recognize and celebrate the extraordinary, selfless dedication of the men and women who serve with the Utah County Sheriff’s Office. The event provided a formal platform to highlight the courage, professionalism, and tireless commitment demonstrated by deputies and support staff who, through long hours and challenging assignments, upheld the highest standards of public safety. \\n\\nNominations came from fellow deputies and colleagues across the office, reflecting a broad range of incidents and operations throughout 2025 in which teamwork, sound judgment, and compassionate service made a tangible difference in the community. In addition to deputy and staff recognitions, several local residents were honored for their decisive actions in emergency situations, their willingness to intervene, and their role in saving lives.\",\"utahCode\":null},{\"id\":557,\"headline\":\"Election Notice\",\"postedAt\":\"2026-05-22T15:00:00.000Z\",\"summary\":null,\"body\":\"$35\",\"utahCode\":null},{\"id\":581,\"headline\":\"New Amphitheater in Provo Canyon\",\"postedAt\":\"2026-05-19T23:00:00.000Z\",\"summary\":null,\"body\":\"PROVO, Utah — Vesper Amphitheater is planned for Provo Canyon, transforming an existing gravel pit into a year-round entertainment destination with indoor and outdoor capacity, officials said. The project aims to blend entertainment with the canyon’s natural setting while preserving the landscape for future generations.\\n\\nThe project is anchored by the belief that entertainment and nature can coexist without compromising the canyon’s character. It seeks to transform rather than overwhelm the landscape and to honor the canyon’s reverence.\\n\\nIndoor capacity is planned for about 8,000 during winter configurations, with outdoor capacity up to 20,000 in the summer. Groundbreaking is anticipated in spring 2027. The venue is designed to offer Utah a setting unlike anywhere else in the Mountain West, with both indoor and outdoor spaces that complement each other across seasons.\",\"utahCode\":null},{\"id\":554,\"headline\":\"Notice of Ballot Drop Box Locations\",\"postedAt\":\"2026-05-19T17:30:00.000Z\",\"summary\":null,\"body\":\"$36\",\"utahCode\":null},{\"id\":546,\"headline\":\"Notice of Early Voting\",\"postedAt\":\"2026-05-19T17:30:00.000Z\",\"summary\":null,\"body\":\"$37\",\"utahCode\":null},{\"id\":580,\"headline\":\"May 13, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-05-12T16:54:43.000Z\",\"summary\":\"The public meeting will be held May 13, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":\"[View Agenda](/api/media/file/05_13_2026_Commission_Meeting_Agenda_03dbb30ec5.pdf)\",\"utahCode\":null},{\"id\":565,\"headline\":\"May 13, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-05-11T20:16:04.000Z\",\"summary\":\"The public meeting will be held May 13, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":null,\"utahCode\":null},{\"id\":564,\"headline\":\"Notice of Logic and Accuracy Testing - May 28, 2026\",\"postedAt\":\"2026-05-11T19:15:00.000Z\",\"summary\":null,\"body\":\"NOTICE OF LOGIC AND ACCURACY TESTING\\n\\nIn accordance with Utah Code § 20A-4-104(1)(b), the Utah County Clerk will conduct a logic and accuracy test of automatic tabulating equipment prior to the Primary Elections to be held on June 23, 2026, for Utah County federal, state, and county races. The logic and accuracy test is open to the public and will be held on Thursday, May 28, 2026, at 10:00 AM Mountain Time at the following location:  \\nUtah County Administration Building  \\nBallot Processing Center  \\n100 E Center Street, Room LL700  \\nProvo, UT 84606\\n\\n[VIEW NOTICE](/api/media/file/L_and_A_Public_Notice_3cd861bf57.pdf)\",\"utahCode\":null},{\"id\":556,\"headline\":\"Utah County Commissioners Pickleball Tournament Benefits the Children’s Justice Center\",\"postedAt\":\"2026-05-06T17:00:00.000Z\",\"summary\":null,\"body\":\"Saratoga Spring, Utah - The second annual Utah County Commissioners Pickleball Tournament was a resounding success, bringing together players and supporters from across the county to stand behind child victims of abuse. Held at The Picklr Lehi, the event was more than just a day of friendly competition—it was a community rally to ensure that every child who comes to the Utah County Children’s Justice Center (CJC) has access to the healing services they deserve.\\n\\n**Why this event matters**  \\nThe CJC serves as a soft-landing spot for children after traumatic experiences, guiding families toward the resources they need for healing. In recent years, the center faced a significant funding challenge when a notable portion of federal funding that financed therapy for kids was lost. The organizers’ goal for this year was to help replenish those critical funds and ensure ongoing access to trauma-focused therapy and other essential services.\",\"utahCode\":null},{\"id\":501,\"headline\":\"Notice of Public Hearing - June 10, 2026\",\"postedAt\":\"2026-05-04T20:00:00.000Z\",\"summary\":\"NOTICE OF PUBLIC HEARING\\nNotice to Reorganize Timpanogos Special Service District\\n\\nIn accordance with Utah Code Section 17D-1-604 and 17D-1-205, NOTICE is hereby given that the Utah County Board of Commissioners intends to reorganize the Timpanogos Special\\nService District (\\\"TSSD\\\") in a  special district.\\n\\n\",\"body\":\"[VIEW NOTICE](/api/media/file/Notice_2026_320_ec46f55e2d.pdf)\",\"utahCode\":null},{\"id\":547,\"headline\":\"Two banners rise at Provo Historic Courthouse to mark historic milestones\",\"postedAt\":\"2026-05-04T15:30:00.000Z\",\"summary\":\"\\n\",\"body\":\"Utah County has installed two new banners at the Provo Historic Courthouse, each celebrating a milestone of national and state history. One banner honors Utah’s Old Historic Courthouse, built 100 years ago, while the other commemorates the United States’ 250 years of independence. The banners offer a moment of reflection on the building's history and the country’s founding, as residents pass by the courthouse in downtown Provo.\",\"utahCode\":null},{\"id\":579,\"headline\":\"Anywhere you want to go…Fly Provo!\",\"postedAt\":\"2026-04-30T18:30:00.000Z\",\"summary\":null,\"body\":\"Welcome to the Provo Airport!\\n\\nSo many exciting things are happening. The biggest one is expansion from four gates to 10 gates over the next two years. That will bring more carriers, more routes, more convenience to local residents, but also bring the economic driver of visitors and guests to Utah Valley. \\n\\nThe Provo Airport will never compete with Salt Lake International Airport, especially when it comes to non-stop flights, and they’re not trying to. That's not why the Provo Airport was built.\",\"utahCode\":null},{\"id\":555,\"headline\":\"Drive Thru Measles Vaccination Clinic\",\"postedAt\":\"2026-04-29T15:15:00.000Z\",\"summary\":null,\"body\":\"Michael Leman, Nursing Director of the Utah County Health Department, drove us around as part of the department’s push to encourage vaccination in response to an uptick in measles cases in Utah County.\\n\\nWe're doing a drive through measles vaccination clinic for the community. We started seeing cases about mid 2025 since that time, we've had 95 confirmed measles cases the entire state.\\n\\nI believe we've surpassed 600 cases at this point; measles is a very, very contagious disease. It spreads very easily. It's easily prevented with the measles vaccination.\\n\\nThe MMR vaccine has been around for a long time, very safe, very effective. Has about a 93% to 97% efficacy rate, and it's the best thing you can do to keep yourself and keep your family protected.\\n\\nIf this at least gets people thinking about it, if they don't come out today, it’s great if they talk to their primary care doctors about it. Obviously, the more people that if we can get vaccinated, the less we have to worry about it spreading.\",\"utahCode\":null},{\"id\":545,\"headline\":\"Utah County Pickleball Tournament aims to Replace Funds for Children\",\"postedAt\":\"2026-04-24T18:30:00.000Z\",\"summary\":null,\"body\":\"$38\",\"utahCode\":null},{\"id\":500,\"headline\":\"May 13, 2026 Notice of Public Hearing\",\"postedAt\":\"2026-04-24T00:00:00.000Z\",\"summary\":null,\"body\":\"PUBLIC NOTICE IS HEREBY GIVEN THAT THE  \\n**BOARD OF COUNTY COMMISSIONERS, UTAH COUNTY, UTAH**  \\nWILL HOLD A PUBLIC HEARING TO RECEIVE COMMENT ON THE DISPOSAL OF PUBLIC PROPERTY, IDENTIFIED BELOW\\n\\nIN THE COMMISSION CHAMBERS, ROOM 1400  \\nOF THE UTAH COUNTY ADMINISTRATION BUILDING  \\n100 East Center Street, Provo, Utah  \\n**May 13, 2026 - 2:00 P.M.**\\n\\nPROPERTY TO BE DISPOSED OF  \\nApproximately 20.4 acres of real property near 6400 N 5050 W, American Fork, UT 84003.\\n\\nPUBLIC COMMENTS\\n\\nIn compliance with the American with Disabilities Act, individuals needing special accommodations (including communicative aids and services) during this meeting should notify the Utah County Clerk's Office at (801) 851-8113 at least three days prior to the meeting. Board members may participate electronically as needed, with the anchor location for the public meeting to be the same as listed above.\\n\\n[VIEW NOTICE](/api/media/file/Notice_2026_325_7c01833253.pdf)\",\"utahCode\":null},{\"id\":461,\"headline\":\"Tricia Roger is Utah County's April Employee of the Month\",\"postedAt\":\"2026-04-23T22:15:00.000Z\",\"summary\":null,\"body\":\"$39\",\"utahCode\":null},{\"id\":363,\"headline\":\"April 24, 2026 Utah County Criminal Justice Coordinating Council Public Meeting\",\"postedAt\":\"2026-04-23T00:00:00.000Z\",\"summary\":\"PUBLIC NOTICE IS HEARBY GIVEN THAT \\nTHE UTAH COUNTY CRIMINAL JUSTICE COORDINATING COUNCIL \\nWILL HOLD A PUBLIC MEETING AT 51 SOUTH UNIVERSITY AVE., PROVO, UTAH 84601 IN THE HISTORIC COURTHOUSE, 3rd FLOOR COMMISSION CONFERENCE ROOM \\nApril 24, 2026 - 12 p.m. \",\"body\":null,\"utahCode\":null},{\"id\":352,\"headline\":\"Safe Drug Disposal\",\"postedAt\":\"2026-04-21T20:30:00.000Z\",\"summary\":null,\"body\":\"Protect our environment and community by properly disposing of your prescription medications at a permanent local medication drop box near you.  [Safe Drug Disposal - Utah Valley DPC](https://utahvalleydpc.org/safe-opioid-disposal/)\\n\\nProperly disposing of unused opioid medication prevents the risk of addiction, misuse, and overdoses. 75% of Utahans currently addicted to opioids get them from a friend or family member. You can dispose of almost any medication at these drop box locations, especially any over-the-counter or prescription medication (i.e. opioids or prescription cough medication).\",\"utahCode\":null},{\"id\":75,\"headline\":\"April 22, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-04-21T19:16:54.000Z\",\"summary\":\"The public meeting will be held April 22, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":null,\"utahCode\":null},{\"id\":578,\"headline\":\"April 22, 2026 Utah County Reinvestment Agency Public Meeting\",\"postedAt\":\"2026-04-21T18:30:00.000Z\",\"summary\":null,\"body\":null,\"utahCode\":null},{\"id\":577,\"headline\":\"April 22, 2026 Board of Equalization of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-04-21T14:52:04.000Z\",\"summary\":\"The public meeting will be held April 22, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":null,\"utahCode\":null},{\"id\":563,\"headline\":\"HABs Happen \",\"postedAt\":\"2026-04-17T21:00:00.000Z\",\"summary\":null,\"body\":\"$3a\",\"utahCode\":null},{\"id\":575,\"headline\":\"Drive-Up Immunization Clinic\",\"postedAt\":\"2026-04-16T21:00:00.000Z\",\"summary\":null,\"body\":\"Free MMR (measles, mumps, rubella) vaccine clinic in Spanish Fork!  \\n  \\nApril 22, 2026  \\n3–6 PM  \\nSpanish Fork Fairgrounds (Ponderosa Building)  \\n475 S Main St, Spanish Fork, UT  \\n  \\nFor kids (6+ months), teens \u0026 adults not up to date. Limited supply—free while it lasts!  \\n  \\nThe MMR vaccine is a critical tool in preventing the spread of highly contagious diseases that can lead  \\nto serious health complications. With measles cases actively being reported in Utah County and  \\nthroughout Utah, staying up to date on the MMR vaccine is an important step to protect yourself and  \\nthe community.  \\n  \\nThis drive-thru clinic is designed to make vaccination quick, easy, and accessible for individuals and  \\nfamilies. Attendees can remain in their vehicles while trained healthcare professionals administer the  \\nvaccine safely and efficiently.\",\"utahCode\":null},{\"id\":534,\"headline\":\"Planning Commisssion Meeting Agenda\",\"postedAt\":\"2026-04-15T17:00:00.000Z\",\"summary\":\"Planning Commission Meeting Agenda and Public Hearing Notice for April 21st 2026 \",\"body\":null,\"utahCode\":null},{\"id\":535,\"headline\":\"CANCELLED _ April 21, 2026 Notice of Joint Public Hearing\",\"postedAt\":\"2026-04-10T18:45:00.000Z\",\"summary\":\"NOTICE OF JOINT PUBLIC HEARING\\nPursuant to the provisions of Utah Code Section 17-61-306, you are hereby\\nnotified that a joint public hearing will be held on Tuesday, April 21, 2026, at\\n5:00 p.m., at the Santaquin City Hall 110 South Center Street, Santaquin, Utah\\nwith the Boards of County Commissioners of Utah and Juab counties to take\\npublic comment regarding the proposal to adjust the existing boundary line\\nbetween Utah County and Juab County.\",\"body\":\"[Cancellation Notice](/api/media/file/2026_Joint_Commissionmeeting_cancellation_1d323401ea.pdf)\",\"utahCode\":null},{\"id\":532,\"headline\":\"UC Tax Tourism Advisory Board Meeting \",\"postedAt\":\"2026-04-10T17:30:00.000Z\",\"summary\":null,\"body\":null,\"utahCode\":null},{\"id\":533,\"headline\":\"Notice of Vacancies on the North Pointe Solid Waste Special Service District Control Board\",\"postedAt\":\"2026-04-07T16:30:00.000Z\",\"summary\":null,\"body\":null,\"utahCode\":null},{\"id\":512,\"headline\":\"NOTICE OF INITATION OF SECURE RURAL SCHOOLS ACT TITLE III PROJECT\",\"postedAt\":\"2026-04-02T14:30:00.000Z\",\"summary\":null,\"body\":null,\"utahCode\":null},{\"id\":511,\"headline\":\"April 1, 2026 Utah County Reinvestment Agency Public Meeting\",\"postedAt\":\"2026-03-31T18:30:00.000Z\",\"summary\":null,\"body\":null,\"utahCode\":null},{\"id\":510,\"headline\":\"April 1, 2026 Board of Directors of the Municipal Building Authority of Utah County, UT Public Meeting\",\"postedAt\":\"2026-03-31T18:30:00.000Z\",\"summary\":null,\"body\":null,\"utahCode\":null},{\"id\":531,\"headline\":\"April 1, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-03-31T17:46:27.000Z\",\"summary\":\"The public meeting will be held April 1, 2026 at 2:00 pm in the Utah County Administration Building, 100 E Center St, Room 1400, Provo, UT\",\"body\":null,\"utahCode\":null},{\"id\":530,\"headline\":\"April 1, 2026 Board of Commissioners of Utah County, Utah Public Meeting\",\"postedAt\":\"2026-03-31T17:24:17.000Z\",\"summary\":\"