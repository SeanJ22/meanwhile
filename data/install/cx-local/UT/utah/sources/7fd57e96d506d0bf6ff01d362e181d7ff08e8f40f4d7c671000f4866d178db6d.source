		</dd>

		
			<dt>Contact Name</dt>
			<dd>Utah County Clerks Office</dd>
		

		
			<dt>Contact Email</dt>
			<dd><a href="mailto:clerkoffice@utahcounty.gov">clerkoffice@utahcounty.gov</a></dd>
		

		

	</dl>

</section>

