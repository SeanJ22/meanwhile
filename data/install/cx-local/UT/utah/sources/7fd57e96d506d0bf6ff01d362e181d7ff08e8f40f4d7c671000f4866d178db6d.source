<h1>Sample Ballot for the November 3, 2026 General Election</h1>





<p class="buttons">
	<a href="#subscribeByEmailSection" class="btn">Subscribe to Public Body</a>
</p>

<section>

	<h3>General Information</h3>

	<dl>

