                                                            <th scope="row" class="text-wrap">
                                                                JUDDST
                                                                    <p class="text-muted text-break">From King County</p>
                                                            </th>
                                                            <td class="text-wrap text-break">
                                                                    <strong>Description</strong>
                                                                    <p>Abbreviated name</p>
                                                                        <strong>Domain</strong>
                                                                                <p>SH - Abbreviated name/code for Shoreline division</p>
                                                                                <p>W - Abbreviated name/code for West division</p>
                                                                                <p>SW - Abbreviated name/code for Southwest division</p>
                                                                                <p>SE - Abbreviated name/code for Southeast division</p>
                                                                                <p>NE - Abbreviated name/code for Northeast division</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th scope="row" class="text-wrap">
                                                                NAME
                                                                    <p class="text-muted">No Source Noted</p>
                                                            </th>
                                                            <td class="text-wrap text-break">
                                                                    <strong>Description</strong>
                                                                    <p>Name of District</p>
                                                                        <strong>Domain</strong>
                                                                                <p>Shoreline division - Name of district division</p>
                                                                                <p>West division - Name of district division</p>
                                                                                <p>Southwest division - Name of district division</p>
                                                                                <p>Southeast division - Name of district division</p>
                                                                                <p>Northeast division - Name of district division</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th scope="row" class="text-wrap">
                                                                Shape.STArea()
                                                                    <p class="text-muted text-break">From SQL Server</p>
                                                            </th>
                                                            <td class="text-wrap text-break">
                                                                    <strong>Description</strong>
                                                                    <p>Returns the area of a geometry instance in square units, based on the spatial reference identifier (SRID) of the geometry.</p>
                                                                    <strong>Domain</strong>
                                                                    <p>Double</p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th scope="row" class="text-wrap">
                                                                Shape.STLength()
                                                                    <p class="text-muted text-break">From SQL Server</p>
                                                            </th>
                                                            <td class="text-wrap text-break">
                                                                    <strong>Description</strong>
                                                                    <p>Returns the total length of the elements in a geometry instance.</p>
                                                                    <strong>Domain</strong>
                                                                    <p>Double</p>
                                                            </td>
                                                        </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
