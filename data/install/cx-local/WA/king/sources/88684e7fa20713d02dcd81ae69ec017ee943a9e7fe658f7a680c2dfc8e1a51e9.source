        <!-- Load the ArcGIS Maps SDK for JavaScript from CDN -->
        <script type="module" src="https://js.arcgis.com/5.0/"></script>
        <!-- Configure the IdentityManager before ArcGIS Map Components load -->
        <script type="module">
            const [FeatureLayer] = await $arcgis.import([
                "@arcgis/core/layers/FeatureLayer.js"
            ]);
            const featureLayerUrl = "https://services.arcgis.com/Ej0PsM5Aw677QF1W/arcgis/rest/services/JUDDST_AREA_409/FeatureServer/0";
            const mapElements = [
                document.getElementById("desktop-map"),
                document.getElementById("mobile-map")
            ].filter(Boolean);

            for (const mapElement of mapElements) {
                await mapElement.viewOnReady();
                const featureLayer = new FeatureLayer({ url: featureLayerUrl });
                mapElement.map.add(featureLayer);
                await mapElement.whenLayerView(featureLayer);

                if (featureLayer.fullExtent) {
                    await mapElement.goTo(featureLayer.fullExtent, { animate: true, duration: 2500 });
                    mapElement.constraints = { geometry: featureLayer.fullExtent };
                }
            }
        </script>
    <script>
        window.copyToClipboard = function (button) {
            const value = button.dataset.copyValue;
            const label = button.dataset.copyLabel;
            const statusRegions = document.querySelectorAll('.copy-status');

            const copyWithFallback = () => {
                const textArea = document.createElement('textarea');
                textArea.value = value;
                textArea.setAttribute('readonly', '');
                textArea.style.position = 'fixed';
                textArea.style.opacity = '0';
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();

                let copied;
                try {
                    copied = document.execCommand('copy');
                } finally {
                    textArea.remove();
                }

                if (!copied) {
                    throw new Error('Clipboard copy failed.');
                }
            };

            button.dataset.copyOriginalText ??= button.textContent.trim();
            const showSuccess = () => {
                statusRegions.forEach(status => {
                    status.textContent = '';
                    status.classList.remove('text-danger');
                    status.classList.remove('text-success');
                });
                button.textContent = 'Copied ✓';
                button.classList.remove('btn-outline-dark');
                button.classList.add('copy-success');
                window.clearTimeout(button.copyFeedbackTimeout);
                button.copyFeedbackTimeout = window.setTimeout(() => {
                    button.textContent = button.dataset.copyOriginalText;
                    button.classList.remove('copy-success');
                    button.classList.add('btn-outline-dark');
                }, 2000);
            };

            const showFailure = () => {
                statusRegions.forEach(status => {
                    status.textContent = `Unable to copy ${label}. Clipboard access is unavailable.`;
                    status.classList.remove('text-success');
                    status.classList.add('text-danger');
                });
            };

            if (navigator.clipboard?.writeText) {
                navigator.clipboard.writeText(value).then(showSuccess, showFailure);
                return;
            }

            try {
                    copyWithFallback();
                showSuccess();
            } catch {
                showFailure();
            }
        };

        document.addEventListener('click', event => {
            const button = event.target.closest('[data-copy-value]');
            if (button) {
                window.copyToClipboard(button);
            }
        });
    </script>
    <style>
        .copy-success {
            background-color: #00755c;
            border-color: #00755c;
            color: #fff;
        }
    </style>
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script type="text/javascript">
        $(document).ready(function(){
        $("[id$='c'][id^='copy']").attr('hidden', true);
        $("button[data-copy-value]").removeAttr('aria-label');

        const desktopTablePreviewContainer = document.getElementById("desktop-table-preview-container");
        const desktopTableFullscreenToggle = document.getElementById("desktop-table-fullscreen-toggle");
        const desktopTable = document.getElementById("desktop-table");

        if (desktopTablePreviewContainer && desktopTableFullscreenToggle && desktopTable)
        {
        const resetDesktopTableHeight = "350px";
        const fullscreenDesktopTableHeight = "calc(100vh - 120px)";
        const expandedClassName = "desktop-table-preview-expanded";
        const bodyExpandedClassName = "desktop-table-preview-open";

        desktopTableFullscreenToggle.addEventListener("click", function () {
        const isExpanded = desktopTablePreviewContainer.classList.contains(expandedClassName);

        if (!isExpanded)
        {
        desktopTablePreviewContainer.classList.add(expandedClassName);
        document.body.classList.add(bodyExpandedClassName);
        desktopTable.style.height = fullscreenDesktopTableHeight;
        desktopTableFullscreenToggle.textContent = "Exit Full Screen";
        desktopTableFullscreenToggle.setAttribute("aria-expanded", "true");
        }
        else
        {
        desktopTablePreviewContainer.classList.remove(expandedClassName);
        document.body.classList.remove(bodyExpandedClassName);
        desktopTable.style.height = resetDesktopTableHeight;
        desktopTableFullscreenToggle.textContent = "Full Screen";
        desktopTableFullscreenToggle.setAttribute("aria-expanded", "false");
        }
        });

        document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && desktopTablePreviewContainer.classList.contains(expandedClassName))
        {
        desktopTablePreviewContainer.classList.remove(expandedClassName);
        document.body.classList.remove(bodyExpandedClassName);
        desktopTable.style.height = resetDesktopTableHeight;
        desktopTableFullscreenToggle.textContent = "Full Screen";
        desktopTableFullscreenToggle.setAttribute("aria-expanded", "false");
        desktopTableFullscreenToggle.focus();
        }
        });
        }
        });

    </script>
