	<div class="row nest first last wide">
	
	<div class="inner col col24 first last id79adc1e2-a32f-4172-849a-7dc3c2392cc9" style="" data-widgetcontainerid="79adc1e2-a32f-4172-849a-7dc3c2392cc9">	
 
	<div data-widget-id='c5561e9b-5885-45f8-bc44-4ad2629af797' data-moduleName="customHtml" id='widgetCustomHtmlc5561e9b-5885-45f8-bc44-4ad2629af797' class="widget widgetCustomHtml skin64 narrow" >
	<div class="widgetBody pageStyles" id="widgetBodyc5561e9b-5885-45f8-bc44-4ad2629af797">
		<div id="customHtmlc5561e9b-5885-45f8-bc44-4ad2629af797"><div><style>
/* defines the grid */
.elections-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1em;
}
.elections-card {
  /*   max-width: 500px; */
  border-radius: 8px;
  background-color: #f2f2f2;
position: relative;
}
.vol-card-image {
  height: 115px;
  border-radius: 8px 8px 0px 0px;
  background-size: cover;
}

.card-title {
  font-size: 1.3rem;
  margin: 15px 0 15px 0;
  text-decoration: none !important;
  color: #394d76 !important;
  font-weight: 800;
}

.vol-card-cont {
  padding: 1em;
  border-radius: 0 0 10px 10px;
}


.vol-link-list {
  margin: 1em 0 1em 0;
}
.el-links {
  padding: 0 !important;
  margin: 0 !important;
  list-style: none !important;
}
.el-links li {
  margin-top: 0.8rem;
}
.el-links li a {
  color: black !important;
}

/* begin horitontal card */

.h-grid {
/*  Remoove padding and margin for paste  */
/*   margin: 1em;
  padding: 1em; */
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1em;
  grid-auto-rows: minmax(auto,270px)
}
.horizontal-card {
  background-color: #f2f2f2;
  position: relative;
}
.h-flex {
  display: flex;
  height: 100%;
}
.h-grid a {
  text-decoration: none !important;
}
.h-title {
  font-size: 1.6rem;
  text-decoration: none !important;
  color: #394d76 !important;
  font-weight: 800;
  margin-bottom: .5rem;
}
.h-img {
  background-size: cover;
  flex: 35%;
}

.h-body {
  margin: 1em 1em 2.5em 1em;
  flex: 65%;
  
}
.h-description {
  color: black !important;
}
.h-link {
  position: absolute;
  right: 5%;
  bottom: 20px;
  margin-bottom: 1em;
  height: 1rem;
}
.no-list {
  position: absolute;
  right: 1rem;
  bottom: 1rem;
  font-size: 2rem
}

/* begin media queries */
@media (min-width: 1600px) {
  .elections-grid {
    gap: 2em;
  }

  .h-grid {
    grid-auto-rows: minmax(auto,275px);
  }
  .h-body {
  padding: 2em;
}
  .h-title {
  font-size: 2rem;
}
}
@media (max-width: 1000px) {
  .elections-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 1em;
  }
}
@media (max-width: 775px) {
  .elections-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1em;
  }
  .h-grid {
    grid-template-columns: repeat(1, 1fr);
  }
}
@media (max-width: 550px) {
  .elections-grid {
    grid-template-columns: repeat(1, 1fr);
    gap: 1em;
  }
}
</style></div></div>
	</div>

	</div>

