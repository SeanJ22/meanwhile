	<section class="widget widgetNewsFlash skin129 widgetOptionSet54 wide" data-modulewidgettype="newsFlash" id="widgetNewsFlasha42c4876-b172-471d-857b-b9514dc6afc8" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}' data-elementquerymatch='matchMultiColumn' data-elementqueryunmatch='unmatchMultiColumn' aria-labelledby="newsFlashHeadera42c4876-b172-471d-857b-b9514dc6afc8">
				<header class="widgetHeader" id="newsFlashHeadera42c4876-b172-471d-857b-b9514dc6afc8">
			<div class="">
