			var months = [ "Jan.", "Feb.", "Mar.", "Apr.", "May", "Jun.", "Jul.", "Aug.", "Sep.", "Oct.", "Nov.", "Dec." ];
			function dateFromString(s) {
			  var bits = s.replace('Z', '').split(/[-T:]/g);
			  var d = new Date(bits[0], bits[1]-1, bits[2]);
			  var localOffset = 0; // offset is set to 0 CRB 102024
			  d.setHours(bits[3]-localOffset, bits[4], bits[5]);
			  var hours = d.getHours(); 
			  var suffix = (hours>11) ? " p.m" : " a.m."; 
			  hours = (hours>12) ? hours - 12 : hours;
			  var minutes = d.getMinutes(); 
			  if(minutes <10) minutes = "0" + minutes;
			  var formattedDate = months[d.getMonth()] + " " + d.getDate() + ", " + d.getFullYear() + " " + hours + ":" + minutes + suffix;
			  return formattedDate;
			}
			document.getElementById("reportTimeResultsLocal").innerText=dateFromString(document.getElementById("reportTimeResults").value);
			
      </script><p style="text-align:center"><strong><a href="#Federal">Federal</a></strong> | <strong><a href="#State">State</a></strong> | <strong><a href="#County">County</a></strong> | <strong><a href="#Referendum">Referendum</a></strong><!--placeholder--></p>
