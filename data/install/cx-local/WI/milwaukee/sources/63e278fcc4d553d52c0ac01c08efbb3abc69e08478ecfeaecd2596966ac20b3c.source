<script> 
function moveBannerToOuterWrap() { 
    if ($(".fixedBannerTS").length) { 
		if ($("#bannerDivbanner2").length) { 
			$("#bannerDivbanner2").appendTo("#outer-wrap"); 
		} else { 
			setTimeout(function() { 
				moveBannerToOuterWrap(); 
			}, 500); 
		} 
	}
} 
moveBannerToOuterWrap(); 
</script> 
