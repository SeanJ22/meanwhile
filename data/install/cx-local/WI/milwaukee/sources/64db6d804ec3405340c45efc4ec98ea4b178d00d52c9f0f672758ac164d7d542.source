	<script type='text/javascript'>
		var appFilterField = $("#appFilterField");
		var response = jsonRpcSync("Services","getGlobalColumnFilters",{});
		if(response.success){
			appFilterField.val(response.value);
		}
		appFilterField.keyup(function(e){if(e.keyCode == 13){applyAppfilter();}});
		function applyAppfilter(){
			var result = jsonRpcSync("Services","setGlobalColumnFilter",{column:'APP_NAME',value:appFilterField.val()});
			var selectors = $(".row-selector.inited");
			for(var i = 0; i < selectors.length; i++){
				$(selectors[i]).data("attacher").search();
			}
		}
	</script>
