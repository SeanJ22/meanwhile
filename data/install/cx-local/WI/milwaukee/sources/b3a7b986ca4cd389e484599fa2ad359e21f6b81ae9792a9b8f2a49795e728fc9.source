<main id="contentArea" class="layoutContainer">
    <div id="heroZone">
        
        <div class="TitanStripe StripeSlider"><div class="noSiteBounds"><div class="Freeform FeatureText New100 HeroZone TitanBlock"><h1>Milwaukee County</h1>

<h1>Election Results</h1>
</div><div class="Freeform NoBottomMargin FeatureImage New100 HeroZone TitanBlock"><p><img loading="lazy"  alt="" src="/files/county/county-clerk/Pictures/Election21.png"  /></p>
</div></div></div>
		<div id="pageTools">
			<div class="siteBounds">
				<nav class="breadcrumb" aria-label="breadcrumb">
					<!--BeginNoIndex--><ul navName="Breadcrumb" navZone="Breadcrumb"><li><a href="/EN/County-Clerk">County Clerk</a><span>&gt;</span></li><li><a href="/EN/County-Clerk/Election-Commission">Election Commission</a><span>&gt;</span></li><li class="current">Election Results</li></ul><!--EndNoIndex-->
				</nav>
				<nav class="tools" aria-label="tools">
					<!--BeginNoIndex--><ul navName="PageTools" navZone=""><li class="email"><a href="#" onclick="NWS.Util.Print.Email('Website Link');return false;">Email</a></li><li class="print"><a class="print" href="#" onclick="javascript:window.print();">Print</a></li></ul><!--EndNoIndex-->
