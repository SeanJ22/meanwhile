<script id="gform_gravityforms_theme-js" defer='defer' src="https://wauwatosa.gov/wp-content/plugins/gravityforms/assets/js/dist/scripts-theme.min.js?ver=97219a00e44efe96fe680a9fde3911cf"></script>
	<script id="wauwatosa-gf-dept-preselect">
		(function($) {
			function preselectDepartment() {
				var params = new URLSearchParams(window.location.search);
				var dept = params.get('department') || params.get('dept');
				if (!dept) return;

				var $select = $('.gfield select').filter(function() {
					var $f = $(this).closest('.gfield');
					var label = ($f.find('.gfield_label').text() || '').toLowerCase();
					return label.indexOf('department') !== -1 || $f.hasClass('select-department');
				});

				if (!$select.length) return;

				var toSlug = function(s) {
					return (s || '').toString().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
				};

				var candSlug = toSlug(dept);
				var candNorm = candSlug.replace(/-department|-dept/g, '');

				// Match option by exact value, label, slug, or normalized department name
				var match = $select.find('option').filter(function() {
					if (!this.value && this.index === 0) return false;
					var valSlug  = toSlug(this.value);
					var textSlug = toSlug($(this).text());
					var valNorm  = valSlug.replace(/-department|-dept/g, '');
					var textNorm = textSlug.replace(/-department|-dept/g, '');

					return candSlug === valSlug || candSlug === textSlug 
						|| (candNorm && (candNorm === valNorm || candNorm === textNorm));
				}).val();

				// Only preselect if the department exists in the dropdown and not already set
				if (match && $select.val() !== match) {
					$select.val(match).trigger('change');
				}
			}

			$(document).ready(preselectDepartment);
			$(document).on('gform_post_render', preselectDepartment);
		})(jQuery);
	</script>
		<script id="wauwatosa-gf-text-only-js">
		(function() {
			'use strict';

			/**
			 * Cleans input value to only allow US name format characters:
			 * A-Z, a-z, spaces, hyphens (-), and apostrophes (').
			 */
			function cleanTextOnlyValue(val) {
				if (typeof val !== 'string') return '';
				var normalized = val.replace(/[’‘`]/g, "'").replace(/[–—]/g, '-');
				return normalized.replace(/[^a-zA-Z\s'\-]/g, '');
			}

			/**
			 * Sanitizes text-only inputs while preserving caret position.
			 */
			function sanitizeTextOnlyInput(input) {
				if (!input || typeof input.value !== 'string') return;
				var oldValue = input.value;
				var newValue = cleanTextOnlyValue(oldValue);

				if (oldValue !== newValue) {
					var start = input.selectionStart;
					var removedBefore = 0;
					if (typeof start === 'number') {
						var beforeSub = oldValue.slice(0, start);
						var beforeCleaned = cleanTextOnlyValue(beforeSub);
						removedBefore = beforeSub.length - beforeCleaned.length;
					}
					input.value = newValue;
					if (typeof start === 'number') {
						var newPos = Math.max(0, start - removedBefore);
						try {
							input.setSelectionRange(newPos, newPos);
						} catch (e) {}
					}
				}
			}

			/**
			 * Checks if target input belongs to a Single Line Text field with "text-only" class.
			 */
			function isTextOnlyInput(input) {
				if (!input || !input.closest || input.nodeName !== 'INPUT') return false;
				if (input.type && input.type !== 'text') return false;
				return !!input.closest('.gfield.text-only');
			}

			/**
			 * Scans container and sanitizes all text-only inputs found.
			 */
			function sanitizeAllTextOnlyInputs(container) {
				var root = container || document;
				var inputs = root.querySelectorAll('.gfield.text-only input');
				for (var i = 0; i < inputs.length; i++) {
					if (isTextOnlyInput(inputs[i])) {
						sanitizeTextOnlyInput(inputs[i]);
					}
				}
			}

			// Real-time input handling (typing, autofill, IME composition).
			document.addEventListener('input', function(e) {
				if (isTextOnlyInput(e.target)) {
					sanitizeTextOnlyInput(e.target);
				}
			}, true);

			// Handle paste and drag-and-drop actions.
			['paste', 'drop'].forEach(function(eventType) {
				document.addEventListener(eventType, function(e) {
					if (isTextOnlyInput(e.target)) {
						setTimeout(function() {
							sanitizeTextOnlyInput(e.target);
						}, 0);
					}
				}, true);
			});

			// Intercept form submission to sanitize text-only values before submit.
			document.addEventListener('submit', function(e) {
				if (e.target && e.target.querySelectorAll) {
					sanitizeAllTextOnlyInputs(e.target);
				}
			}, true);

			// Initial setup on document ready.
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', function() {
					sanitizeAllTextOnlyInputs(document);
				});
			} else {
				sanitizeAllTextOnlyInputs(document);
			}

			// Gravity Forms AJAX post-render hook for dynamic form re-renders and multi-page forms.
			if (window.jQuery) {
				window.jQuery(document).on('gform_post_render', function(event, form_id) {
					var container = document.getElementById('gform_wrapper_' + form_id) || document.getElementById('gform_' + form_id);
					sanitizeAllTextOnlyInputs(container || document);
				});
			}
		})();
	</script>
	<script id="wauwatosa-gf-intl-phone-js">
		(function() {
			var INTL_PHONE_MAX_DIGITS = 12;

			/**
			 * Checks if a phone input belongs to an International-format phone field.
			 * GF renders the field wrapper with data-type="international" or without
			 * an input mask when the format is International. We detect it by checking
			 * the parent .gfield container for ginput_container_phone and the absence
			 * of jQuery mask binding (which only exists for "standard" format).
			 */
			function isInternationalPhoneInput(input) {
				if (!input || !input.closest) return false;
				var container = input.closest('.ginput_container_phone');
				if (!container) return false;
				// Standard format fields have a mask applied via jQuery; international ones do not.
				// We check for the gfield wrapper to ensure it's a phone field.
				var gfield = input.closest('.gfield');
				if (!gfield) return false;
				// If the field has a mask class or data attribute from GF standard format, skip it.
				if (input.className && input.className.indexOf('mask') !== -1) return false;
				// Check if jQuery mask plugin is bound (standard format uses it).
				if (window.jQuery && window.jQuery(input).data && window.jQuery(input).data('events') && window.jQuery(input).data('events').keypress) return false;
				return true;
			}

			/**
			 * Strips non-digit characters from the input and enforces max digit length.
			 * Preserves cursor position after sanitization.
			 */
			function sanitizeIntlPhoneInput(input) {
				if (!input || typeof input.value !== 'string') return;
				var oldValue = input.value;
				// Remove all non-digit characters.
				var newValue = oldValue.replace(/[^0-9]/g, '');
				// Enforce maximum digit limit.
				if (newValue.length > INTL_PHONE_MAX_DIGITS) {
					newValue = newValue.slice(0, INTL_PHONE_MAX_DIGITS);
				}
				if (oldValue !== newValue) {
					var start = input.selectionStart;
					var removedBefore = 0;
					if (start !== null) {
						var beforeCursor = oldValue.slice(0, start);
						removedBefore = beforeCursor.length - beforeCursor.replace(/[^0-9]/g, '').length;
					}
					input.value = newValue;
					if (start !== null) {
						var newPos = Math.max(0, start - removedBefore);
						// Also clamp to the new value length (handles max-length truncation).
						newPos = Math.min(newPos, newValue.length);
						input.setSelectionRange(newPos, newPos);
					}
				}
			}

			// 1. Real-time typing, autofill, and IME composition.
			document.addEventListener('input', function(e) {
				if (e.target && isInternationalPhoneInput(e.target)) {
					sanitizeIntlPhoneInput(e.target);
				}
			}, true);

			// 2. Handle paste and drag-and-drop.
			['paste', 'drop'].forEach(function(eventType) {
				document.addEventListener(eventType, function(e) {
					if (e.target && isInternationalPhoneInput(e.target)) {
						setTimeout(function() {
							sanitizeIntlPhoneInput(e.target);
						}, 0);
					}
				}, true);
			});

			// 3. Block keypress for non-digit keys (extra safety layer beyond the input event).
			document.addEventListener('keypress', function(e) {
				if (e.target && isInternationalPhoneInput(e.target)) {
					// Allow control keys (backspace, tab, enter, arrows).
					if (e.ctrlKey || e.metaKey || e.altKey) return;
					var char = String.fromCharCode(e.which || e.keyCode);
					if (!/^[0-9]$/.test(char)) {
						e.preventDefault();
						return;
					}
					// Block if already at max digits.
					var currentDigits = (e.target.value || '').replace(/[^0-9]/g, '').length;
					if (currentDigits >= INTL_PHONE_MAX_DIGITS) {
						// Allow if there's a selection (user is replacing text).
						if (e.target.selectionStart === e.target.selectionEnd) {
							e.preventDefault();
						}
					}
				}
			}, true);

			// 4. Gravity Forms AJAX post-render hook for re-renders, multi-page, and conditional logic.
			if (window.jQuery) {
				window.jQuery(document).on('gform_post_render', function(event, form_id) {
					var container = document.getElementById('gform_wrapper_' + form_id) || document.getElementById('gform_' + form_id);
					if (container) {
						var phoneInputs = container.querySelectorAll('.ginput_container_phone input[type="tel"]');
						phoneInputs.forEach(function(input) {
							if (isInternationalPhoneInput(input)) {
								sanitizeIntlPhoneInput(input);
							}
						});
					}
				});
			}
		})();
	</script>
	<script id="wauwatosa-gf-numbers-only-js">
		(function() {
			'use strict';

			/**
			 * Sanitizes numbers-only inputs by stripping all non-digit characters.
			 * Mathematically calculates removed characters prior to cursor to preserve caret position.
			 */
			function sanitizeNumbersOnlyInput(input) {
				if (!input || typeof input.value !== 'string') return;
				var oldValue = input.value;
				if (!/\D/.test(oldValue)) return;

				var newValue = oldValue.replace(/[^0-9]/g, '');
				var start = input.selectionStart;
				var removedBefore = 0;

				if (typeof start === 'number') {
					var beforeSub = oldValue.slice(0, start);
					removedBefore = (beforeSub.match(/[^0-9]/g) || []).length;
				}

				input.value = newValue;

				if (typeof start === 'number') {
					var newPos = Math.max(0, start - removedBefore);
					try {
						input.setSelectionRange(newPos, newPos);
					} catch (e) {}
				}
			}

			// Delegated real-time input handling (typing, autofill, IME composition).
			document.addEventListener('input', function(e) {
				if (e.target && e.target.closest && e.target.closest('.gfield.numbers-only')) {
					if (e.target.type === 'text' || !e.target.type) {
						sanitizeNumbersOnlyInput(e.target);
					}
				}
			}, true);

			// Delegated paste and drag-and-drop actions.
			['paste', 'drop'].forEach(function(eventType) {
				document.addEventListener(eventType, function(e) {
					if (e.target && e.target.closest && e.target.closest('.gfield.numbers-only')) {
						if (e.target.type === 'text' || !e.target.type) {
							setTimeout(function() {
								sanitizeNumbersOnlyInput(e.target);
							}, 0);
						}
					}
				}, true);
			});

			// Gravity Forms AJAX post-render hook for dynamic form re-renders and multi-page forms.
			if (window.jQuery) {
				window.jQuery(document).on('gform_post_render', function(event, form_id) {
					var container = document.getElementById('gform_wrapper_' + form_id) || document.getElementById('gform_' + form_id);
					if (container) {
						var inputs = container.querySelectorAll('.gfield.numbers-only input');
						for (var i = 0; i < inputs.length; i++) {
							if (inputs[i].type === 'text' || !inputs[i].type) {
								sanitizeNumbersOnlyInput(inputs[i]);
							}
						}
					}
				});
			}
		})();
	</script>
	<script id="wauwatosa-gf-address-zip-js">
		(function() {
			'use strict';

			/**
			 * Sanitizes address ZIP inputs:
			 * - Strips all non-digit characters (0-9).
			 * - Enforces maximum length of 10 digits.
			 * - Does not require any minimum length (1 to 10 digits allowed).
			 * - Mathematically preserves caret position relative to characters prior to cursor.
			 */
			function sanitizeAddressZipInput(input) {
				if (!input || typeof input.value !== 'string') return;
				var oldValue = input.value;
				var newValue = oldValue.replace(/[^0-9]/g, '');
				if (newValue.length > 10) {
					newValue = newValue.slice(0, 10);
				}

				if (oldValue !== newValue) {
					var start = input.selectionStart;
					var removedBefore = 0;

					if (typeof start === 'number') {
						var beforeSub = oldValue.slice(0, start);
						removedBefore = beforeSub.length - beforeSub.replace(/[^0-9]/g, '').length;
					}

					input.value = newValue;

					if (typeof start === 'number') {
						var newPos = Math.max(0, start - removedBefore);
						newPos = Math.min(newPos, newValue.length);
						try {
							input.setSelectionRange(newPos, newPos);
						} catch (e) {}
					}
				}
			}

			/**
			 * Ensures consistent HTML attributes on target ZIP input:
			 * - maxlength="10"
			 * - Removes any minlength attribute
			 * - pattern="[0-9]{1,10}"
			 * - inputmode="numeric"
			 */
			function configureAddressZipInput(input) {
				if (!input || input.nodeName !== 'INPUT') return;
				if (input.getAttribute('maxlength') !== '10') {
					input.setAttribute('maxlength', '10');
				}
				if (input.hasAttribute('minlength')) {
					input.removeAttribute('minlength');
				}
				if (input.getAttribute('pattern') !== '[0-9]{1,10}') {
					input.setAttribute('pattern', '[0-9]{1,10}');
				}
				if (input.getAttribute('inputmode') !== 'numeric') {
					input.setAttribute('inputmode', 'numeric');
				}
			}

			/**
			 * Checks if target input is a Postal/ZIP code input of an Address field.
			 */
			function isAddressZipInput(input) {
				if (!input || !input.closest || input.nodeName !== 'INPUT') return false;
				var zipContainer = input.closest('.address_zip, .ginput_address_zip');
				if (zipContainer) return true;
				if (input.name && /\.5$/.test(input.name) && input.closest('.ginput_container_address, .gfield')) {
					return true;
				}
				return false;
			}

			/**
			 * Scans a container and configures all Address ZIP inputs found.
			 */
			function setupAddressZipInputs(container) {
				var root = container || document;
				var inputs = root.querySelectorAll('.address_zip input, .ginput_address_zip input, input[name$=".5"]');
				for (var i = 0; i < inputs.length; i++) {
					if (isAddressZipInput(inputs[i])) {
						configureAddressZipInput(inputs[i]);
						sanitizeAddressZipInput(inputs[i]);
					}
				}
			}

			// Delegated real-time input handling (typing, autofill, IME composition).
			document.addEventListener('input', function(e) {
				if (isAddressZipInput(e.target)) {
					configureAddressZipInput(e.target);
					sanitizeAddressZipInput(e.target);
				}
			}, true);

			// Delegated interaction hook (ensures attributes are applied on focus or click).
			document.addEventListener('focusin', function(e) {
				if (isAddressZipInput(e.target)) {
					configureAddressZipInput(e.target);
				}
			}, true);

			// Delegated paste and drag-and-drop actions.
			['paste', 'drop'].forEach(function(eventType) {
				document.addEventListener(eventType, function(e) {
					if (isAddressZipInput(e.target)) {
						setTimeout(function() {
							configureAddressZipInput(e.target);
							sanitizeAddressZipInput(e.target);
						}, 0);
					}
				}, true);
			});

			// Intercept form submission to sanitize ZIP values before submit.
			document.addEventListener('submit', function(e) {
				if (e.target && e.target.querySelectorAll) {
					setupAddressZipInputs(e.target);
				}
			}, true);

			// Initial setup on document ready.
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', function() {
					setupAddressZipInputs(document);
				});
			} else {
				setupAddressZipInputs(document);
			}

			// Gravity Forms AJAX post-render hook for dynamic form re-renders and multi-page forms.
			if (window.jQuery) {
				window.jQuery(document).on('gform_post_render', function(event, form_id) {
					var container = document.getElementById('gform_wrapper_' + form_id) || document.getElementById('gform_' + form_id);
					setupAddressZipInputs(container || document);
				});
			}
		})();
	</script>
	<script id="wauwatosa-gf-datetime-restrictions-js">
		(function($) {
			'use strict';

			function getYesterday() {
				var yesterday = new Date();
				yesterday.setDate(yesterday.getDate() - 1);
				yesterday.setHours(23, 59, 59, 999);
				return yesterday;
			}

			// Minimum age 18: the latest selectable date is (today - 18 years),
			// taken at end of day so the whole cutoff day stays selectable.
			function getMinAge18MaxDate() {
				var max = new Date();
				max.setFullYear(max.getFullYear() - 18);
				max.setHours(23, 59, 59, 999);
				return max;
			}

			function applyDateTimeRestrictions(scope) {
				var $scope = scope ? $(scope) : $(document);
				var yesterday = getYesterday();
				var minAge18Max = getMinAge18MaxDate();

				// 1. Future Dates (today onward)
				$scope.find('.gfield.future-dates').each(function() {
					var $field = $(this);
					// Awaiswp Date-Time add-on picker
					var $dtInput = $field.find('.awp_datetimepicker');
					if ($dtInput.length && typeof $dtInput.datetimepicker === 'function') {
						$dtInput.datetimepicker({
							minDate: 0,
							maxDate: false
						});
					}
					// Standard GF Datepicker input
					var $dateInput = $field.find('input.datepicker');
					if ($dateInput.length && typeof $dateInput.datepicker === 'function') {
						$dateInput.datepicker('option', 'minDate', 0);
						$dateInput.datepicker('option', 'maxDate', null);
					}
				});

				// 2. Past Dates (before today)
				$scope.find('.gfield.past-dates').each(function() {
					var $field = $(this);
					// Awaiswp Date-Time add-on picker
					var $dtInput = $field.find('.awp_datetimepicker');
					if ($dtInput.length && typeof $dtInput.datetimepicker === 'function') {
						$dtInput.datetimepicker({
							minDate: false,
							maxDate: yesterday
						});
					}
					// Standard GF Datepicker input
					var $dateInput = $field.find('input.datepicker');
					if ($dateInput.length && typeof $dateInput.datepicker === 'function') {
						$dateInput.datepicker('option', 'maxDate', '-1d');
						$dateInput.datepicker('option', 'minDate', null);
					}
				});

				// 3. Minimum age 18 (date must be at least 18 years ago)
				$scope.find('.gfield.last-18-years').each(function() {
					var $field = $(this);
					// Awaiswp Date-Time add-on picker
					var $dtInput = $field.find('.awp_datetimepicker');
					if ($dtInput.length && typeof $dtInput.datetimepicker === 'function') {
						$dtInput.datetimepicker({
							minDate: false,
							maxDate: minAge18Max
						});
					}
					// Standard GF Datepicker input
					var $dateInput = $field.find('input.datepicker');
					if ($dateInput.length && typeof $dateInput.datepicker === 'function') {
						$dateInput.datepicker('option', 'minDate', null);
						$dateInput.datepicker('option', 'maxDate', '-18y');
					}
				});
			}

			// Apply on document ready
			$(document).ready(function() {
				applyDateTimeRestrictions();
			});

			// Gravity Forms AJAX post-render hook for dynamic form re-renders and multi-page forms
			$(document).on('gform_post_render', function(event, formId, currentPage) {
				var container = document.getElementById('gform_wrapper_' + formId) || document.getElementById('gform_' + formId);
				applyDateTimeRestrictions(container || document);
			});

			// Delegated interaction hook to guarantee options are locked before the calendar popup renders
			$(document).on('focusin mousedown', '.gfield.future-dates .awp_datetimepicker, .gfield.past-dates .awp_datetimepicker, .gfield.last-18-years .awp_datetimepicker', function() {
				var $input = $(this);
				var $field = $input.closest('.gfield');
				if ($field.hasClass('future-dates') && typeof $input.datetimepicker === 'function') {
					$input.datetimepicker({ minDate: 0, maxDate: false });
				} else if ($field.hasClass('past-dates') && typeof $input.datetimepicker === 'function') {
					$input.datetimepicker({ minDate: false, maxDate: getYesterday() });
				} else if ($field.hasClass('last-18-years') && typeof $input.datetimepicker === 'function') {
					$input.datetimepicker({ minDate: false, maxDate: getMinAge18MaxDate() });
				}
			});
		})(jQuery);
	</script>
<script>
