				<div class="tosa-mobile-panel tosa-mobile-panel--sub" data-panel="sub">
					<button class="tosa-mobile-back" type="button">
						<svg xmlns="http://www.w3.org/2000/svg" width="21" height="16" viewBox="0 0 21 16" fill="none" aria-hidden="true" focusable="false">
							<path d="M0.548655 9.03829C4.33951 9.03829 7.42651 11.9299 7.42651 15.4809L7.42651 16L9.64338 16L9.64338 15.4809C9.64338 12.9838 8.4629 10.6372 6.4788 9.03309L20.7998 9.0331L20.7998 6.95652L6.49542 6.95652C8.47398 5.35237 9.64893 3.00584 9.64893 0.519145L9.64893 8.11351e-07L7.43205 6.25047e-07L7.43205 0.519145C7.43205 4.07009 4.34506 6.96171 0.554198 6.96171L-2.01589e-05 6.96171L-2.03477e-05 9.03829L0.554198 9.03829L0.548655 9.03829Z" fill="#5DBACA" />
