                                                                    <th>Next Election</th>
                                                            </tr>
                        </thead>
                    
                                            <tbody>
                                                            <tr>
                                                                            <td data-label="Office">
                                            <span class="table-cell-content">
                                                Mayor                                            </span>
                                        </td>
                                                                            <td data-label="Term Length">
                                            <span class="table-cell-content">
                                                4 years                                            </span>
                                        </td>
                                                                            <td data-label="Next Election">
                                            <span class="table-cell-content">
                                                Spring 2028                                            </span>
                                        </td>
                                                                    </tr>
                                                            <tr>
                                                                            <td data-label="Office">
                                            <span class="table-cell-content">
                                                Alderperson                                            </span>
                                        </td>
                                                                            <td data-label="Term Length">
                                            <span class="table-cell-content">
                                                4 years (6 Alderpersons, Odd-Districts)                                            </span>
                                        </td>
                                                                            <td data-label="Next Election">
                                            <span class="table-cell-content">
                                                Spring 2028                                            </span>
                                        </td>
                                                                    </tr>
                                                            <tr>
                                                                            <td data-label="Office">
                                            <span class="table-cell-content">
                                                                                            </span>
                                        </td>
