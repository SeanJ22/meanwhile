				</div>

			</div>

		</div>

		<script id="tosa-header-height-inline">
			(function() {
				var resizeTimer;

				function updateHeaderHeight() {
					var hdr = document.querySelector('.site-header');
					if (hdr) {
						var h = hdr.offsetHeight;
						document.documentElement.style.setProperty('--header-height', h + 'px');
						document.documentElement.style.setProperty('--header-offset', h + 'px');
					}
					if (typeof window.tosaUpdateHeaderOffset === 'function') {
						window.tosaUpdateHeaderOffset();
					}
				}

				function animateHeaderOffset(duration) {
					var start = performance.now();

					function step(now) {
						var elapsed = now - start;
						updateHeaderHeight();
						if (elapsed < duration) {
							requestAnimationFrame(step);
						}
					}
					requestAnimationFrame(step);
				}

				function dismissAnnouncementBar(bar, isUserClick) {
					if (!bar || !bar.isConnected) return;
					if (bar.classList.contains('is-dismissing')) return;
					bar.classList.add('is-dismissing');

					bar.style.transition = 'opacity 0.25s ease, max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1), padding 0.3s ease, margin 0.3s ease';
					bar.style.maxHeight = bar.offsetHeight + 'px';
					bar.offsetHeight; // trigger reflow
					bar.style.opacity = '0';
					bar.style.maxHeight = '0';
					bar.style.paddingTop = '0';
					bar.style.paddingBottom = '0';
					bar.style.marginTop = '0';
					bar.style.marginBottom = '0';
					bar.style.overflow = 'hidden';

					animateHeaderOffset(320);

					setTimeout(function() {
						bar.remove();
						updateHeaderHeight();
					}, 300);

					if (isUserClick) {
						try {
							var hash = bar.dataset.hash || '';
							if (hash) {
								sessionStorage.setItem('tosa_announcement_dismissed_hash', hash);
							}
							sessionStorage.setItem('tosa_announcement_dismissed', '1');
						} catch (err) {}
					}
				}

				function showAnnouncementBar(html) {
					if (!html) return;
					var existingBar = document.getElementById('tosa-announcement-bar');
					if (existingBar) return;

					var hdr = document.querySelector('.site-header');
					if (!hdr || !hdr.parentNode) return;

					var temp = document.createElement('div');
					temp.innerHTML = html.trim();
					var newBar = temp.firstElementChild;
					if (!newBar) return;

					newBar.style.opacity = '0';
					newBar.style.maxHeight = '0px';
					newBar.style.overflow = 'hidden';
					newBar.style.transition = 'opacity 0.3s ease, max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), padding 0.3s ease, margin 0.3s ease';

					hdr.parentNode.insertBefore(newBar, hdr);
					initAnnouncementBar(newBar);

					newBar.offsetHeight; // trigger reflow
					var targetH = newBar.scrollHeight || 48;
					newBar.style.maxHeight = targetH + 'px';
					newBar.style.opacity = '1';

					animateHeaderOffset(350);

					setTimeout(function() {
						if (newBar.isConnected) {
							newBar.style.maxHeight = '';
							newBar.style.overflow = '';
							updateHeaderHeight();
						}
					}, 360);
				}

				function updateAnnouncementBar(bar, html) {
					if (!bar || !html) return;
					var temp = document.createElement('div');
					temp.innerHTML = html.trim();
					var newBar = temp.firstElementChild;
					if (!newBar) return;

					bar.className = newBar.className;
					bar.setAttribute('role', newBar.getAttribute('role') || 'status');
					bar.dataset.hash = newBar.dataset.hash || '';
					if (newBar.dataset.expiresAt) {
						bar.dataset.expiresAt = newBar.dataset.expiresAt;
						bar.dataset.serverTime = newBar.dataset.serverTime || '';
					} else {
						delete bar.dataset.expiresAt;
						delete bar.dataset.serverTime;
					}

					var oldContainer = bar.querySelector('.tosa-announcement-container');
					var newContainer = newBar.querySelector('.tosa-announcement-container');
					if (oldContainer && newContainer) {
						oldContainer.innerHTML = newContainer.innerHTML;
						initAnnouncementBar(bar);
						updateHeaderHeight();
					}
				}

				function initAnnouncementBar(bar) {
					if (!bar) return;
					if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('tosa_announcement_dismissed') === '1') {
						bar.remove();
						updateHeaderHeight();
						return;
					}

					var closeBtn = bar.querySelector('.tosa-announcement-close');
					if (closeBtn && !closeBtn._tosaBound) {
						closeBtn._tosaBound = true;
						closeBtn.addEventListener('click', function(e) {
							e.preventDefault();
							dismissAnnouncementBar(bar, true);
						});
					}

					if (bar.dataset.expiresAt && bar.dataset.serverTime) {
						var expTs = parseInt(bar.dataset.expiresAt, 10);
						var srvTs = parseInt(bar.dataset.serverTime, 10);
						if (expTs > 0 && srvTs > 0) {
							var serverOffsetMs = Date.now() - (srvTs * 1000);
							var targetClientMs = (expTs * 1000) + serverOffsetMs;
							var msRemaining = targetClientMs - Date.now();

							if (msRemaining <= 0) {
								dismissAnnouncementBar(bar, false);
								return;
							} else if (msRemaining < 2147483647) {
								setTimeout(function() {
									dismissAnnouncementBar(bar, false);
								}, msRemaining);
							}
						}
					}

					initAnnouncementClamp(bar);
				}

				function initAnnouncementClamp(bar) {
					if (!bar) return;
					var contentEl = bar.querySelector('.tosa-announcement-content');
					var textEl = bar.querySelector('.tosa-announcement-text');
					var toggleBtn = bar.querySelector('.tosa-announcement-toggle');

					function checkClamp() {
						if (!contentEl || !textEl || !toggleBtn || !bar.isConnected) return;
						if (contentEl.classList.contains('is-animating')) return;

						var isExpanded = contentEl.classList.contains('is-expanded');

						contentEl.style.height = '';
						contentEl.classList.add('is-clamped');
						contentEl.classList.remove('is-expanded');
						bar.classList.add('is-clamped');
						bar.classList.remove('is-expanded');
						toggleBtn.style.display = 'none';

						var singleLineH = contentEl.offsetHeight;
						contentEl.dataset.singleLineHeight = singleLineH;

						var hasOverflow = textEl.scrollWidth > textEl.clientWidth + 2;
						if (hasOverflow) {
							toggleBtn.style.display = 'inline-flex';
							var label = toggleBtn.querySelector('.tosa-announcement-toggle-text');
							if (isExpanded) {
								contentEl.classList.remove('is-clamped');
								contentEl.classList.add('is-expanded');
								bar.classList.remove('is-clamped');
								bar.classList.add('is-expanded');
								toggleBtn.classList.remove('collapsed');
								toggleBtn.setAttribute('aria-expanded', 'true');
								if (label) label.textContent = 'Read Less';
							} else {
								toggleBtn.classList.add('collapsed');
								toggleBtn.setAttribute('aria-expanded', 'false');
								if (label) label.textContent = 'Read More';
							}
						} else {
							toggleBtn.style.display = 'none';
							toggleBtn.setAttribute('aria-expanded', 'false');
						}
					}

					if (toggleBtn && contentEl && textEl && !toggleBtn._tosaBound) {
						toggleBtn._tosaBound = true;
						toggleBtn.addEventListener('click', function(e) {
							e.preventDefault();
							if (contentEl.classList.contains('is-animating')) return;

							var isExpanded = contentEl.classList.contains('is-expanded');
							var label = toggleBtn.querySelector('.tosa-announcement-toggle-text');

							if (isExpanded) {
								var startH = contentEl.offsetHeight;
								var targetH = parseFloat(contentEl.dataset.singleLineHeight) || 28;

								contentEl.style.transition = 'none';
								contentEl.style.height = startH + 'px';
								contentEl.classList.add('is-animating');
								bar.classList.add('is-animating');
								contentEl.classList.remove('is-expanded');
								bar.classList.remove('is-expanded');
								contentEl.offsetHeight;

								contentEl.style.transition = '';
								contentEl.style.height = targetH + 'px';
								toggleBtn.classList.add('collapsed');
								toggleBtn.setAttribute('aria-expanded', 'false');
								if (label) label.textContent = 'Read More';

								animateHeaderOffset(370);

								setTimeout(function() {
									contentEl.classList.remove('is-animating');
									bar.classList.remove('is-animating');
									contentEl.classList.add('is-clamped');
									bar.classList.add('is-clamped');
									contentEl.style.height = '';
								}, 350);
							} else {
								var startH = contentEl.offsetHeight;
								contentEl.classList.add('is-animating');
								bar.classList.add('is-animating');
								contentEl.classList.remove('is-clamped');
								bar.classList.remove('is-clamped');

								contentEl.style.transition = 'none';
								var targetH = contentEl.scrollHeight;
								contentEl.style.height = startH + 'px';
								contentEl.offsetHeight;

								contentEl.style.transition = '';
								contentEl.style.height = targetH + 'px';
								toggleBtn.classList.remove('collapsed');
								toggleBtn.setAttribute('aria-expanded', 'true');
								if (label) label.textContent = 'Read Less';

								animateHeaderOffset(370);

								setTimeout(function() {
									contentEl.classList.remove('is-animating');
									bar.classList.remove('is-animating');
									contentEl.classList.add('is-expanded');
									bar.classList.add('is-expanded');
									contentEl.style.height = '';
								}, 350);
							}
						});

						checkClamp();
						window.addEventListener('resize', function() {
							clearTimeout(resizeTimer);
							resizeTimer = setTimeout(checkClamp, 100);
						});
						if (document.fonts && document.fonts.ready) {
							document.fonts.ready.then(checkClamp);
						}
					}
				}

				// Initial setup for server-rendered bar
				var initialBar = document.getElementById('tosa-announcement-bar');
				if (initialBar) {
					initAnnouncementBar(initialBar);
				}
				updateHeaderHeight();

				// Real-time two-way polling: handles BOTH show and hide live without refresh!
				var ajaxUrl = "https:\/\/wauwatosa.gov\/wp-admin\/admin-ajax.php";
				var pageId = 1857;
				var isChecking = false;

				function checkAnnouncementStatus() {
					if (isChecking) return;
					isChecking = true;

					var requestUrl = ajaxUrl + '?action=tosa_check_announcement_status&page_id=' + encodeURIComponent(pageId) + '&_t=' + Date.now();
					fetch(requestUrl, {
							cache: 'no-store',
							headers: {
								'Cache-Control': 'no-cache, no-store, must-revalidate',
								'Pragma': 'no-cache'
							}
						})
						.then(function(res) {
							return res.json();
						})
						.then(function(resp) {
							if (resp && resp.success && resp.data) {
								var currentBar = document.getElementById('tosa-announcement-bar');
								var isHidden = resp.data.hidden;
								var html = resp.data.html;
								var hash = resp.data.hash || '';

								if (isHidden) {
									// Admin turned OFF the announcement bar (or time expired) -> auto-hide without refresh!
									if (currentBar) {
										dismissAnnouncementBar(currentBar, false);
									}
									// If admin turned it OFF, clear dismissal records so it can show again when re-enabled
									try {
										sessionStorage.removeItem('tosa_announcement_dismissed');
										sessionStorage.removeItem('tosa_announcement_dismissed_hash');
									} catch (e) {}
								} else if (html) {
									// Admin turned ON the announcement bar -> auto-show without refresh!
									var dismissedHash = '';
									try {
										dismissedHash = sessionStorage.getItem('tosa_announcement_dismissed_hash');
									} catch (e) {}

									// Only stay hidden if user explicitly clicked 'X' for THIS exact message
									if (dismissedHash && hash && dismissedHash === hash) {
										return;
									}

									if (!currentBar) {
										showAnnouncementBar(html);
									} else if (currentBar.dataset.hash && hash && currentBar.dataset.hash !== hash) {
										updateAnnouncementBar(currentBar, html);
									}
								}
							}
						})
						.catch(function() {})
						.finally(function() {
							isChecking = false;
						});
				}

				// Check every 3.5 seconds
				setInterval(checkAnnouncementStatus, 3500);

				// Immediately check whenever user switches back to this tab or window gains focus
				document.addEventListener('visibilitychange', function() {
					if (document.visibilityState === 'visible') {
						checkAnnouncementStatus();
					}
				});
				window.addEventListener('focus', checkAnnouncementStatus);
			})();
		</script>
