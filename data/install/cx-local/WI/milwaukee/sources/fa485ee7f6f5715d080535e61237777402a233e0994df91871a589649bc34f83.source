    <script>
        /* Third-party accessibility/gallery widget a11y patches. These run only when
           the widget is present and only ADD attributes (labels / aria-hidden on
           decorative icons / landmark wrappers) -- we never hide or remove a working
           widget, so sites that use UserWay/accessiBe/Lightbox are unaffected. */
        (function () {
            var UW_SELECTOR = '[class*="userway"],[class*="uwaw"],[id*="userway"]';
            function accessibleName(el) {
                return el.getAttribute('aria-label') ||
                    el.getAttribute('aria-labelledby') ||
                    el.getAttribute('title') ||
                    (el.textContent && el.textContent.trim());
            }
            function labelUserwayTriggers() {
                var buttons = document.querySelectorAll('[role="button"]');
                for (var i = 0; i < buttons.length; i++) {
                    var el = buttons[i];
                    if (!el.closest(UW_SELECTOR)) continue;
                    if (!accessibleName(el)) el.setAttribute('aria-label', 'Accessibility menu');
                }
                /* The launcher's inner SVG icons are decorative once the button is
                   named; hide them so they don't trip svg-has-no-accessible-name. */
                var svgs = document.querySelectorAll(UW_SELECTOR + ' svg');
                for (var j = 0; j < svgs.length; j++) {
                    var svg = svgs[j];
                    if (accessibleName(svg) || svg.querySelector('title')) continue;
                    svg.setAttribute('aria-hidden', 'true');
                    svg.setAttribute('focusable', 'false');
                }
                /* UserWay marks its launcher wrapper aria-hidden="true" yet leaves the
                   launcher button tabbable (aria_hidden_nontabbable). The button is a
                   real control, so un-hide the wrapper rather than remove keyboard
                   access. Only touch wrappers that actually hold a focusable element. */
                var hiddenWraps = document.querySelectorAll(UW_SELECTOR + '[aria-hidden="true"]');
                for (var w = 0; w < hiddenWraps.length; w++) {
                    if (hiddenWraps[w].querySelector('a[href],button,input,select,textarea,[tabindex],[role="button"]')) {
                        hiddenWraps[w].removeAttribute('aria-hidden');
                    }
                }
            }
            /* accessiBe (paid ADA add-on some clients load) renders its launcher inside
               open shadow roots on <access-widget-ui> hosts, with icon SVGs that have no
               accessible name and occasionally an unnamed button. We keep the widget
               working and just name/hide those so they stop failing the scanner. */
            function patchAccessibe() {
                /* accessiBe also drops a light-DOM trigger <div role="button"> with no
                   text/label ("button role has no associated label"); name it. */
                var triggers = document.querySelectorAll('.acsb-trigger,[class*="acsb"][role="button"]');
                for (var t = 0; t < triggers.length; t++) {
                    if (!accessibleName(triggers[t])) triggers[t].setAttribute('aria-label', 'Accessibility options');
                }
                var hosts = document.querySelectorAll('access-widget-ui');
                for (var i = 0; i < hosts.length; i++) {
                    var root = hosts[i].shadowRoot;
                    if (!root) continue;
                    var svgs = root.querySelectorAll('svg');
                    for (var s = 0; s < svgs.length; s++) {
                        if (accessibleName(svgs[s]) || svgs[s].querySelector('title')) continue;
                        svgs[s].setAttribute('aria-hidden', 'true');
                        svgs[s].setAttribute('focusable', 'false');
                    }
                    var btns = root.querySelectorAll('button,[role="button"]');
                    for (var b = 0; b < btns.length; b++) {
                        if (!accessibleName(btns[b])) btns[b].setAttribute('aria-label', 'Accessibility options');
                    }
                    /* The host sits directly under <body>, so its content is "not within
                       a landmark". Make each visible, non-empty host a region landmark,
                       labelled from its button when present else an index (kept unique
                       to avoid the duplicate-landmark-label rule). */
                    var host = hosts[i];
                    if (!host.getAttribute('role') && root.childElementCount > 0 && getComputedStyle(host).display !== 'none') {
                        var namer = root.querySelector('button,[role="button"]');
                        host.setAttribute('role', 'region');
                        host.setAttribute('aria-label', ((namer && accessibleName(namer)) || ('Accessibility widget ' + (i + 1))).slice(0, 60));
                    }
                }
                /* accessiBe's screen-reader-only <a>/<span> helpers are also loose under
                   <body>; gather them under one region landmark. */
                var loose = document.querySelectorAll('body > a.acsb-sr-only, body > span.acsb-sr-alert, body > .acsb-sr-only');
                if (loose.length) {
                    var region = document.getElementById('acsb-sr-landmark');
                    if (!region) {
                        region = document.createElement('div');
                        region.id = 'acsb-sr-landmark';
                        region.setAttribute('role', 'region');
                        region.setAttribute('aria-label', 'Accessibility screen reader helpers');
                        loose[0].parentNode.insertBefore(region, loose[0]);
                    }
                    for (var l = 0; l < loose.length; l++) {
                        if (loose[l].parentNode !== region) region.appendChild(loose[l]);
                    }
                }
            }
            /* Lightbox2 (image gallery lib) injects close/cancel controls as
               <a role="button"> with no text -> "button role has no associated label". */
            function patchLightbox() {
                var map = [
                    ['.lb-close', 'Close image'],
                    ['.lb-cancel', 'Close image'],
                    ['.lb-prev', 'Previous image'],
                    ['.lb-next', 'Next image']
                ];
                for (var i = 0; i < map.length; i++) {
                    var els = document.querySelectorAll(map[i][0]);
                    for (var j = 0; j < els.length; j++) {
                        if (!accessibleName(els[j])) els[j].setAttribute('aria-label', map[i][1]);
                    }
                }
            }
            function processOverlays() {
                labelUserwayTriggers();
                patchAccessibe();
                patchLightbox();
            }
            function init() {
                processOverlays();
                var obs = new MutationObserver(processOverlays);
                obs.observe(document.body, { childList: true, subtree: true });
                /* Overlays load async and accessiBe fills an encapsulated shadow root
                   the observer can't see, so poll for ~30s as well. */
                var ticks = 0;
                var poll = setInterval(function () {
                    processOverlays();
                    if (++ticks >= 15) { clearInterval(poll); obs.disconnect(); }
                }, 2000);
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
