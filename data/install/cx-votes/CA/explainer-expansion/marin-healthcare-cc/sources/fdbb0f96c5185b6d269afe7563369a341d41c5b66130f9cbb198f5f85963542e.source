es":0},"isEditable":true,"label":"OBJECTID","visible":false},{"fieldName":"District","isEditable":true,"label":"District","visible":true},{"fieldName":"Acres","format":{"digitSeparator":true,"places":2},"isEditable":true,"label":"Acres","visible":true},{"fieldName":"SBE_ID","isEditable":true,"label":"SBE_ID","visible":false},{"fieldName":"Shape__Area","format":{"digitSeparator":false,"places":6},"isEditable":true,"label":"Shape__Area","visible":false},{"fieldName":"Shape__Length","format":{"digitSeparator":false,"places":6},"isEditable":true,"label":"Shape__Length","visible":false},{"fieldName":"expression/expr0","isEditable":true,"visible":false}],"title":"Community Service Districts"}},{"url":"https://services3.arcgis.com/dkpOfuz3lCHMxq7I/arcgis/rest/services/Sphere_of_Influence_Community_Service_District/FeatureServer/16","geometryType":"esriGeometryPolygon","id":"1883054408f-layer-27","layerId":"16","baseURL":"https://services3.arcgis.com/dkpOfuz3lCHMxq7I/arcgis/rest/services/Sphere_of_Influence_Community_Service_District/FeatureServer/","isMapServer":false,"title":"Sphere of Influence - Community Service District","visibility":false,"popupInfo":{"popupElements":[{"type":"fields","description":"","fieldInfos":[],"title":""},{"type":"text","text":"<p>{expression/expr0}&nbsp;</p>"}],"description":"<p>{expression/expr0}&nbsp;</p>","expressionInfos":[{"name":"expr0","title":"New expression","expression":"// Write a script to return a value to show in the pop-up. \r\n// For example, get the average of 4 fields:\r\n// Average($feature.SalesQ1, $feature.SalesQ2, $feature.SalesQ3, $feature.SalesQ4)\r\nProper($feature.District) + TextFormatting.NewLine + \"Date of Adoption: \" + Text($feature.AdoptDate, 'MMMM D, Y') + TextFormatting.NewLine + Text(Round($feature.Acres, 2), '###,###.##')  + \" Acres\"","returnType":"string"}],"fieldInfos":[{"fieldName":"OBJECTID","format":{"digitSeparator":false,"places":0},"isEditable":true,"label":"OBJECTID","visible":false},{"fieldName