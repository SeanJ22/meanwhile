/dkpOfuz3lCHMxq7I/arcgis/rest/services/Water_Districts/FeatureServer/24","layerName":"Water Districts","id":"18836a96825-layer-42","allowDownload":true,"downloadingFileOption":["csv"]},{"url":"https://services3.arcgis.com/dkpOfuz3lCHMxq7I/arcgis/rest/services/Sphere_of_Influence_Water_District/FeatureServer/22","layerName":"Sphere of Influence - Water District","id":"18836a94a5a-layer-41","allowDownload":true,"downloadingFileOption":["csv"]},{"url":"https://services3.arcgis.com/dkpOfuz3lCHMxq7I/arcgis/rest/services/Water_Service_Providers/FeatureServer/25","layerName":"Water Service Providers","id":"1883053de93-layer-21","allowDownload":true,"downloadingFileOption":["csv"]},{"url":"https://services6.arcgis.com/T8eS7sop5hLmgRRH/arcgis/rest/services/Elementary_School_Districts/FeatureServer/7","layerName":"Elementary School Districts","id":"1892787d5be-layer-48","allowDownload":true,"downloadingFileOption":["csv"]},{"url":"https://services6.arcgis.com/T8eS7sop5hLmgRRH/arcgis/rest/services/Shoreline_Trustee_Area/FeatureServer/0","layerName":"Shoreline Trustee Area","id":"188e0190262-layer-45","allowDownload":true,"downloadingFileOption":["csv"]},{"url":"https://services6.arcgis.com/T8eS7sop5hLmgRRH/arcgis/rest/services/School_Trustee_Area/FeatureServer/0","layerName":"School Trustee Area","id":"188e01be908-layer-46","allowDownload":true,"downloadingFileOption":["csv"]},{"url":"https://services6.arcgis.com/T8eS7sop5hLmgRRH/arcgis/rest/services/MMWD_Division/FeatureServer/0","layerName":"MMWD Division","id":"188e01ced97-layer-47","allowDownload":true,"downloadingFileOption":["csv"]},{"url":"https://services6.arcgis.com/T8eS7sop5hLmgRRH/arcgis/rest/services/MMWD_Division/FeatureServer/0","layerName":"MMWD Division","id":"188e01ced97-layer-47","allowDownload":true,"downloadingFileOption":["csv"]}],"extractDataTaskURL":"","downloadingFileOptions":[]},"drawToolSelectableLayers":["1881299232f-layer-10","1883054408f-layer-27","1883054f0a2-layer-36","1883055094e-layer-38","18830544e5b-layer-28","18821bd81e8-layer-19","18830542d7c-layer-26","188305502d3-layer-37","1883054db92-layer-34","18e108f1727-layer-48","18e108f0e4a-layer-47","18830541dfd-layer-25","18830548e56-layer-31","18830540d4b-layer-24","1883054aa67-layer-32","18836a9b244-layer-44","18830545925-layer-29","18836a977db-layer-43","18836a94a5a-layer-41","18836a96825-layer-42","1883053fd17-layer-23","18830546860-layer-30","1883054e8d2-layer-35","1883054c027-layer-33","18836a9c4f4-layer-45","1883053de93-layer-21","188e0190262-layer-45","1881d76d420-layer-12","188e01be908-layer-46","1881d79de4a-layer-13","188e01ced97-layer-47"],"showPointTool":true,"showPolylineTool":true,"showExtentTool":true,"showPolygonTool":true}},{"position":{"left":14,"top":112,"relativeTo":"map"},"placeholderIndex":1,"id":"_8","name":"About","version":"2.36","closeable":true,"uri":"widgets/About/Widget","config":{"about":{"aboutContent":"<div> </div>\n\t<div align=\"center\">\n\t<div style=\"text-align: left;\"><span style=\"font-family: Tahoma; text-decoration: underline;\"><font size=\"4\">Before you start:</font></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\">The search tools are configured for \nsearching specific layers in this mapping application. These include all 23 \nlayers in the LAFCo Approved Districts layer group and the following seven layers in the Other Districts layer group: Elementary School \nDistrict, High School District, Marin Healthcare District &amp; Sphere of Influence, Shoreline Trustee Area, School Trustee \nArea, and MMWD Division.</span></div><div style=\"text-align: left;\"><br /></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma; text-decoration: underline;\"><font size=\"4\">To Use the ID Districts tool:</font></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\">Find the desired location by searching Address, APN, or place.  You can search by: the &quot;Find address or place&quot; dialog box in the top right corner; the &quot;Search By Address or APN&quot; tool in the upper left corner; the &quot;Search for a location&quot; (address or place name) dialog box within the Identify Districts tool itself; or, by finding the location manually on the map.</span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\"><br /></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\">Toggle on all layers in the LAFCo Approved Districts Layer List (click the menu button in the top right corner to turn all layers on or off) or turn on just the layers you wish to search. The tool will not identify and return layers that are turned off. Repeat this step for the searchable layers of interest in the Other Boundaries group.</span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\"><br /></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\">Open the Identify Districts tool and once you have located your area of interest, click the Draw menu and select a method for querying the map to identify Districts. For example, select the Point tool and click in the parcel polygon of interest. This will query all the activated layers that intersect the point you've placed. Click the Report button and the tool will generate a list of all the activated layers with a count of the number of features in each layer that are returned. Click the plus symbol to expand the layer and see the feature information. You can also generate a PDF report of all the layers that returned at least one feature by clicking the printer icon and clicking Print. You can download and save the PDF report.<br /></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\"><br /></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma; text-decoration: underline;\"><font size=\"4\">To Use the Search County Districts tool:</font></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\">The tool is set to search on ALL Marin LAFCo Approved Districts. You can search by All Districts or select a specific District layer via the drop down arrow to the left of the search dialog box. For best results, toggle on all layers in the LAFCO Approved Districts Layer List (click the menu button in the top right corner to turn all layers on or off) or turn on just the layers you wish to search. Repeat this step for the searchable layers of interest in the Other Boundaries group.</span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\"><br /></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\"><span style=\"text-decoration: underline;\">There are two ways you can search with this tool:</span><br />1) Search by typing text into the tool dialog box. The tool will search on names and other attribute values from the District layers and suggest results. Click on a feature that is returned from your search to highlight it on the map.<br /></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\"><br /></span></div><div style=\"text-align: left;\"><span style=\"font-family: Tahoma;\">2) Navigate to your area of interest, click the Set location button, and then click on your location on the map. The tool will query all activated layers and return any that intersect with the location specified. Click on the layers listed in the search results to see the specific Districts identified. Click the layer name again to return to the search results list.<br /></span></div></div>"}}},{"position":{"left":14,"top":212,"relativeTo":"map"},"placeholderIndex":2,"id":"_9","version":"2.28","closeable":true,"uri":""},{"uri":"widgets/OverviewMap/Widget","position":{"right":0,"bottom":0,"zIndex":1,"relativeTo":"map"},"version":"2.36","id":"widgets_OverviewMap_Widget_10","name":"OverviewMap"},{"uri":"widgets/HomeButton/Widget","position":{"left":84,"bottom":64,"relativeTo":"map"},