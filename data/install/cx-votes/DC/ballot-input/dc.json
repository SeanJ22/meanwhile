            "verifiedAt": "2026-10-14T05:02:25.795737Z",
            "collectedAt": "2026-10-14T05:02:25.795737Z"
          },
          "questionText": "Prohibiting Force-Feeding of Birds\nAct of 2026.\nIf enacted, this Initiative would:\n(a) Prohibit any person from\nforce-feeding a bird for the purpose\nof enlarging the bird’s liver beyond\nnormal size;\n(b) Ban the sale or distribution of any\nproduct resulting from force-feeding\na bird, including foie gras;\n(c) Define force-feeding as inserting a\ntube into the bird’s throat to deliver\nexcessive feed;\n(d) Provide for enforcement by the\nDepartment of Energy and\nEnvironment during routine food\nsafety inspections; and\n(e) Provide for civil penalties.",
          "officialNumber": "86",
          "officialStatement": null
        }
      ],
      "measureRecords": [
        {
          "contestId": "dc-2026-general-initiative-86",
          "whatItDoes": "Bans force-feeding birds to enlarge their livers beyond normal size and selling or distributing products made through that practice, including foie gras. Defines force-feeding as placing a tube in a bird’s throat to deliver excessive feed. Provides for civil penalties and enforcement by the Department of Energy and Environment during routine food-safety inspections.",
          "yesMeans": "Approve the ban and its enforcement provisions.",
          "noMeans": "Reject the proposed ban.",
          "parts": [],
