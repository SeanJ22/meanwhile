		<div id="customHtml87f318dc-1746-4cf7-b95b-bbb7db1fa276"><div><div class="registrationTotalsList">
  <div class="dataWrapper">
    <p class="data">Active Registered Voters: <span class="dateValue dataValue"></span></p>
  </div>
  <div class="dataWrapper">
    <p class="data">Democrats: <span class="demValue dataValue"></span></p>
  </div>
  <div class="dataWrapper">
    <p class="data">Republicans: <span class="repValue dataValue"></span></p>
  </div>

  <div class="dataWrapper">
    <p class="data">Other: <span class="othValue dataValue"></span></p>
  </div>
  <div class="dataWrapper">
    <p class="data">Total: <span class="totValue dataValue"></span></p>
  </div>
</div>

<style>
    .registrationTotalsList {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    @media (max-width: 40em) {
        .registrationTotalsList {
            flex-direction: column;
        }
    }
</style>

<script>
var TOTCounty = "lee"; 

function numberWithCommas(x) {
    return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}

var myDate = new Date();
var asOf = (myDate.getMonth() + 1) + "/" + myDate.getDate() + "/" + myDate.getFullYear().toString().substring(2, 4);

$(document).ready(function () {
    if (TOTCounty > "") {
        $(".registrationTotalsList").hide();
        jQuery.support.cors = true;

        if (!window.XDomainRequest) {
            $.ajax({
                dataType: "json",
                url: "//vrcdn.electionsfl.org/parameters/CountyParameters_" + TOTCounty + ".json",
                success: function (data) {
                    ProcessJson(data);
                },
                error: function (data, textStatus, errorThrown) {
                    ProcessError(data, textStatus, errorThrown);
                },
                timeout: 10000,
                complete: function (data) {
                    ProcessEnd(data);
                }
            });
        } else {
            var xdr = new XDomainRequest();
            xdr.onerror = function () {};
            xdr.ontimeout = function () {};
            xdr.onprogress = function () {};
            xdr.open("get", "//vrcdn.electionsfl.org/parameters/CountyParameters_" + TOTCounty + ".json");
            xdr.onload = function () {
                JsonIn(xdr.responseText);
            };
            setTimeout(function () {
                xdr.send();
            }, 0);
        }

        function ProcessEnd(data) {
            // Optional: handle end of request
        }

        function ProcessError(data, textStatus, errorThrown) {
            if (textStatus === "timeout") {
                console.log("Call has timed out");
            } else {
                console.log(textStatus);
            }
        }

        function JsonIn(sdata) {
            ProcessJson(JSON.parse(sdata));
        }

        function ProcessJson(data) {
            var npaValue = Number(data.NewNPA);
            var othValue = Number(data.NewOTH);
            var demValue = Number(data.NewDEM);
            var repValue = Number(data.NewREP);
            var totValue = npaValue + othValue + demValue + repValue;

            if ($(".npaValue").length) {
                $(".npaValue").html(numberWithCommas(npaValue));
            } else {
                othValue += npaValue;
                npaValue = 0;
            }

            $(".dateValue").html(asOf);
            $(".repValue").html(numberWithCommas(repValue));
            $(".demValue").html(numberWithCommas(demValue));
            $(".othValue").html(numberWithCommas(othValue));
            $(".totValue").html(numberWithCommas(totValue));

            var dateparts = data.frozen.RegstatDate.optionvalue.split("-");
            var asOfDate = new Date(dateparts[0], dateparts[1] - 1, dateparts[2]);
            dateparts = data.frozen.RegstatRevert.optionvalue.split("-");
            var endFreeze = new Date(dateparts[0], dateparts[1] - 1, dateparts[2]);
            var dateNow = new Date();

            if (dateNow.getTime() < endFreeze.getTime() && dateNow.getTime() > asOfDate.getTime()) {
                $(".registrationTotalsList").after(
                    "<div style=\"padding: 1px 5px; float: left; background-color: white; color: black; position: absolute; margin-left: 10px;\" class=\"bookclosingmessage\">" +
                    "NOTE: Election Books are closed. Totals are as of Book Closing</div>"
                );
                setTimeout(function () {
                    $(".bookclosingmessage").fadeOut(3000);
                    $(".registrationTotalsList").fadeIn(2000);
                }, 4000);

                var frozenDEM = Number(data.frozen.RegstatDEM.optionvalue.replace(",", ""));
                var frozenREP = Number(data.frozen.RegstatREP.optionvalue.replace(",", ""));
                var frozenNPA = Number(data.frozen.RegstatNPA.optionvalue.replace(",", ""));
                var frozenOTH = Number(data.frozen.RegstatOTH.optionvalue.replace(",", ""));

                if ($(".npaValue").length) {
                    $(".npaValue").html(numberWithCommas(frozenNPA));
                } else {
                    frozenOTH += frozenNPA;
                    frozenNPA = 0;
                }

                var asOfFreeze = ('0' + (asOfDate.getMonth() + 1)).slice(-2) + '/' + ('0' + asOfDate.getDate()).slice(-2) + '/' + asOfDate.getFullYear().toString().substr(2, 2);
                $(".dateValue").html(asOfFreeze);
                $(".repValue").html(numberWithCommas(frozenREP));
                $(".demValue").html(numberWithCommas(frozenDEM));
                $(".othValue").html(numberWithCommas(frozenOTH));

                var frozenTOT = frozenDEM + frozenNPA + frozenOTH + frozenREP;
                $(".totValue").html(numberWithCommas(frozenTOT));
            } else {
                $(".registrationTotalsList").show();
            }
        }
    }
});
</script></div></div>
	</div>

