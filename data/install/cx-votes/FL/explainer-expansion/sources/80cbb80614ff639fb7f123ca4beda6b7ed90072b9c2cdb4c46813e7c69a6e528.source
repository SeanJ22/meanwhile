</script>
</div>

				</div>
					<ol class="tabbedWidgetNarrow cpTabs  accordion"  aria-hidden="False.ToString().ToLowerInvariant()" >
						<li class="" role="presentation">	<a href="#tab0e523ec0-0ff8-4a26-ba21-4d265fea500e_3" class="tabButton" id="tabBtnNarrow0e523ec0-0ff8-4a26-ba21-4d265fea500e_3" role="button" aria-controls="tab0e523ec0-0ff8-4a26-ba21-4d265fea500e_3" aria-expanded="false" ><span class="tabName editable" data-sequence="3" data-tabname="Lee County / Fort Myers Beach Mosquito Control District Referendum" contenteditable="false">Lee County / Fort Myers Beach Mosquito Control District Referendum</span></a>
</li>
					</ol>
				<div class="tabbedWidget cpTabPanel " style="display: none;" id="tab0e523ec0-0ff8-4a26-ba21-4d265fea500e_3" role="region" aria-labelledby="tabBtn0e523ec0-0ff8-4a26-ba21-4d265fea500e_3" >

<div class="widget editor pageStyles narrow" id="divEditor6df72f34-bf6a-47c5-874e-39a4733205b9" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <p><b data-pasted="true" role="emphasis"><span style="font-size: 20px;">2026 Merger of the Lee County Mosquito Control and Fort Myers Beach Mosquito Control Districts Referendum</span></b></p><p><b data-pasted="true" role="emphasis"><span style="font-size: 20px;"><span style="color: rgb(192, 0, 0); font-family: Arial; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; caret-color: rgba(0, 0, 0, 0); white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;" data-pasted="true"><strong>Florida Legislature Special District Referendum</strong></span></span></b></p><p><span style="color: rgb(0, 0, 0); font-family: arial, sans-serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;" data-pasted="true">The Lee County Supervisor of Elections gives notice that on Tuesday, November 3, 2026, a Special Election will be conducted at which the voters of Lee County residing in the Lee County Mosquito Control and the Fort Myers Beach Mosquito Control Districts will be asked if they approve or disapprove amending the boundaries of the Lee County Mosquito Control District to include all of Lee County, abolishing the Fort Myers Beach Mosquito Control District, and transferring the assets and liabilities of the Fort Myers Beach Mosquito Control District to the Lee County Mosquito Control District.</span></p><p><span style="font-size: 18px;" data-pasted="true"><a href="/DocumentCenter/View/1092" target="_blank" rel="noopener" aria-describedby="audioeye_new_window_message" style="font-size: 18px;">Ballot Language (English / Spanish PDF)</a><br><a href="/DocumentCenter/View/1090" target="_blank" rel="noopener" aria-describedby="audioeye_new_window_message" style="font-size: 18px;">Laws of Florida 2025-235 (English PDF)</a><br></span><a href="/DocumentCenter/View/1091" target="_blank" rel="noopener" aria-describedby="audioeye_new_window_message" style="font-size: 18px;"><span style="font-size: 18px;">Laws of Florida 2025-235 (Spanish PDF)</span></a></p><p><br></p>
    </div>

