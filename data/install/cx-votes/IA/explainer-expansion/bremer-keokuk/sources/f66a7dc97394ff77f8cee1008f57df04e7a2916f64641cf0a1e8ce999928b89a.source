<div id="sectionHeader">
    <div class="sectionParent"><a href="/news/">News</a></div>    <div class="sectionPageHeader"><h1>2026 General Election</h1></div>
</div>


<div id="standardPage">
  <div class="pageIntro">Posted October 14, 2026 &middot; <a href="auditor">Auditor</a></div>      <div class="contentColumns">
      <div class="contentLeft">
                        <img src="/images/news/2026_general_election_68508.png" class="newsImage"><p class="MsoTitle" style="text-align:center"><strong style="font-weight:bold">NOTICE OF ELECTION</strong></p>

<p style="text-align:center">&nbsp;</p>

<p style="text-align:justify"><strong>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </strong>The 2026 General Election will be held on Tuesday, November 3, 2026.&nbsp; Polls will be open from 7:00 a.m. until 8:00 p.m.&nbsp; Keokuk County polling places will be as follows:</p>

<p style="text-align:justify">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <strong>Precinct&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Polling Location</strong></p>

<p style="text-align:justify">AD-PR-WS (Adams-Prairie-Washington)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Thomas Hall &ndash; What Cheer Fairgrounds</p>

<p style="text-align:justify">BN-SR (Benton-Steady Run)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Hedrick City Hall</p>

<p style="text-align:justify">ER-LB (English River-Liberty)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; South English Fire Station</p>

<p style="text-align:justify">JA-RL (Jackson-Richland)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Mother Cabrini Hall &ndash; Richland&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>

<p style="text-align:justify">LF-CC (Lafayette-Clear Creek)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Keota City Hall &ndash; North Entrance&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>

<p style="text-align:justify">EL-WL-WN (East Lancaster-West Lancaster-Warren)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Keokuk County Expo &ndash; Sigourney&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>

<p style="text-align:justify">SG-PL-VB (Sigourney-Plank-Van Buren)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Keokuk County Expo &ndash; Sigourney</p>

<p style="text-align:justify">SG1 &amp; SG2 Wards&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Keokuk County Expo &ndash; Sigourney</p>

<p style="text-align:justify">SG3 &amp; SG4 Wards&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Keokuk County Expo &ndash; Sigourney</p>

<p style="text-align:justify; text-indent:.5in">&nbsp;</p>

<p style="text-align:justify; text-indent:.5in">Pre-registered voters are required to provide an approved form of identification at the polling place before receiving and casting a regular ballot. Voters who are not pre-registered, such as voters registering to vote on election day and voters changing precincts, must also provide proof of residence. A voter who is unable to provide an approved form of identification (or prove residence if required) may cast a provisional ballot and provide proof of identity/residence at the county auditor&rsquo;s office by Monday, November 9, 2026. Election Day Registrants may use an attester from that precinct, but attesters must provide an approved form of identification. For additional information about providing proof of identity and/or residence visit: <a href="https://sos.iowa.gov/voterid">https://sos.iowa.gov/voterid</a> or phone (641) 622-2320 or email cbates@keokukcounty.iowa.gov.&nbsp; Any voter who is physically unable to enter a polling place has the right to vote in the voter&rsquo;s vehicle.</p>

<p style="text-align:justify; text-indent:.5in">Public testing of the voting equipment will be held on October 26, 2026, beginning at 9:00 a.m. in the Elections Room, adjoining the Keokuk County Auditor&rsquo;s Office, 2nd floor of the Keokuk County Courthouse, Sigourney, Iowa and continue until testing is finished.</p>

<p style="text-align:justify; text-indent:.5in">The Keokuk County Auditor&rsquo;s office will be open on Saturday, October 31, 2026, 9 a.m. to 5 p.m. for absentee voting. <strong>Sample Ballot will be posted in each precinct and are available at keokukcounty.iowa.gov.</strong></p>

<p style="text-align:justify; text-indent:.5in">&nbsp;</p>

<p style="text-align:justify"><strong>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; The following is a complete listing of candidates for all Federal, State, County and Judicial offices:</strong></p>

<p style="text-align:justify"><strong>U.S. Senator:</strong> Josh Turek (DEM), Ashley Hinson (REP), Thomas Laehn (LIB)</p>

<p style="text-align:justify"><strong>U.S. Representative District 1:</strong> Christina Bohannan (DEM), Mariannette Miller-Meeks (REP), Michael Bridgford</p>

<p style="text-align:justify"><strong>GovernorLt. Governor:</strong> Rob Sand/Dave Muhlbauer (DEM), Zach Lahn/Derek Wulf (REP)</p>

<p style="text-align:justify"><strong>Secretary of State:</strong> Ryan Peterman (DEM), Paul D. Pate (REP)</p>

<p style="text-align:justify"><strong>Auditor of State:</strong> Taylor Wettach (DEM), Chris Cournoyer (REP)</p>

<p style="text-align:justify"><strong>Treasurer of State:</strong> John Norwood (DEM), Roby Smith (REP)</p>

<p style="text-align:justify"><strong>Secretary of Agriculture:</strong><strong> </strong>Chris Jones (DEM), Mike Naig (REP)</p>

<p style="text-align:justify"><strong>Attorney General:</strong><strong> </strong>Nate Willems (DEM), Brenna Bird (REP)</p>

<p style="text-align:justify"><strong>State Representative District 88:</strong><strong> </strong>Helena Hayes (REP)</p>

<p style="text-align:justify"><strong>County Board of Supervisors:</strong><strong> </strong>(Elect Two) Bryan Coffman (REP), Daryl Wood (REP)</p>

<p style="text-align:justify"><strong>County Treasurer:</strong><strong> </strong>Christine Edmundson Long (REP)</p>

<p style="text-align:justify"><strong>County Recorder:</strong><strong> </strong>Dawn T. Goldman (REP)</p>

<p style="text-align:justify"><strong>County Attorney:</strong><strong> </strong>Maddison A.E. Denny (REP)</p>

<p style="text-align:justify"><strong>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </strong></p>

<p style="text-align:justify; text-indent:.5in"><strong>The following is a complete listing of candidates for Non-Partisan Offices in Keokuk County:</strong></p>

<p style="text-align:justify"><strong>Adams Township</strong>:&nbsp; Trustee (Elect Two) &ndash; Colt Mather; Clerk (Elect One) &ndash; Josh Annis</p>

<p style="text-align:justify"><strong>Benton Township</strong>:&nbsp; Trustee (Elect Two) &ndash; Rick Abel; Clerk (Elect One) &ndash; Linda Abel</p>

<p style="text-align:justify"><strong>Clear Creek Township</strong>:&nbsp; Trustee (Elect Two) &ndash; No Candidate Filed; Clerk (Elect One) &ndash; Alan Berg</p>

<p><strong>English River Township</strong>: Trustee (Elect Two) &ndash; Tom Baird; Clerk (Elect One) &ndash; Cherrie Baird</p>

<p><strong>Jackson Township</strong>:&nbsp; Trustee (Elect Two) &ndash; No Candidate Filed; Clerk (Elect One) &ndash; Julie Swanson</p>

<p><strong>Lafayette Township</strong>:&nbsp; Trustee (Elect Two) &ndash; Dennis Lyle, Tom Adam; Clerk (Elect One) &ndash; Kevin Luers;</p>

<p>Trustee To Fill Vacancy &ndash; No Candidate Filed</p>

<p><strong>East Lancaster Township</strong>:&nbsp; Trustee (Elect Two) &ndash; David B. Klein, John Dumont; Clerk (Elect One) &ndash; Carla Dumont</p>

<p><strong>West Lancaster Township</strong>:&nbsp; Trustee (Elect Two) &ndash; Gary Martin; Clerk (Elect One) &ndash; Janet D. Martin</p>

<p><strong>Liberty Township</strong>:&nbsp; Trustee (Elect Two) &ndash; No Candidate Filed; Clerk (Elect One) &ndash; No Candidate Filed</p>

<p><strong>Plank Township</strong>:&nbsp; Trustee (Elect Two) &ndash; Jeffrey H. Hinnah; Clerk (Elect One) &ndash; Holly A. Martin</p>

<p><strong>Prairie Township</strong>:&nbsp; Trustee (Elect Two) &ndash; Kelvin Gale, Steve Van Zee; Clerk (Elect One) &ndash; Judith Christner</p>

<p><strong>Richland Township</strong>:&nbsp; Trustee (Elect Two) &ndash; No Candidate Filed; Clerk (Elect One) &ndash; No Candidate Filed</p>

<p><strong>Sigourney Township</strong><strong>:&nbsp; </strong>Trustee (Elect Two) &ndash; Ronald A. Waechter, Terry Steinhart; Clerk (Elect One) &ndash; Paula Rasplicka; Trustee To Fill Vacancy &ndash; No Candidate Filed</p>

<p style="text-align:justify"><strong>Steady Run Township</strong>:&nbsp; Trustee (Elect Two) &ndash; David Jones; Clerk (Elect One) &ndash; James Campbell</p>

<p style="text-align:justify"><strong>Van Buren Township</strong>:&nbsp; Trustee (Elect Two) &ndash; No Candidate Filed; Clerk (Elect One) &ndash; No Candidate Filed</p>

<p style="text-align:justify"><strong>Warren Township</strong>:&nbsp; Trustee (Elect Two) &ndash; Doyle Abrams; Clerk (Elect One) &ndash; No Candidate Filed</p>

<p style="text-align:justify"><strong>Washington Township</strong>:&nbsp; Trustee (Elect Two) &ndash; Michael Striegel, Kirk E. Beasley; Clerk (Elect One) &ndash; James L. Striegel</p>

<p style="text-align:justify"><strong>County Hospital Trustee:</strong><strong> </strong>(Elect Five) Ron Kurtz, Allison Pence, Judy Striegel, Alan Sellers, Dustin R. Bensmiller,</p>

<p style="text-align:justify">Jodi Greiner, Terry Fogle, Kathy Utterback, Candy Breon, John Dumont, David J. Peterson</p>

<p style="text-align:justify"><strong>Soil &amp; Water Conservation District Commissioner:</strong> (Elect Two) Joel Millikin, Dan Striegel</p>

<p style="text-align:justify"><strong>County Agricultural Extension Council:</strong> (Elect Five) Clinton Mikesell, Michael Bensmiller, Carla Dumont,</p>

<p style="text-align:justify">Heather Bombei, Janis Collins</p>

<p style="text-align:justify">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>

<p style="text-align:justify">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <strong>The following is a complete list of Judges for retention:</strong></p>

<p style="text-align:justify"><strong>Court of Appeals:</strong><strong> </strong>John M. Sandy, Julie A. Schumacher, Sharon Soorholtz Greer</p>

<p style="text-align:justify"><strong>District 8A Court Judge:</strong><strong> </strong>Dustin Hite, Amber L. Thompson</p>

<p style="text-align:justify"><strong>District 8A Associate Judge:</strong><strong> </strong>Susan Cole, Jennifer Nicole Jensen</p>

<p style="margin-top:14px"><strong>Statewide Public Measure - Constitutional Amendment #1:</strong></p>

<p style="text-align:justify">&nbsp;</p>

<p style="text-align:justify">The Constitution of the State of Iowa is amended by adding the following new section to new Article XIII:</p>

<p style="text-align:justify">Passage of a bill that increases the individual income tax rate or the corporate income tax rate, or the rate of any other type of tax based upon income or legal and special reserves, shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. This requirement does not apply to taxes imposed at the option of a local government. Passage of a bill that establishes a new tax on any type of income or legal and special reserves imposed by the state shall require the affirmative votes of at least two-thirds of the members elected to each house of the general assembly. A lawsuit challenging the proper enactment of a bill under this section must be &#64257;led no later than one year following the enactment. If such a lawsuit is not &#64257;led within the one-year limit, the bill shall be considered properly enacted under this section. Each bill to which this section applies must include a separate provision describing the requirements for enactment prescribed by this section. The general assembly shall enact laws to implement this section.</p>

<p style="text-align:justify">&nbsp;</p>

<p style="margin-bottom:11px"><strong>Kirkwood Community College - Public Measure NC:</strong></p>

<p style="margin-bottom:11px; text-align:justify">&ldquo;Shall Kirkwood Community College (Merged Area X) in the Counties of Benton, Black Hawk, Buchanan, Cedar, Clinton, Delaware, Dubuque, Iowa, Jackson, Jefferson, Johnson, Jones, Keokuk, Linn, Louisa, Poweshiek, Tama, and Washington, be authorized to renovate, improve, erect, and equip facilities to modernize learning spaces with an emphasis on health sciences, industrial technologies, agricultural sciences, and business and information technology, contract indebtedness therefor, and issue General Obligation Bonds in an amount not exceeding $88,000,000 for those purposes?&rdquo;</p>

<p style="margin-bottom:11px"><strong>Keota Community School - Public Measure ML:</strong></p>

<p style="margin-bottom:11px; text-align:justify">Shall the Board of Directors of the Keota Community School District in the Counties of Keokuk and Washington, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $6,400,000 to provide funds to remodel, repair, equip, and improve the Jr-Sr High School, including a secure entrance, educational spaces, HVAC, mechanical, electrical, and plumbing improvements; to remodel, repair, equip, and improve the Elementary School, including a secure entrance and plumbing improvements; and for fire alarm upgrades throughout the school building?</p>

<p style="margin-bottom:11px"><strong>Pekin Community School - Public Measure MN:</strong></p>

<p style="margin-bottom:11px; text-align:justify">Shall the Board of Directors of the Pekin Community School District in the Counties of Jefferson, Keokuk, Wapello, and Washington, State of Iowa, be authorized to contract indebtedness and issue General Obligation Bonds in an amount not to exceed $9,200,000 to provide funds to build, furnish, and equip additions to the school building, including classroom and commons area spaces; to remodel, repair, improve, and equip the school building, including a secure entrance, HVAC, mechanical, electrical, plumbing, parking, accessibility, and site improvements?</p>

<p style="margin-bottom:11px; text-align:justify">&nbsp;</p>

<p style="text-align:right">Certified by Christy Bates</p>

<p style="text-align:right">Keokuk County Auditor</p>

<p style="margin-bottom:11px; text-align:right">And Commissioner of Elections</p>
                      </div>
