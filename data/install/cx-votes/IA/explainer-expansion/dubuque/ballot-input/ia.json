        "officialLinkingPage": {
          "url": "https://elections.dubuquecountyiowa.gov/",
          "html": " <style>\n   .welcomelink1 a,\n        .welcomelink1 a:link, \n        .welcomelink1 a:visited,\n        .welcomelink1 a:active {\n            color: #B8C4EA;\n        }\n\n        .welcomelink1 a:hover {\n            color:#718AD6;\n        }\n </style>\n       <div style=\"padding-top: 40px;\">\n               <div class=\"col-sm-2\"></div>\n        <div class=\"col-sm-1\">\n            <div style=\"display:flex; flex-direction: column; align-items: center; justify-content: center;\">\n                <div style=\"display: flex; flex-direction: column; align-items: center; justify-content: center; width: 175px;\">\n                  <!-- \"https://gis.dubuquecounty.us/Elections/Photos/People/Kevin.jpg\" -->\n                    <img src=\"https://gis.dubuquecounty.us/Elections/Photos/People/Keith.jpg\" style=\"height: 225px; width: auto; border-radius: 50%; box-shadow: 0 0 15px 2px #2e2e38\" title=\"Commissioner\">\n                    <div style=\"text-align: center; margin-top: 10px; font-weight: bold;\">\n                        Keith Lucy</div>\n                    <div style=\"text-align: center; font-weight: bold;\">County Auditor &amp;\n                    </div>\n                    <div style=\"text-align: center; font-weight: bold;\"> Commissioner of Elections<br>\n                    <br>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"col-sm-6\">\n            <p class=\"welcomelink1\" style=\"margin-bottom: 30px; padding-top: 40px; padding-right:10%; padding-left:10%;\">\n                Welcome to the Dubuque County Elections website. The\n                Elections Department\n                is a division of the\n                <a href=\"https://www.dubuquecountyiowa.gov/165/Auditor\"> Auditor's Office</a>, the branch of the\n                county\n                government responsible for certifying elections in the county. Below you can find information about\n                upcoming elections, how to vote, finding your elected officials, getting involved with elections,\n                and more.\n                <br>\n                <br>\n                If you can't find what you're looking for, or have a question, please <a href=\"mailto:elections@dubuquecountyiowa.gov\">contact us</a> and we'll get back to you as soon\n                as\n                possible.</p><h5><p class=\"welcomelink1\" style=\"text-align: center; margin-bottom: 30px; padding-top: 40px; padding-right: 10%; padding-left: 10%;\">Phone: 563-589-4457</p></h5>\n        </div>\n        <div class=\"col-sm-1\">\n            <div style=\"display:flex; flex-direction: column; align-items: center; justify-content: center;\">\n                <div style=\"display: flex; flex-direction: column; align-items: center; justify-content: center; width: 175px;\">\n                    <!--\"https://gis.dubuquecounty.us/Elections/Photos/People/Jenny.jpg\" -->\n                    <img src=\"https://gis.dubuquecounty.us/Elections/Photos/People/Jenny2.jpg\" style=\"height: 225px; width: auto; border-radius: 50%; box-shadow: 0 0 15px 2px #2e2e38\" title=\"Deputy Commissioner\">\n                    <div style=\"text-align: center; margin-top: 10px; font-weight: bold;\">\n                        Jenny Hillary</div>\n                    <div style=\"text-align: center; font-weight: bold;\">Deputy Commissioner of Elections\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"col-sm-2\"></div>\n    </div>\n<style>\n        .btncardbck1 {\n          text-align: center;\n          padding-bottom: 4%;\n        }\n        \n        .buttonh1:link, .buttonh1:visited {\n          background-color: rgb(22, 105, 83);\n          color: white;\n          border: solid rgba(18, 83, 65, 1);\n          border-radius: 12px;\n          padding: 2.5% 10%;\n          margin: auto;\n          text-align: center;\n          text-decoration: none !important;\n          display: inline-block;\n        }\n        \n        .buttonh1:hover, .buttonh1:active {\n          border: solid rgba(18, 83, 65, 1);\n          border-radius: 12px;\n          background-color: rgb(18, 83, 65);\n          color: white;\n        }\n        \n        .btncardbck1 img {\n            max-width: 180px;\n            width: 100%;\n            height: auto;\n            margin: auto;\n        }\n\n       .quicklinks{\n            display: flex;\n            margin: auto;\n            margin-bottom: 1vh;\n            margin-top: 1vh;\n            justify-content: center;\n            align-items: center;\n        }\n\n    </style>\n<div>\n<div class=\"quicklinks\">\n            <h2><b> Quick Links </b></h2>\n        </div>\n        <!-- Upcoming Election -->\n        <div class=\"col-sm-2\">\n            <div class=\"btncardbck1\">\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/election-upcoming\">\n                  <!--\"https://gis.dubuquecounty.us//Elections/Icons/VoteButton.svg\" \"https://gis.dbqco.org/PollPics/ElectionsHub/VoteButton.svg\" -->\n                    <img src=\"https://gis.dubuquecounty.us//Elections/Icons/VoteButton.svg\" title=\"Next Election\"></a>\n                <br>\n                <br>\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/election-upcoming\" class=\"buttonh1\" role=\"button\" aria-label=\"Next Election\"><b>Next Election</b> </a>\n            </div>\n        </div>\n        <!-- Register -->\n        <div class=\"col-sm-2\">\n            <div class=\"btncardbck1\">\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-register\">\n                  <!-- \"https://gis.dubuquecounty.us//Elections/Icons/CheckRegistration.svg\" \"https://gis.dbqco.org/PollPics/ElectionsHub/CheckRegistration.svg\"-->\n                    <img src=\"https://gis.dubuquecounty.us//Elections/Icons/CheckRegistration.svg\" title=\"Check Registration\"></a>\n                <br>\n                <br>\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-register\" class=\"buttonh1\" role=\"button\" aria-label=\"Check Registration\"><b>Register to Vote</b></a>\n            </div>\n        </div>\n        <!-- How to Vote -->\n        <div class=\"col-sm-2\">\n            <div class=\"btncardbck1\">\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-how-to\">\n                  <!-- \"https://gis.dubuquecounty.us//Elections/Icons/VoteBox.svg\" \"https://gis.dbqco.org/PollPics/ElectionsHub/VoteBox.svg\"-->\n                    <img src=\"https://gis.dubuquecounty.us//Elections/Icons/VoteBox.svg\" title=\"How to Vote\"></a>\n                <br>\n                <br>\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-how-to\" class=\"buttonh1\" role=\"button\" aria-label=\"How To Vote\"><b>How to Vote?</b></a>\n            </div>\n        </div>\n        <!-- Where to Vote -->\n        <div class=\"col-sm-2\">\n            <div class=\"btncardbck1\">\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-where-to\">\n                  <!-- \"https://gis.dubuquecounty.us//Elections/Icons/VoteBox.svg\" \"https://gis.dbqco.org/PollPics/ElectionsHub/VoteBox.svg\"-->\n                    <img src=\"https://gis.dubuquecounty.us//Elections/Icons/Where.svg\" title=\"Where to Vote\"></a>\n                <br>\n                <br>\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-where-to\" class=\"buttonh1\" role=\"button\" aria-label=\"Where To Vote\"><b>Where to Vote?</b></a>\n            </div>\n        </div>\n        <!-- Absentee Voting -->\n        <div class=\"col-sm-2\">\n            <div class=\"btncardbck1\">\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-absentee\">\n                  <!-- \"https://gis.dubuquecounty.us//Elections/Icons/MailedBallot.svg\" \"https://gis.dbqco.org/PollPics/ElectionsHub/MailedBallot.svg\"-->\n                    <img src=\"https://gis.dubuquecounty.us//Elections/Icons/MailedBallot.svg\" title=\"Absentee Vote\"></a>\n                <br>\n                <br>\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-absentee\" class=\"buttonh1\" role=\"button\" aria-label=\"Absentee Voting\"><b>Absentee Voting</b></a>\n            </div>\n        </div>\n        <!-- Results -->\n        <div class=\"col-sm-2\">\n            <div class=\"btncardbck1\">\n              <!-- \"https://www.livevoterturnout.com/ENR/dubuqueiaenr/12/en/Index_12.html\" \"https://gis.dubuquecounty.us/Elections/Docs/Results/2024NovemberGeneral.pdf\" -->\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/election-results\">\n                  <!--\"https://gis.dubuquecounty.us//Elections/Icons/Results.svg\" \"https://gis.dbqco.org/PollPics/ElectionsHub/Results.svg\"-->\n                    <img src=\"https://gis.dubuquecounty.us//Elections/Icons/Results.svg\" title=\"Results\"></a>\n                <br>\n                <br>\n                <!--\"https://elections.dubuquecountyiowa.gov/pages/election-results\"  -->\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/election-results\" class=\"buttonh1\" role=\"button\" aria-label=\"Results\"><b>Results</b></a>\n            </div>\n        </div>\n</div>\n<style>\n  .newsDatesRow iframe{\n    margin-top: 3%;\n    margin-bottom: 3%;\n    margin-left: auto;\n    margin-right: auto;\n    height: auto;\n    width: 100%;\n    padding-right: 0%;\n    padding-left: 0%;\n    padding-top: 1%;\n    padding-bottom: 1%;\n  }\n  \n</style>\n\n<div class=\"welcomelink1\" style=\"text-align: center;\">\n               <h2>\n                    <b>News</b> <br>\n                </h2>\n                <h5><span style=\"color: inherit; font-size: 24px; background-color: initial;\">General Election</span></h5>\n                \n  </div>\n  <div class=\"welcomelink1\" style=\"text-align: center;\">County wide Election with polls open from 7:00am to 8:00pm on November 3rd. This election is to fill Federal, State and County offices.</div><div class=\"welcomelink1\" style=\"text-align: center;\"><br></div><h4 style=\"text-align: center;\">Absentee Voting</h4><h6 style=\"text-align: center;\">Today, November 2nd is the last day for absentee voting. You have to vote in your assigned polling location on Election Day.</h6>\n  \n  <!-- <h4>General Election Results</h4>\n  <a href=\"https://www.livevoterturnout.com/ENR/dubuqueiaenr/13/en/Index_13.html\" aria-label=\"Results Link\">here</a>\n  <a href=\"https://elections.dubuquecountyiowa.gov/pages/election-results\" aria-label=\"Results page\">here</a>\n  <a href=\"https://gis.dubuquecounty.us/Elections/Docs/MidDayTurnOut.pdf\" aria-label=\"Mid Day Link\">here</a>\n  \n  https://elections.dubuquecountyiowa.gov/pages/election-results\n                <h6>Results from Dubuque County are available <a href=\"https://gis.dubuquecounty.us/Elections/Docs/Results/2024NovemberGeneral.pdf\" aria-label=\"Election Day Results\">here</a>.\n                    <br>\n                </h6>-->\n\n<div class=\"welcomelink1\" style=\"text-align: center;\">\n    <h2>\n        <b>Dates &amp; Deadlines</b></h2><h2></h2><h5>November 3rd, 2026</h5><h6>General Election Day Polls are open from 7:00 am to 8:00 pm.</h6><h5>November 2nd, 2026</h5><h6>Last day for Absentee Voting. Voters must go to their assigned polling location on Election Day.</h6> <h4><br></h4></div><div style=\"text-align: center;\">\n    <a href=\"https://elections.dubuquecountyiowa.gov/pages/election-upcoming\" class=\"btn buttonh1\" role=\"button\" aria-label=\"Upcoming Election Dates\"><b>More Dates</b></a>\n</div>\n<style>\r\n  .home iframe{\r\n            border: 1px solid rgba(43, 69, 147, 0.9);\r\n        }\r\n</style>\r\n<div style=\"text-align: center; min-height: 50px;\">To learn more about where to vote on\r\n            Election Day, visit our\r\n            <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-where-to\" aria-label=\"Where to Vote\"> Where to\r\n                Vote</a> page. If you are unable to use the application above to determine your polling location, call the Dubuque County Elections office at (563) 589-4457 or visit the Iowa Secretary of State's\r\n            <a href=\"https://apps.sos.iowa.gov/elections/voterreg/pollingplace/search.aspx\" aria-label=\"IA SOS Polls Search\">Find Your Polling Place Search</a>.\r\n        </div>\n<style>\n  /* Survey Cards */\n        .formcard {\n            padding: 10px;\n            border: 1.5px solid #ddd;\n            border-collapse: separate;\n            border-radius: 10px;\n            box-shadow: 2px 0px 10px grey;\n        }\n\n        .formcard img {\n            width: 100%;\n            height: 33%;\n            border-radius: 5px;\n            filter: blur(0.5px);\n        }\n</style>\n\n <div>\n        <div class=\"col-sm-1\" aria-label=\"true\"></div>\n        <!-- Mailed/Printed Absent Ballot Request Form -->\n        <div class=\"col-sm-3\">\n            <div class=\"formcard\">\n              <!--\"https://sos.iowa.gov/elections/pdf/absenteeballotapp.pdf\" -->\n                <a href=\"https://sos.iowa.gov/elections/pdf/absenteeballotapp.pdf\" style=\"text-align:center\">\n                  <!--\"https://gis.dubuquecounty.us/Elections/Photos/ElectionsEnvelope.jpg\" \"https://gis.dbqco.org/PollPics/ElectionsHub/ElectionsEnvelope.jpg\"-->\n                    <img src=\"https://gis.dubuquecounty.us/Elections/Photos/ElectionsEnvelope.jpg\" alt=\"Ballot Request Form\">\n                </a>\n                <h5 style=\"text-align: center;\">\n                  <!--\"https://sos.iowa.gov/elections/pdf/absenteeballotapp.pdf\" -->\n                    <a href=\"\" style=\"text-align:center\" aria-label=\"Absentee Ballot Request\">Absentee Ballot Request Form</a>\n                </h5>\n                <p>\n                    Starting 70 days before Election Day, the Elections Office accepts\n                    <!--\"https://sos.iowa.gov/elections/pdf/absenteeballotapp.pdf\" -->\n                    Absentee Ballot                        Request Forms                    .\n                    To receive an Absentee Ballot in the mail, the Elections Office must receive your\n                    completed Absentee Ballot Request Form by 5pm on the Monday, 15 days before Election Day.\n                    <br>\n                </p>\n                <p style=\"font-size: 12px;\">\n                    Don't have a printer? Complete our\n                    <a href=\"https://arcg.is/0Gnmun\">online form </a> and Dubuque County Elections will send you a\n                    printed\n                    Absentee Ballot Request Form in the mail.\n                </p>\n            </div>\n        </div>\n        <!-- FAQ -->\n        <div class=\"col-sm-4\" style=\"padding: 20px;\">\n            <h3 style=\"text-align: center;\"><b>FAQ?</b></h3>\n            <!-- https://elections.dubuquecountyiowa.gov/pages/voting-absentee -->\n            <h5>Q. Will the county Elections Office send absentee ballot request forms to all voters in the county?</h5>\n            <p style=\"margin-left: 25px;\">A. No. State law now prohibits this. If you personally request an absentee ballot request form, the Elections Office will send you one. Please visit our <a href=\"https://elections.dubuquecountyiowa.gov/pages/voting-absentee\" aria-label=\"Absentee Webpage\">Absentee Voting</a> page to learn more.<br></p>\n            <h5>Q. What if I don’t have a four-digit Pin number?</h5>\n            <p style=\"margin-left: 25px;\">A. When filling out an Absentee Ballot Request form this is an OR question. If\n                you have an Iowa Driver’s License or Non-Operator ID number you should use this number as your ID number\n                on the request form, as you are not automatically mailed a voter Pin card. However, any voter may\n                request an Iowa Voter Identification Card.\n            </p>\n            <div style=\"text-align: center;\">\n                <br>\n                <a href=\"https://elections.dubuquecountyiowa.gov/pages/election-faq\" class=\"btn buttonh1\" role=\"button\" aria-label=\"All FAQs Button\"><b>All FAQs</b></a>\n            </div>\n            <br>\n        </div>\n        <!-- PEO APP -->\n        <div class=\"col-sm-3\">\n            <div class=\"formcard\">\n                <a href=\"https://arcg.is/1SXzqu0\" style=\"text-align:center\">\n                  <!--\"https://gis.dubuquecounty.us/Elections/Photos/PEOApp.jpg\" \"https://gis.dbqco.org/PollPics/ElectionsHub/PEOApp.jpg\"-->\n                    <img src=\"https://gis.dubuquecounty.us/Elections/Photos/PEOApp.jpg\" alt=\"Precinct Official Application\">\n                </a>\n                <h5 style=\"text-align: center;\">\n                    <a href=\"https://arcg.is/1SXzqu0\" style=\"text-align:center\">Precinct Election Official\n                        Application</a>\n                </h5>\n                <p>\n                    If you're interested in serving as a Precinct Election Official, now's the time to sign up. We're\n                    always looking for community-minded citizens ready to roll up their sleeves and help make a\n                    difference by working at the polls on Election Day.\n                </p>\n                <div style=\"text-align: center;\">\n                    <a href=\"https://arcg.is/1SXzqu0\" class=\"btn buttonh1\" role=\"button\" aria-label=\"Apply Here\"><b>Sign Up</b></a>\n                </div>\n            </div>\n        </div>\n        <div class=\"col-sm-1\"></div>\n    </div>\n    <style>\r\n   .edayLink a,\r\n        .edayLink a:link, \r\n        .edayLink a:visited,\r\n        .edayLink a:active {\r\n            background-color: rgba(255, 255, 255, 0.5);\r\n            color:rgb(255, 255, 255);\r\n        }\r\n\r\n        .edayLink a:hover {\r\n            background-color:#color: rgba(166, 53, 37, 0.5);\r\n            color:rgb(255, 255, 255);\r\n        }\r\n </style>\r\n    <!-- NavBar -->\r\n<header data-element=\"navbar\" class=\"navbar-fixed-top\">\r\n        <div class=\"site-header\">\r\n            <nav class=\"navbar navbar-inverse\">\r\n                <div class=\"container-fluid\">\r\n                    <!-- Logo, brand, and toggle get grouped for better mobile display -->\r\n                    <div class=\"navbar-header\">\r\n                        <button class=\"navbar-toggle\" data-toggle=\"collapse\" data-target=\"#electionNavbar\">\r\n                            <span class=\"sr-only\">Toggle navigation</span>\r\n                            <span class=\"icon-bar\"></span>\r\n                            <span class=\"icon-bar\"></span>\r\n                            <span class=\"icon-bar\"></span>\r\n                        </button>\r\n                        <a href=\"https://www.dubuquecountyiowa.gov/\">\r\n                            <img alt=\"Logo\" src=\"https://www.dubuquecountyiowa.gov/ImageRepository/Document?documentID=7134\" style=\"float: left;\">\r\n                        </a>\r\n                        <!-- <a class=\"navbar-brand\" href=\"https://elections.dubuquecountyiowa.gov/\">Dubuque County Elections</a> -->\r\n                    </div>\r\n                    <!-- Navbar menu/list items (will collapse for mobile) -->\r\n                    <div class=\"collapse navbar-collapse\" id=\"electionNavbar\">\r\n                        <!-- Unordered menu list -->\r\n                        <ul class=\"nav navbar-nav\">\r\n                            <li>\r\n                              <a href=\"https://elections.dubuquecountyiowa.gov/\">Home</a>\r\n                            </li>\r\n                            <!-- First list item