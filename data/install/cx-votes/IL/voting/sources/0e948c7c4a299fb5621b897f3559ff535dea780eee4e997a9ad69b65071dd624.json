aceholder":"Find address or place","countryCode":"","zoomScale":50000,"maxSuggestions":6,"maxResults":6,"searchInCurrentMapExtent":false,"enableLocalSearch":true,"localSearchMinScale":300000,"localSearchDistance":50000,"type":"locator"},{"name":"Sangamon Locator","url":"https://gis.co.sangamon.il.us/arcgis/rest/services/SangLocator/GeocodeServer","singleLineFieldName":"SingleLine","placeholder":"Enter Sangamon Address","maxResults":6,"searchInCurrentMapExtent":false,"type":"locator","enableLocalSearch":false,"localSearchMinScale":300000,"localSearchDistance":50000},{"name":"Situs","url":"https://gis.co.sangamon.il.us/arcgis/rest/services/SitusAddrLoc/GeocodeServer","singleLineFieldName":"Single Line Input","placeholder":"Find address or place","maxResults":6,"searchInCurrentMapExtent":false,"type":"locator","enableLocalSearch":false,"localSearchMinScale":300000,"localSearchDistance":50000}]},"errorMessage":"No polygon found for this address or location"}},{"name":"About","version":"2.31","uri":"widgets/About/Widget","config":{"about":{"aboutContent":"<div> </div>\n\t<div align=\"center\"><div align=\"center\" style=\"text-align: center;\"><b>Instructions</b></div><div align=\"center\" style=\"text-align: center;\"><b><br /></b></div><div align=\"center\" style=\"text-align: center;\"><b>Phone: 217-753-8683</b></div><div align=\"center\" style=\"text-align: center;\"><b>Email: </b><a href=\"mailto:election@co.sangamon.il.us\" target=\"_self\">elections@co.sangamon.il.us</a></div><div align=\"center\" style=\"text-align: center;\"><br /></div><div align=\"center\" style=\"text-align: left;\">To find your polling place, you can enter your address in the address entry box.  The application will zoom to a scale that encompasses the polling place along with your home address.  Alternatively, you can zoom/Pan the map and find your home location on the map then you can click on the tear drop shaped tool next to the address entry box and then click on the map where you want to set your home location.  The map will zoom in/out to encompass the your polling place along with your home address.</div><div align=\"center\" style=\"text-align: left;\"><br /></div><div align=\"center\" style=\"text-align: left;\"><br /></div><div style=\"text-align: left;\">Once your polling place has been identified and the map extents have been zoomed to encompass your polling place and your home location, the polling place details will be populated within the Information Tab.   If you need driving directions to your polling place then click on the Directions Tab and the application will generate a route from your home to get you to the polling place.</div><div style=\"text-align: left;\"><br /></div><div style=\"text-align: left;\">On a smaller device, you can make the polling place and driving directions full screen by clicking on the little square icon.  You can minimize the poling place information and driving direction pane by clicking on the double chevron / corporal icon.<br /><br /></div><div style=\"text-align: left;\">To return to the Polling Location tool click on the Polling Location Icon <img id=\"img_1518801124380\" src=\"data:image/jpeg;base64,\" /></div></div>"}},"index":4,"id":"widgets_About_Widget_32"}],"groups":[]},"mobileLayout":{"widgetOnScreen":{"widgets":[{"uri":"themes/PlateauTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.7"},{"uri":"widgets/Scalebar/Widget","visible":true,"position":{"left":25,"bottom":25,"relativeTo":"map"},"version":"2.7"},{"uri":"widgets/Search/Widget","visible":false,"position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.7"},{"uri":"widgets/Coordinate/Widget","visible":false,"position":{"left":200,"bottom":20,"relativeTo":"map"},"version":"2.7"},{"uri":"widgets/OverviewMap/Widget","visible":false,"position":{"right":0,"bottom":0,"zIndex":1},"version":"2.7"},{"uri":"widgets/HomeButton/Widget","visible":true,"inPanel":false,"pos