        }
      ],
      "measureRecords": [
        {
          "contestId": "in-ied-2026-public-question-2",
          "whatItDoes": "Lets a city or town court judge live in the county where the court is located or in the closest bordering Indiana county. The closest county is determined by the shortest distance from the city or town limits to the county line. This changes Article 6, Section 6 of the Indiana Constitution and takes effect only if a majority of voters voting on the amendment approve it.",
          "yesMeans": "Approve these new residency options for city and town court judges.",
          "noMeans": "Reject this amendment; Article 6, Section 6 would not change under this question.",
