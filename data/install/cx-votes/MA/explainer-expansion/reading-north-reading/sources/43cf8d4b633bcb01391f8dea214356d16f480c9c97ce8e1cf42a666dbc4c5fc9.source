    <div class="article-header-content px-0 py-md-3 py-2 ">
        <h1 class="fs-1 article-header-title mb-3">
            November 2026 Ballot Question 10
        </h1>
        <div class="article-header-footer d-flex flex-wrap gap-1 align-items-center articles-category">
            <span id="article-header-tag"
                  class="article-badge badge rounded-pill text-border-primary fw-semibold text-truncate me-2 text-dark">
