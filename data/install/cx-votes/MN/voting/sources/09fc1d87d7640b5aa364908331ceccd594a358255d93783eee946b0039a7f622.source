script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"nodeResource":{"__typename":"NodeBasicPage","id":"2808","siteSlug":"www","shortTitle":null,"path":"/residents/elections-voting/voters/vote-on-election-day","computedMenu":"{\"title\":\"Elections \u0026 Voting\",\"url\":\"\\/residents\\/elections-voting\",\"children\":[{\"title\":\"Voters\",\"url\":\"\\/residents\\/elections-voting\\/voters\",\"children\":[{\"title\":\"Key Election Dates\",\"url\":\"\\/residents\\/elections-voting\\/voters\\/key-election-dates-voters\",\"children\":[]},{\"title\":\"Vote Before Election Day\",\"url\":\"\\/residents\\/elections-voting\\/voters\\/vote-before-election-day\",\"children\":[]},{\"title\":\"Vote on Election Day\",\"url\":\"\\/residents\\/elections-voting\\/voters\\/vote-on-election-day\",\"children\":[],\"active\":true},{\"title\":\"Voting Basics\",\"url\":\"\\/residents\\/elections-voting\\/voters\\/voting-basics\",\"children\":[]}],\"activeParent\":true},{\"title\":\"Candidates\",\"url\":\"\\/residents\\/elections-voting\\/candidates\",\"children\":[]},{\"title\":\"Election Judges\",\"url\":\"\\/residents\\/elections-voting\\/election-judges\",\"children\":[]},{\"title\":\"Election Results\",\"url\":\"\\/residents\\/elections-voting\\/election-results\",\"children\":[]},{\"title\":\"Voter Outreach \u0026 Education\",\"url\":\"\\/residents\\/elections-voting\\/voter-outreach-education\",\"children\":[]},{\"title\":\"Information \u0026 Reference\",\"url\":\"\\/residents\\/elections-voting\\/election-information-reference\",\"children\":[]},{\"title\":\"Contact Elections\",\"url\":\"\\/residents\\/elections-voting\\/contact-elections\",\"children\":[]}],\"activeParent\":true}","title":"Vote on Election Day","status":true,"summary":"Vote on Election Day at your assigned polling place in Ramsey County from 7 a.m. to 8 p.m. Check for any polling changes, register with ID proof if needed, and return absentee ballots to the Elections Office by 5 p.m.","displayHeroSection":false,"image":null,"content":[{"__typename":"ParagraphRichText","id":"1406","title":null,"callOutBox":false,"responsiveTables":false,"body":{"processed":"\u003cp\u003eOn Election Day, you must vote at your assigned polling place. Be sure to look up your polling place in advance — it may have changed since you last voted.\u003c/p\u003e\n\u003cp\u003ePolling places will be open from 7 a.m. to 8 p.m. on Election Day.\u003c/p\u003e\n\u003cp\u003e\u003ca class=\"button button-primary\" href=\"https://pollfinder.sos.state.mn.us/\"\u003eFind your polling place\u003c/a\u003e \u003ca class=\"button button-secondary\" href=\"https://www.sos.mn.gov/elections-voting/whats-on-my-ballot/get-a-sample-ballot/\"\u003eView your sample ballot\u003c/a\u003e\u003cbr\u003eTo register on Election Day, you must show \u003ca href=\"https://www.sos.state.mn.us/elections-voting/register-to-vote/register-on-election-day/\"\u003eproof of identification and residence\u003c/a\u003e.\u003c/p\u003e\n\u003ch2\u003eReturning absentee ballots\u003c/h2\u003e\n\u003cp\u003eOn Election Day, the only place you may return your absentee ballot in person is the \u003ca href=\"https://www.google.com/maps/place/Ramsey+County+Property+Tax,+Records+and+Elections+Services/@44.9359416,-93.090656,15z/data=!4m5!3m4!1s0x0:0xd056d0e1386c8e43!8m2!3d44.9359416!4d-93.090656\"\u003eRamsey County Elections Office\u003c/a\u003e. Ballots must be returned by 5 p.m.\u003cbr\u003e\u003cbr\u003eVoters cannot return an absentee ballot at a polling place on Election Day.\u003c/p\u003e\n\u003cp\u003eIf you have an unsubmitted absentee ballot, you may vote at your assigned polling place instead. Your absentee ballot will be spoiled (made invalid in the system) and you will be issued a new ballot to cast at the polling place.\u003c/p\u003e\n"}},{"__typename":"ParagraphContactInfo","id":"4152","title":"Contact us","location":{"title":"Elections","socialMediaHeading":null,"socialMediaLink":null,"contactInfoHeading":null,"peopleHeading":null,"phoneNumber":"651-266-2171","faxNumber":"651-266-2177","emailAddress":"elections@ramseycountymn.gov","personReference":null,"resourcesHeading":null,"resource":[{"title":null,"isDocument":false,"documentLabel":null,"document":null,"link":{"internal":true,"title":"Contact form","url":"/residents/elections-voting/contact-elections"}},{"title":null,"isDocument":false,"documentLabel":null,"document":null,"link":{"internal":true,"title":"More information","url":"/residents/elections-voting"}},{"title":null,"isDocument":false,"documentLabel":null,"document":null,"link":{"internal":false,"title":"E-newsletter","url":"https://public.govdelivery.com/accounts/MNRAMSEY/subscriber/topics?qsp=MNRAMSEY_456"}}],"path":"/elections","overrideCoordinates":false,"address":null,"longitude":null,"latitude":null,"hoursOfOperation":null}}],"requiredPageDepartment":{"name":"Property Tax, Records \u0026 Election Services","id":"23"},"callToAction":null,"metatag":[{"__typename":"MetaTagValue","attributes":{"content":"Vote on Election Day | Ramsey County, Minnesota","name":"title"}},{"__typename":"MetaTagValue","attributes":{"content":"Vote on Election Day at your assigned polling place in Ramsey County from 7 a.m. to 8 p.m. Check for any polling changes, register with ID proof if needed, and return absentee ballots to the Elections Office by 5 p.m.","name":"description"}},{}]},"layout":{"header":{"logoPath":"/static/ramsey-logo.png","mainMenu":{"items":[{"url":"/residents","title":"Residents","id":"eeeaaabe-c957-4bfa-b39c-65e20cfc3f25","children":[{"url":"/residents/assistance-support","title":"Assistance \u0026 Support","id":"9b176bce-9510-4036-9391-0016629ef082"},{"url":"/residents/elections-voting","title":"Elections \u0026 Voting","id":"1a5ea81f-faa0-4893-b06f-4549f650ab34"},{"url":"/residents/emergency-response-preparedness","title":"Emergency Response \u0026 