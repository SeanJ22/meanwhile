document.write('<div class=\"backBtn\" id=\"backBtn\"><a href=\"/cod/browse-by-county/\" alt=\"datalist\" >&larr; Back</a></div><h1 id=\"countyName\">Oliver County</h1><article class=\"cdetail\">    <div class=\"countyInfoBlock\">        <div class=\"county_img\"><img src=\"/image/cache/Oliver.jpg\" alt=\"Oliver.jpg Image\" /></div>        <div class=\"conty_info\">            <h3>Oliver County Courthouse</h3>            <p><i class=\"fa fa-map-marker\" aria-hidden=\"true\">&nbsp;</i> 115 W Main                <br /> Center, ND 58530</p>            <p><i class=\"fa fa-clock-o\" aria-hidden=\"true\">&nbsp;</i> 8:00 - 4:00 CT</p>            <p class=\"hideolivercountynd.org\"><i class=\"fa fa-external-link\" aria-hidden=\"true\">&nbsp;</i> <a href=\"http://olivercountynd.org\" target=\"_blank\">olivercountynd.org</a></p>        </div>        <div class=\"county_map\">            <img src=\"/image/cache/800px-Map_of_North_Dakota_highlighting_Oliver_County.svg.png\" alt=\"800px-Map_of_North_Dakota_highlighting_Oliver_County.svg.png Image\" />        </div>    </div>    <div class=\"conty_details\">        <div class=\"CD_table\">            <div class=\"CD_col\">                <div class=\"CD_row head\">County Commission Meets</div>                <div class=\"CD_row\">1st Thursday</div>            </div>            <div class=\"CD_col\">                <div class=\"CD_row head\">Official Newspaper</div>                <div class=\"CD_row\">Center Republican</div>            </div>            <div class=\"CD_col\">                <div class=\"CD_row head\">		<span id=\"population\"><label for=\"population_input\">Population:</label></span></div>                <div class=\"CD_row\">1,877</div>            </div>            <div class=\"CD_col\">                <div class=\"CD_row head\">		<span id=\"Square_Miles\"><label for=\"Square_Miles_input\">Square Miles:</label></span></div>                <div class=\"CD_row\">722.51</div>            </div>        </div>    </di