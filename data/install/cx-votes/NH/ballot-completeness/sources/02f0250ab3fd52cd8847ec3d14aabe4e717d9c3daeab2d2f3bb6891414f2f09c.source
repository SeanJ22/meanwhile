        <div class="perc-widget" >
<div>

<div class="rxbodyfield"><h2>Sample Ballots</h2></div></div>
</div>
        <div class="perc-widget" >

        
<div id="555712805_list" aria-label="File list" class=" perc-list-vertical perc-file-auto-list"   data-query="{ deliveryurl : 'https://www.dover.nh.gov'}">
<ul class=" perc-list-main"><li class="perc-list-odd perc-list-first   perc-list-element">
<a href="/Assets/government/open-government/election-information/2026-general-election/sample-ballots/DoverWard1.pdf" title="Ward 1" target="_self">Ward 1</a>
</li>
<li class="perc-list-even     perc-list-element">
<a href="/Assets/government/open-government/election-information/2026-general-election/sample-ballots/DoverWard2.pdf" title="Ward 2" target="_self">Ward 2</a>
</li>
<li class="perc-list-odd     perc-list-element">
<a href="/Assets/government/open-government/election-information/2026-general-election/sample-ballots/DoverWard3.pdf" title="Ward 3" target="_self">Ward 3</a>
</li>
