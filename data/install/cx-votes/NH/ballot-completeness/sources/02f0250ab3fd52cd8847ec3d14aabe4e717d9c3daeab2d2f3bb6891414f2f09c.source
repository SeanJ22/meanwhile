<script>
  var subNav = $('.leftNav .current > ul:last');
  $('.leftNav.perc-navbar').html(subNav);
  $('.leftNav.perc-navbar > ul').addClass('sf-menu sf-vertical perc-navbar-sfvertical');
</script> 
<script>
$(document).ready(function() { 
        $('ul.sf-menu').superfish({ 
            delay:       2000,                            // one second delay on mouseout 
            animation:   {opacity:'show',height:'show'},  // fade-in and slide-down animation 
            speed:       2000,                          // faster animation speed 
speedOut: 2000,
disableHI: false,
            autoArrows:  true,                           // disable generation of arrow mark-up 
            dropShadows: false                            // disable drop shadows 
        }); 
//This line removes display 3 levels deep on Navigation
		$( "ul li ul li ul li" ).css('display','none');
		$("ul li ul li a span").css('display','none');
    }); 
</script>

<script>
$(document).ready(function () {
function Currentdate(){
var dateToday = $.datepicker.formatDate('DD, M. dd, yy', new Date());

$('.day_date').text(dateToday);
}


var url = "https://api.openweathermap.org/data/2.5/weather?zip=03820,us&units=imperial&APPID=b74f2fd3819e3774491b9434bdcccab2";

$.ajax({
                                type : "GET",
                                dataType : "jsonp",
                                url : url,
                                success : function(weather){
                                temp =   weather.main.temp.toFixed(0);     
	                        desc = weather.weather[0].main;
				icon = weather.weather[0].icon;
				path = "http://openweathermap.org/img/w/" + icon + ".png";
					          $('.temp').text(temp);
						  $('.weather_description').text(desc);
						  $('.icon img').attr('src', path);
						
					    }
                                                
                                  
                                        });
				
		$(Currentdate);		
});
	
</script>

