  <article data-history-node-id="5251" about="/cityclerk/voting-information" typeof="schema:WebPage" class="page full clearfix">
  <div class="content">

    

          <div class="no-featured-links">
        <h1 class="page-header">
<span property="schema:name">Voting Information</span>
</h1>
        
            <div property="schema:text" class="field field--name-body field--type-text-with-summary field--label-hidden field--item"><div class="cop-embed-voting-info" style="color:#222;line-height:1.6;"><!-- Election date callout --><div style="background-color:#fdfcfb;border-bottom-color:#e3ddd5;border-bottom-width:1px;border-left-color:#632944;border-left-width:5px;border-right-color:#e3ddd5;border-right-width:1px;border-style:solid;border-top-color:#e3ddd5;border-top-width:1px;margin:0 0 20px;padding:18px 20px;"><h2 style="color:#000033;font-size:20px;margin:0 0 12px;">2026 Election</h2><div style="display:flex;flex-wrap:wrap;gap:16px;"><div style="flex:1 1 220px;"><div style="color:#632944;font-size:12px;letter-spacing:0.04em;margin:0 0 2px;text-transform:uppercase;"><strong>Primary</strong></div><div style="color:#000033;font-size:17px;"><p><strong>Tuesday, September 8</strong></p><p style="color:#555;font-size:13px;margin:0 0 14px;">Polling Hours: 8 am-7 pm</p><p style="color:#555;font-size:13px;margin:0 0 14px;">&nbsp;</p><h2 style="color:#000033;font-size:20px;margin:0 0 12px;">Notices</h2><ul><li data-list-item-id="eed1ae851c5d03d3d33cbb5df0b0154b6"><p style="color:#555;font-size:14px;margin:0 0 14px;"><a href="https://files.portsmouthnh.gov/cityclerk/voting/2026-Primary-Counting-of-Ballots-Notice.pdf">Counting of Ballots</a></p></li><li data-list-item-id="e37973146069957c2d5d65f8cc7d33b45"><p style="color:#555;font-size:14px;margin:0 0 14px;"><a href="https://files.portsmouthnh.gov/cityclerk/voting/2026-Primary-Testing-of-Ballot-Notice.pdf">Testing of Ballot Machines</a></p></li></ul></div></div><div style="flex:1 1 220px;"><div style="color:#632944;font-size:12px;letter-spacing:0.04em;margin:0 0 2px;text-transform:uppercase;"><strong>General Election</strong></div><div style="color:#000033;font-size:17px;"><p><strong>Tuesday, November 3</strong></p><p style="color:#555;font-size:13px;margin:0 0 14px;">Polling Hours: 8 am-7 pm</p><p style="color:#555;font-size:13px;margin:0 0 14px;">&nbsp;</p><h2 style="color:#000033;font-size:20px;margin:0 0 12px;">Notices</h2><ul style="color:#555;font-size:14px;margin:0 0 14px;"><li data-list-item-id="e0c847ad76c08d8eb98c359a88a5ad6de">Absentee ballot processing starts in each ward at 10:00 am</li><li data-list-item-id="e0030a23c952e0845abe6512c4e81bba0"><a href="https://files.portsmouthnh.gov/cityclerk/voting/2026NoticeforBallotCounting-10.26.26.pdf">Counting of Ballots</a> - Tuesday, October 27 at 4:30 pm in Conference Room A at City Hall.</li><li data-list-item-id="ebdd8b40c90bcc2c116ea9cf8235fab5c"><a href="https://files.portsmouthnh.gov/cityclerk/voting/2026-General-Testing-of-Ballot-Notice.pdf">Testing of Ballot Machines</a> - Saturday, October 24 at 2:30 pm Council Chambers at City Hall.&nbsp;</li></ul></div></div></div></div><!-- Jump navigation --><nav style="background-color:#f4ece6;border-radius:6px;margin:0 0 28px;padding:14px 16px;" aria-label="Section navigation"><div style="color:#632944;font-size:12px;letter-spacing:0.04em;margin:0 0 8px;text-transform:uppercase;"><strong>Jump to</strong></div><p><a style="background-color:#fff;border-radius:20px;border:1px solid #632944;color:#632944;display:inline-block;font-size:13px;margin:0 6px 6px 0;padding:5px 14px;text-decoration:none;" href="#sample-ballots">Sample Ballots</a> <a style="background-color:#fff;border-radius:20px;border:1px solid #632944;color:#632944;display:inline-block;font-size:13px;margin:0 6px 6px 0;padding:5px 14px;text-decoration:none;" href="#election-forms">Election Forms</a> <a style="background-color:#fff;border-radius:20px;border:1px solid #632944;color:#632944;display:inline-block;font-size:13px;margin:0 6px 6px 0;padding:5px 14px;text-decoration:none;" href="#same-day">Same-Day Registration</a> <a style="background-color:#fff;border-radius:20px;border:1px solid #632944;color:#632944;display:inline-block;font-size:13px;margin:0 6px 6px 0;padding:5px 14px;text-decoration:none;" href="#how-to-register">How to Register</a> <a style="background-color:#fff;border-radius:20px;border:1px solid #632944;color:#632944;display:inline-block;font-size:13px;margin:0 6px 6px 0;padding:5px 14px;text-decoration:none;" href="#which-ward">Which Ward Am I In?</a> <a style="background-color:#fff;border-radius:20px;border:1px solid #632944;color:#632944;display:inline-block;font-size:13px;margin:0 6px 6px 0;padding:5px 14px;text-decoration:none;" href="#locations">Voting Locations</a> <a style="background-color:#fff;border-radius:20px;border:1px solid #632944;color:#632944;display:inline-block;font-size:13px;margin:0 6px 6px 0;padding:5px 14px;text-decoration:none;" href="#registrars">Board of Registrars</a> <a style="background-color:#fff;border-radius:20px;border:1px solid #632944;color:#632944;display:inline-block;font-size:13px;margin:0 6px 6px 0;padding:5px 14px;text-decoration:none;" href="#districts">State Districts</a></p></nav><!-- Sample Ballots --><div style="margin:0 0 32px;scroll-margin-top:100px;" id="sample-ballots"><h2 style="color:#000033;font-size:20px;margin:0 0 4px;">Sample Ballots</h2><p style="color:#555;font-size:13px;margin:0 0 14px;">(All wards are in each file)</p><div style="display:flex;flex-wrap:wrap;gap:14px;"><a style="align-items:center;background-color:#fff;border-radius:0;border:1px solid #e3ddd5;display:flex;flex:1 1 220px;gap:12px;min-width:220px;padding:16px;text-decoration:none;" href="https://files.portsmouthnh.gov/cityclerk/voting/2026-General-Election-Sample-Ballots.pdf"><span style="align-items:center;background-color:#CD7028;border-radius:6px;color:#fff;display:inline-flex;font-size:11px;height:38px;justify-content:center;letter-spacing:0.03em;min-width:38px;width:38px;"><strong>PDF</strong></span> <span style="color:#632944;font-size:15px;"><strong>2026 General Election Sample Ballots</strong></span>&nbsp;</a></div></div><!-- Other Election Forms --><div style="margin:0 0 32px;scroll-margin-top:100px;" id="election-forms"><h2 style="color:#000033;font-size:20px;margin:0 0 14px;">Election Forms</h2><div style="display:flex;flex-wrap:wrap;gap:14px;"><a style="align-items:center;background-color:#fff;border-radius:0;border:1px solid #e3ddd5;display:flex;flex:1 1 260px;gap:12px;min-width:220px;padding:16px;text-decoration:none;" href="https://files.portsmouthnh.gov/cityclerk/2026-Absentee-Ballot-Request-Form.pdf"><span style="align-items:center;background-color:#CD7028;border-radius:6px;color:#fff;display:inline-flex;font-size:11px;height:38px;justify-content:center;letter-spacing:0.03em;min-width:38px;width:38px;"><strong>PDF</strong></span> <span style="color:#632944;font-size:15px;"><strong>2026 Absentee Ballot Application</strong></span> </a><a style="align-items:center;background-color:#fff;border-radius:0;border:1px solid #e3ddd5;display:flex;flex:1 1 260px;gap:12px;min-width:220px;padding:16px;text-decoration:none;" href="https://files.portsmouthnh.gov/cityclerk/voting/2026-General-Election-Worker-Interest-Form_web_fillable.pdf"><span style="align-items:center;background-color:#CD7028;border-radius:6px;color:#fff;display:inline-flex;font-size:11px;height:38px;justify-content:center;letter-spacing:0.03em;min-width:38px;width:38px;"><strong>PDF</strong></span> <span style="color:#632944;font-size:15px;"><strong>Election Worker Interest Form</strong></span>&nbsp;</a></div></div><!-- Same Day Voter Registration --><div style="background-color:#fdfcfb;border-bottom-color:#e3ddd5;border-bottom-width:1px;border-left-color:#B3CCE6;border-left-width:5px;border-right-color:#e3ddd5;border-right-width:1px;border-style:solid;border-top-color:#e3ddd5;border-top-width:1px;margin:0 0 32px;padding:16px 18px;scroll-margin-top:100px;" id="same-day"><h2 style="color:#000033;font-size:20px;margin:0 0 8px;">Same Day Voter Registration</h2><p style="color:#333;font-size:15px;margin:0;">New voters may register to vote on Election Day at their designated polling location.</p></div><!-- How and Where to Register to Vote --><div style="margin:0 0 32px;scroll-margin-top:100px;" id="how-to-register"><h2 style="color:#000033;font-size:20px;margin:0 0 12px;">How and Where to Register to Vote</h2><p style="color:#333;font-size:15px;margin:0 0 10px;"><strong>October 22, 2026 was the last day for Portsmouth residents to register to vote prior to the general election.</strong>&nbsp;</p><p style="color:#333;font-size:15px;margin:0 0 10px;">You can register to vote in local, state, and federal elections in New Hampshire if you are:</p><ul style="color:#333;font-size:15px;margin:0 0 14px;padding-left:22px;"><li style="margin-bottom:8px;" data-list-item-id="e3ba2c7456bf5ea62a3ac42f5a9f75305">A United States citizen</li><li style="margin-bottom:8px;" data-list-item-id="e02f1577363213a6d53b4e5057ea242fd">At least 18 years old on election day</li><li style="margin-bottom:8px;" data-list-item-id="e57a1209d7dda8b71e32160609a228dc9">A resident in the town/city ward you seek to register in. There is no minimum period you are required to have lived in your community before registering</li></ul><p style="color:#333;font-size:15px;">To register to vote, you will be required to complete a Voter Registration Form provided by the Clerk's office or supervisor of the checklist. You will also need to provide proof of your identity, age, U.S. citizenship and domicile (primary residence address). For information on requirements and acceptable documents, see the NH Secretary of State's <a style="color:#632944;" href="https://www.sos.nh.gov/elections/voters">voter webpage</a>.</p></div><!-- Am I Registered? --><h2 style="color:#000033;font-size:20px;margin:0 0 12px;">Am I Registered?</h2><p style="color:#333;font-size:15px;margin:0 0 14px;">Visit the Secretary of State's <a href="https://app.sos.nh.gov/viphome">Voter Information Lookup</a> page.</p><!-- Which Ward Do I Live In? --><div style="margin:0 0 32px;scroll-margin-top:100px;" id="which-ward"><h2 style="color:#000033;font-size:20px;margin:0 0 12px;">Which Ward Do I Live In?</h2><p style="color:#333;font-size:15px;margin:0 0 14px;">Please be sure that your address is accurately listed on the checklist to avoid any issues on Election Day. Remember, you must vote in the ward where you reside.</p><div style="display:flex;flex-wrap:wrap;gap:14px;margin:0 0 18px;"><a style="align-items:center;background-color:#fff;border-radius:0;border:1px solid #e3ddd5;display:flex;flex:1 1 220px;gap:12px;min-width:220px;padding:16px;text-decoration:none;" href="https://files.portsmouthnh.gov/cityclerk/voting/Ward-by-Street-List-10.06.2026.pdf"><span style="align-items:center;background-color:#CD7028;border-radius:6px;color:#fff;display:inline-flex;font-size:11px;height:38px;justify-content:center;letter-spacing:0.03em;min-width:38px;width:38px;"><strong>PDF</strong></span> <span style="color:#632944;font-size:15px;"><strong>Street List by Ward</strong></span> </a><a style="align-items:center;background-color:#fff;border-radius:0;border:1px solid #e3ddd5;display:flex;flex:1 1 220px;gap:12px;min-width:220px;padding:16px;text-decoration:none;" href="https://files.portsmouthnh.gov/cityclerk/voting/2026+VotingWards_34x44.pdf"><span style="align-items:center;background-color:#CD7028;border-radius:6px;color:#fff;display:inline-flex;font-size:11px;height:38px;justify-content:center;letter-spacing:0.03em;min-width:38px;width:38px;"><strong>PDF</strong></span> <span style="color:#632944;font-size:15px;"><strong>Voting Ward Map</strong></span> </a><a style="align-items:center;background-color:#fff;border-radius:0;border:1px solid #e3ddd5;display:flex;flex:1 1 220px;gap:12px;min-width:220px;padding:16px;text-decoration:none;" href="https://files.portsmouthnh.gov/cityclerk/voting/2026_List_of_Ward_Officials.pdf"><span style="align-items:center;background-color:#CD7028;border-radius:6px;color:#fff;display:inline-flex;font-size:11px;height:38px;justify-content:center;letter-spacing:0.03em;min-width:38px;width:38px;"><strong>PDF</strong></span> <span style="color:#632944;font-size:15px;"><strong>List of Elected Ward Officials</strong></span>&nbsp;</a></div><div style="background-color:#fdfcfb;border-bottom-color:#e3ddd5;border-bottom-width:1px;border-left-color:#632944;border-left-width:5px;border-right-color:#e3ddd5;border-right-width:1px;border-style:solid;border-top-color:#e3ddd5;border-top-width:1px;padding:14px 18px;"><p style="color:#333;font-size:15px;margin:0;"><strong>Questions?</strong> Please contact the City Clerk's Office at <a style="color:#632944;" href="tel:(603) 610-7245">(603) 610-7245</a> or via e-mail at <a style="color:#632944;" href="mailto:cityclerk@portsmouthnh.gov">cityclerk@portsmouthnh.gov</a>.</p></div></div><!-- Voting Locations --><div style="margin:0 0 32px;scroll-margin-top:100px;" id="locations"><h2 style="color:#000033;font-size:20px;margin:0 0 14px;">Voting Locations by Ward</h2><div style="display:flex;flex-wrap:wrap;gap:14px;"><div style="background-color:#fff;border:1px solid #e3ddd5;flex:1 1 260px;min-width:240px;padding:16px 18px;"><div style="align-items:center;display:flex;gap:12px;margin-bottom:8px;"><span style="align-items:center;background-color:#632944;border-radius:50%;color:#fff;display:inline-flex;font-size:14px;height:32px;justify-content:center;min-width:32px;width:32px;"><strong>1</strong></span> <span style="color:#000033;font-size:16px;"><strong>New Franklin School</strong></span></div><p style="color:#333;font-size:14px;margin:0 0 4px;">1 Franklin Drive</p><p style="color:#666;font-size:13px;margin:0;"><em>Off Woodbury Avenue, between Anchorage Inn and Howard Johnson Hotel</em></p></div><div style="background-color:#fff;border:1px solid #e3ddd5;flex:1 1 260px;min-width:240px;padding:16px 18px;"><div style="align-items:center;display:flex;gap:12px;margin-bottom:8px;"><span style="align-items:center;background-color:#632944;border-radius:50%;color:#fff;display:inline-flex;font-size:14px;height:32px;justify-content:center;min-width:32px;width:32px;"><strong>2</strong></span> <span style="color:#000033;font-size:16px;"><strong>Portsmouth Middle School</strong></span></div><p style="color:#333;font-size:14px;margin:0 0 4px;">155 Parrott Avenue</p><p style="color:#666;font-size:13px;margin:0;">Connie Bean Gymnasium Entrance&nbsp;</p></div><div style="background-color:#fff;border:1px solid #e3ddd5;flex:1 1 260px;min-width:240px;padding:16px 18px;"><div style="align-items:center;display:flex;gap:12px;margin-bottom:8px;"><span style="align-items:center;background-color:#632944;border-radius:50%;color:#fff;display:inline-flex;font-size:14px;height:32px;justify-content:center;min-width:32px;width:32px;"><strong>3</strong></span> <span style="color:#000033;font-size:16px;"><strong>Portsmouth Senior Activity Center</strong></span></div><p style="color:#333;font-size:14px;margin:0;">125 Cottage Street</p></div><div style="background-color:#fff;border:1px solid #e3ddd5;flex:1 1 260px;min-width:240px;padding:16px 18px;"><div style="align-items:center;display:flex;gap:12px;margin-bottom:8px;"><span style="align-items:center;background-color:#632944;border-radius:50%;color:#fff;display:inline-flex;font-size:14px;height:32px;justify-content:center;min-width:32px;width:32px;"><strong>4</strong></span> <span style="color:#000033;font-size:16px;"><strong>Portsmouth High School</strong></span></div><p style="color:#333;font-size:14px;margin:0;">50 Andrew Jarvis Drive</p></div><div style="background-color:#fff;border:1px solid #e3ddd5;flex:1 1 260px;min-width:240px;padding:16px 18px;"><div style="align-items:center;display:flex;gap:12px;margin-bottom:8px;"><span style="align-items:center;background-color:#632944;border-radius:50%;color:#fff;display:inline-flex;font-size:14px;height:32px;justify-content:center;min-width:32px;width:32px;"><strong>5</strong></span> <span style="color:#000033;font-size:16px;"><strong>Little Harbour School</strong></span></div><p style="color:#333;font-size:14px;margin:0 0 4px;">50 Clough Drive</p><p style="color:#666;font-size:13px;margin:0;"><em>Off of South Street</em></p></div></div></div><!-- Board of Registrars --><div style="margin:0 0 32px;scroll-margin-top:100px;" id="registrars"><h2 style="color:#000033;font-size:20px;margin:0 0 14px;">Board of Registrars</h2><div style="border:1px solid #e3ddd5;overflow-x:auto;"><table class="table" style="border-collapse:collapse;font-size:14px;min-width:520px;width:100%;"><thead><tr style="background-color:#632944;"><th style="color:#fff;padding:10px 14px;"><strong>Role</strong></th><th style="color:#fff;padding:10px 14px;">Ward</th><th style="color:#fff;padding:10px 14px;"><strong>Name</strong></th><th style="color:#fff;padding:10px 14px;"><strong>Email</strong></th></tr></thead><tbody><tr style="background-color:#fdfcfb;"><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Registrar - Chair</td><td>At-Large</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Barbara Ward</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">16bward1224@gmail.com</td></tr><tr style="background-color:#fff;"><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Registrar</td><td>1</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Penny Reynolds</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">preynolds21@comcast.net</td></tr><tr style="background-color:#fdfcfb;"><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Ward Two</td><td>2</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Candace Thayer</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">cshawt@hotmail.com</td></tr><tr style="background-color:#fff;"><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Ward Three</td><td>3</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Angelynne Hinson</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">e.hinson@comcast.net</td></tr><tr style="background-color:#fdfcfb;"><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Ward Four</td><td>4</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Marcia Main</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">marciamain0924@gmail.com</td></tr><tr style="background-color:#fff;"><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Ward Five</td><td>5</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Kathleen Boduch</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">kmboduch@portsmouthnh.gov</td></tr><tr style="background-color:#fdfcfb;"><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Registrar Assistant</td><td>4</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">Arthur Parrott</td><td style="border-top:1px solid #e3ddd5;color:#333;padding:10px 14px;">akparrott@comcast.net</td></tr></tbody></table><p>&nbsp;Registrars Office Number 603-610-7208<br>&nbsp;See a list of all <a href="/cityclerk/elected-city-officials#election-officials">Election Officials</a></p></div></div><!-- State Senate and State Representative Districts --><div style="margin:0;scroll-margin-top:100px;" id="districts"><h2 style="color:#000033;font-size:20px;margin:0 0 14px;">State Senate and State Representative Districts</h2><div style="background-color:#fdfcfb;border:1px solid #e3ddd5;margin:0 0 14px;padding:16px 18px;"><h3 style="color:#632944;font-size:16px;margin:0 0 10px;">State Senate District — effective June 1, 2022</h3><ul style="color:#333;font-size:14px;margin:0;padding-left:22px;"><li data-list-item-id="e7b420627f9b61b317dc47102e42ef2ca">District 21: New Castle, Newfields, Newington, Newmarket, and Portsmouth</li></ul></div><div style="background-color:#fdfcfb;border:1px solid #e3ddd5;margin:0 0 14px;padding:16px 18px;"><h3 style="color:#632944;font-size:16px;margin:0 0 10px;">State Representative Districts — effective June 1, 2022</h3><ul style="color:#333;font-size:14px;margin:0;padding-left:22px;"><li style="margin-bottom:6px;" data-list-item-id="eda9deb6a385ebdcaeea4a8e9f7567147">District 21 - Consists of Portsmouth Ward 1 and Newington only</li><li style="margin-bottom:6px;" data-list-item-id="e0934a98ab2bf3579ffd5665fdb382e11">District 22 - Consists of Portsmouth Ward 5 and New Castle only</li><li style="margin-bottom:6px;" data-list-item-id="e2566f1535b9d14ab36c6cc7dfbf61306">District 26 - Consists of Portsmouth Ward 3 only</li><li style="margin-bottom:6px;" data-list-item-id="e948271995675620e0e37bc54dc49aaf6">District 27 - Consists of Portsmouth Ward 4 only</li><li style="margin-bottom:6px;" data-list-item-id="e448c1ce78ea97a14cce6d030f102c7ac">District 28 - Consists of Portsmouth Ward 2 only</li><li style="margin-bottom:6px;" data-list-item-id="e9bfa16d90fa62c3f248caf61ab3f9de6">District 37 - Consists of Portsmouth Wards 1 and 5, New Castle and Newington</li><li data-list-item-id="e653e2b1f115386dd8e9995727e870c59">District 39 - Floterial with Portsmouth Wards 2, 3 and 4</li></ul></div><!-- 
                                                                                                                                                        
                                                                                                                                                
                                                                                                                                        
                                                                                                                                
                                                                                                                        
                                                                                                                
                                                                                                        
                                                                                                
                                                                                        
                                                                                
                                                                        
                                                                
                                                        
                                                
                                        
                                
                        
                
        <p style="color:#333;font-size:14px;margin:0;">
