<script type="text/javascript">
    $(window).on('load', function () {

        $('[data-accordion-menu]>li').off('keydown');
        $('[data-accordion-menu]>li li').off('keydown');

        $('.nested a').filter(function () {

            return this.href == location.href
        }).parent().addClass('active').siblings().removeClass('active');

        $('.nested a').click(function () {

            $(this).parent().addClass('active').siblings().removeClass('active')
        });

        $('#idavotertag').click(function () {
            $("#idBeaVoter").removeClass("subHeader");
            $("#idWaystoVote").removeClass("subHeader");
        });

        $('#idaDataInformationtag').click(function () {

            $("#idDataInformation").removeClass("subHeader");
        });

        $('#idaElectionstag').click(function () {

            $("#idElectionsWork").removeClass("subHeader");
        });

        $('#idaCandidatetag').click(function () {

            $("#idBeaCandidate").removeClass("subHeader");

        });

});
</script>

<style>
    .subHeader {
        display: block !important;
    }
