<script>
    function LanguageChange(Obj) {
        var CurrentWindowLocation = window.location;
        //loginurl moved from constants to we.config 10/17/22
        var loginURLVal = 'https://vote.sos.ri.gov/';

        if (CurrentWindowLocation == loginURLVal) {
            CurrentWindowLocation = loginURLVal + "Home/IndexSpanish";
        }
        else {
            window.location = loginURLVal;
        }

        if (Obj == "English") {
            if ((CurrentWindowLocation.toString().indexOf("/VoterSpanish/") != -1)) {
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/VoterSpanish/", "/Voter/");
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/CandidatesSpanish/", "/Candidates/");
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/DataInformationSpanish/", "/DataInformation/");
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/ElectionsSpanish/", "/Elections/");
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/VoterRegistrationSpanish/", "/VoterRegistration/");
                window.location = CurrentWindowLocation;
            }
        }
        else if (Obj == "Spanish") {
            if ((CurrentWindowLocation.toString().indexOf("/VoterSpanish/") == -1)) {
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/Voter/", "/VoterSpanish/");
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/Candidates/", "/CandidatesSpanish/");
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/DataInformation/", "/DataInformationSpanish/");
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/Elections/", "/ElectionsSpanish/");
                CurrentWindowLocation = CurrentWindowLocation.toString().replace("/VoterRegistration/", "/VoterRegistrationSpanish/");
                window.location = CurrentWindowLocation;
            }
        }
    }
</script>
