<form action="/Home/GeneralVoterInformation" method="post">    <div class="row">
        <h1>General Voter Information</h1>
    </div>
    <div class="row">
        <div class="medium-4 columns">
            <h2>Welcome back!</h2>
            <div class="callout warning text-center">
                            <label id="recentElection">The next election is: 11/03/2026</label>
                            <label id="recentSampleBallot">
                                <a target='_self' href=https://risos-legacy-files-public.s3.amazonaws.com/documents/elections/ballots/2026/11/03/3102.pdf><u>View Sample Ballot</u></a>
                            </label>
            </div>
            <p>
                
                If you have any questions or concerns feel free to contact your Local Board of Canvassers or the Board of Elections.<br /><br />
                For Early Voting locations click <a href="https://vote.sos.ri.gov/Elections/PollingPlaceHours"> here.</a>
            </p>
        </div>
        <div class="medium-5 columns">
            <h2>Your Upcoming Elections</h2>
            <div class="row">
                <div class="small-12 columns">
                    <div class="v-align-block election-block">
                                <a href='http://maps.google.com/maps?q="+200 OLD COUNTY RD, SMITHFIELD, RI 02917+"' target='sospollingplace' title="View polling place on Google Maps.">
                                    <span class="fa-stack fa-2x v-align-image">
                                        <span class="fa fa-circle-thin fa-stack-2x"></span>
                                        <span class="fa fa-map-marker fa-stack-1x"></span>
                                    </span>
                                </a>
                                <div class="v-align-text">
                                    <ul>
                                        
                                        <li class="v-align-text-line notranslate"><strong>STATEWIDE GENERAL ELECTION</strong></li>
                                        <li class="v-align-text-line notranslate"><strong>11/03/2026</strong></li>

                                                <li class="v-align-text-line notranslate"><a target='_self' href=https://risos-legacy-files-public.s3.amazonaws.com/documents/elections/ballots/2026/11/03/3102.pdf><u>View Sample Ballot</u></a></li>
                                            <li class="v-align-text-line">
                                                <strong>
                                                    Assigned Polling Place: (Polling Places
                                                    are subject to change. Please check back closer to election day)
                                                </strong>
                                            </li>
                                            <li class="v-align-text-line notranslate">
                                            <a href='http://maps.google.com/maps?q="+200 OLD COUNTY RD, SMITHFIELD, RI 02917+"' target='sospollingplace' title="View polling place on Google Maps.">
                                                
                                                OLD COUNTY ROAD ELEMENTARY SCHOOL
                                                <br />
                                                200 OLD COUNTY RD, SMITHFIELD, RI 02917
                                            </a>
                                            </li>
                                    </ul>
                                </div>
                                <br />
                    </div>
                </div>
            </div>
        </div>
        <div class="medium-3 columns">
            <h2>Your District</h2>
            <ul>
                

                    <li><strong>PRECINCT: </strong>3102</li>
                                    <li><strong>STATE REP: </strong>44</li>
                                    <li><strong>STATE SENATE: </strong>22</li>
                                                    <li><strong>CONGRESSIONAL: </strong>1</li>

                                
            </ul>
        </div>
    </div>
