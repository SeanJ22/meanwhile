<script type="text/javascript" src="/media/site-assets/js/sortable.min.js"></script>
<script>
var eTable = document.getElementsByTagName('table');
var cols;
var firstRowTds;
var firstRowThs;
var thsContent;
var trs;
var tds;
var j, n, x, y, z;
var tLabel;
var tHead;
var thText;
var newThText;

//remove colgroup
for (i = 0; i < eTable.length; i++) { 
  cols = eTable.item(i).getElementsByTagName('colgroup');
  for (j = 0; j < cols.length; j++) {
    //remove colgroup tags
    cols.item(j).remove();
  }
  //remove existing table classes and add correct ones
  eTable.item(i).removeAttribute('class');
  eTable.item(i).classList.add('table', 'table-bordered', 'unstriped', 'responsive-card-table', 'sortable');

  //remove internal classes
  trs = eTable.item(i).getElementsByTagName('tr');
 // console.log (trs.length + ' is number of table rows');
  for (z = 0; z < trs.length; z++) {
    trs.item(z).removeAttribute('class');
    tds = trs.item(z).getElementsByTagName('td');
    tds.item(0).setAttribute('scope','row');
    for (y = 0; y < tds.length; y++) {
      tds.item(y).removeAttribute('class'); 
    }
    tds = eTable.item(i).getElementsByTagName('td');
    for (x = 0; x <tds.length; x++) {
      tds.item(x).removeAttribute('class');
    }
  }
  tHead = document.createElement('thead');
  // first row already includes th tags
  firstRowThs = trs.item(0).getElementsByTagName('th');
  if (firstRowThs.length > 0) {
    for (x = 0; x < firstRowThs.length; x++) {
      firstRowThs.item(x).setAttribute ('scope', 'col');
      firstRowThs.item(x).setAttribute ('data-sort-type', 'string');
    }
  } else {
      // if first row has no th, add scope to first row tds and change to th
    firstRowTds = trs.item(0).getElementsByTagName('td');
    var headerRow = document.createElement('tr');
    var headerCell;
    eTable.item(i).appendChild(tHead);
    for (x = 0; x < firstRowTds.length; x++) {
      headerCell = document.createElement('th');
      headerCell.textContent = firstRowTds.item(x).innerHTML;
      headerRow.appendChild(headerCell);
    }
    eTable.item(i).deleteRow(0);
    eTable.item(i).getElementsByTagName('thead')[0].appendChild(headerRow);   
  }
  firstRowThs = eTable.item(i).getElementsByTagName('th');
  for (x = 0; x <firstRowThs.length; x++) {
    firstRowThs.item(x).setAttribute('scope','col');
    firstRowThs.item(x).setAttribute('data-sort-type','string');
    thText = firstRowThs.item(x).textContent;
    // console.log(thText);
   newThText = thText.split('Election Name').join('');
   newThText = newThText.split('Election Type').join('');
   newThText = newThText.split('Election District').join('');
   newThText = newThText.split('Election Date').join('');
   newThText = newThText.split('Polling Location Name').join('');
   newThText = newThText.split('Polling Location Locality Name').join('');
   newThText = newThText.split('Polling Location Address Line 1').join('');
   newThText = newThText.split('Polling Location Address Line 2').join('');
   newThText = newThText.split('Polling Location City').join('');
   newThText = newThText.split('Polling Location Precinct Name').join('');
   newThText = newThText.split('Polling Location State').join('');   
   newThText = newThText.split('Polling Location Voting Room').join('');
   newThText = newThText.split('Polling Location Zip').join('');
   newThText = newThText.split('SEN').join('');
   newThText = newThText.split('Town').join('');
   newThText = newThText.split('Super').join('');
   newThText = newThText.split('Locality Name').join('');     
                                     

   firstRowThs.item(x).textContent = newThText;
  }       
  console.log('number of th cells = ' + firstRowThs.length);
  console.log('nomber of trs = ' + trs.length);
  for (x = 0; x < trs.length; x++) {
    // add scope = row to first td element in row 2 and later
    // add data-label attributes to td with matching header value
    //replace empty cells with dashes
    tds = trs.item(x).getElementsByTagName('td');
    //tds.item(0).setAttribute('scope','row');
    for (n = 0; n < tds.length; n++) {
      tLabel = (firstRowThs.item(n).innerHTML);
      console.log('Header label: ' +tLabel);
      tds.item(n).setAttribute('data-label', tLabel);
      if ((tds.item(n).textContent == '') || (tds.item(n).textContent == null) || (tds.item(n).textContent == ' ') ) {
        tds.item(n).textContent = '-';
      }
    }
  }  
}
    (function() {
  'use strict';

  var TableFilter = (function() {
    var Arr = Array.prototype;
    var input;

    function onInputEvent(e) {
      input = e.target;
      var table1 = document.getElementsByClassName(input.getAttribute('data-table'));
      Arr.forEach.call(table1, function(table) {
        Arr.forEach.call(table.tBodies, function(tbody) {
          Arr.forEach.call(tbody.rows, filter);
        });
      });
    }

    function filter(row) {
      var text = row.textContent.toLowerCase();
      var val = input.value.toLowerCase();
      row.style.display = text.indexOf(val) === -1 ? 'none' : 'table-row';
    }

    return {
      init: function() {
        var inputs = document.getElementsByClassName('table-filter');
        Arr.forEach.call(inputs, function(input) {
          input.oninput = onInputEvent;
        });
      }
    };

  })();

 TableFilter.init();
})();
</script>

</body>
</html>



