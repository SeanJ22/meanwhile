6/bsuvtorg/zs4uii6xvyne5lkifjqh/Quarry-2024.jpg%22,%22width%22:800},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_4/v1726256986/bsuvtorg/zs4uii6xvyne5lkifjqh/Quarry-2024.jpg%22,%22width%22:1200},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_5/v1726256986/bsuvtorg/zs4uii6xvyne5lkifjqh/Quarry-2024.jpg%22,%22width%22:1600},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto/v1726256986/bsuvtorg/zs4uii6xvyne5lkifjqh/Quarry-2024.jpg%22,%22width%22:2031}]" data-permitted-user="true" data-resource-title="Quarry-2024.jpg" data-resource-uuid="21582c0a-dc84-47f4-9c29-2d4ae46feede"></picture></figure></article><article class="fsResource fsStyleAutoclear fsResourceTypeImage"><figure><picture><img alt="Sunrise over Spruce Mountain" data-aspect-ratio="0.75" data-image-sizes="[{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_1/v1749238627/bsuvtorg/cn9p1orvzpriwb8u7fsl/BarreSunrise.jpg%22,%22width%22:256},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_2/v1749238627/bsuvtorg/cn9p1orvzpriwb8u7fsl/BarreSunrise.jpg%22,%22width%22:512},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_3/v1749238627/bsuvtorg/cn9p1orvzpriwb8u7fsl/BarreSunrise.jpg%22,%22width%22:800},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_4/v1749238627/bsuvtorg/cn9p1orvzpriwb8u7fsl/BarreSunrise.jpg%22,%22width%22:1200},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_5/v1749238627/bsuvtorg/cn9p1orvzpriwb8u7fsl/BarreSunrise.jpg%22,%22width%22:1600},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_6/v1749238627/bsuvtorg/cn9p1orvzpriwb8u7fsl/BarreSunrise.jpg%22,%22width%22:2200}]" data-permitted-user="true" data-resource-title="BarreSunrise.jpg" data-resource-uuid="fe4638af-d054-4b16-b0d0-66fdf0631e25"></picture></figure></article></div><button aria-l