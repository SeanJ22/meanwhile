							<h1 class="fsPageTitle">Budget</h1>




							<div class="fsPageLayout fsLayout fsOneColumnLayout fsStyleAutoclear" id="fsEl_8996" data-use-new="true" >

				<div class=" fsDiv fsStyleAutoclear" id="fsEl_8997"  >

				<div class="fsElement fsPanelGroup fsAccordion fsPanelIconAfter" id="fsEl_18425" data-use-new="true" >

				<div class="fsElementContent" >
		    <ul class="fsTabsNav" role="tablist">
        
            <li id="fsTab-18426" class="fsTabsNavItem " role="presentation">
                <a role='tab' aria-selected='false' href='#fs-panel-18426' aria-controls='fsEl_18426'>FY27 Budget Vote & Tax Resources</a>
                
            </li>

    </ul>

    	<section class="fsElement fsPanel fsStateOpen fsStyleAutoclear" id="fsEl_18426" data-use-new="true" role="tabpanel" >

				<header>
				<h2 class="fsElementTitle" id="fsElementTitle_18426"><a role='button' aria-controls='fsPanelContent_18426' aria-expanded='false' href='#fs-panel-18426'>FY27 Budget Vote & Tax Resources</a></h2>
	</header>
	<div class="fsElementContent" aria-hidden="true">
		<a id="fs-panel-18426"></a>
	<div class="fsElement fsLayout fsTwoColumnLayout fsStyleAutoclear" id="fsEl_18427" data-use-new="true" >

						<div class=" fsDiv fsStyleColumn fsStyleColumn-1 fsStyleAutoclear" id="fsEl_18428"  >

				<section class="fsElement fsContent" id="fsEl_18429" data-use-new="true" >

				<header>
				<h2 class="fsElementTitle" id="fsElementTitle_18429">Budget</h2>
	</header>
	<div class="fsElementContent" >
			<ul>
	<li><a href="https://youtu.be/5W4yK0ciWCU" target="_blank"><strong>FY27 Budget Informational Meeting (10/27/2026)</strong></a></li>
	<li><a data-file-name="FY27ProposedBudgetVote4Slides.pdf" data-resource-uuid="80176672-3379-4dd9-9bd6-95fa5dcc4196" href="/fs/resource-manager/view/80176672-3379-4dd9-9bd6-95fa5dcc4196" target="_blank"><strong>FY27 Budget Presentation (10/27/2026)</strong></a></li>
	<li><strong><a data-file-name="FinalWarningBUUSDBudgetRevote4SIGNED.pdf" data-resource-uuid="e1355c3f-216e-4004-8600-2b092e5cf790" href="/fs/resource-manager/view/e1355c3f-216e-4004-8600-2b092e5cf790" target="_blank">FY27 Approved Revote Budget Warning - November 3, 2026</a></strong></li>
	<li><strong><a data-file-name="FY26RevenueandExpenses-Draft1.pdf" data-resource-uuid="f6b6caa1-494a-4b8d-a2b0-be3a253e4efa" href="/fs/resource-manager/view/f6b6caa1-494a-4b8d-a2b0-be3a253e4efa" target="_blank">FY26 Revenue &amp; Expenses - Draft</a></strong></li>
	<li><strong><a data-file-name="AOEMemo_WhatHappensWhenaSchoolBudgetDoesntPassFall2026.pdf" data-resource-uuid="3b7b94f6-2b07-4b1f-a6ac-1f6982064bed" href="/fs/resource-manager/view/3b7b94f6-2b07-4b1f-a6ac-1f6982064bed" target="_blank">What Happens When a School Budget Doesn&#39;t Pass?<br />
	Memo from the Agency of Education</a></strong></li>
	<li><a href="https://youtu.be/NkXRx7Jcth0" target="_blank"><b>FY27 Budget Informational Meeting (9/8/26)</b></a></li>
	<li><a data-file-name="FY27ProposedBudgetSlides.pdf" data-resource-uuid="8240f60f-4edf-452f-8147-38837f350533" href="/fs/resource-manager/view/8240f60f-4edf-452f-8147-38837f350533" target="_blank"><b>FY27 Budget Presentation (9/8/26)</b></a></li>
	<li><a data-file-name="FY27RevotePostcard4.pdf" data-resource-uuid="a007e2cd-904f-400a-85f9-fa56d65a7e57" href="/fs/resource-manager/view/a007e2cd-904f-400a-85f9-fa56d65a7e57" target="_blank" title="FY27 Revote Budget Postcard (September 15)"><b>FY27 Revote Budget (September&nbsp;2026) Postcard</b></a></li>
	<li><a data-file-name="FY27ApprovedWarningRevote-September152026.pdf" data-resource-uuid="eb295117-d1da-4231-a005-ce46b220b34b" href="/fs/resource-manager/view/eb295117-d1da-4231-a005-ce46b220b34b" target="_blank"><b>FY27 Approved Revote Budget Warning - September 15, 2026</b></a></li>
	<li><a data-file-name="RevoteBudgetPostcard.pdf" data-resource-uuid="78b8a89c-cc7c-4b98-a1d8-74ce051c2be0" href="/fs/resource-manager/view/78b8a89c-cc7c-4b98-a1d8-74ce051c2be0" target="_blank"><b>FY27 Revote Budget Postcard</b></a></li>
