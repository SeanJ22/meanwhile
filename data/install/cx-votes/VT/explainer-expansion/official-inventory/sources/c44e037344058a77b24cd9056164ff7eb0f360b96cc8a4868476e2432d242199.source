epd":null,"send":null,"ctyn":null,"distReported":"0/1","townsReported":null,"distCode":"","io":false,"rc":[{"cid":226154,"cn":"DARLENE F COOK","vc":0,"isWriteIn":false,"isWinner":false,"pn":"INDEPENDENT","pco":"ccc1d9"},{"cid":226155,"cn":"JENNIFER SHATNEY","vc":0,"isWriteIn":false,"isWinner":false,"pn":"INDEPENDENT","pco":"ccc1d9"},{"cid":226156,"cn":"REBECCA WURDAK","vc":0,"isWriteIn":false,"isWinner":false,"pn":"DEMOCRATIC","pco":"007ABC"}],"wc":[{"cid":0,"cn":"OTHER WRITE-IN","vc":0,"isWriteIn":false,"isWinner":false,"pn":null,"pco":null}]}],"cd":[{"tn":"WEST FAIRLEE","repd":null,"send":null,"vc1":0,"vc2":0,"vc3":0,"ovc":0}],"bqcd":[]},{"tid":37,"tn":"BRADFORD","ldid":0,"ld":null,"oid":17,"on":"JUSTICE OF THE PEACE - 2 YEARS","vf":10,"otc":"L","cid1":212495,"cn1":"LAWRENCE COFFIN","cid2":212475,"cn2":"NICHOLAS DILORENZO","cid3":212502,"cn3":"JOSHUA GRAVLIN","bq":null,"cs":[{"tid":37,"ctyId":0,"oid":0,"sc":0,"sv":0,"bv":0,"vf":10,"tn":"BRADFORD","repd":null,"send":null,"ctyn":null,"distReported":"0/1","townsReported":null,"distCode":"","io":false,"rc":[{"cid":212495,"cn":"LAWRENCE COFFIN","vc":0,"isWriteIn":false,"isWinner":false,"pn":"DEMOCRATIC","pco":"007ABC"},{"cid":212475,"cn":"NICHOLAS DILORENZO","vc":0,"isWriteIn":false,"isWinner":false,"pn":"REPUBLICAN","pco":"ff2c2c"},{"cid":212502,"cn":"JOSHUA GRAVLIN","vc":0,"isWriteIn":false,"isWinner":false,"pn":"DEMOCRATIC","pco":"007ABC"},{"cid":212471,"cn":"GARY MOORE","vc":0,"isWriteIn":false,"isWinner":false,"pn":"REPUBLICAN","pco":"ff2c2c"},{"cid":212492,"cn":"NATHAN PEETS","vc":0,"isWriteIn":false,"isWinner":false,"pn":"REPUBLICAN","pco":"ff2c2c"},{"cid":212456,"cn":"DANIEL PERRY, III","vc":0,"isWriteIn":false,"isWinner":false,"pn":"REPUBLICAN","pco":"ff2c2c"},{"cid":212498,"cn":"MONIQUE PRIESTLEY","vc":0,"isWriteIn":false,"isWinner":false,"pn":"DEMOCRATIC","pco":"007ABC"},{"cid":212496,"cn":"JONATHAN STIMSON","vc":0,"isWriteIn":false,"isWinner":false,"pn":"DEMOCRATIC","pco":"007ABC"},{"cid":212464,"cn":"CAROLE TAYLOR","vc":0,"isWriteIn":false,"isWinner":false,"pn":"REPUBLICAN","pco":"ff2c2c"},{"cid":212500,"cn":"KATHERINE WILLIAMS","vc":0,"isWriteIn":false,"isWinner":false,"pn":"DEMOCRATIC","pco":"007ABC"}],"wc":[{"cid":0,"cn":"OTHER WRITE-IN","vc":0,"isWriteIn":false,"isWinner":false,"pn":null,"pco":null}]}],"cd":[{"tn":"BRADFORD","repd":null,"send":null,"vc1":0,"vc2":0,"vc3":0,"ovc":0}],"bqcd":[]},{"tid":37,"tn":"BRADFORD","ldid":0,"ld":null,"oid":1,"on":"BALLOT QUESTIONS","vf":1,"otc":"BQ","cid1":213270,"cn1":"YES","cid2":213271,"cn2":"NO","cid3":0,"cn3":null,"bq":"\u003Cp\u003EShall the voters approve the following amendment to the Town Charter?\u003C/p\u003E\u003Cp\u003EThe voters of the Town of Bradford hereby amend the Charter of the Town of Bradford, Title 24, Appendix, Chapter 106, as follows:\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E1.Add a new\u00A7 209 to Subchapter 2 to read:\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E\u00A7 209. Recall of elected municipal officers. Any elected municipal officer of the Town of Bradford, except justices of the peace, may be recalled by the voters in accordance with this section.\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(a) Initiation of recall petition. A recall shall be initiated by a written petition signed by not less than 15 percent of the registered voters of the Town, as determined by the most recent voter checklist. The petition shall clearly state the name of the officer sought to be recalled and the office held. No statement of cause shall be required.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(b) Certification petition. Within seven business days of filing, the Town Clerk shall examine the petition and certify whether it contains the required number of valid signatures.\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(c) Warning of recall vote. Upon certification of a sufficient petition, the Selectboard shall warn a recall vote to be conducted by Australian ballot, to occur within 60 days of certification, or at the next annual or special Town meeting if such meeting occurs within that period.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(d) Required public informational meeting. At least seven days but not more than fifteen days prior to the recall vote, the Selectboard shall hold a public informational meeting. At this meeting, the officer who is the subject of the recall petition and representatives of the petitioners seeking recall shall each be afforded a reasonable opportunity to present information and respond to questions from voters.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(e) Ballot question. The ballot shall read substantially as follows: \u0022Shall [name], holding the office of [office], be recalled from office?\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(f) \u0022Vote required for recall. The officer shall be recalled only if both of the following conditions are met:(1) the number of ballots cast on the recall question is at least equal to the number of votes cast in the election at which the officer was elected, or at least one-third of the registered voters of the Town, whichever is greater; and (2) at least two-thirds of the ballots cast on the recall question vote in favor of recall.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(g) Effect of recall. Upon a successful recall vote, the office shall be declared vacant immediately and shall be filled as provided by law.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(h) Limitations on recall. No recall petition may be filed within the first six months of an officer\u0027s term, within the final six months of an officer\u0027s term, or more than once during the same term of office for the same officer.\u003Cbr\u003E\u0026nbsp;\u003C/p\u003E","cs":[{"tid":37,"ctyId":0,"oid":0,"sc":0,"sv":0,"bv":0,"vf":1,"tn":"BRADFORD","repd":null,"send":null,"ctyn":null,"distReported":null,"townsReported":null,"distCode":"","io":false,"rc":[{"cid":213270,"cn":"YES","vc":0,"isWriteIn":false,"isWinner":false,"pn":null,"pco":null},{"cid":213271,"cn":"NO","vc":0,"isWriteIn":false,"isWinner":false,"pn":null,"pco":null}],"wc":[]}],"cd":[{"tn":"BRADFORD","repd":"ORANGE-2","send":"ORANGE_","vc1":0,"vc2":0,"vc3":0,"ovc":0}],"bqcd":[{"bq":"\u003Cp\u003EShall the voters approve the following amendment to the Town Charter?\u003C/p\u003E\u003Cp\u003EThe voters of the Town of Bradford hereby amend the Charter of the Town of Bradford, Title 24, Appendix, Chapter 106, as follows:\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E1.Add a new\u00A7 209 to Subchapter 2 to read:\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E\u00A7 209. Recall of elected municipal officers. Any elected municipal officer of the Town of Bradford, except justices of the peace, may be recalled by the voters in accordance with this section.\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(a) Initiation of recall petition. A recall shall be initiated by a written petition signed by not less than 15 percent of the registered voters of the Town, as determined by the most recent voter checklist. The petition shall clearly state the name of the officer sought to be recalled and the office held. No statement of cause shall be required.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(b) Certification petition. Within seven business days of filing, the Town Clerk shall examine the petition and certify whether it contains the required number of valid signatures.\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(c) Warning of recall vote. Upon certification of a sufficient petition, the Selectboard shall warn a recall vote to be conducted by Australian ballot, to occur within 60 days of certification, or at the next annual or special Town meeting if such meeting occurs within that period.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(d) Required public informational meeting. At least seven days but not more than fifteen days prior to the recall vote, the Selectboard shall hold a public informational meeting. At this meeting, the officer who is the subject of the recall petition and representatives of the petitioners seeking recall shall each be afforded a reasonable opportunity to present information and respond to questions from voters.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(e) Ballot question. The ballot shall read substantially as follows: \u0022Shall [name], holding the office of [office], be recalled from office?\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(f) \u0022Vote required for recall. The officer shall be recalled only if both of the following conditions are met:(1) the number of ballots cast on the recall question is at least equal to the number of votes cast in the election at which the officer was elected, or at least one-third of the registered voters of the Town, whichever is greater; and (2) at least two-thirds of the ballots cast on the recall question vote in favor of recall.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(g) Effect of recall. Upon a successful recall vote, the office shall be declared vacant immediately and shall be filled as provided by law.\u0026nbsp;\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E(h) Limitations on recall. No recall petition may be filed within the first six months of an officer\u0027s term, within the final six months of an officer\u0027s term, or more than once during the same term of office for the same officer.\u003Cbr\u003E\u0026nbsp;\u003C/p\u003E","tn":"BRADFORD","repd":null,"yvc":0,"nvc":0,"sv":0,"bv":0,"tvc":0}]},{"tid":37,"tn":"BRADFORD","ldid":0,"ld":null,"oid":1,"on":"BALLOT QUESTIONS","vf":1,"otc":"BQ","cid1":0,"cn1":null,"cid2":0,"cn2":null,"cid3":0,"cn3":null,"bq":"\u003Ch2 style=\u0022line-height:111%;margin:0in 0in .0001pt 176.5pt;\u0022\u003E\u003Cspan style=\u0022font-family:\u0026quot;Calibri\u0026quot;,sans-serif;\u0022\u003E\u003Cspan style=\u0022font-size:14.0pt;line-height:111%;mso-ascii-theme-font:minor-latin;mso-bidi-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;\u0022\u003EShall the 