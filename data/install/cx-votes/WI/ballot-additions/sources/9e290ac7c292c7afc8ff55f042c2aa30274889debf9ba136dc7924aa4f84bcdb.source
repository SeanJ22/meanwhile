  <script type="text/javascript">
    function toggleDetail(pseudoLink, contestId) {
      if (document.getElementById('detail' + contestId).style.display === 'none') {
        document.getElementById('detail' + contestId).style.display = 'block';
        pseudoLink.innerHTML = 'Hide Detail';
      } else {
        document.getElementById('detail' + contestId).style.display = 'none';
        pseudoLink.innerHTML = 'Show Reporting Unit Detail';
      }
    }

    function newRequest(dropDownList) {
      var strNewURL = location.href.replace(location.search, '') +
                      "?contest=" + dropDownList.value;

      if(document.getElementById("hdnPast").value !== "") {
        strNewURL += "&past=" + document.getElementById("hdnPast").value;
      }
      window.location = strNewURL;
    }

</script>

