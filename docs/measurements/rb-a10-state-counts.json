  "inventoryUnchanged": true,
  "query": "WITH roots AS MATERIALIZED (\n  SELECT substring(scope from '^US-([A-Z]{2})(:|$)') AS state,record_class,reader_payload_node(payload) AS root\n  FROM civic_data_promotions WHERE record_class IN ('REGISTRY_RUNTIME_BINDING','BALLOT_CANDIDACY','VOTING_SITE')\n), board_ids AS (\n  SELECT r.state,reader_payload_node(b.item)->>'id' AS id FROM roots r\n  CROSS JOIN LATERAL reader_payload_members(reader_payload_node(r.root->'registry')->'bodies') b\n  WHERE r.record_class='REGISTRY_RUNTIME_BINDING'\n  UNION SELECT e.state::text,e.id FROM entity e WHERE e.kind IN ('body','committee')\n  AND EXISTS(SELECT 1 FROM fact f WHERE f.entity_id=e.id AND f.field='name' AND f.status='live')\n), race_ids AS (\n  SELECT r.state,reader_payload_node(c.item)->>'id' AS id FROM roots r\n  CROSS JOIN LATERAL jsonb_each(reader_payload_node(r.root->'ballots')) b\n  CROSS JOIN LATERAL reader_payload_members(reader_payload_node(b.value)->'contests') c\n  WHERE r.record_class='BALLOT_CANDIDACY'\n), site_ids AS (\n  SELECT r.state,reader_payload_node(s.item)->>'id' AS id FROM roots r\n  CROSS JOIN LATERAL reader_payload_members(r.root->'jurisdictions') j\n  CROSS JOIN LATERAL reader_payload_members(reader_payload_node(j.item)->'sites') s\n  WHERE r.record_class='VOTING_SITE'\n), boards AS(SELECT state,count(DISTINCT id)::int n FROM board_ids GROUP BY state),\nraces AS(SELECT state,count(DISTINCT id)::int n FROM race_ids GROUP BY state),\nsites AS(SELECT state,count(DISTINCT id)::int n FROM site_ids GROUP BY state)\nSELECT state,coalesce(boards.n,0) AS boards,coalesce(races.n,0) AS races,coalesce(sites.n,0) AS sites\nFROM unnest($1::text[]) AS states(state) LEFT JOIN boards USING(state) LEFT JOIN races USING(state) LEFT JOIN sites USING(state) ORDER BY state"
}
