  "sqlExactlyAsExecuted": "-- PREPARED OFFLINE ONLY. Not executed against any database.\n-- Output: exactly 57 fixed state/DC/territory/US rows, counts and presence flags only.\n-- Fact state is the owning entity's stored state; NULL means the US bucket.\n-- Member subjects are distinct nonempty IDs encoded after `member:`; no alias/person merge.\n-- Runtime counts use ONLY canonical current per-state reader-registry-runtime pointers.\n-- The retired country-wide US:reader-registry-runtime-bindings pointer is excluded.\n-- Roster entries, executive entries and candidacy-holder entries are separate inventories;\n-- do not add them together or treat them as distinct people/visible official totals.\nWITH buckets(state) AS (\n  VALUES\n    ('AK'),('AL'),('AR'),('AS'),('AZ'),('CA'),('CO'),('CT'),('DC'),('DE'),\n    ('FL'),('GA'),('GU'),('HI'),('IA'),('ID'),('IL'),('IN'),('KS'),('KY'),\n    ('LA'),('MA'),('MD'),('ME'),('MI'),('MN'),('MO'),('MP'),('MS'),('MT'),\n    ('NC'),('ND'),('NE'),('NH'),('NJ'),('NM'),('NV'),('NY'),('OH'),('OK'),\n    ('OR'),('PA'),('PR'),('RI'),('SC'),('SD'),('TN'),('TX'),('US'),('UT'),\n    ('VA'),('VI'),('VT'),('WA'),('WI'),('WV'),('WY')\n), fact_counts AS MATERIALIZED (\n  SELECT coalesce(e.state::text,'US') AS state,\n    count(*)::bigint AS live_member_fact_count,\n    count(DISTINCT nullif(substr(f.field,8),''))::bigint AS distinct_member_subjects\n  FROM fact f\n  JOIN entity e ON e.id=f.entity_id\n  WHERE f.status='live' AND f.field LIKE 'member:%'\n  GROUP BY coalesce(e.state::text,'US')\n)\nSELECT b.state,\n  coalesce(f.live_member_fact_count,0::bigint) AS live_member_fact_count,\n  coalesce(f.distinct_member_subjects,0::bigint) AS distinct_member_subjects,\n  coalesce(r.runtime_roster_member_entries,0::bigint) AS runtime_roster_member_entries,\n  coalesce(r.statewide_executive_entries,0::bigint) AS statewide_executive_entries,\n  coalesce(r.candidacy_holder_entries,0::bigint) AS candidacy_holder_entries,\n  coalesce(r.runtime_publication_present,false) AS runtime_publication_present,\n  coalesce(r.body_rosters_field_present,false) AS body_rosters_field_present,\n  coalesce(r.statewide_executives_field_present,false) AS statewide_executives_field_present,\n  coalesce(r.candidacy_rows_field_present,false) AS candidacy_rows_field_present\nFROM buckets b\nLEFT JOIN fact_counts f ON f.state=b.state\nLEFT JOIN LATERAL (\n  -- Correlated to one bucket: retain at most one state's runtime root at a time.\n  WITH pointer AS MATERIALIZED (\n    SELECT p.payload\n    FROM civic_data_promotions p\n    WHERE p.record_class='REGISTRY_RUNTIME_BINDING'\n      AND p.key='REGISTRY_RUNTIME_BINDING:' ||\n        CASE WHEN b.state='US' THEN 'US' ELSE 'US-' || b.state END ||\n        ':reader-registry-runtime'\n  ), root AS MATERIALIZED (\n    SELECT reader_payload_node(payload) AS value FROM pointer\n  ), candidacy_bridge AS MATERIALIZED (\n    SELECT reader_payload_node(value->'officialCandidacies') AS value FROM root\n  )\n  SELECT\n    true AS runtime_publication_present,\n    root.value ? 'bodyRosters' AS body_rosters_field_present,\n    root.value ? 'statewideExecutives' AS statewide_executives_field_present,\n    coalesce((SELECT value ? 'rows' FROM candidacy_bridge),false) AS candidacy_rows_field_present,\n    (\n      SELECT count(*)::bigint\n      FROM reader_payload_members(coalesce(root.value->'bodyRosters','[]'::jsonb)) roster\n      CROSS JOIN LATERAL reader_payload_members(\n        coalesce(reader_payload_node(roster.item)->'members','[]'::jsonb)\n      ) member\n    ) AS runtime_roster_member_entries,\n    (\n      SELECT count(*)::bigint\n      FROM reader_payload_members(coalesce(root.value->'statewideExecutives','[]'::jsonb)) executive\n    ) AS statewide_executive_entries,\n    (\n      SELECT count(*)::bigint\n      FROM candidacy_bridge bridge\n      CROSS JOIN LATERAL reader_payload_members(coalesce(bridge.value->'rows','[]'::jsonb)) candidacy\n      CROSS JOIN LATERAL (SELECT reader_payload_node(candidacy.item) AS value) header\n      WHERE header.value ? 'holder' AND header.value->'holder' <> 'null'::jsonb\n    ) AS candidacy_holder_entries\n  FROM root\n) r ON true\nORDER BY b.state;\n",
