          "text": "SELECT p.key, p.source_id, p.record_class, p.scope, p.current_version_id, p.last_known_good_version_id,\n    p.promoted_at, (p.validation_receipt - 'excludedFacts') || jsonb_build_object('excludedFacts','[]'::jsonb) validation_receipt,\n    (WITH selected AS MATERIALIZED (\n  SELECT coalesce(array_agg(logical),'{}'::text[]) AS exact_keys,\n    coalesce(array_agg(logical) FILTER (WHERE logical ~ '^(zip|cell):'),'{}'::text[]) AS location_keys\n  FROM (SELECT substring(key FROM 21) AS logical\n    FROM unnest($3::text[]) requested(key) WHERE starts_with(key,'open-data-partition:')) keys\n) SELECT CASE\n  WHEN p.record_class='CURATED_READER_RECORD' AND p.source_id IN ('epa-echo','socrata-discovery')\n    AND p.scope=p.source_id||':national' AND header->>'kind'='open-data' AND header->>'sourceId'=p.source_id\n  THEN CASE WHEN header ? 'partitions' THEN reader_payload_value(header-'partitions') || jsonb_build_object('partitions',\n    coalesce((SELECT jsonb_agg(reader_payload_value(item) ORDER BY ordinal_index)\n      FROM reader_payload_members(header->'partitions') members\n      WHERE reader_payload_node(item)->>'id'=ANY(selected.exact_keys)\n        OR split_part(reader_payload_node(item)->>'id',':state:',1)=ANY(selected.location_keys)), '[]'::jsonb))\n    ELSE reader_place_payload(p.payload,$3::text[],NULL) END\n  ELSE NULL END FROM (SELECT reader_payload_node(p.payload) AS header) decoded CROSS JOIN selected) payload,\n    c.retrieved_at, reader_payload_node(c.candidate)->'temporal' temporal FROM civic_data_promotions p\n    JOIN civic_data_candidates c ON c.id=p.current_version_id\n    WHERE p.record_class=$1 AND p.scope=$2 AND c.state='PROMOTED' AND $3::text[] IS NOT NULL",
