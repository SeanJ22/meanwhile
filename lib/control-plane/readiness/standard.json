    {
      "id": "readiness/instrument-derived@1",
      "adoptedOn": "2026-09-04",
      "supersededOn": "2026-09-06",
      "summary": "The first instrument-derived standard: every capability graded from its own evidence walks through the five gates, replacing the hand-authored publisher. Its cells were derived without the reader-delivery instrument and without the per-state FEC and candidate-filing slices, and its ZIP populations came from the ACS 2023 vintage.",
      "gates": null,
      "capabilities": null,
      "notRecorded": "This version was code, not a list, while it was in force; its exact gates and capabilities are in the code history, not in this manifest."
    },
    {
      "id": "readiness/instrument-derived@2",
      "adoptedOn": "2026-09-06",
      "supersededOn": null,
      "summary": "Adds the reader-delivery instrument (a capability's rows are traced to the files a deployed Reader route must read), the per-state FEC and candidate-filing slices, and ZIP populations from the ACS 2024 vintage.",
      "gates": [
        {
          "id": "SOURCE_KNOWN",
          "label": "Source known",
          "definition": "A named, reachable publisher path exists and has been observed. Publisher observation precedes any claim about what they publish."
        },
        {
          "id": "ACQUIRED",
          "label": "Acquired",
          "definition": "Records have been pulled and vaulted, with an as-of timestamp."
        },
        {
          "id": "VERIFIED",
          "label": "Verified",
          "definition": "Reconciled against an external authority. No reconciliation may compare a parser to itself; if the only thing confirming our count is our own count, this gate is NOT_WALKED."
        },
        {
          "id": "SHOWN_TO_READER",
          "label": "Shown to reader",
          "definition": "Rendered on a live reader surface, and stated N equals rendered rows."
        },
        {
          "id": "ASK_ANSWERS",
          "label": "Ask answers",
          "definition": "Ask answers from this data under the answer contract, without falling back to general knowledge."
        }
      ],
