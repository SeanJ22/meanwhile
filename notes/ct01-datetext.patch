+    "SC excerpt": ["Register online at scVOTES.gov (must be received by Sunday, October 4 ). Download a voter registration form from scVOTES.gov .",
+      "Register online at scVOTES.gov (must be received by Sunday, October 4). Download a voter registration form from scVOTES.gov."],
+    OR: ["Voter registration deadline : October 13", "Voter registration deadline: October 13"],
+    "already clean": ["Mail-in ballots can be requested until Oct. 29.", "Mail-in ballots can be requested until Oct. 29."],
