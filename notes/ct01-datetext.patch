diff --git a/tests/reader-dated-text.test.ts b/tests/reader-dated-text.test.ts
new file mode 100644
index 000000000..f9aa77158
--- /dev/null
+++ b/tests/reader-dated-text.test.ts
@@ -0,0 +1,70 @@
+import assert from "node:assert/strict";
+import { readdirSync, readFileSync } from "node:fs";
+import { test } from "node:test";
+import { readerDatedText } from "../lib/text/format-date.ts";
+
+const DIR = "data/ballot/2026-navigation";
+const DATED = new Set(["registration_deadline", "mail_ballot_request_deadline", "early_voting"]);
+
+function quotes(): { state: string; quote: string }[] {
+  const found: { state: string; quote: string }[] = [];
+  const walk = (node: unknown, state: string): void => {
+    if (Array.isArray(node)) { node.forEach(item => walk(item, state)); return; }
+    if (!node || typeof node !== "object") return;
+    const value = node as { fieldKind?: string; quote?: unknown };
+    if (typeof value.fieldKind === "string" && typeof value.quote === "string") {
+      if (DATED.has(value.fieldKind)) found.push({ state, quote: value.quote });
+      return;
+    }
+    Object.values(node).forEach(child => walk(child, state));
+  };
+  for (const file of readdirSync(DIR).filter(name => name.endsWith(".json"))) {
+    walk(JSON.parse(readFileSync(`${DIR}/${file}`, "utf8")), file.slice(0, 2).toUpperCase());
+  }
+  return found;
+}
+
+test("held deadline sentences read with capitalised dates and clean punctuation", () => {
+  const samples: Record<string, [string, string]> = {
