diff --git a/lib/text/format-date.ts b/lib/text/format-date.ts
index f4102e395..1b7b4c929 100644
--- a/lib/text/format-date.ts
+++ b/lib/text/format-date.ts
@@ -9,6 +9,8 @@
  * meeting's own zone first, as `lib/map/format.ts` does.
  */
 
+import { readerText } from "./reader-names.ts";
+
 const MONTHS = [
   "January",
   "February",
@@ -71,3 +73,33 @@ export function spellOutDates(text: string): string {
       formatDateLong(`${y}-${m}-${d}`) ?? whole,
   );
 }
+
+const MONTH_MENTION = /\b([A-Za-z]{3,9}\.?)([ \t]+)0?(\d{1,2})(?=(?:st|nd|rd|th)?\b)/g;
+/** Month and weekday names standing alone; "may" is left alone, since it is usually the verb. */
+const NAMED_DAY = /\b(?:january|february|march|april|june|july|august|september|october|november|december|monday|tuesday|wednesday|thursday|friday|saturday|sunday|election day)\b/gi;
+const SHOUTING_RUN = /\b[A-Z][A-Z'’]+\b(?:[ \t,&/–—-]+\b[A-Z][A-Z'’]+\b)+/g;
+
+function isMonth(word: string): boolean {
+  const key = word.toLowerCase().replace(/\.$/, "");
+  return MONTHS.some(name => key === name.toLowerCase() || key === name.slice(0, 3).toLowerCase() || (name === "September" && key === "sept"));
+}
+
+const capitalised = (words: string) => words.replace(/\b\p{L}/gu, letter => letter.toUpperCase());
+
+/**
+ * A source's own sentence about dates, ready for a reader: the source's words,
+ * order and dates, with month and weekday names capitalised, a shouting heading
+ * cased, and no stray space before punctuation.
+ * "voter pre-registration ends on october 23 ." → "Voter pre-registration ends on October 23."
+ */
+export function readerDatedText(text: string): string {
+  return text.replace(SHOUTING_RUN, run => readerText(run, "sentence"))
+    .replace(MONTH_MENTION, (whole, word: string, space: string, day: string) =>
+      isMonth(word) ? `${capitalised(word.toLowerCase())}${space}${Number(day)}` : whole)
+    .replace(NAMED_DAY, name => capitalised(name.toLowerCase()))
+    .replace(/[ \t]+([.,;:!?)])(?=[\s.,;:)]|$)/g, "$1")
+    .replace(/\([ \t]+/g, "(")
+    .replace(/[ \t]{2,}/g, " ")
+    .trim()
+    .replace(/^\p{Ll}/u, letter => letter.toUpperCase());
+}
