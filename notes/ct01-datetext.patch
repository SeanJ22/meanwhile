+  for (const [label, [quote, expected]] of Object.entries(samples)) assert.equal(readerDatedText(quote), expected, label);
+  const held = new Set(quotes().map(row => row.quote));
+  for (const [label, [quote]] of Object.entries(samples)) if (!/ /.test(label)) assert.ok(held.has(quote), `${label}: sample is not a held quote`);
