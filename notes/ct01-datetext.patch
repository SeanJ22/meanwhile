+test("every state's held deadline sentence keeps its words and dates and reads cleanly", () => {
+  const rows = quotes();
+  const states = new Set(rows.map(row => row.state));
+  assert.ok(states.size >= 50, `only ${states.size} states hold deadline sentences`);
+  for (const { state, quote } of rows) {
+    const sentence = readerDatedText(quote);
+    const letters = (text: string) => text.toLowerCase().replace(/[^\p{L}]/gu, "");
+    const numbers = (text: string) => (text.match(/\d+/g) ?? []).map(Number);
+    assert.equal(letters(sentence), letters(quote), `${state}: words changed in ${quote}`);
+    assert.deepEqual(numbers(sentence), numbers(quote), `${state}: dates changed in ${quote}`);
+    assert.doesNotMatch(sentence, /\b(?:january|february|march|april|june|july|august|september|october|november|december|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/,
+      `${state}: lower-case month or weekday in ${sentence}`);
+    assert.doesNotMatch(sentence, /[ \t][.,;:)](?=\s|$)/, `${state}: space before punctuation in ${sentence}`);
+    assert.doesNotMatch(sentence, /^\p{Ll}/u, `${state}: sentence starts in lower case: ${sentence}`);
+  }
+});
