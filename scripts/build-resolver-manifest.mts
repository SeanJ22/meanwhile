/** Builds the resolver input from held geometry. A national file stays in until
 * per-state derivatives cover every division it holds. */
import { readFileSync, writeFileSync } from "node:fs";
import { basename, join } from "node:path";

import { US_JURISDICTIONS, jurisdictionFromOcdId } from "../lib/coverage/states.ts";
import { geometryFiles } from "../lib/holdings/discovery.ts";
import { today } from "./doc-dates.mjs";

const ROOT = process.cwd();
const OUT = join(process.cwd(), "data", "derived", "resolver-geometry.json");

/** Geometry that is not a division boundary and must never answer who governs a point. */
const NOT_DISTRICT_GEOMETRY: Record<string, string> = {
  "state-outlines.geojson":
    "a generalized state outline for the focus effect — never a governance boundary",
  "body-territories.geojson":
    "BODY territories, not DIVISION boundaries — recorded plats belonging to governments " +
    "the Census enumerates no division for. lib/registry/body-territory.ts point-tests them; " +
    "they have no ocdId, so including them would make the division resolver answer with a body id.",
};

/** `cd119.geojson` → `cd119`; `cd119-NN.geojson` → `cd119` + state FIPS `NN`. */
function parseName(file: string): { type: string; fips: string | null } {
  const stem = basename(file).replace(/\.geojson$/, "");
  const m = /^(.*)-(\d{2})$/.exec(stem);
  return m ? { type: m[1], fips: m[2] } : { type: stem, fips: null };
}

const files = geometryFiles(ROOT);

const collections = new Map(files.map(file => [file, JSON.parse(readFileSync(join(ROOT, file), "utf8")) as { features: { properties: { ocdId?: string }; geometry: { type: string; coordinates: unknown } }[] }]));
const ids = (file: string) => new Set(collections.get(file)!.features.map(feature => feature.properties.ocdId).filter((id): id is string => Boolean(id)));

interface Row {
  file: string;
  features: number;
  coordinates: number;
}

const included: Row[] = [];
const excluded: { file: string; reason: string }[] = [];

for (const file of files) {
  const notDistrict = NOT_DISTRICT_GEOMETRY[basename(file)];
  if (notDistrict) {
    excluded.push({ file, reason: notDistrict });
    continue;
  }

  const { type, fips } = parseName(file);
  const ownIds = ids(file);
  const splitFiles = files.filter(other => { const parsed = parseName(other); return parsed.type === type && parsed.fips !== null; });
  const splitIds = new Set(splitFiles.flatMap(other => [...ids(other)]));
  if (fips === null && splitFiles.length && ownIds.size > 0 && [...ownIds].every(id => splitIds.has(id))) {
    excluded.push({ file, reason: "superseded by held per-state derivatives covering every sourced division in the national file" });
    continue;
  }
  const national = files.find(other => { const parsed = parseName(other); return parsed.type === type && parsed.fips === null; });
  if (fips !== null && national && ownIds.size > 0) {
    const nationalIds = ids(national);
    const nationalSuperseded = nationalIds.size > 0 && [...nationalIds].every(id => splitIds.has(id));
    if (!nationalSuperseded && [...ownIds].every(id => nationalIds.has(id))) {
      excluded.push({ file, reason: "already represented by the held national file, whose other divisions have no complete state derivatives" });
      continue;
    }
  }

  const parsed = collections.get(file)!;
  let coordinates = 0;
  for (const feature of parsed.features ?? []) {
    const polys =
      feature.geometry.type === "Polygon"
        ? [feature.geometry.coordinates as number[][][]]
        : (feature.geometry.coordinates as number[][][][]);
    for (const poly of polys) for (const ring of poly) coordinates += ring.length;
  }
  included.push({ file, features: parsed.features?.length ?? 0, coordinates });
}

const heldFips = new Set(included.flatMap(row => collections.get(row.file)!.features.flatMap(feature => jurisdictionFromOcdId(feature.properties.ocdId ?? null)?.fips ?? [])));
const covered = US_JURISDICTIONS.filter(state => heldFips.has(state.fips)).map(state => state.fips);

const totals = included.reduce(
  (acc, r) => ({ features: acc.features + r.features, coordinates: acc.coordinates + r.coordinates }),
  { features: 0, coordinates: 0 },
);

writeFileSync(
  OUT,
  `${JSON.stringify(
    {
      $comment: [
        "GENERATED by scripts/build-resolver-manifest.mts (pnpm resolver:manifest).",
        "P-003: the geometry lib/registry/server.ts may read. Never hand-edited.",
        "Every canonical state geometry and national geometry file appears on exactly one list.",
      ],
      schemaVersion: 2,
      generatedAt: today(),
      coveredStateFips: covered,
      totals,
      files: included.map((r) => r.file),
      detail: included,
      excluded,
    },
    null,
    2,
  )}\n`,
  "utf8",
);

const unaccounted = files.filter(
  (f) => !included.some((r) => r.file === f) && !excluded.some((r) => r.file === f),
);

console.log(`\nresolver manifest — ${today()}\n`);
console.log(`  read by the resolver   ${included.length} file(s)`);
console.log(`  excluded               ${excluded.length} file(s)`);
for (const row of excluded) console.log(`      ${row.file} — ${row.reason.slice(0, 96)}`);
console.log(`\n  features               ${totals.features.toLocaleString()}`);
console.log(`  coordinates            ${totals.coordinates.toLocaleString()}`);
console.log(`\n  unaccounted            ${unaccounted.length}${unaccounted.length ? ` — ${unaccounted.join(", ")}` : ""}`);
console.log(`\n  written ${OUT}\n`);

if (unaccounted.length > 0) process.exit(1);
