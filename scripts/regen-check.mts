/**
 * `pnpm regen` — **the completion condition RULING 92 never had.**
 * (RULING 102, 2026-08-23. Written for NJ Hunt 6 hardening item 5.)
 *
 * ## What it answers
 *
 * *Has any generator been fixed without its artifact being regenerated?*
 *
 * That question had no instrument. `data/states/nj/hunt/nj-morris-municipal-sites.json`
 * pointed five municipalities at the wrong government's website while its
 * generator was already correct — somebody had done the RULING 92 thing and
 * stopped, and every downstream hunt read the stale output as current.
 *
 * ## How
 *
 * Each registered artifact's generator is digested over its whole repo-local
 * source closure — the entry script plus every module it imports, transitively
 * — and compared against `tests/generator-digests.json`. Four verdicts, kept
 * apart because they need different actions:
 *
 * - **CURRENT** — the generator has not moved since the artifact was written.
 * - **STALE** — it has. The artifact is owed a regeneration.
 * - **UNRECORDED** — no digest has ever been taken. Also owed.
 * - **UNRESOLVABLE** — the command does not resolve to a repo file, so no
 *   completion condition can be computed. Named rather than skipped, because
 *   a generator with no completion condition is the state this ends.
 *
 * ## Usage
 *
 *   pnpm regen            — report, exit 1 if anything is STALE or UNRECORDED
 *   pnpm regen --write    — record today's digests (run AFTER regenerating)
 *   pnpm regen --run-pure — re-run every PURE generator, then diff and record
 *
 * `--write` on its own does not regenerate anything: it records what is in the
 * tree now. Running it without having regenerated would make the guard agree
 * with a stale artifact, which is why the count changed is printed every time
 * and why the author is told when nothing moved.
 */

import { execSync } from "node:child_process";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

import { today } from "./doc-dates.mjs";

import {
  DIGEST_FILE,
  GENERATED,
  type DigestFile,
} from "../lib/ops/generated-register.ts";
import {
  checkArtifact,
  digestGenerator,
  entryFor,
  sourceClosure,
} from "../lib/ops/generator-digest.ts";

const ROOT = process.cwd();
const WRITE = process.argv.includes("--write");
const RUN_PURE = process.argv.includes("--run-pure");

/*
 * `today()` from the shared helper, never a date this script composes. An
 * agent does not know today's date, and a date not read from the system clock
 * in America/Phoenix is a fabrication — the same rule every other stamp in
 * this repo obeys.
 */

function loadDigests(): DigestFile {
  const full = join(ROOT, DIGEST_FILE);
  if (!existsSync(full)) return {};
  return JSON.parse(readFileSync(full, "utf8")) as DigestFile;
}

const recorded = loadDigests();

/* ------------------------------------------------------------------ run --- */

/**
 * **Regenerate and diff — the two halves of the ruling, in one step.**
 *
 * Only PURE generators are re-run here. An impure one reads the network, and
 * re-running it inside a check would make the check's verdict depend on
 * whether a county's website was up. Those are regenerated by hand, by the
 * session that fixed them, and `--write` records the result.
 */
const changed: string[] = [];
if (RUN_PURE) {
  const pure = GENERATED.filter((x) => x.pure);
  const before = new Map(pure.map(a => [a.path, existsSync(join(ROOT, a.path)) ? readFileSync(join(ROOT, a.path), "utf8") : null]));
  // A single generator may own many artifacts (state-manifest owns 56).
  // Run each command once, then compare every registered output as before.
  for (const command of new Set(pure.map(a => a.command))) {
    process.stdout.write(`re-running ${command}\n`);
    execSync(command, { cwd: ROOT, stdio: "pipe", encoding: "utf8" });
  }
  for (const a of pure) {
    if (before.get(a.path) !== readFileSync(join(ROOT, a.path), "utf8")) changed.push(a.path);
  }
}

/* --------------------------------------------------------------- report --- */

const checks = GENERATED.map((a) => checkArtifact(ROOT, a, recorded[a.path]?.digest ?? null));

const by = (v: string) => checks.filter((c) => c.verdict === v);

/* ------------------------------------------------------- the git sweep --- */

/**
 * **The sweep that finds the defect this ruling was built over, TODAY.**
 *
 * The digest ledger is forward-looking: it catches the NEXT generator fix that
 * ships without a regeneration. It cannot see the ones already in the tree,
 * because there is no earlier digest to compare against — and
 * `data/states/nj/hunt/nj-morris-municipal-sites.json` was exactly that shape.
 *
 * Git can see it. If any file in a generator's source closure was last
 * committed AFTER its artifact was last committed, the generator was fixed and
 * the output was not regenerated. That is the whole of it, and it needs no
 * network and no baseline.
 *
 * A caveat stated rather than hidden: a generator edit that could not change
 * the output — a comment, a rename — shows here too. That is a false positive
 * in the sense that nothing is wrong with the artifact, and it is still the
 * right verdict for a tool to print, because the only way to KNOW is to
 * regenerate and diff, which is what the ruling asks for.
 */
const commitTimes = new Map<string, string | null>();
function lastCommit(path: string): string | null {
  if (commitTimes.has(path)) return commitTimes.get(path)!;
  try {
    const out = execSync(`git log -1 --format=%cI -- "${path}"`, {
      cwd: ROOT,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
    const result = out.length > 0 ? out : null;
    commitTimes.set(path, result);
    return result;
  } catch {
    commitTimes.set(path, null);
    return null;
  }
}

interface GitSweepRow {
  path: string;
  artifactAt: string | null;
  newerSources: Array<{ file: string; at: string; shared: number }>;
}

/*
 * **How many generators read each file.** A file read by one generator is that
 * generator; a file read by nine is a shared helper, and an edit to it says
 * far less about whether THIS artifact is owed a re-run. Both are printed —
 * the distinction is signal, never a licence to ignore a row.
 */
const readers = new Map<string, number>();
for (const a of GENERATED) {
  const entry = entryFor(ROOT, a.command);
  if (entry === null) continue;
  for (const file of sourceClosure(ROOT, entry)) {
    readers.set(file, (readers.get(file) ?? 0) + 1);
  }
}

const sweep: GitSweepRow[] = [];
for (const a of GENERATED) {
  const entry = entryFor(ROOT, a.command);
  if (entry === null) continue;
  const artifactAt = lastCommit(a.path);
  if (artifactAt === null) continue;
  const newerSources: GitSweepRow["newerSources"] = [];
  for (const file of sourceClosure(ROOT, entry)) {
    const at = lastCommit(file);
    if (at !== null && at > artifactAt) {
      newerSources.push({ file, at, shared: readers.get(file) ?? 1 });
    }
  }
  if (newerSources.length > 0) sweep.push({ path: a.path, artifactAt, newerSources });
}

console.log(`\ngit sweep — generator source committed AFTER its artifact\n`);
if (sweep.length === 0) {
  console.log("  none. Every registered artifact was committed at or after its generator.\n");
} else {
  for (const row of sweep) {
    console.log(`  ${row.path}`);
    console.log(`    artifact last committed ${row.artifactAt}`);
    for (const s of row.newerSources) {
      const scope = s.shared > 1 ? `shared by ${s.shared} generators` : "dedicated to this one";
      console.log(`    newer source: ${s.file}  ${s.at}  [${scope}]`);
    }
  }
}
const dedicated = sweep.filter((r) => r.newerSources.some((s) => s.shared === 1));
console.log(
  `  ${sweep.length} of ${GENERATED.length} artifact(s) are behind their generator; ` +
    `${dedicated.length} behind a DEDICATED source.\n`,
);

console.log(`\ngenerator digests — ${checks.length} registered artifact(s)\n`);
for (const c of checks) {
  const mark =
    c.verdict === "CURRENT" ? "  ok  " : c.verdict === "UNRESOLVABLE" ? " ???? " : " STALE";
  const closure = c.files > 0 ? `${c.files} source file(s)` : "closure not computed";
  console.log(`${mark} ${c.verdict.padEnd(12)} ${c.path}`);
  console.log(`         ${c.command}`);
  console.log(`         ${closure}`);
  if (c.verdict === "STALE") {
    console.log(`         recorded ${c.recorded?.slice(0, 12)} → now ${c.current?.slice(0, 12)}`);
  }
}

console.log(
  `\n  CURRENT ${by("CURRENT").length}  ·  STALE ${by("STALE").length}  ·  ` +
    `UNRECORDED ${by("UNRECORDED").length}  ·  UNRESOLVABLE ${by("UNRESOLVABLE").length}` +
    `   of ${checks.length}`,
);
if (RUN_PURE) {
  console.log(`  pure generator commands re-run: ${new Set(GENERATED.filter((x) => x.pure).map(x => x.command)).size}`);
  console.log(`  artifacts CHANGED by the re-run: ${changed.length}`);
  for (const p of changed) console.log(`    ${p}`);
}

/* ---------------------------------------------------------------- write --- */

if (WRITE) {
  const stamp = today();
  const next: DigestFile = { ...recorded };
  let moved = 0;
  for (const a of GENERATED) {
    const entry = entryFor(ROOT, a.command);
    if (entry === null) continue;
    const d = digestGenerator(ROOT, entry);
    // --write records completed regeneration of changed generators. An
    // unchanged entry still describes its original regeneration, not this run.
    if (next[a.path]?.digest === d.digest) continue;
    moved += 1;
    next[a.path] = {
      digest: d.digest,
      files: d.files,
      entry: d.entry,
      regeneratedOn: stamp,
    };
  }
  // Sorted keys so the file diffs cleanly rather than reordering on every write.
  const sorted: DigestFile = {};
  for (const k of Object.keys(next).sort()) sorted[k] = next[k];
  writeFileSync(join(ROOT, DIGEST_FILE), `${JSON.stringify(sorted, null, 2)}\n`, "utf8");
  console.log(`\n  wrote ${DIGEST_FILE} — ${moved} digest(s) moved, stamped ${stamp}`);
  process.exit(0);
}

const owed = by("STALE").length + by("UNRECORDED").length;
if (owed > 0) {
  console.error(
    `\n  ${owed} artifact(s) are owed a regeneration. RULING 102: a generator fix is not\n` +
      "  finished until its output is regenerated and diffed. Regenerate them, then run\n" +
      "  `pnpm regen --write` to record the new digests.\n",
  );
  process.exit(1);
}
console.log("\n  every registered artifact is current against its generator.\n");
