import { readFileSync, writeFileSync } from "node:fs";
import { readRecords } from "../lib/reference/index.ts";
import { dataPath, notePath } from "./lib/reference-paths.ts";
import { compileStateCampaignFinanceAgencies, STATE_CF_HEADER } from "../lib/reference/state-campaign-finance.ts";

const corrections = JSON.parse(readFileSync("tests/fixtures/reference/fec-campaign-office-blocks.json", "utf8")) as {
  capturedAt: string; blocks: { jurisdiction: string; text: string; page: number }[];
};
const rows = compileStateCampaignFinanceAgencies({ directory: readRecords("fec_combined_federal_state_disclosure_directory"),
  previous: readRecords("state-cf-agencies"), correctedBlocks: corrections.blocks, sourceCheckedAt: corrections.capturedAt.slice(0, 10) });
const cell = (value: string) => `"${value.replaceAll('"', '""')}"`;
writeFileSync(dataPath("state-cf-agencies"), [STATE_CF_HEADER.join(","), ...rows.map(row => STATE_CF_HEADER.map(key => cell(row[key] ?? "")).join(","))].join("\n") + "\n");
writeFileSync(notePath("state-cf-agencies"), `# state-cf-agencies.csv — source note

## Source
- Publisher: Federal Election Commission (United States).
- Source PDF: https://www.fec.gov/resources/cms-content/documents/cfsded.pdf
- Derived from data/reference/fec_combined_federal_state_disclosure_directory.csv, captured 2026-10-02.
- Supplementary office blocks: tests/fixtures/reference/fec-campaign-office-blocks.json, retained from the same PDF bytes.
- Source PDF SHA-256: 0a30a76fb056f4708d6edaff96b3be6b026f4cc7f36f65b2cf1bed6a5bd0d22c.
- Rows: 56, one office for each state, DC and territory.

## Extraction and reader use
Generated by node --experimental-strip-types scripts/regenerate-state-cf-reference.mts. The compiler selects an office whose published records-held text names state, district, territorial or local campaign-finance reports. It also recognizes campaign reports for state and county offices. Federal-only offices cannot stand in. North Carolina and Virginia office headings joined the preceding text cell in the directory extraction; their captured office blocks establish the proper office, URL and phone. The Washington state-specific records category distinguishes its Public Disclosure Commission from federal offices printed under WASHINGTON.

Readers receive the named office, phone and agency URL through readRecords and the national state-office selector. The source-check date identifies the FEC capture, not a new visit to every agency website. Historical website status fields are retained only for an unchanged office and URL; unavailable status does not remove an office listed by the FEC. Empty portal fields mean no separate filing portal is held.

## Licence
A United States government work, public domain under 17 U.S.C. § 105.
`);
console.log(`State campaign-finance offices: ${rows.length} from the held FEC directory.`);
