/**
 * Repository navigation derived only from the would-be-committed file paths.
 * Ordinary edits, data refreshes and new commits leave the output unchanged.
 * Run pnpm repo-map to write the inventory; --check compares without writing.
 */
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

import { filesThatWouldBeCommitted } from "../lib/ops/repo-files.ts";

const ROOT = fileURLToPath(new URL("../", import.meta.url));
const DOC = join(ROOT, "docs", "repo-inventory.md");

function code(path: string): string {
  return `\`${path.replace(/`/g, "\\`").replace(/\r?\n/g, " ")}\``;
}

function fileSection(title: string, files: string[]): string[] {
  return [
    `## ${title}`,
    "",
    `${files.length} file(s).`,
    "",
    ...files.map((file) => `- ${code(file)}`),
    ...(files.length === 0 ? ["No matching file paths."] : []),
    "",
  ];
}

export function renderInventory(paths: readonly string[]): string {
  const files = [...new Set(paths)].sort();
  const routes = files.filter((file) => /^app\/(?:.*\/)?(?:route\.ts|page\.tsx)$/.test(file));
  const tests = files.filter((file) => /\.test\.tsx?$/.test(file));
  const modules = [...new Set(files.filter((file) => file.startsWith("lib/"))
    .map((file) => file.split("/").slice(0, -1).join("/")))].sort();
  const out = [
    "# Repo inventory",
    "",
    "**GENERATED by `pnpm repo-map`. Never hand-edit.**",
    "",
    "This is a file-path index of the would-be-committed tree from " +
      "`filesThatWouldBeCommitted()` in `lib/ops/repo-files.ts`: tracked files plus " +
      "unignored new files, excluding deleted paths. Ignored build output and local " +
      "settings are excluded. File contents, line counts, digests, HEAD and time " +
      "stamps are not inputs. Editing existing files leaves this document unchanged; " +
      "adding, removing or renaming a file updates it.",
    "",
    "Read each source file for its current exports, configuration, commands and " +
      "data. Standing decisions are in `docs/rulings.md`. Live production health and " +
      "release observations belong to the canonical operations data plane and Admin. " +
      "GitHub Actions is not a routine civic-data or operational scheduler.",
    "",
    "## Routes and pages",
    "",
    `${routes.length} file(s). Paths retain route groups and dynamic segments as written.`,
    "",
    ...routes.map((file) => `- ${code("/" + file.replace(/^app\//, "")
      .replace(/\/?(?:route\.ts|page\.tsx)$/, ""))} — ${code(file)}`),
    ...(routes.length === 0 ? ["No route or page file paths."] : []),
    "",
    "## Library directories",
    "",
    `${modules.length} director(ies), derived from lib/ file paths.`,
    "",
    ...modules.map((module) => `- ${code(module)}`),
    ...(modules.length === 0 ? ["No library file paths."] : []),
    "",
    ...fileSection("Schema and migrations", files.filter((file) =>
      file === "lib/db/schema.ts" || /^lib\/db\/migrations\/.*\.sql$/.test(file) ||
      file === "lib/control-plane/repository/pg-schema.ts")),
    ...fileSection("Scripts", files.filter((file) => file.startsWith("scripts/"))),
    ...fileSection("Workflows", files.filter((file) => /^\.github\/workflows\/[^/]+\.ya?ml$/.test(file))),
    ...fileSection("Tests", tests),
    ...fileSection("Complete file tree", files),
  ];
  // Dates in filenames are source names, not measured or generated-at stamps.
  // Annotate every such line so this stays deterministic as the day changes.
  return out.map((line) => /20\d\d-\d\d-\d\d/.test(line)
    ? `${line} <!-- expected-future: date copied from a file path; no measurement date is claimed -->`
    : line).join("\n");
}

const invoked = process.argv[1]?.replace(/\\/g, "/").endsWith("repo-map.mts");
if (invoked) {
  const next = renderInventory(filesThatWouldBeCommitted({ cwd: ROOT }));
  const current = existsSync(DOC) ? readFileSync(DOC, "utf8") : null;
  if (current === next) {
    console.log("docs/repo-inventory.md unchanged — file paths are current");
  } else if (process.argv.includes("--check")) {
    console.error("docs/repo-inventory.md is stale against the file paths. Run: pnpm repo-map");
    process.exitCode = 1;
  } else {
    writeFileSync(DOC, next, "utf8");
    console.log("docs/repo-inventory.md updated — file paths changed");
  }
}
