/**
 * `pnpm stage1` — the Stage 1 cutover gate, and the descent freeze verdict.
 *
 * ## Why a two-stage cutover exists at all
 *
 * The active NJ/AZ/NH descent frontier must not keep changing while its
 * canonical state representation is being replaced. But the project must not
 * spend an extended period building the system that DESCRIBES the work instead
 * of doing the work.
 *
 * So the freeze covers the minimum: **freeze the moving state only long enough
 * to replace its canonical store.** It does NOT wait for every historical
 * document to be perfect. Full supersession normalization, remaining domain
 * policies, remaining provenance classification and compatibility cleanup are
 * all Stage 2, and none of them makes the Stage 1 state unsafe.
 *
 * This script answers ONE question — may the descent resume? — from measured
 * state rather than from a session's judgement, and it names the exact failing
 * criterion when the answer is no. "Migration incomplete" is not an answer it
 * can produce.
 */

import { createHash } from "node:crypto";
import { existsSync, readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

import { loadIndex } from "../lib/governance/ledger.ts";
import { validateLedger } from "../lib/governance/validate.ts";
import { validateKnowledge, type MethodKnowledge } from "../lib/method/knowledge.ts";
import { ELIGIBLE_EDGE_VERSION } from "../lib/workstate/eligibility.ts";
import { proveResume } from "../lib/workstate/frontier.ts";
import {
  generateHandoff,
  validateWorkstream,
  type Workstream,
} from "../lib/workstate/workstream.ts";
import { loadMethodStore, loadWorkstreamFor } from "../lib/workstate/load.ts";
import { floored } from "../lib/ops/denominator-floor.ts";

const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
const STATES = ["nj", "az", "nh"] as const;
const TODAY = process.env.WTP_TODAY ?? "2026-08-26";

interface Criterion {
  key: string;
  label: string;
  check: () => { pass: boolean; detail: string };
}

const index = loadIndex();

// Loading is SHARED with the final acceptance gate. Two gates reading the same
// two stores is one job, and RULING 103 caught the second copy.
const ws = (state: string) => loadWorkstreamFor(ROOT, state);
const methodStore = () => loadMethodStore(ROOT);

const CRITERIA: Criterion[] = [
  {
    key: "canonical ruling ledger",
    label: "rulings mechanically imported, immutable ids, legacy aliases resolve",
    check: () => {
      const n = index.records.length;
      const dangling: string[] = [];
      const claude = readFileSync(join(ROOT, "CLAUDE.md"), "utf8");
      for (const m of claude.matchAll(/RULING\s+(\d+)/gi)) {
        if (!index.resolve(`RULING ${m[1]}`)) dangling.push(m[1]);
      }
      const highest = index.highestNumber();
      return {
        pass: n > 150 && dangling.length === 0 && highest >= 171,
        detail: `${n} records, highest id ${highest}, ${dangling.length} dangling reference(s)`,
      };
    },
  },
  {
    key: "new decisions atomic",
    label: "a new decision lands through one gated path and regenerates every view",
    check: () => {
      const { issues } = validateLedger(index, ROOT);
      const hasPath =
        existsSync(join(ROOT, "lib/governance/adoptions.ts")) &&
        existsSync(join(ROOT, "scripts/governance-compile.mts")) &&
        existsSync(join(ROOT, "scripts/governance-check.mts"));
      return {
        pass: hasPath && issues.length === 0,
        detail: hasPath
          ? `governance:check reports ${issues.length} structural issue(s)`
          : "the atomic governance path is missing",
      };
    },
  },
  {
    key: "rulings dual-write ended for new decisions",
    label: "docs/rulings.md is generated and needs no hand-maintained second write",
    check: () => {
      const text = readFileSync(join(ROOT, "docs", "rulings.md"), "utf8");
      const generated = /GENERATED by `pnpm governance:compile`/.test(text);
      const registered = readFileSync(join(ROOT, "lib/ops/generated-register.ts"), "utf8").includes(
        '"docs/rulings.md"',
      );
      return {
        pass: generated && registered,
        detail: generated
          ? `generated${registered ? " and registered with its generator digest" : ", NOT registered"}`
          : "still a hand-maintained authority",
      };
    },
  },
  {
    key: "current discovery policy compiled",
    label: "one authoritative compiled surface for current discovery law",
    check: () => {
      const p = join(ROOT, "docs/governance/policies/discovery.md");
      if (!existsSync(p)) return { pass: false, detail: "absent" };
      const n = index.records.filter(
        (r) => r.domain === "discovery" && r.kind === "LAW_DECISION" && ["ACTIVE", "AMENDED"].includes(r.status),
      ).length;
      return { pass: n > 20, detail: `${n} discovery rule(s) in force` };
    },
  },
  {
    key: "current shipping policy compiled",
    label: "one authoritative compiled surface for shipping / verification / close-out",
    check: () => {
      const p = join(ROOT, "docs/governance/policies/shipping-ci.md");
      if (!existsSync(p)) return { pass: false, detail: "absent" };
      const claims = index
        .records.filter((r) => ["ACTIVE", "AMENDED"].includes(r.status))
        .flatMap((r) => r.claims.map((c) => c.key));
      const has = ["verification.target", "shipping.closeout_path"].every((k) => claims.includes(k));
      return {
        pass: has,
        detail: has
          ? "verification.target and shipping.closeout_path each have exactly one current answer"
          : "the verification or close-out rule slot has no current answer",
      };
    },
  },
  {
    key: "canonical active frontier",
    label: "NJ/AZ/NH migrated to machine-readable work state",
    check: () => {
      const missing = STATES.filter((s) => !ws(s));
      const edges = STATES.map((s) => ws(s)?.edges.length ?? 0).reduce((a, b) => a + b, 0);
      return {
        pass: missing.length === 0 && edges > 1000,
        detail: missing.length ? `missing: ${missing.join(", ")}` : `${edges} edge(s) persisted across 3 states`,
      };
    },
  },
  {
    key: "exact resume without seed rediscovery",
    label: "outstanding work is READ from canonical state, not rebuilt from seeds",
    check: () => {
      const proofs = STATES.map((s) => proveResume(ROOT, s));
      if (proofs.some((p) => !p)) return { pass: false, detail: "a state has no resumable state" };
      const outstanding = proofs.reduce((n, p) => n + (p?.outstandingEligible ?? 0), 0);
      // And the descent itself must actually READ it. A resume API nothing
      // calls is a resume that does not happen.
      const descent = readFileSync(join(ROOT, "scripts/descent.mts"), "utf8");
      const wired =
        descent.includes("resumeFrom(") &&
        descent.includes("recordDiscovery(") &&
        descent.includes("saveWorkstream(");
      const cursors = proofs.every((p) => p && p.cursor.length > 0);
      return {
        pass: outstanding > 0 && wired && cursors,
        detail: wired
          ? `${outstanding} outstanding eligible edge(s) resumable; descent reads canonical state and persists every discovery`
          : "descent.mts does not read canonical state",
      };
    },
  },
  {
    key: "method inheritance preserved",
    label: "cumulative route knowledge survives and is inherited",
    check: () => {
      const k = methodStore();
      if (!k) return { pass: false, detail: "no method store" };
      const issues = validateKnowledge(k);
      const withApplicability = k.routes.filter((r) => r.applicability).length;
      return {
        pass: k.routes.length >= 61 && issues.length === 0 && withApplicability === k.routes.length,
        detail: `${k.routes.length} route(s), ${withApplicability} with applicability, ${issues.length} issue(s)`,
      };
    },
  },
  {
    key: "candidate/body separation",
    label: "a lead is not a body, and no candidate count feeds the coverage numerator",
    check: () => {
      let candidates = 0;
      let promoted = 0;
      for (const s of STATES) {
        const w = ws(s);
        if (!w) continue;
        candidates += w.candidates.length;
        promoted += w.candidates.filter((c) => c.state === "BODY_PROMOTED").length;
      }
      return {
        pass: candidates > 0,
        detail: `${candidates} lead(s), ${promoted} promoted body/bodies — the numerator is ${promoted}`,
      };
    },
  },
  {
    key: "permission/transport separation",
    label: "a transport failure can never become a permission verdict",
    check: () => {
      const types = readFileSync(join(ROOT, "lib/workstate/types.ts"), "utf8");
      const enforced =
        types.includes("PERMISSION_STATES") &&
        types.includes("TRANSPORT_STATES") &&
        types.includes("cannot have been read");
      const guarded = readFileSync(join(ROOT, "lib/workstate/workstream.ts"), "utf8").includes(
        "transport-became-permission",
      );
      return {
        pass: enforced && guarded,
        detail: enforced
          ? `${guarded ? "typed apart and guarded" : "typed apart, NOT guarded"}`
          : "not separated",
      };
    },
  },
  {
    key: "aggregate-tail accounting",
    label: "the historical obligation is preserved, counted apart, and never resumable",
    check: () => {
      const expected: Record<string, number> = { nj: 1986, az: 1143, nh: 771 };
      let tail = 0;
      let resumable = 0;
      const wrong: string[] = [];
      for (const s of STATES) {
        const w = ws(s);
        if (!w) continue;
        const carried = (w.unmaterialized ?? []).reduce(
          (n, o) => n + (o.dischargedOn ? 0 : o.count),
          0,
        );
        if (carried !== expected[s]) wrong.push(`${s}: carrying ${carried}, history says ${expected[s]}`);
        tail += carried;
        resumable += w.edges.filter((e) => e.eligible && ["UNWALKED", "DISCOVERED", "IN_PROGRESS"].includes(e.disposition)).length;
      }
      return {
        pass: wrong.length === 0 && tail === 3900,
        detail: wrong.length
          ? wrong.join("; ")
          : `${resumable} resumable edge(s) + ${tail} unmaterialized obligation(s), reported apart and never summed`,
      };
    },
  },
  {
    key: "generated handoff",
    label: "cursor and remainder come from canonical state, not from prose",
    check: () => {
      const bad: string[] = [];
      for (const s of STATES) {
        const w = ws(s);
        if (!w) continue;
        const h = generateHandoff(
          w,
          { today: TODAY, methodVersion: 0, eligibleEdgeVersion: ELIGIBLE_EDGE_VERSION },
          "EARLY_HANDOFF",
        );
        if (!h.resumeCursor) bad.push(`${s}: no cursor`);
        if (h.workstream !== "OPEN") bad.push(`${s}: not OPEN`);
      }
      return { pass: bad.length === 0, detail: bad.length ? bad.join("; ") : "3 of 3 states generate a cursor and a remainder" };
    },
  },
  {
    key: "Stage 1 validators",
    label: "governance, method and work-state validators all pass",
    check: () => {
      const g = validateLedger(index, ROOT).issues.length;
      const k = methodStore();
      const m = k ? validateKnowledge(k).length : 1;
      let wIssues = 0;
      for (const s of STATES) {
        const w = ws(s);
        if (!w) continue;
        wIssues += validateWorkstream(w, {
          today: TODAY,
          methodVersion: 0,
          eligibleEdgeVersion: ELIGIBLE_EDGE_VERSION,
        }).length;
      }
      return {
        pass: g === 0 && m === 0 && wIssues === 0,
        detail: `governance ${g}, method ${m}, work-state ${wIssues}`,
      };
    },
  },
];

// RULING 159 — a gate that evaluated zero criteria would print a green board
// about nothing. The floor is asserted before any verdict is reported.
floored("stage1 criteria", "the Stage 1 acceptance list", CRITERIA.length, CRITERIA.length);

const results = CRITERIA.map((c) => ({ ...c, ...c.check() }));
const failed = results.filter((r) => !r.pass);

console.log("STAGE 1 CUTOVER");
console.log("");
console.log(`DESCENT FREEZE: ${failed.length === 0 ? "LIFTED" : "NOT LIFTED"}`);
console.log("");
for (const r of results) {
  console.log(`${r.key.padEnd(42)} ${r.pass ? "PASS" : "FAIL"}   ${r.detail}`);
}
console.log("");

if (failed.length > 0) {
  console.log("EXACT FAILING ACCEPTANCE CRITERIA:");
  for (const f of failed) console.log(`  - ${f.key}: ${f.label}`);
  console.log("");
  console.error(`Stage 1 NOT complete — ${failed.length} criterion/criteria failing`);
  process.exit(1);
}

console.log("Stage 1 is complete. The descent may resume immediately.");
console.log("");
console.log("Remaining governance normalization is STAGE 2 and does NOT hold the freeze:");
console.log("  - full historical provenance classification (43 records still uncertain)");
console.log("  - full supersession normalization beyond the 10 scoped partials");
console.log("  - removal of the docs/rulings.md compatibility path once consumers move");
console.log("");
console.log("THERE IS NO SECOND MIGRATION OF THE ACTIVE FRONTIER.");
console.log("New descent work writes directly into data/workstate/<state>.json.");
