  {
    "publisher": "Commonwealth Election Commission",
    "url": "https://www.votecnmi.gov.mp/polling-places.php",
    "shape": "list-page",
    "scope": {
      "state": "MP",
      "ocdId": "ocd-division/country:us/territory:mp/county:saipan",
      "name": "Saipan",
      "countyFips": "69110"
    },
    "electionDate": "2026-11-03",
    "electionPageUrl": "https://www.votecnmi.gov.mp/polling-places.php",
    "title": "2026 General Election",
    "officialLinkingPage": {
      "url": "https://www.fec.gov/introduction-campaign-finance/how-to-research-public-records/state-election-offices/",
      "html": "<a href=\"https://www.votecnmi.gov.mp/\">https://www.votecnmi.gov.mp/</a>"
    },
    "discoveredFrom": "https://www.votecnmi.gov.mp/",
    "model": "ASSIGNED",
    "matchingUnit": "PRECINCT",
    "access": {
      "status": "open",
      "checkedAt": "2026-10-21",
      "detail": "Published inline JavaScript records render the public polling list. No registration lookup is submitted. Northern Islands combined entry is excluded until individual sites are published; village/facility location wording is retained without invented street numbers."
    },
    "id": "mp-election-day-saipan-2026",
    "covers": [
      "ELECTION_DAY"
    ],
    "extraction": {
      "format": "html",
      "records": {
        "pattern": "\\{\\s*ids:\\[(?!'4D')[^\\]]+\\],[^}]+\\}",
        "fields": {
          "precinct": {
            "pattern": "ids:\\[([^\\]]+)\\]",
            "group": 1
          },
          "island": {
            "pattern": "island:'([^']+)'",
            "group": 1
          },
          "area": {
            "pattern": "area:'([^']+)'",
            "group": 1
          },
          "site": {
            "pattern": "site:'([^']+)'",
            "group": 1
          },
          "locationNotes": {
            "pattern": "door:'([^']+)'",
            "group": 1
          },
          "lat": {
            "pattern": "mapQ:'(-?[0-9.]+),(-?[0-9.]+)'",
            "group": 1
          },
          "lng": {
            "pattern": "mapQ:'(-?[0-9.]+),(-?[0-9.]+)'",
            "group": 2
          }
        }
      },
      "splitRows": {
        "column": "precinct",
        "pattern": "[',\\s]+"
      },
      "columns": {
        "name": "site",
        "address": [
          "site",
          "area",
          "island"
        ],
        "precinct": "precinct"
      },
      "transforms": {
        "precinct": {
          "column": "precinct",
          "pattern": "^'?([^']+)'?$",
          "group": 1
        }
      },
      "constants": {
        "election": "2026 General Election",
        "days": "Tuesday, November 3",
        "hours": "7:00 AM – 7:00 PM ChST"
      },
      "textAssertions": [
        "2026 General Election",
        "Election Day polling places",
        "November 3"
      ],
      "filters": {
        "island": "saipan"
      }
    }
  },
