    },
    "electionDate": "2026-11-03",
    "electionPageUrl": "https://votemt.gov/",
    "discoveredFrom": "https://votemt.gov/",
    "access": {
      "status": "open",
      "detail": "Original statewide XLSX downloaded October 13, 2026, after robots permission; 30 satellite location rows after aligned multi-site cells are separated.",
      "checkedAt": "2026-10-13"
    },
    "title": "2026 Polling Location Satellite Office General Final",
    "extraction": {
      "format": "xlsx",
      "sheet": "Satellite",
      "headerRow": 3,
      "kind": "SATELLITE",
      "columns": {
        "countyName": "County",
        "name": "Satellite Location/Alternate Election Office",
        "address": "Satellite Location/Alternate Election Office",
        "days": "Satellite Days\r\n(Absentee Period)",
        "hours": "Satellite Hours\r\n(Absentee Period)",
        "tribalNation": "Tribe",
        "reservation": "Reservation"
      },
      "splitRows": {
        "column": "Satellite Location/Alternate Election Office",
        "pattern": "\\r?\\n(?:\\s*\\r?\\n)*(?=[^\\r\\n]*,\\s*#?\\d)",
        "alignedColumns": [
          "Satellite Days\r\n(Absentee Period)",
          "Satellite Hours\r\n(Absentee Period)"
        ],
        "alignedPattern": "\\r?\\n(?:\\s*\\r?\\n)+"
      },
      "transforms": {
        "name": {
          "column": "Satellite Location/Alternate Election Office",
          "pattern": "^(.*?),\\s*([\\s\\S]+)$",
          "group": 1
        },
        "address": {
          "column": "Satellite Location/Alternate Election Office",
          "pattern": "^(.*?),\\s*([\\s\\S]+)$",
          "group": 2
        },
        "countyName": {
          "column": "County",
          "pattern": "^(.*?)(?:,\\s*cont\\.)?$",
          "group": 1
        }
      },
      "constants": {
        "election": "2026 General Election"
      }
    },
    "matchingUnit": "COUNTY",
    "fileUpdatedAt": "October, 1, 2026",
    "electionAssociationVerified": true
  },
