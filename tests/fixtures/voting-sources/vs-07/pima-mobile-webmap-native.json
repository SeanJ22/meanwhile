e":"Pima County Boundary","url":"https://gisdata.pima.gov/arcgis1/rest/services/GISOpenData/Boundaries/MapServer/13","layerType":"ArcGISFeatureLayer","layerDefinition":{"featureReduction":null,"fieldConfigurations":[{"name":"Shape.STArea()","fieldFormat":{"type":"number","minimumFractionDigits":2,"useGrouping":"always"}},{"name":"Shape.STLength()","fieldFormat":{"type":"number","minimumFractionDigits":2,"useGrouping":"always"}}],"drawingInfo":{"renderer":{"type":"simple","symbol":{"type":"CIMSymbolReference","symbol":{"type":"CIMPolygonSymbol","symbolLayers":[{"type":"CIMSolidStroke","enable":true,"capStyle":"Round","joinStyle":"Round","lineStyle3D":"Strip","miterLimit":4,"width":0.75,"color":[110,110,110,255]},{"type":"CIMSolidFill","enable":true,"color":[0,0,0,0]}]}}}}},"showLabels":false,"popupInfo":{"popupElements":[{"type":"fields"},{"type":"attachments","displayType":"auto"}],"showAttachments":true,"fieldInfos":[{"fieldName":"OBJECTID","isEditable":false,"label":"OBJECTID","visible":false},{"fieldName":"NAME","isEditable":true,"label":"Name","visible":true},{"fieldName":"Shape.STArea()","format":{"digitSeparator":true,"places":2},"isEditable":true,"label":"Shape.STArea()","visible":false},{"fieldName":"Shape.STLength()","format":{"digitSeparator":true,"places":2},"isEditable":true,"label":"Shape.STLength()","visible":false}],"title":"Boundaries - Pima County Boundary: {NAME}"}},{"id":"1929c605614-layer-62","title":"Light Gray Canvas Reference","itemId":"1768e8369a214dfab4e2167d5c5f2454","layerType":"VectorTileLayer","styleUrl":"https://www.arcgis.com/sharing/rest/content/items/1768e8369a214dfab4e2167d5c5f2454/resources/styles/root.json"},{"id":"18f7435b46e-layer-5","title":"Precinct Polygons","url":"https://services2.arcgis.com/UTBp78iglGpbqp1B/arcgis/rest/services/election_polys_app_view/FeatureServer/12","visibility":false,"itemId":"8999088ae8b44cbf80353f8960c7b5da","layerType":"ArcGISFeatureLayer","layerDefinition":{"fieldConfigurations":[{"name":"BOS_DISTRICT","fieldFormat":{"type":"number","maximumFractionDigits":0,"useGrouping":"always"}},{"name":"PCC_DIST","fieldFormat":{"type":"number","maximumFractionDigits":0,"useGrouping":"always"}},{"name":"JTED_BOARD","fieldFormat":{"type":"number","maximumFractionDigits":0,"useGrouping":"always"}},{"name":"SCH_DISTNO","fieldFormat":{"type":"number","maximumFractionDigits":0,"useGrouping":"always"}},{"alias":"Sample Ballot","name":"BALLOT_URL"},{"name":"BALLOT_ID","fieldFormat":{"type":"number","useGrouping":"always"}},{"name":"Shape__Area","fieldFormat":{"type":"number","useGrouping":"always"}},{"name":"Shape__Length","fieldFormat":{"type":"number","useGrouping":"always"}}]}},{"id":"192596375c2-layer-5","title":"Election Polygons App View","url":"https://services2.arcgis.com/UTBp78iglGpbqp1B/arcgis/rest/services/election_polys_20241004_view/FeatureServer/0","itemId":"ba56147f7d54454eab8775c145746676","layerType":"ArcGISFeatureLayer","layerDefinition":{"fieldConfigurations":[{"name":"BOS_DISTRICT","fieldFormat":{"type":"number","useGrouping":"never"}},{"name":"PCC_DIST","fieldFormat":{"type":"number","useGrouping":"never"}},{"name":"JTED_BOARD","fieldFormat":{"type":"number","useGrouping":"never"}},{"name":"SCH_DISTNO","fieldFormat":{"type":"number","useGrouping":"never"}},{"alias":"SHAPE__Length","name":"Shape__Length","fieldFormat":{"type":"number","maximumFractionDigits":6,"minimumFractionDigits":6,"useGrouping":"never"}},{"alias":"SHAPE__Area","name":"Shape__Area","fieldFormat":{"type":"number","maximumFractionDigits":6,"minimumFractionDigits":6,"useGrouping":"never"}}]},"popupInfo":{"popupElements":[{"type":"expression","expressionInfo":{"title":"Precinct Popup","expression":"// Precinct information popupElement.fields\n\n// Get locale\nvar env = GetEnvironment();\nvar locale = env['locale'];\n\n// Function to translate school districts\nfunction translateSchoolDistrict (name, number) {\n  var distNumber = 'Núm. ' + number;\n  var nameArray = Split(name, ' ');\n  var distName = Proper(Concatenate(Slice(nameArray, 0 , -3), ' '));\n  if (nameArray[-3] == 'ELEMENTARY') {\n    var distLevel = 'Primario';\n  } else if (nameArray[-3] == 'UNIFIED') {\n    var distLevel = 'Unificado'\n  }\n  var translatedDist = Concatenate(['Distrito', distLevel, 'Escolar', distNumber, 'de', distName], ' ')\n  return translatedDist\n};\n\n// Function to translate jurisdictions\nfunction translateJurisdiction (jurisdiction) {\n  if (jurisdiction == 'UNINCORPORATED PIMA COUNTY') {\n    return 'Área no incorporada del condado de Pima'\n  } else {\n    return Proper(jurisdiction)\n  }  \n};\n\n// Function to generate ballot URLs\nfunction generateBallotURL (p, ct, sd, fd) {\n  // Array of cities/towns with elections\n  var ctWithElections = [\n    'ORO VALLEY',\n    'TUCSON',\n    'SOUTH TUCSON'\n  ]\n  // Encode values for gray ballots\n  var cityOrTown = IIf(Includes(ctWithElections, ct), 'Incorporated', 'Unincorporated'); //if city/town has an election, return \"Incorporated\", else return \"Unincorporated\"\n  var incorp = IIf(cityOrTown == 'Incorporated', 'Y', '');\n  var unincorp = IIf(cityOrTown == 'Unincorporated', 'Y', '');\n  // School Districts (number) with elections\n  var sdWithElections = [\n    1, //TUSD\n    10, //Amphi\n    13, //Tanque Verde\n    20, //Vail\n    30 //Sahuarita\n  ]\n  // Fire Districts with elections\n  var fdWithElections = [\n    'DREXEL HEIGHTS', //fd number 2\n    'HIDDEN VALLEY', //5\n    'NORTHWEST', //14\n    'MESCAL-J6' //20\n  ]\n  // School Districts (number) WITHOUT jted elections\n  var jtedNo = [\n    35, //San Fernando\n    37, //Empire\n    39, //Continental\n    44, //Redington\n    51 //Altar Valley\n  ]\n  \n  //Determine ballot color based on city/town, sd, fd, and jted\n  if (Includes(ctWithElections, ct)) {\n    var desc_ct = 'Yes City'\n  } else {\n    var desc_ct = 'No City'\n  };\n\n  if (Includes(sdWithElections, sd)) {\n    var desc_sd = 'Yes School'\n  } else {\n    var desc_sd = 'No School'\n  };\n\n  if (Includes(fdWithElections, fd)) {\n    var desc_fd = 'Yes Fire'\n  } else {\n    var desc_fd = 'No Fire'\n  };\n\n  if (Includes(jtedNo, sd)) {\n    var desc_jted = 'No JTED'\n  } else {\n    var desc_jted = 'Yes JTED'\n  };\n\n  if (desc_ct == 'No City' && desc_sd == 'No School' && desc_fd == 'No Fire' && desc_jted == 'No JTED') {\n    var color = \"NONE\"\n  };\n\n  if (desc_ct == 'No City' && desc_sd == 'No School' && desc_fd == 'No Fire' && desc_jted == 'Yes JTED') {\n      if (p == \"46\") {\n        var color = \"NONE\"\n    }\n      else {\n        var color = \"BROWN\"      \n    }\n  };\n\n  if (desc_ct == 'No City' && desc_sd == 'No School' && desc_fd == 'Yes Fire' && desc_jted == 'Yes JTED') {\n    var color = \"BLACK\"\n  };\n  \n  if (desc_ct == 'No City' && desc_sd == 'Yes School' && desc_fd == 'No Fire' && desc_jted == 'Yes JTED') {\n    if (p == \"46\" && IsEmpty($feature.JTED_BOARD)) {\n      var color = \"RED\"\n    }\n    else {\n      var color = \"ORANGE\"\n    }\n  };\n\n  if (desc_ct == 'No City' && desc_sd == 'Yes School' && desc_fd == 'Yes Fire' && desc_jted == 'Yes JTED') {\n    var color = \"GOLD\"\n  };\n\n  if (desc_ct == 'Yes City' && desc_sd == 'No School' && desc_fd == 'No Fire' && desc_jted == 'Yes JTED') {\n    var color = \"OLIVE\"\n  };\n\n  if (desc_ct == 'Yes City' && desc_sd == 'Yes School' && desc_fd == 'No Fire' && desc_jted == 'Yes JTED') {\n    if (p == '39' && sd == 13) {\n      var color = 'PURPLE'\n    }\n    else if (p == '47' && ct == 'TUCSON') {\n      var color = 'CYAN'\n    }\n    else if (p == '166' && sd == 10) {\n      var color = 'PURPLE'\n    }\n    else {\n      var color = 'TAN'\n    }\n  };\n\n  if (desc_ct == 'Yes City' && desc_sd == 'Yes School' && desc_fd == 'Yes Fire' && desc_jted == 'Yes JTED') {\n    var color = \"PINK\"\n  };\n\n   Console(p)\n   Console(sd)\n   Console(desc_ct)\n   Console(desc_sd)\n   Console(desc_fd)\n   Console(desc_jted)\n   Console(color)\n\n  var urlSource = 'https://onbase.pima.gov/publicaccess/EL_NextGen_Single/etc/cq/index.html?'; //base OB URL\n  var params = { //dictionary of URL params\n    cqid: 401, \n    OBKey__1060_1: p,\n\t\tOBKey__1207_1: incorp,\n    OBKey__1208_1: unincorp,\n    OBKey__1062_1: color\n  }; \n\n  var ballotURL = urlSource + UrlEncode(params); //build ballot URL\n  \n  if (!IsEmpty(p) && !IsEmpty(ct)){ //check if these parameters are empty, i.e. location is outside of Pima County\n    return ballotURL;\n  } else {\n  return IIf(locale != 'es', 'Sample ballot not available', 'Boleta de muestra no disponible')\n  }\n};\n\nfunction generateFedBallotURL (p) {\n  var urlSource = 'https://onbase.pima.gov/publicaccess/EL_NextGen_Single/etc/cq/index.html?'; //base OB URL\n\n  // Build parameters for Federal Only Ballots\n  var fedParams = { //dictionary of URL params\n    cqid: 401, \n    OBKey__1060_1: p,\n    OBKey__1062_1: 'GRAY'\n  };\n  var fedBallotURL = urlSource + UrlEncode(fedParams); //build Federal Only Ballot URL\n\n  if (!IsEmpty(p)){ //check if these parameters are empty, i.e. location is outside of Pima County\n  return fedBallotURL;\n  } else {\n  return IIf(locale != 'es', 'Sample ballot not available', 'Boleta de muestra no disponible')\n  }\n};\n\n// Give sample ballot URL or comment that ballots aren't available, translating if locale == 'es'\nvar ballotsExist = true //set to true if ballots and URLs are ready //set to false to display no ballot message\n\nif (ballotsExist != true) {\n  if (locale != 'es') {\n    var ballot = 'Sample ballots for the upcoming election are not yet available'\n    var fedBallot = 'Sample ballots for the upcoming election are not yet available'\n  } else {\n    var ballot = 'Aún no están disponibles las boletas de muestra para las próximas elecciones'\n    var fedBallot = 'Aún no están disponibles las boletas de muestra para las próximas elecciones'\n  }  \n} else {\n  var ballot = generateBallotURL($feature.POLL_PCT_STR, $feature.JUR_NAME, $feature.SCH_DISTNO, $feature.FIRE_DIST) //call helper function with feature attributes\n  var fedBallot = generateFedBallotURL($feature.POLL_PCT_STR)\n};\n\n// Set field content variables, translating if locale == 'es'\nif (locale != 'es') \n{\n  var congressionalDist = IIf(IsEmpty($feature.CONG_DIST_STR), 'District not found', $feature.CONG_DIST_STR);\n  var legislativeDist = IIf(IsEmpty($feature.LEG_DIST), 'District not found', $feature.LEG_DIST);\n  var precinct = IIf(IsEmpty($feature.POLL_PCT_STR), 'Precinct not found', $feature.POLL_PCT_STR);\n  var incorporatedArea = IIf(IsEmpty($feature.JUR_NAME), 'This location is outside of Pima County', Proper($feature.JUR_NAME));\n  var tucsonWard = IIf(IsEmpty($feature.COT_WARD_STR), 'This location is outside of the City of Tucson', $feature.COT_WARD_STR);\n  var schoolDist = IIf(IsEmpty($feature.SCH_DISTNO), 'This location is not within a school district', Proper($feature.SCH_DIST) + ' No. ' + $feature.SCH_DISTNO);\n  var fireDist = IIf(IsEmpty($feature.FIRE_DIST), 'This location is not within a separate fire tax district', Proper($feature.FIRE_DIST));\n  var supervisorDist = IIf(IsEmpty($feature.BOS_DISTRICT), 'District not found', $feature.BOS_DISTRICT);\n  var collegeDist = IIf(IsEmpty($feature.PCC_DIST), 'District not found', $feature.PCC_DIST);\n  var jtedDist = IIf(IsEmpty($feature.JTED_BOARD), 'This location is not within a JTED Governing Board District', $feature.JTED_BOARD);\n  var jpDist = IIf(IsEmpty($feature.JP_DIST), 'Precinct not found', $feature.JP_DIST);\n} \nelse \n{\n  var congressionalDist = IIf(IsEmpty($feature.CONG_DIST_STR), 'Distrito no encontrado', $feature.CONG_DIST_STR);\n  var legislativeDist = IIf(IsEmpty($feature.LEG_DIST), 'Distrito no encontrado', $feature.LEG_DIST);\n  var precinct = IIf(IsEmpty($feature.POLL_PCT_STR), 'Distrito electoral no encontrado', $feature.POLL_PCT_STR);\n  var incorporatedArea = IIf(IsEmpty($feature.JUR_NAME), 'Esta ubicación se encuentra fuera del condado de Pima', translateJurisdiction($feature.JUR_NAME));\n  var tucsonWard = IIf(IsEmpty($feature.COT_WARD_STR), 'Esta ubicación se encuentra fuera de la ciudad de Tucson', $feature.COT_WARD_STR);\n  var schoolDist = IIf(IsEmpty($feature.SCH_DISTNO), 'Esta ubicación no se encuentra en un distrito escolar', translateSchoolDistrict($feature.SCH_DIST, $feature.SCH_DISTNO));\n  var fireDist = IIf(IsEmpty($feature.FIRE_DIST), 'Esta ubicación no se encuentra dentro de un distrito fiscal de bomberos separado', Proper($feature.FIRE_DIST));\n  var supervisorDist = IIf(IsEmpty($feature.BOS_DISTRICT), 'Distrito no encontrado', $feature.BOS_DISTRICT);\n  var collegeDist = IIf(IsEmpty($feature.PCC_DIST), 'Distrito no encontrado', $feature.PCC_DIST);\n  var jtedDist = IIf(IsEmpty($feature.JTED_BOARD), 'Esta ubicación no se encuentra dentro de un distrito de Pima JTED', $feature.JTED_BOARD);\n  var jpDist = IIf(IsEmpty($feature.JP_DIST), 'Distrito electoral no encontrado', $feature.JP_DIST);\n};\n\n// Build fields element and translate labels if locate == 'es'\nreturn {\n  type: 'fields',\n  //title: '',\n  //description: '',\n  fieldInfos: [\n    {\n      fieldName : 'ballot',\n      label: IIf(locale != 'es', 'Sample Ballot', 'Boleta de Muestra')\n    },\n    {\n      fieldName: \"fedBallot\",\n      label: IIf(locale != 'es', 'Sample Federal Only Ballot', 'Boleta electoral exclusivamente federal')\n    },\n    {\n      fieldName : 'congressionalDist',\n      label: IIf(locale != 'es', 'US Congressional District', 'Distrito del Congreso de los EE. UU.')\n    },\n    {\n      fieldName : 'legislativeDist',\n      label: IIf(locale != 'es', 'State Legislative District', 'Distrito Legislativo Estatal')\n    },\n    {\n      fieldName : 'precinct',\n      label: IIf(locale != 'es', 'Voting Precinct', 'Distrito Electoral')\n    },\n    {\n      fieldName : 'incorporatedArea',\n      label: IIf(locale != 'es', 'Incorporated Area', 'Área Incorporada')\n    },\n    {\n      fieldName : 'tucsonWard',\n      label: IIf(locale != 'es', 'City of Tucson Ward', 'Distrito de la Ciudad de Tucsón')\n    },\n    {\n      fieldName : 'schoolDist',\n      label: IIf(locale != 'es', 'School District', 'Distrito Escolar')\n    },\n    {\n      fieldName : 'fireDist',\n      label: IIf(locale != 'es', 'Fire District', 'Distrito de Bomberos')\n    },\n    {\n      fieldName : 'supervisorDist',\n      label: IIf(locale != 'es', 'Pima County Supervisor District', 'Distrito Supervisor del Condado de Pima')\n    },\n    {\n      fieldName : 'collegeDist',\n      label: IIf(locale != 'es', 'Pima Community College District', 'Distrito del Colegio Comunitario Pima')\n    },\n    {\n      fieldName : 'jtedDist',\n      label: IIf(locale != 'es', 'Pima JTED District', 'Distrito de Pima JTED')\n    },\n    {\n      fieldName : 'jpDist',\n      label: IIf(locale != 'es', 'Justice of the Peace Precinct', 'Distrito Electoral del Juez de Paz')\n    }\n  ],\n  attributes: {\n    ballot: ballot,\n    fedBallot: fedBallot,\n    congressionalDist: congressionalDist,\n    legislativeDist: legislativeDist,\n    precinct: precinct,\n    incorporatedArea: incorporatedArea,\n    tucsonWard: tucsonWard,\n    schoolDist: schoolDist,\n    fireDist: fireDist,\n    supervisorDist: supervisorDist,\n    collegeDist: collegeDist,\n    jtedDist: jtedDist,\n    jpDist: jpDist\n  }\n};","returnType":"dictionary"}}],"expressionInfos":[{"name":"expr0","title":"Popup Title","expression":"var env = GetEnvironment();\nvar locale = env['locale'];\n\nIIf(locale != 'es', 'Pima County Voter Information', 'Información para votantes del condado de Pima')","returnType":"string"}],"fieldInfos":[{"fieldName":"OBJECTID","format":{"digitSeparator":false,"places":0},"isEditable":false,"label":"OBJECTID","visible":true},{"fieldName":"BOS_DISTRICT","format":{"digitSeparator":false,"places":0},"isEditable":true,"label":"BOS_DISTRICT","visible":true},{"fieldName":"PCC_DIST","format":{"digitSeparator":false,"places":0},"isEditable":true,"label":"